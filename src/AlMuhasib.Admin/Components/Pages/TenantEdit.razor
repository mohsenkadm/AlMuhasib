@page "/tenants/new"
@page "/tenants/{Id:int}"
@rendermode InteractiveServer
@using AlMuhasib.Cloud.Core.Entities
@using AlMuhasib.Cloud.Core.Interfaces
@using AlMuhasib.Core.Enums
@using AlMuhasib.Admin.Services
@inject ITenantService TenantService
@inject DeveloperAuthState Auth
@inject NavigationManager Nav

<PageTitle>@(Id == 0 ? "عميل جديد" : "إدارة عميل")</PageTitle>

@if (_ready)
{
    <div class="page-header">
        <h1>@(Id == 0 ? "إنشاء عميل جديد" : $"تعديل: {_companyName}")</h1>
        <a href="/tenants" class="btn btn-secondary">← رجوع للقائمة</a>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    <div class="card" style="margin-bottom:1.5rem">
        <div class="card-header"><h3>بيانات العميل</h3></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-group full">
                    <label>اسم الشركة</label>
                    <input class="form-control" @bind="_companyName" placeholder="اسم الشركة أو المحل" />
                </div>
                <div class="form-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_isMobileEnabled" />
                        تفعيل المزامنة والتطبيق
                    </label>
                </div>
                @if (Id > 0)
                {
                    <div class="form-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="_isActive" />
                            العميل نشط
                        </label>
                    </div>
                }
                <div class="form-group">
                    <label>انتهاء الترخيص</label>
                    <input type="date" class="form-control" @bind="_licenseExpires" />
                </div>
                <div class="form-group">
                    <label>نوع النظام</label>
                    <select class="form-control" @bind="_applicationSystemType">
                        <option value="@((int)ApplicationSystemType.Accounting)">المحاسبة</option>
                        <option value="@((int)ApplicationSystemType.CarContracts)">عقود السيارات</option>
                        <option value="@((int)ApplicationSystemType.HotelManagement)">إدارة الفنادق</option>
                        <option value="@((int)ApplicationSystemType.CarTrading)">بيع وشراء السيارات</option>
                    </select>
                </div>
            </div>
            <div style="display:flex;gap:.75rem;flex-wrap:wrap;margin-top:.5rem">
                <button class="btn btn-primary" @onclick="SaveAsync">حفظ البيانات</button>
                @if (Id > 0)
                {
                    <button class="btn btn-danger" @onclick="ConfirmDeleteTenant">حذف العميل</button>
                }
            </div>
        </div>
    </div>

    @if (Id > 0)
    {
        <div class="card">
            <div class="card-header"><h3>حسابات التطبيق (@_accounts.Count)</h3></div>
            <div class="card-body" style="padding:0">
                @if (_accounts.Count > 0)
                {
                    <table class="data-table">
                        <thead>
                            <tr><th>المستخدم</th><th>الحالة</th><th>ينتهي في</th><th>إجراء</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _accounts)
                            {
                                <tr>
                                    <td><strong>@a.Username</strong></td>
                                    <td>
                                        <span class="badge @(a.IsActive ? "badge-success" : "badge-danger")">
                                            @(a.IsActive ? "فعّال" : "معطّل")
                                        </span>
                                    </td>
                                    <td>@(a.ExpiresAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td style="white-space:nowrap">
                                        <button class="btn btn-secondary btn-sm" @onclick="() => OpenEditAccount(a)">تعديل</button>
                                        <button class="btn @(a.IsActive ? "btn-warning" : "btn-success") btn-sm"
                                                @onclick="() => ToggleAccount(a.Id, !a.IsActive)">
                                            @(a.IsActive ? "تعطيل" : "تفعيل")
                                        </button>
                                        <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDeleteAccount(a)">حذف</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="padding:1.5rem;color:var(--text-muted);text-align:center">لا توجد حسابات بعد</div>
                }
            </div>

            <div class="card-body" style="border-top:1px solid var(--border)">
                <h4 style="margin:0 0 1rem;font-size:.95rem">إنشاء حساب جديد</h4>
                <div class="form-grid">
                    <div class="form-group">
                        <label>اسم المستخدم</label>
                        <input class="form-control" @bind="_newUsername" placeholder="username" />
                    </div>
                    <div class="form-group">
                        <label>كلمة المرور</label>
                        <input type="password" class="form-control" @bind="_newPassword" />
                    </div>
                    <div class="form-group">
                        <label>ينتهي في</label>
                        <input type="date" class="form-control" @bind="_newAccountExpires" />
                    </div>
                </div>
                <button class="btn btn-accent" @onclick="CreateAccountAsync">إنشاء الحساب</button>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header"><h3>حساب التطبيق الأول</h3></div>
            <div class="card-body">
                <div class="form-grid">
                    <div class="form-group">
                        <label>اسم المستخدم</label>
                        <input class="form-control" @bind="_newUsername" placeholder="demo" />
                    </div>
                    <div class="form-group">
                        <label>كلمة المرور</label>
                        <input type="password" class="form-control" @bind="_newPassword" />
                    </div>
                    <div class="form-group">
                        <label>ينتهي في</label>
                        <input type="date" class="form-control" @bind="_newAccountExpires" />
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (_editAccount is not null)
{
    <div class="modal-backdrop" @onclick="CloseEditAccount">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>تعديل حساب: @_editAccount.Username</h3>
            <div class="form-group" style="margin-bottom:1rem">
                <label>كلمة مرور جديدة (اتركها فارغة للإبقاء على الحالية)</label>
                <input type="password" class="form-control" @bind="_editPassword" />
            </div>
            <div class="form-group" style="margin-bottom:1rem">
                <label>ينتهي في</label>
                <input type="date" class="form-control" @bind="_editExpires" />
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseEditAccount">إلغاء</button>
                <button class="btn btn-primary" @onclick="SaveAccountEditAsync" disabled="@_savingAccount">
                    @(_savingAccount ? "جارٍ الحفظ..." : "حفظ")
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteAccountTarget is not null)
{
    <div class="modal-backdrop" @onclick="CancelDeleteAccount">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>تأكيد حذف الحساب</h3>
            <p>هل أنت متأكد من حذف الحساب <strong>@_deleteAccountTarget.Username</strong>؟</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDeleteAccount">إلغاء</button>
                <button class="btn btn-danger" @onclick="DeleteAccountConfirmedAsync">حذف</button>
            </div>
        </div>
    </div>
}

@if (_confirmDeleteTenant)
{
    <div class="modal-backdrop" @onclick="CancelDeleteTenant">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>تأكيد حذف العميل</h3>
            <p>هل أنت متأكد من حذف العميل <strong>@_companyName</strong> وجميع حساباته؟</p>
            <p style="color:var(--text-muted);font-size:.9rem">لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDeleteTenant">إلغاء</button>
                <button class="btn btn-danger" @onclick="DeleteTenantConfirmedAsync" disabled="@_deleting">
                    @(_deleting ? "جارٍ الحذف..." : "حذف نهائياً")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private string _companyName = "";
    private bool _isMobileEnabled = true;
    private bool _isActive = true;
    private DateTime? _licenseExpires;
    private int _applicationSystemType;
    private List<TenantAccount> _accounts = [];
    private string _newUsername = "";
    private string _newPassword = "";
    private DateTime? _newAccountExpires;
    private string? _message;
    private bool _isError;
    private Tenant? _tenant;
    private bool _ready;

    private TenantAccount? _editAccount;
    private string _editPassword = "";
    private DateTime? _editExpires;
    private bool _savingAccount;

    private TenantAccount? _deleteAccountTarget;
    private bool _confirmDeleteTenant;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        if (Id > 0)
        {
            _tenant = await TenantService.GetByIdAsync(Id);
            if (_tenant is null) return;
            _companyName = _tenant.CompanyName;
            _isMobileEnabled = _tenant.IsMobileEnabled;
            _isActive = _tenant.IsActive;
            _licenseExpires = _tenant.LicenseExpiresAt;
            _applicationSystemType = _tenant.ApplicationSystemType;
            _accounts = await TenantService.GetAccountsAsync(Id);
        }
        else
        {
            _licenseExpires = DateTime.UtcNow.AddYears(1);
            _newAccountExpires = DateTime.UtcNow.AddYears(1);
        }

        _ready = true;
    }

    private async Task SaveAsync()
    {
        _isError = false;
        try
        {
            if (Id == 0)
            {
                var tenant = await TenantService.CreateAsync(_companyName, _isMobileEnabled, _licenseExpires, _applicationSystemType);
                if (!string.IsNullOrWhiteSpace(_newUsername) && !string.IsNullOrWhiteSpace(_newPassword))
                    await TenantService.CreateAccountAsync(tenant.Id, _newUsername, _newPassword, _newAccountExpires);
                Nav.NavigateTo($"/tenants/{tenant.Id}");
                return;
            }

            _tenant!.CompanyName = _companyName;
            _tenant.IsMobileEnabled = _isMobileEnabled;
            _tenant.IsActive = _isActive;
            _tenant.LicenseExpiresAt = _licenseExpires;
            _tenant.ApplicationSystemType = _applicationSystemType;
            await TenantService.UpdateAsync(_tenant);
            _message = "تم حفظ بيانات العميل بنجاح";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private async Task CreateAccountAsync()
    {
        _isError = false;
        try
        {
            await TenantService.CreateAccountAsync(Id, _newUsername, _newPassword, _newAccountExpires);
            _accounts = await TenantService.GetAccountsAsync(Id);
            _newUsername = _newPassword = "";
            _message = "تم إنشاء الحساب بنجاح";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private async Task ToggleAccount(int accountId, bool active)
    {
        await TenantService.SetAccountActiveAsync(accountId, active);
        _accounts = await TenantService.GetAccountsAsync(Id);
    }

    private void OpenEditAccount(TenantAccount account)
    {
        _editAccount = account;
        _editPassword = "";
        _editExpires = account.ExpiresAt;
    }

    private void CloseEditAccount() => _editAccount = null;

    private async Task SaveAccountEditAsync()
    {
        if (_editAccount is null) return;
        _savingAccount = true;
        _isError = false;
        try
        {
            if (!string.IsNullOrWhiteSpace(_editPassword))
                await TenantService.ResetPasswordAsync(_editAccount.Id, _editPassword);

            await TenantService.ExtendAccountAsync(_editAccount.Id, _editExpires);
            _accounts = await TenantService.GetAccountsAsync(Id);
            _message = "تم تحديث الحساب بنجاح";
            _editAccount = null;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _savingAccount = false;
        }
    }

    private void ConfirmDeleteAccount(TenantAccount account) => _deleteAccountTarget = account;

    private void CancelDeleteAccount() => _deleteAccountTarget = null;

    private async Task DeleteAccountConfirmedAsync()
    {
        if (_deleteAccountTarget is null) return;
        _isError = false;
        try
        {
            await TenantService.DeleteAccountAsync(_deleteAccountTarget.Id);
            _message = $"تم حذف الحساب «{_deleteAccountTarget.Username}»";
            _deleteAccountTarget = null;
            _accounts = await TenantService.GetAccountsAsync(Id);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
            _deleteAccountTarget = null;
        }
    }

    private void ConfirmDeleteTenant() => _confirmDeleteTenant = true;

    private void CancelDeleteTenant() => _confirmDeleteTenant = false;

    private async Task DeleteTenantConfirmedAsync()
    {
        _deleting = true;
        _isError = false;
        try
        {
            await TenantService.DeleteAsync(Id);
            Nav.NavigateTo("/tenants");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
            _confirmDeleteTenant = false;
        }
        finally
        {
            _deleting = false;
        }
    }
}
