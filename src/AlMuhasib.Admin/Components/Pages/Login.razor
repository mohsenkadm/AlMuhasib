@page "/login"
@layout EmptyLayout
@using AlMuhasib.Admin.Services
@inject DeveloperAuthState Auth
@inject NavigationManager Nav

<PageTitle>تسجيل دخول — لوحة المطور</PageTitle>

<div class="login-page">
    <div class="login-hero">
        <h1>المحاسب Cloud</h1>
        <p>لوحة تحكم المطور لإدارة العملاء، التراخيص، المزامنة، والإشعارات من مكان واحد.</p>
        <div class="login-hero-features">
            <div class="login-feature"><span class="login-feature-dot"></span> إدارة عملاء متعددين (Multi-Tenant)</div>
            <div class="login-feature"><span class="login-feature-dot"></span> تفعيل المزامنة والتطبيق لكل عميل</div>
            <div class="login-feature"><span class="login-feature-dot"></span> إرسال إشعارات OneSignal</div>
        </div>
    </div>

    <div class="login-form-side">
        <div class="login-card">
            <h2>تسجيل الدخول</h2>
            <p class="subtitle">أدخل بيانات حساب المطور للوصول إلى لوحة التحكم</p>

            @if (_showError)
            {
                <div class="alert alert-error">بيانات الدخول غير صحيحة</div>
            }

            <form method="post" action="/auth/login">
                <div class="form-group">
                    <label for="username">اسم المستخدم</label>
                    <input id="username" name="username" class="form-control" value="admin" placeholder="admin" required />
                </div>
                <div class="form-group">
                    <label for="password">كلمة المرور</label>
                    <input id="password" name="password" type="password" class="form-control" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn btn-primary btn-block">دخول</button>
            </form>
        </div>
    </div>
</div>

@code {
    private bool _showError;

    protected override void OnInitialized()
    {
        if (Auth.IsAuthenticated)
            Nav.NavigateTo("/dashboard", forceLoad: true);

        _showError = Nav.Uri.Contains("error=invalid", StringComparison.OrdinalIgnoreCase);
    }
}
