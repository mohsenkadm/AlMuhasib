@page "/tenants"
@rendermode InteractiveServer
@using AlMuhasib.Cloud.Core.Entities
@using AlMuhasib.Cloud.Core.Interfaces
@using AlMuhasib.Core.Enums
@using AlMuhasib.Admin.Services
@inject ITenantService TenantService
@inject DeveloperAuthState Auth
@inject NavigationManager Nav

<PageTitle>العملاء — لوحة المطور</PageTitle>

@if (_ready)
{
    <div class="page-header">
        <h1>عملاء النظام</h1>
        <div class="page-actions">
            <a href="/tenants/new" class="btn btn-primary">＋ عميل جديد</a>
            <a href="/notifications" class="btn btn-secondary">✉ إشعارات</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">@_message</div>
    }

    <div class="card">
        <div class="card-body" style="padding:0">
            @if (_tenants.Count == 0)
            {
                <div style="padding:3rem;text-align:center;color:var(--text-muted)">
                    <p style="font-size:1.1rem;margin-bottom:1rem">لا يوجد عملاء مسجلون</p>
                    <a href="/tenants/new" class="btn btn-primary">إنشاء أول عميل</a>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>الشركة</th>
                            <th>النظام</th>
                            <th>الحالة</th>
                            <th>المزامنة</th>
                            <th>انتهاء الترخيص</th>
                            <th>آخر مزامنة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _tenants)
                        {
                            var expired = t.LicenseExpiresAt < DateTime.UtcNow;
                            <tr>
                                <td><strong>@t.CompanyName</strong></td>
                                <td>
                                    <span class="badge @GetSystemBadgeClass(t.ApplicationSystemType)">
                                        @GetSystemLabel(t.ApplicationSystemType)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(t.IsActive ? "badge-success" : "badge-danger")">
                                        @(t.IsActive ? "نشط" : "معطّل")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(t.IsMobileEnabled ? "badge-info" : "badge-warning")">
                                        @(t.IsMobileEnabled ? "مفعّل" : "معطّل")
                                    </span>
                                </td>
                                <td>
                                    @if (expired)
                                    {
                                        <span class="badge badge-danger">@t.LicenseExpiresAt?.ToString("yyyy-MM-dd")</span>
                                    }
                                    else
                                    {
                                        @(t.LicenseExpiresAt?.ToString("yyyy-MM-dd") ?? "—")
                                    }
                                </td>
                                <td>@(t.LastSyncAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td style="white-space:nowrap">
                                    <a href="/tenants/@t.Id" class="btn btn-secondary btn-sm">تعديل</a>
                                    <button class="btn @(t.IsActive ? "btn-warning" : "btn-success") btn-sm"
                                            @onclick="() => ToggleActiveAsync(t)">
                                        @(t.IsActive ? "تعطيل" : "تفعيل")
                                    </button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => ConfirmDelete(t)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_deleteTarget is not null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h3>تأكيد الحذف</h3>
            <p>هل أنت متأكد من حذف العميل <strong>@_deleteTarget.CompanyName</strong>؟</p>
            <p style="color:var(--text-muted);font-size:.9rem">سيتم حذف حسابات التطبيق المرتبطة أيضاً. لا يمكن التراجع عن هذا الإجراء.</p>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CancelDelete">إلغاء</button>
                <button class="btn btn-danger" @onclick="DeleteConfirmedAsync" disabled="@_deleting">
                    @(_deleting ? "جارٍ الحذف..." : "حذف نهائياً")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Tenant> _tenants = [];
    private bool _ready;
    private string? _message;
    private bool _isError;
    private Tenant? _deleteTarget;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }
        await ReloadAsync();
        _ready = true;
    }

    private async Task ReloadAsync() =>
        _tenants = await TenantService.GetAllAsync();

    private async Task ToggleActiveAsync(Tenant tenant)
    {
        _isError = false;
        try
        {
            await TenantService.SetActiveAsync(tenant.Id, !tenant.IsActive);
            await ReloadAsync();
            _message = tenant.IsActive ? "تم تعطيل العميل" : "تم تفعيل العميل";
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private void ConfirmDelete(Tenant tenant) => _deleteTarget = tenant;

    private void CancelDelete() => _deleteTarget = null;

    private async Task DeleteConfirmedAsync()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        _isError = false;
        try
        {
            await TenantService.DeleteAsync(_deleteTarget.Id);
            _message = $"تم حذف العميل «{_deleteTarget.CompanyName}»";
            _deleteTarget = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
            _deleteTarget = null;
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string GetSystemLabel(int type) => type switch
    {
        (int)ApplicationSystemType.CarContracts => "عقود السيارات",
        (int)ApplicationSystemType.HotelManagement => "الفنادق",
        (int)ApplicationSystemType.CarTrading => "بيع وشراء السيارات",
        (int)ApplicationSystemType.RealEstateContracts => "العقارات",
        (int)ApplicationSystemType.GoldShop => "محل الذهب",
        _ => "المحاسبة"
    };

    private static string GetSystemBadgeClass(int type) => type switch
    {
        (int)ApplicationSystemType.CarContracts => "badge-info",
        (int)ApplicationSystemType.HotelManagement => "badge-success",
        (int)ApplicationSystemType.CarTrading => "badge-warning",
        (int)ApplicationSystemType.RealEstateContracts => "badge-primary",
        (int)ApplicationSystemType.GoldShop => "badge-warning",
        _ => "badge-secondary"
    };
}
