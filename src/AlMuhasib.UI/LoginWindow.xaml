<Window x:Class="AlMuhasib.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="تسجيل الدخول - المحاسب"
        Height="700" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Window.Resources>
        <Style x:Key="PasswordToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                            <materialDesign:PackIcon x:Name="Icon"
                                                     Kind="EyeOff"
                                                     Width="20" Height="20"
                                                     Foreground="#90A4AE"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ECEFF1" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Kind" Value="Eye" />
                                <Setter TargetName="Icon" Property="Foreground" Value="#1565C0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0D47A1" Offset="0" />
                        <GradientStop Color="#1565C0" Offset="0.5" />
                        <GradientStop Color="#42A5F5" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1565C0" Offset="0" />
                                <GradientStop Color="#1E88E5" Offset="0.5" />
                                <GradientStop Color="#64B5F6" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.02" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.02" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.18" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Entrance animations ─── -->
        <Storyboard x:Key="WindowEntrance">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.94" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.94" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="BrandEntrance">
            <DoubleAnimation Storyboard.TargetName="BrandPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BrandPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="16" To="0" Duration="0:0:0.45" BeginTime="0:0:0.12">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FormEntrance">
            <DoubleAnimation Storyboard.TargetName="FormPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="FormPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="28" To="0" Duration="0:0:0.5" BeginTime="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.9" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.05" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.05" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="RootCard" Opacity="0" CornerRadius="22" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="0" Opacity="0.35" Color="#0D47A1" />
        </Border.Effect>

        <Grid x:Name="CardScale" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
            </Grid.RenderTransform>

            <Border CornerRadius="22" ClipToBounds="True" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="220" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ═══ HEADER ═══ -->
                    <Grid Grid.Row="0" ClipToBounds="True">
                        <Border CornerRadius="22,22,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0A1628" Offset="0" />
                                    <GradientStop Color="#0D2847" Offset="0.4" />
                                    <GradientStop Color="#1565C0" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Ellipse Width="200" Height="200" Fill="#304DD0E1" Opacity="0.2"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-70,-60,0,0" />
                        <Ellipse Width="160" Height="160" Fill="#403F51B5" Opacity="0.25"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-40" />

                        <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="14,14,0,0"
                                Style="{StaticResource IconButton}"
                                Foreground="White" Opacity="0.75"
                                Width="36" Height="36"
                                Click="CloseButton_Click"
                                ToolTip="إغلاق">
                            <Border Background="#22FFFFFF" CornerRadius="18" Width="36" Height="36">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Button>

                        <StackPanel x:Name="BrandPanel" Opacity="0"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="16" />
                            </StackPanel.RenderTransform>

                            <Grid Width="88" Height="88" Margin="0,0,0,14">
                                <Ellipse x:Name="LogoRing" Width="88" Height="88"
                                         Stroke="#55FFFFFF" StrokeThickness="1.5"
                                         StrokeDashArray="3 5" Opacity="0.5" />
                                <Border Width="64" Height="64" CornerRadius="32"
                                        Background="#28FFFFFF"
                                        BorderBrush="#44FFFFFF" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon x:Name="LogoIcon"
                                                             Kind="CalculatorVariant"
                                                             Width="34" Height="34"
                                                             Foreground="#80DEEA"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             RenderTransformOrigin="0.5,0.5">
                                        <materialDesign:PackIcon.RenderTransform>
                                            <ScaleTransform />
                                        </materialDesign:PackIcon.RenderTransform>
                                    </materialDesign:PackIcon>
                                </Border>
                            </Grid>

                            <TextBlock Text="{x:Static helpers:AppInfo.AppNameAr}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center" />

                            <TextBlock Text="{x:Static helpers:AppInfo.AppNameEn}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#B3E5FC" Opacity="0.9"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />

                            <Border Background="#1FFFFFFF" CornerRadius="14"
                                    Padding="12,4" Margin="0,10,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="{x:Static helpers:AppInfo.VersionLabel}"
                                           FontSize="11" Foreground="#E1F5FE" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ═══ FORM ═══ -->
                    <Border Grid.Row="1" Background="#FAFBFD" CornerRadius="0,0,22,22">
                        <StackPanel x:Name="FormPanel" Opacity="0"
                                    VerticalAlignment="Center"
                                    Margin="36,24,36,28"
                                    RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform Y="28" />
                            </StackPanel.RenderTransform>

                            <TextBlock Text="مرحباً بعودتك"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#1A237E"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="سجّل دخولك للمتابعة إلى لوحة التحكم"
                                       FontSize="13" Foreground="#78909C"
                                       Margin="0,0,0,22" />

                            <!-- Error -->
                            <Border CornerRadius="10"
                                    Background="#FFEBEE"
                                    BorderBrush="#FFCDD2" BorderThickness="1"
                                    Padding="12,10"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0"
                                                             Kind="AlertCircleOutline"
                                                             Width="20" Height="20"
                                                             Foreground="#D32F2F"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="#C62828"
                                               FontSize="12.5"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <TextBox x:Name="UsernameBox"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم المستخدم"
                                     materialDesign:HintAssist.FloatingScale="0.85"
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Account"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource OutlinedTextBox}"
                                     FontSize="14"
                                     Margin="0,0,0,16"
                                     FlowDirection="RightToLeft" />

                            <Grid Margin="0,0,0,10">
                                <PasswordBox x:Name="PasswordBoxHidden"
                                             materialDesign:HintAssist.Hint="كلمة المرور"
                                             materialDesign:HintAssist.FloatingScale="0.85"
                                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                             materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource OutlinedPasswordBox}"
                                             FontSize="14"
                                             FlowDirection="RightToLeft"
                                             Padding="48,10,12,10"
                                             PasswordChanged="PasswordBox_PasswordChanged" />

                                <TextBox x:Name="PasswordBoxVisible"
                                         Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="كلمة المرور"
                                         materialDesign:HintAssist.FloatingScale="0.85"
                                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                         materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource OutlinedTextBox}"
                                         FontSize="14"
                                         FlowDirection="RightToLeft"
                                         Padding="48,10,12,10"
                                         Visibility="Collapsed" />

                                <ToggleButton x:Name="PasswordToggle"
                                              Style="{StaticResource PasswordToggleButton}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              Panel.ZIndex="2"
                                              Checked="PasswordToggle_Changed"
                                              Unchecked="PasswordToggle_Changed" />
                            </Grid>

                            <CheckBox Content="تذكرني"
                                      IsChecked="{Binding RememberMe}"
                                      FontSize="13"
                                      Margin="0,6,0,22"
                                      Foreground="#546E7A" />

                            <Button Command="{Binding LoginCommand}"
                                    Style="{StaticResource LoginPrimaryButton}"
                                    IsDefault="True">
                                <Grid>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="Login" Width="20" Height="20"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="تسجيل الدخول"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                     IsIndeterminate="True"
                                                     Width="22" Height="22"
                                                     Foreground="White" />
                                        <TextBlock Text="جاري التحقق..."
                                                   Foreground="White"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="14" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,22,0,0" Opacity="0.85">
                                <materialDesign:PackIcon Kind="ShieldCheck"
                                                         Width="14" Height="14"
                                                         Foreground="#90A4AE"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,6,0" />
                                <TextBlock FontSize="10" Foreground="#90A4AE">
                                    <Run Text="© 2026 " />
                                    <Run Text="{x:Static helpers:AppInfo.AppNameAr}" />
                                    <Run Text=" — جميع الحقوق محفوظة" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource WindowEntrance}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource BrandEntrance}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource FormEntrance}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource LogoPulse}" />
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Border>
</Window>
