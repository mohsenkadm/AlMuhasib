<Window x:Class="AlMuhasib.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        xmlns:models="clr-namespace:AlMuhasib.UI.Models"
        xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="تسجيل الدخول"
        Icon="{DynamicResource BrandWindowIcon}"
        Height="720" Width="920"
        MinHeight="640" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PasswordToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                            <materialDesign:PackIcon x:Name="Icon" Kind="EyeOff" Width="20" Height="20"
                                                     Foreground="{DynamicResource HintForegroundBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MutedIconBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Kind" Value="Eye"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource HighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumericPadToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="ToolTip" Value="لوحة الأرقام"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                            <materialDesign:PackIcon x:Name="Icon" Kind="Dialpad" Width="20" Height="20"
                                                     Foreground="{DynamicResource HintForegroundBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource HighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource HighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumPadKeyButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="KeyBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#1565C0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="KeyBd" Property="Background" Value="{DynamicResource SearchResultHoverBrush}"/>
                                <Setter TargetName="KeyBd" Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="KeyBd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyBd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="0.94" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="KeyBd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="0.94" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KeyBd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="KeyBd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumPadActionButton" TargetType="Button" BasedOn="{StaticResource NumPadKeyButton}">
            <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource HighlightBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="LoginPrimaryButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="0.5"/>
                        <GradientStop Color="#42A5F5" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1565C0" Offset="0"/>
                                <GradientStop Color="#1E88E5" Offset="0.5"/>
                                <GradientStop Color="#64B5F6" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginHiddenScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>

        <Style x:Key="AdminCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Height" Value="188"/>
            <Setter Property="MinHeight" Value="188"/>
            <Setter Property="MaxHeight" Value="188"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="18" Padding="12,16"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.08" Color="#1565C0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}"/>
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SearchResultHoverBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AdminCardTemplate" DataType="{x:Type models:LoginAdminOption}">
            <Button Style="{StaticResource AdminCardButton}"
                    Command="{Binding DataContext.SelectAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel HorizontalAlignment="Center">
                    <Grid Width="78" Height="78" Margin="0,0,0,12">
                        <Ellipse Width="78" Height="78" Stroke="#E8F4FD" StrokeThickness="2"/>
                        <Ellipse Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{Binding AvatarColorStart}" Offset="0"/>
                                    <GradientStop Color="{Binding AvatarColorEnd}" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                    <TextBlock Text="{Binding RoleDisplay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <Storyboard x:Key="WindowEntrance">
            <DoubleAnimation Storyboard.TargetName="RootCard" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BrandBottomCards"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.55" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BrandBottomCards"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="22" To="0" Duration="0:0:0.55" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="LoginBrandActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" Opacity="0" CornerRadius="24" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.28" Color="#0D47A1"/>
        </Border.Effect>

        <Grid x:Name="CardScale" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
            </Grid.RenderTransform>

            <Border CornerRadius="24" ClipToBounds="True" Background="{DynamicResource CardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ Brand panel (logo + support) — theme aware ═══ -->
                    <Grid Grid.Column="0" ClipToBounds="True">
                        <Border x:Name="BrandPanelChrome" CornerRadius="0,24,24,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#EEF3FA" Offset="0"/>
                                                <GradientStop Color="#D9E7F7" Offset="0.5"/>
                                                <GradientStop Color="#BFD6F0" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0B1A33" Offset="0"/>
                                                        <GradientStop Color="#123A6B" Offset="0.55"/>
                                                        <GradientStop Color="#1E88E5" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Ellipse Width="240" Height="240" Opacity="0.35"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-90,0,0"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#6642A5F5" Offset="0"/>
                                    <GradientStop Color="#0042A5F5" Offset="1"/>
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="0.38" Duration="0:0:4"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.05" Duration="0:0:4"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.05" Duration="0:0:4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>

                        <DockPanel Margin="20,26,20,18">
                            <StackPanel x:Name="BrandBottomCards" DockPanel.Dock="Bottom" Opacity="0">
                                <StackPanel.RenderTransform>
                                    <TranslateTransform Y="22"/>
                                </StackPanel.RenderTransform>

                                <!-- Support card -->
                                <Border x:Name="SupportCard" CornerRadius="18" Padding="14" Margin="0,0,0,10" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F7FBFF"/>
                                            <Setter Property="BorderBrush" Value="#C7D8EC"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="#28FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12" LastChildFill="False">
                                            <Border DockPanel.Dock="Right" Width="38" Height="38" CornerRadius="12">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E4F0EA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Background" Value="#33A5D6A7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <materialDesign:PackIcon Kind="Headset" Width="18" Height="18"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="#4F7D6A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Foreground" Value="#A5D6A7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="الدعم الفني" FontSize="14" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#163A5C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="نحن هنا لمساعدتك" FontSize="11.5" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#5E7B9A"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C5D8EE"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Command="{Binding OpenWhatsAppSupportCommand}"
                                                    Style="{StaticResource LoginBrandActionButton}"
                                                    Background="#4A7A68"
                                                    BorderBrush="#6B9A87" BorderThickness="1"
                                                    ToolTip="فتح واتساب الدعم">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Whatsapp" Width="17" Height="17"
                                                                             Foreground="#EAF6F0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="واتساب" Margin="7,0,0,0" Foreground="#F4FAF7" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2"
                                                    Command="{Binding ToggleSupportPhoneCommand}"
                                                    ToolTip="عرض رقم هاتف الدعم">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LoginBrandActionButton}">
                                                        <Setter Property="Background" Value="#EAF1F8"/>
                                                        <Setter Property="BorderBrush" Value="#B7CBE0"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="#1E4A73"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Background" Value="#1FFFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="PhoneOutline" Width="16" Height="16"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock Text="الهاتف" Margin="7,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Border Margin="0,10,0,0" CornerRadius="12" Padding="10,9" BorderThickness="1"
                                                Visibility="{Binding IsSupportPhoneVisible, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E8F2FB"/>
                                                    <Setter Property="BorderBrush" Value="#A9C5DF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                            <Setter Property="Background" Value="#22000000"/>
                                                            <Setter Property="BorderBrush" Value="#40B3E5FC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="PhoneInTalk" Width="15" Height="15" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Foreground" Value="#81D4FA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock Text="{Binding SupportPhoneDisplay}"
                                                           FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0"
                                                           VerticalAlignment="Center" FontFamily="Consolas">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#0D47A1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Foreground" Value="#E3F2FD"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Trial card -->
                                <Border CornerRadius="18" Padding="14" BorderThickness="1"
                                        Visibility="{Binding ShowTrialCard, Converter={StaticResource BoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F7F1E6"/>
                                            <Setter Property="BorderBrush" Value="#D2C2A4"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="#3A7A6540"/>
                                                    <Setter Property="BorderBrush" Value="#559C8563"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Width="28" Height="28" CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EADFCB"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Background" Value="#559C8563"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <materialDesign:PackIcon Kind="KeyVariant" Width="15" Height="15"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Foreground" Value="#7A6548"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                        <Setter Property="Foreground" Value="#F0E6D2"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Border>
                                                <TextBlock Text="تفعيل النظام" FontSize="13.5" FontWeight="Bold"
                                                           Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#5C4A30"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F0E6D2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TrialDaysText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#7A6A50"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                                <Setter Property="Foreground" Value="#D9CBB0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Command="{Binding OpenDesktopActivationCommand}"
                                                Style="{StaticResource LoginBrandActionButton}"
                                                Background="#7A6548"
                                                BorderBrush="#A08A66" BorderThickness="1"
                                                MinWidth="78" VerticalAlignment="Center"
                                                ToolTip="فتح نافذة التفعيل">
                                            <TextBlock Text="تفعيل" Foreground="#F7F1E6" VerticalAlignment="Center"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Brand identity -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,4,4,18">
                                <!-- White Qayd mark needs a solid dark plate in light mode -->
                                <Border Width="88" Height="88" CornerRadius="28" Margin="0,0,0,18"
                                        HorizontalAlignment="Center" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0F3A6B"/>
                                            <Setter Property="BorderBrush" Value="#1A5A9C"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.22" Color="#0D47A1"/>
                                    </Border.Effect>
                                    <Image Source="{DynamicResource BrandMarkImage}"
                                           Width="58" Height="58" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="{x:Static helpers:AppInfo.AppNameAr}"
                                           FontSize="27" FontWeight="Bold"
                                           HorizontalAlignment="Center" TextAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#123A63"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{x:Static helpers:AppInfo.AppNameEn}"
                                           FontSize="12.5" HorizontalAlignment="Center" Margin="0,5,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4D74A3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Foreground" Value="#B3E5FC"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border HorizontalAlignment="Center" Margin="0,14,0,0"
                                        CornerRadius="20" Padding="14,6" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#C5D6EA"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Background" Value="#24FFFFFF"/>
                                                    <Setter Property="BorderBrush" Value="#40FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{x:Static helpers:AppInfo.VersionLabel}"
                                               FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#1E4E7A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="Foreground" Value="#E1F5FE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="اختر المستخدم ثم أكمل تسجيل الدخول"
                                           FontSize="12.5" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,20,0,0" MaxWidth="230" LineHeight="19">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#5B7899"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Foreground" Value="#C5D8EE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </Grid>

                    <!-- ═══ Login content ═══ -->
                    <Grid Grid.Column="1" Background="{DynamicResource BackgroundBrush}">
                        <Button x:Name="CloseButton" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="16,16,0,0" Style="{StaticResource IconButton}"
                                Foreground="{DynamicResource TextSecondaryBrush}" Width="36" Height="36"
                                Click="CloseButton_Click" ToolTip="إغلاق">
                            <Border Background="{DynamicResource MutedIconBackgroundBrush}" CornerRadius="18" Width="36" Height="36">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Button>

                        <Button Command="{Binding ToggleThemeCommand}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,16,16,0" Style="{StaticResource IconButton}"
                                Width="40" Height="40"
                                ToolTip="{Binding ThemeToggleToolTip}">
                            <Border Background="{DynamicResource MutedIconBackgroundBrush}" CornerRadius="20" Width="40" Height="40"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <materialDesign:PackIcon Width="20" Height="20"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="WeatherNight"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                    <Setter Property="Kind" Value="WhiteBalanceSunny"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </Border>
                        </Button>

                        <Grid Margin="40,36,40,32">
                            <!-- Error banner -->
                            <Border VerticalAlignment="Top" CornerRadius="10"
                                    Background="{DynamicResource DashboardKpiRedLightBrush}" BorderBrush="#FFCDD2" BorderThickness="1"
                                    Padding="12,10" Panel.ZIndex="10"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                                             Foreground="#D32F2F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}"
                                               Foreground="#C62828" FontSize="12.5" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <!-- Step 1: Select admin -->
                            <Grid x:Name="AdminStepPanel"
                                  Visibility="{Binding IsSelectingAdmin, Converter={StaticResource BoolToVis}}">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Grid.RenderTransform>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0"
                                                Background="{DynamicResource PrimaryHueLightBrush}">
                                            <materialDesign:PackIcon Kind="AccountGroupOutline" Width="22" Height="22"
                                                                     Foreground="{DynamicResource HighlightBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="من يقوم بتسجيل الدخول؟"
                                                       FontSize="23" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="اختر بطاقة المستخدم للمتابعة إلى كلمة المرور"
                                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border CornerRadius="18" Background="{DynamicResource CardBrush}" Padding="12,14" Margin="0,18,0,0"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            MinHeight="390" MaxHeight="520" Height="410">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.08" Color="#1565C0"/>
                                        </Border.Effect>
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding IsLoadingAdmins, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True" Width="36" Height="36"/>
                                                <TextBlock Text="جاري تحميل المستخدمين..."
                                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                            </StackPanel>

                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          CanContentScroll="False"
                                                          PanningMode="VerticalOnly"
                                                          Visibility="{Binding IsLoadingAdmins, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <ScrollViewer.Resources>
                                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource LoginHiddenScrollBar}"/>
                                                </ScrollViewer.Resources>
                                                <ItemsControl ItemsSource="{Binding AdminUsers}"
                                                              ItemTemplate="{StaticResource AdminCardTemplate}"
                                                              VerticalAlignment="Top">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="3"
                                                                         VerticalAlignment="Top"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="اضغط على بطاقة المستخدم للمتابعة"
                                               FontSize="12" Foreground="{DynamicResource HintForegroundBrush}"
                                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Step 2: Password -->
                            <Grid x:Name="PasswordStepPanel" Opacity="0"
                                  Visibility="{Binding IsEnteringPassword, Converter={StaticResource BoolToVis}}">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="40"/>
                                </Grid.RenderTransform>

                                <StackPanel VerticalAlignment="Center" MaxWidth="420">
                                    <Button Command="{Binding BackToAdminSelectionCommand}"
                                            Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                                            Margin="0,0,0,10" Padding="8,4"
                                            Foreground="{DynamicResource TextSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="اختيار مستخدم آخر" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Grid Width="80" Height="80" Margin="0,0,0,10">
                                            <Ellipse Width="80" Height="80" Stroke="#BBDEFB" StrokeThickness="2"/>
                                            <Ellipse Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{Binding SelectedAdmin.AvatarColorStart}" Offset="0"/>
                                                        <GradientStop Color="{Binding SelectedAdmin.AvatarColorEnd}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SelectedAdmin.Initials}" FontSize="24" FontWeight="Bold"
                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="{Binding SelectedAdmin.FullName}"
                                                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="أدخل كلمة المرور للمتابعة"
                                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <PasswordBox x:Name="PasswordBoxHidden"
                                                     materialDesign:HintAssist.Hint="كلمة المرور"
                                                     materialDesign:HintAssist.FloatingScale="0.85"
                                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                     materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                                     materialDesign:HintAssist.IsFloating="True"
                                                     Style="{StaticResource OutlinedPasswordBox}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                     FontSize="14" FlowDirection="RightToLeft"
                                                     Padding="48,10,48,10"
                                                     PasswordChanged="PasswordBox_PasswordChanged"/>

                                        <TextBox x:Name="PasswordBoxVisible"
                                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="كلمة المرور"
                                                 materialDesign:HintAssist.FloatingScale="0.85"
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Style="{StaticResource OutlinedTextBox}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                                 FontSize="14" FlowDirection="RightToLeft"
                                                 Padding="48,10,48,10" Visibility="Collapsed"/>

                                        <ToggleButton x:Name="PasswordToggle"
                                                      Style="{StaticResource PasswordToggleButton}"
                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Margin="10,0,0,0" Panel.ZIndex="2"
                                                      Checked="PasswordToggle_Changed"
                                                      Unchecked="PasswordToggle_Changed"/>

                                        <ToggleButton x:Name="NumericPadToggle"
                                                      Style="{StaticResource NumericPadToggleButton}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Panel.ZIndex="2"
                                                      Checked="NumericPadToggle_Changed"
                                                      Unchecked="NumericPadToggle_Changed"
                                                      ToolTip="لوحة الأرقام (للأجهزة بدون كيبورد)"/>
                                    </Grid>

                                    <Border x:Name="NumericPadPanel"
                                            Visibility="Collapsed" Opacity="0"
                                            Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="16"
                                            BorderBrush="{DynamicResource HighlightBorderBrush}" BorderThickness="1"
                                            Padding="10,12" Margin="0,0,0,8"
                                            FlowDirection="LeftToRight">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="16"/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.1" Color="#1565C0"/>
                                        </Border.Effect>
                                        <UniformGrid Columns="3" Rows="4">
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="1" Tag="1" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="2" Tag="2" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="3" Tag="3" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="4" Tag="4" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="5" Tag="5" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="6" Tag="6" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="7" Tag="7" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="8" Tag="8" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="9" Tag="9" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadActionButton}" Click="NumPadBackspace_Click" ToolTip="حذف"
                                                    FlowDirection="RightToLeft">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="BackspaceOutline" Width="20" Height="20"
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="حذف" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource NumPadKeyButton}" Content="0" Tag="0" Click="NumPadDigit_Click"/>
                                            <Button Style="{StaticResource NumPadActionButton}" Click="NumPadClose_Click" ToolTip="إغلاق اللوحة"
                                                    FlowDirection="RightToLeft">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="KeyboardOffOutline" Width="20" Height="20"
                                                                             VerticalAlignment="Center"/>
                                                    <TextBlock Text="إغلاق" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </Border>

                                    <CheckBox Content="تذكرني" IsChecked="{Binding RememberMe}"
                                              FontSize="13" Margin="0,4,0,16" Foreground="{DynamicResource TextSecondaryBrush}"/>

                                    <Button Command="{Binding LoginCommand}"
                                            Style="{StaticResource LoginPrimaryButton}" IsDefault="True">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                <materialDesign:PackIcon Kind="Login" Width="20" Height="20"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="تسجيل الدخول" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                             IsIndeterminate="True" Width="22" Height="22" Foreground="White"/>
                                                <TextBlock Text="جاري التحقق..." Foreground="White"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Step 3: Branch selection (multi-branch users only) -->
                            <Grid x:Name="BranchStepPanel" Opacity="0"
                                  Visibility="{Binding IsSelectingBranch, Converter={StaticResource BoolToVis}}">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="40"/>
                                </Grid.RenderTransform>

                                <StackPanel VerticalAlignment="Center" MaxWidth="440">
                                    <Button Command="{Binding BackToPasswordCommand}"
                                            Style="{StaticResource FlatButton}" HorizontalAlignment="Right"
                                            Margin="0,0,0,10" Padding="8,4"
                                            Foreground="{DynamicResource TextSecondaryBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="رجوع" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,18">
                                        <Border Width="56" Height="56" CornerRadius="28" Margin="0,0,0,12"
                                                Background="{DynamicResource PrimaryHueLightBrush}" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="SourceBranch" Width="28" Height="28"
                                                                     Foreground="{DynamicResource HighlightBrush}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="اختر الفرع" FontSize="22" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="لديك صلاحية على أكثر من فرع — اختر فرع العمل لهذه الجلسة"
                                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                                   TextAlignment="Center" Margin="0,6,0,0" MaxWidth="360"/>
                                    </StackPanel>

                                    <Border CornerRadius="16" Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            Padding="10" MaxHeight="300">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding AvailableBranches}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Margin="0,0,0,8" Cursor="Hand"
                                                                Command="{Binding DataContext.SelectBranchAndContinueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Card" CornerRadius="12" Padding="14,12"
                                                                                        Background="{DynamicResource CardBrush}"
                                                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5">
                                                                                    <ContentPresenter/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource SearchResultHoverBrush}"/>
                                                                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsPressed" Value="True">
                                                                                        <Setter TargetName="Card" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                                                        Background="{DynamicResource PrimaryHueLightBrush}" Margin="0,0,12,0">
                                                                    <materialDesign:PackIcon Kind="Store" Width="20" Height="20"
                                                                                             Foreground="{DynamicResource HighlightBrush}"
                                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                               FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                    <TextBlock FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0">
                                                                        <Run Text="الرمز: "/><Run Text="{Binding Code}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                                <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft"
                                                                                         Width="20" Height="20"
                                                                                         Foreground="#90CAF9"
                                                                                         VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,16" Opacity="0.85">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="14" Height="14"
                                                     Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock FontSize="10" Foreground="{DynamicResource HintForegroundBrush}">
                                <Run Text="© 2026 "/>
                                <Run Text="{x:Static helpers:AppInfo.AppNameAr}"/>
                                <Run Text=" — جميع الحقوق محفوظة"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource WindowEntrance}"/>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Border>
</Window>
