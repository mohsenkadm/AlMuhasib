<Window x:Class="AlMuhasib.UI.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoginViewModel, IsDesignTimeCreatable=False}"
        Title="تسجيل الدخول - المحاسب"
        Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Window.Resources>
        <!-- Password visibility toggle style -->
        <Style x:Key="PasswordToggleButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <materialDesign:PackIcon x:Name="Icon"
                                                     Kind="EyeOff"
                                                     Width="20" Height="20"
                                                     Foreground="#9E9E9E"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Icon" Property="Kind" Value="Eye" />
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border with rounded corners and shadow -->
    <Border CornerRadius="16"
            Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.25" Color="#000000" />
        </Border.Effect>
        <Border CornerRadius="16" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Gradient Header -->
                    <RowDefinition Height="*" />      <!-- Form -->
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════ -->
                <!-- GRADIENT HEADER                            -->
                <!-- ═══════════════════════════════════════════ -->
                <Border Grid.Row="0" Height="200" CornerRadius="16,16,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A237E" Offset="0" />
                            <GradientStop Color="#283593" Offset="0.4" />
                            <GradientStop Color="#3949AB" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Close button -->
                        <Button HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="12,12,0,0"
                                Style="{StaticResource IconButton}"
                                Foreground="White"
                                Opacity="0.7"
                                Width="32" Height="32"
                                Click="CloseButton_Click"
                                ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>

                        <!-- Logo + App Name -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- App Icon -->
                            <Border Width="70" Height="70"
                                    CornerRadius="35"
                                    Background="#26FFFFFF"
                                    HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CalculatorVariant"
                                                         Width="38" Height="38"
                                                         Foreground="#FFB300"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="نظام المحاسب"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />

                            <TextBlock Text="الإصدار 1.0.0"
                                       FontSize="11"
                                       Foreground="White"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- LOGIN FORM                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            Margin="40,28,40,32">

                    <!-- Error message snackbar-style -->
                    <Border CornerRadius="8"
                            Background="#FFEBEE"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0"
                                                     Kind="AlertCircleOutline"
                                                     Width="20" Height="20"
                                                     Foreground="#D32F2F"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       Foreground="#C62828"
                                       FontSize="12.5"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Username -->
                    <TextBox x:Name="UsernameBox"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="اسم المستخدم"
                             materialDesign:HintAssist.FloatingScale="0.85"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Account"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource OutlinedTextBox}"
                             FontSize="14"
                             Margin="0,0,0,18"
                             FlowDirection="RightToLeft" />

                    <!-- Password field -->
                    <Grid Margin="0,0,0,12">
                        <PasswordBox x:Name="PasswordBoxHidden"
                                     materialDesign:HintAssist.Hint="كلمة المرور"
                                     materialDesign:HintAssist.FloatingScale="0.85"
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource OutlinedPasswordBox}"
                                     FontSize="14"
                                     FlowDirection="RightToLeft"
                                     PasswordChanged="PasswordBox_PasswordChanged" />

                        <TextBox x:Name="PasswordBoxVisible"
                                 Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="كلمة المرور"
                                 materialDesign:HintAssist.FloatingScale="0.85"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Lock"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource OutlinedTextBox}"
                                 FontSize="14"
                                 FlowDirection="RightToLeft"
                                 Visibility="Collapsed" />

                        <!-- Show/hide password toggle -->
                        <ToggleButton x:Name="PasswordToggle"
                                      Style="{StaticResource PasswordToggleButton}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      Checked="PasswordToggle_Changed"
                                      Unchecked="PasswordToggle_Changed" />
                    </Grid>

                    <!-- Remember me -->
                    <CheckBox Content="تذكرني"
                              IsChecked="{Binding RememberMe}"
                              FontSize="13"
                              Margin="0,4,0,20"
                              Foreground="#616161" />

                    <!-- Login Button -->
                    <Button Command="{Binding LoginCommand}"
                            Height="48"
                            FontSize="16"
                            FontWeight="SemiBold"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            IsDefault="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1A237E" Offset="0" />
                                            <GradientStop Color="#3949AB" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </Button.Style>

                        <Grid>
                            <!-- Normal content -->
                            <TextBlock Text="تسجيل الدخول"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                            <!-- Loading spinner -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                             IsIndeterminate="True"
                                             Width="22" Height="22"
                                             Foreground="White" />
                                <TextBlock Text="جاري تسجيل الدخول..."
                                           Foreground="White"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Footer -->
                    <TextBlock Text="© 2026 نظام المحاسب - جميع الحقوق محفوظة"
                               FontSize="10"
                               Foreground="#BDBDBD"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
