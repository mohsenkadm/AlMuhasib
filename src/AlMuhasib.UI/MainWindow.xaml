<Window x:Class="AlMuhasib.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:AlMuhasib.UI"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        xmlns:views="clr-namespace:AlMuhasib.UI.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Title="المحاسب - AlMuhasib"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="{DynamicResource NormalFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="Auto" />
            <!-- Main Content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SIDEBAR (RIGHT side in RTL)                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradientBrush}"
                CornerRadius="0"
                Effect="{x:Null}">
            <Border.Width>
                <Binding Path="IsSidebarExpanded">
                    <Binding.Converter>
                        <local:BoolToWidthConverter ExpandedWidth="260" CollapsedWidth="72" />
                    </Binding.Converter>
                </Binding>
            </Border.Width>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Logo/Brand -->
                    <RowDefinition Height="*" />      <!-- Nav Items -->
                    <RowDefinition Height="Auto" />   <!-- User Section -->
                </Grid.RowDefinitions>

                <!-- BRAND / LOGO -->
                <Border Grid.Row="0" Padding="16,20,16,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="CalculatorVariant"
                                                 Width="36" Height="36"
                                                 Foreground="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="المحاسب"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="نظام المحاسبة المتكامل"
                                       FontSize="10"
                                       Foreground="{DynamicResource SidebarForeground}"
                                       Opacity="0.7"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Separator Grid.Row="0"
                           VerticalAlignment="Bottom"
                           Background="#FFFFFF"
                           Opacity="0.12"
                           Margin="16,0" />

                <!-- NAVIGATION MENU -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,8">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <!-- Regular menu item (non-group) -->
                                    <Button Command="{Binding DataContext.SelectMenuItemCommand, 
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Cursor="Hand"
                                            Height="44"
                                            Margin="0,2"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0">
                                        <Button.Visibility>
                                            <Binding Path="IsGroupHeader">
                                                <Binding.Converter>
                                                    <local:InverseBoolToVisibilityConverter />
                                                </Binding.Converter>
                                            </Binding>
                                        </Button.Visibility>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    CornerRadius="8"
                                                                    Padding="12,0"
                                                                    Background="Transparent">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <materialDesign:PackIcon Grid.Column="0"
                                                                                             Kind="{Binding Icon}"
                                                                                             Width="22" Height="22"
                                                                                             VerticalAlignment="Center"
                                                                                             Foreground="{DynamicResource SidebarForeground}" />

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Title}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="14,0,0,0"
                                                                               FontSize="13.5"
                                                                               FontWeight="Medium"
                                                                               Foreground="{DynamicResource SidebarForeground}"
                                                                               Visibility="{Binding DataContext.IsSidebarExpanded,
                                                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{DynamicResource SidebarSelected}" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background"
                                                                            Value="{DynamicResource SidebarHover}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Group header (expandable) -->
                                    <StackPanel Visibility="{Binding IsGroupHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Command="{Binding DataContext.SelectMenuItemCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                Height="44"
                                                Margin="0,2"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Bd"
                                                                        CornerRadius="8"
                                                                        Padding="12,0"
                                                                        Background="Transparent">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <materialDesign:PackIcon Grid.Column="0"
                                                                                                 Kind="{Binding Icon}"
                                                                                                 Width="22" Height="22"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Foreground="{DynamicResource SidebarForeground}" />

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Title}"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="14,0,0,0"
                                                                                   FontSize="13.5"
                                                                                   FontWeight="Medium"
                                                                                   Foreground="{DynamicResource SidebarForeground}"
                                                                                   Visibility="{Binding DataContext.IsSidebarExpanded,
                                                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                                                       Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                                        <materialDesign:PackIcon Grid.Column="2"
                                                                                                 Width="18" Height="18"
                                                                                                 VerticalAlignment="Center"
                                                                                                 Foreground="{DynamicResource SidebarForeground}"
                                                                                                 Opacity="0.6"
                                                                                                 Visibility="{Binding DataContext.IsSidebarExpanded,
                                                                                                     RelativeSource={RelativeSource AncestorType=Window},
                                                                                                     Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <materialDesign:PackIcon.Style>
                                                                                <Style TargetType="materialDesign:PackIcon">
                                                                                    <Setter Property="Kind" Value="ChevronDown" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                            <Setter Property="Kind" Value="ChevronUp" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </materialDesign:PackIcon.Style>
                                                                        </materialDesign:PackIcon>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background"
                                                                                Value="{DynamicResource SidebarHover}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Children (sub-items) -->
                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      Margin="20,0,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectMenuItemCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Cursor="Hand"
                                                            Height="38"
                                                            Margin="0,1"
                                                            HorizontalContentAlignment="Stretch"
                                                            Padding="0"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Bd"
                                                                                    CornerRadius="6"
                                                                                    Padding="10,0"
                                                                                    Background="Transparent">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="Auto" />
                                                                                        <ColumnDefinition Width="*" />
                                                                                    </Grid.ColumnDefinitions>

                                                                                    <materialDesign:PackIcon Grid.Column="0"
                                                                                                             Kind="{Binding Icon}"
                                                                                                             Width="18" Height="18"
                                                                                                             VerticalAlignment="Center"
                                                                                                             Foreground="{DynamicResource SidebarForeground}"
                                                                                                             Opacity="0.8" />

                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Title}"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="10,0,0,0"
                                                                                               FontSize="12.5"
                                                                                               Foreground="{DynamicResource SidebarForeground}"
                                                                                               Opacity="0.9"
                                                                                               Visibility="{Binding DataContext.IsSidebarExpanded,
                                                                                                   RelativeSource={RelativeSource AncestorType=Window},
                                                                                                   Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                </Grid>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background"
                                                                                            Value="{DynamicResource SidebarSelected}" />
                                                                                </DataTrigger>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="Bd" Property="Background"
                                                                                            Value="{DynamicResource SidebarHover}" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- USER SECTION (bottom) -->
                <Border Grid.Row="2" Padding="12,12">
                    <Grid>
                        <Separator VerticalAlignment="Top"
                                   Background="#FFFFFF"
                                   Opacity="0.12"
                                   Margin="4,-12,4,0" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- User Avatar -->
                            <Border Grid.Column="0"
                                    Width="38" Height="38"
                                    CornerRadius="19"
                                    Background="{DynamicResource SidebarSelected}">
                                <materialDesign:PackIcon Kind="Account"
                                                         Width="22" Height="22"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White" />
                            </Border>

                            <!-- Username -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LoggedInUsername}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <!-- Logout Button -->
                            <Button Grid.Column="2"
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="تسجيل الخروج"
                                    Style="{StaticResource IconButton}"
                                    Foreground="{DynamicResource SidebarForeground}"
                                    Width="36" Height="36"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN AREA (LEFT side in RTL)                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Top Bar -->
                <RowDefinition Height="*" />      <!-- Content -->
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0"
                    Style="{StaticResource ModernTopBar}">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Toggle -->
                        <ColumnDefinition Width="Auto" />  <!-- Page Title -->
                        <ColumnDefinition Width="*" />     <!-- Spacer -->
                        <ColumnDefinition Width="Auto" />  <!-- Search -->
                        <ColumnDefinition Width="Auto" />  <!-- Date -->
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar Toggle -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="طي/فتح القائمة"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="Menu" Width="24" Height="24" />
                    </Button>

                    <!-- Page Title -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding PageTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Foreground="{DynamicResource MaterialDesignBody}" />

                    <!-- Search Box -->
                    <TextBox Grid.Column="3"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             Margin="8,0"
                             MinWidth="280"
                             VerticalAlignment="Center" />

                    <!-- Date & Time -->
                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="8,0,4,0">
                        <materialDesign:PackIcon Kind="CalendarToday"
                                                 Width="18" Height="18"
                                                 VerticalAlignment="Center"
                                                 Foreground="#757575"
                                                 Margin="0,0,6,0" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#616161">
                            <Run Text="{Binding CurrentHijriDate, Mode=OneWay}" />
                            <Run Text=" | " />
                            <Run Text="{Binding CurrentGregorianDate, Mode=OneWay}" />
                            <Run Text=" | " />
                            <Run Text="{Binding CurrentTime, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT AREA -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BackgroundBrush}"
                    Padding="24,20">
                <Grid>
                    <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                            <views:ProductsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
                            <views:CategoriesView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                            <views:CustomersView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
                            <views:SuppliersView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PurchaseInvoiceViewModel}">
                            <views:PurchaseInvoiceView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SalesInvoiceViewModel}">
                            <views:SalesInvoiceView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallmentInvoiceViewModel}">
                            <views:InstallmentInvoiceView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallmentsViewModel}">
                            <views:InstallmentsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CashBankViewModel}">
                            <views:CashBankView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:WarehousesViewModel}">
                            <views:WarehousesView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:VouchersViewModel}">
                            <views:VouchersView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ExpenseViewModel}">
                            <views:ExpenseView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:InvestorsViewModel}">
                            <views:InvestorsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SalesReportViewModel}">
                            <views:SalesReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PurchasesReportViewModel}">
                            <views:PurchasesReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfitReportViewModel}">
                            <views:ProfitReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallmentsReportViewModel}">
                            <views:InstallmentsReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:InstallmentDetailReportViewModel}">
                            <views:InstallmentDetailReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PaidInstallmentsReportViewModel}">
                            <views:PaidInstallmentsReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:UnpaidInstallmentsReportViewModel}">
                            <views:UnpaidInstallmentsReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:OverdueReportViewModel}">
                            <views:OverdueReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CustomerStatementViewModel}">
                            <views:CustomerStatementView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SupplierStatementViewModel}">
                            <views:SupplierStatementView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ExpensesReportViewModel}">
                            <views:ExpensesReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:IncomeExpenseReportViewModel}">
                            <views:IncomeExpenseReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:WarehouseReportViewModel}">
                            <views:WarehouseReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:InvestorsReportViewModel}">
                            <views:InvestorsReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CashFlowReportViewModel}">
                            <views:CashFlowReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:BalanceSheetViewModel}">
                            <views:BalanceSheetView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                            <views:UsersView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PermissionsViewModel}">
                            <views:PermissionsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
                            <views:AuditLogView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
                            <views:SetupWizardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:CapitalAdjustmentViewModel}">
                            <views:CapitalAdjustmentView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
                            <views:BackupRestoreView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>

                <!-- Permission Snackbar -->
                <materialDesign:Snackbar x:Name="MainSnackbar"
                                         MessageQueue="{Binding SnackbarQueue}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,0,16" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- EXIT DIALOG OVERLAY                          -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.ColumnSpan="2"
              Visibility="{Binding IsExitDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000">

            <!-- Blurred dark overlay -->
            <Border Background="#80000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Dialog Card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="520"
                    Background="White" CornerRadius="20"
                    Padding="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.9" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.9" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Gradient Header -->
                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="32,28"
                            Background="{StaticResource PrimaryGradientBrush}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="#30FFFFFF" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ExitToApp" Width="32" Height="32"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="هل تريد الخروج؟"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="يمكنك إنشاء نسخة احتياطية قبل المغادرة"
                                       FontSize="13"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup Status (shown during backup) -->
                    <Border Grid.Row="1" Padding="24,12"
                            Visibility="{Binding IsExitBackupInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         IsIndeterminate="True" Height="4" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ExitBackupStatus}"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="28,24,28,8" Orientation="Vertical">
                        <!-- Backup and Exit -->
                        <Button Command="{Binding ExitWithBackupCommand}"
                                IsEnabled="{Binding IsExitBackupInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,0,10"
                                Height="52"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExitDialogButton}">
                                    <Setter Property="Background" Value="{StaticResource SuccessGradientBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#2E7D32"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseExport" Width="22" Height="22"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="نسخ احتياطي ثم خروج" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="DemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Exit Without Backup -->
                        <Button Command="{Binding ExitApplicationCommand}"
                                IsEnabled="{Binding IsExitBackupInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,0,10"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExitDialogButton}">
                                    <Setter Property="Background" Value="{StaticResource DangerGradientBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#C62828"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ExitToApp" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="خروج بدون نسخ" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Cancel -->
                    <Border Grid.Row="3" Padding="28,0,28,20">
                        <Button Command="{Binding CancelExitCommand}"
                                IsEnabled="{Binding IsExitBackupInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                HorizontalAlignment="Stretch"
                                Height="44"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExitDialogButton}">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#616161"/>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="إلغاء" FontSize="14" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
