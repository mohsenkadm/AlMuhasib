                <controls:ToastHost x:Name="AppToastHost"
                                    Panel.ZIndex="500"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="20,12,0,0"/>
                </Grid>
            </Border>

            <!-- Quick assist dim overlay -->
            <Border Background="#33000000"
                    Visibility="{Binding IsQuickAssistOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="90"
                    MouseLeftButtonDown="QuickAssistBackdrop_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsQuickAssistOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Quick Assist FAB (bottom-right — away from invoice action buttons on the left) -->
            <Grid HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="0,0,20,68"
                  Panel.ZIndex="100">
                <StackPanel VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Panel.ZIndex="1">
                    <!-- Action buttons panel -->
                    <Border x:Name="QuickAssistPanel"
                            Background="White"
                            CornerRadius="16"
                            Padding="10"
                            Margin="0,0,0,12"
                            MinWidth="220"
                            Visibility="{Binding IsQuickAssistOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            RenderTransformOrigin="0.5,1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#1565C0"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuickAssistOpen}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                     From="0.7" To="1" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.22"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="أدوات مساعدة"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1565C0"
                                       Margin="4,2,4,10"/>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding OpenPrintSettingsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E3F2FD" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="PrinterSettings" Width="18" Height="18"
                                                                 Foreground="#1565C0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="إعدادات الطباعة" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding OpenCalculatorCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#FFF3E0" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="Calculator" Width="18" Height="18"
                                                                 Foreground="#EF6C00"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="حاسبة ويندوز" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding OpenOnScreenKeyboardCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#F3E5F5" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="Keyboard" Width="18" Height="18"
                                                                 Foreground="#7B1FA2"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="لوحة المفاتيح" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding GoToDashboardCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E8F5E9" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18"
                                                                 Foreground="#2E7D32"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="لوحة التحكم" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding GoToBackupCommand}"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#ECEFF1" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="DatabaseExport" Width="18" Height="18"
                                                                 Foreground="#455A64"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="نسخ احتياطي" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding OpenSystemUpdateCommand}"
                                    Margin="0,8,0,0"
                                    IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E3F2FD" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="CloudDownload" Width="18" Height="18"
                                                                 Foreground="#1565C0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تحديث النظام" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    Margin="0,8,0,0"
                                    IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E8F5E9" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="CloudSync" Width="18" Height="18"
                                                                 Foreground="#2E7D32"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="فحص التحديث الآن" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding RestartFeatureTourCommand}"
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E0F7FA" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="MapMarkerPath" Width="18" Height="18"
                                                                 Foreground="#00838F"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="جولة التعريف" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding OpenHelpVideosCommand}"
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E3F2FD" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18"
                                                                 Foreground="#1565C0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="فيديوهات تعريفية" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding OpenHelpWhatsAppCommand}"
                                    Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E8F5E9" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18"
                                                                 Foreground="#25D366"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="دعم واتساب" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="ملف العمل"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#455A64"
                                       Margin="4,12,4,6"/>
                            <TextBlock Text="{Binding WorkspaceProfileDisplay, StringFormat='الحالي: {0}'}"
                                       FontSize="11" Foreground="#78909C" Margin="4,0,4,8"/>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding SeedDemoDataCommand}"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#FFFDE7" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="DatabasePlus" Width="18" Height="18"
                                                                 Foreground="#F9A825"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="بيانات تجريبية" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                            <UniformGrid Columns="3" Margin="0,0,0,4">
                                <Button Style="{StaticResource QuickAssistActionButton}"
                                        Command="{Binding SetWorkspaceProfileFullCommand}"
                                        Margin="2" Padding="6,4" FontSize="11"
                                        Content="كامل"/>
                                <Button Style="{StaticResource QuickAssistActionButton}"
                                        Command="{Binding SetWorkspaceProfileCashierCommand}"
                                        Margin="2" Padding="6,4" FontSize="11"
                                        Content="كاشير"/>
                                <Button Style="{StaticResource QuickAssistActionButton}"
                                        Command="{Binding SetWorkspaceProfileAccountantCommand}"
                                        Margin="2" Padding="6,4" FontSize="11"
                                        Content="محاسب"/>
                            </UniformGrid>
                            <Button Style="{StaticResource QuickAssistActionButton}"
                                    Command="{Binding ToggleMenuCustomizerCommand}"
                                    Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#E8EAF6" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="Tune" Width="18" Height="18"
                                                                 Foreground="#3949AB"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="تخصيص القائمة" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- FAB -->
                    <Button Style="{StaticResource QuickAssistFab}"
                            Command="{Binding ToggleQuickAssistCommand}"
                            ToolTip="أدوات مساعدة وسريعة">
                        <materialDesign:PackIcon Kind="Tools"
                                                 Width="20" Height="20"
                                                 Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
            </Grid><!-- end content row -->

        </Grid><!-- end main column -->

        </Grid><!-- end body grid -->

        <!-- ═══════════════════════════════════════════ -->
        <!-- EXIT DIALOG OVERLAY                          -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsExitDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="1000">

            <!-- Blurred dark overlay -->
            <Border Background="#80000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <!-- Dialog Card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="520"
                    Background="White" CornerRadius="20"
                    Padding="0"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.18" Color="#000000"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         From="0.9" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         From="0.9" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Gradient Header -->
                    <Border Grid.Row="0" CornerRadius="20,20,0,0" Padding="32,28"
                            Background="{StaticResource PrimaryGradientBrush}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="#30FFFFFF" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ExitToApp" Width="32" Height="32"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="هل تريد الخروج؟"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0"/>
                            <TextBlock Text="يمكنك إنشاء نسخة احتياطية قبل المغادرة"
                                       FontSize="13"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>
                            <TextBlock Text="عند «نسخ احتياطي ثم خروج» ستختار مكان الحفظ (مثلاً سطح المكتب أو قرص D)"
                                       FontSize="11"
                                       Foreground="#B3FFFFFF"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,8,16,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Backup Status (shown during backup) -->
                    <Border Grid.Row="1" Padding="24,12"
                            Visibility="{Binding IsExitBackupInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         IsIndeterminate="True" Height="4" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ExitBackupStatus}"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                            <TextBlock Text="{Binding ExitBackupPath}"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryHueMidBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,6,0,0"
                                       Visibility="{Binding ExitBackupPath, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <Button Command="{Binding OpenExitBackupFolderCommand}"
                                    Style="{StaticResource FlatButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding ExitBackupPath, Converter={StaticResource NullToCollapsedConverter}}">
                                <TextBlock Text="فتح مجلد النسخة" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="2" Margin="28,24,28,8" Orientation="Vertical">
                        <!-- Backup and Exit -->
                        <Button Command="{Binding ExitWithBackupCommand}"
                                IsEnabled="{Binding IsExitBackupInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,0,10"
                                Height="52"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExitDialogButton}">
                                    <Setter Property="Background" Value="{StaticResource SuccessGradientBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.2" Color="#2E7D32"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseExport" Width="22" Height="22"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="نسخ احتياطي ثم خروج" VerticalAlignment="Center"
                                           FontSize="15" FontWeight="DemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Exit Without Backup -->
                        <Button Command="{Binding ExitApplicationCommand}"
                                IsEnabled="{Binding IsExitBackupInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                Margin="0,0,0,10"
                                Height="48"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExitDialogButton}">
                                    <Setter Property="Background" Value="{StaticResource DangerGradientBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#C62828"/>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ExitToApp" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="خروج بدون نسخ" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Cancel -->
                    <Border Grid.Row="3" Padding="28,0,28,20">
                        <Button Command="{Binding CancelExitCommand}"
                                IsEnabled="{Binding IsExitBackupInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                HorizontalAlignment="Stretch"
                                Height="44"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ExitDialogButton}">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Setter Property="Foreground" Value="#616161"/>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="إلغاء" FontSize="14" FontWeight="Medium"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- جولة التعريف بالميزات -->
        <Grid Visibility="{Binding IsFeatureTourOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Grid.RowSpan="3" Panel.ZIndex="2100">
            <Border Background="#99000000"/>
            <materialDesign:Card HorizontalAlignment="Center" VerticalAlignment="Center"
                                 MinWidth="400" MaxWidth="480" Padding="28,24"
                                 UniformCornerRadius="16" materialDesign:ElevationAssist.Elevation="Dp12">
                <StackPanel>
                    <materialDesign:PackIcon Kind="InformationOutline" Width="40" Height="40"
                                             Foreground="#1565C0" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding CurrentFeatureTourStep.Title}"
                               FontSize="20" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding CurrentFeatureTourStep.Description}"
                               FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding FeatureTourProgressText}"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding FeatureTourBackCommand}"
                                Style="{StaticResource FlatButton}" Content="السابق"
                                Visibility="{Binding CanFeatureTourGoBack, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Grid.Column="1" Command="{Binding SkipFeatureTourCommand}"
                                Style="{StaticResource FlatButton}" Content="تخطي"
                                HorizontalAlignment="Center"/>
                        <Button Grid.Column="2" Command="{Binding FeatureTourNextCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Padding" Value="20,8"/>
                                    <Setter Property="Content" Value="التالي"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFeatureTourLastStep}" Value="True">
                                            <Setter Property="Content" Value="إنهاء"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- المساعد الذكي -->
        <Grid Grid.Row="1" Grid.RowSpan="2"
              Visibility="{Binding IsSmartAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Panel.ZIndex="2050">
            <Border Background="#66000000" MouseLeftButtonDown="SmartAssistantBackdrop_Click"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="400"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,0,0,0"
                    Padding="16,20"
                    Panel.ZIndex="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="-2" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="المساعد الذكي" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="تنبيهات ومهام مقترحة ليومك" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseSmartAssistantCommand}"
                                Click="SmartAssistantClose_Click"
                                Style="{StaticResource PanelCloseButton}"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="إغلاق المساعد"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                                 Visibility="{Binding IsSmartAssistantLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="التنبيهات" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding AssistantAlerts}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8"
                                                Background="{DynamicResource BackgroundBrush}"
                                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                                                Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.ExecuteAssistantAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="مهام اليوم" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding AssistantTasks}" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ExecuteAssistantTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                HorizontalContentAlignment="Stretch"
                                                Margin="0,0,0,6" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                                <materialDesign:PackIcon Grid.Column="1" Kind="ChevronLeft" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="نصائح" FontWeight="SemiBold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding AssistantTips}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Text="{Binding ., StringFormat='• {0}', Mode=OneWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding RefreshSmartAssistantCommand}" Style="{StaticResource OutlinedButton}"
                                Content="تحديث" Margin="0,0,8,0"/>
                        <Button Command="{Binding QuickOpenPosCommand}" Style="{StaticResource PrimaryButton}"
                                Content="فتح POS" Padding="16,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- بحث شامل Ctrl+K -->
        <controls:GlobalSearchOverlay x:Name="GlobalSearchOverlay"
                                      Grid.RowSpan="3"
                                      Panel.ZIndex="2000"
                                      Visibility="{Binding IsGlobalSearchOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <controls:VoiceAssistantOverlay x:Name="VoiceAssistantOverlay"
                                        Grid.RowSpan="3"
                                        Panel.ZIndex="2300"
                                        DataContext="{Binding}"
                                        Visibility="{Binding IsVoiceAssistantOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <controls:CustomerQuickStatementOverlay x:Name="QuickStatementOverlay"
                                                Grid.RowSpan="3"
                                                Panel.ZIndex="2100"
                                                DataContext="{Binding}"
                                                Visibility="{Binding IsQuickStatementOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- آخر العمليات -->
        <Popup x:Name="RecentActivityPopup"
               IsOpen="{Binding IsRecentActivityOpen}"
               Placement="Center"
               PlacementTarget="{Binding ElementName=RootLayoutGrid}"
               DataContext="{Binding ElementName=RootLayoutGrid, Path=DataContext}"
               StaysOpen="False"
               AllowsTransparency="True"
               Grid.RowSpan="3"
               Panel.ZIndex="1990">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="16"
                    MinWidth="380" MaxWidth="520" MinHeight="200" MaxHeight="440"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="آخر العمليات" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"
                               Foreground="{DynamicResource SearchResultTitleBrush}" />
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding RecentActivities}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="8"
                                        Background="{DynamicResource BackgroundBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SearchResultTitleBrush}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SearchResultSubtitleBrush}" />
                                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:yyyy/MM/dd HH:mm}'}"
                                                   FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1"
                               Text="لا توجد عمليات مسجّلة بعد.&#x0a;افتح شاشات أو نفّذ حركات (فواتير، تسديدات...) لتظهر هنا."
                               FontSize="13"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentActivities}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Popup>

        <!-- تخصيص القائمة -->
        <Popup IsOpen="{Binding IsMenuCustomizerOpen}"
               Placement="Center"
               PlacementTarget="{Binding ElementName=RootLayoutGrid}"
               DataContext="{Binding ElementName=RootLayoutGrid, Path=DataContext}"
               StaysOpen="False"
               AllowsTransparency="True"
               Grid.RowSpan="3"
               Panel.ZIndex="1985">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="16"
                    MinWidth="380" MaxWidth="520" MinHeight="280" MaxHeight="520"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="تخصيص القائمة" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource SearchResultTitleBrush}"/>
                        <TextBlock Text="حدّد الشاشات الظاهرة في القائمة، وثبّت حتى 6 شاشات تُفتح تلقائياً عند تشغيل النظام."
                                   Margin="0,4,0,10"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MenuVisibilityOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Margin="0,0,0,8"
                                            Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsVisible}"
                                                      Content="إظهار"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"/>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding IsPinned}"
                                                      IsEnabled="{Binding IsVisible}"
                                                      Content="تثبيت"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                         Width="18" Height="18"
                                                                         Foreground="{DynamicResource ChromeTabSelectedForegroundBrush}"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Title}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource SearchResultTitleBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <Button Command="{Binding SaveMenuCustomizationCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0">
                            <TextBlock Text="حفظ"/>
                        </Button>
                        <Button Command="{Binding ResetMenuCustomizationCommand}"
                                Style="{StaticResource OutlinedButton}">
                            <TextBlock Text="إعادة ضبط"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Tasks panel dropdown -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="2201"
              Visibility="{Binding IsTasksPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#44000000" MouseLeftButtonDown="TasksBackdrop_Click"/>
            <controls:TasksPanel x:Name="TasksPanelHost"
                                 DataContext="{Binding}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,52,170,0"
                                 Panel.ZIndex="1"
                                 RenderTransformOrigin="0.5,0">
                <controls:TasksPanel.RenderTransform>
                    <TranslateTransform Y="0"/>
                </controls:TasksPanel.RenderTransform>
                <controls:TasksPanel.Style>
                    <Style TargetType="controls:TasksPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTasksPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-16" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:TasksPanel.Style>
            </controls:TasksPanel>
        </Grid>

        <!-- Notes panel dropdown -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="2201"
              Visibility="{Binding IsNotesPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#44000000" MouseLeftButtonDown="NotesBackdrop_Click"/>
            <controls:NotesPanel x:Name="NotesPanelHost"
                                 DataContext="{Binding}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,52,220,0"
                                 Panel.ZIndex="1"
                                 RenderTransformOrigin="0.5,0">
                <controls:NotesPanel.RenderTransform>
                    <TranslateTransform Y="0"/>
                </controls:NotesPanel.RenderTransform>
                <controls:NotesPanel.Style>
                    <Style TargetType="controls:NotesPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotesPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-16" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:NotesPanel.Style>
            </controls:NotesPanel>
        </Grid>

        <!-- Notification Center dropdown -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="2200"
              Visibility="{Binding IsNotificationPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#44000000" MouseLeftButtonDown="NotificationBackdrop_Click"/>
            <controls:NotificationPanel x:Name="NotificationPanelHost"
                                        DataContext="{Binding}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,52,14,0"
                                        Panel.ZIndex="1"
                                        RenderTransformOrigin="0.5,0">
                <controls:NotificationPanel.RenderTransform>
                    <TranslateTransform Y="0"/>
                </controls:NotificationPanel.RenderTransform>
                <controls:NotificationPanel.Style>
                    <Style TargetType="controls:NotificationPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotificationPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="-16" To="0" Duration="0:0:0.32">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:NotificationPanel.Style>
            </controls:NotificationPanel>
        </Grid>

        <!-- Open Recent Excel panel -->
        <Grid Grid.RowSpan="3"
              Panel.ZIndex="2202"
              Visibility="{Binding IsOpenRecentExcelPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="#55000000" MouseLeftButtonDown="OpenRecentExcelBackdrop_Click"/>
            <controls:OpenRecentExcelPanel x:Name="OpenRecentExcelPanelHost"
                                           DataContext="{Binding}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Panel.ZIndex="1"
                                           RenderTransformOrigin="0.5,0.5">
                <controls:OpenRecentExcelPanel.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </controls:OpenRecentExcelPanel.RenderTransform>
                <controls:OpenRecentExcelPanel.Style>
                    <Style TargetType="controls:OpenRecentExcelPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOpenRecentExcelPanelOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.92" To="1" Duration="0:0:0.34">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.92" To="1" Duration="0:0:0.34">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:OpenRecentExcelPanel.Style>
            </controls:OpenRecentExcelPanel>
        </Grid>

        <!-- Bottom notification reminder -->
        <Border Grid.RowSpan="3"
                Panel.ZIndex="2150"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                MaxWidth="560"
                MinWidth="320"
                CornerRadius="14"
                Background="White"
                BorderBrush="#E2EAF3"
                BorderThickness="1"
                Visibility="{Binding IsNotificationReminderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                RenderTransformOrigin="0.5,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2" Color="#1565C0"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform Y="0"/>
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotificationReminderVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         From="24" To="0" Duration="0:0:0.38">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Margin="14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="#FFF3E0" Margin="0,0,12,0">
                    <materialDesign:PackIcon Kind="BellRing" Width="24" Height="24"
                                             Foreground="#EF6C00"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotificationReminderTitle}"
                               FontWeight="Bold" FontSize="13" Foreground="#263238"/>
                    <TextBlock Text="{Binding NotificationReminderMessage}"
                               FontSize="12" Foreground="#546E7A" TextWrapping="Wrap"
                               Margin="0,3,0,0" MaxWidth="360"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding OpenNotificationsFromReminderCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="34" Padding="12,0" Margin="0,0,8,0"
                        Content="عرض"/>
                <Button Grid.Column="3"
                        Command="{Binding DismissNotificationReminderCommand}"
                        Style="{StaticResource PanelCloseButton}"
                        ToolTip="إغلاق"/>
            </Grid>
        </Border>
    </Grid>
</Window>
