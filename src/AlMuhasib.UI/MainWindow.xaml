<Window x:Class="AlMuhasib.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:AlMuhasib.UI"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        xmlns:models="clr-namespace:AlMuhasib.UI.Models"
        xmlns:views="clr-namespace:AlMuhasib.UI.Views"
        xmlns:loyaltyViews="clr-namespace:AlMuhasib.UI.Views.Loyalty"
        xmlns:carViews="clr-namespace:AlMuhasib.UI.Views.Car"
        xmlns:carVm="clr-namespace:AlMuhasib.UI.ViewModels.Car"
        xmlns:carTradeViews="clr-namespace:AlMuhasib.UI.Views.CarTrade"
        xmlns:carTradeVm="clr-namespace:AlMuhasib.UI.ViewModels.CarTrade"
        xmlns:reViews="clr-namespace:AlMuhasib.UI.Views.RealEstate"
        xmlns:reVm="clr-namespace:AlMuhasib.UI.ViewModels.RealEstate"
        xmlns:hotelViews="clr-namespace:AlMuhasib.UI.Views.Hotel"
        xmlns:hotelVm="clr-namespace:AlMuhasib.UI.ViewModels.Hotel"
        xmlns:goldViews="clr-namespace:AlMuhasib.UI.Views.Gold"
        xmlns:goldVm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
        xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
        xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
        xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
        mc:Ignorable="d"
        behaviors:ScrollViewerMouseWheel.IsEnabled="True"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel, IsDesignTimeCreatable=False}"
        Icon="pack://application:,,,/Assets/Brand/qayd-icon.ico"
        Title="قيد - Qayd"
        Height="768" Width="1366"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="{DynamicResource NormalFontSize}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <Storyboard x:Key="TabContentFadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="12" To="0" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- CUSTOM TITLE BAR (full width)                -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                x:Name="AppTitleBar"
                Style="{StaticResource AppTitleBar}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="10,0,14,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window controls (physical left) -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            FlowDirection="LeftToRight"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnMinimize"
                            Style="{StaticResource TitleBarCaptionButton}"
                            ToolTip="تصغير"
                            Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" />
                    </Button>
                    <Button x:Name="BtnMaximize"
                            Style="{StaticResource TitleBarCaptionButton}"
                            ToolTip="تكبير"
                            Click="MaximizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowMaximize" Width="16" Height="16" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="إغلاق"
                            Command="{Binding RequestExitCommand}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- Sidebar toggle + page title -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="طي/فتح القائمة"
                            Width="38" Height="38">
                        <materialDesign:PackIcon Kind="Menu" Width="22" Height="22" />
                    </Button>
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                </StackPanel>

                <!-- Animated date & time pills -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            FlowDirection="LeftToRight"
                            WindowChrome.IsHitTestVisibleInChrome="False">
                    <Border Style="{StaticResource TitleBarDatePill}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarStar"
                                                     Width="16" Height="16"
                                                     Foreground="#1565C0"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="HijriIconRotate" Angle="0" />
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:12"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding CurrentHijriDate, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TitleBarDatePill}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarToday"
                                                     Width="16" Height="16"
                                                     Foreground="#00897B"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="{Binding CurrentGregorianDate, Mode=OneWay}"
                                       FontSize="12" FontWeight="Medium"
                                       Foreground="#37474F"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TitleBarDatePill}"
                            Background="#E8F5E9"
                            BorderBrush="#C8E6C9">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ClockOutline"
                                                     Width="16" Height="16"
                                                     Foreground="#2E7D32"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0">
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.45" Duration="0:0:1"
                                                                 AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock x:Name="ClockText"
                                       Text="{Binding CurrentTime, Mode=OneWay}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1B5E20"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentTime}" Value="{x:Null}">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Open Recent + Tasks + Notes + Notifications + Help -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding ToggleOpenRecentExcelPanelCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            Width="38" Height="38" Margin="0,0,8,0"
                            ToolTip="Open Recent — ملفات Excel الأخيرة">
                        <Grid Width="24" Height="24">
                            <materialDesign:PackIcon Kind="MicrosoftExcel" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#2E7D32"/>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="#43A047" BorderBrush="White" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-7,-9,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentExcelExportCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RecentExcelExportBadgeText}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ToggleTasksPanelCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            Width="38" Height="38" Margin="0,0,8,0"
                            ToolTip="مهامي">
                        <Grid Width="24" Height="24">
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#1565C0"/>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="#E53935" BorderBrush="White" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-7,-9,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PendingTaskCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding PendingTaskBadgeText}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ToggleNotesPanelCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            Width="38" Height="38" Margin="0,0,8,0"
                            ToolTip="ملاحظاتي">
                        <materialDesign:PackIcon Kind="NotebookOutline" Width="20" Height="20"
                                                 Foreground="#F57F17"/>
                    </Button>
                    <Button Command="{Binding ToggleNotificationPanelCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            Width="38" Height="38" Margin="0,0,8,0"
                            ToolTip="الإشعارات">
                        <Grid Width="24" Height="24">
                            <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Foreground="#37474F"/>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="#E53935" BorderBrush="White" BorderThickness="1.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-7,-9,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnreadNotificationCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding UnreadNotificationBadgeText}"
                                           FontSize="9" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Command="{Binding CheckForUpdatesCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            Width="38" Height="38" Margin="0,0,8,0"
                            ToolTip="التحقق من تحديثات النظام"
                            IsEnabled="{Binding IsCheckingForUpdate, Converter={StaticResource InverseBooleanConverter}}">
                        <materialDesign:PackIcon Kind="CloudDownload" Width="20" Height="20" Foreground="#1565C0"/>
                    </Button>
                    <Button Command="{Binding OpenHelpVideosCommand}"
                            Style="{StaticResource OutlinedButton}"
                            Height="34" Padding="10,0" Margin="0,0,6,0"
                            materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                            ToolTip="دليل الفيديوهات التعريفية">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18"
                                                     VerticalAlignment="Center" Foreground="#1565C0"/>
                            <TextBlock Text="الفيديوهات" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenHelpWhatsAppCommand}"
                            Style="{StaticResource OutlinedButton}"
                            Height="34" Padding="10,0"
                            materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                            ToolTip="تواصل مع الدعم عبر واتساب">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18"
                                                     VerticalAlignment="Center" Foreground="#25D366"/>
                            <TextBlock Text="الدعم" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Accent shimmer line -->
                <Border Grid.Column="0" Grid.ColumnSpan="5"
                        VerticalAlignment="Bottom" Height="2" IsHitTestVisible="False"
                        Opacity="0.85">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#001565C0" Offset="0"/>
                            <GradientStop Color="#801565C0" Offset="0.35"/>
                            <GradientStop Color="#801E88E5" Offset="0.65"/>
                            <GradientStop Color="#001E88E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.5" To="1" Duration="0:0:2.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </Border>

        <!-- Trial banner (new installs only while trial is active) -->
        <Border Grid.Row="1"
                Background="#FFF8E1"
                BorderBrush="#FFE082"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding ShowTrialBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <DockPanel>
                <Button DockPanel.Dock="Left"
                        Content="إدخال مفتاح التفعيل"
                        Command="{Binding OpenDesktopActivationCommand}"
                        Style="{StaticResource OutlinedButton}"
                        Height="32" Padding="14,0" Margin="12,0,0,0"/>
                <TextBlock VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#5D4037"
                           Text="{Binding TrialBannerText}"/>
            </DockPanel>
        </Border>

        <!-- Body: sidebar + report flyout + main -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- SIDEBAR (RIGHT side in RTL)                  -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarGradientBrush}"
                BorderBrush="#18FFFFFF"
                BorderThickness="1,0,0,0"
                CornerRadius="0"
                Effect="{x:Null}">
            <Border.Width>
                <Binding Path="IsSidebarExpanded">
                    <Binding.Converter>
                        <local:BoolToWidthConverter ExpandedWidth="280" CollapsedWidth="76" />
                    </Binding.Converter>
                </Binding>
            </Border.Width>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- Logo/Brand -->
                    <RowDefinition Height="Auto" />  <!-- Search -->
                    <RowDefinition Height="*" />      <!-- Nav Items -->
                    <RowDefinition Height="Auto" />   <!-- User Section -->
                </Grid.RowDefinitions>

                <!-- BRAND / LOGO -->
                <Border Grid.Row="0" Padding="14,18,14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12"
                                VerticalAlignment="Center"
                                Background="Transparent">
                            <Image Source="pack://application:,,,/Assets/Brand/qayd-mark.png"
                                   Width="44" Height="44"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="قيد"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White" />
                            <TextBlock Text="{x:Static helpers:AppInfo.TaglineAr}"
                                       FontSize="10.5"
                                       Foreground="#90A4AE"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Command="{Binding ToggleSearchCommand}"
                                ToolTip="بحث في القوائم"
                                Style="{StaticResource SidebarHeaderIconButton}"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"/>
                        </Button>

                        <Button Grid.Column="0" Grid.ColumnSpan="3"
                                Command="{Binding ToggleSearchCommand}"
                                ToolTip="بحث"
                                Style="{StaticResource SidebarHeaderIconButton}"
                                Width="40" Height="40"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                        Background="#14FFFFFF" Margin="14,0"/>

                <!-- SIDEBAR SEARCH (animated) -->
                <Border x:Name="SidebarSearchPanel"
                        Grid.Row="1"
                        Padding="12,0,12,8"
                        ClipToBounds="True"
                        MaxHeight="0"
                        Opacity="0"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchOpen}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                 To="56" Duration="0:0:0.28">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.22"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                 To="0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseIn"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SidebarSearchTextBox}"/>

                        <Popup Placement="Bottom"
                               PlacementTarget="{Binding ElementName=SidebarSearchPanel}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               IsOpen="{Binding HasSearchResults}"
                               PopupAnimation="Fade"
                               HorizontalOffset="0"
                               VerticalOffset="6">
                            <Border Background="{DynamicResource SearchPanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource SearchPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="8"
                                    MinWidth="260"
                                    MaxWidth="340"
                                    MaxHeight="360">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.14" Color="#0D1B2A"/>
                                </Border.Effect>
                                <ListBox ItemsSource="{Binding SearchResults}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="MinHeight" Value="48" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SidebarSearchResultButton}"
                                                    MinHeight="44"
                                                    HorizontalContentAlignment="Stretch">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Width="36" Height="36"
                                                            CornerRadius="8"
                                                            Background="{DynamicResource PrimaryHueLightBrush}"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Top">
                                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                                 Width="20" Height="20"
                                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                                 HorizontalAlignment="Center"
                                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               FontSize="14"
                                                               LineHeight="20"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SearchResultTitleBrush}"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <!-- NAVIGATION MENU -->
                <ScrollViewer Grid.Row="2"
                              Style="{StaticResource ThinScrollViewer}"
                              Padding="4,6,4,8">
                    <ItemsControl ItemsSource="{Binding MenuItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <!-- Section label (e.g. التقارير) -->
                                    <TextBlock Text="{Binding Title}"
                                               Margin="16,14,12,6"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#607D8B"
                                               Visibility="{Binding IsMenuSectionLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsMenuSectionLabel}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Regular menu item (non-group, non-category) -->
                                    <Button Command="{Binding DataContext.SelectMenuItemCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavMenuButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReportCategory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMenuSectionLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Report category → click opens flyout -->
                                    <Button Style="{StaticResource SidebarNavReportCategoryButton}"
                                            Visibility="{Binding IsReportCategory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            Command="{Binding DataContext.SelectMenuItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>

                                    <!-- Group header (expandable) -->
                                    <StackPanel Visibility="{Binding IsGroupHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Command="{Binding DataContext.SelectMenuItemCommand,
                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SidebarNavGroupButton}"/>

                                        <!-- Children (sub-items) -->
                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      Margin="8,2,0,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.SelectMenuItemCommand,
                                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SidebarNavChildButton}"
                                                            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- USER SECTION (bottom) -->
                <Border Grid.Row="3" Padding="10,8,10,14">
                    <Border CornerRadius="14" Padding="10,10"
                            Background="#12FFFFFF"
                            BorderBrush="#20FFFFFF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1565C0" Offset="0"/>
                                        <GradientStop Color="#1976D2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="Account"
                                                         Width="22" Height="22"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="White" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding LoggedInUsername}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="مسجّل الدخول"
                                           FontSize="10"
                                           Foreground="#78909C"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Command="{Binding LogoutCommand}"
                                    ToolTip="تسجيل الخروج"
                                    Style="{StaticResource SidebarHeaderIconButton}"
                                    Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Logout" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- Report category flyout (adjacent to sidebar, click-driven) -->
        <Grid Grid.Column="1"
              VerticalAlignment="Top"
              Visibility="{Binding IsReportFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border ClipToBounds="True"
                    VerticalAlignment="Top"
                    RenderTransformOrigin="1,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="16"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReportFlyoutOpen}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             From="16" To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:ReportCategoryFlyout DataContext="{Binding}" VerticalAlignment="Top"/>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN AREA (LEFT side in RTL)                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Chrome-style tab strip -->
            <Border Grid.Row="0" Style="{StaticResource ChromeTabStrip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding OpenTabs}"
                             SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                             Style="{StaticResource ChromeTabListBox}"
                             ItemContainerStyle="{StaticResource ChromeTabListBoxItem}"
                             HorizontalContentAlignment="Left"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DocumentTab}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                 Width="16" Height="16"
                                                                 Foreground="{DynamicResource ChromeTabSelectedForegroundBrush}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ChromeTabForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="128"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ChromeTabPinButton}"
                                            Command="{Binding DataContext.TogglePinTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="تثبيت التبويب (يفتح تلقائياً عند التشغيل)">
                                        <materialDesign:PackIcon Width="16" Height="16">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Kind" Value="PinOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ChromeTabForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Kind" Value="Pin"/>
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource ChromeTabCloseButton}"
                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="إغلاق التبويب"
                                            PreviewMouseLeftButtonDown="ChromeTabClose_PreviewMouseLeftButtonDown"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1"
                            Background="{DynamicResource ChromeTabInactiveBrush}"
                            CornerRadius="8"
                            Padding="8,4"
                            Margin="8,2,4,4"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource ChromeTabForegroundBrush}"
                                   VerticalAlignment="Center"
                                   Text="{Binding OpenTabs.Count, Mode=OneWay, StringFormat={}{0}/8}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- شريط الإجراءات السريع -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,8,12,4">
                <ScrollViewer Style="{StaticResource ModernHorizontalScrollViewer}">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding QuickNewCarContractCommand}"
                                Visibility="{Binding ShowQuickNewCarContract, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="إنشاء عقد بيع سيارة جديد">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentPlus" Width="18" Height="18" VerticalAlignment="Center" Foreground="#1565C0"/>
                                <TextBlock Text="عقد جديد" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickCarContractsListCommand}"
                                Visibility="{Binding ShowQuickCarContractsList, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="قائمة عقود السيارات">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" VerticalAlignment="Center" Foreground="#1565C0"/>
                                <TextBlock Text="العقود" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickNewReservationCommand}"
                                Visibility="{Binding ShowQuickNewReservation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="حجز فندقي جديد">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarPlus" Width="18" Height="18" VerticalAlignment="Center" Foreground="#6A1B9A"/>
                                <TextBlock Text="حجز جديد" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickCheckInCommand}"
                                Visibility="{Binding ShowQuickCheckIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="تسجيل دخول/خروج">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Login" Width="18" Height="18" VerticalAlignment="Center" Foreground="#6A1B9A"/>
                                <TextBlock Text="تسجيل دخول" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickPosSaleCommand}"
                                Visibility="{Binding ShowQuickPos, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="شاشة كاشير — بيع نقدي سريع">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PointOfSale" Width="18" Height="18" VerticalAlignment="Center" Foreground="#1565C0"/>
                                <TextBlock Text="POS" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickNewSaleCommand}"
                                Visibility="{Binding ShowQuickSale, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="بيع جديد" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickNewPurchaseCommand}"
                                Visibility="{Binding ShowQuickPurchase, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CartArrowDown" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="شراء" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickReceiptVoucherCommand}"
                                Visibility="{Binding ShowQuickReceipt, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashPlus" Width="18" Height="18" VerticalAlignment="Center" Foreground="#2E7D32" />
                                <TextBlock Text="قبض" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickPaymentVoucherCommand}"
                                Visibility="{Binding ShowQuickPayment, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMinus" Width="18" Height="18" VerticalAlignment="Center" Foreground="#C62828" />
                                <TextBlock Text="صرف" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickInstallmentsCommand}"
                                Visibility="{Binding ShowQuickInstallments, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="تسديد أقساط" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickInstallmentInvoiceCommand}"
                                Visibility="{Binding ShowQuickInstallmentInvoice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="فاتورة أقساط" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding QuickSalesReturnCommand}"
                                Visibility="{Binding ShowQuickReturn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="مرتجع من تقرير المبيعات">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="KeyboardReturn" Width="18" Height="18" VerticalAlignment="Center" Foreground="#C62828"/>
                                <TextBlock Text="مرتجع" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="24" Fill="#E0E0E0" Margin="4,0,10,0" />
                        <Button Command="{Binding ToggleSmartAssistantCommand}"
                                Visibility="{Binding ShowQuickAssistant, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="المساعد الذكي — تنبيهات ومهام">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RobotOutline" Width="18" Height="18" VerticalAlignment="Center" Foreground="#6A1B9A"/>
                                <TextBlock Text="المساعد" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleVoiceAssistantCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="المساعد الصوتي (Ctrl+Space)">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse Width="18" Height="18">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.3,0.25" Center="0.38,0.34">
                                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                                <GradientStop Color="#67E8F9" Offset="0.35"/>
                                                <GradientStop Color="#C084FC" Offset="0.72"/>
                                                <GradientStop Color="#6366F1" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#818CF8" BlurRadius="6" ShadowDepth="0" Opacity="0.65"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="#F8FAFC" Opacity="0.95"/>
                                </Grid>
                                <TextBlock Text="صوتي Ctrl+Space" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenGlobalSearchCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="بحث شامل (Ctrl+K)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="بحث Ctrl+K" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleRecentActivityCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="آخر العمليات">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="آخر العمليات" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding TogglePinTabCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,6,0"
                                materialDesign:ButtonAssist.CornerRadius="8" FontSize="12"
                                ToolTip="تثبيت التبويب الحالي">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pin" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="تثبيت" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleSoundCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="10,0" Margin="0,0,4,0"
                                ToolTip="تفعيل / إيقاف الأصوات">
                            <materialDesign:PackIcon Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="VolumeHigh" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSoundEnabled}" Value="False">
                                                <Setter Property="Kind" Value="VolumeOff" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <Button Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="34" Padding="10,0" Margin="0,0,4,0"
                                ToolTip="وضع ليلي / نهاري">
                            <materialDesign:PackIcon Kind="ThemeLightDark" Width="18" Height="18" />
                        </Button>
                        <Button Command="{Binding IncreaseFontSizeCommand}"
                                Style="{StaticResource IconButton}" Width="34" Height="34"
                                ToolTip="تكبير الخط">
                            <materialDesign:PackIcon Kind="FormatFontSizeIncrease" Width="18" Height="18" />
                        </Button>
                        <Button Command="{Binding DecreaseFontSizeCommand}"
                                Style="{StaticResource IconButton}" Width="34" Height="34"
                                ToolTip="تصغير الخط">
                            <materialDesign:PackIcon Kind="FormatFontSizeDecrease" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- CONTENT AREA -->
            <Grid Grid.Row="2">
            <Border x:Name="TabContentHost"
                    Background="{DynamicResource BackgroundBrush}"
                    Padding="24,16,24,20"
                    RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <ContentControl Content="{Binding CurrentViewModel}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type carVm:CarDashboardViewModel}">
                            <carViews:CarDashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type carVm:CarContractFormViewModel}">
                            <carViews:CarContractFormView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type carVm:CarContractsViewModel}">
                            <carViews:CarContractsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type carVm:CarContractsReportViewModel}">
                            <carViews:CarContractsReportView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type reVm:RealEstateDashboardViewModel}">
                            <reViews:RealEstateDashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type reVm:RealEstateContractFormViewModel}">
                            <reViews:RealEstateContractFormView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type reVm:RealEstateContractsViewModel}">
