<Window x:Class="AlMuhasib.UI.Windows.DuhokBranchActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تفعيل فرع دهوك"
        Width="440" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{DynamicResource MutedIconBackgroundBrush}"
        FontFamily="{DynamicResource ArabicFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="تفعيل فرع دهوك" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1"
                   Text="أدخل كلمة المرور لتفعيل هوية اكسبريس للمبيعات"
                   TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,16"/>

        <PasswordBox Grid.Row="2"
                     x:Name="PasswordBox"
                     materialDesign:HintAssist.Hint="كلمة المرور"
                     materialDesign:HintAssist.IsFloating="True"
                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                     FontSize="16"
                     Margin="0,0,0,8"
                     KeyDown="PasswordBox_KeyDown"/>

        <TextBlock Grid.Row="3"
                   x:Name="ErrorText"
                   Foreground="#C62828"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,4,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
            <Button Content="إلغاء" IsCancel="True" Style="{StaticResource FlatButton}" Padding="20,8" Margin="0,0,8,0"/>
            <Button Content="تفعيل فرع دهوك" IsDefault="True" Click="Activate_Click"
                    Style="{StaticResource PrimaryButton}" Padding="24,8"/>
        </StackPanel>
    </Grid>
</Window>
