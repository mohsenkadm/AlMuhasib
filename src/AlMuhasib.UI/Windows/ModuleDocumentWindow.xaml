<Window x:Class="AlMuhasib.UI.Windows.ModuleDocumentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
        Title="المحاسب"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        MinWidth="1024"
        MinHeight="640"
        FlowDirection="RightToLeft"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{DynamicResource AppFont}"
        TextElement.FontFamily="{DynamicResource AppFont}"
        Icon="{DynamicResource BrandWindowIcon}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CustomsUiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <ContentControl x:Name="DocumentHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>

        <controls:ToastHost x:Name="DocumentToastHost"
                            Panel.ZIndex="500"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,12,0,0"/>
    </Grid>
</Window>
