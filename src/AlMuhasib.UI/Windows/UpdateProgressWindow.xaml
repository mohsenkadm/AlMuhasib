<Window x:Class="AlMuhasib.UI.Windows.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحديث المحاسب"
        Width="440" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}">
    <Border Background="{DynamicResource CardBrush}" Padding="28">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="جاري تحديث النظام" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock x:Name="StatusText" Text="يرجى الانتظار..." TextWrapping="Wrap" Margin="0,0,0,16"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ProgressBar x:Name="ProgressBar" Height="8" IsIndeterminate="True"/>
        </StackPanel>
    </Border>
</Window>
