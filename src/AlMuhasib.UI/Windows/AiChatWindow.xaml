<Window x:Class="AlMuhasib.UI.Windows.AiChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
        xmlns:models="clr-namespace:AlMuhasib.UI.Models"
        Title="المساعد الذكي"
        Width="420" Height="620"
        MinWidth="360" MinHeight="480"
        MaxWidth="560" MaxHeight="820"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="Manual"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:HexToBrushConverter x:Key="HexBrush"/>

        <Style x:Key="AiHeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#22FFFFFF" CornerRadius="17"
                                Width="34" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat input — no MaterialDesign underline -->
        <Style x:Key="AiChatInputTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MaxHeight" Value="110"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Placeholder"
                                       Text="اكتب سؤالك هنا..."
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Top"
                                       Foreground="{DynamicResource HintForegroundBrush}"
                                       FontSize="{TemplateBinding FontSize}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AiSuggestionCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="12,10"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AiSuggestionHoverBorderBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#5E35B1"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.02" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.02" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type models:AssistantMessage}">
            <Grid Margin="0,0,0,10">
                <Border x:Name="Bubble"
                        MaxWidth="300"
                        CornerRadius="16"
                        Padding="12,10"
                        HorizontalAlignment="Right">
                    <StackPanel>
                        <TextBlock x:Name="ContentText"
                                   Text="{Binding Content}"
                                   TextWrapping="Wrap"
                                   FontSize="13.5"
                                   LineHeight="20"
                                   Foreground="{DynamicResource AiAssistantBubbleForegroundBrush}"/>
                        <TextBlock x:Name="TimeText"
                                   Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                   FontSize="10"
                                   Opacity="0.65"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFromUser}" Value="True">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Left"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AiUserBubbleBrush}"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,4,16"/>
                    <Setter TargetName="ContentText" Property="Foreground" Value="White"/>
                    <Setter TargetName="TimeText" Property="Foreground" Value="#CCFFFFFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFromUser}" Value="False">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AiAssistantBubbleBrush}"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AiAssistantBubbleBorderBrush}"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1"/>
                    <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,16,4"/>
                    <Setter TargetName="ContentText" Property="Foreground" Value="{DynamicResource AiAssistantBubbleForegroundBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AiErrorBubbleBrush}"/>
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AiErrorBubbleBorderBrush}"/>
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootChrome"
            Margin="10"
            CornerRadius="22"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.32" Color="#0D1B2A"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootTranslate" Y="0"/>
            </TransformGroup>
        </Border.RenderTransform>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    CornerRadius="22,22,0,0"
                    Padding="16,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#3949AB" Offset="0.45"/>
                        <GradientStop Color="#7E57C2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#80FFFFFF" Offset="0"/>
                                    <GradientStop Color="#30FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <materialDesign:PackIcon Kind="RobotOutline"
                                                     Width="24" Height="24"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="المساعد الذكي"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="White"/>
                            <TextBlock Text="مساعدك المحاسبي"
                                       FontSize="11.5"
                                       Foreground="#DDE7FF"
                                       Margin="0,2,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse Width="7" Height="7" Fill="#69F0AE" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="11"
                                           Foreground="#C8E6C9"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource AiHeaderIconButton}"
                                ToolTip="محادثة جديدة"
                                Command="{Binding NewChatCommand}"
                                Margin="0,0,6,0">
                            <materialDesign:PackIcon Kind="ChatPlus" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource AiHeaderIconButton}"
                                ToolTip="تصغير"
                                Click="MinimizeButton_Click"
                                Margin="0,0,6,0">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource AiHeaderIconButton}"
                                ToolTip="إغلاق"
                                Click="CloseButton_Click">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages / Welcome -->
            <Grid Grid.Row="1" Background="{DynamicResource AiChatBodyBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="16,14"
                              Visibility="{Binding ShowWelcome, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="مرحباً بك 👋"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,4,0,6"/>
                        <TextBlock Text="كيف يمكنني مساعدتك في إدارة أعمالك اليوم؟"
                                   FontSize="13.5"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AssistantSuggestion}">
                                    <Button Style="{StaticResource AiSuggestionCard}"
                                            Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0"
                                                    Background="{Binding BackgroundHex, Converter={StaticResource HexBrush}}">
                                                <materialDesign:PackIcon Kind="{Binding IconKind}"
                                                                         Width="18" Height="18"
                                                                         Foreground="{Binding AccentHex, Converter={StaticResource HexBrush}}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       FontSize="13.5"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="MessagesScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="14,12"
                              Visibility="{Binding ShowWelcome, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl x:Name="MessagesList" ItemsSource="{Binding Messages}"/>
                </ScrollViewer>

                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="16,0,16,12" Padding="14,10"
                        CornerRadius="16"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="#7E57C2" Margin="0,0,5,0" Opacity="0.35"/>
                        <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="#5C6BC0" Margin="0,0,5,0" Opacity="0.35"/>
                        <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="#42A5F5" Opacity="0.35"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Composer -->
            <Border Grid.Row="2"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,10,12,14"
                    CornerRadius="0,0,22,22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="InputShell"
                            Background="{DynamicResource AiComposerFieldBrush}"
                            BorderBrush="{DynamicResource AiComposerFieldBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="18"
                            Padding="2">
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource AiChatInputTextBox}"
                                 Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                 GotKeyboardFocus="InputBox_GotKeyboardFocus"
                                 LostKeyboardFocus="InputBox_LostKeyboardFocus"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                    </Border>

                    <Button Grid.Column="1"
                            Width="46" Height="46"
                            Margin="10,0,0,0"
                            VerticalAlignment="Bottom"
                            Cursor="Hand"
                            Command="{Binding SendCommand}"
                            ToolTip="إرسال">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SendBd" CornerRadius="23" Width="46" Height="46"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1565C0" Offset="0"/>
                                            <GradientStop Color="#5E35B1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#5E35B1" BlurRadius="12" ShadowDepth="2" Opacity="0.4"/>
                                    </Border.Effect>
                                    <materialDesign:PackIcon Kind="Send"
                                                             Width="20" Height="20"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             FlowDirection="LeftToRight"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SendBd" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#5E35B1" BlurRadius="18" ShadowDepth="3" Opacity="0.55"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="SendBd" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="SendBd" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
