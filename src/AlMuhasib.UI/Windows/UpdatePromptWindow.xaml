<Window x:Class="AlMuhasib.UI.Windows.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="تحديث النظام"
        Width="520" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}">
    <Border Background="{DynamicResource CardBrush}" Padding="24" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="يتوفر تحديث جديد" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <TextBlock x:Name="VersionText" FontSize="14" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="MandatoryHint" Visibility="Collapsed" Margin="0,8,0,0"
                           Foreground="#C62828" FontWeight="SemiBold"
                           Text="هذا التحديث إلزامي — يجب التثبيت للمتابعة."/>
            </StackPanel>

            <Border Grid.Row="1" Background="#F5F7FA" CornerRadius="10" Padding="14" Margin="0,0,0,20"
                    MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="13"
                               Foreground="#37474F"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="InstallButton" Content="تثبيت التحديث" Click="InstallButton_Click"
                        Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0" Margin="0,0,10,0"/>
                <Button x:Name="LaterButton" Content="لاحقاً" Click="LaterButton_Click"
                        Style="{StaticResource OutlinedButton}" Height="40" Padding="24,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
