<Window x:Class="AlMuhasib.UI.Windows.PosFullscreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AlMuhasib.UI.Views"
        xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
        Title="بيع سريع (POS) — كاشير"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ShowInTaskbar="True"
        Background="{DynamicResource BackgroundBrush}"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}"
        MinWidth="1024"
        MinHeight="640">

    <Grid Margin="8">
        <views:PosQuickSaleView x:Name="PosView" IsFullscreenHost="True"/>

        <controls:ToastHost x:Name="PosToastHost"
                            Panel.ZIndex="500"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="20,12,0,0"/>
    </Grid>
</Window>
