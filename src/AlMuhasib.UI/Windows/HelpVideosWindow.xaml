<Window x:Class="AlMuhasib.UI.Windows.HelpVideosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
        Title="دليل الفيديوهات التعريفية"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F0F4F8"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed"/>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="28,22" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D47A1" Offset="0"/>
                    <GradientStop Color="#1565C0" Offset="0.55"/>
                    <GradientStop Color="#42A5F5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistPlay" Width="32" Height="32"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="دليل الفيديوهات التعريفية"
                                   FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                    <TextBlock Text="شاهد شرح كل واجهة داخل النظام"
                               FontSize="13" Foreground="#E3F2FD" Margin="44,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Click="CloseButton_Click"
                        Style="{StaticResource IconButton}"
                        Foreground="White" Width="40" Height="40"
                        ToolTip="إغلاق">
                    <Border Background="#22FFFFFF" CornerRadius="20" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Video list -->
            <materialDesign:Card Grid.Column="0" UniformCornerRadius="16"
                                 Padding="0" Margin="0,0,16,0"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#E3F2FD" CornerRadius="16,16,0,0" Padding="16,14">
                        <TextBox materialDesign:HintAssist.Hint="بحث في الفيديوهات..."
                                 Style="{StaticResource OutlinedTextBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Videos}"
                             SelectedItem="{Binding SelectedVideo}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Padding="8,8,8,12">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="12" Padding="12"
                                                    Background="White" BorderBrush="#E0E7EF" BorderThickness="1"
                                                    Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#F5FAFF"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Background="#E8F5E9" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding CategoryTitle}" FontSize="11"
                                                       Foreground="#2E7D32" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="{Binding Duration}" FontSize="11" Foreground="#78909C"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding Duration, Converter={StaticResource NullToCollapsed}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#1A237E" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#607D8B"
                                               TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="لا توجد فيديوهات مطابقة."
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#78909C" FontSize="14"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </materialDesign:Card>

            <!-- Player -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="16" Padding="0"
                                 materialDesign:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0A1628" CornerRadius="16,16,0,0" MinHeight="360">
                        <Grid>
                            <wv2:WebView2 x:Name="VideoWebView" DefaultBackgroundColor="Transparent"/>

                            <Border x:Name="PlayerLoadingOverlay" Background="#CC0A1628">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 IsIndeterminate="True" Width="48" Height="48" Foreground="White"/>
                                    <TextBlock Text="جاري تحميل المشغّل..." Foreground="White"
                                               Margin="0,14,0,0" FontSize="14"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="NoVideoOverlay" Background="#E6101828" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                    <materialDesign:PackIcon Kind="VideoOffOutline" Width="56" Height="56"
                                                             Foreground="#90CAF9" HorizontalAlignment="Center"/>
                                    <TextBlock Text="لم يُضبط رابط يوتيوب لهذا الفيديو بعد"
                                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                                               TextAlignment="Center" Margin="0,16,0,8"/>
                                    <TextBlock Text="عدّل ملف help-videos.json في مجلد البرنامج وأضف رابط YouTube."
                                               Foreground="#B0BEC5" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="White" CornerRadius="0,0,16,16" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="VideoTitleText" Text="{Binding SelectedVideo.Title}"
                                           FontSize="18" FontWeight="Bold" Foreground="#1A237E"/>
                                <TextBlock x:Name="VideoDescriptionText" Text="{Binding SelectedVideo.Description}"
                                           FontSize="13" Foreground="#546E7A" TextWrapping="Wrap"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Click="OpenInBrowser_Click"
                                    Style="{StaticResource OutlinedButton}" Height="40" Padding="16,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="فتح في يوتيوب" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>
