<Window x:Class="AlMuhasib.UI.Windows.SetupWizardHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إعداد نظام قيد"
        Height="640" Width="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Border CornerRadius="16" Background="White" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="مرحباً بك في قيد" FontSize="28" FontWeight="Bold"
                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                <TextBlock x:Name="StepSubtitle" Text="اختر نوع النظام المناسب لعملك"
                           FontSize="14" Foreground="#607D8B" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border x:Name="Step1Indicator" Width="36" Height="36" CornerRadius="18" Background="#1565C0">
                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle Width="40" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
                <Border x:Name="Step2Indicator" Width="36" Height="36" CornerRadius="18" Background="#E0E0E0">
                    <TextBlock Text="2" Foreground="#78909C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Rectangle x:Name="Step3Connector" Width="40" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0" Visibility="Collapsed"/>
                <Border x:Name="Step3Indicator" Width="36" Height="36" CornerRadius="18" Background="#E0E0E0" Visibility="Collapsed">
                    <TextBlock Text="3" Foreground="#78909C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Step 1: System Type -->
            <ScrollViewer x:Name="Step1Panel" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="1380">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AccountingCard" Grid.Column="0" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnAccountingSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#E3F2FD" Margin="0,0,0,14">
                                <md:PackIcon Kind="CalculatorVariant" Width="40" Height="40" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="النظام المحاسبي" FontSize="18" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة المبيعات والمشتريات والمخزون والأقساط" TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,8,0,0" MaxWidth="260"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarCard" Grid.Column="2" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnCarSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#E8F5E9" Margin="0,0,0,14">
                                <md:PackIcon Kind="CarSide" Width="40" Height="40" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="عقود السيارات" FontSize="18" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة عقود البيع والشراء للمعارض" TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,8,0,0" MaxWidth="260"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarTradeCard" Grid.Column="4" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnCarTradeSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#FFF3E0" Margin="0,0,0,14">
                                <md:PackIcon Kind="SwapHorizontal" Width="40" Height="40" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="بيع وشراء السيارات" FontSize="18" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة عمليات الشراء والبيع مع التسديد" TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,8,0,0" MaxWidth="240"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HotelCard" Grid.Column="6" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnHotelSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#F3E5F5" Margin="0,0,0,14">
                                <md:PackIcon Kind="Hotel" Width="40" Height="40" Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="إدارة الفنادق" FontSize="18" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="حجوزات الغرف وتسجيل الدخول والخروج" TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,8,0,0" MaxWidth="240"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RealEstateCard" Grid.Column="8" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnRealEstateSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#E0F2F1" Margin="0,0,0,12">
                                <md:PackIcon Kind="HomeCity" Width="36" Height="36" Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="عقود العقارات" FontSize="16" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="بيع وشراء الدور والأراضي مع الآجل والديون" TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- Step 2: Deployment Mode -->
            <Grid x:Name="Step2Panel" Grid.Row="2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="MainServerCard" Grid.Column="0" CornerRadius="14" BorderThickness="2"
                        BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                        MouseLeftButtonUp="OnMainServerSelected">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#E8F5E9" Margin="0,0,0,14">
                            <md:PackIcon Kind="Server" Width="40" Height="40" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="حاسبة رئيسية" FontSize="20" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                        <TextBlock Text="تخزين قاعدة البيانات على هذا الجهاز واستقبال الحاسبات الفرعية"
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,10,0,0" MaxWidth="280"/>
                    </StackPanel>
                </Border>

                <Border x:Name="BranchClientCard" Grid.Column="2" CornerRadius="14" BorderThickness="2"
                        BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                        MouseLeftButtonUp="OnBranchClientSelected">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#E3F2FD" Margin="0,0,0,14">
                            <md:PackIcon Kind="LanConnect" Width="40" Height="40" Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="حاسبة فرعية" FontSize="20" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                        <TextBlock Text="الاتصال بحاسبة رئيسية عبر الشبكة بدون مزامنة"
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,10,0,0" MaxWidth="280"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StandaloneCard" Grid.Column="4" CornerRadius="14" BorderThickness="2"
                        BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                        MouseLeftButtonUp="OnStandaloneSelected">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#FFF3E0" Margin="0,0,0,14">
                            <md:PackIcon Kind="DesktopClassic" Width="40" Height="40" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="حاسبة مستقلة" FontSize="20" FontWeight="Bold" Foreground="#263238" HorizontalAlignment="Center"/>
                        <TextBlock Text="قاعدة بيانات محلية على هذا الجهاز فقط (الوضع التقليدي)"
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C" Margin="0,10,0,0" MaxWidth="280"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 3: Branch Connection -->
            <ScrollViewer x:Name="Step3BranchPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                    <Border Background="#E3F2FD" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="LanConnect" Width="24" Height="24" Foreground="#1565C0" VerticalAlignment="Center"/>
                                <TextBlock Text="ربط الحاسبة الفرعية بالرئيسية" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="ابحث عن الحاسبة الرئيسية على شبكة WiFi أو أدخل عنوان IP يدوياً"
                                       Foreground="#546E7A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="DiscoverButton" Content="البحث على الشبكة" Click="OnDiscoverClick"
                            Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8"
                            HorizontalAlignment="Stretch" Padding="0,12" Margin="0,0,0,12"/>

                    <TextBlock x:Name="DiscoveryStatusText" Text="" Foreground="#607D8B" Margin="0,0,0,12"/>

                    <ListBox x:Name="DiscoveredServersList" MinHeight="120" MaxHeight="180" Margin="0,0,0,16"
                             SelectionChanged="OnDiscoveredServerSelected"
                             md:HintAssist.Hint="الأجهزة المكتشفة"/>

                    <TextBox x:Name="MainServerHostText" md:HintAssist.Hint="عنوان IP للحاسبة الرئيسية" Margin="0,0,0,12"/>
                    <TextBox x:Name="BranchNameText" md:HintAssist.Hint="اسم الفرع (اختياري)" Margin="0,0,0,12"/>
                    <TextBox x:Name="SqlUsernameText" md:HintAssist.Hint="اسم مستخدم SQL" Margin="0,0,0,12"/>
                    <PasswordBox x:Name="SqlPasswordBox" md:HintAssist.Hint="كلمة مرور SQL" Margin="0,0,0,12"/>
                    <TextBox x:Name="PairingCodeText" md:HintAssist.Hint="رمز الربط (6 أرقام)" MaxLength="6" Margin="0,0,0,12"/>

                    <TextBlock x:Name="ConnectionTestResultText" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button x:Name="TestConnectionButton" Content="اختبار الاتصال" Click="OnTestConnectionClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}" md:ButtonAssist.CornerRadius="8"
                            HorizontalAlignment="Stretch" Padding="0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 3: Main Server Setup -->
            <ScrollViewer x:Name="Step3MainPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                    <Border Background="#E8F5E9" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Server" Width="24" Height="24" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <TextBlock Text="تهيئة الحاسبة الرئيسية" FontSize="18" FontWeight="Bold" Foreground="#2E7D32" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="سيتم إعداد SQL Server لاستقبال الحاسبات الفرعية عبر الشبكة"
                                       Foreground="#546E7A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBox x:Name="ServerLabelText" md:HintAssist.Hint="اسم الحاسبة الرئيسية (يظهر للفروع)" Margin="0,0,0,12"/>
                    <TextBox x:Name="MainPairingCodeText" md:HintAssist.Hint="رمز الربط للفروع" IsReadOnly="True" Margin="0,0,0,12"/>
                    <TextBlock Text="شارك رمز الربط مع الحاسبات الفرعية عند الاتصال" Foreground="#78909C" Margin="0,0,0,16"/>

                    <TextBlock x:Name="MainSetupStatusText" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Button x:Name="ConfigureMainServerButton" Content="تهيئة SQL Express واستقبال الفروع"
                            Click="OnConfigureMainServerClick"
                            Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8"
                            HorizontalAlignment="Stretch" Padding="0,12"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Step 3: Standalone SQL Server Selection -->
            <ScrollViewer x:Name="Step3StandalonePanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" HorizontalAlignment="Center">
                    <Border Background="#FFF3E0" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Database" Width="24" Height="24" Foreground="#E65100" VerticalAlignment="Center"/>
                                <TextBlock Text="اختيار سيرفر قاعدة البيانات" FontSize="18" FontWeight="Bold" Foreground="#E65100" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="اختر مثيل SQL Server المتوفر على هذا الجهاز. سيتم حفظه في إعدادات التطبيق واستخدامه دائماً للاتصال والترحيل."
                                       Foreground="#546E7A" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="SqlServerCombo"
                                  Grid.Column="0"
                                  IsEditable="True"
                                  md:HintAssist.Hint="اسم السيرفر / المثيل"
                                  SelectionChanged="OnSqlServerSelectionChanged"
                                  StaysOpenOnEdit="True"/>

                        <Button x:Name="RefreshSqlServersButton"
                                Grid.Column="2"
                                Content="تحديث القائمة"
                                Click="OnRefreshSqlServersClick"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Padding="16,10"
                                VerticalAlignment="Bottom"/>
                    </Grid>

                    <TextBlock x:Name="SqlServerDiscoveryStatusText"
                               Text="جاري البحث عن السيرفرات المتوفرة..."
                               Foreground="#607D8B"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="StandaloneConnectionTestResultText"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Button x:Name="TestStandaloneConnectionButton"
                            Content="اختبار الاتصال"
                            Click="OnTestStandaloneConnectionClick"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            md:ButtonAssist.CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            Padding="0,10"
                            Margin="0,0,0,8"/>

                    <TextBlock Text="يمكنك أيضاً كتابة اسم السيرفر يدوياً إن لم يظهر في القائمة (مثال: .\\SQLEXPRESS أو (localdb)\\MSSQLLocalDB)."
                               Foreground="#90A4AE"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="BackButton" Content="رجوع" Click="OnBackClick" Visibility="Collapsed"
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0" Padding="32,10"/>
                <Button x:Name="ContinueButton" Content="متابعة" IsEnabled="False" Click="OnContinueClick"
                        Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8" Padding="48,10" FontSize="15"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
