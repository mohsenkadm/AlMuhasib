<Window x:Class="AlMuhasib.UI.Windows.SystemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="اختيار نوع النظام"
        Height="560" Width="1280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Border CornerRadius="16" Background="White" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
                <TextBlock Text="مرحباً بك في المحاسب" FontSize="28" FontWeight="Bold"
                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                <TextBlock Text="اختر نوع النظام المناسب لعملك — هذا الاختيار يُطبّق مرة واحدة فقط"
                           FontSize="14" Foreground="#607D8B" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="1180">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AccountingCard" Grid.Column="0" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnAccountingSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#E3F2FD" Margin="0,0,0,14">
                                <md:PackIcon Kind="CalculatorVariant" Width="40" Height="40"
                                             Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="النظام المحاسبي" FontSize="18" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة المبيعات والمشتريات والمخزون والأقساط والتقارير المالية"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="260"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarCard" Grid.Column="2" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnCarSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#E8F5E9" Margin="0,0,0,14">
                                <md:PackIcon Kind="CarSide" Width="40" Height="40"
                                             Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="عقود السيارات" FontSize="18" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة عقود البيع والشراء للمعارض مع التسديد والطباعة والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="260"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HotelCard" Grid.Column="6" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnHotelSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#F3E5F5" Margin="0,0,0,14">
                                <md:PackIcon Kind="Hotel" Width="40" Height="40"
                                             Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="إدارة الفنادق" FontSize="18" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="حجوزات الغرف، تسجيل الدخول والخروج، النظافة، الصندوق والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="240"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarTradeCard" Grid.Column="4" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnCarTradeSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Width="80" Height="80" CornerRadius="40" Background="#FFF3E0" Margin="0,0,0,14">
                                <md:PackIcon Kind="SwapHorizontal" Width="40" Height="40"
                                             Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="بيع وشراء السيارات" FontSize="18" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة عمليات الشراء والبيع مع التسديد وكشف الحساب والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button x:Name="ContinueButton" Content="متابعة" IsEnabled="False"
                        Click="OnContinueClick"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        md:ButtonAssist.CornerRadius="8" Padding="48,10" FontSize="15"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
