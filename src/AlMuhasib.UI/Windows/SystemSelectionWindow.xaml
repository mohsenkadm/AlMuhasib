<Window x:Class="AlMuhasib.UI.Windows.SystemSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="اختيار نوع النظام"
        Height="620" Width="1680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Window.Resources>
        <Style x:Key="WizardContinueButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="MinWidth" Value="168"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="36,0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="md:ButtonAssist.CornerRadius" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="#B0BEC5"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="md:ElevationAssist.Elevation" Value="Dp0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="White" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
                <TextBlock Text="مرحباً بك في المحاسب" FontSize="28" FontWeight="Bold"
                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                <TextBlock Text="اختر نوع النظام المناسب لعملك — هذا الاختيار يُطبّق مرة واحدة فقط"
                           FontSize="14" Foreground="#607D8B" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="1600">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="AccountingCard" Grid.Column="0" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnAccountingSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#E3F2FD" Margin="0,0,0,12">
                                <md:PackIcon Kind="CalculatorVariant" Width="36" Height="36"
                                             Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="النظام المحاسبي" FontSize="16" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة المبيعات والمشتريات والمخزون والأقساط والتقارير المالية"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarCard" Grid.Column="2" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnCarSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#E8F5E9" Margin="0,0,0,12">
                                <md:PackIcon Kind="CarSide" Width="36" Height="36"
                                             Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="عقود السيارات" FontSize="16" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة عقود البيع والشراء للمعارض مع التسديد والطباعة والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CarTradeCard" Grid.Column="4" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnCarTradeSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#FFF3E0" Margin="0,0,0,12">
                                <md:PackIcon Kind="SwapHorizontal" Width="36" Height="36"
                                             Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="بيع وشراء السيارات" FontSize="16" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة عمليات الشراء والبيع مع التسديد وكشف الحساب والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="HotelCard" Grid.Column="6" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnHotelSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#F3E5F5" Margin="0,0,0,12">
                                <md:PackIcon Kind="Hotel" Width="36" Height="36"
                                             Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="إدارة الفنادق" FontSize="16" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="حجوزات الغرف، تسجيل الدخول والخروج، النظافة، الصندوق والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="RealEstateCard" Grid.Column="8" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnRealEstateSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#E0F2F1" Margin="0,0,0,12">
                                <md:PackIcon Kind="HomeCity" Width="36" Height="36"
                                             Foreground="#00695C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="عقود العقارات" FontSize="16" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="بيع وشراء الدور والأراضي مع الآجل وكشف الديون والطباعة والتقارير"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GoldCard" Grid.Column="10" CornerRadius="14" BorderThickness="2"
                            BorderBrush="#E0E0E0" Background="#FAFAFA" Cursor="Hand"
                            MouseLeftButtonUp="OnGoldSelected">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#FFF8E1" Margin="0,0,0,12">
                                <md:PackIcon Kind="DiamondStone" Width="36" Height="36"
                                             Foreground="#B8860B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="نظام الذهب" FontSize="16" FontWeight="Bold"
                                       Foreground="#263238" HorizontalAlignment="Center"/>
                            <TextBlock Text="إدارة محلات الذهب العراقية: أسعار المثقال، المخزون، البيع والشراء والآجل"
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#78909C"
                                       Margin="0,8,0,0" MaxWidth="220"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,8">
                <Button x:Name="ContinueButton" Content="متابعة" IsEnabled="False"
                        Click="OnContinueClick"
                        Style="{StaticResource WizardContinueButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
