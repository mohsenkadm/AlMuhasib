<UserControl x:Class="AlMuhasib.UI.Controls.AttachmentsPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,10"
                   Visibility="{Binding ShowHeader, ElementName=Root, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Title, ElementName=Root}"
                       FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
            <Button x:Name="AddButton"
                    DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Command="{Binding AddCommand, ElementName=Root}"
                    Style="{StaticResource FlatButton}"
                    Content="{Binding AddButtonText, ElementName=Root}"
                    IsEnabled="False"
                    ToolTip="{Binding SaveFirstHint, ElementName=Root}"/>
        </DockPanel>

        <TextBlock Text="{Binding SaveFirstHint, ElementName=Root}"
                   FontSize="12"
                   Foreground="{DynamicResource HintForegroundBrush}"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasSavedOwner, ElementName=Root, Converter={StaticResource InvBoolToVis}}"/>

        <DataGrid ItemsSource="{Binding Items, ElementName=Root}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  Style="{StaticResource ModernDataGrid}"
                  MaxHeight="{Binding MaxGridHeight, ElementName=Root}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="140"/>
                <DataGridTemplateColumn x:Name="ActionsColumn" Header="إجراءات" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- Default compact icons (Accounting / shared) -->
                                <StackPanel Orientation="Horizontal" Margin="2,0"
                                            Visibility="{Binding UseLabeledActions, ElementName=Root, Converter={StaticResource InvBoolToVis}}">
                                    <Button Command="{Binding OpenCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableViewIconButton}"
                                            ToolTip="عرض">
                                        <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableDeleteIconButton}"
                                            IsEnabled="{Binding CanDelete, ElementName=Root}"
                                            ToolTip="حذف" Margin="6,0,0,0">
                                        <md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                                <!-- Labeled actions (Customs opt-in) — أيقونات واضحة بدون ضغط -->
                                <StackPanel Orientation="Horizontal" Margin="2,0"
                                            Visibility="{Binding UseLabeledActions, ElementName=Root, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding OpenCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableViewIconButton}"
                                            ToolTip="عرض الملف">
                                        <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                    </Button>
                                    <Button Command="{Binding DeleteCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableDeleteIconButton}"
                                            IsEnabled="{Binding CanDelete, ElementName=Root}"
                                            ToolTip="حذف المرفق"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>
