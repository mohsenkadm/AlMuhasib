<UserControl x:Class="AlMuhasib.UI.Controls.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2"
                         UniformCornerRadius="12"
                         Padding="20"
                         Margin="0,0,0,16">
        <materialDesign:Card.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </materialDesign:Card.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                               FontSize="11" Foreground="#9E9E9E"
                               Margin="0,2,0,0"
                               Visibility="{Binding Subtitle, ElementName=Root, 
                                   Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>

                <!-- Period selector buttons (optional) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding ShowPeriodSelector, ElementName=Root,
                                Converter={StaticResource BooleanToVisibilityConverter}}">
                    <RadioButton Content="يوم" GroupName="Period" Margin="0,0,4,0"
                                 Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                 FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                 IsChecked="{Binding IsDaySelected, ElementName=Root}" />
                    <RadioButton Content="أسبوع" GroupName="Period" Margin="0,0,4,0"
                                 Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                 FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                 IsChecked="{Binding IsWeekSelected, ElementName=Root}" />
                    <RadioButton Content="شهر" GroupName="Period" Margin="0,0,4,0"
                                 Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                 FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                 IsChecked="{Binding IsMonthSelected, ElementName=Root}" />
                    <RadioButton Content="سنة" GroupName="Period"
                                 Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                 FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                 IsChecked="{Binding IsYearSelected, ElementName=Root}" />
                </StackPanel>
            </Grid>

            <!-- ═══ Chart Content (LTR canvas — avoids mirrored labels in RTL pages) ═══ -->
            <Border Grid.Row="1" FlowDirection="LeftToRight" MinHeight="250">
                <ContentPresenter Content="{Binding ChartContent, ElementName=Root}" />
            </Border>

            <!-- ═══ Empty State ═══ -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center"
                        Margin="0,20"
                        Visibility="{Binding IsEmpty, ElementName=Root,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="ChartBoxOutline"
                                         Width="48" Height="48"
                                         HorizontalAlignment="Center"
                                         Foreground="#BDBDBD" />
                <TextBlock Text="لا توجد بيانات كافية"
                           FontSize="13" Foreground="#9E9E9E"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
