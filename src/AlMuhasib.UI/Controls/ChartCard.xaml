<UserControl x:Class="AlMuhasib.UI.Controls.ChartCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <materialDesign:Card UniformCornerRadius="22"
                         Padding="0"
                         ClipToBounds="True"
                         Margin="0,0,0,16"
                         materialDesign:ElevationAssist.Elevation="Dp2"
                         Background="{DynamicResource DashboardChartCardBrush}"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Accent strip -->
            <Border Grid.Row="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2563EB" Offset="0" />
                        <GradientStop Color="#38BDF8" Offset="0.5" />
                        <GradientStop Color="#A5F3FC" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Soft ambient wash -->
            <Border Grid.Row="2" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#102563EB" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Header -->
            <Border Grid.Row="1"
                    Background="Transparent"
                    Padding="20,16,20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title, ElementName=Root}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                                   FontSize="11.5" Foreground="{DynamicResource HintForegroundBrush}"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding Subtitle, ElementName=Root,
                                       Converter={StaticResource NullToCollapsedConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowPeriodSelector, ElementName=Root,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">
                        <RadioButton Content="يوم" GroupName="Period" Margin="0,0,4,0"
                                     Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                     FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                     IsChecked="{Binding IsDaySelected, ElementName=Root}" />
                        <RadioButton Content="أسبوع" GroupName="Period" Margin="0,0,4,0"
                                     Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                     FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                     IsChecked="{Binding IsWeekSelected, ElementName=Root}" />
                        <RadioButton Content="شهر" GroupName="Period" Margin="0,0,4,0"
                                     Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                     FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                     IsChecked="{Binding IsMonthSelected, ElementName=Root}" />
                        <RadioButton Content="سنة" GroupName="Period"
                                     Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"
                                     FontSize="11" MinWidth="0" MinHeight="0" Padding="10,4"
                                     IsChecked="{Binding IsYearSelected, ElementName=Root}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chart host: flush canvas, no nested well -->
            <Border Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="12,4,16,16"
                    Margin="4,0,4,4"
                    MinHeight="250"
                    FlowDirection="LeftToRight"
                    ClipToBounds="True">
                <ContentPresenter Content="{Binding ChartContent, ElementName=Root}" />
            </Border>

            <!-- Empty state -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsEmpty, ElementName=Root,
                            Converter={StaticResource BooleanToVisibilityConverter}}">
                <materialDesign:PackIcon Kind="ChartBoxOutline"
                                         Width="48" Height="48"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource ChartEmptyIconBrush}" />
                <TextBlock Text="لا توجد بيانات كافية"
                           FontSize="13" Foreground="{DynamicResource HintForegroundBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
