<UserControl x:Class="AlMuhasib.UI.Controls.HotelFormDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Border Style="{StaticResource DialogContentWrapper}" MinWidth="{Binding MinDialogWidth, ElementName=Root}" MaxWidth="{Binding MaxDialogWidth, ElementName=Root}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{Binding AccentBrush, ElementName=Root}" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                <StackPanel>
                    <Button Command="{Binding CloseCommand, ElementName=Root}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource FlatButton}"
                            Foreground="White"
                            ToolTip="إغلاق"
                            Padding="2"
                            Margin="0,0,0,8"
                            Visibility="{Binding ShowCloseButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <md:PackIcon Kind="Close" Width="22" Height="22"/>
                    </Button>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="{Binding IconKind, ElementName=Root}" Width="26" Height="26" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"
                                     Visibility="{Binding ShowIcon, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title, ElementName=Root}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding Subtitle, ElementName=Root}" FontSize="12" Foreground="#F3E5F5" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NullToCollapsedConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="{Binding MaxContentHeight, ElementName=Root}">
                <ContentPresenter Content="{Binding DialogContent, ElementName=Root}" Margin="24,20,24,12"/>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                <Grid>
                    <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top" Margin="-20,-14,-20,8"
                                 Visibility="{Binding IsBusy, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <StackPanel>
                        <ContentPresenter Content="{Binding FooterContent, ElementName=Root}" Margin="0,0,0,12"
                                          Visibility="{Binding FooterContent, ElementName=Root, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="{Binding SaveButtonText, ElementName=Root}"
                                    Command="{Binding SaveCommand, ElementName=Root}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{Binding AccentBrush, ElementName=Root}"
                                    md:ButtonAssist.CornerRadius="8"
                                    Padding="28,10"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding IsSaveEnabled, ElementName=Root}"
                                    Visibility="{Binding ShowSaveButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="{Binding CancelButtonText, ElementName=Root}"
                                    Command="{Binding CloseCommand, ElementName=Root}"
                                    Style="{StaticResource FlatButton}"
                                    md:ButtonAssist.CornerRadius="8"
                                    Padding="24,10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
