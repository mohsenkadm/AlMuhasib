<UserControl x:Class="AlMuhasib.UI.Controls.VoiceAssistantOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             FlowDirection="RightToLeft"
             Visibility="Collapsed"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="VoiceWaveBar" TargetType="Rectangle">
            <Setter Property="Width" Value="5"/>
            <Setter Property="RadiusX" Value="2.5"/>
            <Setter Property="RadiusY" Value="2.5"/>
            <Setter Property="Fill" Value="#E0FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <Style x:Key="GlassSuggestionButton" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#F5FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#24FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="OrbPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.08" To="0.45" Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.85" To="1.18" Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.85" To="1.18" Duration="0:0:1.6"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.05" To="0.28" Duration="0:0:2.1" BeginTime="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.9" To="1.32" Duration="0:0:2.1" BeginTime="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="PulseRing2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.9" To="1.32" Duration="0:0:2.1" BeginTime="0:0:0.35"/>
            <DoubleAnimation Storyboard.TargetName="OrbGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0.95" Duration="0:0:1.4" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="OrbCenterLight"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="1" Duration="0:0:1.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="OrbCenterLight"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92" To="1.12" Duration="0:0:1.1" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="OrbCenterLight"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="1.12" Duration="0:0:1.1" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="OrbHueShift" RepeatBehavior="Forever">
            <ColorAnimation Storyboard.TargetName="OrbGradient"
                            Storyboard.TargetProperty="(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                            From="#FF22D3EE" To="#FFA855F7" Duration="0:0:3.2" AutoReverse="True"/>
            <ColorAnimation Storyboard.TargetName="OrbGradient"
                            Storyboard.TargetProperty="(GradientBrush.GradientStops)[2].(GradientStop.Color)"
                            From="#FFF472B6" To="#FF3B82F6" Duration="0:0:2.8" AutoReverse="True"/>
            <ColorAnimation Storyboard.TargetName="OrbGradient"
                            Storyboard.TargetProperty="(GradientBrush.GradientStops)[3].(GradientStop.Color)"
                            From="#FF6366F1" To="#FF06B6D4" Duration="0:0:3.6" AutoReverse="True"/>
        </Storyboard>

        <Storyboard x:Key="OverlayEntrance" RepeatBehavior="1x">
            <DoubleAnimation Storyboard.TargetName="RootPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentHost"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.82" To="1" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentHost"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.82" To="1" Duration="0:0:0.42">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="RootPanel" Opacity="0">
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.85" RadiusY="0.85">
                <GradientStop Color="#CC000000" Offset="0"/>
                <GradientStop Color="#F0111827" Offset="0.55"/>
                <GradientStop Color="#F5000000" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Background="#18000000"/>

        <StackPanel x:Name="ContentHost"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="560"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform ScaleX="0.82" ScaleY="0.82"/>
            </StackPanel.RenderTransform>

            <Grid Width="300" Height="300" Margin="0,0,0,8">
                <Ellipse x:Name="OrbGlow" Width="280" Height="280"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.75">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#004F46E5" Offset="0"/>
                            <GradientStop Color="#6622D3EE" Offset="0.45"/>
                            <GradientStop Color="#55A855F7" Offset="0.72"/>
                            <GradientStop Color="#00F472B6" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="28"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="PulseRing2" Width="250" Height="250"
                         Stroke="#44FFFFFF" StrokeThickness="1.5"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.15" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#A855F7" BlurRadius="40" ShadowDepth="0" Opacity="0.5"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="PulseRing1" Width="210" Height="210"
                         Stroke="#66FFFFFF" StrokeThickness="2"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.2" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#22D3EE" BlurRadius="32" ShadowDepth="0" Opacity="0.55"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="OrbCore" Width="156" Height="156"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush x:Name="OrbGradient" GradientOrigin="0.28,0.22" Center="0.36,0.32" RadiusX="0.72" RadiusY="0.72">
                            <GradientStop Color="#F8FFFFFF" Offset="0"/>
                            <GradientStop Color="#FF67E8F9" Offset="0.22"/>
                            <GradientStop Color="#FFC084FC" Offset="0.52"/>
                            <GradientStop Color="#FF818CF8" Offset="0.78"/>
                            <GradientStop Color="#FF312E81" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#A78BFA" BlurRadius="52" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="132" Height="132"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.28" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush GradientOrigin="0.22,0.18">
                            <GradientStop Color="#CCFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.72"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="108" Height="42"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.32" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-28"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#88FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="10"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="92" Height="36"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.22" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="34"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <BlurEffect Radius="8"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse x:Name="OrbCenterLight" Width="26" Height="26"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Opacity="0.85" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#AAFFFFFF" Offset="0.45"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFFFFF" BlurRadius="20" ShadowDepth="0" Opacity="0.95"/>
                    </Ellipse.Effect>
                </Ellipse>

                <StackPanel x:Name="OrbInnerWaves" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False">
                    <Rectangle x:Name="InnerWave1" Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="#F8FAFC" Margin="3,0" Opacity="0.92"/>
                    <Rectangle x:Name="InnerWave2" Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="#F8FAFC" Margin="3,0" Opacity="0.92"/>
                    <Rectangle x:Name="InnerWave3" Width="4" Height="26" RadiusX="2" RadiusY="2" Fill="#FFFFFF" Margin="3,0"/>
                    <Rectangle x:Name="InnerWave4" Width="4" Height="18" RadiusX="2" RadiusY="2" Fill="#F8FAFC" Margin="3,0" Opacity="0.92"/>
                    <Rectangle x:Name="InnerWave5" Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="#F8FAFC" Margin="3,0" Opacity="0.92"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="قيد الصوتي"
                       FontSize="26" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="#F8FAFC"
                       Margin="0,0,0,6">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="{Binding VoiceStatusMessage}"
                       FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                       Margin="24,0" MaxWidth="480"
                       Foreground="#D9E2EC" LineHeight="22"
                       Visibility="{Binding IsVoicePackInstalling, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

            <Border Margin="28,18,28,0" Padding="22,20" CornerRadius="20" MaxWidth="420"
                    Visibility="{Binding IsVoicePackInstalling, Converter={StaticResource BoolToVis}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                        <GradientStop Color="#1A6366F1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#55FFFFFF"/>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect Color="#6366F1" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="تجهيز التعرف الصوتي العربي"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding VoiceInstallStep}"
                               FontSize="12" Opacity="0.75"
                               Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <ProgressBar Value="{Binding VoiceInstallProgress}" Maximum="100"
                                 Height="10" Margin="0,0,0,8"
                                 Foreground="#22D3EE" Background="#33FFFFFF"/>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding VoiceInstallProgress, StringFormat={}{0:0}%}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="28" Height="28"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Foreground="#A855F7"/>
                    </Grid>

                    <TextBlock Text="{Binding VoiceStatusMessage}"
                               FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="#E2E8F0" LineHeight="20"/>
                    <TextBlock Text="لا تغلق النافذة حتى يكتمل التثبيت"
                               FontSize="11.5" Opacity="0.6" TextAlignment="Center"
                               Foreground="#CBD5E1" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VoiceTranscript}"
                       FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       TextAlignment="Center" MinHeight="30"
                       Margin="24,10,24,0" MaxWidth="480"
                       Foreground="#FFFFFF"
                       Visibility="{Binding IsVoicePackInstalling, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                </TextBlock.Effect>
            </TextBlock>

            <StackPanel x:Name="WavePanel" Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Height="40" Margin="0,18,0,10"
                        Opacity="0.9"
                        Visibility="{Binding IsVoicePackInstalling, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Rectangle x:Name="Wave1" Style="{StaticResource VoiceWaveBar}" Height="10" Margin="4,0"/>
                <Rectangle x:Name="Wave2" Style="{StaticResource VoiceWaveBar}" Height="20" Margin="4,0"/>
                <Rectangle x:Name="Wave3" Style="{StaticResource VoiceWaveBar}" Height="28" Margin="4,0"/>
                <Rectangle x:Name="Wave4" Style="{StaticResource VoiceWaveBar}" Height="34" Margin="4,0"/>
                <Rectangle x:Name="Wave5" Style="{StaticResource VoiceWaveBar}" Height="24" Margin="4,0"/>
                <Rectangle x:Name="Wave6" Style="{StaticResource VoiceWaveBar}" Height="16" Margin="4,0"/>
                <Rectangle x:Name="Wave7" Style="{StaticResource VoiceWaveBar}" Height="30" Margin="4,0"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding VoiceSuggestions}" Margin="12,6,12,0"
                          Visibility="{Binding IsVoicePackInstalling, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GlassSuggestionButton}"
                                Command="{Binding DataContext.ExecuteVoiceSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <TextBlock Text="{Binding DisplayLabel}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"
                        Visibility="{Binding IsVoiceSpeechUnavailable, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource GlassSuggestionButton}"
                        Command="{Binding RetryVoiceModelSetupCommand}"
                        Content="إعادة تنزيل نموذج الصوت"/>
            </StackPanel>

            <TextBlock Text="Ctrl+Space للفتح  •  Esc للإغلاق"
                       FontSize="11.5" Opacity="0.45" HorizontalAlignment="Center"
                       Foreground="#CBD5E1" Margin="0,22,0,0"/>

            <Button HorizontalAlignment="Center" Margin="0,16,0,0"
                    Command="{Binding CloseVoiceAssistantCommand}"
                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                    Foreground="#94A3B8" FontSize="13" Opacity="0.8">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="12,6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="إغلاق"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
