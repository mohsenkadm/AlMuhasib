<UserControl x:Class="AlMuhasib.UI.Controls.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:AlMuhasib.UI.Models"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             Width="580"
             MaxHeight="540">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:IdEqualsMultiConverter x:Key="IdEqualsMulti"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBrush}"
            CornerRadius="16"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#F57F17"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="16,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F57F17" Offset="0"/>
                        <GradientStop Color="#FFB74D" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="NotebookOutline" Width="22" Height="22"
                                                     Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="ملاحظاتي" FontSize="17" FontWeight="Bold"
                                       Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="دفتر ملاحظاتك الشخصي — تُحفظ تلقائياً"
                                   FontSize="11.5" Foreground="#FFF3E0" Margin="30,3,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="10"
                            Padding="10,4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11.5" Foreground="White">
                            <Run Text="العدد: "/>
                            <Run Text="{Binding NotesCount}" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>
                    <Button Grid.Column="2"
                            Command="{Binding CloseNotesPanelCommand}"
                            Style="{StaticResource PanelCloseButton}"
                            Foreground="White" Background="#33FFFFFF"/>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                         Visibility="{Binding IsNotesLoading, Converter={StaticResource BoolVis}}"/>

            <Grid Grid.Row="2" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Notes sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                                Command="{Binding CreateNoteCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Margin="10,10,10,8" Padding="8,6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="جديد" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,0,8,10">
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:UserNoteItem}">
                                        <Border Margin="0,0,0,6" CornerRadius="10" Padding="10,8" Cursor="Hand"
                                                Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource IdEqualsMulti}">
                                                                    <Binding Path="DataContext.SelectedNote" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                    <Binding/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="BorderBrush" Value="#F57F17"/>
                                                            <Setter Property="Background" Value="#FFF8E1"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding PreviewText}" FontSize="10.5" Margin="0,3,0,0"
                                                           Foreground="#78909C" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Notepad editor -->
                <Grid Grid.Column="1" Margin="12,12,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource NotepadPaperBorder}">
                        <Grid>
                            <Rectangle Fill="{StaticResource NotepadRuledLinesBrush}" IsHitTestVisible="False"/>
                            <StackPanel Margin="16,14,16,14">
                                <TextBox Text="{Binding NoteEditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="عنوان الملاحظة"
                                         FontSize="16" FontWeight="SemiBold"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0,0,0,8" Margin="0,0,0,4"/>
                                <Border Height="1" Background="#E0D5B7" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NoteEditorContent, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="280"
                                         FontSize="14"
                                         Background="Transparent" BorderThickness="0"
                                         materialDesign:HintAssist.Hint="اكتب ملاحظتك هنا..."/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedNoteLastEditedDisplay, Mode=OneWay, StringFormat='آخر تعديل: {0}'}"
                                       FontSize="11.5" Foreground="#78909C" VerticalAlignment="Center"/>
                            <Border Background="#E8F5E9" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                                    Visibility="{Binding IsNoteSavedIndicatorVisible, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Check" Width="14" Height="14" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    <TextBlock Text="تم الحفظ" FontSize="10.5" FontWeight="Bold" Foreground="#2E7D32" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding DeleteNoteCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Padding="10,6" Margin="0,0,8,0"
                                ToolTip="حذف الملاحظة">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#E53935" VerticalAlignment="Center"/>
                                <TextBlock Text="حذف" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding CreateNoteCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="NotebookPlus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="ملاحظة جديدة" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Empty state -->
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Background="#99FFF8E1" CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotesCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="NotebookEditOutline" Width="48" Height="48"
                                                     Foreground="#F57F17" HorizontalAlignment="Center"/>
                            <TextBlock Text="ابدأ بكتابة ملاحظتك الأولى"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,12,0,12"
                                       HorizontalAlignment="Center" Foreground="#5D4037"/>
                            <Button Command="{Binding CreateNoteCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="16,8">
                                <TextBlock Text="إنشاء ملاحظة"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
