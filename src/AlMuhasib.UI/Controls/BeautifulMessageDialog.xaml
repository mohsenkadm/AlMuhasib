<Window x:Class="AlMuhasib.UI.Controls.BeautifulMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AlMuhasib"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="460"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.85" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.85" To="1" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShowAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="DialogCard"
            Background="White"
            CornerRadius="18"
            Margin="16"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.22" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header with icon -->
                <RowDefinition Height="Auto"/>  <!-- Message -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- HEADER                                      -->
            <!-- ═══════════════════════════════════════════ -->
            <Border x:Name="HeaderBorder" Grid.Row="0"
                    CornerRadius="18,18,0,0"
                    Padding="28,24,28,20"
                    MouseLeftButtonDown="HeaderBorder_MouseLeftButtonDown">
                <StackPanel HorizontalAlignment="Center">
                    <Border x:Name="IconCircle"
                            Width="60" Height="60" CornerRadius="30"
                            HorizontalAlignment="Center">
                        <materialDesign:PackIcon x:Name="DialogIcon"
                                                 Width="30" Height="30"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText"
                               FontSize="19" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- MESSAGE                                     -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="1" Padding="28,20,28,8">
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           FontSize="14"
                           LineHeight="22"
                           Foreground="#424242"
                           TextAlignment="Center"
                           MaxWidth="380"/>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- BUTTONS                                     -->
            <!-- ═══════════════════════════════════════════ -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="28,16,28,24">
                <!-- Buttons are added programmatically -->
            </StackPanel>
        </Grid>
    </Border>
</Window>
