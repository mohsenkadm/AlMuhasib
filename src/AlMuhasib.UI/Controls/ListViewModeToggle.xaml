<UserControl x:Class="AlMuhasib.UI.Controls.ListViewModeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <Border x:Name="Shell" CornerRadius="9" Padding="3">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#E8EDF2"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OnDarkBackground, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="#2FFFFFFF"/>
                        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="TableButton"
                         IsChecked="{Binding IsCardView, Converter={StaticResource InverseBooleanConverter}}"
                         ToolTip="عرض جدول"
                         Cursor="Hand"
                         MinWidth="0" MinHeight="0"
                         BorderThickness="0" Background="Transparent">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" CornerRadius="6" Padding="9,6" Background="Transparent">
                            <md:PackIcon x:Name="Icon" Kind="ViewList" Width="17" Height="17"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="White"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Icon" Property="Foreground" Value="#ECEFF1"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Icon" Property="Foreground" Value="#78909C"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background" Value="#18FFFFFF"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background" Value="#ECEFF1"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <RadioButton x:Name="CardButton"
                         IsChecked="{Binding IsCardView}"
                         ToolTip="عرض بطاقات"
                         Cursor="Hand"
                         MinWidth="0" MinHeight="0"
                         BorderThickness="0" Background="Transparent">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" CornerRadius="6" Padding="9,6" Background="Transparent">
                            <md:PackIcon x:Name="Icon" Kind="ViewModule" Width="17" Height="17"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="White"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="#1565C0"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Icon" Property="Foreground" Value="#ECEFF1"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Icon" Property="Foreground" Value="#78909C"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background" Value="#18FFFFFF"/>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding OnDarkBackground, ElementName=Root}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Segment" Property="Background" Value="#ECEFF1"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </StackPanel>
    </Border>
</UserControl>
