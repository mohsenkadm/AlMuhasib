<UserControl x:Class="AlMuhasib.UI.Controls.ListViewModeToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             FlowDirection="RightToLeft"
             x:Name="Root"
             Height="40">

    <!-- مبدّل قائمة/بطاقات: كبسولة زجاج شفافة بحجمها الأصلي -->
    <Grid MinWidth="76">
        <controls:LiquidGlassChrome Tone="Standard" ShadowStrength="0.34"/>

        <StackPanel Orientation="Horizontal" Margin="3,2" VerticalAlignment="Center">
            <RadioButton x:Name="TableButton"
                         IsChecked="{Binding IsCardView, Converter={StaticResource InverseBooleanConverter}}"
                         ToolTip="عرض جدول"
                         Cursor="Hand"
                         MinWidth="0" MinHeight="0"
                         BorderThickness="0" Background="Transparent">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Bd" Width="34" Height="30" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <controls:LiquidGlassChrome x:Name="ActiveGlass"
                                                        Tone="Standard"
                                                        IsActive="True"
                                                        ShadowStrength="0.22"
                                                        Visibility="Collapsed"/>
                            <md:PackIcon x:Name="Icon" Kind="ViewList" Width="25" Height="25"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveGlass" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <RadioButton x:Name="CardButton"
                         IsChecked="{Binding IsCardView}"
                         ToolTip="عرض بطاقات"
                         Cursor="Hand"
                         MinWidth="0" MinHeight="0"
                         BorderThickness="0" Background="Transparent">
                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="Bd" Width="38" Height="30" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <controls:LiquidGlassChrome x:Name="ActiveGlass"
                                                        Tone="Standard"
                                                        IsActive="True"
                                                        ShadowStrength="0.22"
                                                        Visibility="Collapsed"/>
                            <md:PackIcon x:Name="Icon" Kind="ViewModule" Width="20" Height="20"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ActiveGlass" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </StackPanel>
    </Grid>
</UserControl>
