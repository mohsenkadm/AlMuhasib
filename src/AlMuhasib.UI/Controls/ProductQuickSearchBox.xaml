<UserControl x:Class="AlMuhasib.UI.Controls.ProductQuickSearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:models="clr-namespace:AlMuhasib.UI.Models"
             x:Name="Root"
             FlowDirection="RightToLeft"
             MinWidth="160">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid>
        <TextBox x:Name="SearchBox"
                 Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                 materialDesign:HintAssist.Hint="ابحث بالاسم أو العلمي..."
                 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                 BorderThickness="0"
                 Background="Transparent"
                 FontSize="13"
                 Padding="0,2"
                 VerticalContentAlignment="Center"
                 GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                 LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                 TextChanged="SearchBox_TextChanged"/>

        <Popup x:Name="SuggestionsPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=SearchBox}"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               HorizontalOffset="-8"
               VerticalOffset="4"
               Opened="SuggestionsPopup_Opened">
            <Border x:Name="PopupCard"
                    Width="480"
                    MaxHeight="360"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#D6E3F0"
                    BorderThickness="1"
                    Padding="0"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0"
                    SnapsToDevicePixels="True">
                <Border.RenderTransform>
                    <TranslateTransform Y="-8"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.22" Color="#000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="14,14,0,0" Padding="14,10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0D47A1" Offset="0"/>
                                <GradientStop Color="#1976D2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="10" Background="#33FFFFFF" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="اقتراحات المواد" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                <TextBlock Text="المخزون لكل مخزن والسعر إن وُجد" FontSize="10" Foreground="#BBDEFB"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280" Padding="8,6">
                        <ItemsControl x:Name="SuggestionsList" ItemsSource="{Binding Suggestions, ElementName=Root}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ProductSearchSuggestion}">
                                    <Border x:Name="ItemBd"
                                            Margin="0,0,0,6"
                                            Padding="10,8"
                                            CornerRadius="10"
                                            BorderBrush="#E3ECF5"
                                            BorderThickness="1"
                                            Background="#FAFCFF"
                                            Cursor="Hand"
                                            PreviewMouseLeftButtonDown="Suggestion_PreviewMouseLeftButtonDown">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock FontSize="13" Foreground="#1A237E" TextWrapping="Wrap"
                                                       behaviors:HighlightingTextBlockBehavior.HighlightText="{Binding Name}"
                                                       behaviors:HighlightingTextBlockBehavior.SearchTerm="{Binding SearchTerm}"/>

                                            <TextBlock Grid.Row="1" FontSize="10" Foreground="#607D8B" Margin="0,2,0,0"
                                                       Visibility="{Binding HasScientificName, Converter={StaticResource BoolVis}}"
                                                       behaviors:HighlightingTextBlockBehavior.HighlightText="{Binding ScientificName}"
                                                       behaviors:HighlightingTextBlockBehavior.SearchTerm="{Binding SearchTerm}"/>

                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding WarehouseStocks}" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:WarehouseStockChip}">
                                                        <Border Background="#E3F2FD" CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                                            <TextBlock FontSize="10" Foreground="#1565C0">
                                                                <Run Text="{Binding WarehouseName, Mode=OneWay}"/>
                                                                <Run Text=":"/>
                                                                <Run Text="{Binding QuantityLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                            </TextBlock>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border Grid.Row="3" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                    Background="#FFF8E1" CornerRadius="8" Padding="8,3"
                                                    Visibility="{Binding HasPrice, Converter={StaticResource BoolVis}}">
                                                <TextBlock Text="{Binding PriceLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#F57F17"/>
                                            </Border>
                                            <TextBlock Grid.Row="3" HorizontalAlignment="Right" Margin="0,4,0,0"
                                                       Text="{Binding PriceLabel}" FontSize="10" Foreground="#90A4AE">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPrice}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="ItemBd" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#EEF5FF"/>
                                            <Setter TargetName="ItemBd" Property="BorderBrush" Value="#90CAF9"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="#F7FAFD" BorderBrush="#E8EEF5" BorderThickness="0,1,0,0"
                            CornerRadius="0,0,14,14" Padding="12,8">
                        <TextBlock x:Name="EmptyHint" FontSize="11" Foreground="#78909C"
                                   Text="ابدأ الكتابة لعرض المواد المقترحة مع أرصدة المخازن"/>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
