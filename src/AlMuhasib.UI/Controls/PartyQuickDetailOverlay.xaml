<UserControl x:Class="AlMuhasib.UI.Controls.PartyQuickDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <Style x:Key="MetaPill" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="StatPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="140"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="880" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00695C" Offset="0"/>
                            <GradientStop Color="#00897B" Offset="0.55"/>
                            <GradientStop Color="#26A69A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="AccountDetails" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="13" Foreground="#E0F2F1" Margin="0,4,0,0">
                                    <Run Text="{Binding TypeLabel, Mode=OneWay}"/>
                                    <Run Text=" — تفاصيل سريعة"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="CloseButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16"
                                  Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <Border Style="{StaticResource MetaPill}"
                                        Visibility="{Binding Phone, Converter={StaticResource NullToCollapsedConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="الهاتف" FontSize="11" Foreground="#90A4AE"/>
                                        <TextBlock Text="{Binding Phone}" FontWeight="SemiBold" Foreground="#37474F"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetaPill}"
                                        Visibility="{Binding Address, Converter={StaticResource NullToCollapsedConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="العنوان" FontSize="11" Foreground="#90A4AE"/>
                                        <TextBlock Text="{Binding Address}" FontWeight="SemiBold" Foreground="#37474F" TextWrapping="Wrap" MaxWidth="280"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetaPill}"
                                        Visibility="{Binding FileNumber, Converter={StaticResource NullToCollapsedConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="رقم الملف" FontSize="11" Foreground="#90A4AE"/>
                                        <TextBlock Text="{Binding FileNumber}" FontWeight="SemiBold" Foreground="#37474F"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,4,0,12">
                                <Border Style="{StaticResource StatPill}" Background="#FFEBEE">
                                    <StackPanel>
                                        <TextBlock Text="المطلوب / الرصيد" FontSize="11" Foreground="#C62828"/>
                                        <TextBlock Text="{Binding BalanceText}" FontSize="18" FontWeight="Bold" Foreground="#B71C1C"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatPill}" Background="#E3F2FD">
                                    <StackPanel>
                                        <TextBlock Text="عدد التعاملات" FontSize="11" Foreground="#1565C0"/>
                                        <TextBlock Text="{Binding DealCountText}" FontSize="18" FontWeight="Bold" Foreground="#0D47A1"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatPill}" Background="#E8F5E9">
                                    <StackPanel>
                                        <TextBlock Text="إجمالي التعاملات" FontSize="11" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding TotalDealAmountText}" FontSize="18" FontWeight="Bold" Foreground="#1B5E20"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border Background="#FFF8E1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="History" Foreground="#F57C00" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="آخر تعامل" FontSize="11" Foreground="#EF6C00"/>
                                        <TextBlock Text="{Binding LastDealText}" FontWeight="SemiBold" Foreground="#E65100" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="المواد التي تم التعامل عليها" FontSize="15" FontWeight="Bold"
                                       Foreground="#00695C" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding Products}" Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      MaxHeight="200" Margin="0,0,0,14"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="المادة" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="الكمية" Binding="{Binding TotalQuantity, StringFormat=N2}" Width="80"/>
                                    <DataGridTextColumn Header="مرات" Binding="{Binding DealCount}" Width="60"/>
                                    <DataGridTextColumn Header="آخر تاريخ" Binding="{Binding LastDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="100"/>
                                    <DataGridTextColumn Header="آخر سعر" Binding="{Binding LastUnitPrice, StringFormat=N0}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Text="آخر الحركات" FontSize="15" FontWeight="Bold"
                                       Foreground="#00695C" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding RecentTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F5F7FA" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="#37474F" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Date, StringFormat=\{0:yyyy/MM/dd\}}" FontSize="11" Foreground="#90A4AE" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                    <TextBlock FontSize="12" Foreground="#78909C" HorizontalAlignment="Left">
                                                        <Run Text="مدين "/><Run Text="{Binding Debit, Mode=OneWay, StringFormat=N0}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="12" Foreground="#78909C" HorizontalAlignment="Left">
                                                        <Run Text="دائن "/><Run Text="{Binding Credit, Mode=OneWay, StringFormat=N0}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="48" Height="48"/>
                        <TextBlock Text="جاري تحميل التفاصيل…" Margin="0,14,0,0" Foreground="#607D8B"/>
                    </StackPanel>

                    <Border Margin="24" Padding="16" Background="#FFEBEE" CornerRadius="12" VerticalAlignment="Center"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                        Padding="22,14" CornerRadius="0,0,18,18">
                    <Button Click="CloseButton_Click" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Height="40" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="إغلاق" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
