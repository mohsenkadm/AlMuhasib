<Window x:Class="AlMuhasib.UI.Controls.ProductSizeQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="اختيار القياس والكمية"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Width="480" Height="520"
        MinWidth="420" MinHeight="400">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="#E0E0E0" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#C2185B" Offset="0"/>
                        <GradientStop Color="#AD1457" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="اختيار القياس والكمية" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding ProductName}" FontSize="14" Foreground="#FCE4EC" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ModeHint}" FontSize="12" Foreground="#F8BBD0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignIconButton}" Foreground="White"
                            Click="Cancel_Click" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Sizes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="12" Background="#FAFAFA" CornerRadius="10"
                                        BorderBrush="#EEEEEE" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SizeName}" FontSize="16" FontWeight="SemiBold" Foreground="#212121"/>
                                            <TextBlock FontSize="12" Foreground="#757575" Margin="0,4,0,0"
                                                       Visibility="{Binding DataContext.ShowStock, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}">
                                                <Run Text="المتاح:"/>
                                                <Run Text="{Binding AvailableStock, StringFormat=N0}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Width="34" Height="34" FontSize="16" FontWeight="Bold"
                                                    Command="{Binding DecreaseCommand}" Margin="0,0,6,0"
                                                    Style="{StaticResource OutlinedButton}" Padding="0"/>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Width="64" Height="34" TextAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Style="{StaticResource FilledTextBox}"/>
                                            <Button Content="+" Width="34" Height="34" FontSize="16" FontWeight="Bold"
                                                    Command="{Binding IncreaseCommand}" Margin="6,0,0,0"
                                                    Style="{StaticResource PrimaryButton}" Padding="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="#FCE4EC" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                        <TextBlock FontWeight="SemiBold" Foreground="#880E4F">
                            <Run Text="إجمالي الكمية:"/>
                            <Run Text="{Binding TotalQuantity, StringFormat=N0, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,12" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="تأكيد" Style="{StaticResource PrimaryButton}" Padding="24,10"
                            Click="Confirm_Click" MinWidth="120"/>
                    <Button Content="إلغاء" Style="{StaticResource OutlinedButton}" Padding="24,10"
                            Click="Cancel_Click" Margin="10,0,0,0" MinWidth="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
