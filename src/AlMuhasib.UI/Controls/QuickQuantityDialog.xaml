<Window x:Class="AlMuhasib.UI.Controls.QuickQuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="الكمية"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Width="400" Height="260"
        MinWidth="360" MinHeight="240">

    <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E7D32" Offset="0"/>
                        <GradientStop Color="#1B5E20" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="إدخال الكمية" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="ProductNameText" FontSize="13" Foreground="#C8E6C9"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20" VerticalAlignment="Center">
                <TextBlock Text="الكمية" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>
                <Border Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="#2E7D32" BorderThickness="2"
                        CornerRadius="10" Padding="8" MinHeight="56">
                    <TextBox x:Name="QuantityBox"
                             FontSize="28" FontWeight="Bold"
                             MinHeight="40"
                             MinWidth="160"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="12,6"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             PreviewKeyDown="QuantityBox_PreviewKeyDown"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,0,16,18">
                <Button Content="تأكيد" Style="{StaticResource PrimaryButton}" Width="120" Height="40"
                        Click="Confirm_Click" Margin="0,0,10,0" IsDefault="True"/>
                <Button Content="إلغاء" Style="{StaticResource OutlinedButton}" Width="110" Height="40"
                        Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
