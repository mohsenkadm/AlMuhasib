<UserControl x:Class="AlMuhasib.UI.Controls.HotelListPageShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,12"/>
                <ContentPresenter Content="{Binding ToolbarContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"/>
            </StackPanel>
        </md:Card>

        <!-- Main list + preview -->
        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{Binding PreviewPanelWidth, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <controls:ListTableHeaderBar Grid.Row="0"
                                                 Title="{Binding ListTitle, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 TargetDataGrid="{Binding TargetDataGrid, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 IsFilterPanelOpen="{Binding IsFilterPanelOpen, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveFilterCount, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ClearFiltersCommand="{Binding ClearFiltersCommand, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ExportCommand="{Binding ExportCommand, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 PrintCommand="{Binding PrintCommand, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ShowCardToggle="{Binding ShowCardToggle, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ShowFilter="{Binding ShowFilter, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ShowExport="{Binding ShowExport, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ShowPrint="{Binding ShowPrint, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                 ExtraContent="{Binding ListHeaderExtra, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"/>

                    <controls:HotelListStatsBar Grid.Row="1"
                                                Margin="16,12,16,4"
                                                ItemsSource="{Binding StatsItemsSource, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                Visibility="{Binding ShowStatsBar, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}, Converter={StaticResource BoolVis}}"/>

                    <ContentPresenter Grid.Row="2"
                                      Content="{Binding ListContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                      Margin="0"/>

                    <ContentPresenter Grid.Row="3"
                                      Content="{Binding ListFooterContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                      Visibility="{Binding ListFooterContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <controls:PaginationBar Grid.Row="4"
                                            Visibility="{Binding ShowPagination, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}, Converter={StaticResource BoolVis}}"/>
                </Grid>

                <controls:HotelEntityPreviewPanel Grid.Column="1"
                                                    HasSelection="{Binding HasPreviewSelection, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    Title="{Binding PreviewTitle, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    Subtitle="{Binding PreviewSubtitle, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    IconKind="{Binding PreviewIconKind, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    SelectedTabIndex="{Binding PreviewSelectedTab, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}, Mode=TwoWay}"
                                                    SummaryContent="{Binding PreviewSummaryContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    HistoryContent="{Binding PreviewHistoryContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    ActionsContent="{Binding PreviewActionsContent, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    CloseCommand="{Binding ClosePreviewCommand, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    ShowCloseButton="{Binding ShowPreviewCloseButton, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}}"
                                                    Visibility="{Binding ShowPreviewPanel, RelativeSource={RelativeSource AncestorType=controls:HotelListPageShell}, Converter={StaticResource BoolVis}}"/>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
