<UserControl x:Class="AlMuhasib.UI.Controls.ReportBulkInstallmentPayBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
    </UserControl.Resources>

    <Border Background="#E3F2FD" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
            Visibility="{Binding HasBulkInstallmentSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Foreground="#1565C0">
                    <Run Text="تسديد جماعي — محدد: "/>
                    <Run Text="{Binding BulkInstallmentCount, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" قسط | الإجمالي: "/>
                    <Run Text="{Binding BulkInstallmentTotal, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" د.ع"/>
                </TextBlock>
                <TextBlock Text="{Binding BulkInstallmentMessage}" FontSize="11" Foreground="#C62828" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding BulkInstallmentMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding BulkPayCashBoxes}" SelectedItem="{Binding BulkPayCashBox}"
                          DisplayMemberPath="Name" Width="140" Margin="0,0,8,0"
                          Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="الصندوق"/>
                <Button Content="تسديد المحدد" Style="{StaticResource SuccessButton}"
                        Command="{Binding PayBulkInstallmentsCommand}" Padding="14,0" Height="36" Margin="0,0,6,0"/>
                <Button Content="إلغاء التحديد" Style="{StaticResource OutlinedButton}"
                        Command="{Binding ClearBulkInstallmentSelectionCommand}" Height="36"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
