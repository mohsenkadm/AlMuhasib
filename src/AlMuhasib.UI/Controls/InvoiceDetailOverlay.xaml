<UserControl x:Class="AlMuhasib.UI.Controls.InvoiceDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="MetaPill" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="920" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1976D2" Offset="0.6"/>
                            <GradientStop Color="#42A5F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="13" Foreground="#E3F2FD" Margin="0,4,0,0">
                                    <Run Text="رقم الفاتورة:"/>
                                    <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="CloseButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="التاريخ" FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Foreground="#37474F"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PartyLabel}" FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold" Foreground="#37474F"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="المخزن" FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding WarehouseName}" FontWeight="SemiBold" Foreground="#37474F"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="طريقة الدفع" FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding PaymentMethod}" FontWeight="SemiBold" Foreground="#1565C0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}"
                                    Visibility="{Binding CreditDueDateText, Converter={StaticResource NullToCollapsedConverter}}">
                                <StackPanel>
                                    <TextBlock Text="تاريخ الاستحقاق" FontSize="11" Foreground="#90A4AE"/>
                                    <TextBlock Text="{Binding CreditDueDateText}" FontWeight="SemiBold" Foreground="#37474F"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Background="#FFF8E1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding HasCreditInfo, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardClockOutline" Foreground="#F57C00" VerticalAlignment="Center"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#E65100">
                                    <Run Text="المدفوع:"/><Run Text="{Binding PaidAmountText, Mode=OneWay}"/>
                                    <Run Text="  |  المتبقي:"/><Run Text="{Binding RemainingAmountText, Mode=OneWay}"/>
                                    <Run Text="  |  "/><Run Text="{Binding CreditStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="#E8F5E9" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding HasInstallments, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InstallmentSummaryText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="#1B5E20" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="بنود الفاتورة" FontSize="15" FontWeight="Bold" Foreground="#1565C0" Margin="0,4,0,10"/>
                        <DataGrid ItemsSource="{Binding Items}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="220" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="80"/>
                                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPriceText}" Width="90"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPriceText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="جدول الأقساط" FontSize="15" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,10"
                                   Visibility="{Binding HasInstallments, Converter={StaticResource BoolVis}}"/>
                        <DataGrid ItemsSource="{Binding Installments}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="180" Margin="0,0,0,14"
                                  Visibility="{Binding HasInstallments, Converter={StaticResource BoolVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDateText}" Width="120"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="110"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#F5F7FA" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="المجموع:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding SubtotalText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="الخصم:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding DiscountText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="التقريب:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding RoundingText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding CompanyFeeText, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="نسبة الشركة:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding CompanyFeeText}" Foreground="#6A1B9A" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="الصافي" FontSize="12" Foreground="#78909C" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding GrandTotalText}" FontSize="24" FontWeight="Bold"
                                               Foreground="#1565C0" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#ECEFF1" CornerRadius="10" Padding="12,10"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="ملاحظات" FontSize="11" Foreground="#78909C"/>
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#455A64"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                        Padding="22,14" CornerRadius="0,0,18,18">
                    <Button Click="CloseButton_Click" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Height="40" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="تم" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
