<UserControl x:Class="AlMuhasib.UI.Controls.InvoiceDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="MetaPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MutedIconBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="920" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1976D2" Offset="0.6"/>
                            <GradientStop Color="#42A5F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="13" Foreground="#E3F2FD" Margin="0,4,0,0">
                                    <Run Text="رقم الفاتورة:"/>
                                    <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Click="CloseButton_Click"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="التاريخ" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PartyLabel}" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="المخزن" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding WarehouseName}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="طريقة الدفع" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding PaymentMethod}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}"
                                    Visibility="{Binding CreditDueDateText, Converter={StaticResource NullToCollapsedConverter}}">
                                <StackPanel>
                                    <TextBlock Text="تاريخ الاستحقاق" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding CreditDueDateText}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Background="{DynamicResource TitleBarIconBadgeAmberBg}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding HasCreditInfo, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardClockOutline" Foreground="{DynamicResource TitleBarIconBadgeAmberFg}" VerticalAlignment="Center"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TitleBarIconBadgeAmberFg}">
                                    <Run Text="المدفوع:"/><Run Text="{Binding PaidAmountText, Mode=OneWay}"/>
                                    <Run Text="  |  المتبقي:"/><Run Text="{Binding RemainingAmountText, Mode=OneWay}"/>
                                    <Run Text="  |  "/><Run Text="{Binding CreditStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource TitleBarIconBadgeGreenBg}" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding HasInstallments, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarClock" Foreground="{DynamicResource TitleBarIconBadgeGreenFg}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding InstallmentSummaryText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TitleBarIconBadgeGreenFg}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="بنود الفاتورة" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <controls:ColumnFilterToggle Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Margin="12,0,0,0"
                                                         IsChecked="{Binding Path=(behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen), ElementName=InvoiceDetailItemsGrid, Mode=TwoWay}"
                                                         ActiveFilterCount="{Binding Path=(behaviors:DataGridColumnFilterBehavior.ActiveFilterCount), ElementName=InvoiceDetailItemsGrid}"
                                                         TargetDataGrid="{Binding ElementName=InvoiceDetailItemsGrid}"/>
                        </Grid>
                        <DataGrid x:Name="InvoiceDetailItemsGrid"
                                  ItemsSource="{Binding Items}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="220" Margin="0,0,0,14"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Number"/>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ItemName"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="80"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="QuantityText"/>
                                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPriceText}" Width="90"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="UnitPriceText"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPriceText}" Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalPriceText"/>
                                <DataGridTextColumn Header="انتهاء الضمان" Binding="{Binding WarrantyEndDateText}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WarrantyEndDateText"/>
                                <DataGridTextColumn Header="حالة الضمان" Binding="{Binding WarrantyStatusText}" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WarrantyStatusText"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Margin="0,0,0,10"
                              Visibility="{Binding HasInstallments, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="جدول الأقساط" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <controls:ColumnFilterToggle Grid.Column="1"
                                                         VerticalAlignment="Center"
                                                         Margin="12,0,0,0"
                                                         IsChecked="{Binding Path=(behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen), ElementName=InvoiceDetailInstallmentsGrid, Mode=TwoWay}"
                                                         ActiveFilterCount="{Binding Path=(behaviors:DataGridColumnFilterBehavior.ActiveFilterCount), ElementName=InvoiceDetailInstallmentsGrid}"
                                                         TargetDataGrid="{Binding ElementName=InvoiceDetailInstallmentsGrid}"/>
                        </Grid>
                        <DataGrid x:Name="InvoiceDetailInstallmentsGrid"
                                  ItemsSource="{Binding Installments}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="180" Margin="0,0,0,14"
                                  Visibility="{Binding HasInstallments, Converter={StaticResource BoolVis}}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Number"/>
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDateText}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDateText"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AmountText"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding StatusText}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StatusText"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{DynamicResource MutedIconBackgroundBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="المجموع:" Width="120" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding SubtotalText}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="الخصم:" Width="120" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding DiscountText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="التقريب:" Width="120" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding RoundingText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding TransportFeeText, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="أجور النقل:" Width="120" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TransportFeeText}" Foreground="{DynamicResource PrimaryHueDarkBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                                Visibility="{Binding CompanyFeeText, Converter={StaticResource NullToCollapsedConverter}}">
                                        <TextBlock Text="نسبة الشركة:" Width="120" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding CompanyFeeText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="الصافي" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding GrandTotalText}" FontSize="24" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueDarkBrush}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource MutedIconBackgroundBrush}" CornerRadius="10" Padding="12,10"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="ملاحظات" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                        Padding="22,14" CornerRadius="0,0,18,18">
                    <Button Click="CloseButton_Click" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Height="40" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="تم" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
