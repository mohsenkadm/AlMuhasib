<UserControl x:Class="AlMuhasib.UI.Controls.Loyalty.LoyaltyPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
    </UserControl.Resources>

    <Border x:Name="PanelRoot"
            Opacity="0"
            Visibility="{Binding ShowLoyaltyPanel, Converter={StaticResource BoolVis}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="CornerRadius" Value="10"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Border.RenderTransform>
            <TranslateTransform Y="18"/>
        </Border.RenderTransform>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B71C1C" Offset="0"/>
                <GradientStop Color="#E53935" Offset="0.55"/>
                <GradientStop Color="#FF7043" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect x:Name="PanelShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.28" Color="#B71C1C"/>
        </Border.Effect>

        <Grid>
        <!-- Full layout (sales invoice) -->
        <StackPanel x:Name="FullLayout">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#33FFFFFF" CornerRadius="10" Padding="8" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="GiftOutline" Width="22" Height="22" Foreground="White"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="نظام الولاء" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding LoyaltyCustomerLabel}" FontSize="11" Foreground="#FFEBEE"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding LoyaltyBalance}" FontSize="22" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="نقطة متاحة" FontSize="10" Foreground="#FFCDD2" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#22FFFFFF" CornerRadius="10" Padding="10,8" Margin="0,0,0,8"
                    Visibility="{Binding HasLoyaltyCustomer, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="متوقع كسبها" FontSize="11" Foreground="#FFCDD2"/>
                        <TextBlock Text="{Binding LoyaltyExpectedEarnPoints, StringFormat='{}{0} نقطة'}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="أقصى استبدال" FontSize="11" Foreground="#FFCDD2"/>
                        <TextBlock Text="{Binding LoyaltyMaxRedeemPoints, StringFormat='{}{0} نقطة'}"
                                   FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding HasLoyaltyCustomer, Converter={StaticResource BoolVis}}">
                <TextBlock Text="استبدال نقاط (خصم على الفاتورة)" FontSize="12" FontWeight="SemiBold"
                           Foreground="White" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LoyaltyRedeemPoints, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="عدد النقاط"
                             materialDesign:HintAssist.Foreground="White"
                             Foreground="White"
                             CaretBrush="White"
                             BorderBrush="#66FFFFFF"
                             Background="#22FFFFFF"
                             Padding="10,8"/>
                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,8"
                            Command="{Binding RedeemMaxLoyaltyCommand}"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            ToolTip="استبدال الكل المتاح">
                        <materialDesign:PackIcon Kind="ArrowCollapseDown" Width="18" Height="18"/>
                    </Button>
                    <Button Grid.Column="2" Margin="6,0,0,0" Padding="10,8"
                            Command="{Binding ClearLoyaltyRedeemCommand}"
                            Background="#33FFFFFF" BorderBrush="#66FFFFFF" Foreground="White"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            ToolTip="مسح الاستبدال">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="خصم الولاء" Foreground="#FFEBEE" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding LoyaltyDiscountAmount, StringFormat='{}{0:N0} د.ع'}"
                               FontWeight="Bold" Foreground="White" FontSize="16"/>
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding LoyaltyStatusMessage}"
                       FontSize="11" Foreground="#FFEBEE" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasLoyaltyStatusMessage, Converter={StaticResource BoolVis}}"/>
        </StackPanel>

        <!-- Compact layout (POS cashier) -->
        <StackPanel x:Name="CompactLayout">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="GiftOutline" Width="16" Height="16" Foreground="White"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="الولاء" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="{Binding LoyaltyCustomerLabel}" FontSize="10" Foreground="#FFCDD2"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#33FFFFFF" CornerRadius="8" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="White">
                        <Run Text="{Binding LoyaltyBalance, Mode=OneWay}"/>
                        <Run Text=" نقطة" FontSize="10" FontWeight="Normal"/>
                    </TextBlock>
                </Border>
            </Grid>

            <Grid Visibility="{Binding HasLoyaltyCustomer, Converter={StaticResource BoolVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding LoyaltyRedeemPoints, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="استبدال نقاط"
                         materialDesign:HintAssist.Foreground="#FFCDD2"
                         materialDesign:HintAssist.IsFloating="False"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#66FFFFFF"
                         Background="#22FFFFFF"
                         Padding="8,6"
                         FontSize="12"
                         Height="34"
                         VerticalContentAlignment="Center"/>
                <Button Grid.Column="1" Margin="6,0,0,0" Width="32" Height="34" Padding="0"
                        Command="{Binding RedeemMaxLoyaltyCommand}"
                        Background="#33FFFFFF" BorderBrush="#66FFFFFF" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        ToolTip="{Binding LoyaltyMaxRedeemPoints, StringFormat='أقصى: {0}'}">
                    <materialDesign:PackIcon Kind="ArrowCollapseDown" Width="16" Height="16"/>
                </Button>
                <Button Grid.Column="2" Margin="4,0,0,0" Width="32" Height="34" Padding="0"
                        Command="{Binding ClearLoyaltyRedeemCommand}"
                        Background="#33FFFFFF" BorderBrush="#66FFFFFF" Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        ToolTip="مسح">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                </Button>
                <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding LoyaltyDiscountAmount, StringFormat='{}{0:N0}'}"
                           FontWeight="Bold" Foreground="White" FontSize="13"
                           ToolTip="خصم الولاء"/>
            </Grid>

            <TextBlock Text="{Binding LoyaltyStatusMessage}"
                       FontSize="10" Foreground="#FFEBEE" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="{Binding HasLoyaltyStatusMessage, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
