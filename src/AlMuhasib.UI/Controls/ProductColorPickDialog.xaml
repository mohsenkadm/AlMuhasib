<Window x:Class="AlMuhasib.UI.Controls.ProductColorPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="اختيار اللون"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Width="420" Height="420"
        MinWidth="360" MinHeight="320">

    <Border Background="White" CornerRadius="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#0D47A1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="اختيار اللون" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ProductNameText" FontSize="14" Foreground="#BBDEFB" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="اختر لوناً ثم أكّد لإضافة المنتج إلى السلة" FontSize="12" Foreground="#90CAF9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignIconButton}" Foreground="White"
                            Click="Cancel_Click" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </Border>

            <ListBox x:Name="ColorsList"
                     Grid.Row="1"
                     Margin="16,12"
                     DisplayMemberPath="ColorName"
                     MouseDoubleClick="Confirm_Click"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,16,16">
                <Button Content="تأكيد" Style="{StaticResource PrimaryButton}" Width="110" Click="Confirm_Click" Margin="0,0,8,0"/>
                <Button Content="تخطي" Style="{StaticResource OutlinedButton}" Width="100" Click="Skip_Click" Margin="0,0,8,0" ToolTip="إضافة بدون لون"/>
                <Button Content="إلغاء" Style="{StaticResource OutlinedButton}" Width="100" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
