<Window x:Class="AlMuhasib.UI.Controls.ProductBarcodeEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إدارة الباركودات"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Width="540" Height="580"
        FontFamily="{DynamicResource AppFont}"
        TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: عمود العنوان + عمود الإغلاق منفصلان لتفادي التعارض في RTL -->
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="18,14"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="20"
                                Background="#33FFFFFF" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Barcode" Width="22" Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إدارة الباركودات" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="كل باركود في سطر مستقل — يمكن الإضافة والتعديل" FontSize="12"
                                       Foreground="#E3F2FD" Margin="0,4,0,0" Opacity="0.92"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="White"
                            Click="Close_Click"
                            ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewBarcodeBox"
                             materialDesign:HintAssist.Hint="أضف باركود جديد…"
                             Style="{StaticResource FilledTextBox}"
                             VerticalContentAlignment="Center"
                             MinHeight="48"
                             Padding="14,12"
                             KeyDown="NewBarcodeBox_KeyDown"/>
                    <Button Grid.Column="1" Margin="12,0,0,0" MinHeight="48" MinWidth="104"
                            Padding="16,10"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddBarcode_Click"
                            ToolTip="إضافة الباركود للقائمة">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="إضافة" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="12"
                        Padding="4">
                    <TextBox x:Name="BarcodesBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontSize="15"
                             FontFamily="Consolas, Cascadia Mono, Courier New"
                             Padding="14,12"
                             MinHeight="220"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             VerticalContentAlignment="Top"
                             TextChanged="BarcodesBox_TextChanged"
                             materialDesign:TextFieldAssist.HasClearButton="False"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                </Border>

                <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="0 باركود"/>
                    <TextBlock x:Name="ErrorText"
                               Foreground="{DynamicResource DashboardKpiRedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>

            <Border Grid.Row="2" Padding="18,14"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Background="{DynamicResource CardBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="حفظ" Style="{StaticResource PrimaryButton}" Padding="28,10"
                            Click="Save_Click" MinWidth="120"/>
                    <Button Content="إغلاق" Style="{StaticResource OutlinedButton}" Padding="24,10"
                            Click="Close_Click" Margin="10,0,0,0" MinWidth="100"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
