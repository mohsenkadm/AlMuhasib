<UserControl x:Class="AlMuhasib.UI.Controls.AnimatedStatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <UserControl.Resources>
        <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="AmountDetailButton" TargetType="Button">
            <Setter Property="Background" Value="#E0F2F1"/>
            <Setter Property="Foreground" Value="#00695C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B2DFDB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#80CBC4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <materialDesign:Card Style="{StaticResource StatCard}">
        <materialDesign:Card.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="20" />
        </materialDesign:Card.RenderTransform>
        <materialDesign:Card.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SlideTransform"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.4"
                                         EasingFunction="{StaticResource CubicEaseOut}" />
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.4"
                                         EasingFunction="{StaticResource CubicEaseOut}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </materialDesign:Card.Triggers>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon Circle -->
            <Border Grid.Column="0"
                    Width="52" Height="52" CornerRadius="26"
                    Background="{Binding IconBackground, ElementName=Root}"
                    VerticalAlignment="Top" Margin="0,0,0,0">
                <materialDesign:PackIcon Kind="{Binding Icon, ElementName=Root}"
                                         Width="26" Height="26"
                                         Foreground="{Binding IconForeground, ElementName=Root}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, ElementName=Root}"
                               FontSize="12" Foreground="{DynamicResource HintForegroundBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,8,0"/>
                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource AmountDetailButton}"
                            Command="{Binding DetailCommand, ElementName=Root}"
                            CommandParameter="{Binding DetailCommandParameter, ElementName=Root}"
                            Visibility="{Binding ShowDetailButton, ElementName=Root, Converter={StaticResource BoolToVis}}"
                            ToolTip="عرض تفاصيل المبلغ">
                        <materialDesign:PackIcon Kind="MagnifyScan" Width="15" Height="15"
                                                 Foreground="#00695C"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock x:Name="ValueText"
                               Text="{Binding DisplayValue, ElementName=Root}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{Binding ValueForeground, ElementName=Root}" />
                    <TextBlock Text="{Binding Suffix, ElementName=Root}"
                               FontSize="14" FontWeight="Normal"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Bottom"
                               Margin="6,0,0,4"
                               Visibility="{Binding Suffix, ElementName=Root,
                                   Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>

                <!-- Comparison -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                            Visibility="{Binding ComparisonLabel, ElementName=Root,
                                Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock x:Name="ComparisonArrow"
                               FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                    <TextBlock x:Name="ComparisonText"
                               FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
