<UserControl x:Class="AlMuhasib.UI.Controls.AnimatedStatCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <UserControl.Resources>
        <CubicEase x:Key="CubicEaseOut" EasingMode="EaseOut" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <Style x:Key="AmountDetailButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DashboardKpiTealLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DashboardKpiTealBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="14" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <materialDesign:Card Style="{StaticResource StatCard}">
        <materialDesign:Card.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="20" />
        </materialDesign:Card.RenderTransform>
        <materialDesign:Card.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="SlideTransform"
                                         Storyboard.TargetProperty="Y"
                                         From="20" To="0" Duration="0:0:0.4"
                                         EasingFunction="{StaticResource CubicEaseOut}" />
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.4"
                                         EasingFunction="{StaticResource CubicEaseOut}" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </materialDesign:Card.Triggers>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Icon Circle -->
                <Border Grid.Column="0"
                        Width="48" Height="48" CornerRadius="24"
                        Background="{Binding IconBackground, ElementName=Root}"
                        VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="{Binding Icon, ElementName=Root}"
                                             Width="24" Height="24"
                                             Foreground="{Binding IconForeground, ElementName=Root}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Text Content -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title, ElementName=Root}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource HintForegroundBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                VerticalAlignment="Top"
                                Style="{StaticResource AmountDetailButton}"
                                Command="{Binding DetailCommand, ElementName=Root}"
                                CommandParameter="{Binding DetailCommandParameter, ElementName=Root}"
                                Visibility="{Binding ShowDetailButton, ElementName=Root, Converter={StaticResource BoolToVis}}"
                                ToolTip="من أين جاء هذا المبلغ؟">
                            <materialDesign:PackIcon Kind="MagnifyScan" Width="15" Height="15"
                                                     Foreground="{DynamicResource DashboardKpiTealBrush}"
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Hint, ElementName=Root}"
                               FontSize="10.5"
                               Foreground="{DynamicResource HintForegroundBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,28,0"
                               Opacity="0.9"
                               Visibility="{Binding Hint, ElementName=Root,
                                   Converter={StaticResource NullToCollapsedConverter}}"/>

                    <!-- Single-currency value -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding ShowSecondaryValue, ElementName=Root, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock x:Name="ValueText"
                                   Text="{Binding DisplayValue, ElementName=Root}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{Binding ValueForeground, ElementName=Root}" />
                        <TextBlock Text="{Binding Suffix, ElementName=Root}"
                                   FontSize="14" FontWeight="Normal"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Bottom"
                                   Margin="6,0,0,4"
                                   Visibility="{Binding Suffix, ElementName=Root,
                                       Converter={StaticResource NullToCollapsedConverter}}" />
                    </StackPanel>

                    <!-- Comparison -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                Visibility="{Binding ComparisonLabel, ElementName=Root,
                                    Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock x:Name="ComparisonArrow"
                                   FontSize="12" FontWeight="Bold" Margin="0,0,4,0" />
                        <TextBlock x:Name="ComparisonText"
                                   FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Twin currency rail (IQD + USD) -->
            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="14"
                    Background="{DynamicResource SubtleBorderBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    Padding="3"
                    Visibility="{Binding ShowSecondaryValue, ElementName=Root, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- IQD lane -->
                    <Border Grid.Column="0" CornerRadius="11" Padding="10,9"
                            Background="{Binding IconBackground, ElementName=Root}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,6,0"
                                        Background="{Binding IconForeground, ElementName=Root}">
                                    <TextBlock Text="د.ع" FontSize="8" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="دينار"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding IconForeground, ElementName=Root}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayValue, ElementName=Root}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{Binding ValueForeground, ElementName=Root}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="د.ع"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="5,0,0,1"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Width="1" Margin="3,8"
                            Background="{DynamicResource CardBorderBrush}"
                            Opacity="0.65"/>

                    <!-- USD lane -->
                    <Border Grid.Column="2" CornerRadius="11" Padding="10,9"
                            Background="{DynamicResource DashboardKpiTealLightBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,6,0"
                                        Background="{DynamicResource DashboardKpiTealBrush}">
                                    <materialDesign:PackIcon Kind="CurrencyUsd"
                                                             Width="13" Height="13"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="دولار"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DashboardKpiTealBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SecondaryValue, ElementName=Root}"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource DashboardKpiTealBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
