<UserControl x:Class="AlMuhasib.UI.Controls.WarehouseTransferDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="MetaPill" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="860" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B5E20" Offset="0"/>
                            <GradientStop Color="#2E7D32" Offset="0.55"/>
                            <GradientStop Color="#66BB6A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="TruckDelivery" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="13" Foreground="#E8F5E9" Margin="0,4,0,0">
                                    <Run Text="رقم النقل:"/>
                                    <Run Text="{Binding TransferNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="CloseButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="التاريخ" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="من مخزن" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding FromWarehouseName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="إلى مخزن" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding ToWarehouseName}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="عدد البنود" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding LineCountText}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="إجمالي الكمية" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding TotalQuantityText}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetaPill}">
                                <StackPanel>
                                    <TextBlock Text="بواسطة" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                    <TextBlock Text="{Binding CreatedBy}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="الملاحظات" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,4"/>
                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <TextBlock Text="بنود النقل" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  MinHeight="160" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="140"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding QuantityText}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="18,12" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Button Content="إغلاق" HorizontalAlignment="Left" Click="CloseButton_Click"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
