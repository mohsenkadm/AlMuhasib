<UserControl x:Class="AlMuhasib.UI.Controls.GlobalSearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             Visibility="Collapsed"
             Background="#99000000">
    <UserControl.Resources>
        <Style x:Key="SearchResultListBoxItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border MaxWidth="720"
                MinWidth="420"
                Margin="24,80,24,24"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="{DynamicResource CardBrush}"
                CornerRadius="16"
                Padding="0"
                materialDesign:ElevationAssist.Elevation="Dp12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="460" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="20,16"
                        Background="{DynamicResource PrimaryHueLightBrush}"
                        CornerRadius="16,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="24" Height="24"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Text="{Binding GlobalSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ابحث عن عميل، منتج، فاتورة، سند، أو قائمة..."
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="16"
                                 MinHeight="36"
                                 VerticalContentAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Command="{Binding DataContext.CloseGlobalSearchCommand, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
                                ToolTip="إغلاق (Esc)">
                            <materialDesign:PackIcon Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding GlobalSearchResults}"
                         ItemContainerStyle="{StaticResource SearchResultListBoxItem}"
                         BorderThickness="0"
                         Padding="10,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectGlobalSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window, Mode=FindAncestor}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SidebarSearchResultButton}"
                                    MinHeight="52"
                                    HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                            Background="{DynamicResource PrimaryHueLightBrush}"
                                            Margin="0,0,12,0" VerticalAlignment="Top">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SearchResultTitleBrush}" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Foreground="{DynamicResource SearchResultSubtitleBrush}" />
                                        <Border Background="{DynamicResource PrimaryHueLightBrush}"
                                                CornerRadius="6" Padding="8,2"
                                                HorizontalAlignment="Right"
                                                Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="16,10"
                        Background="{DynamicResource BackgroundBrush}"
                        CornerRadius="0,0,16,16">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap">
                        <Run Text="Ctrl+K" FontWeight="Bold" />
                        <Run Text=" بحث شامل  |  " />
                        <Run Text="↑↓" FontWeight="Bold" />
                        <Run Text=" تنقل  |  " />
                        <Run Text="Enter" FontWeight="Bold" />
                        <Run Text=" فتح  |  " />
                        <Run Text="Esc" FontWeight="Bold" />
                        <Run Text=" إغلاق" />
                    </TextBlock>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
