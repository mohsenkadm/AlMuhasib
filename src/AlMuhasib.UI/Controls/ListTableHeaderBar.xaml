<UserControl x:Class="AlMuhasib.UI.Controls.ListTableHeaderBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Opacity" Value="0.95"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Title, ElementName=Root}"
                       FontSize="15" FontWeight="Bold" Foreground="White"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentPresenter Content="{Binding ExtraContent, ElementName=Root}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>

                <controls:ColumnFilterToggle
                    Visibility="{Binding ShowFilter, ElementName=Root, Converter={StaticResource BoolVis}}"
                    IsChecked="{Binding IsFilterPanelOpen, ElementName=Root, Mode=TwoWay}"
                    ActiveFilterCount="{Binding ActiveFilterCount, ElementName=Root}"
                    ClearFiltersCommand="{Binding ClearFiltersCommand, ElementName=Root}"
                    TargetDataGrid="{Binding TargetDataGrid, ElementName=Root}"
                    OnDarkBackground="True"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"/>

                <Button Style="{StaticResource HeaderIconButton}"
                        Visibility="{Binding ShowExport, ElementName=Root, Converter={StaticResource BoolVis}}"
                        Command="{Binding ExportCommand, ElementName=Root}"
                        ToolTip="تصدير Excel">
                    <md:PackIcon Kind="FileExcelOutline" Width="20" Height="20" Foreground="White"/>
                </Button>

                <Button Style="{StaticResource HeaderIconButton}"
                        Visibility="{Binding ShowPrint, ElementName=Root, Converter={StaticResource BoolVis}}"
                        Command="{Binding PrintCommand, ElementName=Root}"
                        ToolTip="طباعة">
                    <md:PackIcon Kind="Printer" Width="20" Height="20" Foreground="White"/>
                </Button>

                <controls:ListViewModeToggle
                    Visibility="{Binding ShowCardToggle, ElementName=Root, Converter={StaticResource BoolVis}}"
                    OnDarkBackground="True"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
