<UserControl x:Class="AlMuhasib.UI.Controls.GoldItemPickerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             x:Name="Root"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot" Visibility="Collapsed" IsHitTestVisible="False">
        <Border x:Name="Backdrop"
                Background="#CC000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="16"
                             Width="720"
                             MaxHeight="640"
                             UniformCornerRadius="16"
                             Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="18,14" CornerRadius="16,16,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6B4E16" Offset="0"/>
                            <GradientStop Color="#B8860B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                                <Button Command="{Binding CancelCommand}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Foreground="White"
                                        ToolTip="إغلاق">
                                    <materialDesign:PackIcon Kind="Close"/>
                                </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="اختيار قطع الذهب" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#EEFFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="16" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Text="{Binding SelectedCount, StringFormat='المحدد: {0}'}"
                                   Foreground="#5D4037" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="إضافة المحدد" Command="{Binding ConfirmCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="20,8">
                                <Button.Background>
                                    <SolidColorBrush Color="#B8860B"/>
                                </Button.Background>
                            </Button>
                            <Button Content="إلغاء" Command="{Binding CancelCommand}"
                                    Style="{StaticResource OutlinedButton}" Padding="20,8"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="بحث بالاسم / الباركود / العيار / الرقم"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource FilledTextBox}"/>
                </StackPanel>

                <Grid Margin="12,0,12,8">
                    <ListBox ItemsSource="{Binding VisibleItems}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GoldItemPickerDisplayItem}">
                                <Border Margin="0,0,0,8" Padding="12,10" CornerRadius="10"
                                        BorderThickness="1" Cursor="Hand"
                                        MouseLeftButtonUp="ItemRow_MouseLeftButtonUp">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#E8D5A3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                    <Setter Property="BorderBrush" Value="#B8860B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="#5D4037"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#8D6E63" Margin="0,2,0,0"/>
                                            <TextBlock FontSize="11" Foreground="#A1887F" Margin="0,2,0,0">
                                                <Run Text="باركود:"/>
                                                <Run Text="{Binding Barcode, Mode=OneWay, TargetNullValue=—}"/>
                                                <Run Text="  |  #"/>
                                                <Run Text="{Binding Id, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Background="#88FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="5" VerticalAlignment="Center"
                                     Foreground="#B8860B"/>
                    </Border>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
