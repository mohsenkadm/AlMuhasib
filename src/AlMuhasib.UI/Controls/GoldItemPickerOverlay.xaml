<UserControl x:Class="AlMuhasib.UI.Controls.GoldItemPickerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             x:Name="Root"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot" Visibility="Collapsed" IsHitTestVisible="False">
        <Border x:Name="Backdrop"
                Background="#CC000000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="16"
                             MinWidth="920"
                             Width="980"
                             MaxHeight="640"
                             UniformCornerRadius="16"
                             Padding="0"
                             Background="{DynamicResource CardBrush}"
                             materialDesign:ElevationAssist.Elevation="Dp16">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Padding="18,14" CornerRadius="16,16,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#6B4E16" Offset="0"/>
                            <GradientStop Color="#B8860B" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button Command="{Binding CancelCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="White"
                                ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="اختيار قطع الذهب" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#EEFFFFFF" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Bottom" Padding="16"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Text="{Binding SelectedCount, StringFormat='المحدد: {0}'}"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="إضافة المحدد" Command="{Binding ConfirmCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="20,8">
                                <Button.Background>
                                    <SolidColorBrush Color="#B8860B"/>
                                </Button.Background>
                            </Button>
                            <Button Content="إلغاء" Command="{Binding CancelCommand}"
                                    Style="{StaticResource OutlinedButton}" Padding="20,8"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="بحث بالاسم / الباركود / العيار / الرقم"
                             materialDesign:HintAssist.IsFloating="True"
                             Style="{StaticResource FilledTextBox}"/>
                </StackPanel>

                <Grid Margin="12,0,12,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding VisibleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:GoldItemPickerDisplayItem}">
                                    <Border Margin="0,0,10,10" Padding="10,8" CornerRadius="10"
                                            BorderThickness="1" Cursor="Hand"
                                            Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                                            MouseLeftButtonUp="ItemRow_MouseLeftButtonUp">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#FFF8E1"/>
                                                        <Setter Property="BorderBrush" Value="#B8860B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="11"
                                                           Foreground="#2E7D32" DockPanel.Dock="Left"/>
                                                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis">
                                                    <Run Text="#"/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="5" VerticalAlignment="Center"
                                     Foreground="#B8860B"/>
                    </Border>
                </Grid>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
