<UserControl x:Class="AlMuhasib.UI.Controls.PaginationBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <UserControl.Resources>
        <converters:PaginationStatisticsTextConverter x:Key="PaginationStatsConverter"/>

        <Style x:Key="PaginationNavButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Foreground" Value="#546E7A"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#FAFBFC"
            BorderBrush="{StaticResource SubtleBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       Foreground="#607D8B">
                <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource PaginationStatsConverter}">
                        <Binding Path="PaginationText"/>
                        <Binding Path="TotalCount"/>
                        <Binding Path="TotalRecords"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4,3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding FirstPageCommand}"
                            Style="{StaticResource PaginationNavButton}"
                            ToolTip="الصفحة الأولى"
                            Visibility="{Binding ShowFirstLastButtons, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <md:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                    </Button>

                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource PaginationNavButton}"
                            ToolTip="السابقة">
                        <md:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>

                    <Border Background="#F1F5F9"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="4,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="12" Foreground="#37474F">
                            <Run Text="صفحة" />
                            <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1565C0"/>
                            <Run Text="من" />
                            <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold" Foreground="#1565C0"/>
                        </TextBlock>
                    </Border>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource PaginationNavButton}"
                            ToolTip="التالية">
                        <md:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>

                    <Button Command="{Binding LastPageCommand}"
                            Style="{StaticResource PaginationNavButton}"
                            ToolTip="الصفحة الأخيرة"
                            Visibility="{Binding ShowFirstLastButtons, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <md:PackIcon Kind="PageLast" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
