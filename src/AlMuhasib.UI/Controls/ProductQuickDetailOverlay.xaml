<UserControl x:Class="AlMuhasib.UI.Controls.ProductQuickDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <Style x:Key="MetaPill" TargetType="Border">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style x:Key="StatPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="760" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E65100" Offset="0"/>
                            <GradientStop Color="#FB8C00" Offset="0.55"/>
                            <GradientStop Color="#FFB74D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="PackageVariant" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" MaxWidth="480"/>
                                <TextBlock Text="تفاصيل المنتج" FontSize="13" Foreground="#FFF3E0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Click="CloseButton_Click"
                                VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="White"
                                ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16"
                                  Visibility="{Binding HasData, Converter={StaticResource BoolVis}}">
                        <StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Border Style="{StaticResource MetaPill}"
                                        Visibility="{Binding Barcode, Converter={StaticResource NullToCollapsedConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="الباركود" FontSize="11" Foreground="#90A4AE"/>
                                        <TextBlock Text="{Binding Barcode}" FontWeight="SemiBold" Foreground="#37474F"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource MetaPill}"
                                        Visibility="{Binding CategoryName, Converter={StaticResource NullToCollapsedConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="التصنيف" FontSize="11" Foreground="#90A4AE"/>
                                        <TextBlock Text="{Binding CategoryName}" FontWeight="SemiBold" Foreground="#37474F"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#607D8B" Margin="0,0,0,12"
                                       Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}"/>

                            <WrapPanel Margin="0,0,0,12">
                                <Border Style="{StaticResource StatPill}" Background="#E8F5E9">
                                    <StackPanel>
                                        <TextBlock Text="الكمية المتوفرة" FontSize="11" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding TotalStockText}" FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatPill}" Background="#E3F2FD">
                                    <StackPanel>
                                        <TextBlock Text="سعر البيع الحالي" FontSize="11" Foreground="#1565C0"/>
                                        <TextBlock Text="{Binding CurrentSalePriceText}" FontSize="18" FontWeight="Bold" Foreground="#0D47A1"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource StatPill}" Background="#F3E5F5">
                                    <StackPanel>
                                        <TextBlock Text="سعر الشراء الحالي" FontSize="11" Foreground="#6A1B9A"/>
                                        <TextBlock Text="{Binding CurrentPurchasePriceText}" FontSize="18" FontWeight="Bold" Foreground="#4A148C"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <Border Background="#FFF3E0" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="آخر سعر شراء" FontSize="11" Foreground="#EF6C00"/>
                                        <TextBlock Text="{Binding LastPurchaseText}" FontWeight="SemiBold" Foreground="#E65100" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#E0F7FA" CornerRadius="12" Padding="14,12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="آخر سعر بيع" FontSize="11" Foreground="#00838F"/>
                                        <TextBlock Text="{Binding LastSaleText}" FontWeight="SemiBold" Foreground="#006064" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <Border Background="#F5F7FA" CornerRadius="12" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="ملخص المبيعات" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding SaleSummaryText}" FontWeight="SemiBold" Foreground="#37474F" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F5F7FA" CornerRadius="12" Padding="14,12" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ملخص المشتريات" FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding PurchaseSummaryText}" FontWeight="SemiBold" Foreground="#37474F" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="المخزون حسب المخزن" FontSize="15" FontWeight="Bold"
                                       Foreground="#E65100" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding StocksByWarehouse}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFC" BorderBrush="#ECEFF1" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding WarehouseName}"
                                                           FontWeight="SemiBold"
                                                           Foreground="#455A64"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0"/>
                                                <Border Grid.Column="1"
                                                        Background="#E8F5E9"
                                                        CornerRadius="8"
                                                        Padding="10,4"
                                                        MinWidth="72"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Quantity, StringFormat=N2}"
                                                               FontWeight="Bold"
                                                               Foreground="#2E7D32"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Width="48" Height="48"/>
                        <TextBlock Text="جاري تحميل تفاصيل المنتج…" Margin="0,14,0,0" Foreground="#607D8B"/>
                    </StackPanel>

                    <Border Margin="24" Padding="16" Background="#FFEBEE" CornerRadius="12" VerticalAlignment="Center"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                        Padding="22,14" CornerRadius="0,0,18,18">
                    <Button Click="CloseButton_Click" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Height="40" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="إغلاق" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
