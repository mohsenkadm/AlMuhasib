<UserControl x:Class="AlMuhasib.UI.Controls.InvoiceSearchSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:AlMuhasib.UI.Models"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Background="Transparent"
             IsHitTestVisible="False">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid x:Name="OverlayRoot" Visibility="Collapsed" IsHitTestVisible="False">
        <!-- Backdrop dimming -->
        <Border x:Name="Backdrop"
                Background="#B3000000"
                Opacity="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MouseDown="Backdrop_MouseDown"/>

        <Border x:Name="SidePanel"
                Width="420"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Background="{StaticResource SearchPanelBackgroundBrush}"
                BorderBrush="#D0DCE8"
                BorderThickness="1,0,0,0"
                materialDesign:ElevationAssist.Elevation="Dp16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="-4" Opacity="0.22" Direction="180"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelSlide" X="420"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="16,14" CornerRadius="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{Binding HeaderColorStart, ElementName=Root}" Offset="0"/>
                            <GradientStop Color="{Binding HeaderColorEnd, ElementName=Root}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#33FFFFFF" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="FileSearchOutline" Width="24" Height="24" Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PanelTitle, ElementName=Root}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="ابحث برقم الفاتورة أو اسم العميل/المورد" FontSize="11" Foreground="#E3F2FD" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Click="CloseButton_Click"
                                VerticalAlignment="Center"
                                Width="40" Height="40" Cursor="Hand"
                                Background="#44FFFFFF" BorderThickness="0"
                                ToolTip="إغلاق">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseBd" Background="{TemplateBinding Background}" CornerRadius="20">
                                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="White"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseBd" Property="Background" Value="#66FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseBd" Property="Background" Value="#88FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Search + Sort -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E8EEF5" BorderThickness="0,0,0,1" Padding="16,14,16,10">
                    <StackPanel>
                        <TextBox Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="رقم الفاتورة، اسم العميل أو المورد..."
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                 Style="{StaticResource FilledTextBox}"
                                 MinHeight="48" FontSize="14" Padding="12,10"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#546E7A">
                                <Run Text="النتائج:" FontWeight="SemiBold"/>
                                <Run Text="{Binding InvoiceSearchResults.Count, Mode=OneWay}"/>
                            </TextBlock>
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding InvoiceSearchSortNewestFirst}"
                                          Cursor="Hand" Padding="12,6" FontSize="12" FontWeight="SemiBold">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Bd" CornerRadius="20" Padding="{TemplateBinding Padding}"
                                                            Background="{DynamicResource BackgroundBrush}"
                                                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="SortClockDescendingOutline" Width="16" Height="16"
                                                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                            <Setter Property="Content" Value="الأحدث أولاً"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter Property="Content" Value="الأقدم أولاً"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Grid Grid.Row="2" Margin="16,10,16,8" Background="#F5F8FB">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding InvoiceSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:InvoiceSearchListItem}">
                                    <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="12"
                                            Background="#FFFFFF"
                                            BorderBrush="#DDE5EE" BorderThickness="1"
                                            Cursor="Hand"
                                            MouseLeftButtonUp="InvoiceItem_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F3F9FF"/>
                                                        <Setter Property="BorderBrush" Value="#90CAF9"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" FontSize="14" Foreground="#263238"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,4,0,0" Foreground="#78909C"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"
                                                                         HorizontalAlignment="Right" Margin="0,4,0,0"
                                                                         Foreground="#78909C"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsInvoiceSearchLoading, Converter={StaticResource BoolVis}}">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="4"/>
                        <TextBlock Text="جاري البحث..." FontSize="12" Margin="0,10,0,0"
                                   Foreground="#78909C" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsInvoiceSearchLoading}" Value="False"/>
                                            <Condition Binding="{Binding InvoiceSearchResults.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <materialDesign:PackIcon Kind="FileSearchOutline" Width="48" Height="48"
                                                 Foreground="#78909C" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="لا توجد نتائج" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,4"
                                   Foreground="#78909C" HorizontalAlignment="Center"/>
                        <TextBlock Text="جرّب البحث برقم الفاتورة أو اسم الطرف" FontSize="11"
                                   Foreground="#78909C" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Footer hint -->
                <Border Grid.Row="3" Background="#FFFFFF"
                        BorderBrush="#E8EEF5" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="GestureTap" Width="16" Height="16"
                                                 Foreground="#78909C" VerticalAlignment="Center"/>
                        <TextBlock Text="اضغط على الفاتورة لتحميلها للتعديل" FontSize="11" Margin="6,0,0,0"
                                   Foreground="#78909C" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
