<Window x:Class="AlMuhasib.UI.Controls.TouchNumericPadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="إدخال رقمي"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}"
        Width="360" Height="520"
        MinWidth="340" MinHeight="480">

    <Window.Resources>
        <Style x:Key="PadKey" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PadAction" TargetType="Button" BasedOn="{StaticResource PadKey}">
            <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#0D47A1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="إدخال القيمة" FontSize="17" FontWeight="Bold" Foreground="White"
                               FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#BBDEFB"
                               Margin="0,4,0,0" TextWrapping="Wrap"
                               FontFamily="{DynamicResource AppFont}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Margin="18,16,18,8" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="#1565C0" BorderThickness="2" CornerRadius="12" Padding="12" MinHeight="64">
                <TextBlock x:Name="DisplayText" Text="0"
                           FontSize="32" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="{DynamicResource AppFont}"/>
            </Border>

            <UniformGrid Grid.Row="2" Columns="3" Margin="12,4,12,4" FlowDirection="LeftToRight">
                <Button Style="{StaticResource PadKey}" Content="1" Tag="1" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="2" Tag="2" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="3" Tag="3" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="4" Tag="4" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="5" Tag="5" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="6" Tag="6" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="7" Tag="7" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="8" Tag="8" Click="Digit_Click"/>
                <Button Style="{StaticResource PadKey}" Content="9" Tag="9" Click="Digit_Click"/>
                <Button x:Name="DecimalButton" Style="{StaticResource PadAction}" Content="." Click="Decimal_Click"/>
                <Button Style="{StaticResource PadKey}" Content="0" Tag="0" Click="Digit_Click"/>
                <Button Style="{StaticResource PadAction}" Click="Backspace_Click" ToolTip="حذف">
                    <materialDesign:PackIcon Kind="BackspaceOutline" Width="22" Height="22"/>
                </Button>
            </UniformGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,4,16,16">
                <Button Content="تأكيد" Style="{StaticResource PrimaryButton}" Width="120" Height="44"
                        Click="Confirm_Click" Margin="0,0,10,0" IsDefault="True"
                        FontFamily="{DynamicResource AppFont}"/>
                <Button Content="مسح" Style="{StaticResource OutlinedButton}" Width="80" Height="44"
                        Click="Clear_Click" Margin="0,0,10,0"
                        FontFamily="{DynamicResource AppFont}"/>
                <Button Content="إلغاء" Style="{StaticResource OutlinedButton}" Width="100" Height="44"
                        Click="Cancel_Click" IsCancel="True"
                        FontFamily="{DynamicResource AppFont}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
