<UserControl x:Class="AlMuhasib.UI.Controls.HotelEntityLink"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FlowDirection="RightToLeft">
    <Button Command="{Binding Command, ElementName=Root}"
            CommandParameter="{Binding CommandParameter, ElementName=Root}"
            Content="{Binding LinkText, ElementName=Root}"
            Style="{StaticResource HotelEntityLinkButton}"
            ToolTip="{Binding ToolTipText, ElementName=Root}"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"/>
</UserControl>
