<UserControl x:Class="AlMuhasib.UI.Controls.DashboardKpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinHeight="112">

    <UserControl.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <materialDesign:Card UniformCornerRadius="20"
                         Padding="0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         materialDesign:ElevationAssist.Elevation="Dp1"
                         Background="{DynamicResource CardBrush}"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         BorderThickness="1"
                         Cursor="Hand"
                         RenderTransformOrigin="0.5,0.5">
        <materialDesign:Card.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </materialDesign:Card.RenderTransform>
        <materialDesign:Card.Style>
            <Style TargetType="materialDesign:Card">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.02" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.02" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </materialDesign:Card.Style>

        <StackPanel VerticalAlignment="Stretch">
            <Border Height="4" CornerRadius="20,20,0,0"
                    Background="{Binding AccentBrush, ElementName=Root}" />

            <Grid Margin="20,18,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="16"
                        Background="{Binding AccentLightBrush, ElementName=Root}"
                        VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="{Binding Icon, ElementName=Root}"
                                             Width="28" Height="28"
                                             Foreground="{Binding AccentBrush, ElementName=Root}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" />
                    <TextBlock Text="{Binding Value, ElementName=Root}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{Binding ValueBrush, ElementName=Root}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding ShowTrend, ElementName=Root, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="8" Padding="8,3"
                                Background="{Binding AccentLightBrush, ElementName=Root}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="12" Height="12"
                                                         VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Foreground="{Binding TrendBrush, ElementName=Root}"
                                                         Kind="{Binding TrendIcon, ElementName=Root}" />
                                <TextBlock Text="{Binding TrendText, ElementName=Root}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding TrendBrush, ElementName=Root}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="آخر 14 يوم"
                                   FontSize="10"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource HintForegroundBrush}" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        VerticalAlignment="Top"
                        Width="32" Height="32" MinWidth="32" Padding="0"
                        Visibility="{Binding ShowDetailButton, ElementName=Root, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DetailCommand, ElementName=Root}"
                        Cursor="Hand"
                        ToolTip="عرض تفاصيل المبلغ">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{Binding AccentLightBrush, ElementName=Root}"/>
                            <Setter Property="Foreground" Value="{Binding AccentBrush, ElementName=Root}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="16" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                            <materialDesign:PackIcon Kind="MagnifyScan" Width="16" Height="16"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                     Foreground="{TemplateBinding Foreground}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Border Margin="12,0,12,10" Height="52" CornerRadius="12"
                    Background="{Binding AccentLightBrush, ElementName=Root}"
                    Visibility="{Binding ShowMiniChart, ElementName=Root, Converter={StaticResource BoolToVis}}"
                    ClipToBounds="True">
                <lvc:CartesianChart x:Name="MiniChart"
                                    Series="{Binding MiniChartSeries, ElementName=Root}"
                                    XAxes="{Binding MiniChartXAxes, ElementName=Root}"
                                    YAxes="{Binding MiniChartYAxes, ElementName=Root}"
                                    TooltipPosition="Hidden"
                                    LegendPosition="Hidden"
                                    AnimationsSpeed="00:00:00.350"
                                    Margin="4,6,4,2" />
            </Border>

            <ContentPresenter Margin="20,0,20,16"
                              Content="{Binding DetailsContent, ElementName=Root}"
                              Visibility="{Binding DetailsContent, ElementName=Root, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </materialDesign:Card>
</UserControl>
