<UserControl x:Class="AlMuhasib.UI.Controls.DashboardKpiCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             x:Name="Root"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinHeight="112">

    <UserControl.Resources>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>

    <materialDesign:Card UniformCornerRadius="20"
                         Padding="0"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         materialDesign:ElevationAssist.Elevation="Dp1"
                         Background="{DynamicResource CardBrush}"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         BorderThickness="1"
                         Cursor="Hand"
                         RenderTransformOrigin="0.5,0.5">
        <materialDesign:Card.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </materialDesign:Card.RenderTransform>
        <materialDesign:Card.Style>
            <Style TargetType="materialDesign:Card">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1.02" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1.02" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                     To="1" Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                     To="1" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </materialDesign:Card.Style>

        <StackPanel VerticalAlignment="Stretch">
            <Border Height="4" CornerRadius="20,20,0,0"
                    Background="{Binding AccentBrush, ElementName=Root}" />

            <Grid Margin="20,18,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="54" Height="54" CornerRadius="16"
                        Background="{Binding AccentLightBrush, ElementName=Root}">
                    <materialDesign:PackIcon Kind="{Binding Icon, ElementName=Root}"
                                             Width="28" Height="28"
                                             Foreground="{Binding AccentBrush, ElementName=Root}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" />
                    <TextBlock Text="{Binding Value, ElementName=Root}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{Binding ValueBrush, ElementName=Root}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ContentPresenter Margin="20,12,20,16"
                              Content="{Binding DetailsContent, ElementName=Root}"
                              Visibility="{Binding DetailsContent, ElementName=Root, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </materialDesign:Card>
</UserControl>
