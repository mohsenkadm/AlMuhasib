<Window x:Class="AlMuhasib.UI.Controls.IraqiCurrencyChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        Title="حساب العملات"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="720"
        MaxHeight="860"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.88" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.88" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="Backdrop"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="ChangePulse">
            <DoubleAnimation Storyboard.TargetName="ChangeCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ChangeCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="1" Duration="0:0:0.28">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="DenomButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                CornerRadius="12"
                                Padding="0"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.22" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" Value="0.96"/>
                                <Setter TargetName="Card" Property="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" Value="0.96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShowAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border x:Name="Backdrop" Background="#99000000" Opacity="0"
                MouseLeftButtonDown="Backdrop_MouseLeftButtonDown"/>

        <Border x:Name="DialogCard"
                Background="White"
                CornerRadius="20"
                Margin="24"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                RenderTransformOrigin="0.5,0.5"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.28" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        CornerRadius="20,20,0,0"
                        Padding="24,20"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1565C0" Offset="0.55"/>
                            <GradientStop Color="#1E88E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="CashMultiple" Width="28" Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="حساب العملات" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="اضغط فئة العملة التي دفعها الزبون — F7 للإغلاق" FontSize="12"
                                       Foreground="#CCFFFFFF" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding CloseCommand}"
                                Style="{StaticResource FlatButton}"
                                Foreground="White" Padding="6" VerticalAlignment="Top"
                                ToolTip="إغلاق (Esc)">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="620"
                              Padding="22,18,22,8">
                    <StackPanel>
                        <!-- Invoice total -->
                        <Border Background="#F5F9FC" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="مبلغ الفاتورة" Foreground="#607D8B" FontSize="13"/>
                                    <TextBlock Text="الإجمالي المطلوب" Foreground="#90A4AE" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding InvoiceTotal, StringFormat='{}{0:N0} د.ع'}"
                                           FontSize="28" FontWeight="Bold" Foreground="#0D47A1"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Denomination grid -->
                        <TextBlock Text="عملات الدفع" FontWeight="SemiBold" FontSize="14"
                                   Foreground="#37474F" Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding Denominations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CurrencyDenominationItem}">
                                    <Button Style="{StaticResource DenomButton}"
                                            Command="{Binding DataContext.AddDenominationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DisplayAmount}">
                                        <Border Height="88" CornerRadius="12" ClipToBounds="True"
                                                Background="{Binding PrimaryBrush}">
                                            <Grid>
                                                <!-- Stylized note pattern -->
                                                <Border CornerRadius="12" Opacity="0.45">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="Transparent" Offset="0"/>
                                                            <GradientStop Color="#60FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Ellipse Width="70" Height="70" Opacity="0.18" Fill="White"
                                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                                         Margin="-20,-20,0,0"/>
                                                <Ellipse Width="40" Height="40" Opacity="0.12" Fill="White"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         Margin="0,0,-8,-8"/>
                                                <Border Width="28" Height="28" CornerRadius="14"
                                                        Background="#33FFFFFF"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Margin="10,8,0,0">
                                                    <TextBlock Text="ع" FontSize="12" FontWeight="Bold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="دينار" FontSize="11" Foreground="#E0FFFFFF"
                                                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Paid / Change summary -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#E3F2FD" CornerRadius="14" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="المبلغ المدفوع" Foreground="#1565C0" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="24" FontWeight="Bold" Foreground="#0D47A1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ChangeCard" Grid.Column="2" CornerRadius="14" Padding="16,14"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECEFF1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowChangeDue}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowShortfall}" Value="True">
                                                <Setter Property="Background" Value="#FFF8E1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Default: no paid / exact -->
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowChangeDue}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ShowShortfall}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="الباقي للزبون" FontSize="12" FontWeight="SemiBold" Foreground="#78909C"/>
                                        <TextBlock Text="0 د.ع" FontSize="26" FontWeight="Bold" Foreground="#90A4AE" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowChangeDue, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="الباقي للزبون" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                        <TextBlock Text="{Binding ChangeAmount, StringFormat='{}{0:N0} د.ع'}"
                                                   FontSize="26" FontWeight="Bold" Foreground="#1B5E20" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowShortfall, Converter={StaticResource BoolVis}}">
                                        <TextBlock Text="المتبقي على الزبون" FontSize="12" FontWeight="SemiBold" Foreground="#F57F17"/>
                                        <TextBlock Text="{Binding ShortfallAmount, StringFormat='{}{0:N0} د.ع'}"
                                                   FontSize="26" FontWeight="Bold" Foreground="#E65100" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Change breakdown -->
                        <Border Margin="0,16,0,0" Background="#FAFAFA" CornerRadius="14" Padding="16,14"
                                Visibility="{Binding ShowChangeDue, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CashRefund" Width="20" Height="20"
                                                             Foreground="#2E7D32" VerticalAlignment="Center"/>
                                    <TextBlock Text="كيف ترجع الباقي" FontWeight="SemiBold" FontSize="14"
                                               Foreground="#1B5E20" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding ChangeBreakdown}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CurrencyBreakdownItem}">
                                            <Border CornerRadius="10" Padding="12,10" Margin="0,0,8,8" MinWidth="120"
                                                    Background="{Binding PrimaryBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                                    <Grid Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding CountLabel}" Foreground="#E0FFFFFF" FontSize="12"
                                                                   HorizontalAlignment="Left"/>
                                                        <TextBlock Text="{Binding TotalLabel}" Foreground="White" FontSize="12"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer actions -->
                <Border Grid.Row="2" BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                        Padding="20,14,20,18" CornerRadius="0,0,20,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding UndoLastCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="42" Padding="16,0" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    IsEnabled="{Binding HasPaid}"
                                    ToolTip="تراجع عن آخر عملة">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Undo" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="تراجع" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearPaidCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Height="42" Padding="14,0"
                                    IsEnabled="{Binding HasPaid}"
                                    ToolTip="مسح المبلغ المدفوع">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Eraser" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="مسح" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ApplyPaidCommand}"
                                    Height="42" Padding="20,0" Margin="0,0,8,0"
                                    Visibility="{Binding AllowApplyPaid, Converter={StaticResource BoolVis}}"
                                    IsEnabled="{Binding HasPaid}"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    Background="#2E7D32" BorderThickness="0" Foreground="White"
                                    FontWeight="SemiBold" Cursor="Hand"
                                    ToolTip="تعيين المبلغ المدفوع في شاشة الدفع">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1B5E20"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="تعيين كمدفوع" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseCommand}"
                                    Content="إغلاق"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="42" Padding="22,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
