<UserControl x:Class="AlMuhasib.UI.Controls.GoldInvoiceDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="GoldMetaPill" TargetType="Border">
            <Setter Property="Background" Value="#FFF8E1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="920" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6B4E16" Offset="0"/>
                            <GradientStop Color="#B8860B" Offset="0.6"/>
                            <GradientStop Color="#DAA520" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="13" Foreground="#FFF8E1" Margin="0,4,0,0">
                                    <Run Text="رقم الفاتورة:"/>
                                    <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Click="CloseButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource GoldMetaPill}">
                                <StackPanel>
                                    <TextBlock Text="التاريخ" FontSize="11" Foreground="#8D6E63"/>
                                    <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" Foreground="#5D4037"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GoldMetaPill}">
                                <StackPanel>
                                    <TextBlock Text="النوع" FontSize="11" Foreground="#8D6E63"/>
                                    <TextBlock Text="{Binding InvoiceTypeText}" FontWeight="SemiBold" Foreground="#5D4037"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GoldMetaPill}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PartyLabel}" FontSize="11" Foreground="#8D6E63"/>
                                    <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold" Foreground="#5D4037"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GoldMetaPill}">
                                <StackPanel>
                                    <TextBlock Text="المخزن" FontSize="11" Foreground="#8D6E63"/>
                                    <TextBlock Text="{Binding WarehouseName}" FontWeight="SemiBold" Foreground="#5D4037"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GoldMetaPill}">
                                <StackPanel>
                                    <TextBlock Text="طريقة الدفع" FontSize="11" Foreground="#8D6E63"/>
                                    <TextBlock Text="{Binding PaymentMethod}" FontWeight="SemiBold" Foreground="#B8860B"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource GoldMetaPill}">
                                <StackPanel>
                                    <TextBlock Text="الحالة" FontSize="11" Foreground="#8D6E63"/>
                                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="#5D4037"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Background="#FFF8E1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                Visibility="{Binding HasCreditInfo, Converter={StaticResource BoolVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CreditCardClockOutline" Foreground="#B8860B" VerticalAlignment="Center"/>
                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#6B4E16">
                                    <Run Text="المدفوع:"/><Run Text="{Binding PaidAmountText, Mode=OneWay}"/>
                                    <Run Text="  |  المتبقي:"/><Run Text="{Binding RemainingAmountText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="بنود الفاتورة" FontSize="15" FontWeight="Bold" Foreground="#B8860B" Margin="0,4,0,10"/>
                        <DataGrid ItemsSource="{Binding Lines}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="220" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="العيار" Binding="{Binding KaratText}" Width="70"/>
                                <DataGridTextColumn Header="الوزن" Binding="{Binding WeightText}" Width="90"/>
                                <DataGridTextColumn Header="قيمة الذهب" Binding="{Binding GoldValueText}" Width="100"/>
                                <DataGridTextColumn Header="أجور" Binding="{Binding MakingChargeText}" Width="90"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding LineTotalText}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="المدفوعات" FontSize="15" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,0,10"
                                   Visibility="{Binding HasPayments, Converter={StaticResource BoolVis}}"/>
                        <DataGrid ItemsSource="{Binding Payments}" Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="160" Margin="0,0,0,14"
                                  Visibility="{Binding HasPayments, Converter={StaticResource BoolVis}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding DateText}" Width="110"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountText}" Width="110"/>
                                <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyText}" Width="70"/>
                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="#FAFAFA" CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="قيمة الذهب:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding GoldValueText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="أجور الصياغة:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding MakingChargeText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="الخصم:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding DiscountText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="الوزن:" Width="120" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding WeightText}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="الإجمالي" FontSize="12" Foreground="#78909C" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding GrandTotalText}" FontSize="24" FontWeight="Bold"
                                               Foreground="#B8860B" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#ECEFF1" CornerRadius="10" Padding="12,10"
                                Visibility="{Binding HasNotes, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="ملاحظات" FontSize="11" Foreground="#78909C"/>
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#455A64"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#FAFBFC" BorderBrush="#ECEFF1" BorderThickness="0,1,0,0"
                        Padding="22,14" CornerRadius="0,0,18,18">
                    <Button Click="CloseButton_Click" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" Height="40" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="تم" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
