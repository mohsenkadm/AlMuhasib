<UserControl x:Class="AlMuhasib.UI.Controls.ReportCategoryFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:AlMuhasib.UI.Models"
             FlowDirection="RightToLeft"
             Width="452"
             x:Name="RootFlyout">

    <UserControl.Resources>
        <Style x:Key="ReportCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card"
                                Background="{DynamicResource FlyoutCardBrush}"
                                CornerRadius="14"
                                BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="1"
                                Padding="8,10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border x:Name="IconHost"
                                        Width="46" Height="46"
                                        CornerRadius="12"
                                        Background="{DynamicResource PrimaryHueLightBrush}"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,6">
                                    <materialDesign:PackIcon x:Name="IconGlyph"
                                                             Kind="{Binding Icon}"
                                                             Width="24" Height="24"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TitleText"
                                           Text="{Binding Title}"
                                           TextAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           MaxWidth="124"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource FlyoutCardHoverBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}"/>
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource ChromeTabSelectedForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ChromeTabSelectedBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="FlyoutRoot"
            Background="{DynamicResource FlyoutPanelBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="1,0,0,0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="-3" Opacity="0.28" Color="#050814" Direction="0"/>
        </Border.Effect>
        <Grid VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                            Background="#33FFFFFF" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="{Binding ActiveReportCategoryIcon}"
                                                 Width="20" Height="20"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveReportCategoryTitle}"
                                   FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock FontSize="11" Foreground="#E8EEF5" Opacity="0.9" Margin="0,2,0,0">
                            <Run Text="{Binding ReportFlyoutItems.Count, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding ActiveFlyoutItemLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="CardsScroller"
                          Grid.Row="1"
                          Style="{StaticResource ThinScrollViewer}"
                          Background="{DynamicResource FlyoutPanelBrush}"
                          Padding="6,8,6,10"
                          VerticalAlignment="Top"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReportFlyoutItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel ItemWidth="142" ItemHeight="94"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ReportMenuEntry}">
                            <Button Style="{StaticResource ReportCardButton}"
                                    Click="ReportCard_Click"
                                    Loaded="ReportCard_Loaded"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
