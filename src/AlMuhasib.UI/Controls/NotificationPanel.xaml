<UserControl x:Class="AlMuhasib.UI.Controls.NotificationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:AlMuhasib.UI.Models"
             xmlns:ux="clr-namespace:AlMuhasib.Core.Models.Ux;assembly=AlMuhasib.Core"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="NotificationDrawerHeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="IsTabStop" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Glow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#FFFFFF"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationOpenButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TitleBarIconBadgeBlueFg}"/>
            <Setter Property="Background" Value="{DynamicResource TitleBarIconBadgeBlueBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotificationCard" TargetType="Border">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource DashboardItemBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DashboardItemBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SearchResultHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource HighlightBorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="0"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top chrome: title + refresh + close -->
            <Border Grid.Row="0" Padding="18,16" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource NotificationDrawerHeaderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="20"
                                    Background="#33FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="BellRing" Width="20" Height="20"
                                                         Foreground="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الإشعارات" FontSize="18" FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock Text="تنبيهات النظام والمهام التي تحتاج متابعة"
                                           FontSize="12" Foreground="#E3F2FD" Margin="0,3,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Panel.ZIndex="20">
                        <Border Background="#33FFFFFF" CornerRadius="12" Padding="10,5"
                                Margin="0,0,10,0" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolVis}}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="White">
                                <Run Text="{Binding UnreadNotificationCount, Mode=OneWay}"/>
                                <Run Text=" غير مقروء"/>
                            </TextBlock>
                        </Border>
                        <Button x:Name="BtnRefreshNotifications"
                                Style="{StaticResource NotificationDrawerHeaderIconButton}"
                                Margin="0,0,8,0"
                                ToolTip="تحديث الإشعارات"
                                Click="RefreshNotificationsButton_Click"
                                PreviewMouseLeftButtonDown="HeaderButton_PreviewMouseLeftButtonDown">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                        <Button x:Name="BtnCloseNotifications"
                                Style="{StaticResource NotificationDrawerHeaderIconButton}"
                                ToolTip="إغلاق"
                                Click="CloseNotificationsButton_Click"
                                PreviewMouseLeftButtonDown="HeaderButton_PreviewMouseLeftButtonDown">
                            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" IsHitTestVisible="False"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TitleBarIconBadgeBlueFg}"
                         Visibility="{Binding IsNotificationCenterLoading, Converter={StaticResource BoolVis}}"/>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,14,16,10"
                          Background="{DynamicResource ContentBackground}">
                <StackPanel>
                    <!-- Unread -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="غير مقروءة" FontWeight="Bold" FontSize="13.5"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1"
                                Command="{Binding MarkAllNotificationsReadCommand}"
                                Style="{StaticResource NotificationOpenButton}"
                                Content="قراءة الكل"
                                ToolTip="تعليم جميع الإشعارات كمقروءة"
                                Visibility="{Binding HasUnreadNotifications, Converter={StaticResource BoolVis}}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding UnreadNotifications}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AppNotificationItem}">
                                <Border Style="{StaticResource NotificationCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22" Margin="0,0,12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource TitleBarIconBadgeBlueBg}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static ux:SmartAlertSeverity.Critical}">
                                                                <Setter Property="Background" Value="{DynamicResource DashboardKpiRedLightBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="{x:Static ux:SmartAlertSeverity.Warning}">
                                                                <Setter Property="Background" Value="{DynamicResource DashboardKpiOrangeLightBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <materialDesign:PackIcon Width="22" Height="22"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="InformationOutline"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource TitleBarIconBadgeBlueFg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static ux:SmartAlertSeverity.Critical}">
                                                                    <Setter Property="Kind" Value="AlertOctagon"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource DashboardKpiRedBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Static ux:SmartAlertSeverity.Warning}">
                                                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource DashboardKpiOrangeBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}" FontSize="12.5" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding TimeAgoText}" FontSize="11" Margin="0,6,0,0"
                                                           Foreground="{DynamicResource HintForegroundBrush}"/>
                                            </StackPanel>
                                            <Ellipse Grid.Column="2" Width="9" Height="9" Fill="#E53935"
                                                     VerticalAlignment="Top" Margin="8,4,0,0"/>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="56,12,0,0">
                                            <Button Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NotificationOpenButton}"
                                                    Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="15" Height="15"
                                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="فتح" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.MarkNotificationReadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource NotificationOpenButton}"
                                                    Background="{DynamicResource TitleBarIconBadgeNeutralBg}"
                                                    Foreground="{DynamicResource TitleBarIconBadgeNeutralFg}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Check" Width="15" Height="15"
                                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="تمّت القراءة" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource DashboardItemBrush}"
                            BorderBrush="{DynamicResource DashboardItemBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14" Padding="24,22" Margin="0,0,0,16"
                            Visibility="{Binding HasUnreadNotifications, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="28"
                                    Background="{DynamicResource DashboardKpiGreenLightBrush}"
                                    HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="28" Height="28"
                                                         Foreground="{DynamicResource DashboardKpiGreenBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="لا توجد إشعارات غير مقروءة" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="ستظهر هنا التنبيهات الجديدة فور وصولها"
                                       FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{DynamicResource HintForegroundBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Read -->
                    <TextBlock Text="مقروءة" FontWeight="Bold" FontSize="13.5" Margin="0,4,0,10"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <ItemsControl ItemsSource="{Binding ReadNotifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AppNotificationItem}">
                                <Border Style="{StaticResource NotificationCard}" Opacity="0.9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource MutedIconBackgroundBrush}" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="Check" Width="18" Height="18"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Message}" FontSize="12" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource HintForegroundBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource NotificationOpenButton}"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="OpenInNew" Width="14" Height="14"
                                                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="فتح" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="لا توجد إشعارات مقروءة بعد"
                               FontSize="12.5" Foreground="{DynamicResource HintForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReadNotifications.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    Background="{DynamicResource CardBrush}">
                <TextBlock Text="اضغط فتح للانتقال إلى الشاشة المرتبطة بالإشعار"
                           FontSize="11.5"
                           Foreground="{DynamicResource HintForegroundBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
