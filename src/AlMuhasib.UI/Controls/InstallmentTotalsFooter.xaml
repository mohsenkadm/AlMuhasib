<UserControl x:Class="AlMuhasib.UI.Controls.InstallmentTotalsFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" Padding="16,12"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Text="{Binding ScopeNote}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,8"
                       Visibility="{Binding HasScopeNote, Converter={StaticResource BoolToVis}}"/>
            <UniformGrid Columns="4">
                <StackPanel Margin="4,0">
                    <TextBlock Text="عدد السجلات (د.ع)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="إجمالي المبالغ" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalAmountText}" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المسدد" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PaidAmountText}" FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المتبقي" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding RemainingAmountText}" FontSize="16" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,10,0,0"
                         Visibility="{Binding ShowUsdSection, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="4,0">
                    <TextBlock Text="عدد السجلات ($)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CountUsd, StringFormat={}{0:N0}}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="إجمالي المبالغ $" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalAmountUsdText}" FontSize="16" FontWeight="Bold" Foreground="#00695C"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المسدد $" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PaidAmountUsdText}" FontSize="16" FontWeight="Bold" Foreground="#2E7D32"/>
                </StackPanel>
                <StackPanel Margin="4,0">
                    <TextBlock Text="المتبقي $" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding RemainingAmountUsdText}" FontSize="16" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
