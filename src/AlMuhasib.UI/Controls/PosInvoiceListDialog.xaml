<Window x:Class="AlMuhasib.UI.Controls.PosInvoiceListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="قائمة الفواتير"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFont}"
        Width="520" Height="560"
        MinWidth="480" MinHeight="480">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="18,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1565C0" Offset="0"/>
                        <GradientStop Color="#0D47A1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="TitleText" Text="الفواتير" FontSize="17" FontWeight="Bold" Foreground="White"
                               FontFamily="{DynamicResource AppFont}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#BBDEFB" Margin="0,4,0,0"
                               FontFamily="{DynamicResource AppFont}"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="InvoiceList" Grid.Row="1" Margin="12"
                     BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     FontFamily="{DynamicResource AppFont}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="15"
                                               FontFamily="{DynamicResource AppFont}"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontFamily="{DynamicResource AppFont}"/>
                                    <TextBlock Text="{Binding AmountText}" FontSize="14" FontWeight="SemiBold"
                                               Margin="0,6,0,0" Foreground="#1565C0"
                                               FontFamily="{DynamicResource AppFont}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="{Binding PrimaryActionLabel}"
                                            Style="{StaticResource PrimaryButton}"
                                            Height="36" Padding="14,0" Margin="0,0,0,6"
                                            Tag="{Binding}"
                                            Click="PrimaryAction_Click"
                                            FontFamily="{DynamicResource AppFont}"
                                            Visibility="{Binding ShowPrimaryAction, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="طباعة"
                                            Style="{StaticResource OutlinedButton}"
                                            Height="36" Padding="14,0"
                                            Tag="{Binding}"
                                            Click="Print_Click"
                                            FontFamily="{DynamicResource AppFont}"
                                            Visibility="{Binding ShowPrint, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="لا توجد فواتير" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontFamily="{DynamicResource AppFont}" Visibility="Collapsed"/>

            <Button Grid.Row="2" Content="إغلاق" Style="{StaticResource OutlinedButton}"
                    Height="42" Width="120" Margin="0,0,0,16" HorizontalAlignment="Center"
                    Click="Close_Click" IsCancel="True"
                    FontFamily="{DynamicResource AppFont}"/>
        </Grid>
    </Border>
</Window>
