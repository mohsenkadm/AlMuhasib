<Window x:Class="AlMuhasib.UI.Controls.ProductBulkDiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="خصم جماعي للمنتجات"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="RightToLeft"
        Width="460" Height="480"
        MinWidth="400" MinHeight="420">

    <Border Background="White" CornerRadius="16" BorderBrush="#E0E0E0" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,16"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E7D32" Offset="0"/>
                        <GradientStop Color="#1B5E20" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <StackPanel>
                        <TextBlock Text="خصم جماعي للمنتجات" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock FontSize="13" Foreground="#C8E6C9" Margin="0,6,0,0">
                            <Run Text="عدد المنتجات المحددة:"/>
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignIconButton}" Foreground="White"
                            Click="Cancel_Click" ToolTip="إغلاق">
                        <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="نوع الخصم" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding DiscountTypeOptions}"
                              SelectedItem="{Binding SelectedOption}"
                              DisplayMemberPath="Label"
                              Style="{StaticResource FilledComboBox}"
                              materialDesign:HintAssist.Hint="نسبة أو قيمة"
                              materialDesign:HintAssist.IsFloating="True"/>

                    <TextBlock Text="قيمة الخصم" FontWeight="SemiBold" Margin="0,16,0,6"/>
                    <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             materialDesign:HintAssist.Hint="النسبة أو المبلغ لكل وحدة"
                             materialDesign:HintAssist.IsFloating="True"/>

                    <CheckBox Content="تحديد تاريخ انتهاء للخصم"
                              IsChecked="{Binding HasExpiry}"
                              Margin="0,16,0,8"/>
                    <DatePicker SelectedDate="{Binding ExpiryDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                IsEnabled="{Binding HasExpiry}"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Background="#FAFAFA"
                    CornerRadius="0,0,16,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="تطبيق الخصم" Style="{StaticResource PrimaryButton}"
                            Click="Apply_Click" Padding="18,0" Height="40" Margin="0,0,8,0"/>
                    <Button Content="إلغاء الخصم" Style="{StaticResource OutlinedButton}"
                            Click="Clear_Click" Padding="14,0" Height="40" Margin="0,0,8,0"
                            ToolTip="إزالة الخصم عن المنتجات المحددة"/>
                    <Button Content="إغلاق" Style="{StaticResource OutlinedButton}"
                            Click="Cancel_Click" Padding="14,0" Height="40"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
