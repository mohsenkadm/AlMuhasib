<UserControl x:Class="AlMuhasib.UI.Controls.AmountBreakdownOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid x:Name="RootHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border x:Name="Backdrop" Background="#99000000" MouseDown="Backdrop_MouseDown"/>

        <materialDesign:Card x:Name="DialogCard"
                             MaxWidth="640" MinWidth="320"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="18" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp16"
                             RenderTransformOrigin="0.5,0.5">
            <materialDesign:Card.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </materialDesign:Card.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="22,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00695C" Offset="0"/>
                            <GradientStop Color="#00897B" Offset="0.55"/>
                            <GradientStop Color="#26A69A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Border Width="48" Height="48" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="CalculatorVariantOutline" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="#E0F2F1" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Click="CloseButton_Click"
                                VerticalAlignment="Top" Margin="0,-4,-8,0"
                                Style="{StaticResource MaterialDesignIconButton}" Foreground="White" ToolTip="إغلاق">
                            <materialDesign:PackIcon Kind="Close" Width="22" Height="22"/>
                        </Button>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16">
                    <StackPanel>
                        <Border Background="#E0F2F1" CornerRadius="12" Padding="14,12" Margin="0,0,0,16"
                                Visibility="{Binding Formula, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <TextBlock Text="المعادلة" FontSize="11" Foreground="#546E7A" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Formula}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#004D40" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" CornerRadius="12" Padding="14,12"
                                            BorderThickness="1" BorderBrush="#E0E0E0" Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                                                    Background="#F5F5F5" Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Operator}" FontWeight="Bold" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="#455A64"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="#263238"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#78909C"
                                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                       Text="{Binding Amount, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="16" FontWeight="Bold" Foreground="#00695C"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#FFF8E1" CornerRadius="12" Padding="14,12" Margin="0,8,0,0"
                                BorderBrush="#FFE082" BorderThickness="1"
                                Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20"
                                                         Foreground="#F9A825" VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="13" Foreground="#5D4037"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="0,0,18,18" Padding="22,16"
                        BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding ResultLabel}" FontSize="12" Foreground="#78909C"/>
                            <TextBlock Text="{Binding ResultAmount, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="26" FontWeight="Bold" Foreground="#004D40" Margin="0,2,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Content="إغلاق"
                                Style="{StaticResource PrimaryButton}"
                                Click="CloseButton_Click" Height="40" MinWidth="96" Padding="22,0"/>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
