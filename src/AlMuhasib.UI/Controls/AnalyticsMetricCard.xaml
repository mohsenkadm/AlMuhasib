<UserControl x:Class="AlMuhasib.UI.Controls.AnalyticsMetricCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft"
             x:Name="Root"
             Margin="6">
    <Border CornerRadius="18"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid MinHeight="124">
            <Border Width="5" HorizontalAlignment="Right" CornerRadius="0,18,18,0"
                    Background="{Binding AccentBrush, ElementName=Root}"/>
            <Grid Margin="16,14,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="14"
                        Background="{Binding IconBackground, ElementName=Root}"
                        VerticalAlignment="Top">
                    <materialDesign:PackIcon Kind="{Binding Icon, ElementName=Root}"
                                             Width="22" Height="22"
                                             Foreground="{Binding IconForeground, ElementName=Root}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <TextBlock Text="{Binding Title, ElementName=Root}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding TextValue, ElementName=Root}"
                               FontSize="{Binding ValueFontSize, ElementName=Root}"
                               FontWeight="Bold"
                               Foreground="{Binding ValueForeground, ElementName=Root}"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="58"
                               Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding Hint, ElementName=Root}"
                               FontSize="11"
                               Foreground="{DynamicResource HintForegroundBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="34"
                               Margin="0,4,0,0"
                               Visibility="{Binding Hint, ElementName=Root, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <Border x:Name="ComparisonChip" Margin="0,8,0,0" CornerRadius="10"
                            Padding="8,3" HorizontalAlignment="Right" Visibility="Collapsed"
                            Background="{Binding IconBackground, ElementName=Root}">
                        <TextBlock x:Name="ComparisonText" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
