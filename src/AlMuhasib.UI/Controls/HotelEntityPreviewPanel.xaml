<UserControl x:Class="AlMuhasib.UI.Controls.HotelEntityPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Border Style="{StaticResource HotelPreviewPanelBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Empty state -->
            <StackPanel Grid.RowSpan="3"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="24"
                        Visibility="{Binding HasSelection, ElementName=Root, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <md:PackIcon Kind="CursorDefaultClick" Width="48" Height="48"
                             Foreground="#B0BEC5" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding EmptyMessage, ElementName=Root}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#78909C"
                           FontSize="13"
                           MaxWidth="260"/>
            </StackPanel>

            <!-- Header -->
            <Border Grid.Row="0"
                    Style="{StaticResource HotelPreviewPanelHeader}"
                    Visibility="{Binding HasSelection, ElementName=Root, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#33FFFFFF" Margin="0,0,10,0">
                            <md:PackIcon Kind="{Binding IconKind, ElementName=Root}"
                                         Width="22" Height="22" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title, ElementName=Root}"
                                       FontSize="16" FontWeight="Bold" Foreground="White"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                            <TextBlock Text="{Binding Subtitle, ElementName=Root}"
                                       FontSize="11" Foreground="#E3F2FD" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240"
                                       Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NullToCollapsedConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand, ElementName=Root}"
                            Style="{StaticResource FlatButton}"
                            Foreground="White"
                            ToolTip="إغلاق المعاينة"
                            Padding="4"
                            Visibility="{Binding ShowCloseButton, ElementName=Root, Converter={StaticResource BoolVis}}">
                        <md:PackIcon Kind="Close" Width="20" Height="20"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Tabs -->
            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding SelectedTabIndex, ElementName=Root, Mode=TwoWay}"
                        Style="{StaticResource HotelPreviewTabControl}"
                        Visibility="{Binding HasSelection, ElementName=Root, Converter={StaticResource BoolVis}}">
                <TabItem Header="ملخص">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ContentPresenter Content="{Binding SummaryContent, ElementName=Root}" Margin="0,8,0,0"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="السجل">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ContentPresenter Content="{Binding HistoryContent, ElementName=Root}" Margin="0,8,0,0"/>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="إجراءات">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                        <ContentPresenter Content="{Binding ActionsContent, ElementName=Root}" Margin="0,8,0,0"/>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Optional footer -->
            <ContentPresenter Grid.Row="2"
                              Content="{Binding FooterContent, ElementName=Root}"
                              Margin="12,0,12,12"
                              Visibility="{Binding FooterContent, ElementName=Root, Converter={StaticResource NullToCollapsedConverter}}"/>
        </Grid>
    </Border>
</UserControl>
