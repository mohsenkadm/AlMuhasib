<UserControl x:Class="AlMuhasib.UI.Controls.ColumnFilterToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <UserControl.Resources>
        <converters:PositiveIntToVisibilityConverter x:Key="CountVis"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="FilterToggle"
                      IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                      ToolTip="بحث في الأعمدة (Ctrl+Shift+F)"
                      Cursor="Hand"
                      Height="36"
                      MinWidth="36"
                      Padding="10,0"
                      Margin="4,0"
                      Background="Transparent"
                      BorderThickness="0">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Shell"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource DataGridHeaderHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{StaticResource PrimaryHueLightBrush}"/>
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid>
                <md:PackIcon Kind="FilterVariant" Width="18" Height="18" VerticalAlignment="Center"
                             Foreground="{DynamicResource DataGridHeaderForegroundBrush}"/>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-8,0"
                        MinWidth="16" Height="16"
                        CornerRadius="8"
                        Background="{StaticResource AccentBrush}"
                        Padding="4,0"
                        Visibility="{Binding ActiveFilterCount, ElementName=Root, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{Binding ActiveFilterCount, ElementName=Root}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ToggleButton>

        <Button x:Name="ClearButton"
                Style="{StaticResource IconButton}"
                Width="32" Height="32"
                Margin="2,0,0,0"
                ToolTip="مسح فلاتر الأعمدة"
                Visibility="{Binding ActiveFilterCount, ElementName=Root, Converter={StaticResource CountVis}}">
            <md:PackIcon Kind="FilterVariantRemove" Width="16" Height="16"/>
        </Button>
    </StackPanel>
</UserControl>
