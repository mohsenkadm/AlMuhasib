<UserControl x:Class="AlMuhasib.UI.Controls.ColumnFilterToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             FlowDirection="RightToLeft"
             x:Name="Root">

    <UserControl.Resources>
        <converters:PositiveIntToVisibilityConverter x:Key="CountVis"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="FilterToggle"
                      IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                      ToolTip="بحث في الأعمدة (Ctrl+Shift+F)"
                      Cursor="Hand"
                      Height="40"
                      MinWidth="40"
                      Padding="0"
                      Margin="4,0"
                      Background="Transparent"
                      BorderThickness="0"
                      FocusVisualStyle="{x:Null}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Bd" Width="40" Height="40" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <controls:LiquidGlassChrome x:Name="Glass"
                                                    Tone="Standard"
                                                    ShadowStrength="0.34"
                                                    IsHovered="{TemplateBinding IsMouseOver}"
                                                    IsPressed="{TemplateBinding IsPressed}"
                                                    IsActive="{TemplateBinding IsChecked}"/>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid>
                <md:PackIcon Kind="FilterVariant" Width="20" Height="20" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-6,-6,0"
                        MinWidth="16" Height="16"
                        CornerRadius="8"
                        Background="{StaticResource AccentBrush}"
                        Padding="4,0"
                        Visibility="{Binding ActiveFilterCount, ElementName=Root, Converter={StaticResource CountVis}}">
                    <TextBlock Text="{Binding ActiveFilterCount, ElementName=Root}"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ToggleButton>

        <Button x:Name="ClearButton"
                Width="40" Height="40"
                Margin="2,0,0,0"
                Padding="0"
                ToolTip="مسح فلاتر الأعمدة"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                Background="Transparent"
                BorderThickness="0"
                Visibility="{Binding ActiveFilterCount, ElementName=Root, Converter={StaticResource CountVis}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Grid Width="40" Height="40">
                        <controls:LiquidGlassChrome Tone="Standard"
                                                    ShadowStrength="0.28"
                                                    IsHovered="{TemplateBinding IsMouseOver}"
                                                    IsPressed="{TemplateBinding IsPressed}"/>
                        <md:PackIcon Kind="FilterVariantRemove" Width="20" Height="20"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </StackPanel>
</UserControl>
