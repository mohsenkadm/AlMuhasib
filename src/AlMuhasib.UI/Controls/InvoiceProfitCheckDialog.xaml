<Window x:Class="AlMuhasib.UI.Controls.InvoiceProfitCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
        Title="فحص ربح الفاتورة"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource AppFont}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.88" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.88" To="1" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.28"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="DialogCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.24"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource ShowAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="DialogCard"
            Width="700" MaxHeight="600"
            Background="White"
            CornerRadius="18"
            Margin="16"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MaxHeight="360"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18,18,0,0" Padding="20,16" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1B5E20" Offset="0"/>
                        <GradientStop Color="#43A047" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#33FFFFFF" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="ChartLine" Width="24" Height="24" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="فحص ربح الفاتورة" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding SummaryLabel}" FontSize="11" Foreground="#C8E6C9"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            VerticalAlignment="Center"
                            Width="34" Height="34"
                            Cursor="Hand"
                            Background="#33FFFFFF"
                            BorderThickness="0"
                            ToolTip="إغلاق"
                            Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="17">
                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12" MaxHeight="360">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:InvoiceProfitLine}">
                            <Border Margin="0,0,0,8" CornerRadius="12" Padding="12,10" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FAFAFA"/>
                                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                                <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="#263238" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <Border Background="#FFFFFF" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                                <TextBlock FontSize="11" Foreground="#546E7A">
                                                    <Run Text="كمية:"/>
                                                    <Run Text="{Binding QuantityLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#FFFFFF" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                                <TextBlock FontSize="11" Foreground="#546E7A">
                                                    <Run Text="شراء:"/>
                                                    <Run Text="{Binding PurchasePriceLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="#FFFFFF" CornerRadius="8" Padding="8,3" Margin="0,0,6,4"
                                                    BorderBrush="#E0E0E0" BorderThickness="1">
                                                <TextBlock FontSize="11" Foreground="#546E7A">
                                                    <Run Text="بيع:"/>
                                                    <Run Text="{Binding SalePriceLabel, Mode=OneWay}" FontWeight="Bold"/>
                                                </TextBlock>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="12,8" MinWidth="110">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ECEFF1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                        <Setter Property="Background" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="الربح" FontSize="10" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#546E7A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFCDD2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                                <Setter Property="Foreground" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ProfitLabel}" FontWeight="Bold" FontSize="14"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#37474F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoss}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsProfit}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#F5F9F6" BorderBrush="#E0E8E2" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Visibility="{Binding ShowDiscountControls, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="خصم الفاتورة (اختياري)" FontWeight="SemiBold" Foreground="#1B5E20" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding DiscountTypeOptions}"
                                      SelectedItem="{Binding SelectedDiscountOption}"
                                      Width="160" Height="36" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="قيمة الخصم"
                                     Width="120" Height="36" Margin="0,0,8,0"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center" Foreground="#2E7D32" FontSize="12">
                                <Run Text="مبلغ الخصم:"/>
                                <Run Text="{Binding InvoiceDiscountAmount, StringFormat=N0, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" CornerRadius="12" Padding="16,10" MinWidth="160" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#ECEFF1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverallLoss}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverallProfit}" Value="True">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="إجمالي ربح الفاتورة" FontSize="11" Foreground="#546E7A" HorizontalAlignment="Center"/>
                            <TextBlock FontSize="20" FontWeight="Bold" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#37474F"/>
                                        <Setter Property="Text" Value="{Binding TotalProfit, StringFormat='{}{0:N0} د.ع'}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverallLoss}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverallProfit}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="#FAFBFD" BorderBrush="#E8EEF5" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,18,18" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="إغلاق" Click="Close_Click"
                            Style="{StaticResource FlatButton}" Height="38" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Content="تطبيق الخصم والمتابعة" Click="Apply_Click"
                            Style="{StaticResource AccentButton}" Height="38" Padding="18,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Visibility="{Binding ShowDiscountControls, Converter={StaticResource BoolVis}}"/>
                    <Button Content="حسناً" Click="Close_Click"
                            Height="38" Padding="18,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDiscountControls}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
