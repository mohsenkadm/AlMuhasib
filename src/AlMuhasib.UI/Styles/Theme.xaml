    <Style x:Key="SidebarNavMenuButton" TargetType="Button">
        <Setter Property="Height" Value="46"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="#42A5F540"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="11" Padding="8,0" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1">
                        <Grid x:Name="LayoutRoot">
                            <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" CornerRadius="2"
                                    Background="{StaticResource SidebarMenuAccentBrush}"
                                    Visibility="Collapsed" Margin="-4,8,0,8"/>
                            <Grid x:Name="ContentRow" Margin="2,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconHost" Grid.Column="0" Width="36" Height="36"
                                        CornerRadius="10" Background="Transparent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon x:Name="NavIcon"
                                                             Kind="{Binding Icon}"
                                                             Width="21" Height="21"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{StaticResource SidebarMenuIconBrush}"/>
                                </Border>
                                <TextBlock x:Name="NavText" Grid.Column="1"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center" Margin="10,0,6,0"
                                           FontSize="13.5" FontWeight="Medium"
                                           Foreground="#CFD8DC"
                                           Visibility="{Binding DataContext.IsSidebarExpanded,
                                               RelativeSource={RelativeSource AncestorType=Window},
                                               Converter={StaticResource SidebarBoolToVis}}"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A2F4A"/>
                            <Setter TargetName="IconHost" Property="Background" Value="#FFFFFF10"/>
                            <Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                            <Setter TargetName="NavText" Property="Foreground" Value="#ECEFF1"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SidebarNavSelectedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#42A5F533"/>
