                            <Setter TargetName="AccentBar" Property="Background" Value="White"/>
                            <Setter TargetName="IconHost" Property="Background" Value="#FFFFFF28"/>
                            <Setter TargetName="NavIcon" Property="Foreground" Value="White"/>
                            <Setter TargetName="NavText" Property="Foreground" Value="White"/>
                            <Setter TargetName="NavText" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="ContentRow" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Bd" Property="Padding" Value="0"/>
                            <Setter TargetName="LayoutRoot" Property="Margin" Value="0"/>
