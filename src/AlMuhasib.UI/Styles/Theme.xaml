    <SolidColorBrush x:Key="SidebarSearchBackgroundFocusBrush" Color="#223A58"/>
    <SolidColorBrush x:Key="SidebarSearchBorderBrush" Color="#3A5572"/>
    <SolidColorBrush x:Key="SidebarSearchBorderHoverBrush" Color="#4E6D8F"/>
    <SolidColorBrush x:Key="SidebarSearchBorderFocusBrush" Color="#42A5F5"/>
    <SolidColorBrush x:Key="SidebarSearchForegroundBrush" Color="#E8EEF4"/>
    <SolidColorBrush x:Key="SidebarSearchHintBrush" Color="#8FA8C4"/>
