                                                         Foreground="#90A4AE"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       FontSize="13" FontWeight="SemiBold" Foreground="#90A4AE"
                                       Visibility="{Binding DataContext.IsSidebarExpanded,
                                           RelativeSource={RelativeSource AncestorType=Window},
                                           Converter={StaticResource SidebarBoolToVis}}"/>
                            <materialDesign:PackIcon Grid.Column="2" Width="18" Height="18"
                                                     VerticalAlignment="Center" Foreground="#78909C" Opacity="0.85"
                                                     Visibility="{Binding DataContext.IsSidebarExpanded,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource SidebarBoolToVis}}">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="ChevronDown"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Kind" Value="ChevronUp"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A2F4A"/>
                            <Setter TargetName="IconHost" Property="Background" Value="#FFFFFF10"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#15283D"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

