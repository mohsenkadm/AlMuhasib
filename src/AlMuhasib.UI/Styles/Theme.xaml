    <LinearGradientBrush x:Key="SidebarNavSelectedBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1565C0" Offset="0"/>
        <GradientStop Color="#1E5FA8" Offset="0.55"/>
