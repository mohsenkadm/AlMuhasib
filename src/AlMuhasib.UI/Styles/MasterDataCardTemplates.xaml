<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:entities="clr-namespace:AlMuhasib.Core.Entities;assembly=AlMuhasib.Core"
                    xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels">

    <Style x:Key="MasterDataEntityCardBorder" TargetType="Border">
        <Setter Property="Width" Value="228"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#90CAF9"/>
                <Setter Property="Background" Value="#F8FBFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MasterDataCardTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#263238"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="MasterDataCardMeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#78909C"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="MasterDataCardActionsPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ═══ Category Card ═══ -->
    <DataTemplate x:Key="CategoryCardTemplate" DataType="{x:Type entities:Category}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E3F2FD" Margin="0,0,0,8">
                    <md:PackIcon Kind="Tag" Width="20" Height="20" Foreground="#1565C0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource MasterDataCardMeta}">
                    <Run Text="تاريخ الإنشاء: "/>
                    <Run Text="{Binding CreatedAt, StringFormat=yyyy/MM/dd}"/>
                </TextBlock>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Product Card ═══ -->
    <DataTemplate x:Key="ProductCardTemplate" DataType="{x:Type entities:Product}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="248">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,8">
                    <md:PackIcon Kind="PackageVariant" Width="20" Height="20" Foreground="#388E3C"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="التصنيف: "/>
                        <Run Text="{Binding Category.Name, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}" FontFamily="Consolas">
                        <Run Text="الباركود: "/>
                        <Run Text="{Binding Barcode, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource MasterDataCardMeta}"
                               MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Customer Card ═══ -->
    <DataTemplate x:Key="CustomerCardTemplate" DataType="{x:Type entities:Customer}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#FFF3E0" Margin="0,0,0,8">
                    <md:PackIcon Kind="Account" Width="20" Height="20" Foreground="#F57C00"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="العنوان: "/>
                        <Run Text="{Binding Address, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="رقم الملف: "/>
                        <Run Text="{Binding FileNumber, TargetNullValue=—}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenAttachmentsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableAttachIconButton}">
                        <md:PackIcon Kind="Attachment" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Supplier Card ═══ -->
    <DataTemplate x:Key="SupplierCardTemplate" DataType="{x:Type entities:Supplier}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#ECEFF1" Margin="0,0,0,8">
                    <md:PackIcon Kind="TruckDelivery" Width="20" Height="20" Foreground="#546E7A"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="العنوان: "/>
                        <Run Text="{Binding Address, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource MasterDataCardMeta}"
                               MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Investor Card ═══ -->
    <DataTemplate x:Key="InvestorCardTemplate" DataType="{x:Type vm:InvestorRow}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="248">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#EDE7F6" Margin="0,0,0,8">
                    <md:PackIcon Kind="AccountGroup" Width="20" Height="20" Foreground="#5E35B1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="إجمالي الإيداعات: "/>
                        <Run Text="{Binding TotalDeposit, StringFormat=N0}" FontWeight="SemiBold" Foreground="#1976D2"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="نسبة الربح: "/>
                        <Run Text="{Binding ProfitPercentage, StringFormat=N2}"/>
                        <Run Text="%"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="إجمالي الأرباح: "/>
                        <Run Text="{Binding TotalProfitsEarned, StringFormat=N0}" FontWeight="SemiBold" Foreground="#388E3C"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.EditInvestorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Shared card grid panel ═══ -->
    <ItemsPanelTemplate x:Key="MasterDataCardWrapPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

</ResourceDictionary>
