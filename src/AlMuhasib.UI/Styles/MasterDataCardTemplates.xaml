<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:entities="clr-namespace:AlMuhasib.Core.Entities;assembly=AlMuhasib.Core"
                    xmlns:hotel="clr-namespace:AlMuhasib.Core.Entities.Hotel;assembly=AlMuhasib.Core"
                    xmlns:hotelModels="clr-namespace:AlMuhasib.Core.Models.Hotel;assembly=AlMuhasib.Core"
                    xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
                    xmlns:hotelVm="clr-namespace:AlMuhasib.UI.ViewModels.Hotel"
                    xmlns:controls="clr-namespace:AlMuhasib.UI.Controls">

    <Style x:Key="MasterDataEntityCardBorder" TargetType="Border">
        <Setter Property="Width" Value="228"/>
        <Setter Property="Margin" Value="0,0,12,12"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource SubtleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="Padding" Value="14,12"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#90CAF9"/>
                <Setter Property="Background" Value="#F8FBFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MasterDataCardTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#263238"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="MasterDataCardMeta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#78909C"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="MasterDataCardActionsPanel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <!-- ═══ Category Card ═══ -->
    <DataTemplate x:Key="CategoryCardTemplate" DataType="{x:Type entities:Category}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E3F2FD" Margin="0,0,0,8">
                    <md:PackIcon Kind="Tag" Width="20" Height="20" Foreground="#1565C0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource MasterDataCardMeta}"
                           Text="{Binding CreatedAt, Mode=OneWay, StringFormat=تاريخ الإنشاء: yyyy/MM/dd}"/>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Product Card ═══ -->
    <DataTemplate x:Key="ProductCardTemplate" DataType="{x:Type entities:Product}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="248">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,8">
                    <md:PackIcon Kind="PackageVariant" Width="20" Height="20" Foreground="#388E3C"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}"
                               Text="{Binding Category.Name, Mode=OneWay, TargetNullValue=—, FallbackValue=—, StringFormat=التصنيف: {0}}"/>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}" FontFamily="Consolas"
                               Text="{Binding Barcode, Mode=OneWay, TargetNullValue=—, StringFormat=الباركود: {0}}"/>
                    <TextBlock Text="{Binding Description, Mode=OneWay}" Style="{StaticResource MasterDataCardMeta}"
                               MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Customer Card ═══ -->
    <DataTemplate x:Key="CustomerCardTemplate" DataType="{x:Type entities:Customer}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#FFF3E0" Margin="0,0,0,8">
                    <md:PackIcon Kind="Account" Width="20" Height="20" Foreground="#F57C00"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="العنوان: "/>
                        <Run Text="{Binding Address, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="رقم الملف: "/>
                        <Run Text="{Binding FileNumber, TargetNullValue=—}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenAttachmentsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableAttachIconButton}">
                        <md:PackIcon Kind="Attachment" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Driver Card ═══ -->
    <DataTemplate x:Key="DriverCardTemplate" DataType="{x:Type entities:Driver}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#EFEBE9" Margin="0,0,0,8">
                    <md:PackIcon Kind="AccountHardHat" Width="20" Height="20" Foreground="#5D4037"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="العنوان: "/>
                        <Run Text="{Binding Address, TargetNullValue=—}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Supplier Card ═══ -->
    <DataTemplate x:Key="SupplierCardTemplate" DataType="{x:Type entities:Supplier}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#ECEFF1" Margin="0,0,0,8">
                    <md:PackIcon Kind="TruckDelivery" Width="20" Height="20" Foreground="#546E7A"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="العنوان: "/>
                        <Run Text="{Binding Address, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource MasterDataCardMeta}"
                               MaxHeight="32" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Investor Card ═══ -->
    <DataTemplate x:Key="InvestorCardTemplate" DataType="{x:Type vm:InvestorRow}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="248">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#EDE7F6" Margin="0,0,0,8">
                    <md:PackIcon Kind="AccountGroup" Width="20" Height="20" Foreground="#5E35B1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}"
                           ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="إجمالي الإيداعات: "/>
                        <Run Text="{Binding TotalDeposit, StringFormat=N0}" FontWeight="SemiBold" Foreground="#1976D2"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="نسبة الربح: "/>
                        <Run Text="{Binding ProfitPercentage, StringFormat=N2}"/>
                        <Run Text="%"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="إجمالي الأرباح: "/>
                        <Run Text="{Binding TotalProfitsEarned, StringFormat=N0}" FontWeight="SemiBold" Foreground="#388E3C"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.EditInvestorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource TableEditIconButton}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Hotel Floor Card ═══ -->
    <DataTemplate x:Key="HotelFloorCardTemplate" DataType="{x:Type hotel:Floor}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E8EAF6" Margin="0,0,0,8">
                    <md:PackIcon Kind="Stairs" Width="20" Height="20" Foreground="#3949AB"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}" ToolTip="{Binding Name}"/>
                <TextBlock Grid.Row="2" Style="{StaticResource MasterDataCardMeta}">
                    <Run Text="الترتيب: "/>
                    <Run Text="{Binding SortOrder}"/>
                </TextBlock>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Hotel Room Type Card ═══ -->
    <DataTemplate x:Key="HotelRoomTypeCardTemplate" DataType="{x:Type hotel:RoomType}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="248">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E3F2FD" Margin="0,0,0,8">
                    <md:PackIcon Kind="BedKingOutline" Width="20" Height="20" Foreground="#1565C0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding Name}" Style="{StaticResource MasterDataCardTitle}" ToolTip="{Binding Name}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="السعة: "/>
                        <Run Text="{Binding Capacity}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="السعر الأساسي: "/>
                        <Run Text="{Binding BasePrice, StringFormat=N0}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Hotel Room Card ═══ -->
    <DataTemplate x:Key="HotelRoomCardTemplate" DataType="{x:Type hotelVm:HotelRoomListDisplay}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="228">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,8">
                    <md:PackIcon Kind="Door" Width="20" Height="20" Foreground="#2E7D32"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding RoomNumber}" Style="{StaticResource MasterDataCardTitle}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الطابق: "/>
                        <Run Text="{Binding FloorName}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="النوع: "/>
                        <Run Text="{Binding RoomTypeName}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="النزيل: "/>
                        <Run Text="{Binding CurrentGuestName}"/>
                    </TextBlock>
                </StackPanel>
                <controls:HotelStatusBadge Grid.Row="3" Label="{Binding StatusLabel}" Color="{Binding StatusColor}" Margin="0,8,0,0"/>
                <StackPanel Grid.Row="4" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Hotel Guest Card ═══ -->
    <DataTemplate x:Key="HotelGuestCardTemplate" DataType="{x:Type hotelModels:GuestListItem}">
        <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="248">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#FFF3E0" Margin="0,0,0,8">
                    <md:PackIcon Kind="Account" Width="20" Height="20" Foreground="#F57C00"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding FullName}" Style="{StaticResource MasterDataCardTitle}" ToolTip="{Binding FullName}"/>
                <StackPanel Grid.Row="2">
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهاتف: "/>
                        <Run Text="{Binding Phone, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الهوية: "/>
                        <Run Text="{Binding IdNumber, TargetNullValue=—}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource MasterDataCardMeta}">
                        <Run Text="الحجوزات: "/>
                        <Run Text="{Binding ReservationCount}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Row="3" Style="{StaticResource MasterDataCardActionsPanel}">
                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                        <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ═══ Shared card grid panel ═══ -->
    <ItemsPanelTemplate x:Key="MasterDataCardWrapPanel">
        <WrapPanel Orientation="Horizontal"/>
    </ItemsPanelTemplate>

</ResourceDictionary>
