<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>AlMuhasib.UI</RootNamespace>
    <AssemblyName>AlMuhasib</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>NU1701</NoWarn>
     <Version>1.14.30</Version>
    <AssemblyVersion>1.14.30.0</AssemblyVersion>
    <FileVersion>1.14.30.0</FileVersion>
    <ApplicationIcon>Assets\Brand\qayd-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.5" />
    <PackageReference Include="MaterialDesignThemes" Version="5.*" />
    <PackageReference Include="MaterialDesignColors" Version="5.*" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Speech" Version="10.0.10" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlMuhasib.Updater\AlMuhasib.Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\AlMuhasib.Core\AlMuhasib.Core.csproj" />
    <ProjectReference Include="..\AlMuhasib.Infrastructure\AlMuhasib.Infrastructure.csproj" />
    <ProjectReference Include="..\AlMuhasib.Shared\AlMuhasib.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="help-videos.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Sounds\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="Assets\Brand\qayd-mark.png" />
    <Resource Include="Assets\Brand\qayd-icon.ico" />
    <None Update="Assets\Brand\qayd-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Cairo Arabic UI font: shipped next to the app for WPF + installer + auto-update. -->
    <None Update="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="..\..\scripts\configure-sql-express.ps1">
      <Link>scripts\configure-sql-express.ps1</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyUpdaterExecutable" AfterTargets="Build" DependsOnTargets="ResolveProjectReferences">
    <PropertyGroup>
      <UpdaterOutputPath>$(MSBuildProjectDirectory)\..\AlMuhasib.Updater\bin\$(Configuration)\net10.0\</UpdaterOutputPath>
    </PropertyGroup>
    <MSBuild Projects="..\AlMuhasib.Updater\AlMuhasib.Updater.csproj" Properties="Configuration=$(Configuration)" Targets="Build" Condition="!Exists('$(UpdaterOutputPath)AlMuhasib.Updater.dll')" />
    <ItemGroup>
      <UpdaterFiles Include="$(UpdaterOutputPath)AlMuhasib.Updater.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish updater as self-contained single-file so TEMP launcher works without machine-wide .NET. -->
  <Target Name="IncludeUpdaterInPublish" AfterTargets="Publish">
    <PropertyGroup>
      <UpdaterPublishOut>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\AlMuhasib.Updater\bin\$(Configuration)\net10.0\win-x64\publish-sc\'))</UpdaterPublishOut>
    </PropertyGroup>
    <ItemGroup>
      <_StaleUpdaterFiles Include="$(PublishDir)AlMuhasib.Updater.*" />
    </ItemGroup>
    <Delete Files="@(_StaleUpdaterFiles)" Condition="'@(_StaleUpdaterFiles)' != ''" />
    <MSBuild Projects="..\AlMuhasib.Updater\AlMuhasib.Updater.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=true;EnableCompressionInSingleFile=true;PublishDir=$(UpdaterPublishOut)" />
    <Error Condition="!Exists('$(UpdaterPublishOut)AlMuhasib.Updater.exe')" Text="Self-contained AlMuhasib.Updater.exe was not produced." />
    <Copy SourceFiles="$(UpdaterPublishOut)AlMuhasib.Updater.exe" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
