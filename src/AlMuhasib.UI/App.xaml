<Application x:Class="AlMuhasib.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:AlMuhasib.UI"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <!-- Custom theme overrides MUST come AFTER MaterialDesign defaults -->
                <ResourceDictionary Source="/Styles/Theme.xaml" />
                <ResourceDictionary Source="/Styles/MasterDataCardTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:PaymentMethodConverter x:Key="PaymentMethodConverter" />
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <converters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter" />
            <converters:InstallmentTypeConverter x:Key="InstallmentTypeConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:UserTaskStatusLabelConverter x:Key="UserTaskStatusLabelConverter" />
            <converters:IdEqualsMultiConverter x:Key="IdEqualsMultiConverter" />
            <converters:PaginationStatisticsTextConverter x:Key="PaginationStatisticsTextConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
            <converters:RestaurantEnumLabelConverter x:Key="RestaurantEnumLabelConverter" />
            <converters:PositiveIntToVisibilityConverter x:Key="PositiveIntToVisibilityConverter" />
            <converters:ReservationStatusLabelConverter x:Key="ReservationStatusLabelConverter" />
            <converters:ReservationStatusColorConverter x:Key="ReservationStatusColorConverter" />
            <converters:RoomStatusLabelConverter x:Key="RoomStatusLabelConverter" />
            <converters:RoomStatusColorConverter x:Key="RoomStatusColorConverter" />
            <converters:HousekeepingStatusLabelConverter x:Key="HousekeepingStatusLabelConverter" />
            <converters:HousekeepingStatusColorConverter x:Key="HousekeepingStatusColorConverter" />
            <converters:GoldItemStatusLabelConverter x:Key="GoldItemStatusLabelConverter" />

            <!-- Legacy aliases (kept for backward compatibility with existing views) -->
            <SolidColorBrush x:Key="SidebarBackground" Color="#0D1B2A" />
            <SolidColorBrush x:Key="SidebarForeground" Color="#ECEFF1" />
            <SolidColorBrush x:Key="SidebarHover" Color="#1A2F4A" />
            <SolidColorBrush x:Key="SidebarSelected" Color="#1A4D82" />
            <SolidColorBrush x:Key="TopBarBackground" Color="White" />
            <SolidColorBrush x:Key="ContentBackground" Color="#F5F7FA" />
            <Color x:Key="AccentColor">#00ACC1</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentLightBrush" Color="#E0F7FA" />
            <SolidColorBrush x:Key="AccentDarkBrush" Color="#00838F" />
            <!-- بديل الأصفر/البرتقالي — بنفسجي ناعم -->
            <SolidColorBrush x:Key="HighlightLightBrush" Color="#EDE7F6" />
            <SolidColorBrush x:Key="HighlightBrush" Color="#7E57C2" />
            <SolidColorBrush x:Key="HighlightBorderBrush" Color="#D1C4E9" />

            <!-- Arabic Font -->
            <FontFamily x:Key="ArabicFont">Segoe UI, Tahoma, Arial</FontFamily>

        </ResourceDictionary>
    </Application.Resources>
</Application>
