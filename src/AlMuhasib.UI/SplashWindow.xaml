<Window x:Class="AlMuhasib.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
        Title="قيد"
        Icon="pack://application:,,,/Assets/Brand/qayd-icon.ico"
        Width="520" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource ArabicFont}">

    <Window.Resources>
        <Storyboard x:Key="SplashEntrance" RepeatBehavior="1x">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.55">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.92" To="1" Duration="0:0:0.65">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="ContentScale"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.92" To="1" Duration="0:0:0.65">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoGlow"
                             Storyboard.TargetProperty="Opacity"
                             From="0.35" To="0.85" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="1.06" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoIcon"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="1.06" Duration="0:0:1.4">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="RingSpin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbitRing"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="0" To="360" Duration="0:0:8"/>
        </Storyboard>

        <Storyboard x:Key="RingSpinReverse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="OrbitRingInner"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                             From="360" To="0" Duration="0:0:5.5"/>
        </Storyboard>

        <Storyboard x:Key="ShimmerBar" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Shimmer"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-220" To="420" Duration="0:0:1.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="DotWave" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Dot1"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.5" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Dot2"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.5" AutoReverse="True"
                             BeginTime="0:0:0.17"/>
            <DoubleAnimation Storyboard.TargetName="Dot3"
                             Storyboard.TargetProperty="Opacity"
                             From="0.25" To="1" Duration="0:0:0.5" AutoReverse="True"
                             BeginTime="0:0:0.34"/>
        </Storyboard>

        <Storyboard x:Key="FloatBlob1" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Blob1"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-18" Duration="0:0:2.8">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FloatBlob2" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Blob2"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="14" Duration="0:0:3.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Root" Opacity="0" CornerRadius="24" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.45" Color="#0D47A1"/>
        </Border.Effect>

        <Grid x:Name="ContentScale" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
            </Grid.RenderTransform>

            <Border CornerRadius="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A1628" Offset="0"/>
                        <GradientStop Color="#0D2847" Offset="0.45"/>
                        <GradientStop Color="#1565C0" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ClipToBounds="True">
                    <!-- Ambient blobs -->
                    <Ellipse x:Name="Blob1" Width="280" Height="280"
                             Fill="#204DD0E1" Opacity="0.22"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-80,-100,0,0"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Blob2" Width="220" Height="220"
                             Fill="#403F51B5" Opacity="0.28"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-60,-70"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <TranslateTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Grid Margin="36,40,36,32">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Brand -->
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">

                            <Grid Width="148" Height="148" Margin="0,0,0,28">
                                <Ellipse x:Name="OrbitRing" Width="148" Height="148"
                                         Stroke="#4DFFFFFF" StrokeThickness="2"
                                         StrokeDashArray="4 6"
                                         Opacity="0.55"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="OrbitRingInner" Width="118" Height="118"
                                         Stroke="#66B3E5FC" StrokeThickness="1.5"
                                         StrokeDashArray="2 8"
                                         Opacity="0.45"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>

                                <Ellipse x:Name="LogoGlow" Width="92" Height="92"
                                         Fill="#4D4DD0E1" Opacity="0.5"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <Border Width="76" Height="76" CornerRadius="38"
                                        Background="Transparent"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="LogoIcon"
                                           Source="pack://application:,,,/Assets/Brand/qayd-mark.png"
                                           Width="76" Height="76"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <ScaleTransform/>
                                        </Image.RenderTransform>
                                    </Image>
                                </Border>
                            </Grid>

                            <TextBlock x:Name="AppNameText"
                                       Text="قيد"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock x:Name="AppNameEnText"
                                       Text="Qayd"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#B3E5FC"
                                       Opacity="0.9"
                                       HorizontalAlignment="Center"
                                       Margin="0,6,0,0"/>

                            <TextBlock Text="{x:Static helpers:AppInfo.TaglineAr}"
                                       FontSize="13"
                                       Foreground="#E3F2FD"
                                       Opacity="0.75"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>

                            <Border Background="#1AFFFFFF" CornerRadius="20"
                                    Padding="16,6" Margin="0,18,0,0"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="VersionText"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#E1F5FE"/>
                            </Border>
                        </StackPanel>

                        <!-- Loading footer -->
                        <StackPanel Grid.Row="1" Margin="0,8,0,0">

                            <TextBlock x:Name="StatusText"
                                       Text="جاري بدء التشغيل..."
                                       FontSize="13"
                                       Foreground="#E3F2FD"
                                       Opacity="0.9"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,14"/>

                            <!-- Progress track + shimmer -->
                            <Grid x:Name="ProgressTrack" Height="6" Margin="8,0">
                                <Border CornerRadius="3" Background="#26FFFFFF"/>
                                <Border x:Name="ProgressFill" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#4DD0E1" Offset="0"/>
                                            <GradientStop Color="#42A5F5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="3" ClipToBounds="True" Background="Transparent">
                                    <Rectangle x:Name="Shimmer" Width="90" RadiusX="3" RadiusY="3" Opacity="0.55">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                                <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform X="-220"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,16,0,0">
                                <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#4DD0E1" Opacity="0.35" Margin="4,0"/>
                                <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#81D4FA" Opacity="0.35" Margin="4,0"/>
                                <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.35" Margin="4,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource SplashEntrance}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource LogoPulse}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource RingSpin}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource RingSpinReverse}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource ShimmerBar}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource DotWave}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FloatBlob1}"/>
            </EventTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard Storyboard="{StaticResource FloatBlob2}"/>
            </EventTrigger>
        </Border.Triggers>
    </Border>
</Window>
