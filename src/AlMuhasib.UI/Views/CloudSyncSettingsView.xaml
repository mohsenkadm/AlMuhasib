<UserControl x:Class="AlMuhasib.UI.Views.CloudSyncSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="SyncStatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SyncSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="24" MaxWidth="920">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hero header -->
            <Border Grid.Row="0" CornerRadius="18" Margin="0,0,0,18" Padding="24,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="0.45"/>
                        <GradientStop Color="#00ACC1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Color="#0D47A1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="CloudSync" Width="30" Height="30"
                                                     Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="المزامنة السحابية" FontSize="26" FontWeight="Bold"
                                       Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="ربط النظام المحلي مع API السحابي — مزامنة ثنائية الاتجاه للفواتير والمخازن والبيانات"
                                   FontSize="13" Foreground="#E3F2FD" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="12" Padding="14,10"
                            VerticalAlignment="Center" MinWidth="140">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="{Binding ConnectionIconKind}" Width="28" Height="28"
                                                     Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status cards -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
                <Border Style="{StaticResource SyncStatCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#E3F2FD" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="ClockOutline" Width="18" Height="18" Foreground="#1565C0"/>
                            </Border>
                            <TextBlock Text="آخر مزامنة" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastSyncDisplay}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding LastSyncDetail}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SyncStatCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#E0F7FA" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="DatabaseSync" Width="18" Height="18" Foreground="#00838F"/>
                            </Border>
                            <TextBlock Text="آخر عملية رفع" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding LastAcceptedCount, StringFormat={}{0} سجل}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding LastConflictDisplay}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SyncStatCard}" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="#EDE7F6" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="TimerSync" Width="18" Height="18" Foreground="#7E57C2"/>
                            </Border>
                            <TextBlock Text="المزامنة التلقائية" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding AutoSyncStatusText}" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding AutoSyncIntervalDisplay}" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Error / status banner -->
            <Border Grid.Row="2" CornerRadius="12" Padding="14,12" Margin="0,0,0,16"
                    Visibility="{Binding HasSyncError, Converter={StaticResource BoolVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFEBEE"/>
                        <Setter Property="BorderBrush" Value="#FFCDD2"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                             Foreground="#C62828" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock Text="{Binding LastSyncError}" Foreground="#C62828" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" CornerRadius="12" Padding="14,12" Margin="0,0,0,16"
                    Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20"
                                             Foreground="#2E7D32" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Connection settings -->
            <Border Grid.Row="3" Style="{StaticResource SyncSectionCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="ServerNetwork" Width="22" Height="22"
                                                 Foreground="#1565C0" VerticalAlignment="Center"/>
                        <TextBlock Text="إعدادات الاتصال" FontSize="17" FontWeight="Bold"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox materialDesign:HintAssist.Hint="عنوان API (مثال: http://localhost:5265)"
                             Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,14" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="اسم المستخدم"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <PasswordBox Grid.Column="2" x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="كلمة المرور"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"/>
                    </Grid>

                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12"
                            Padding="16,14" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="مزامنة تلقائية في الخلفية" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="رفع وسحب البيانات دورياً دون تدخل يدوي"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding AutoSyncEnabled}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"
                                Visibility="{Binding AutoSyncEnabled, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="تكرار كل" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBox Text="{Binding AutoSyncIntervalMinutes}" Width="56" Margin="10,0"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" VerticalAlignment="Center"/>
                        <TextBlock Text="دقيقة" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <Border Grid.Row="4" Style="{StaticResource SyncSectionCard}" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="إجراءات المزامنة" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="احفظ الإعدادات ثم اختبر الاتصال قبل المزامنة الأولى"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding SaveCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="16,8"
                                >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="حفظ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding TestConnectionCommand}" Margin="0,0,8,0"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="16,8"
                                >
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="اختبار الاتصال" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SyncNowCommand}" Style="{StaticResource AccentButton}"
                                Padding="20,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CloudUpload" Width="18" Height="18"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="مزامنة الآن" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Busy overlay -->
            <Border Grid.Row="0" Grid.RowSpan="5" Background="#66000000" CornerRadius="12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Value="0" IsIndeterminate="True" Width="48" Height="48"/>
                    <TextBlock Text="جاري المزامنة..." Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
