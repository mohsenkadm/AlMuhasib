<UserControl x:Class="AlMuhasib.UI.Views.UserActivityProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             d:DataContext="{d:DesignInstance vm:UserActivityProfileViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border Grid.Row="0" CornerRadius="16" Padding="22,18" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D47A1" Offset="0"/>
                    <GradientStop Color="#1565C0" Offset="0.55"/>
                    <GradientStop Color="#0288D1" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="18" Background="#33FFFFFF" Margin="0,0,16,0">
                    <md:PackIcon Kind="AccountCircle" Width="36" Height="36" Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Background="#33FFFFFF" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Username}" FontSize="12" Foreground="#E3F2FD"/>
                        </Border>
                        <Border Background="#33FFFFFF" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding RoleDisplay}" FontSize="12" Foreground="#E3F2FD"/>
                        </Border>
                        <Border Background="#33FFFFFF" CornerRadius="10" Padding="10,4">
                            <TextBlock Text="{Binding StatusDisplay}" FontSize="12" Foreground="#E3F2FD"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#BBDEFB"
                               Text="{Binding LastLoginDisplay, StringFormat=آخر دخول: {0}}"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding RefreshAllCommand}"
                        Style="{StaticResource OutlinedButton}" Height="40" Padding="14,0"
                        VerticalAlignment="Center" Background="#22FFFFFF" BorderBrush="#66FFFFFF" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="تحديث" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                    <controls:AnimatedStatCard Title="إجمالي النشاط" Value="{Binding TotalActivityCount}"
                                       Icon="ChartTimelineVariant" Margin="0,0,10,0"
                                       IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#0D47A1"/>
            <controls:AnimatedStatCard Title="تعديلات الفواتير" Value="{Binding ModificationsCount}"
                                       Icon="FileEditOutline" Margin="0,0,10,0"
                                       IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#E65100"/>
            <controls:AnimatedStatCard Title="سجلات محذوفة" Value="{Binding DeletedCount}"
                                       Icon="DeleteSweep" Margin="0,0,10,0"
                                       IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#B71C1C"/>
            <controls:AnimatedStatCard Title="فواتير محذوفة" Value="{Binding DeletedInvoicesCount}"
                                       Icon="FileCancel"
                                       IconBackground="#F3E5F5" IconForeground="#7B1FA2" ValueForeground="#6A1B9A"/>
        </UniformGrid>

        <!-- Filters -->
        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="14" Margin="0,0,0,14" md:ElevationAssist.Elevation="Dp2">
            <WrapPanel>
                <DatePicker Width="150" Margin="0,0,8,0" SelectedDate="{Binding DateFrom}"
                            md:HintAssist.Hint="من تاريخ" Style="{StaticResource FilledDatePicker}"/>
                <DatePicker Width="150" Margin="0,0,8,0" SelectedDate="{Binding DateTo}"
                            md:HintAssist.Hint="إلى تاريخ" Style="{StaticResource FilledDatePicker}"/>
                <TextBox Width="220" Margin="0,0,8,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="بحث في السجلات..." Style="{StaticResource FilledTextBox}"/>
                <ComboBox Width="160" Margin="0,0,8,0"
                          ItemsSource="{Binding DeletedKindOptions}"
                          SelectedItem="{Binding SelectedDeletedKind}"
                          md:HintAssist.Hint="نوع المحذوف (لتاب المحذوفات)"
                          Style="{StaticResource FilledComboBox}"/>
                <Button Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Height="40" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="بحث" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </md:Card>

        <!-- Tabs -->
        <md:Card Grid.Row="3" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <TabControl SelectedIndex="{Binding SelectedTabIndex}" md:ColorZoneAssist.Mode="Standard"
                        Style="{StaticResource MaterialDesignTabControl}">
                <!-- Modifications -->
                <TabItem Header="سجل تعديلات الفواتير">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding ModificationRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource ModernDataGrid}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Width="140" Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Timestamp"/>
                                <DataGridTextColumn Header="الفاتورة" Width="120" Binding="{Binding EntityKey}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EntityKey"/>
                                <DataGridTextColumn Header="العنوان" Width="*" Binding="{Binding EntityTitle}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EntityTitle"/>
                                <DataGridTextColumn Header="الملخص" Width="2*" Binding="{Binding ChangeSummary}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ChangeSummary"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="تفاصيل الفاتورة" Style="{StaticResource FlatButton}" Height="30" Padding="8,0"
                                                        Command="{Binding DataContext.OpenModificationInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="الفروق" Style="{StaticResource FlatButton}" Height="30" Padding="8,0"
                                                        Command="{Binding DataContext.ShowModificationDiffCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="0,1,0,0" Padding="12,8">
                            <Grid>
                                <TextBlock Text="{Binding ModPaginationInfo}" VerticalAlignment="Center" Foreground="#607D8B" FontSize="12.5"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Command="{Binding ModFirstPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" ToolTip="الأولى">
                                        <md:PackIcon Kind="PageFirst"/>
                                    </Button>
                                    <Button Command="{Binding ModPreviousPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" IsEnabled="{Binding ModCanGoPrevious}">
                                        <md:PackIcon Kind="ChevronRight"/>
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0" FontSize="12"
                                               Text="{Binding ModCurrentPage, StringFormat={}{0}}" />
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="/" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding ModTotalPages}"/>
                                    <Button Command="{Binding ModNextPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" IsEnabled="{Binding ModCanGoNext}">
                                        <md:PackIcon Kind="ChevronLeft"/>
                                    </Button>
                                    <Button Command="{Binding ModLastPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32">
                                        <md:PackIcon Kind="PageLast"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Deleted -->
                <TabItem Header="سجل المحذوفات">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding DeletedRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource ModernDataGrid}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Width="90" Binding="{Binding EntityKindDisplay}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EntityKindDisplay"/>
                                <DataGridTextColumn Header="العنوان" Width="140" Binding="{Binding Title}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Title"/>
                                <DataGridTextColumn Header="التفاصيل" Width="*" Binding="{Binding Subtitle}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Subtitle"/>
                                <DataGridTextColumn Header="المبلغ" Width="110" Binding="{Binding Amount, StringFormat=N0}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                                <DataGridTextColumn Header="تاريخ الحذف" Width="140" Binding="{Binding DeletedAt, StringFormat=yyyy/MM/dd HH:mm}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DeletedAt"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="تفاصيل" Style="{StaticResource FlatButton}" Height="30" Padding="10,0"
                                                    Command="{Binding DataContext.OpenDeletedDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="0,1,0,0" Padding="12,8">
                            <Grid>
                                <TextBlock Text="{Binding DelPaginationInfo}" VerticalAlignment="Center" Foreground="#607D8B" FontSize="12.5"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Command="{Binding DelFirstPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32">
                                        <md:PackIcon Kind="PageFirst"/>
                                    </Button>
                                    <Button Command="{Binding DelPreviousPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" IsEnabled="{Binding DelCanGoPrevious}">
                                        <md:PackIcon Kind="ChevronRight"/>
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0" FontSize="12" Text="{Binding DelCurrentPage}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="/" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding DelTotalPages}"/>
                                    <Button Command="{Binding DelNextPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" IsEnabled="{Binding DelCanGoNext}">
                                        <md:PackIcon Kind="ChevronLeft"/>
                                    </Button>
                                    <Button Command="{Binding DelLastPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32">
                                        <md:PackIcon Kind="PageLast"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Performance -->
                <TabItem Header="أداء الموظف">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,12">
                            <controls:AnimatedStatCard Title="إضافات" Value="{Binding PerfAddCount}" Icon="PlusCircle"
                                                       IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="تعديلات" Value="{Binding PerfEditCount}" Icon="Pencil"
                                                       IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="حذف" Value="{Binding PerfDeleteCount}" Icon="Delete"
                                                       IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="إجمالي العمليات" Value="{Binding PerfTotalOps}" Icon="ChartBar"
                                                       IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="مرات الدخول" Value="{Binding PerfLoginCount}" Icon="Login"
                                                       IconBackground="#F3E5F5" IconForeground="#7B1FA2" ValueForeground="#7B1FA2"/>
                        </UniformGrid>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <ComboBox Width="160" Margin="0,0,8,0"
                                      ItemsSource="{Binding PerformanceActionFilters}"
                                      SelectedItem="{Binding SelectedPerformanceAction}"
                                      md:HintAssist.Hint="نوع العملية"
                                      Style="{StaticResource FilledComboBox}"/>
                            <ComboBox Width="180" Margin="0,0,8,0"
                                      ItemsSource="{Binding PerformanceEntityFilters}"
                                      SelectedItem="{Binding SelectedPerformanceEntity}"
                                      md:HintAssist.Hint="نوع الكيان"
                                      Style="{StaticResource FilledComboBox}"/>
                            <ItemsControl ItemsSource="{Binding PerformanceByEntity}" Margin="8,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#ECEFF1" CornerRadius="10" Padding="10,4" Margin="0,0,6,4">
                                            <TextBlock FontSize="11" Foreground="#455A64">
                                                <Run Text="{Binding EntityDisplay}" FontWeight="SemiBold"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Count}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding PerformanceRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource ModernDataGrid}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Width="140" Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Timestamp"/>
                                <DataGridTextColumn Header="العملية" Width="90" Binding="{Binding ActionDisplay}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ActionDisplay"/>
                                <DataGridTextColumn Header="الكيان" Width="140" Binding="{Binding EntityName}"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EntityName"/>
                                <DataGridTextColumn Header="المعرف" Width="80" Binding="{Binding EntityId}"/>
                                <DataGridTemplateColumn Header="تفاصيل" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="عرض" Style="{StaticResource FlatButton}" Height="30" Padding="10,0"
                                                    Command="{Binding DataContext.ShowPerformanceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="3" Background="#FAFBFC" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                BorderThickness="0,1,0,0" Padding="12,8">
                            <Grid>
                                <TextBlock Text="{Binding PerfPaginationInfo}" VerticalAlignment="Center" Foreground="#607D8B" FontSize="12.5"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Command="{Binding PerfFirstPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32">
                                        <md:PackIcon Kind="PageFirst"/>
                                    </Button>
                                    <Button Command="{Binding PerfPreviousPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" IsEnabled="{Binding PerfCanGoPrevious}">
                                        <md:PackIcon Kind="ChevronRight"/>
                                    </Button>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0" FontSize="12" Text="{Binding PerfCurrentPage}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="/" Margin="0,0,4,0"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding PerfTotalPages}"/>
                                    <Button Command="{Binding PerfNextPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" IsEnabled="{Binding PerfCanGoNext}">
                                        <md:PackIcon Kind="ChevronLeft"/>
                                    </Button>
                                    <Button Command="{Binding PerfLastPageCommand}" Style="{StaticResource IconButton}" Width="32" Height="32">
                                        <md:PackIcon Kind="PageLast"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </md:Card>

        <!-- Details overlay -->
        <Border Grid.RowSpan="4" Background="#80000000"
                Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="520" MaxHeight="560" Background="White" CornerRadius="16" Padding="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding DetailsTitle}" FontSize="16" FontWeight="Bold" Foreground="#1565C0" TextWrapping="Wrap"/>
                    <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding DetailsBody}" TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="#37474F"/>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="إغلاق" Command="{Binding CloseDetailsCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Height="38" Padding="20,0"/>
                </Grid>
            </Border>
        </Border>

        <Border Style="{StaticResource PageLoading}" Grid.RowSpan="4"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="40" Height="40"/>
        </Border>
    </Grid>
</UserControl>
