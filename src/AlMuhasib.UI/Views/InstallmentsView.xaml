<UserControl x:Class="AlMuhasib.UI.Views.InstallmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallmentsViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <converters:InstallmentStatusToBrushConverter x:Key="StatusToBrush" />
        <converters:InstallmentStatusToTextConverter x:Key="StatusToText" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- BEAUTIFUL SUMMARY CARDS                        -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,16">
            <UniformGrid Rows="1" Columns="6">
                <!-- Total Plans -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="4" Padding="16,12"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#667eea" Offset="0"/>
                                        <GradientStop Color="#764ba2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="إجمالي الخطط" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SummaryTotalPlans}" FontSize="22" FontWeight="Bold" Foreground="#424242"/>
                    </StackPanel>
                </Border>

                <!-- Total Amount -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="4" Padding="16,12"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1A237E" Offset="0"/>
                                        <GradientStop Color="#283593" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="المبلغ الكلي" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SummaryTotalAmount, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#1A237E"/>
                    </StackPanel>
                </Border>

                <!-- Paid Amount -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="4" Padding="16,12"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="المبلغ المسدد" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SummaryPaidAmount, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Remaining Amount -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="4" Padding="16,12"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource HighlightLightBrush}" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CashMinus" Width="20" Height="20" Foreground="{DynamicResource HighlightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="المبلغ المتبقي" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SummaryRemainingAmount, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Paid Count -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="4" Padding="16,12"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CashCheck" Width="20" Height="20" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="أقساط مسددة" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SummaryPaidCount}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <!-- Overdue Count -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Margin="4" Padding="16,12"
                        BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="36" Height="36" CornerRadius="10" Background="#FFEBEE" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="AlertCircle" Width="20" Height="20" Foreground="#C62828" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="أقساط متأخرة" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SummaryOverdueCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <StackPanel Grid.Row="2">
        <!-- شريط التسديد الجماعي (يظهر عند تحديد أقساط من أي تبويب) -->
        <Border Margin="0,12,0,0"
                Padding="16,12"
                CornerRadius="12"
                Background="#E3F2FD"
                BorderBrush="#90CAF9"
                BorderThickness="1"
                Visibility="{Binding HasBulkSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#1565C0">
                        <Run Text="تسديد جماعي — محدد: " />
                        <Run Text="{Binding BulkSelectedCount, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=" قسط | الإجمالي: " />
                        <Run Text="{Binding BulkSelectedTotalRemaining, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="Bold" />
                        <Run Text=" د.ع" />
                    </TextBlock>
                    <TextBlock Text="{Binding BulkPayMessage}"
                               FontSize="12"
                               Foreground="#C62828"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding BulkPayMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding PaymentCashBoxes}"
                          SelectedItem="{Binding PaymentCashBox}"
                          DisplayMemberPath="Name"
                          materialDesign:HintAssist.Hint="الصندوق"
                          materialDesign:HintAssist.IsFloating="True"
                          Style="{StaticResource FilledComboBox}"
                          FontSize="13"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Command="{Binding PaySelectedInstallmentsCommand}"
                        Style="{StaticResource SuccessButton}"
                        Height="40"
                        Padding="20,0"
                        Margin="12,0,0,0"
                        materialDesign:ButtonAssist.CornerRadius="8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Text="تسديد المحدد" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Click="ClearBulkSelection_Click"
                        Style="{StaticResource FlatButton}"
                        Content="إلغاء التحديد"
                        Height="40"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Margin="0,8,0,0"
                Padding="12,10"
                CornerRadius="10"
                Background="#E8F5E9"
                BorderBrush="#A5D6A7"
                BorderThickness="1"
                Visibility="{Binding CanSendWhatsAppReceipt, Converter={StaticResource BoolToVis}}">
            <Button Command="{Binding SendPaymentReceiptWhatsAppCommand}"
                    Style="{StaticResource OutlinedButton}"
                    Height="40"
                    HorizontalAlignment="Stretch"
                    materialDesign:ButtonAssist.CornerRadius="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Whatsapp" Width="22" Height="22" Foreground="#25D366" VerticalAlignment="Center"/>
                    <TextBlock Text="إرسال إيصال التسديد (PDF) عبر واتساب" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                    Style="{StaticResource ModernTabs}">

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 0: خطط الأقساط الكلية (All Plans)                   -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="خطط الأقساط الكلية" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter bar -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding PaymentCustomers}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding PlansSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      materialDesign:HintAssist.Hint="اسم عميل، فاتورة أو رقم الإضبارة..."
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      FontSize="13"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      behaviors:EnterKeyCommandBehavior.Command="{Binding PlansSearchCommand}" />

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding InstallmentTypeFilters}"
                                      SelectedValue="{Binding SelectedInstallmentTypeFilter}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      materialDesign:HintAssist.Hint="نوع الأقساط"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      Width="140" FontSize="13"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center" />

                            <Button Grid.Column="2"
                                    Command="{Binding PlansSearchCommand}"
                                    Content="بحث"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    FontSize="13" />

                            <controls:ColumnFilterToggle Grid.Column="3"
                                                           IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                           ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                           ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                           TargetDataGrid="{Binding ElementName=AllPlansGrid}"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />

                            <Button Grid.Column="4"
                                    Command="{Binding ExportPlansCommand}"
                                    ToolTip="تصدير Excel"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#2E7D32"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="20" Height="20" />
                            </Button>

                            <Button Grid.Column="5"
                                    Command="{Binding PrintPlansCommand}"
                                    ToolTip="طباعة"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#1565C0"
                                    Width="36" Height="36">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Plans DataGrid -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                        <controls:InstallmentTotalsFooter DockPanel.Dock="Bottom" DataContext="{Binding PlansFooter}"/>
                        <DataGrid x:Name="AllPlansGrid"
                                  ItemsSource="{Binding AllPlans}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العميل" Binding="{Binding Customer.Name}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Customer.Name" />
                                <DataGridTextColumn Header="رقم الإضبارة" Binding="{Binding FileNumber}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="FileNumber" />
                                <DataGridTemplateColumn Header="النوع" Width="80"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InstallmentType">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       Text="{Binding InstallmentType, Converter={StaticResource InstallmentTypeConverter}}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="المبلغ الكلي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="عدد الأقساط" Binding="{Binding NumberOfInstallments}" Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NumberOfInstallments">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="قيمة القسط" Binding="{Binding InstallmentAmount, StringFormat='{}{0:N0} د.ع'}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InstallmentAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="نسبة الشركة" Binding="{Binding CompanyFeeAmount, StringFormat='{}{0:N0} د.ع'}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CompanyFeeAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#4A148C" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat=yyyy/MM/dd}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StartDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding Invoice.InvoiceNumber}" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Invoice.InvoiceNumber">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#1565C0" />
                                            <Setter Property="FontFamily" Value="Consolas" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="إجراءات" Width="220" MinWidth="220"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource TableViewIconButton}"
                                                        Command="{Binding DataContext.ViewPlanDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="عرض التفاصيل">
                                                    <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableEditIconButton}"
                                                        Command="{Binding DataContext.EditPlanInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="تعديل الفاتورة">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TablePrintIconButton}"
                                                        Command="{Binding DataContext.PrintPlanInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="طباعة الفاتورة">
                                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableDeleteIconButton}"
                                                        Command="{Binding DataContext.DeletePlanInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="حذف الفاتورة">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        <controls:PaginationBar Grid.Row="1" DataContext="{Binding PlansPager}"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 1: غير المسددات (Overdue)                        -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#C62828" />
                        <TextBlock Text="غير المسددات" FontSize="13" VerticalAlignment="Center" />
                        <Border Background="#C62828" CornerRadius="10" Padding="6,2" Margin="6,0,0,0"
                                Visibility="{Binding OverdueCount, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding OverdueCount}" Foreground="White" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="10" Padding="16,10" Margin="0,0,0,12"
                                         Background="#FFEBEE" materialDesign:ElevationAssist.Elevation="Dp0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Width="22" Height="22" Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock FontSize="14" Foreground="#B71C1C" VerticalAlignment="Center">
                                <Run Text="يوجد" />
                                <Run Text="{Binding OverdueCount, Mode=OneWay}" FontWeight="Bold" />
                                <Run Text="قسط متأخر عن موعد الاستحقاق" />
                            </TextBlock>
                            <Button Command="{Binding LoadOverdueCommand}"
                                    Content="تحديث"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="#C62828"
                                    Height="30"
                                    Margin="16,0,0,0"
                                    FontSize="12" />
                            <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                           ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                           ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                           TargetDataGrid="{Binding ElementName=OverdueInstallmentsGrid}"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />
                            <Button Command="{Binding PrintOverdueCommand}"
                                    ToolTip="طباعة"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#1565C0"
                                    Width="32" Height="32"
                                    Margin="8,0,0,0">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Overdue DataGrid -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="حدّد عدة أقساط (Ctrl+نقر) ثم استخدم «تسديد المحدد» في الأسفل"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,8,12,4" />

                        <DataGrid x:Name="OverdueInstallmentsGrid"
                                  DockPanel.Dock="Top"
                                  ItemsSource="{Binding OverdueInstallments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  SelectionChanged="PayableInstallmentsGrid_SelectionChanged"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FFCDD2"
                                  RowHeight="48"
                                  FontSize="13"
                                  Background="{DynamicResource CardBrush}"
                                  BorderThickness="0"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  materialDesign:DataGridAssist.CellPadding="12 6"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العميل" Binding="{Binding InstallmentPlan.Customer.Name}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InstallmentPlan.Customer.Name" />
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#C62828" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#C62828" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="تسديد" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.PayOverdueInstallmentCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Height="28"
                                                    Padding="10,0"
                                                    materialDesign:ButtonAssist.CornerRadius="6"
                                                    FontSize="11">
                                                <TextBlock Text="تسديد" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:InstallmentTotalsFooter DockPanel.Dock="Bottom" DataContext="{Binding OverdueFooter}"/>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 2: تسديد الأقساط (Payment)                        -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashCheck" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="تسديد الأقساط" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                    <StackPanel>
                        <!-- Customer Search -->
                        <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding FilteredPaymentCustomers}"
                                          SelectedItem="{Binding PaymentSelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Name"
                                          Text="{Binding PaymentCustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False"
                                          StaysOpenOnEdit="True"
                                          materialDesign:HintAssist.Hint="اختر العميل أو ابحث بالاسم..."
                                          materialDesign:HintAssist.IsFloating="True"
                                          materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                          Style="{StaticResource FilledComboBox}"
                                          FontSize="14"
                                          Margin="0,0,12,0"
                                          behaviors:EnterKeyCommandBehavior.Command="{Binding SearchCustomerPlansCommand}" />

                                <Button Grid.Column="1"
                                        Command="{Binding SearchCustomerPlansCommand}"
                                        Content="عرض الأقساط"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="40"
                                        Padding="20,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        FontSize="14" />
                            </Grid>
                        </materialDesign:Card>

                        <!-- Plans List -->
                        <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="16" Margin="0,0,0,16"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock Text="خطط الأقساط" FontSize="14" FontWeight="SemiBold" Foreground="#424242" VerticalAlignment="Center" />
                                    <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                                 TargetDataGrid="{Binding ElementName=CustomerPlansGrid}"
                                                                 Margin="4,0,0,0"
                                                                 VerticalAlignment="Center" />
                                </StackPanel>

                                <DataGrid x:Name="CustomerPlansGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding CustomerPlans}"
                                          SelectedItem="{Binding PaymentSelectedPlan}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Single"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F0F0F0"
                                          RowHeight="40"
                                          MaxHeight="200"
                                          FontSize="12"
                                          Background="{DynamicResource CardBrush}"
                                          BorderThickness="0"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="10 6"
                                          materialDesign:DataGridAssist.CellPadding="10 4"
                                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding Invoice.InvoiceNumber}" Width="140"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Invoice.InvoiceNumber" />
                                        <DataGridTextColumn Header="المبلغ الكلي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0} د.ع'}" Width="130"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalAmount" />
                                        <DataGridTextColumn Header="عدد الأقساط" Binding="{Binding NumberOfInstallments}" Width="90"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NumberOfInstallments" />
                                        <DataGridTextColumn Header="رقم الإضبارة" Binding="{Binding FileNumber}" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="FileNumber" />
                                        <DataGridTextColumn Header="تاريخ البداية" Binding="{Binding StartDate, StringFormat=yyyy/MM/dd}" Width="110"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StartDate" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Installments for selected plan -->
                        <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="16" Margin="0,0,0,16"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#424242" VerticalAlignment="Center">
                                        <Run Text="تفاصيل الأقساط" />
                                        <Run Text=" — حدّد عدة صفوف للتسديد الجماعي" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    </TextBlock>
                                    <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                                 TargetDataGrid="{Binding ElementName=PlanInstallmentsGrid}"
                                                                 Margin="4,0,0,0"
                                                                 VerticalAlignment="Center" />
                                </StackPanel>

                                <DockPanel Grid.Row="1">
                                <controls:InstallmentTotalsFooter DockPanel.Dock="Bottom" DataContext="{Binding PaymentFooter}"/>
                                <DataGrid x:Name="PlanInstallmentsGrid"
                                          ItemsSource="{Binding PlanInstallments}"
                                          SelectedItem="{Binding PaymentSelectedInstallment}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          SelectionMode="Extended"
                                          SelectionChanged="PayableInstallmentsGrid_SelectionChanged"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F0F0F0"
                                          RowHeight="40"
                                          MaxHeight="260"
                                          FontSize="12"
                                          Background="{DynamicResource CardBrush}"
                                          BorderThickness="0"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="10 6"
                                          materialDesign:DataGridAssist.CellPadding="10 4"
                                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate" />
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount" />
                                        <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount" />
                                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#C62828" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="الحالة" Width="100"
                                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </DockPanel>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Payment Form -->
                        <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                                             Background="#E8F5E9" materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                         materialDesign:HintAssist.Hint="مبلغ التسديد"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="16"
                                         FontWeight="Bold"
                                         Foreground="#2E7D32"
                                         Margin="0,0,12,0" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding PaymentCashBoxes}"
                                          SelectedItem="{Binding PaymentCashBox}"
                                          DisplayMemberPath="Name"
                                          materialDesign:HintAssist.Hint="الصندوق"
                                          materialDesign:HintAssist.IsFloating="True"
                                          materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                          Style="{StaticResource FilledComboBox}"
                                          FontSize="14"
                                          Margin="0,0,12,0" />

                                <Button Grid.Column="2"
                                        Command="{Binding PayInstallmentCommand}"
                                        Style="{StaticResource SuccessButton}"
                                        Height="44"
                                        Padding="24,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        FontSize="15"
                                        FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashCheck" Width="22" Height="22" VerticalAlignment="Center" />
                                        <TextBlock Text="تسديد" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </materialDesign:Card>

                        <!-- Payment Message -->
                        <TextBlock Text="{Binding PaymentMessage}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaymentSuccess}" Value="True">
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PaymentMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Command="{Binding SendPaymentReceiptWhatsAppCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="42"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                Visibility="{Binding CanSendWhatsAppReceipt, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Whatsapp" Width="20" Height="20" Foreground="#25D366" VerticalAlignment="Center"/>
                                <TextBlock Text="إرسال إيصال واتساب (PDF)" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 3: عرض تفصيلي مفصل (Detailed)                    -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentMultipleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="عرض مفصل" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding PaymentCustomers}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      Text="{Binding DetailedSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      materialDesign:HintAssist.Hint="اسم عميل، فاتورة أو رقم الإضبارة..."
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      FontSize="13"
                                      Margin="0,0,12,0"
                                      behaviors:EnterKeyCommandBehavior.Command="{Binding SearchDetailedPlansCommand}" />

                            <Button Grid.Column="1"
                                    Command="{Binding SearchDetailedPlansCommand}"
                                    Content="بحث"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="36"
                                    Padding="16,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    FontSize="13"
                                    Margin="0,0,8,0" />

                            <controls:ColumnFilterToggle Grid.Column="2"
                                                           IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                           ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                           ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                           TargetDataGrid="{Binding ElementName=DetailedInstallmentsGrid}"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Command="{Binding PrintDetailedCommand}"
                                    ToolTip="طباعة الخطة المحددة"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#1565C0"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" />
                            </Button>

                            <Button Grid.Column="4"
                                    Command="{Binding PrintAllDetailedPlansCommand}"
                                    ToolTip="طباعة كل فواتير العميل"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#2E7D32"
                                    Width="36" Height="36">
                                <materialDesign:PackIcon Kind="PrinterPos" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Plans selector -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" UniformCornerRadius="12" Padding="16" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="جدول الأقساط - اختر خطة أقساط للعميل" FontSize="14" FontWeight="SemiBold" Foreground="#424242" VerticalAlignment="Center" />
                                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                             TargetDataGrid="{Binding ElementName=DetailedPlansGrid}"
                                                             Margin="4,0,0,0"
                                                             VerticalAlignment="Center" />
                            </StackPanel>

                            <DataGrid x:Name="DetailedPlansGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding DetailedPlans}"
                                      SelectedItem="{Binding DetailedSelectedPlan}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F0F0F0"
                                      RowHeight="40"
                                      MaxHeight="180"
                                      FontSize="12"
                                      Background="{DynamicResource CardBrush}"
                                      BorderThickness="0"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="10 6"
                                      materialDesign:DataGridAssist.CellPadding="10 4"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding Customer.Name}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Customer.Name" />
                                    <DataGridTextColumn Header="المبلغ الكلي" Binding="{Binding TotalAmount, StringFormat='{}{0:N0}'}" Width="120"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalAmount" />
                                    <DataGridTextColumn Header="عدد الأقساط" Binding="{Binding NumberOfInstallments}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NumberOfInstallments" />
                                    <DataGridTextColumn Header="رقم الإضبارة" Binding="{Binding FileNumber}" Width="120"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="FileNumber" />
                                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding Invoice.InvoiceNumber}" Width="140"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Invoice.InvoiceNumber" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Detailed installments -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="حدّد عدة أقساط غير مسددة (Ctrl+نقر) للتسديد الجماعي"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,8,12,4" />

                        <DataGrid x:Name="DetailedInstallmentsGrid"
                                  ItemsSource="{Binding DetailedInstallments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  SelectionChanged="PayableInstallmentsGrid_SelectionChanged"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowHeight="44"
                                  FontSize="13"
                                  Background="{DynamicResource CardBrush}"
                                  BorderThickness="0"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  materialDesign:DataGridAssist.CellPadding="12 6"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} د.ع'}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="الحالة" Width="120"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                    CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="تاريخ التسديد" Binding="{Binding PaymentDate, StringFormat=yyyy/MM/dd}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الصندوق" Binding="{Binding CashBox.Name}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CashBox.Name" />
                                <DataGridTemplateColumn Header="إجراء" Width="180"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.PayDetailedInstallmentCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SuccessButton}"
                                                        Height="26" Padding="10,0"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        FontSize="11" Margin="0,0,4,0"
                                                        Visibility="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=ShowPay}">
                                                    <TextBlock Text="تسديد"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.CancelDetailedInstallmentCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Height="26" Padding="10,0"
                                                        materialDesign:ButtonAssist.CornerRadius="6"
                                                        FontSize="11" Background="#FFEBEE" Foreground="#C62828"
                                                        BorderThickness="0">
                                                    <TextBlock Text="إلغاء التسديد"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:InstallmentTotalsFooter DockPanel.Dock="Bottom" DataContext="{Binding DetailedFooter}"/>
                        </DockPanel>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 4: تمت التسوية (Paid)                               -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#2E7D32" />
                        <TextBlock Text="تمت التسوية" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding PaidSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم عميل للبحث..."
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource FilledTextBox}"
                                     FontSize="13"
                                     Margin="0,0,12,0" />

                            <Button Grid.Column="1"
                                    Command="{Binding PaidSearchCommand}"
                                    Content="بحث"
                                    Style="{StaticResource SuccessButton}"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    FontSize="13" />

                            <controls:ColumnFilterToggle Grid.Column="2"
                                                           IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                           ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                           ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                           TargetDataGrid="{Binding ElementName=PaidInstallmentsGrid}"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Command="{Binding ExportPaidCommand}"
                                    ToolTip="تصدير Excel"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#2E7D32"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="20" Height="20" />
                            </Button>

                            <Button Grid.Column="4"
                                    Command="{Binding PrintPaidCommand}"
                                    ToolTip="طباعة"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#1565C0"
                                    Width="36" Height="36">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Paid DataGrid -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                        <controls:InstallmentTotalsFooter DockPanel.Dock="Bottom" DataContext="{Binding PaidFooter}"/>
                        <DataGrid x:Name="PaidInstallmentsGrid"
                                  ItemsSource="{Binding PaidInstallments}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Single"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العميل" Binding="{Binding InstallmentPlan.Customer.Name}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InstallmentPlan.Customer.Name" />
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="تاريخ التسديد" Binding="{Binding PaymentDate, StringFormat=yyyy/MM/dd}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الصندوق" Binding="{Binding CashBox.Name}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CashBox.Name" />
                                <DataGridTemplateColumn Header="إجراء" Width="110"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.CancelPaidInstallmentCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Height="26" Padding="10,0"
                                                    materialDesign:ButtonAssist.CornerRadius="6"
                                                    FontSize="11" Background="#FFEBEE" Foreground="#C62828"
                                                    BorderThickness="0">
                                                <TextBlock Text="إلغاء التسديد"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        </DockPanel>
                        <controls:PaginationBar Grid.Row="1" DataContext="{Binding PaidPager}"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 5: لم تتم التسوية (Unpaid)                         -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockAlertOutline" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource HighlightBrush}" />
                        <TextBlock Text="لم تتم التسوية" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="12" Padding="16,12" Margin="0,0,0,12"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding UnpaidSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم عميل للبحث..."
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource FilledTextBox}"
                                     FontSize="13"
                                     Margin="0,0,12,0" />

                            <Button Grid.Column="1"
                                    Command="{Binding UnpaidSearchCommand}"
                                    Content="بحث"
                                    Style="{StaticResource PrimaryButton}"
                                    Background="{DynamicResource HighlightBrush}"
                                    Foreground="White"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="8"
                                    FontSize="13" />

                            <controls:ColumnFilterToggle Grid.Column="2"
                                                           IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                           ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                           ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                           TargetDataGrid="{Binding ElementName=UnpaidInstallmentsGrid}"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center" />

                            <Button Grid.Column="3"
                                    Command="{Binding ExportUnpaidCommand}"
                                    ToolTip="تصدير Excel"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#2E7D32"
                                    Width="36" Height="36"
                                    Margin="0,0,4,0">
                                <materialDesign:PackIcon Kind="FileExcelOutline" Width="20" Height="20" />
                            </Button>

                            <Button Grid.Column="4"
                                    Command="{Binding PrintUnpaidCommand}"
                                    ToolTip="طباعة"
                                    Style="{StaticResource IconButton}"
                                    Foreground="#1565C0"
                                    Width="36" Height="36">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" />
                            </Button>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Unpaid DataGrid -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="حدّد عدة أقساط (Ctrl+نقر) ثم استخدم «تسديد المحدد» في الأسفل"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,8,12,4" />
                        <DataGrid x:Name="UnpaidInstallmentsGrid"
                                  ItemsSource="{Binding UnpaidInstallments}"
                                  Style="{StaticResource ModernDataGrid}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  SelectionMode="Extended"
                                  SelectionChanged="PayableInstallmentsGrid_SelectionChanged"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العميل" Binding="{Binding InstallmentPlan.Customer.Name}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InstallmentPlan.Customer.Name" />
                                <DataGridTemplateColumn Header="الحالة" Width="110"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                    CornerRadius="10" Padding="8,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource StatusToText}}"
                                                           Foreground="White"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat='{}{0:N0} د.ع'}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="إجراء" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.PayUnpaidInstallmentCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource SuccessButton}"
                                                    Height="26" Padding="10,0"
                                                    materialDesign:ButtonAssist.CornerRadius="6"
                                                    FontSize="11">
                                                <TextBlock Text="تسديد"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:InstallmentTotalsFooter DockPanel.Dock="Bottom" DataContext="{Binding UnpaidFooter}"/>
                        </DockPanel>
                        <controls:PaginationBar Grid.Row="1" DataContext="{Binding UnpaidPager}"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- LOADING OVERLAY -->
        <Border Grid.RowSpan="3" Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جاري التحميل..."
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
