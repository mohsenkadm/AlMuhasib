<UserControl x:Class="AlMuhasib.UI.Views.WorkSummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WorkSummaryReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="ملخص العمل" FontSize="24" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBlock Text="نظرة شاملة على المبيعات والعملاء ونشاط ساعات العمل"
                           FontSize="13" Foreground="#78909C" Margin="0,0,0,18"/>

                <UniformGrid Columns="5" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="عملاء جدد"
                        TextValue="{Binding NewCustomersCount}"
                        Icon="AccountPlus"
                        IconBackground="#E0F2F1"
                        IconForeground="#00695C"
                        ValueForeground="#00695C"/>
                    <controls:AnimatedStatCard
                        Title="قيمة المبيعات"
                        TextValue="{Binding TotalSalesAmount}"
                        Icon="CashRegister"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="عدد التعاملات"
                        TextValue="{Binding DealCount}"
                        Icon="SwapHorizontal"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="عدد الأصناف"
                        TextValue="{Binding DistinctProductCount}"
                        Icon="PackageVariant"
                        IconBackground="#FFF3E0"
                        IconForeground="#EF6C00"
                        ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard
                        Title="كمية الأصناف"
                        TextValue="{Binding TotalProductQuantity}"
                        Icon="Counter"
                        IconBackground="#F3E5F5"
                        IconForeground="#6A1B9A"
                        ValueForeground="#6A1B9A"/>
                </UniformGrid>

                <controls:ChartCard Title="المبيعات على مر السنين" Margin="0,0,0,12">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding SalesByYearSeries}"
                                            XAxes="{Binding SalesByYearXAxes}"
                                            YAxes="{Binding SalesByYearYAxes}"
                                            Height="280"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <controls:ChartCard Title="أكثر العملاء مبيعاً" Margin="0,0,8,0">
                        <controls:ChartCard.ChartContent>
                            <lvc:CartesianChart Series="{Binding TopCustomersSeries}"
                                                XAxes="{Binding TopCustomersXAxes}"
                                                YAxes="{Binding TopCustomersYAxes}"
                                                Height="280"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                    <controls:ChartCard Title="أكثر ساعات عملاً في النظام" Margin="8,0,0,0">
                        <controls:ChartCard.ChartContent>
                            <lvc:CartesianChart Series="{Binding BusiestHoursSeries}"
                                                XAxes="{Binding BusiestHoursXAxes}"
                                                YAxes="{Binding BusiestHoursYAxes}"
                                                Height="280"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="تحديث" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="نشاط الساعات"
                                             TargetDataGrid="{Binding ElementName=WorkSummaryGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="WorkSummaryGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="220"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                          Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الساعة" Binding="{Binding HourLabel}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="HourLabel"/>
                        <DataGridTextColumn Header="عدد التعاملات" Binding="{Binding ActivityCount}" Width="140"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ActivityCount"/>
                        <DataGridTextColumn Header="قيمة المبيعات" Binding="{Binding SalesAmount, StringFormat=N0}" Width="160"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SalesAmount"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
