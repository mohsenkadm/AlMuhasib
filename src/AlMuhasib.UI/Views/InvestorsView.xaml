<UserControl x:Class="AlMuhasib.UI.Views.InvestorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                Style="{StaticResource ModernTabs}"
                md:ColorZoneAssist.Mode="PrimaryMid"
                TabStripPlacement="Top">

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 0: INVESTOR LIST -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="AccountGroup" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="إدارة المستثمرين" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add/Edit form card -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="إضافة مستثمر جديد"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="تعديل بيانات المستثمر"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" md:HintAssist.Hint="اسم المستثمر"
                                     Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="رقم الهاتف"
                                     Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                            <TextBox Grid.Column="4" md:HintAssist.Hint="نسبة الربح %"
                                     Text="{Binding FormProfitPercentage, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button Command="{Binding SaveInvestorCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="إضافة"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Text" Value="حفظ التعديل"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                            <Button Content="إلغاء" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="تصدير Excel" Command="{Binding ExportInvestorsCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    md:ButtonAssist.CornerRadius="8" Margin="16,0,0,0">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="FileExcelOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="تصدير Excel" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Investor DataGrid -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,10">
                            <TextBlock Text="إدارة المستثمرين" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Investors}"
                                  SelectedItem="{Binding SelectedInvestor}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="إجمالي الإيداعات" Binding="{Binding TotalDeposit, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="نسبة الربح %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="إجمالي الأرباح" Binding="{Binding TotalProfitsEarned, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatButton}"
                                                    Command="{Binding DataContext.EditInvestorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    ToolTip="تعديل" Padding="4">
                                                <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 1: DEPOSIT -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="CashPlus" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="إيداع مبلغ" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Deposit form -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="إيداع مبلغ جديد" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="المستثمر"
                                      ItemsSource="{Binding InvestorsList}"
                                      SelectedItem="{Binding DepositInvestor}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="المبلغ"
                                     Text="{Binding DepositAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                            <DatePicker Grid.Column="4" md:HintAssist.Hint="تاريخ العملية"
                                        SelectedDate="{Binding DepositDate}"
                                        Style="{StaticResource FilledDatePicker}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="الصندوق"
                                      ItemsSource="{Binding CashBoxes}"
                                      SelectedItem="{Binding DepositCashBox}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="ملاحظات"
                                     Text="{Binding DepositNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </Grid>

                        <Button Grid.Row="3" HorizontalAlignment="Left"
                                Content="تأكيد الإيداع" Command="{Binding SubmitDepositCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                    </Grid>
                </md:Card>

                <!-- Recent deposits -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#1976D2" Padding="16,10">
                            <TextBlock Text="آخر عمليات الإيداع" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentDeposits}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding Investor.Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 2: WITHDRAWAL -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="CashMinus" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="سحب مبلغ" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Withdrawal form -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="سحب مبلغ من رصيد" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="المستثمر"
                                      ItemsSource="{Binding InvestorsList}"
                                      SelectedItem="{Binding WithdrawInvestor}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="المبلغ"
                                     Text="{Binding WithdrawAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                            <DatePicker Grid.Column="4" md:HintAssist.Hint="التاريخ"
                                        SelectedDate="{Binding WithdrawDate}"
                                        Style="{StaticResource FilledDatePicker}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="الصندوق"
                                      ItemsSource="{Binding CashBoxes}"
                                      SelectedItem="{Binding WithdrawCashBox}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="ملاحظات"
                                     Text="{Binding WithdrawNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </Grid>

                        <!-- Max withdrawal info -->
                        <TextBlock Grid.Row="3" Text="{Binding WithdrawMaxInfo}"
                                   FontSize="13" Foreground="#F57C00" FontWeight="SemiBold"
                                   Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WithdrawMaxInfo}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Row="4" HorizontalAlignment="Left"
                                Content="تأكيد السحب" Command="{Binding SubmitWithdrawalCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                    </Grid>
                </md:Card>

                <!-- Recent withdrawals -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E65100" Padding="16,10">
                            <TextBlock Text="آخر عمليات السحب" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentWithdrawals}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding Investor.Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 3: PROFIT DISTRIBUTION -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="CurrencyUsd" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="توزيع الأرباح" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Distribution controls -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="توزيع أرباح المستثمرين" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0" md:HintAssist.Hint="تاريخ التوزيع"
                                        SelectedDate="{Binding DistributionDate}"
                                        Style="{StaticResource FilledDatePicker}"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="الأرباح القابلة:" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="{Binding DistributableProfits, StringFormat=N0}"
                                           FontWeight="Bold" FontSize="16" Foreground="#388E3C"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="معاينة التوزيع"
                                    Command="{Binding PreviewDistributionCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                        </Grid>
                    </Grid>
                </md:Card>

                <!-- Preview DataGrid -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#388E3C" Padding="16,10">
                            <Grid>
                                <TextBlock Text="معاينة التوزيع" FontSize="15" FontWeight="Bold" Foreground="White"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Left"
                                        Command="{Binding PrintDistributionPreviewCommand}"
                                        ToolTip="طباعة المعاينة"
                                        Style="{StaticResource FlatButton}"
                                        Foreground="White" Padding="4">
                                    <md:PackIcon Kind="Printer"/>
                                </Button>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ProfitPreviews}"
                                  AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding InvestorName}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الإيداعات الكلية" Binding="{Binding TotalDeposit, StringFormat=N0}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الإيداعات المؤهلة" Binding="{Binding EligibleDeposit, StringFormat=N0}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="النسبة %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الربح" Binding="{Binding ProfitAmount, StringFormat=N0}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>

                <!-- Confirm bar -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="16" Margin="0,12,0,0" md:ElevationAssist.Elevation="Dp1"
                         Visibility="{Binding IsPreviewReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي التوزيع:" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalToDistribute, StringFormat=N0}"
                                       FontWeight="Bold" FontSize="18" Foreground="#388E3C"
                                       VerticalAlignment="Center" Margin="0,0,24,0"/>
                            <ComboBox md:HintAssist.Hint="الصندوق"
                                      ItemsSource="{Binding CashBoxes}"
                                      SelectedItem="{Binding DistributionCashBox}"
                                      DisplayMemberPath="Name" Width="200"
                                      Style="{StaticResource FilledComboBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="إعادة الحساب" Command="{Binding RecalculateTotalCommand}"
                                    Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                            <Button Content="تأكيد التوزيع" Command="{Binding ConfirmDistributionCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8"
                                    Background="#388E3C"/>
                        </StackPanel>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 4: PROFIT STATEMENT -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="ChartLine" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="كشف الأرباح" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Investor selector + summary -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="كشف أرباح المستثمر" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="اختر المستثمر"
                                      ItemsSource="{Binding InvestorsList}"
                                      SelectedItem="{Binding StatementInvestor}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="رصيد الإيداع:" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatementCurrentDeposit, StringFormat=N0}"
                                           FontWeight="Bold" FontSize="15" Foreground="#1976D2"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي الأرباح:" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatementTotalProfits, StringFormat=N0}"
                                           FontWeight="Bold" FontSize="15" Foreground="#388E3C"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="6" Command="{Binding PrintStatementCommand}"
                                    ToolTip="طباعة" Style="{StaticResource PrimaryButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="8">
                                <md:PackIcon Kind="Printer"/>
                            </Button>
                            <Button Grid.Column="8" Command="{Binding ExportStatementCommand}"
                                    ToolTip="تصدير Excel" Style="{StaticResource PrimaryButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="8">
                                <md:PackIcon Kind="FileExcelOutline"/>
                            </Button>
                        </Grid>
                    </Grid>
                </md:Card>

                <!-- Statement DataGrid -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#388E3C" Padding="16,10">
                            <TextBlock Text="كشف الأرباح التفصيلي" FontSize="15" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding StatementDetails}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاريخ التوزيع" Binding="{Binding ProfitDistribution.Date, StringFormat=yyyy/MM/dd}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="نسبة الربح %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="إجمالي التوزيع الشهري" Binding="{Binding ProfitDistribution.DistributedAmount, StringFormat=N0}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
