<UserControl x:Class="AlMuhasib.UI.Views.InvestorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <helpers:CustomFieldSlotConverter x:Key="CustomFieldSlotConverter"/>
    </UserControl.Resources>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                Style="{StaticResource ModernTabs}"
                md:ColorZoneAssist.Mode="PrimaryMid"
                TabStripPlacement="Top">

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 0: INVESTOR LIST -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="AccountGroup" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="إدارة المستثمرين" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Add/Edit form card -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="إضافة مستثمر جديد"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="Text" Value="تعديل بيانات المستثمر"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" md:HintAssist.Hint="اسم المستثمر"
                                     Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="رقم الهاتف"
                                     Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                            <TextBox Grid.Column="4" md:HintAssist.Hint="نسبة الربح %"
                                     Text="{Binding FormProfitPercentage, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </Grid>

                        <controls:CustomFieldsEditor Grid.Row="2" Items="{Binding EditCustomFields}" Margin="0,0,0,12"
                                                     Visibility="{Binding HasCustomFields, Converter={StaticResource BoolVis}}"/>

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Button Command="{Binding SaveInvestorCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0">
                                <Button.Content>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="إضافة"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Text" Value="حفظ التعديل"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button.Content>
                            </Button>
                            <Button Content="إلغاء" Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Investor DataGrid -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="قائمة المستثمرين"
                                                     TargetDataGrid="{Binding ElementName=InvestorsGrid}"
                                                     ExportCommand="{Binding ExportInvestorsCommand}"
                                                     PrintCommand="{Binding PrintTableCommand}"
                                                     ShowCardToggle="True"
                                                     ShowFilter="False"/>

                        <Grid Grid.Row="1">
                        <DataGrid x:Name="InvestorsGrid"
                                  ItemsSource="{Binding Investors}"
                                  SelectedItem="{Binding SelectedInvestor}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  SelectionMode="Single" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ModernDataGrid}"
                                  Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="إجمالي الإيداعات" Binding="{Binding TotalDeposit, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="نسبة الربح %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="إجمالي الأرباح" Binding="{Binding TotalProfitsEarned, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="" Width="Auto">
                                    
                                <DataGridTextColumn x:Name="ColCf1" Header="حقل 1" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=1}"/>
                                <DataGridTextColumn x:Name="ColCf2" Header="حقل 2" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=2}"/>
                                <DataGridTextColumn x:Name="ColCf3" Header="حقل 3" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=3}"/>
                                <DataGridTextColumn x:Name="ColCf4" Header="حقل 4" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=4}"/>
                                <DataGridTextColumn x:Name="ColCf5" Header="حقل 5" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=5}"/>
                                <DataGridTextColumn x:Name="ColCf6" Header="حقل 6" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=6}"/>
                                <DataGridTextColumn x:Name="ColCf7" Header="حقل 7" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=7}"/>
                                <DataGridTextColumn x:Name="ColCf8" Header="حقل 8" Width="100" Visibility="Collapsed"
                                                    Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=8}"/>

<DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FlatButton}"
                                                    Command="{Binding DataContext.EditInvestorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="تعديل" Padding="4">
                                                <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                                          Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding Investors}"
                                                ItemTemplate="{StaticResource InvestorCardTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 1: DEPOSIT -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="CashPlus" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="إيداع مبلغ" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Deposit form -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="إيداع مبلغ جديد" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="المستثمر"
                                      ItemsSource="{Binding InvestorsList}"
                                      SelectedItem="{Binding DepositInvestor}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="المبلغ"
                                     Text="{Binding DepositAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericTextBox}"/>
                            <DatePicker Grid.Column="4" md:HintAssist.Hint="تاريخ العملية"
                                        SelectedDate="{Binding DepositDate}"
                                        Style="{StaticResource FilledDatePicker}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="الصندوق"
                                      ItemsSource="{Binding CashBoxes}"
                                      SelectedItem="{Binding DepositCashBox}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="ملاحظات"
                                     Text="{Binding DepositNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </Grid>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تأكيد الإيداع" Command="{Binding SubmitDepositCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                            <Button Command="{Binding SendPendingWhatsAppReceiptCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="36" Padding="16,0" Margin="12,0,0,0"
                                    md:ButtonAssist.CornerRadius="8"
                                    Visibility="{Binding CanSendWhatsAppReceipt, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="إرسال إيصال الإيداع عبر واتساب">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Whatsapp" Width="18" Height="18" Foreground="#25D366" VerticalAlignment="Center"/>
                                    <TextBlock Text="واتساب" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Recent deposits -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="آخر عمليات الإيداع"
                                                     TargetDataGrid="{Binding ElementName=RecentDepositsGrid}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowPrint="False"
                                                     ShowFilter="False"/>
                        <DataGrid x:Name="RecentDepositsGrid" Grid.Row="1" ItemsSource="{Binding RecentDeposits}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding Investor.Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="واتساب" Width="70"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TableWhatsAppIconButton}"
                                                    Command="{Binding DataContext.SendTransactionWhatsAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <md:PackIcon Kind="Whatsapp" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 2: WITHDRAWAL -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="CashMinus" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="سحب مبلغ" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Withdrawal form -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="سحب مبلغ من رصيد" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="المستثمر"
                                      ItemsSource="{Binding InvestorsList}"
                                      SelectedItem="{Binding WithdrawInvestor}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="المبلغ"
                                     Text="{Binding WithdrawAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericTextBox}"/>
                            <DatePicker Grid.Column="4" md:HintAssist.Hint="التاريخ"
                                        SelectedDate="{Binding WithdrawDate}"
                                        Style="{StaticResource FilledDatePicker}"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="الصندوق"
                                      ItemsSource="{Binding CashBoxes}"
                                      SelectedItem="{Binding WithdrawCashBox}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>
                            <TextBox Grid.Column="2" md:HintAssist.Hint="ملاحظات"
                                     Text="{Binding WithdrawNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </Grid>

                        <!-- Max withdrawal info -->
                        <TextBlock Grid.Row="3" Text="{Binding WithdrawMaxInfo}"
                                   FontSize="13" Foreground="#7E57C2" FontWeight="SemiBold"
                                   Margin="0,0,0,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WithdrawMaxInfo}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تأكيد السحب" Command="{Binding SubmitWithdrawalCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                            <Button Command="{Binding SendPendingWhatsAppReceiptCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="36" Padding="16,0" Margin="12,0,0,0"
                                    md:ButtonAssist.CornerRadius="8"
                                    Visibility="{Binding CanSendWhatsAppReceipt, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="إرسال إيصال السحب عبر واتساب">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Whatsapp" Width="18" Height="18" Foreground="#25D366" VerticalAlignment="Center"/>
                                    <TextBlock Text="واتساب" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Recent withdrawals -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="آخر عمليات السحب"
                                                     TargetDataGrid="{Binding ElementName=RecentWithdrawalsGrid}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowPrint="False"
                                                     ShowFilter="False"/>
                        <DataGrid x:Name="RecentWithdrawalsGrid" Grid.Row="1" ItemsSource="{Binding RecentWithdrawals}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding Investor.Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="واتساب" Width="70"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TableWhatsAppIconButton}"
                                                    Command="{Binding DataContext.SendTransactionWhatsAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <md:PackIcon Kind="Whatsapp" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 3: PROFIT DISTRIBUTION -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="CurrencyUsd" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="توزيع الأرباح" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Distribution controls -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="توزيع أرباح المستثمرين" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker Grid.Column="0" md:HintAssist.Hint="تاريخ التوزيع"
                                        SelectedDate="{Binding DistributionDate}"
                                        Style="{StaticResource FilledDatePicker}"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="الأرباح القابلة:" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center" FontSize="14"/>
                                <TextBlock Text="{Binding DistributableProfits, StringFormat=N0}"
                                           FontWeight="Bold" FontSize="16" Foreground="#388E3C"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="4" Content="معاينة التوزيع"
                                    Command="{Binding PreviewDistributionCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                        </Grid>
                    </Grid>
                </md:Card>

                <!-- Preview DataGrid -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="معاينة التوزيع"
                                                     TargetDataGrid="{Binding ElementName=ProfitPreviewsGrid}"
                                                     PrintCommand="{Binding PrintDistributionPreviewCommand}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowFilter="False"/>

                        <DataGrid x:Name="ProfitPreviewsGrid" Grid.Row="1" ItemsSource="{Binding ProfitPreviews}"
                                  AutoGenerateColumns="False" IsReadOnly="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding InvestorName}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الإيداعات الكلية" Binding="{Binding TotalDeposit, StringFormat=N0}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الإيداعات المؤهلة" Binding="{Binding EligibleDeposit, StringFormat=N0}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="النسبة %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الربح" Binding="{Binding ProfitAmount, StringFormat=N0}" Width="140" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="واتساب" Width="70" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TableWhatsAppIconButton}"
                                                    Command="{Binding DataContext.SendProfitPreviewWhatsAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <md:PackIcon Kind="Whatsapp" Width="18" Height="18"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>

                <!-- Confirm bar -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="16" Margin="0,12,0,0" md:ElevationAssist.Elevation="Dp1"
                         Visibility="{Binding IsPreviewReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي التوزيع:" FontWeight="SemiBold" FontSize="14"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalToDistribute, StringFormat=N0}"
                                       FontWeight="Bold" FontSize="18" Foreground="#388E3C"
                                       VerticalAlignment="Center" Margin="0,0,24,0"/>
                            <ComboBox md:HintAssist.Hint="الصندوق"
                                      ItemsSource="{Binding CashBoxes}"
                                      SelectedItem="{Binding DistributionCashBox}"
                                      DisplayMemberPath="Name" Width="200"
                                      Style="{StaticResource FilledComboBox}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Content="إعادة الحساب" Command="{Binding RecalculateTotalCommand}"
                                    Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                            <Button Content="تأكيد التوزيع" Command="{Binding ConfirmDistributionCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8"
                                    Background="#388E3C"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="10"
                        Background="#E8F8EF" BorderBrush="#A5D6A7" BorderThickness="1"
                        Visibility="{Binding CanSendProfitWhatsApp, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding SendPendingProfitWhatsAppCommand}"
                            Style="{StaticResource OutlinedButton}"
                            Height="40" HorizontalAlignment="Stretch"
                            md:ButtonAssist.CornerRadius="10"
                            ToolTip="إرسال إيصالات التوزيع عبر واتساب">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <md:PackIcon Kind="Whatsapp" Width="22" Height="22" Foreground="#25D366" VerticalAlignment="Center"/>
                            <TextBlock Text="إرسال إيصالات توزيع الأرباح (PDF) عبر واتساب" Margin="10,0,0,0"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TAB 4: PROFIT STATEMENT -->
        <!-- ═══════════════════════════════════════════ -->
        <TabItem>
            <TabItem.Header>
                <StackPanel>
                    <md:PackIcon Kind="ChartLine" Width="24" Height="24" HorizontalAlignment="Center"/>
                    <TextBlock Text="كشف الأرباح" Margin="0,4,0,0"/>
                </StackPanel>
            </TabItem.Header>

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Investor selector + summary -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="كشف أرباح المستثمر" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" md:HintAssist.Hint="اختر المستثمر"
                                      ItemsSource="{Binding InvestorsList}"
                                      SelectedItem="{Binding StatementInvestor}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="رصيد الإيداع:" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatementCurrentDeposit, StringFormat=N0}"
                                           FontWeight="Bold" FontSize="15" Foreground="#1976D2"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي الأرباح:" FontWeight="SemiBold" Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatementTotalProfits, StringFormat=N0}"
                                           FontWeight="Bold" FontSize="15" Foreground="#388E3C"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </md:Card>

                <!-- Statement DataGrid -->
                <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="كشف الأرباح التفصيلي"
                                                     TargetDataGrid="{Binding ElementName=StatementDetailsGrid}"
                                                     ExportCommand="{Binding ExportStatementCommand}"
                                                     PrintCommand="{Binding PrintStatementCommand}"
                                                     ShowCardToggle="False"
                                                     ShowFilter="False">
                            <controls:ListTableHeaderBar.ExtraContent>
                                <Button Command="{Binding ShareStatementWhatsAppCommand}"
                                        ToolTip="إرسال الكشف عبر واتساب"
                                        Background="#E8F8EF" BorderBrush="#A5D6A7" BorderThickness="1"
                                        Width="36" Height="36" Cursor="Hand"
                                        md:ButtonAssist.CornerRadius="8">
                                    <md:PackIcon Kind="Whatsapp" Width="20" Height="20" Foreground="#25D366"/>
                                </Button>
                            </controls:ListTableHeaderBar.ExtraContent>
                        </controls:ListTableHeaderBar>
                        <DataGrid x:Name="StatementDetailsGrid" Grid.Row="1" ItemsSource="{Binding StatementDetails}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تاريخ التوزيع" Binding="{Binding ProfitDistribution.Date, StringFormat=yyyy/MM/dd}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="نسبة الربح %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#388E3C"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="إجمالي التوزيع الشهري" Binding="{Binding ProfitDistribution.DistributedAmount, StringFormat=N0}" Width="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="8,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
