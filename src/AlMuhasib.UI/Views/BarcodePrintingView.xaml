<UserControl x:Class="AlMuhasib.UI.Views.BarcodePrintingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BarcodePrintingViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <!-- DialogHost يجب أن يلف المحتوى — DialogHost فارغ فوق الصفحة يظهر شاشة بيضاء -->
    <md:DialogHost IsOpen="{Binding IsPrintDialogOpen}"
                   CloseOnClickAway="False"
                   DialogTheme="Inherit"
                   OverlayBackground="#80000000">
        <md:DialogHost.DialogContent>
            <controls:BarcodePrintDialogContent/>
        </md:DialogHost.DialogContent>

        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="14" Margin="0,0,0,14" Padding="20,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E65100" Offset="0"/>
                        <GradientStop Color="#EF6C00" Offset="0.55"/>
                        <GradientStop Color="#FB8C00" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="طباعة الباركودات" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" FontSize="13" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                            Style="{StaticResource OutlinedButton}"
                            Foreground="White" BorderBrush="#66FFFFFF" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="تحديث" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Stats + Filters -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E3EAF0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="إجمالي الفرع" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{Binding TotalProducts}" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E3EAF0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="بباركود" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{Binding WithBarcodeCount}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,8,0" BorderBrush="#E3EAF0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="بدون باركود" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{Binding WithoutBarcodeCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="14,12" BorderBrush="#E3EAF0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المعروض الآن" FontSize="12" Opacity="0.7"/>
                            <TextBlock Text="{Binding FilteredCount}" FontSize="22" FontWeight="Bold" Foreground="#EF6C00"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <md:Card Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="بحث بالاسم أو الباركود"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Name"
                                  md:HintAssist.Hint="الصنف"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Command="{Binding ClearCategoryFilterCommand}"
                                Style="{StaticResource FlatButton}" Margin="0,0,8,0"
                                ToolTip="مسح فلتر الصنف">
                            <md:PackIcon Kind="FilterOffOutline" Width="18" Height="18"/>
                        </Button>
                        <CheckBox Grid.Column="3" Content="لديه باركود فقط"
                                  IsChecked="{Binding OnlyWithBarcode}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </md:Card>
            </StackPanel>

            <!-- Products table -->
            <md:Card Grid.Row="2" Padding="0">
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="160"/>
                        <DataGridTextColumn Header="الصنف" Binding="{Binding CategoryName}" Width="140"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding PriceText}" Width="110"/>
                        <DataGridTemplateColumn Header="طباعة" Width="128" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenPrintDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="طباعة ملصق الباركود"
                                            IsEnabled="{Binding HasBarcode}"
                                            Height="34" MinWidth="108" Padding="12,0"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Cursor="Hand"
                                            md:ButtonAssist.CornerRadius="10"
                                            BorderThickness="0"
                                            FontWeight="SemiBold"
                                            Foreground="White">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#EF6C00" Offset="0"/>
                                                            <GradientStop Color="#F57C00" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter Property="BorderBrush" Value="#E65100"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FB8C00" Offset="0"/>
                                                                    <GradientStop Color="#EF6C00" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#BDBDBD"/>
                                                        <Setter Property="Foreground" Value="#F5F5F5"/>
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Printer" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="طباعة" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </md:Card>

            <controls:PaginationBar Grid.Row="3" Margin="0,12,0,0"/>
        </Grid>
    </md:DialogHost>
</UserControl>
