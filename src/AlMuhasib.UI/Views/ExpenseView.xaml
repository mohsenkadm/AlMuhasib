<UserControl x:Class="AlMuhasib.UI.Views.ExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 0: TOP – Expense Types (left) + Add Expense Form (right) -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══ Expense Types Management ═══ -->
            <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="0" Padding="16" md:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="أنواع المصاريف"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               Margin="0,0,0,12"/>

                    <!-- Add new type -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم النوع الجديد"
                                 Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource FilledTextBox}"/>
                        <Button Grid.Column="1"
                                Command="{Binding AddExpenseTypeCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Content="إضافة"
                                md:ButtonAssist.CornerRadius="8"/>
                    </Grid>

                    <!-- Type list -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding ExpenseTypes}"
                             SelectedItem="{Binding SelectedType}"
                             MaxHeight="200"
                             Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="14" Margin="4"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Edit/Delete buttons -->
                    <StackPanel Grid.Row="3">
                        <!-- Normal mode -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingType, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Button Content="تعديل" Margin="0,0,8,0"
                                    Command="{Binding StartEditTypeCommand}"
                                    Style="{StaticResource FlatButton}"/>
                            <Button Content="حذف"
                                    Command="{Binding DeleteExpenseTypeCommand}"
                                    Foreground="Red"
                                    Style="{StaticResource FlatButton}"/>
                        </StackPanel>

                        <!-- Edit mode -->
                        <StackPanel Visibility="{Binding IsEditingType, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBox Text="{Binding EditTypeName, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="الاسم الجديد"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ" Margin="0,0,8,0"
                                        Command="{Binding SaveEditTypeCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        md:ButtonAssist.CornerRadius="8"/>
                                <Button Content="إلغاء"
                                        Command="{Binding CancelEditTypeCommand}"
                                        Style="{StaticResource FlatButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </md:Card>

            <!-- ═══ Add Expense Form ═══ -->
            <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="2" Padding="20" md:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="إضافة مصروف جديد"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               Margin="0,0,0,16"/>

                    <!-- Row 1: Type + Amount + Date -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  md:HintAssist.Hint="نوع المصروف"
                                  ItemsSource="{Binding ExpenseTypes}"
                                  SelectedItem="{Binding FormExpenseType}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"/>

                        <TextBox Grid.Column="2"
                                 md:HintAssist.Hint="المبلغ"
                                 Text="{Binding FormAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericTextBox}"/>

                        <DatePicker Grid.Column="4"
                                    md:HintAssist.Hint="التاريخ"
                                    SelectedDate="{Binding FormDate}"
                                    Style="{StaticResource FilledDatePicker}"/>
                    </Grid>

                    <!-- Row 2: CashBox + Notes -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  md:HintAssist.Hint="الصندوق"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding FormCashBox}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"/>

                        <TextBox Grid.Column="2"
                                 md:HintAssist.Hint="ملاحظات"
                                 Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}"/>
                    </Grid>

                    <!-- Row 3: Add button -->
                    <Button Grid.Row="3"
                            HorizontalAlignment="Left"
                            Content="حفظ المصروف"
                            Command="{Binding AddExpenseCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8"
                            Padding="24,8"/>
                </Grid>
            </md:Card>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 1: FILTERS BAR -->
        <!-- ═══════════════════════════════════════════ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="16" Margin="0,0,0,12" md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0"
                          md:HintAssist.Hint="نوع المصروف"
                          ItemsSource="{Binding ExpenseTypes}"
                          SelectedItem="{Binding FilterExpenseType}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource FilledComboBox}"
                          md:HintAssist.FloatingScale="0.75"
                          IsEditable="False"/>

                <ComboBox Grid.Column="2"
                          md:HintAssist.Hint="الصندوق"
                          ItemsSource="{Binding CashBoxes}"
                          SelectedItem="{Binding FilterCashBox}"
                          DisplayMemberPath="Name"
                          Style="{StaticResource FilledComboBox}"
                          md:HintAssist.FloatingScale="0.75"
                          IsEditable="False"/>

                <DatePicker Grid.Column="4"
                            md:HintAssist.Hint="من تاريخ"
                            SelectedDate="{Binding FilterFromDate}"
                            Style="{StaticResource FilledDatePicker}"
                            Width="140"/>

                <DatePicker Grid.Column="6"
                            md:HintAssist.Hint="إلى تاريخ"
                            SelectedDate="{Binding FilterToDate}"
                            Style="{StaticResource FilledDatePicker}"
                            Width="140"/>

                <TextBox Grid.Column="8"
                         md:HintAssist.Hint="بحث في الملاحظات"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilledTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="10"
                        Command="{Binding SearchCommand}"
                        ToolTip="بحث"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8">
                    <md:PackIcon Kind="Magnify"/>
                </Button>

                <Button Grid.Column="12"
                        Command="{Binding ClearFiltersCommand}"
                        ToolTip="مسح الفلاتر"
                        Style="{StaticResource FlatButton}">
                    <md:PackIcon Kind="FilterRemoveOutline"/>
                </Button>
            </Grid>
        </md:Card>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 2: EXPENSES LIST + FOOTER -->
        <!-- ═══════════════════════════════════════════ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header bar -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="سجل المصاريف" FontSize="15" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ExportExpensesCommand}"
                                    ToolTip="تصدير Excel"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="White" Margin="0,0,8,0">
                                <md:PackIcon Kind="FileExcelOutline"/>
                            </Button>
                            <Button Command="{Binding PrintExpensesCommand}"
                                    ToolTip="طباعة"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="White">
                                <md:PackIcon Kind="Printer"/>
                            </Button>
                            <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                           ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                           ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                           TargetDataGrid="{Binding ElementName=ExpensesGrid}"
                                                           Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DataGrid -->
                <DataGrid x:Name="ExpensesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Expenses}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ExpenseType.Name}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ExpenseType.Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="الصندوق" Binding="{Binding CashBox.Name}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CashBox.Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="8,0"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer: Total + Pager -->
                <Border Grid.Row="2" Background="#F5F5F5" Padding="16,8">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="إجمالي المبلغ:" FontWeight="SemiBold" Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalFiltered, StringFormat=N0}"
                                       FontWeight="Bold" FontSize="15" Foreground="#D32F2F"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Command="{Binding PreviousPageCommand}" 
                                    Style="{StaticResource FlatButton}"
                                    Padding="4">
                                <md:PackIcon Kind="ChevronRight"/>
                            </Button>
                            <TextBlock VerticalAlignment="Center" Margin="8,0">
                                <Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalPages, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Command="{Binding NextPageCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Padding="4">
                                <md:PackIcon Kind="ChevronLeft"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
