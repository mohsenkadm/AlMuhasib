<UserControl x:Class="AlMuhasib.UI.Views.CustomerNetProfitReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CustomerNetProfitReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="{Binding ReportTitle}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="صافي الأرباح" TextValue="{Binding TotalNetProfit}" Icon="TrendingUp" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي الديون" TextValue="{Binding TotalOutstanding}" Icon="AccountAlert" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="عدد العملاء" TextValue="{Binding CustomerCount}" Icon="AccountMultiple" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="متوسط الهامش" TextValue="{Binding AverageMarginPercent}" Icon="Percent" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                </UniformGrid>

                <controls:ChartCard Title="{Binding ChartTitle}">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}"
                                            Height="280" FlowDirection="LeftToRight"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding TopCountOptions}" SelectedItem="{Binding TopCount}" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="عدد النتائج" Width="120" Margin="0,0,12,0"
                                  Visibility="{Binding TopCountVisibility}"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,8,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="صافي ربح العملاء"
                                             TargetDataGrid="{Binding ElementName=CustomerNetProfitGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="CustomerNetProfitGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"

                                  Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Rank"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Phone"/>
                        <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceCount"/>
                        <DataGridTextColumn Header="المبيعات" Binding="{Binding SalesAmount, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SalesAmount"/>
                        <DataGridTextColumn Header="التكلفة" Binding="{Binding Cost, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Cost"/>
                        <DataGridTextColumn Header="صافي الربح" Binding="{Binding NetProfit, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NetProfit"/>
                        <DataGridTextColumn Header="الهامش %" Binding="{Binding MarginPercent, StringFormat={}{0:N1}%}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="MarginPercent"/>
                        <DataGridTextColumn Header="الدين المستحق" Binding="{Binding OutstandingBalance, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="OutstandingBalance"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
