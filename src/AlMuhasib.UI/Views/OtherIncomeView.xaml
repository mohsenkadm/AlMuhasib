<UserControl x:Class="AlMuhasib.UI.Views.OtherIncomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث" Command="{Binding SearchCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="إضافة نوع إيراد" Command="{Binding AddTypeCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Plus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حفظ الإيراد" Command="{Binding SaveIncomeCommand}">
                <MenuItem.Icon><md:PackIcon Kind="CashPlus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير" Command="{Binding ExportIncomesCommand}">
                <MenuItem.Icon><md:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة" Command="{Binding PrintIncomesCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="0" Padding="16" md:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="أنواع الإيرادات" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" md:HintAssist.Hint="اسم النوع الجديد"
                                 Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" Style="{StaticResource FilledTextBox}"
                                 IsEnabled="{Binding CanAdd}"/>
                        <Button Grid.Column="1" Command="{Binding AddTypeCommand}" Content="إضافة"
                                Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8"
                                IsEnabled="{Binding CanAdd}"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding IncomeTypes}" SelectedItem="{Binding SelectedType}"
                             MaxHeight="200" Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" Margin="4,4,0,4"/>
                                    <TextBlock Text="موقوف" FontSize="11" Margin="8,4,4,4" Foreground="#C62828"
                                               Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingType, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Button Content="تعديل" Margin="0,0,8,0" Command="{Binding StartEditTypeCommand}"
                                    Style="{StaticResource FlatButton}" IsEnabled="{Binding CanEdit}"/>
                            <Button Content="تفعيل/إيقاف" Margin="0,0,8,0" Command="{Binding ToggleTypeActiveCommand}"
                                    Style="{StaticResource FlatButton}" IsEnabled="{Binding CanEdit}"/>
                            <Button Content="حذف" Command="{Binding DeleteTypeCommand}" Foreground="Red"
                                    Style="{StaticResource FlatButton}" IsEnabled="{Binding CanDelete}"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEditingType, Converter={StaticResource BoolToVis}}">
                            <TextBox Text="{Binding EditTypeName, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="الاسم الجديد" Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ" Margin="0,0,8,0" Command="{Binding SaveEditTypeCommand}"
                                        Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8"/>
                                <Button Content="إلغاء" Command="{Binding CancelEditTypeCommand}" Style="{StaticResource FlatButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </md:Card>

            <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="2" Padding="20" md:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <Button DockPanel.Dock="Left" HorizontalAlignment="Left" Content="إلغاء التعديل"
                                Command="{Binding CancelEditCommand}" Style="{StaticResource FlatButton}"
                                Visibility="{Binding IsEditingIncome, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" md:HintAssist.Hint="نوع الإيراد"
                                  ItemsSource="{Binding ActiveIncomeTypes}" SelectedItem="{Binding FormIncomeType}"
                                  DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"/>
                        <TextBox Grid.Column="2" md:HintAssist.Hint="المبلغ"
                                 Text="{Binding FormAmount, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NumericTextBox}"/>
                        <DatePicker Grid.Column="4" md:HintAssist.Hint="التاريخ"
                                    SelectedDate="{Binding FormDate}" Style="{StaticResource FilledDatePicker}"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" md:HintAssist.Hint="القاصة"
                                  ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding FormCashBox}"
                                  DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"/>
                        <TextBox Grid.Column="2" md:HintAssist.Hint="ملاحظات"
                                 Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}"/>
                    </Grid>
                    <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,14"
                                 Visibility="{Binding ShowCashImpact, Converter={StaticResource BoolToVis}}">
                        <Border Margin="0,0,8,0" Padding="12,10" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource DashboardKpiBlueLightBrush}"
                                BorderBrush="{DynamicResource DashboardKpiBlueBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Safe" Width="16" Height="16" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource DashboardKpiBlueBrush}"/>
                                    <TextBlock Text="رصيد الصندوق" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource DashboardKpiBlueBrush}">
                                    <Run Text="{Binding SelectedCashBalance, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding CashImpactCurrency, Mode=OneWay}" FontSize="12"/>
                                </TextBlock>
                                <TextBlock Text="{Binding FormCashBox.Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="4,0" Padding="12,10" CornerRadius="12" BorderThickness="1"
                                Background="{DynamicResource DashboardKpiGreenLightBrush}"
                                BorderBrush="{DynamicResource DashboardKpiGreenBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CashPlus" Width="16" Height="16" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                                    <TextBlock Text="سيُضاف" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource DashboardKpiGreenBrush}">
                                    <Run Text="{Binding CashMovementAmount, Mode=OneWay, StringFormat=N0}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding CashImpactCurrency, Mode=OneWay}" FontSize="12"/>
                                </TextBlock>
                                <TextBlock Text="من المبلغ المكتوب" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="8,0,0,0" Padding="12,10" CornerRadius="12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource DashboardKpiTealLightBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource DashboardKpiTealBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CashImpactShortfall}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DashboardKpiRedLightBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource DashboardKpiRedBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CashRegister" Width="16" Height="16" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="بعد الإضافة" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding CashBalanceAfter, Mode=OneWay, StringFormat=N0}"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="الرصيد المتوقع"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CashImpactShortfall}" Value="True">
                                                    <Setter Property="Text" Value="الرصيد لا يكفي"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource DashboardKpiRedBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Button Grid.Row="4" HorizontalAlignment="Left" Content="{Binding SaveButtonText}"
                            Command="{Binding SaveIncomeCommand}" IsEnabled="{Binding CanSaveCurrent}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8"/>
                </Grid>
            </md:Card>
        </Grid>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="16" Margin="0,0,0,12" md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" md:HintAssist.Hint="نوع الإيراد" ItemsSource="{Binding IncomeTypes}"
                          SelectedItem="{Binding FilterType}" DisplayMemberPath="Name"
                          Style="{StaticResource FilledComboBox}"/>
                <ComboBox Grid.Column="2" md:HintAssist.Hint="القاصة" ItemsSource="{Binding CashBoxes}"
                          SelectedItem="{Binding FilterCashBox}" DisplayMemberPath="Name"
                          Style="{StaticResource FilledComboBox}"/>
                <DatePicker Grid.Column="4" md:HintAssist.Hint="من تاريخ" SelectedDate="{Binding FilterFromDate}"
                            Style="{StaticResource FilledDatePicker}"/>
                <DatePicker Grid.Column="6" md:HintAssist.Hint="إلى تاريخ" SelectedDate="{Binding FilterToDate}"
                            Style="{StaticResource FilledDatePicker}"/>
                <ComboBox Grid.Column="8" md:HintAssist.Hint="العملة" ItemsSource="{Binding CurrencyFilters}"
                          SelectedItem="{Binding FilterCurrency}" DisplayMemberPath="Name"
                          Style="{StaticResource FilledComboBox}"/>
                <TextBox Grid.Column="10" md:HintAssist.Hint="بحث بالرقم أو الملاحظة أو النوع"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilledTextBox}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="12" Command="{Binding SearchCommand}" ToolTip="بحث"
                        Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8">
                    <md:PackIcon Kind="Magnify"/>
                </Button>
                <Button Grid.Column="14" Command="{Binding ClearFiltersCommand}" ToolTip="مسح الفلاتر"
                        Style="{StaticResource FlatButton}">
                    <md:PackIcon Kind="FilterRemoveOutline"/>
                </Button>
            </Grid>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0" Title="سجل الإيرادات الأخرى"
                                             TargetDataGrid="{Binding ElementName=IncomesGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportIncomesCommand}"
                                             PrintCommand="{Binding PrintIncomesCommand}"
                                             ShowCardToggle="False"/>
                <DataGrid x:Name="IncomesGrid" Grid.Row="1" ItemsSource="{Binding Incomes}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserDeleteRows="False" Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding IncomeNumber}" Width="120"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding OtherIncomeType.Name}" Width="*"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="80"/>
                        <DataGridTextColumn Header="القاصة" Binding="{Binding CashBox.Name}" Width="130"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="230" MinWidth="210"
                                                CellStyle="{StaticResource TableActionsCellStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.BeginEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                                                Width="100" Height="36" Margin="0,0,8,0"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="تعديل الإيراد">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Pencil" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="تعديل" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteIncomeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                                                Width="100" Height="36" Margin="0"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="حذف الإيراد">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="حذف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="2" Background="{DynamicResource MutedIconBackgroundBrush}" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="إجمالي الصفحة:" FontWeight="SemiBold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalFiltered, StringFormat=N0}" FontWeight="Bold" FontSize="15"
                                   Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
                <controls:PaginationBar Grid.Row="3"/>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
