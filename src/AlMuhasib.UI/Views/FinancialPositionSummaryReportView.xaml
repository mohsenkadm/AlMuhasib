<UserControl x:Class="AlMuhasib.UI.Views.FinancialPositionSummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:FinancialPositionSummaryReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="ملخص المركز المالي" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="إجمالي الأصول"
                        TextValue="{Binding TotalAssets}"
                        Icon="Warehouse"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="الالتزامات"
                        TextValue="{Binding TotalLiabilities}"
                        Icon="Bank"
                        IconBackground="#FFEBEE"
                        IconForeground="#C62828"
                        ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard
                        Title="حقوق الملكية"
                        TextValue="{Binding TotalEquity}"
                        Icon="AccountCash"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="رأس المال العامل"
                        TextValue="{Binding NetWorkingCapital}"
                        Icon="SwapHorizontal"
                        IconBackground="#FFF3E0"
                        IconForeground="#EF6C00"
                        ValueForeground="#EF6C00"/>
                </UniformGrid>

                <controls:ChartCard Title="التوزيع" Margin="0,0,0,4">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding PieSeries}" Height="300"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding AsOfDate}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="حتى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="ملخص المركز المالي"
                                             TargetDataGrid="{Binding ElementName=FinancialPositionSummaryReportGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="FinancialPositionSummaryReportGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                          Grid.Row="1">
                    <DataGrid.Columns>
                                <DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Section"/>
                                <DataGridTextColumn Header="البند" Binding="{Binding LineName}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="LineName"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
