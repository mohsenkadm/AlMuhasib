<UserControl x:Class="AlMuhasib.UI.Views.PlatformDeductionSettlementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:models="clr-namespace:AlMuhasib.Core.Models;assembly=AlMuhasib.Core"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <md:Card x:Name="HeroCard" Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="18" Margin="0,0,0,12"
                 md:ElevationAssist.Elevation="Dp2">
            <md:Card.RenderTransform>
                <TranslateTransform Y="16"/>
            </md:Card.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="تسديد استقطاع المنصة" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" Opacity="0.75" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Command="{Binding PickFileCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="18,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileExcel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="استيراد إكسل المنصة"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ReloadCommand}" Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إعادة الفحص"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{StaticResource FlatButton}" Margin="0,0,4,0" Content="الكل"/>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Matched" Style="{StaticResource FlatButton}" Margin="0,0,4,0" Content="مطابق"/>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Suggested" Style="{StaticResource FlatButton}" Margin="0,0,4,0" Content="اقتراحات"/>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="NotFound" Style="{StaticResource FlatButton}" Margin="0,0,4,0" Content="غير موجود"/>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="Selected" Style="{StaticResource FlatButton}" Content="المحدد"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <UniformGrid x:Name="StatsPanel" Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <controls:AnimatedStatCard Title="إجمالي الصفوف" TextValue="{Binding TotalRows, StringFormat={}{0}}" Icon="FileTable"
                                       IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0" Margin="0,0,8,0"/>
            <controls:AnimatedStatCard Title="مطابق" TextValue="{Binding MatchedCount, StringFormat={}{0}}" Icon="CheckCircle"
                                       IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
            <controls:AnimatedStatCard Title="اقتراحات" TextValue="{Binding SuggestedCount, StringFormat={}{0}}" Icon="AccountQuestion"
                                       IconBackground="#FFF8E1" IconForeground="#EF6C00" ValueForeground="#EF6C00" Margin="0,0,8,0"/>
            <controls:AnimatedStatCard Title="غير موجود" TextValue="{Binding NotFoundCount, StringFormat={}{0}}" Icon="AccountOff"
                                       IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828" Margin="0,0,8,0"/>
            <controls:AnimatedStatCard Title="محدد للتسديد" TextValue="{Binding SelectedCount, StringFormat={}{0}}" Icon="CheckboxMarked"
                                       IconBackground="#E0F2F1" IconForeground="#00796B" ValueForeground="#00796B" Margin="0,0,8,0"/>
            <controls:AnimatedStatCard Title="مجموع المحدد" TextValue="{Binding SelectedAmount, StringFormat=N0}" Icon="CashMultiple"
                                       IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
        </UniformGrid>

        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <DataGrid ItemsSource="{Binding RowsView}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      Style="{StaticResource ModernDataGrid}"
                      RowHeight="46"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.IsDeferredScrollingEnabled="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="Background" Value="#FAFAFA"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Matched}">
                                <Setter Property="Background" Value="#E8F5E9"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Suggested}">
                                <Setter Property="Background" Value="#FFF8E1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Invalid}">
                                <Setter Property="Background" Value="#FFEBEE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.NotFound}">
                                <Setter Property="Background" Value="#EEEEEE"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="تحديد" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          IsEnabled="{Binding CanSettle}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="55" IsReadOnly="True"/>
                    <DataGridTextColumn Header="اسم المنصة" Binding="{Binding ExcelCustomerName}" Width="1.6*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="الحالة" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Chip" CornerRadius="10" Padding="8,3" HorizontalAlignment="Center" Background="#757575">
                                    <TextBlock Text="{Binding MatchLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Matched}">
                                        <Setter TargetName="Chip" Property="Background" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Suggested}">
                                        <Setter TargetName="Chip" Property="Background" Value="#EF6C00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Invalid}">
                                        <Setter TargetName="Chip" Property="Background" Value="#C62828"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.NotFound}">
                                        <Setter TargetName="Chip" Property="Background" Value="#616161"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="عميل النظام" Binding="{Binding MatchedCustomerName}" Width="1.4*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Header="اقتراح / ربط" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel x:Name="SuggestPanel" Orientation="Horizontal" Visibility="Collapsed">
                                    <ComboBox ItemsSource="{Binding Suggestions}"
                                              SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                              DisplayMemberPath="Display"
                                              Width="155" Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                    <Button Content="اعتماد"
                                            Command="{Binding DataContext.AcceptSuggestionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource FlatButton}"
                                            Padding="8,2"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding MatchStatus}" Value="{x:Static models:PlatformDeductionMatchStatus.Suggested}">
                                        <Setter TargetName="SuggestPanel" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="المبلغ المستقطع" Binding="{Binding DeductedAmount, StringFormat=N2}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="حالة الاستقطاع" Binding="{Binding DeductionStatus}" Width="120" IsReadOnly="True"/>
                    <DataGridTextColumn Header="معرف الفاتورة" Binding="{Binding PlatformInvoiceId}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="نتيجة" Binding="{Binding ResultMessage}" Width="1.2*" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <md:Card x:Name="FooterBar" Grid.Row="3" Style="{StaticResource ElevatedCard}"
                 Padding="16,14" Margin="0,12,0,0" MinHeight="88"
                 md:ElevationAssist.Elevation="Dp3">
            <md:Card.RenderTransform>
                <TranslateTransform Y="20"/>
            </md:Card.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectAllMatchedCommand}" Style="{StaticResource FlatButton}"
                            Margin="0,0,8,6" Padding="14,8" MinHeight="36"
                            Content="تحديد الكل المطابق"/>
                    <Button Command="{Binding ClearSelectionCommand}" Style="{StaticResource FlatButton}"
                            Margin="0,0,16,6" Padding="14,8" MinHeight="36"
                            Content="إلغاء التحديد"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                        <TextBlock Text="القاصة:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  Width="200" MinHeight="36" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Margin="0,0,0,6" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding SelectedAmount, StringFormat=الإجمالي المحدد: {0:N2} د.ع}"/>
                </WrapPanel>
                <Button Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        Command="{Binding SettleSelectedCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        md:ButtonAssist.CornerRadius="10"
                        Height="48"
                        MinHeight="48"
                        Margin="0,8,0,0"
                        Padding="24,0"
                        IsEnabled="{Binding IsSettling, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <md:PackIcon Kind="CashCheck" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="تسديد المحدد" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <Border Grid.RowSpan="4" Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           Opacity="0.85"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
