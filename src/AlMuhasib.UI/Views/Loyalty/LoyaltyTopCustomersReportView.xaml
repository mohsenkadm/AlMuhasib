<UserControl x:Class="AlMuhasib.UI.Views.Loyalty.LoyaltyTopCustomersReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoyaltyTopCustomersReportViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,24,24,8">
            <TextBlock Text="أكثر الزبائن ولاءً" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="ترتيب الزبائن حسب النقاط المكتسبة والرصيد الحالي"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource FilterBar}">
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                materialDesign:HintAssist.Hint="من" Width="140" Margin="0,0,12,0"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                materialDesign:HintAssist.Hint="إلى" Width="140" Margin="0,0,12,0"/>
                    <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,8,0"/>
                    <Button Content="تصدير" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أكثر الزبائن ولاءً"
                                             TargetDataGrid="{Binding ElementName=TopLoyaltyGrid}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             ShowCardToggle="False"/>
                <DataGrid x:Name="TopLoyaltyGrid" Grid.Row="1"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding PointsBalance}" Width="90"/>
                        <DataGridTextColumn Header="مكتسب" Binding="{Binding LifetimeEarned}" Width="90"/>
                        <DataGridTextColumn Header="مستبدل" Binding="{Binding LifetimeRedeemed}" Width="90"/>
                        <DataGridTextColumn Header="المستوى" Binding="{Binding TierName}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
