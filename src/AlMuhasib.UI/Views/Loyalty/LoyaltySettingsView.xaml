<UserControl x:Class="AlMuhasib.UI.Views.Loyalty.LoyaltySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:LoyaltySettingsViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded"
             x:Name="Root">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="24" MaxWidth="920">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="Hero" Grid.Row="0" CornerRadius="18" Padding="24,22" Margin="0,0,0,18" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="16"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#B71C1C" Offset="0"/>
                        <GradientStop Color="#E53935" Offset="0.6"/>
                        <GradientStop Color="#FF7043" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="GiftOutline" Width="30" Height="30" Foreground="White"/>
                            <TextBlock Text="إعدادات الولاء" FontSize="26" FontWeight="Bold" Foreground="White" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="حدّد قواعد كسب النقاط واستبدالها كخصم على فاتورة البيع"
                                   FontSize="13" Foreground="#FFEBEE" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="FeatureStateText" Text="الحالة من إعدادات الميزات" Foreground="White" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PreviewText}" FontSize="11" Foreground="#FFCDD2" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <materialDesign:Card x:Name="SectionEarn" Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,14" Opacity="0">
                <materialDesign:Card.RenderTransform>
                    <TranslateTransform Y="14"/>
                </materialDesign:Card.RenderTransform>
                <StackPanel>
                    <TextBlock Text="قواعد الكسب" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding PointsPerAmount, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="مبلغ لكل نقطة (د.ع)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,10,12"/>
                        <TextBox Text="{Binding MinInvoiceAmountToEarn, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="حد أدنى للفاتورة لكسب النقاط"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <CheckBox Content="كسب نقاط من البيع الآجل" IsChecked="{Binding EarnOnCreditSales}" Margin="0,0,10,8"/>
                        <CheckBox Content="تقريب الكسب للأسفل" IsChecked="{Binding RoundEarnDown}" Margin="0,0,0,8"/>
                    </UniformGrid>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card x:Name="SectionRedeem" Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,14" Opacity="0">
                <materialDesign:Card.RenderTransform>
                    <TranslateTransform Y="14"/>
                </materialDesign:Card.RenderTransform>
                <StackPanel>
                    <TextBlock Text="قواعد الاستبدال" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <UniformGrid Columns="2">
                        <TextBox Text="{Binding PointValueInCurrency, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="قيمة النقطة عند الاستبدال (د.ع)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,10,12"/>
                        <TextBox Text="{Binding MinPointsToRedeem, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="أقل نقاط للاستبدال"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox Text="{Binding MaxRedeemPercentOfInvoice, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="سقف نسبة الاستبدال من الفاتورة %"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,10,12"/>
                        <TextBox Text="{Binding PointsExpireAfterDays, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 materialDesign:HintAssist.Hint="انتهاء النقاط بعد (أيام) — فارغ بلا انتهاء"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    </UniformGrid>
                    <TextBlock Text="{Binding PreviewText}" Foreground="#C62828" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Content="حفظ الإعدادات" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                        Padding="28,12" materialDesign:ButtonAssist.CornerRadius="10"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="#2E7D32" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
