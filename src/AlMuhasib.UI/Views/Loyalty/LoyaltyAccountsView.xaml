<UserControl x:Class="AlMuhasib.UI.Views.Loyalty.LoyaltyAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoyaltyAccountsViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="حسابات ولاء الزبائن" FontSize="18" FontWeight="Bold" Foreground="#B71C1C"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding LoadCommand}" Style="{StaticResource FlatButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Refresh" Margin="0,0,6,0"/>
                                <TextBlock Text="تحديث"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAdjustCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"
                                IsEnabled="{Binding CanEdit}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Pencil" Margin="0,0,6,0"/>
                                <TextBlock Text="تعديل رصيد"/>
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="بحث بالاسم أو الهاتف"
                                 Style="{StaticResource FilledTextBox}" MinWidth="240"/>
                        <Button Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="بحث"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </md:Card>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="إجمالي الأرصدة" TextValue="{Binding TotalBalanceText}" Icon="StarCircle" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
            <controls:AnimatedStatCard Title="مكتسب" TextValue="{Binding TotalEarnedText}" Icon="ArrowUpBold" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="مستبدل" TextValue="{Binding TotalRedeemedText}" Icon="ArrowDownBold" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
            <controls:AnimatedStatCard Title="عدد الحسابات" TextValue="{Binding AccountsCountText}" Icon="AccountGroup" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
        </UniformGrid>

        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedAccount}"
                      Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding PointsBalance}" Width="90"/>
                    <DataGridTextColumn Header="مكتسب" Binding="{Binding LifetimeEarned}" Width="90"/>
                    <DataGridTextColumn Header="مستبدل" Binding="{Binding LifetimeRedeemed}" Width="90"/>
                    <DataGridTextColumn Header="المستوى" Binding="{Binding TierName}" Width="90"/>
                    <DataGridTextColumn Header="آخر كسب" Binding="{Binding LastEarnedAt, StringFormat=yyyy-MM-dd}" Width="110"/>
                    <DataGridTextColumn Header="آخر استبدال" Binding="{Binding LastRedeemedAt, StringFormat=yyyy-MM-dd}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsAdjustOpen}" CloseOnClickAway="False">
            <md:DialogHost.DialogContent>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="22" MinWidth="380">
                    <StackPanel>
                        <TextBlock Text="تعديل رصيد النقاط" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBox Text="{Binding AdjustDelta, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="القيمة (+ إضافة / − خصم)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox Text="{Binding AdjustNote, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="سبب التعديل (إلزامي)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تأكيد" Command="{Binding ConfirmAdjustCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CloseAdjustCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
