<UserControl x:Class="AlMuhasib.UI.Views.Loyalty.LoyaltySummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoyaltySummaryReportViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="تقرير ملخص الولاء" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="ملخص النقاط المكتسبة والمستبدلة وقيمة الخصومات ضمن الفترة"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource FilterBar}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                materialDesign:HintAssist.Hint="من" Width="140" Margin="0,0,12,0"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                materialDesign:HintAssist.Hint="إلى" Width="140" Margin="0,0,12,0"/>
                    <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3">
                <controls:AnimatedStatCard Title="نقاط مكتسبة" TextValue="{Binding EarnedPoints}" Icon="Gift" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                <controls:AnimatedStatCard Title="نقاط مستبدلة" TextValue="{Binding RedeemedPoints}" Icon="TicketPercent" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                <controls:AnimatedStatCard Title="قيمة خصم الولاء" TextValue="{Binding RedeemValue}" Icon="CashMinus" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                <controls:AnimatedStatCard Title="زبائن نشطون" TextValue="{Binding ActiveCustomers}" Icon="AccountStar" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                <controls:AnimatedStatCard Title="عدد الحركات" TextValue="{Binding TransactionsCount}" Icon="SwapVertical" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                <controls:AnimatedStatCard Title="تعديلات يدوية" TextValue="{Binding AdjustedPoints}" Icon="Pencil" IconBackground="#EFEBE9" IconForeground="#5D4037" ValueForeground="#5D4037"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
