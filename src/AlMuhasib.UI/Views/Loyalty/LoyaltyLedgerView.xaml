<UserControl x:Class="AlMuhasib.UI.Views.Loyalty.LoyaltyLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:LoyaltyLedgerViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="سجل حركات النقاط" FontSize="22" FontWeight="Bold" Foreground="#B71C1C" Margin="0,0,0,6"/>
            <TextBlock Text="كل عمليات الكسب والاستبدال والتعديل على نقاط الولاء"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource FilterBar}">
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                md:HintAssist.Hint="من" Width="140" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                md:HintAssist.Hint="إلى" Width="140" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name" Width="200" Margin="0,0,8,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedTypeOption}"
                              DisplayMemberPath="Label" Width="140" Margin="0,0,8,0"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <Button Content="بحث" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="تصدير" Command="{Binding ExportToExcelCommand}" Style="{StaticResource OutlinedButton}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                      IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="الزبون" Binding="{Binding Customer.Name}" Width="*"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="90"/>
                    <DataGridTextColumn Header="النقاط" Binding="{Binding Points}" Width="80"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding CurrencyAmount, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="الرصيد بعد" Binding="{Binding BalanceAfter}" Width="90"/>
                    <DataGridTextColumn Header="الفاتورة" Binding="{Binding Invoice.InvoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="ملاحظة" Binding="{Binding Note}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
