<UserControl x:Class="AlMuhasib.UI.Views.MigrationWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             x:Name="Root"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="18" Margin="20,0,20,12" Padding="24,18" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="16"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1A237E" Offset="0"/>
                    <GradientStop Color="#283593" Offset="0.55"/>
                    <GradientStop Color="#3949AB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <md:PackIcon Kind="DatabaseImport" Width="30" Height="30" Foreground="White"/>
                        <TextBlock Text="معالج النقل من نظام قديم / Excel"
                                   FontSize="22" FontWeight="Bold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="أدخل البيانات يدوياً أو عبر قالب Excel لكل مرحلة — مع الحفظ قبل الانتقال للخطوة التالية"
                               FontSize="13" Foreground="#E8EAF6" TextWrapping="Wrap" MaxWidth="640"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StepTitle}" FontSize="13" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="الخطوة الحالية" FontSize="10" Foreground="#C5CAE9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Compact scrollable step chips -->
        <ScrollViewer x:Name="StepIndicator" Grid.Row="1" Margin="20,0,20,12"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Opacity="0">
            <ScrollViewer.RenderTransform>
                <TranslateTransform Y="10"/>
            </ScrollViewer.RenderTransform>
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,0" CornerRadius="16" Padding="12,8" MinWidth="110"
                                BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                            <Setter Property="BorderBrush" Value="#66BB6A"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <md:PackIcon.Style>
                                        <Style TargetType="md:PackIcon">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </md:PackIcon.Style>
                                </md:PackIcon>
                                <TextBlock Text="{Binding ShortTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Completed -->
        <Border Grid.Row="2" Margin="20,0,20,12" CornerRadius="12" Padding="16,12"
                Visibility="{Binding IsCompleted, Converter={StaticResource BoolVis}}"
                Background="{DynamicResource DashboardKpiGreenLightBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <md:PackIcon Kind="CheckCircle" Width="26" Height="26" Foreground="{DynamicResource DashboardKpiGreenBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="اكتمل معالج النقل بنجاح — يمكنك متابعة العمل بشكل طبيعي"
                           FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="StepContentScroller" Grid.Row="3"
                      VerticalScrollBarVisibility="Auto" Padding="20,0,20,8" Opacity="0">
            <ScrollViewer.RenderTransform>
                <TranslateTransform X="-20"/>
            </ScrollViewer.RenderTransform>

            <md:Card Style="{StaticResource ElevatedCard}" Padding="24" MaxWidth="980"
                     HorizontalAlignment="Center" md:ElevationAssist.Elevation="Dp2">
                <Grid x:Name="StepContentPanel" MinHeight="320">
                    <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Background="{DynamicResource MutedIconBackgroundBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                            <TextBlock Text="{Binding StepDescription}" FontSize="13.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22"/>
                        </Border>

                        <!-- Capital form -->
                        <StackPanel Visibility="{Binding IsCapitalStep, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="رأس المال" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding CapitalAmount, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="المبلغ" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الأرباح الافتتاحية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ProfitOpeningBalance, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="المبلغ" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <DatePicker SelectedDate="{Binding CapitalDate}" Width="180" Margin="0,0,12,0"
                                            md:HintAssist.Hint="التاريخ" Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                <TextBox Text="{Binding CapitalNotes, UpdateSourceTrigger=PropertyChanged}" Width="320"
                                         md:HintAssist.Hint="ملاحظات" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mode toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                                    Visibility="{Binding IsCapitalStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Button Command="{Binding SetManualModeCommand}" Margin="0,0,8,0" Padding="14,8"
                                    md:ButtonAssist.CornerRadius="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManualEntryMode}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Keyboard" VerticalAlignment="Center"/>
                                    <TextBlock Text="إدخال يدوي" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SetExcelModeCommand}" Padding="14,8"
                                    md:ButtonAssist.CornerRadius="8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExcelMode}" Value="True">
                                                <Setter Property="Background" Value="#2E7D32"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FileExcel" VerticalAlignment="Center"/>
                                    <TextBlock Text="قالب Excel واستيراد" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Manual entry -->
                        <Border Visibility="{Binding ShowManualEntryForm, Converter={StaticResource BoolVis}}"
                                Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Margin="0,0,8,0"
                                         Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="الاسم / المنتج / الزبون"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox Grid.Column="1" Margin="0,0,8,0"
                                         Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="إضافي (صنف/موقع/نوع)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox Grid.Column="2" Margin="0,0,8,0"
                                         Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="مبلغ / سعر / رصيد"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <TextBox Grid.Column="3" Margin="0,0,8,0"
                                         Text="{Binding NewRowAmount2, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="كمية / نسبة / شراء"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <Button Grid.Column="4" Command="{Binding AddManualRowCommand}"
                                        Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8" Padding="16,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Plus" VerticalAlignment="Center"/>
                                        <TextBlock Text="إضافة" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Excel panel -->
                        <StackPanel Visibility="{Binding ShowExcelPanel, Converter={StaticResource BoolVis}}" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Command="{Binding DownloadTemplateCommand}" Style="{StaticResource OutlinedButton}"
                                        md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Download" VerticalAlignment="Center"/>
                                        <TextBlock Text="تحميل القالب" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding BrowseFileCommand}" Style="{StaticResource OutlinedButton}"
                                        md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="FolderOpen" VerticalAlignment="Center"/>
                                        <TextBlock Text="استعراض Excel" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding LoadPreviewCommand}" Style="{StaticResource PrimaryButton}"
                                        md:ButtonAssist.CornerRadius="8" Padding="14,8">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Eye" VerticalAlignment="Center"/>
                                        <TextBlock Text="عرض في الجدول" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Border BorderBrush="#BDBDBD" BorderThickness="1.5" CornerRadius="10" Padding="14"
                                    Background="{DynamicResource BackgroundBrush}">
                                <TextBlock Text="{Binding SelectedFilePath, TargetNullValue='لم يُختر ملف بعد'}"
                                           TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,10"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

                        <!-- Data grid -->
                        <DataGrid ItemsSource="{Binding CurrentRows}"
                                  Visibility="{Binding ShowDataGrid, Converter={StaticResource BoolVis}}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  MaxHeight="280" Style="{StaticResource ModernDataGrid}"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" IsReadOnly="False"/>
                                <DataGridTextColumn Header="إضافي" Binding="{Binding CategoryName}" Width="100"/>
                                <DataGridTextColumn Header="الهاتف/الباركود" Binding="{Binding Phone}" Width="110"/>
                                <DataGridTextColumn Header="المبلغ/السعر" Binding="{Binding Amount, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="كمية/نسبة" Binding="{Binding Quantity, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="تكلفة/شراء" Binding="{Binding UnitCost, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="منتج" Binding="{Binding ProductName}" Width="110"/>
                                <DataGridTextColumn Header="نوع تسعير" Binding="{Binding PricingTypeName}" Width="100"/>
                                <DataGridTextColumn Header="أقساط" Binding="{Binding NumberOfInstallments}" Width="70"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding ErrorText}" Width="100"/>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveRowCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}"
                                                    ToolTip="حذف الصف">
                                                <md:PackIcon Kind="DeleteOutline" Width="18" Height="18" Foreground="#C62828"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Columns="2" Margin="0,12,0,0"
                                     Visibility="{Binding HasLastResult, Converter={StaticResource BoolVis}}">
                            <Border Background="{DynamicResource DashboardKpiGreenLightBrush}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="محفوظ" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                                    <TextBlock Text="{Binding LastImportedCount}" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource DashboardKpiOrangeLightBrush}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="متخطى" FontSize="11" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DashboardKpiOrangeBrush}"/>
                                    <TextBlock Text="{Binding LastSkippedCount}" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource DashboardKpiOrangeBrush}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Margin="0,10,0,0"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </md:Card>
        </ScrollViewer>

        <!-- Navigation -->
        <Grid Grid.Row="4" Margin="20,10,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding PreviousStepCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"
                    Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8" MinWidth="110">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="السابق"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Command="{Binding SaveCurrentStepCommand}" Margin="0,0,10,0"
                    Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8" MinWidth="130"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="حفظ الخطوة"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" md:ButtonAssist.CornerRadius="8" MinWidth="140"
                    IsEnabled="{Binding CanGoNext}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Command" Value="{Binding NextStepCommand}"/>
                        <Setter Property="Content">
                            <Setter.Value>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="حفظ والتالي"/>
                                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Background" Value="#388E3C"/>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                            <TextBlock Text="حفظ وإنهاء" Foreground="White"/>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
