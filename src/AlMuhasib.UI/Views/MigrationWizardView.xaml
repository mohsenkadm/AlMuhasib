<UserControl x:Class="AlMuhasib.UI.Views.MigrationWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             x:Name="Root"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="StepCircle" TargetType="Grid">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style x:Key="StepConnector" TargetType="Rectangle">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="2"/>
            <Setter Property="Fill" Value="#E0E0E0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,8,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="18" Margin="20,0,20,16" Padding="24,20" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="16"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#283593" Offset="0"/>
                    <GradientStop Color="#3949AB" Offset="0.5"/>
                    <GradientStop Color="#5C6BC0" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.28" Color="#283593"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <md:PackIcon Kind="DatabaseImport" Width="32" Height="32" Foreground="White"/>
                        <TextBlock Text="معالج النقل من نظام قديم" FontSize="24" FontWeight="Bold"
                                   Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="انقل عملاءك ومورديك ومنتجاتك وأرصدة الأقساط من Excel بأمان وخطوة بخطوة"
                               FontSize="13" Foreground="#E8EAF6" TextWrapping="Wrap" MaxWidth="560"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="12" Padding="14,10" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding StepTitle}" FontSize="13" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="الخطوة الحالية" FontSize="10" Foreground="#C5CAE9"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Step indicator -->
        <StackPanel x:Name="StepIndicator" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,20" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="10"/>
            </StackPanel.RenderTransform>

            <StackPanel Orientation="Horizontal">
                <Grid Style="{StaticResource StepCircle}">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <md:PackIcon Kind="AccountGroup" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon.Style>
                            <Style TargetType="md:PackIcon">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </md:PackIcon.Style>
                    </md:PackIcon>
                </Grid>
                <Rectangle Style="{StaticResource StepConnector}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Grid Style="{StaticResource StepCircle}">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <md:PackIcon Kind="TruckDelivery" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon.Style>
                            <Style TargetType="md:PackIcon">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </md:PackIcon.Style>
                    </md:PackIcon>
                </Grid>
                <Rectangle Style="{StaticResource StepConnector}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Grid Style="{StaticResource StepCircle}">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <md:PackIcon Kind="PackageVariant" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <md:PackIcon.Style>
                            <Style TargetType="md:PackIcon">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </md:PackIcon.Style>
                    </md:PackIcon>
                </Grid>
                <Rectangle Style="{StaticResource StepConnector}"/>
            </StackPanel>

            <Grid Style="{StaticResource StepCircle}">
                <Ellipse Fill="#E0E0E0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <md:PackIcon Kind="CashClock" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <md:PackIcon.Style>
                        <Style TargetType="md:PackIcon">
                            <Setter Property="Foreground" Value="#616161"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </md:PackIcon.Style>
                </md:PackIcon>
            </Grid>
        </StackPanel>

        <!-- Completed banner -->
        <Border Grid.Row="2" Margin="20,0,20,12" CornerRadius="12" Padding="16,12"
                Visibility="{Binding IsCompleted, Converter={StaticResource BoolVis}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E8F5E9" Offset="0"/>
                    <GradientStop Color="#C8E6C9" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <md:PackIcon Kind="CheckCircle" Width="28" Height="28" Foreground="#2E7D32" VerticalAlignment="Center"/>
                <TextBlock Text="اكتمل معالج النقل بنجاح — راجع البيانات في الشاشات المناسبة"
                           FontSize="14" FontWeight="SemiBold" Foreground="#1B5E20"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Step content -->
        <ScrollViewer x:Name="StepContentScroller" Grid.Row="3"
                      VerticalScrollBarVisibility="Auto" Padding="20,0,20,8" Opacity="0">
            <ScrollViewer.RenderTransform>
                <TranslateTransform X="-20"/>
            </ScrollViewer.RenderTransform>

            <md:Card Style="{StaticResource ElevatedCard}" Padding="28" MaxWidth="860"
                     HorizontalAlignment="Center" md:ElevationAssist.Elevation="Dp2">
                <Grid x:Name="StepContentPanel" MinHeight="280">
                    <Grid.RenderTransform>
                        <TranslateTransform X="0"/>
                    </Grid.RenderTransform>

                    <!-- Shared step layout (not completed) -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Instructions -->
                        <Border Background="#F5F5F5" CornerRadius="12" Padding="16,14" Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F5F5F5"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                            <Setter Property="Background" Value="#E8EAF6"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                            <Setter Property="Background" Value="#F3E5F5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding StepDescription}" FontSize="13.5"
                                           TextWrapping="Wrap" Foreground="#424242" LineHeight="22"/>
                            </StackPanel>
                        </Border>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button Command="{Binding DownloadTemplateCommand}" Style="{StaticResource OutlinedButton}"
                                    md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Download" VerticalAlignment="Center"/>
                                    <TextBlock Text="تحميل القالب" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BrowseFileCommand}" Style="{StaticResource OutlinedButton}"
                                    md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpen" VerticalAlignment="Center"/>
                                    <TextBlock Text="استعراض ملف" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportStepCommand}" Style="{StaticResource PrimaryButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="20,8"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="DatabaseImport" VerticalAlignment="Center"/>
                                    <TextBlock Text="استيراد الآن" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- File path drop zone -->
                        <Border BorderBrush="#BDBDBD" BorderThickness="2" CornerRadius="12"
                                Padding="20,16" Margin="0,0,0,16" Background="#FAFAFA">
                            <StackPanel>
                                <md:PackIcon Kind="FileExcel" Width="36" Height="36"
                                             Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding SelectedFilePath, TargetNullValue='لم يُختر ملف بعد — اضغط استعراض ملف'}"
                                           TextWrapping="Wrap" HorizontalAlignment="Center"
                                           FontSize="13" Foreground="#616161" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Progress -->
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,12"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

                        <!-- Result stats -->
                        <UniformGrid Columns="3" Margin="0,0,0,12"
                                     Visibility="{Binding HasLastResult, Converter={StaticResource BoolVis}}">
                            <Border Background="#E8F5E9" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="مستورد" FontSize="11" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastImportedCount}" FontSize="22" FontWeight="Bold"
                                               Foreground="#1B5E20" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF3E0" CornerRadius="10" Padding="12,10" Margin="3,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="متخطى" FontSize="11" Foreground="#EF6C00" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastSkippedCount}" FontSize="22" FontWeight="Bold"
                                               Foreground="#E65100" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#E3F2FD" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="الحالة" FontSize="11" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                    <md:PackIcon Kind="Check" Width="22" Height="22" Foreground="#1565C0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Preview for steps 0-2 -->
                        <StackPanel Visibility="{Binding HasPreviewRows, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="معاينة العينة" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                            <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="12" MaxHeight="120">
                                <ItemsControl ItemsSource="{Binding PreviewSampleRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="#616161"
                                                       TextWrapping="Wrap" Margin="0,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <!-- Installment grid for step 3 -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8"
                                       Visibility="{Binding HasInstallmentRows, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="معاينة أرصدة الأقساط" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                               ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                               ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                               TargetDataGrid="{Binding ElementName=InstallmentImportPreviewGrid}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid x:Name="InstallmentImportPreviewGrid"
                                      ItemsSource="{Binding InstallmentImportRows}"
                                      Visibility="{Binding HasInstallmentRows, Converter={StaticResource BoolVis}}"
                                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200"
                                      Style="{StaticResource ModernDataGrid}"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="40"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RowNumber"/>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding TotalAmount, StringFormat=N0}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalAmount"/>
                                    <DataGridTextColumn Header="أقساط" Binding="{Binding NumberOfInstallments}" Width="60"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NumberOfInstallments"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding ErrorsText}" Width="120"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ErrorsText"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </md:Card>
        </ScrollViewer>

        <!-- Navigation -->
        <Grid Grid.Row="4" Margin="20,12,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Command="{Binding PreviousStepCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"
                    Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8" MinWidth="120">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="السابق"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="2" md:ButtonAssist.CornerRadius="8" MinWidth="140"
                    IsEnabled="{Binding CanGoNext}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Command" Value="{Binding NextStepCommand}"/>
                        <Setter Property="Content">
                            <Setter.Value>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="التالي"/>
                                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Command" Value="{Binding FinishCommand}"/>
                                <Setter Property="Background" Value="#388E3C"/>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                            <TextBlock Text="إنهاء" Foreground="White"/>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
