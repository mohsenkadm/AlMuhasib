<UserControl x:Class="AlMuhasib.UI.Views.MigrationWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="12,8,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Right: Step navigator ═══ -->
        <Border Grid.Column="0" CornerRadius="16" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,14">
                    <TextBlock Text="معالج النقل" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Margin="0,4,0,8"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6"
                                 md:ProgressBarAssist.Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToStepCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,6" Padding="10,9" Cursor="Hand"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                                    BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                    Background="{DynamicResource BackgroundBrush}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB6A"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <md:PackIcon Kind="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                        <TextBlock Grid.Column="1" Text="{Binding ShortTitle}" Margin="8,0,0,0"
                                                   FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <md:PackIcon Grid.Column="2" Kind="CheckCircle" Width="14" Height="14"
                                                     Foreground="#66BB6A" VerticalAlignment="Center"
                                                     Visibility="{Binding IsSaved, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Left: Content ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="16" Padding="20,16" Margin="0,0,0,12" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="12"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="0.55"/>
                        <GradientStop Color="#00838F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding StepDescription}" FontSize="12.5" Foreground="#E3F2FD"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="620"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="10" Padding="12,8" VerticalAlignment="Center"
                            Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding EntryHint}" FontSize="11" Foreground="White" TextWrapping="Wrap" MaxWidth="200"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Completed -->
            <Border Grid.Row="1" CornerRadius="14" Padding="24" VerticalAlignment="Center"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolVis}}"
                    Background="{DynamicResource DashboardKpiGreenLightBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <md:PackIcon Kind="CheckDecagram" Width="48" Height="48" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                    <TextBlock Text="اكتمل النقل بنجاح" FontSize="20" FontWeight="Bold" Margin="0,12,0,6"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                    <TextBlock Text="يمكنك الآن استخدام النظام بشكل طبيعي" FontSize="13"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Step body -->
            <ScrollViewer x:Name="StepContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          Opacity="0">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform X="-16"/>
                </ScrollViewer.RenderTransform>

                <Border x:Name="StepContentPanel" Background="{DynamicResource CardBrush}" CornerRadius="16"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <!-- Capital -->
                        <StackPanel Visibility="{Binding IsCapitalStep, Converter={StaticResource BoolVis}}">
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="رأس المال" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding CapitalAmount, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="المبلغ" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock Text="الأرباح الافتتاحية" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding ProfitOpeningBalance, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="المبلغ" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker SelectedDate="{Binding CapitalDate}" Width="180" Margin="0,0,12,0"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" md:HintAssist.Hint="التاريخ"/>
                                <TextBox Text="{Binding CapitalNotes, UpdateSourceTrigger=PropertyChanged}" MinWidth="280"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="ملاحظات"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Mode + actions (non-capital) -->
                        <StackPanel Visibility="{Binding IsCapitalStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Command="{Binding SetManualModeCommand}" Margin="0,0,6,0" Padding="12,7" md:ButtonAssist.CornerRadius="8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManualEntryMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="KeyboardOutline" VerticalAlignment="Center"/>
                                            <TextBlock Text="يدوي" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetExcelModeCommand}" Padding="12,7" md:ButtonAssist.CornerRadius="8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExcelMode}" Value="True">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center"/>
                                            <TextBlock Text="Excel" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding EntryHint}" VerticalAlignment="Center"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </DockPanel>

                            <!-- Excel panel -->
                            <Border Visibility="{Binding ShowExcelPanel, Converter={StaticResource BoolVis}}"
                                    Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Button Command="{Binding DownloadTemplateCommand}" Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0" Padding="12,7">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Download" VerticalAlignment="Center"/>
                                                <TextBlock Text="تحميل القالب" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding BrowseFileCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="12,7">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="FileUploadOutline" VerticalAlignment="Center"/>
                                                <TextBlock Text="استيراد Excel وعرضه" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedFilePath, TargetNullValue='اختر ملف Excel ليظهر هنا'}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Manual quick-entry: Cash -->
                            <Border Visibility="{Binding ShowManualEntryForm, Converter={StaticResource BoolVis}}"
                                    Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <!-- Cash/Bank -->
                                    <Grid Visibility="{Binding IsCashStep, Converter={StaticResource BoolVis}}" Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/><ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AccountKinds}" SelectedItem="{Binding NewRowKind}"
                                                  md:HintAssist.Hint="النوع" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="الاسم" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="الرصيد" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}"
                                                 md:HintAssist.Hint="رقم الحساب" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="4" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>

                                    <!-- Investors -->
                                    <Grid Visibility="{Binding IsInvestorsStep, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="اسم المستثمر"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewRowPhone, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الهاتف"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewRowAmount2, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="نسبة الربح %"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الرصيد الافتتاحي"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="4" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>

                                    <!-- Warehouses -->
                                    <Grid Visibility="{Binding IsWarehousesStep, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="اسم المخزن"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الموقع"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="2" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>

                                    <!-- Simple name steps -->
                                    <Grid Visibility="{Binding IsSimpleNameStep, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الاسم"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="1" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>

                                    <!-- Products -->
                                    <StackPanel Visibility="{Binding IsProductsStep, Converter={StaticResource BoolVis}}">
                                        <ComboBox ItemsSource="{Binding AvailableWarehouses}" SelectedItem="{Binding SelectedWarehouseName}"
                                                  md:HintAssist.Hint="المخزن المستهدف للرصيد الافتتاحي"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="اسم المنتج"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableCategories}"
                                                      Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True" md:HintAssist.Hint="الصنف"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding NewRowPhone, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الباركود"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="السعر"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="4" Text="{Binding NewRowAmount2, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الكمية"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="5" Text="{Binding NewRowAmount3, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="التكلفة"
                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                            <Button Grid.Column="6" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                    md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Product pricing -->
                                    <Grid Visibility="{Binding IsProductPricingStep, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding AvailableProducts}"
                                                  Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" md:HintAssist.Hint="المنتج"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailablePricingTypes}"
                                                  Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" md:HintAssist.Hint="نوع التسعير"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="سعر البيع"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding NewRowAmount2, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="سعر الشراء"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <Button Grid.Column="4" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>

                                    <!-- Customers / Suppliers -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCustomersStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSuppliersStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الاسم"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewRowPhone, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الهاتف"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="رقم الملف"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="الرصيد الآجل"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <DatePicker Grid.Column="4" SelectedDate="{Binding NewRowDate}" Width="140" Margin="0,0,6,0"
                                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                        <Button Grid.Column="5" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>

                                    <!-- Installments -->
                                    <Grid Visibility="{Binding IsInstallmentsStep, Converter={StaticResource BoolVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="0.7*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding NewRowName, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="اسم الزبون"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewRowExtra, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="رقم الملف"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding NewRowAmount, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="المبلغ الكلي"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="3" Text="{Binding NewRowInt, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="عدد الأقساط"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="4" Text="{Binding NewRowInt2, UpdateSourceTrigger=PropertyChanged}" md:HintAssist.Hint="المسدد"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                        <DatePicker Grid.Column="5" SelectedDate="{Binding NewRowDate}" Width="130" Margin="0,0,6,0"
                                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                        <Button Grid.Column="6" Command="{Binding AddManualRowCommand}" Style="{StaticResource PrimaryButton}"
                                                md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

                        <!-- Grid toolbar -->
                        <DockPanel Visibility="{Binding ShowDataGrid, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                            <Button DockPanel.Dock="Left" Command="{Binding ClearRowsCommand}" Style="{StaticResource OutlinedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="DeleteSweep" VerticalAlignment="Center"/>
                                    <TextBlock Text="مسح الكل" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding CurrentRows.Count, StringFormat={}{0} صف}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DockPanel>

                        <!-- Editable preview grid -->
                        <DataGrid ItemsSource="{Binding CurrentRows}"
                                  Visibility="{Binding ShowDataGrid, Converter={StaticResource BoolVis}}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  MaxHeight="320" Style="{StaticResource ModernDataGrid}"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم / المنتج" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
                                <DataGridTextColumn Header="صنف / نوع" Binding="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="هاتف / باركود" Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="باركود" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="المبلغ / السعر" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="كمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70"/>
                                <DataGridTextColumn Header="تكلفة" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="80"/>
                                <DataGridTextColumn Header="نوع تسعير" Binding="{Binding PricingTypeName, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                <DataGridTextColumn Header="أقساط" Binding="{Binding NumberOfInstallments, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="ملاحظة" Binding="{Binding ErrorText}" Width="110" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveRowCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="حذف">
                                                <md:PackIcon Kind="Close" Width="16" Height="16" Foreground="#C62828"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Margin="0,10,0,0"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer nav -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="14"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding PreviousStepCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"
                            Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8" MinWidth="100"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="السابق"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding SkipStepCommand}"
                                Visibility="{Binding CanSkip, Converter={StaticResource BoolVis}}"
                                Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8"
                                MinWidth="100" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="SkipNext" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="تخطي"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveCurrentStepCommand}" Style="{StaticResource OutlinedButton}"
                                md:ButtonAssist.CornerRadius="8" MinWidth="120" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="حفظ الخطوة"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8" MinWidth="150"
                                IsEnabled="{Binding CanGoNext}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="حفظ والتالي"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                                    <Setter Property="Text" Value="حفظ وإنهاء"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
