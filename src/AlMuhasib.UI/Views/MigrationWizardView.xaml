<UserControl x:Class="AlMuhasib.UI.Views.MigrationWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             x:Name="Root"
             Style="{StaticResource PosPageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:DecimalThousandsConverter x:Key="DecThousands"/>
        <!-- Freezable proxy: يتجنب دورة x:Reference مع أعمدة DataGrid — يُملأ من الكود -->
        <helpers:BindingProxy x:Key="WizardProxy"/>

        <Style x:Key="WizardAmountEditN0" TargetType="TextBox" BasedOn="{StaticResource NumericCellTextBox}">
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.DecimalPlaces" Value="0"/>
        </Style>
        <Style x:Key="WizardAmountEditN2" TargetType="TextBox" BasedOn="{StaticResource NumericCellTextBox}">
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.DecimalPlaces" Value="2"/>
        </Style>
        <Style x:Key="WizardAmountFieldN0" TargetType="TextBox" BasedOn="{StaticResource NumericTextBox}">
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.DecimalPlaces" Value="0"/>
        </Style>
        <Style x:Key="WizardAmountFieldN2" TargetType="TextBox" BasedOn="{StaticResource NumericTextBox}">
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.IsEnabled" Value="True"/>
            <Setter Property="behaviors:ThousandSeparatedInputBehavior.DecimalPlaces" Value="2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8,12,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ Right: Step navigator (enlarged) ═══ -->
        <Border Grid.Column="0" CornerRadius="16" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,14">
                    <TextBlock Text="معالج النقل" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="12.5" Margin="0,6,0,10"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="8"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.GoToStepCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Margin="0,0,0,10" Padding="12,14" Cursor="Hand"
                                        MinHeight="52" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="14" Padding="{TemplateBinding Padding}"
                                                    BorderThickness="1.5" BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                    Background="{DynamicResource BackgroundBrush}"
                                                    MinHeight="{TemplateBinding MinHeight}">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#66BB6A"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.94"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center"
                                                Background="#22000000" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding StepNumber}" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <md:PackIcon Grid.Column="1" Kind="{Binding Icon}" Width="22" Height="22"
                                                     VerticalAlignment="Center" Margin="0,0,10,0">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ShortTitle}"
                                                   FontSize="14.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <md:PackIcon Grid.Column="3" Kind="CheckCircle" Width="18" Height="18"
                                                     Foreground="#66BB6A" VerticalAlignment="Center" Margin="8,0,0,0"
                                                     Visibility="{Binding IsSaved, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ═══ Left: Content ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="16" Padding="20,16" Margin="0,0,0,12" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="12"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="0.55"/>
                        <GradientStop Color="#00838F" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding StepTitle}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding StepDescription}" FontSize="13" Foreground="#E3F2FD"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MaxWidth="640"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="10" Padding="12,8" VerticalAlignment="Center"
                            Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding EntryHint}" FontSize="11.5" Foreground="White" TextWrapping="Wrap" MaxWidth="220"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" CornerRadius="14" Padding="24" VerticalAlignment="Center"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolVis}}"
                    Background="{DynamicResource DashboardKpiGreenLightBrush}">
                <StackPanel HorizontalAlignment="Center">
                    <md:PackIcon Kind="CheckDecagram" Width="48" Height="48" HorizontalAlignment="Center"
                                 Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                    <TextBlock Text="اكتمل النقل بنجاح" FontSize="20" FontWeight="Bold" Margin="0,12,0,6"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                    <TextBlock Text="يمكنك الآن استخدام النظام بشكل طبيعي" FontSize="13"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="StepContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          Opacity="0">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform X="-16"/>
                </ScrollViewer.RenderTransform>

                <Border x:Name="StepContentPanel" Background="{DynamicResource CardBrush}" CornerRadius="16"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="20">
                    <StackPanel>
                        <Border Visibility="{Binding IsPricingTypesStep, Converter={StaticResource BoolVis}}"
                                Background="{DynamicResource DashboardKpiBlueLightBrush}" CornerRadius="10"
                                Padding="12,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="TagMultiple" Width="18" Height="18" VerticalAlignment="Center"
                                             Foreground="{DynamicResource DashboardKpiBlueBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="احفظ أنواع التسعير قبل إدخال المنتجات — تُستخدم كأعمدة أسعار في القالب والإدخال اليدوي"
                                           TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DashboardKpiBlueBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Branches + multi-currency capital -->
                        <StackPanel Visibility="{Binding IsBranchesStep, Converter={StaticResource BoolVis}}">
                            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <md:PackIcon Kind="CurrencyUsd" Width="20" Height="20" Foreground="#1565C0"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="تعدد العملات (دينار + دولار)" FontWeight="SemiBold" FontSize="13.5"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <CheckBox Content="تفعيل التعامل بالدولار في النظام"
                                              IsChecked="{Binding EnableMultiCurrency}"
                                              FontSize="13" Margin="0,0,0,8"/>
                                    <StackPanel Visibility="{Binding ShowUsdFields, Converter={StaticResource BoolVis}}">
                                        <TextBox md:HintAssist.Hint="سعر الصرف الافتتاحي (1 دولار = ؟ دينار)"
                                                 Style="{StaticResource WizardAmountFieldN0}"
                                                 Text="{Binding InitialUsdToIqd, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,0,4" MaxWidth="360" HorizontalAlignment="Left"/>
                                        <TextBlock Text="يُحوَّل رأس المال بالدولار إلى دينار عند الحفظ لكل فرع"
                                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <DatePicker SelectedDate="{Binding CapitalDate}" Width="180" Margin="0,0,12,0"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" md:HintAssist.Hint="التاريخ"/>
                                <TextBox Text="{Binding CapitalNotes, UpdateSourceTrigger=PropertyChanged}" MinWidth="280"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" md:HintAssist.Hint="ملاحظات عامة"/>
                            </StackPanel>

                            <Border Background="#FFF3E0" CornerRadius="10" Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding HasBranchRows, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <TextBlock Text="لا توجد فروع محمّلة — تأكد من إعداد الفرع الرئيسي ثم أعد فتح المعالج"
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="#E65100"/>
                            </Border>

                            <TextBlock Text="أدخل رأس المال والأرباح الافتتاحية لكل فرع في الحقول أدناه ثم احفظ الخطوة"
                                       FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"
                                       Visibility="{Binding CanEnterBranchCapital, Converter={StaticResource BoolVis}}"/>

                            <Border Background="{DynamicResource DashboardKpiGreenLightBrush}" CornerRadius="10"
                                    Padding="12,10" Margin="0,0,0,12"
                                    Visibility="{Binding AllBranchesHaveCapital, Converter={StaticResource BoolVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource DashboardKpiGreenBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="رأس المال مسجّل مسبقاً لكل الفروع — يمكنك المتابعة أو إضافة فرع جديد لإدخال رأس ماله. حقول الأرباح تبقى قابلة للإدخال إن لم تُسجَّل بعد."
                                               TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Editable capital grid — بدون CopyableCells لأنها تمنع التعديل -->
                            <DataGrid ItemsSource="{Binding BranchRows}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      MaxHeight="360" Style="{StaticResource ModernDataGrid}"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      IsReadOnly="False"
                                      SelectionUnit="Cell"
                                      CanUserSortColumns="False"
                                      RowHeight="64"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      behaviors:DataGridCopyableCellsBehavior.IsEnabled="False"
                                      Margin="0,0,0,12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الفرع" Binding="{Binding BranchName}" IsReadOnly="True" Width="1.4*"/>
                                    <DataGridTextColumn Header="الرمز" Binding="{Binding BranchCode}" IsReadOnly="True" Width="70"/>
                                    <DataGridTemplateColumn Header="رأس المال د.ع" Width="130" MinWidth="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CapitalAmount, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource WizardAmountFieldN0}"
                                                         Margin="2" Padding="6,4" FontWeight="SemiBold"
                                                         IsEnabled="{Binding HasExistingCapital, Converter={StaticResource InverseBooleanConverter}}"
                                                         md:HintAssist.Hint="دينار"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="ColCapitalUsd" Header="رأس المال $" Width="120" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding CapitalAmountUsd, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource WizardAmountFieldN0}"
                                                         Margin="2" Padding="6,4" FontWeight="SemiBold"
                                                         IsEnabled="{Binding HasExistingCapital, Converter={StaticResource InverseBooleanConverter}}"
                                                         md:HintAssist.Hint="دولار"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="أرباح د.ع" Width="120" MinWidth="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ProfitOpeningBalance, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource WizardAmountFieldN0}"
                                                         Margin="2" Padding="6,4"
                                                         IsEnabled="{Binding HasExistingProfit, Converter={StaticResource InverseBooleanConverter}}"
                                                         md:HintAssist.Hint="أرباح"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn x:Name="ColProfitUsd" Header="أرباح $" Width="110" MinWidth="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ProfitOpeningBalanceUsd, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource WizardAmountFieldN0}"
                                                         Margin="2" Padding="6,4"
                                                         IsEnabled="{Binding HasExistingProfit, Converter={StaticResource InverseBooleanConverter}}"
                                                         md:HintAssist.Hint="أرباح $"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridCheckBoxColumn Header="مسجّل" Binding="{Binding HasExistingCapital}" IsReadOnly="True" Width="64"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewBranchName, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="اسم فرع جديد"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1" Text="{Binding NewBranchCode, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="رمز الفرع"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding NewBranchCapitalIqd, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                         md:HintAssist.Hint="رأس المال د.ع"
                                         Style="{StaticResource WizardAmountFieldN0}" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="3" Width="130"
                                         Text="{Binding NewBranchCapitalUsd, Converter={StaticResource DecThousands}, ConverterParameter=N0, UpdateSourceTrigger=LostFocus}"
                                         md:HintAssist.Hint="رأس المال $"
                                         Style="{StaticResource WizardAmountFieldN0}" Margin="0,0,6,0"
                                         Visibility="{Binding ShowUsdFields, Converter={StaticResource BoolVis}}"/>
                                <Button Grid.Column="4" Command="{Binding AddBranchCommand}" Style="{StaticResource PrimaryButton}"
                                        md:ButtonAssist.CornerRadius="8" Padding="14,8" Content="إضافة فرع"/>
                            </Grid>

                            <TextBlock Text="{Binding CapitalTotalInIqdDisplay}"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Mode + actions (non-branches / non-capital) -->
                        <StackPanel Visibility="{Binding IsCustomFormStep, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Command="{Binding SetManualModeCommand}" Margin="0,0,6,0" Padding="12,7" md:ButtonAssist.CornerRadius="8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsManualEntryMode}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="TableEdit" VerticalAlignment="Center"/>
                                            <TextBlock Text="جدول سريع" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetExcelModeCommand}" Padding="12,7" md:ButtonAssist.CornerRadius="8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsExcelMode}" Value="True">
                                                        <Setter Property="Background" Value="#2E7D32"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center"/>
                                            <TextBlock Text="Excel" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding EntryHint}" VerticalAlignment="Center"
                                           FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </DockPanel>

                            <!-- Excel: 1 Download → 2 Import → 3 Preview → Save footer -->
                            <Border Visibility="{Binding ShowExcelPanel, Converter={StaticResource BoolVis}}"
                                    Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="مسار Excel الاحترافي" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,12">
                                        <Border Background="{DynamicResource DashboardKpiBlueLightBrush}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="١ — تنزيل القالب" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <Button Command="{Binding DownloadTemplateCommand}" Style="{StaticResource PrimaryButton}"
                                                        md:ButtonAssist.CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <md:PackIcon Kind="Download" VerticalAlignment="Center"/>
                                                        <TextBlock Text="تنزيل القالب" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource DashboardKpiGreenLightBrush}" CornerRadius="10" Padding="12" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="٢ — استيراد الملف" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <Button Command="{Binding BrowseFileCommand}" Style="{StaticResource PrimaryButton}"
                                                        Background="#2E7D32" md:ButtonAssist.CornerRadius="8" Padding="12,8"
                                                        HorizontalAlignment="Stretch">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <md:PackIcon Kind="FileUploadOutline" VerticalAlignment="Center"/>
                                                        <TextBlock Text="استيراد القالب" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource DashboardKpiTealLightBrush}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="٣ — معاينة ثم حفظ" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                                <TextBlock Text="راجع الجدول بالأسفل ثم اضغط «حفظ الخطوة» من الأسفل"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <TextBlock Text="{Binding SelectedFilePath, TargetNullValue='لم يُختر ملف بعد'}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Manual forms removed — Excel-like grid entry for all steps -->

                            <!-- شريط أدوات الجدول السريع -->
                            <DockPanel Visibility="{Binding ShowExcelLikeToolbar, Converter={StaticResource BoolVis}}" Margin="0,0,0,8"
                                       HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                                            Visibility="{Binding IsWarehousesStep, Converter={StaticResource BoolVis}}"
                                            Margin="12,0,0,0">
                                    <TextBlock Text="فرع الصفوف الجديدة:" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox Width="200" MinHeight="34"
                                              ItemsSource="{Binding AvailableBranches}"
                                              DisplayMemberPath="Name"
                                              SelectedItem="{Binding SelectedBranchForWarehouse, Mode=TwoWay}"
                                              md:HintAssist.Hint="اختر الفرع"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              ToolTip="يُطبَّق على الصفوف الجديدة فقط — يمكن تغيير الفرع لكل صف من عمود الفرع"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AddBlankRowsCommand}" Style="{StaticResource OutlinedButton}"
                                            Padding="12,7" Margin="0,0,6,0" md:ButtonAssist.CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="TableRowPlusAfter" VerticalAlignment="Center"/>
                                            <TextBlock Text="صفوف إضافية" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ClearRowsCommand}" Style="{StaticResource OutlinedButton}"
                                            Padding="12,7" md:ButtonAssist.CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Eraser" VerticalAlignment="Center"/>
                                            <TextBlock Text="مسح" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding CurrentRowCount, StringFormat={}{0} صف}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>

                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,10"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}"/>

                        <!-- جدول منتجات شبيه Excel -->
                        <DockPanel Visibility="{Binding ShowProductsGrid, Converter={StaticResource BoolVis}}" Margin="0,0,0,8">
                            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource BackgroundBrush}">
                                <TextBlock FontSize="12.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="توضيح العملات:"/>
                                    <Run Text=" "/>
                                    <Run Text="(دينار)" FontWeight="Bold" Foreground="#1565C0"/>
                                    <Run Text=" = دينار عراقي · "/>
                                    <Run Text="(دولار)" FontWeight="Bold" Foreground="#00796B"/>
                                    <Run Text=" = دولار أمريكي (عند تفعيل تنوع العملات). عدّل الأسعار ثم احفظ الخطوة لتحديثها في النظام."/>
                                </TextBlock>
                            </Border>
                            <DataGrid x:Name="ProductsGrid"
                                      ItemsSource="{Binding CurrentRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="True"
                                      CanUserDeleteRows="True"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      SelectionUnit="Cell"
                                      SelectionMode="Single"
                                      EnableRowVirtualization="True"
                                      EnableColumnVirtualization="True"
                                      GridLinesVisibility="All"
                                      MaxHeight="460"
                                      ColumnHeaderHeight="72"
                                      RowHeight="42"
                                      Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="False"
                                      behaviors:DataGridCopyableCellsBehavior.IsEnabled="False"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      FontSize="13.5"/>
                        </DockPanel>

                        <!-- جدول إدخال شبيه Excel لباقي الخطوات -->
                        <DataGrid x:Name="PreviewGrid"
                                  ItemsSource="{Binding CurrentRows}"
                                  Visibility="{Binding ShowDataGrid, Converter={StaticResource BoolVis}}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="True"
                                  CanUserDeleteRows="True"
                                  CanUserSortColumns="False"
                                  MaxHeight="460"
                                  ColumnHeaderHeight="56"
                                  RowHeight="42"
                                  Style="{StaticResource ModernDataGrid}"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="All"
                                  IsReadOnly="False"
                                  SelectionUnit="Cell"
                                  SelectionMode="Single"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  FrozenColumnCount="0"
                                  behaviors:DataGridCopyableCellsBehavior.IsEnabled="False"
                                  RowStyle="{StaticResource ModernDataGridRow}"
                                  FontSize="13.5">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ColName"
                                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="180" MinWidth="140">
                                    <DataGridTextColumn.Header>
                                        <TextBlock x:Name="ColNameHeaderText" Text="الاسم" FontWeight="SemiBold" FontSize="12.5"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </DataGridTextColumn.Header>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn x:Name="ColBranch" Width="160" MinWidth="130">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="الفرع" FontWeight="SemiBold" FontSize="12.5"
                                                   TextAlignment="Center"
                                                   ToolTip="اختر الفرع الذي يتبعه هذا المخزن"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableBranches, ElementName=Root}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding BranchId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      IsEditable="False"
                                                      md:HintAssist.Hint="اختر الفرع"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      Margin="2" Padding="8,4" MinHeight="34"
                                                      VerticalAlignment="Center"
                                                      ToolTip="الفرع الذي يُحفظ عليه المخزن"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn x:Name="ColKind" Width="170" MinWidth="150">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="قاصة أو مصرف"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   TextAlignment="Center" TextWrapping="NoWrap"
                                                   ToolTip="نوع الحساب: قاصة نقدية أو حساب مصرف"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AccountKinds, ElementName=Root}"
                                                      SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      md:HintAssist.Hint="قاصة أو مصرف"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      Margin="2" Padding="8,4" MinHeight="34"
                                                      VerticalAlignment="Center"
                                                      ToolTip="اختر: قاصة نقدية أو حساب مصرف"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColCategory" Header="التصنيف"
                                                    Binding="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn x:Name="ColWarehouse" Header="المخزن"
                                                    Binding="{Binding WarehouseName, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn x:Name="ColPhone" Header="الهاتف"
                                                    Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="130" MinWidth="110"/>
                                <DataGridTextColumn x:Name="ColFileNumber" Header="رقم الملف"
                                                    Binding="{Binding FileNumber, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120" MinWidth="100"/>
                                <DataGridTextColumn x:Name="ColBarcode" Header="الباركود"
                                                    Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <DataGridTextColumn x:Name="ColAccountNumber" Header="رقم الحساب"
                                                    Binding="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="130" MinWidth="110"/>
                                <DataGridTextColumn x:Name="ColAmount" Header="رصيد دينار"
                                                    Binding="{Binding Amount, UpdateSourceTrigger=LostFocus, Mode=TwoWay, Converter={StaticResource DecThousands}, ConverterParameter=N0}"
                                                    EditingElementStyle="{StaticResource WizardAmountEditN0}"
                                                    Width="130" MinWidth="110"/>
                                <DataGridTextColumn x:Name="ColAmountUsd" Header="رصيد دولار"
                                                    Binding="{Binding AmountUsd, UpdateSourceTrigger=LostFocus, Mode=TwoWay, Converter={StaticResource DecThousands}, ConverterParameter=N2}"
                                                    EditingElementStyle="{StaticResource WizardAmountEditN2}"
                                                    Width="120" MinWidth="100"/>
                                <DataGridTextColumn x:Name="ColProfitPercent" Header="نسبة الربح %"
                                                    Binding="{Binding ProfitPercentage, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecThousands}, ConverterParameter=N2}"
                                                    EditingElementStyle="{StaticResource WizardAmountEditN2}"
                                                    Width="120" MinWidth="100"/>
                                <DataGridTextColumn x:Name="ColQuantity" Header="الكمية"
                                                    Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecThousands}, ConverterParameter=N0}"
                                                    EditingElementStyle="{StaticResource WizardAmountEditN0}"
                                                    Width="80"/>
                                <DataGridTextColumn x:Name="ColCost" Header="التكلفة"
                                                    Binding="{Binding UnitCost, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecThousands}, ConverterParameter=N0}"
                                                    EditingElementStyle="{StaticResource WizardAmountEditN0}"
                                                    Width="90"/>
                                <DataGridTemplateColumn x:Name="ColCurrency" Width="160" MinWidth="140">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="دينار أو دولار"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   TextAlignment="Center" TextWrapping="NoWrap"
                                                   ToolTip="عملة الحساب: دينار عراقي أو دولار أمريكي"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.CurrencyOptions, ElementName=Root}"
                                                      SelectedValuePath="Currency"
                                                      SelectedValue="{Binding CostCurrency, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="DisplayName"
                                                      IsEditable="False"
                                                      md:HintAssist.Hint="دينار أو دولار"
                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                      Margin="2" Padding="8,4" MinHeight="34"
                                                      VerticalAlignment="Center"
                                                      ToolTip="اختر: دينار عراقي أو دولار أمريكي"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColFxRate" Header="سعر الصرف"
                                                    Binding="{Binding FxRate, UpdateSourceTrigger=LostFocus, Converter={StaticResource DecThousands}, ConverterParameter=N0}"
                                                    EditingElementStyle="{StaticResource WizardAmountEditN0}"
                                                    Width="90"/>
                                <DataGridTextColumn x:Name="ColPrices" Header="الأسعار" IsReadOnly="True"
                                                    Binding="{Binding PricesSummary}" Width="1.6*"/>
                                <DataGridTextColumn x:Name="ColInstallments" Header="عدد الأقساط"
                                                    Binding="{Binding NumberOfInstallments, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120" MinWidth="100"/>
                                <DataGridTextColumn x:Name="ColPaidInstallments" Header="المسدَّد"
                                                    Binding="{Binding PaidInstallmentsCount, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100" MinWidth="80"/>
                                <DataGridTemplateColumn x:Name="ColDate" Width="220" MinWidth="200">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock x:Name="ColDateHeaderText" Text="التاريخ"
                                                   FontWeight="SemiBold" FontSize="12.5"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                                        md:HintAssist.Hint="اختر التاريخ"
                                                        Margin="2" Padding="8,4" MinHeight="36" MinWidth="190"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        FontSize="13"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColNotes" Header="ملاحظة"
                                                    Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="160" MinWidth="120"/>
                                <DataGridTextColumn x:Name="ColError" Header="خطأ"
                                                    Binding="{Binding ErrorText}" Width="120" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="{Binding StatusMessage}" FontSize="12.5" Margin="0,10,0,0"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" CornerRadius="14"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding PreviousStepCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"
                            Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8" MinWidth="100"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="السابق"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Command="{Binding SkipStepCommand}"
                                Visibility="{Binding CanSkip, Converter={StaticResource BoolVis}}"
                                Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8"
                                MinWidth="100" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="SkipNext" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="تخطي"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveCurrentStepCommand}" Style="{StaticResource OutlinedButton}"
                                md:ButtonAssist.CornerRadius="8" MinWidth="120" Margin="0,0,8,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ContentSaveOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="حفظ الخطوة"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding NextStepCommand}" Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8" MinWidth="150"
                                IsEnabled="{Binding CanGoNext}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="حفظ والتالي"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                                    <Setter Property="Text" Value="حفظ وإنهاء"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
