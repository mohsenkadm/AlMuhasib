<UserControl x:Class="AlMuhasib.UI.Views.NetworkConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="NetworkSectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="24" MaxWidth="920">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="18" Margin="0,0,0,18" Padding="24,22">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#004D40" Offset="0"/>
                        <GradientStop Color="#00695C" Offset="0.5"/>
                        <GradientStop Color="#00897B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <materialDesign:PackIcon Kind="LanConnect" Width="30" Height="30" Foreground="White"/>
                            <TextBlock Text="ربط الحاسبات" FontSize="26" FontWeight="Bold" Foreground="White" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DeploymentModeText, StringFormat='نوع الحاسبة: {0}'}"
                                   FontSize="13" Foreground="#B2DFDB"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#22FFFFFF" CornerRadius="12" Padding="14,10" MinWidth="140">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="{Binding ConnectionIconKind}" Width="28" Height="28" Foreground="White"/>
                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Branch client settings -->
            <Border Grid.Row="1" Style="{StaticResource NetworkSectionCard}"
                    Visibility="{Binding IsBranchClient, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="إعدادات الحاسبة الفرعية" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Button Content="البحث على الشبكة" Command="{Binding DiscoverServersCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,0,12"/>

                    <ComboBox ItemsSource="{Binding DiscoveredServers}"
                              SelectedItem="{Binding SelectedDiscoveredServer}"
                              DisplayMemberPath="ServerLabel"
                              materialDesign:HintAssist.Hint="الأجهزة المكتشفة" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding MainServerHost, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="عنوان IP للحاسبة الرئيسية" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding BranchDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="اسم الفرع" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding SqlInstance, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="مثيل SQL (مثال: SQLEXPRESS)" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding SqlPort, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="منفذ SQL" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding SqlUsername, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="اسم مستخدم SQL" Margin="0,0,0,12"/>
                    <PasswordBox x:Name="SqlPasswordBox" materialDesign:HintAssist.Hint="كلمة مرور SQL" Margin="0,0,0,12"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 PasswordChanged="SqlPasswordBox_OnPasswordChanged"/>
                    <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="رمز الربط" MaxLength="6" Margin="0,0,0,16"/>

                    <UniformGrid Columns="2">
                        <Button Content="اختبار الاتصال" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Content="حفظ الإعدادات" Command="{Binding SaveBranchSettingsCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="8,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Main server settings -->
            <Border Grid.Row="2" Style="{StaticResource NetworkSectionCard}"
                    Visibility="{Binding ShowMainServerSettings, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="إعدادات الحاسبة الرئيسية" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>

                    <CheckBox Content="السماح للحاسبات الفرعية بالاتصال" IsChecked="{Binding AllowBranchConnections}" Margin="0,0,0,8"/>
                    <CheckBox Content="تفعيل الاكتشاف التلقائي على الشبكة" IsChecked="{Binding DiscoveryEnabled}" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding ServerLabel, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="اسم الحاسبة الرئيسية" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding MainPairingCode, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="رمز الربط للفروع" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="تجديد" Command="{Binding RegeneratePairingCodeCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Margin="8,0,0,0"/>
                    </Grid>

                    <Button Content="حفظ إعدادات الرئيسية" Command="{Binding SaveMainServerSettingsCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#607D8B" Margin="0,8,0,0"
                       Visibility="{Binding IsBranchClient, Converter={StaticResource BoolVis}}"/>
        </Grid>
    </ScrollViewer>
</UserControl>
