<UserControl x:Class="AlMuhasib.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />

        <!-- ─── Color Palette ─────────────────────────────── -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="AccentColor">#FF8F00</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <!-- ─── Shimmer loading animation brush ───────────── -->
        <LinearGradientBrush x:Key="ShimmerBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#EEEEEE" Offset="0" />
            <GradientStop Color="#E0E0E0" Offset="0.5" />
            <GradientStop Color="#EEEEEE" Offset="1" />
        </LinearGradientBrush>

        <!-- ─── Summary card with hover scale + elevation ─── -->
        <Style x:Key="SummaryCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.03" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.03" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Section card with hover glow ──────────────── -->
        <Style x:Key="SectionCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Section header ────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#212121" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- ─── Skeleton placeholder rectangle ────────────── -->
        <Style x:Key="SkeletonRect" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ShimmerBrush}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- ─── Staggered fade-in storyboard ─────────────── -->
        <Storyboard x:Key="FadeInRow0">
            <DoubleAnimation Storyboard.TargetName="Row0" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Row0" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0" Duration="0:0:0.5" BeginTime="0:0:0">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeInRow1">
            <DoubleAnimation Storyboard.TargetName="Row1" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Row1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0" Duration="0:0:0.5" BeginTime="0:0:0.15">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeInRow2">
            <DoubleAnimation Storyboard.TargetName="Row2" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Row2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0" Duration="0:0:0.5" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeInRow3">
            <DoubleAnimation Storyboard.TargetName="Row3" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Row3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="30" To="0" Duration="0:0:0.5" BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LOADING SKELETON (shown while IsBusy)              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Skeleton summary cards -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="10,0,0,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Skeleton charts -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Height="16" Width="180" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="260" Margin="0,14,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="260" Margin="0,14,0,0" CornerRadius="130" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Skeleton tables -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <Border Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <Border Style="{StaticResource SkeletonRect}" Height="14" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Shimmer pulse animation -->
            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="1" To="0.5" Duration="0:0:0.8" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT (shown after loading)                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 1: SUMMARY CARDS (staggered entrance)  -->
                <!-- ═══════════════════════════════════════════ -->
                <UniformGrid x:Name="Row0" Grid.Row="0" Columns="4" Margin="0,0,0,20"
                             Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <UniformGrid.RenderTransform>
                        <TranslateTransform />
                    </UniformGrid.RenderTransform>

                    <!-- Today's Sales -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#E8F5E9">
                                <materialDesign:PackIcon Kind="CashRegister"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#2E7D32" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المبيعات اليوم"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding TodaySales, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#2E7D32"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Today's Purchases -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="5,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#FFF3E0">
                                <materialDesign:PackIcon Kind="CartArrowDown"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#E65100" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المشتريات اليوم"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding TodayPurchases, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#E65100"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Net Profit -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="5,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#E3F2FD">
                                <materialDesign:PackIcon Kind="ChartLine"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الأرباح الصافية"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding NetProfit, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Overdue Installments -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#FFEBEE">
                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#C62828" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الأقساط المتأخرة"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="#C62828"
                                           Margin="0,4,0,0">
                                    <Run Text="{Binding OverdueInstallmentsCount, Mode=OneWay}" />
                                    <Run Text=" قسط" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 2: CHARTS                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid x:Name="Row1" Grid.Row="1" Margin="0,0,0,20"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sales Line Chart -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ChartAreaspline"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="مبيعات آخر 30 يوم"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="1"
                                                Series="{Binding SalesSeries}"
                                                XAxes="{Binding SalesXAxes}"
                                                YAxes="{Binding SalesYAxes}"
                                                TooltipPosition="Top"
                                                AnimationsSpeed="00:00:00.500" />
                        </Grid>
                    </materialDesign:Card>

                    <!-- Expense Pie Chart -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ChartPie"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="توزيع المصاريف"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <lvc:PieChart Grid.Row="1"
                                          Series="{Binding ExpenseSeries}"
                                          AnimationsSpeed="00:00:00.500" />
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 3: TABLES                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid x:Name="Row2" Grid.Row="2" Margin="0,0,0,20"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Recent Transactions -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="آخر العمليات"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource ModernDataGrid}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="80" />
                                    <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="90" />
                                    <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Upcoming Installments -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="CalendarClock"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="أقساط قريبة الاستحقاق"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding UpcomingInstallments}"
                                      Style="{StaticResource ModernDataGrid}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="110" />
                                    <DataGridTemplateColumn Header="المتبقي" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DaysRemaining, Converter={x:Static converters:LessThanConverter.Instance}}" Value="True">
                                                                    <Setter Property="Background" Value="#FFF3E0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Medium" HorizontalAlignment="Center">
                                                        <Run Text="{Binding DaysRemaining, Mode=OneWay}" />
                                                        <Run Text=" يوم" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 4: BOTTOM SUMMARY                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid x:Name="Row3" Grid.Row="3"
                      Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cash Boxes -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="#FFF8E1">
                                    <materialDesign:PackIcon Kind="SafeSquareOutline"
                                                             Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="أرصدة القاصات"
                                           FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="#212121" />
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CashBoxes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="#F5F5F5" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontSize="13" Foreground="#424242" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Balance, StringFormat=N0}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Bank Balance -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SummaryCard}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="60" Height="60" CornerRadius="30"
                                    Background="#E8EAF6" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Bank" Width="32" Height="32"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="رصيد المصرف"
                                       FontSize="13" Foreground="#9E9E9E"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding BankBalance, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </materialDesign:Card>

                    <!-- Total Inventory -->
                    <materialDesign:Card Grid.Column="4" Style="{StaticResource SummaryCard}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="60" Height="60" CornerRadius="30"
                                    Background="#E0F2F1" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Warehouse" Width="32" Height="32"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#00695C" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="قيمة المخزون"
                                       FontSize="13" Foreground="#9E9E9E"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding TotalInventoryValue, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="#00695C"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SNACKBAR                                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarQueue}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,16" />
    </Grid>
</UserControl>
