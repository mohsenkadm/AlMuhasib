<UserControl x:Class="AlMuhasib.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel, IsDesignTimeCreatable=False}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             Background="Transparent"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <converters:TaskPriorityToBrushConverter x:Key="TaskPriorityBrush" />
        <converters:TaskPriorityToLightBrushConverter x:Key="TaskPriorityLightBrush" />

        <!-- ─── Color Palette ─────────────────────────────── -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="AccentColor">#00ACC1</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <!-- ─── Summary card with hover scale + elevation ─── -->
        <Style x:Key="SummaryCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="20" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.02" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.02" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Section card with hover glow ──────────────── -->
        <Style x:Key="SectionCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="20" />
            <Setter Property="Padding" Value="24,20" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardTaskButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Section header ────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <Style x:Key="DashboardSectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="DashboardIconBadge" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Storyboard x:Key="SkeletonShimmerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerWave"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-160" To="520" Duration="0:0:1.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ─── Skeleton placeholder with moving shimmer ─── -->
        <Style x:Key="SkeletonRect" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <Border Background="#E4EAF2" CornerRadius="8" />
                            <Rectangle x:Name="ShimmerWave" Width="120" IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.42" />
                                        <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.58" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-160" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource SkeletonShimmerStoryboard}" />
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeletonRound" TargetType="ContentControl" BasedOn="{StaticResource SkeletonRect}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <Ellipse Fill="#E4EAF2" />
                            <Rectangle x:Name="ShimmerWave" Width="120" IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.42" />
                                        <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.58" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-160" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource SkeletonShimmerStoryboard}" />
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Quick action button ───────────────────────── -->
        <Style x:Key="DashboardQuickAction" TargetType="Button">
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <materialDesign:Card x:Name="Card" UniformCornerRadius="16" Padding="16,14"
                                             materialDesign:ElevationAssist.Elevation="Dp0"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="#33FFFFFF" BorderThickness="1"
                                             RenderTransformOrigin="0.5,0.5">
                            <materialDesign:Card.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </materialDesign:Card.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </materialDesign:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.03" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.03" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Row reveal (no TargetName — valid inside Style.Triggers) ─── -->
        <Style x:Key="DashboardReveal0" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="22" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal1" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.08">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.08">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal2" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal3" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.24">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.24">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal4" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.32">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.32">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Ambient page background -->
        <Border Background="{DynamicResource DashboardAmbientBrush}" IsHitTestVisible="False" />
        <Ellipse Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-140,-120,0,0" IsHitTestVisible="False" Opacity="0.55">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#221565C0" Offset="0" />
                    <GradientStop Color="#001565C0" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-100,0" IsHitTestVisible="False" Opacity="0.45">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#1A00ACC1" Offset="0" />
                    <GradientStop Color="#0000ACC1" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LOADING SKELETON (shown while IsBusy)              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              Margin="24,20,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Skeleton summary cards -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="10,0,0,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Skeleton charts -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="180" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="260" Margin="0,14,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRound}" Height="260" Margin="0,14,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Skeleton tables -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT (shown after loading)                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="DashboardScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScrollViewer}">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid x:Name="DashboardContent" Margin="24,20,16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Welcome header -->
                <materialDesign:Card Grid.Row="0" UniformCornerRadius="24" Padding="0"
                                     Margin="0,0,0,20" ClipToBounds="True"
                                     materialDesign:ElevationAssist.Elevation="Dp4"
                                     BorderThickness="0">
                    <Grid MinHeight="210">
                        <Border CornerRadius="24">
                            <Border.Background>
                                <DynamicResource ResourceKey="DashboardHeroBrush" />
                            </Border.Background>
                        </Border>

                        <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="-90,-110,0,0" IsHitTestVisible="False" Opacity="0.18" Fill="White" />
                        <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-50,-70" IsHitTestVisible="False" Opacity="0.14" Fill="#80DEEA" />
                        <Ellipse Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,20,80,0" IsHitTestVisible="False" Opacity="0.1" Fill="White" />

                        <Grid Margin="28,26">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Background="#33FFFFFF" CornerRadius="20" Padding="10,4"
                                            HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ViewDashboard" Width="16" Height="16"
                                                                     Foreground="White" VerticalAlignment="Center" />
                                            <TextBlock Text="لوحة التحكم" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="White">
                                        <Run Text="{Binding WelcomeGreeting, Mode=OneWay}" />
                                        <Run Text="، " />
                                        <Run Text="{Binding UserDisplayName, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="نظرة شاملة على أداء عملك — مؤشرات محدّثة لحظياً"
                                               FontSize="14" Foreground="#E3F2FD" Margin="0,8,0,0" Opacity="0.95" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16"
                                                                 Foreground="#B3E5FC" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayDate, Mode=OneWay}"
                                                   FontSize="12" Foreground="#B3E5FC"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                                    <Border Background="{DynamicResource DashboardGlassChipBrush}" CornerRadius="16"
                                            Padding="16,12" Margin="0,0,0,10" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="مبيعات اليوم" FontSize="11" Foreground="#E1F5FE" />
                                            <TextBlock Text="{Binding TodaySales, Converter={StaticResource CurrencyFormat}}"
                                                       FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource DashboardGlassChipBrush}" CornerRadius="16"
                                            Padding="16,12" BorderBrush="#33FFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClipboardList" Width="18" Height="18"
                                                                     Foreground="White" VerticalAlignment="Center" />
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="مهام اليوم" FontSize="11" Foreground="#E1F5FE" />
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="White">
                                                    <Run Text="{Binding DailyTaskCount, Mode=OneWay}" />
                                                    <Run Text=" مهمة" FontSize="13" FontWeight="Normal" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="إجراءات سريعة" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E1F5FE" Margin="0,22,0,10" />

                            <!-- Quick actions -->
                            <UniformGrid Grid.Row="2" Columns="3">
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowDashboardQuickSales, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenSalesInvoiceCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#43A047" Offset="0" />
                                                    <GradientStop Color="#2E7D32" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة مبيعات" FontWeight="Bold" FontSize="14" Foreground="#1B5E20" />
                                            <TextBlock Text="إنشاء فاتورة بيع جديدة" FontSize="11" Foreground="#558B2F" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowDashboardQuickPurchase, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenPurchaseInvoiceCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="4,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FB8C00" Offset="0" />
                                                    <GradientStop Color="#EF6C00" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="CartArrowDown" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة مشتريات" FontWeight="Bold" FontSize="14" Foreground="#E65100" />
                                            <TextBlock Text="تسجيل مشتريات جديدة" FontSize="11" Foreground="#F57C00" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowDashboardQuickInstallment, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenInstallmentInvoiceCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#42A5F5" Offset="0" />
                                                    <GradientStop Color="#1565C0" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة أقساط" FontWeight="Bold" FontSize="14" Foreground="#0D47A1" />
                                            <TextBlock Text="بيع بالتقسيط للعملاء" FontSize="11" Foreground="#1976D2" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- مركز المهام والتنبيهات الذكية -->
                <materialDesign:Card Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,18"
                                     Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource DashboardTasksPanelBrush}" CornerRadius="16" Padding="18,16"
                                BorderBrush="{DynamicResource DashboardTasksPanelBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource DashboardIconBadge}" Background="{DynamicResource DashboardIconBadgeBlueBrush}">
                                        <materialDesign:PackIcon Kind="ClipboardList" Width="22" Height="22"
                                                                 Foreground="{DynamicResource DashboardKpiBlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="مهام اليوم" />
                                            <Run Text=" (" Foreground="{DynamicResource HintForegroundBrush}" />
                                            <Run Text="{Binding DailyTaskCount, Mode=OneWay}" FontWeight="Bold" />
                                            <Run Text=")" Foreground="{DynamicResource HintForegroundBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="إنجاز المهام العاجلة يحافظ على تدفق العمل"
                                                   FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DailyTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DashboardTaskButton}"
                                                    Command="{Binding DataContext.ExecuteDailyTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{DynamicResource DashboardItemBrush}" CornerRadius="14" Padding="14,12"
                                                        BorderBrush="{DynamicResource DashboardItemBorderBrush}" BorderThickness="1" MinHeight="64">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0"
                                                                Background="{Binding Priority, Converter={StaticResource TaskPriorityLightBrush}}">
                                                            <TextBlock Text="{Binding Priority}" FontWeight="Bold" FontSize="16"
                                                                       Foreground="{Binding Priority, Converter={StaticResource TaskPriorityBrush}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="{DynamicResource DashboardIconBadgeBlueBrush}"
                                                                CornerRadius="10" Padding="8,6" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="تنفيذ" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource DashboardKpiBlueBrush}" VerticalAlignment="Center" />
                                                                <materialDesign:PackIcon Kind="ChevronLeft" Foreground="{DynamicResource DashboardKpiBlueBrush}"
                                                                                         Width="16" Height="16" Margin="4,0,0,0" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource DashboardSuccessPanelBrush}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0"
                                        BorderBrush="{DynamicResource DashboardSuccessPanelBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource DashboardSuccessForegroundBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="لا توجد مهام عاجلة اليوم — عمل رائع!"
                                                   FontSize="12" Foreground="{DynamicResource DashboardSuccessForegroundBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DailyTaskCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource DashboardAlertsPanelBrush}" CornerRadius="16" Padding="18,16"
                                BorderBrush="{DynamicResource DashboardAlertsPanelBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource DashboardIconBadge}" Background="{DynamicResource DashboardIconBadgeRedBrush}">
                                        <materialDesign:PackIcon Kind="BellRing" Width="22" Height="22"
                                                                 Foreground="{DynamicResource DashboardKpiRedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="تنبيهات ذكية" FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="متابعة فورية للحالات التي تحتاج انتباهك"
                                                   FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding SmartAlerts}" MaxHeight="260">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource DashboardItemBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                                    BorderBrush="{DynamicResource DashboardAlertItemBorderBrush}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                            Background="{DynamicResource DashboardAlertTitleBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                   Foreground="{DynamicResource DashboardAlertTitleBrush}" />
                                                        <TextBlock Text="{Binding Message}" FontSize="12"
                                                                   Foreground="{DynamicResource DashboardAlertBodyBrush}"
                                                                   TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="لا توجد تنبيهات حالياً"
                                           FontSize="12" Foreground="{DynamicResource HintForegroundBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmartAlertCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 1: SUMMARY CARDS (staggered entrance)  -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="0,0,0,16" Style="{StaticResource DashboardReveal0}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               HorizontalAlignment="Stretch"
                                               Title="إجمالي المبيعات اليوم"
                                               Value="{Binding TodaySales, Converter={StaticResource CurrencyFormat}}"
                                               Icon="CashRegister"
                                               AccentBrush="{DynamicResource DashboardKpiGreenBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiGreenLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiGreenBrush}" />

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Visibility="{Binding ShowTodayPurchases, Converter={StaticResource BoolToVis}}"
                                               Title="إجمالي المشتريات اليوم"
                                               Value="{Binding TodayPurchases, Converter={StaticResource CurrencyFormat}}"
                                               Icon="CartArrowDown"
                                               AccentBrush="{DynamicResource DashboardKpiOrangeBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiOrangeBrush}" />

                    <controls:DashboardKpiCard Grid.Column="2" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Visibility="{Binding ShowNetProfit, Converter={StaticResource BoolToVis}}"
                                               Title="الأرباح الصافية"
                                               Value="{Binding NetProfit, Converter={StaticResource CurrencyFormat}}"
                                               Icon="ChartLine"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}" />

                    <controls:DashboardKpiCard Grid.Column="3" Margin="8,0,0,0"
                                               HorizontalAlignment="Stretch"
                                               Title="الأقساط المتأخرة"
                                               Value="{Binding OverdueInstallmentsCount, StringFormat={}{0} قسط}"
                                               Icon="AlertCircleOutline"
                                               AccentBrush="{DynamicResource DashboardKpiRedBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiRedLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiRedBrush}" />
                </Grid>

                <!-- Additional Statistics Row -->
                <Grid Grid.Row="3" Margin="0,0,0,16"
                      Visibility="{Binding ShowInvestorStats, Converter={StaticResource BoolToVis}}"
                      Style="{StaticResource DashboardReveal1}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               HorizontalAlignment="Stretch"
                                               Title="رصيد المستثمرين"
                                               Value="{Binding InvestorBalance, Converter={StaticResource CurrencyFormat}}"
                                               Icon="TrendingUp"
                                               AccentBrush="{DynamicResource DashboardKpiIndigoBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiIndigoLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiIndigoBrush}" />

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Title="رصيد الأقساط غير المسددة"
                                               Value="{Binding UnpaidInstallmentsBalance, Converter={StaticResource CurrencyFormat}}"
                                               Icon="CalendarMultipleCheck"
                                               AccentBrush="{DynamicResource DashboardKpiOrangeBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiOrangeBrush}" />

                    <controls:DashboardKpiCard Grid.Column="2" Margin="8,0,0,0"
                                               HorizontalAlignment="Stretch"
                                               Title="رصيد الآجل للعملاء"
                                               Value="{Binding CustomerCreditBalance, Converter={StaticResource CurrencyFormat}}"
                                               Icon="AccountCash"
                                               AccentBrush="{DynamicResource DashboardKpiPinkBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiPinkLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiPinkBrush}" />
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 2: CHARTS                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="4" Margin="0,0,0,16"
                      Visibility="{Binding ShowFinanceCharts, Converter={StaticResource BoolToVis}}"
                      Style="{StaticResource DashboardReveal2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sales Line Chart -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource DashboardSectionHeaderPanel}">
                                <Border Style="{StaticResource DashboardIconBadge}" Background="{DynamicResource DashboardIconBadgeBlueBrush}">
                                    <materialDesign:PackIcon Kind="ChartAreaspline" Width="22" Height="22"
                                                             Foreground="{DynamicResource DashboardKpiBlueBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="مبيعات آخر 30 يوم" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Text="اتجاه الإيرادات اليومية" FontSize="11"
                                               Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource DashboardChartWellBrush}" CornerRadius="14" Padding="8"
                                    BorderBrush="{DynamicResource DashboardChartWellBorderBrush}" BorderThickness="1" FlowDirection="LeftToRight">
                                <lvc:CartesianChart Series="{Binding SalesSeries}"
                                                    XAxes="{Binding SalesXAxes}"
                                                    YAxes="{Binding SalesYAxes}"
                                                    TooltipPosition="Top"
                                                    MinHeight="260"
                                                    AnimationsSpeed="00:00:00.500" />
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Expense Pie Chart -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource DashboardSectionHeaderPanel}">
                                <Border Style="{StaticResource DashboardIconBadge}" Background="{DynamicResource DashboardIconBadgeCyanBrush}">
                                    <materialDesign:PackIcon Kind="ChartPie" Width="22" Height="22"
                                                             Foreground="{DynamicResource DashboardKpiTealBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="توزيع المصاريف" Style="{StaticResource SectionHeader}" />
                                    <TextBlock Text="حصة كل فئة من إجمالي المصروفات" FontSize="11"
                                               Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource DashboardChartWellBrush}" CornerRadius="14" Padding="8"
                                    BorderBrush="{DynamicResource DashboardChartWellBorderBrush}" BorderThickness="1" FlowDirection="LeftToRight">
                                <lvc:PieChart Series="{Binding ExpenseSeries}"
                                              LegendPosition="Bottom"
                                              MinHeight="260"
                                              AnimationsSpeed="00:00:00.500" />
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 3: TABLES                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="5" Margin="0,0,0,16"
                      Style="{StaticResource DashboardReveal3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Recent Transactions -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="آخر العمليات"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                               ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                               ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                               TargetDataGrid="{Binding ElementName=RecentTransactionsGrid}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid x:Name="RecentTransactionsGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      MaxHeight="280"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="80"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Type" />
                                    <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Number" />
                                    <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Party" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="95"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Upcoming Installments -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="CalendarClock"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="أقساط قريبة الاستحقاق"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                               ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                               ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                               TargetDataGrid="{Binding ElementName=UpcomingInstallmentsGrid}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"/>
                            </StackPanel>
                            <DataGrid x:Name="UpcomingInstallmentsGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding UpcomingInstallments}"
                                      Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      MaxHeight="280"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName" />
                                                        <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerFileNumber}" Width="90"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerFileNumber}" Width="90"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerFileNumber"/>
                                    <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="110"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate" />
                                    <DataGridTemplateColumn Header="المتبقي" Width="80"
                                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DaysRemaining, Converter={x:Static converters:LessThanConverter.Instance}}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HighlightLightBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Medium" HorizontalAlignment="Center">
                                                        <Run Text="{Binding DaysRemaining, Mode=OneWay}" />
                                                        <Run Text=" يوم" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 4: BOTTOM SUMMARY                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="6"
                      Style="{StaticResource DashboardReveal4}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cash Boxes -->
                    <controls:DashboardKpiCard Grid.Column="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Title="إجمالي القاصات"
                                               Value="{Binding TotalCashBalance, Converter={StaticResource CurrencyFormat}}"
                                               Icon="SafeSquareOutline"
                                               AccentBrush="{DynamicResource DashboardKpiTealBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiTealLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiTealBrush}">
                        <ItemsControl ItemsSource="{Binding CashBoxes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Balance, StringFormat=N0}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DashboardKpiTealBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:DashboardKpiCard>

                    <!-- Bank Balance -->
                    <controls:DashboardKpiCard Grid.Column="2"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Title="رصيد المصرف"
                                               Value="{Binding BankBalance, Converter={StaticResource CurrencyFormat}}"
                                               Icon="Bank"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}" />

                    <!-- Total Inventory -->
                    <controls:DashboardKpiCard Grid.Column="4"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Title="قيمة المخزون"
                                               Value="{Binding TotalInventoryValue, Converter={StaticResource CurrencyFormat}}"
                                               Icon="Warehouse"
                                               AccentBrush="{DynamicResource DashboardKpiIndigoBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiIndigoLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiIndigoBrush}" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SNACKBAR                                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarQueue}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,16" />
    </Grid>
</UserControl>
