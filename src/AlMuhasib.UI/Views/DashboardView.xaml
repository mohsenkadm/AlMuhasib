<UserControl x:Class="AlMuhasib.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel, IsDesignTimeCreatable=False}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             Background="#F0F4F8"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat" />

        <!-- ─── Color Palette ─────────────────────────────── -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="AccentColor">#00ACC1</Color>
        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

        <!-- ─── Shimmer sweep storyboard ──────────────────── -->
        <Storyboard x:Key="SkeletonShimmerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerWave"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-160" To="520" Duration="0:0:1.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ─── Summary card with hover scale + elevation ─── -->
        <Style x:Key="SummaryCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E8EEF5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp8" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.03" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.03" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Section card with hover glow ──────────────── -->
        <Style x:Key="SectionCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2" />
            <Setter Property="Background" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ─── Section header ────────────────────────────── -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#212121" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- ─── Skeleton placeholder with moving shimmer ─── -->
        <Style x:Key="SkeletonRect" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <Border Background="#E4EAF2" CornerRadius="8" />
                            <Rectangle x:Name="ShimmerWave" Width="120" IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.42" />
                                        <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.58" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-160" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource SkeletonShimmerStoryboard}" />
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeletonRound" TargetType="ContentControl" BasedOn="{StaticResource SkeletonRect}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <Ellipse Fill="#E4EAF2" />
                            <Rectangle x:Name="ShimmerWave" Width="120" IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.42" />
                                        <GradientStop Color="#99FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#44FFFFFF" Offset="0.58" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-160" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource SkeletonShimmerStoryboard}" />
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Quick action button ───────────────────────── -->
        <Style x:Key="DashboardQuickAction" TargetType="Button">
            <Setter Property="Height" Value="88"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <materialDesign:Card x:Name="Card" UniformCornerRadius="14" Padding="14,12"
                                             materialDesign:ElevationAssist.Elevation="Dp2"
                                             Background="{TemplateBinding Background}"
                                             RenderTransformOrigin="0.5,0.5">
                            <materialDesign:Card.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </materialDesign:Card.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </materialDesign:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="materialDesign:ElevationAssist.Elevation" Value="Dp8"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.03" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.03" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ─── Row reveal (no TargetName — valid inside Style.Triggers) ─── -->
        <Style x:Key="DashboardReveal0" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="22" /></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal1" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.08">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.08">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal2" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal3" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.24">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.24">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal4" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.32">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.32">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════════════ -->
        <!-- LOADING SKELETON (shown while IsBusy)              -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Skeleton summary cards -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="10,0,0,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right" />
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <!-- Skeleton charts -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="180" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="260" Margin="0,14,0,0" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRound}" Height="260" Margin="0,14,0,0" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- Skeleton tables -->
            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" />
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="White">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6" />
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT (shown after loading)                 -->
        <!-- ═══════════════════════════════════════════════════ -->
        <ScrollViewer x:Name="DashboardScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScrollViewer}">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid x:Name="DashboardContent" Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Welcome header -->
                <materialDesign:Card Grid.Row="0" UniformCornerRadius="16" Padding="0"
                                     Margin="0,0,0,18"
                                     materialDesign:ElevationAssist.Elevation="Dp3"
                                     BorderBrush="#D6E4F5" BorderThickness="1">
                    <Grid>
                        <Border CornerRadius="16" Opacity="0.95">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1565C0" Offset="0"/>
                                    <GradientStop Color="#1E88E5" Offset="0.55"/>
                                    <GradientStop Color="#42A5F5" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="22,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <materialDesign:PackIcon Kind="ViewDashboard" Width="26" Height="26"
                                                                 Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="لوحة التحكم"
                                                   FontSize="22" FontWeight="Bold" Foreground="White"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="نظرة شاملة على أداء عملك اليوم"
                                               FontSize="13" Foreground="#E3F2FD"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="12"
                                        Padding="14,10" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ChartTimelineVariant" Width="20" Height="20"
                                                                 Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="مؤشرات محدّثة لحظياً"
                                                   FontSize="12" Foreground="White"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Quick actions -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,18,0,0">
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Command="{Binding OpenSalesInvoiceCommand}"
                                        Background="#E8F5E9" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#2E7D32" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة مبيعات" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                            <TextBlock Text="إنشاء فاتورة بيع جديدة" FontSize="11" Foreground="#558B2F" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Command="{Binding OpenPurchaseInvoiceCommand}"
                                        Background="#FFF3E0" Margin="4,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#EF6C00" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="CartArrowDown" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة مشتريات" FontWeight="Bold" FontSize="14" Foreground="#E65100"/>
                                            <TextBlock Text="تسجيل مشتريات جديدة" FontSize="11" Foreground="#F57C00" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Command="{Binding OpenInstallmentInvoiceCommand}"
                                        Background="#E3F2FD" Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="44" Height="44" CornerRadius="12" Background="#1565C0" Margin="0,0,12,0">
                                            <materialDesign:PackIcon Kind="CalendarClock" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة أقساط" FontWeight="Bold" FontSize="14" Foreground="#0D47A1"/>
                                            <TextBlock Text="بيع بالتقسيط للعملاء" FontSize="11" Foreground="#1976D2" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 1: SUMMARY CARDS (staggered entrance)  -->
                <!-- ═══════════════════════════════════════════ -->
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16"
                             Style="{StaticResource DashboardReveal0}">

                    <!-- Today's Sales -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#E8F5E9">
                                <materialDesign:PackIcon Kind="CashRegister"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#2E7D32" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المبيعات اليوم"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding TodaySales, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#2E7D32"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Today's Purchases -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="5,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="{DynamicResource HighlightLightBrush}">
                                <materialDesign:PackIcon Kind="CartArrowDown"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource HighlightBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="إجمالي المشتريات اليوم"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding TodayPurchases, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Net Profit -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="5,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#E3F2FD">
                                <materialDesign:PackIcon Kind="ChartLine"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الأرباح الصافية"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding NetProfit, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Overdue Installments -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#FFEBEE">
                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#C62828" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="الأقساط المتأخرة"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock FontSize="22" FontWeight="Bold" Foreground="#C62828"
                                           Margin="0,4,0,0">
                                    <Run Text="{Binding OverdueInstallmentsCount, Mode=OneWay}" />
                                    <Run Text=" قسط" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- Additional Statistics Row -->
                <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,16"
                             Style="{StaticResource DashboardReveal1}">
                    <!-- Investor Balance -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#E8EAF6">
                                <materialDesign:PackIcon Kind="TrendingUp"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#283593" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="رصيد المستثمرين"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding InvestorBalance, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#283593"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Unpaid Installments Balance -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="5,0,5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="{DynamicResource HighlightLightBrush}">
                                <materialDesign:PackIcon Kind="CalendarMultipleCheck"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource HighlightBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="رصيد الأقساط غير المسددة"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding UnpaidInstallmentsBalance, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Customer Credit Balance -->
                    <materialDesign:Card Style="{StaticResource SummaryCard}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="14"
                                    Background="#FCE4EC">
                                <materialDesign:PackIcon Kind="AccountCash"
                                                         Width="28" Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#AD1457" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="رصيد الآجل للعملاء"
                                           FontSize="12" Foreground="#9E9E9E" />
                                <TextBlock Text="{Binding CustomerCreditBalance, Converter={StaticResource CurrencyFormat}}"
                                           FontSize="22" FontWeight="Bold" Foreground="#AD1457"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </UniformGrid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 2: CHARTS                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="3" Margin="0,0,0,16"
                      Style="{StaticResource DashboardReveal2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sales Line Chart -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ChartAreaspline"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="مبيعات آخر 30 يوم"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" FlowDirection="LeftToRight">
                                <lvc:CartesianChart Series="{Binding SalesSeries}"
                                                    XAxes="{Binding SalesXAxes}"
                                                    YAxes="{Binding SalesYAxes}"
                                                    TooltipPosition="Top"
                                                    AnimationsSpeed="00:00:00.500" />
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Expense Pie Chart -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="300" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ChartPie"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="توزيع المصاريف"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <Border Grid.Row="1" FlowDirection="LeftToRight">
                                <lvc:PieChart Series="{Binding ExpenseSeries}"
                                              LegendPosition="Bottom"
                                              AnimationsSpeed="00:00:00.500" />
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 3: TABLES                              -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="4" Margin="0,0,0,16"
                      Style="{StaticResource DashboardReveal3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Recent Transactions -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="آخر العمليات"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding RecentTransactions}"
                                      Style="{StaticResource ModernDataGrid}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="80" />
                                    <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="90" />
                                    <DataGridTextColumn Header="الجهة" Binding="{Binding Party}" Width="*" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Upcoming Installments -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="CalendarClock"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="أقساط قريبة الاستحقاق"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding UpcomingInstallments}"
                                      Style="{StaticResource ModernDataGrid}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="110" />
                                    <DataGridTemplateColumn Header="المتبقي" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DaysRemaining, Converter={x:Static converters:LessThanConverter.Instance}}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource HighlightLightBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11" FontWeight="Medium" HorizontalAlignment="Center">
                                                        <Run Text="{Binding DaysRemaining, Mode=OneWay}" />
                                                        <Run Text=" يوم" />
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ROW 4: BOTTOM SUMMARY                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Grid.Row="5"
                      Style="{StaticResource DashboardReveal4}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Cash Boxes -->
                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                        Background="{DynamicResource AccentLightBrush}">
                                    <materialDesign:PackIcon Kind="SafeSquareOutline"
                                                             Width="22" Height="22"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="أرصدة القاصات"
                                           FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="#212121" />
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding CashBoxes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,8" BorderBrush="#F5F5F5" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                           FontSize="13" Foreground="#424242" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Balance, StringFormat=N0}"
                                                           FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource PrimaryBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Bank Balance -->
                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SummaryCard}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="60" Height="60" CornerRadius="30"
                                    Background="#E8EAF6" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Bank" Width="32" Height="32"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource PrimaryBrush}" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="رصيد المصرف"
                                       FontSize="13" Foreground="#9E9E9E"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding BankBalance, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </materialDesign:Card>

                    <!-- Total Inventory -->
                    <materialDesign:Card Grid.Column="4" Style="{StaticResource SummaryCard}">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Width="60" Height="60" CornerRadius="30"
                                    Background="#E0F2F1" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Warehouse" Width="32" Height="32"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Foreground="#00695C" />
                            </Border>
                            <TextBlock Grid.Row="1" Text="قيمة المخزون"
                                       FontSize="13" Foreground="#9E9E9E"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding TotalInventoryValue, Converter={StaticResource CurrencyFormat}}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="#00695C"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- SNACKBAR                                           -->
        <!-- ═══════════════════════════════════════════════════ -->
        <materialDesign:Snackbar MessageQueue="{Binding SnackbarQueue}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,16" />
    </Grid>
</UserControl>
