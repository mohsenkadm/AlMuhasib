<UserControl x:Class="AlMuhasib.UI.Views.InstallmentInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InstallmentInvoiceViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- HEADER SECTION                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Invoice Number -->
                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Text="{Binding InvoiceNumber, Mode=OneWay}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="رقم الفاتورة"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,12,12"
                                 FontSize="14"
                                 FontFamily="Consolas"
                                 Foreground="#E65100"
                                 FontWeight="Bold" />

                        <!-- Date Picker -->
                        <DatePicker Grid.Row="0" Grid.Column="1"
                                    SelectedDate="{Binding InvoiceDate}"
                                    materialDesign:HintAssist.Hint="التاريخ"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource FilledDatePicker}"
                                    Margin="0,0,12,12"
                                    FontSize="14" />

                        <!-- Customer -->
                        <ComboBox Grid.Row="0" Grid.Column="2"
                                  ItemsSource="{Binding FilteredCustomers}"
                                  SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  materialDesign:HintAssist.Hint="الزبون (ابحث أو اكتب اسم هنا)"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,0,12"
                                  FontSize="14" />

                        <!-- Warehouse -->
                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,0"
                                  FontSize="14" />

                        <!-- File Number -->
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding FileNumber, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="رقم الإضبارة"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,12,0"
                                 FontSize="14" />

                        <!-- CashBox -->
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="الصندوق"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  FontSize="14" />
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ITEMS TABLE                                    -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="0"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#FFF3E0"
                                CornerRadius="12,12,0,0"
                                Padding="16,10">
                            <Grid>
                                <TextBlock Text="بنود الفاتورة"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100"
                                           VerticalAlignment="Center" />
                                <Button Command="{Binding AddRowCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryButton}"
                                        Background="#FF8F00"
                                        Foreground="White"
                                        Height="32"
                                        Padding="14,0"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="إضافة صف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="Cell"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowHeight="48"
                                  MinHeight="200"
                                  MaxHeight="350"
                                  FontSize="13"
                                  Background="White"
                                  BorderThickness="0"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  materialDesign:DataGridAssist.CellPadding="12 6">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="#" Width="45" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                       Path=(ItemsControl.AlternationIndex),
                                                       StringFormat='{}{0}'}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#9E9E9E" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="المنتج / اسم المنتج" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Products,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name"
                                                      Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      materialDesign:HintAssist.Hint="ابحث أو اكتب..."
                                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      FontSize="13"
                                                      Padding="0,4">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
                                                        <Setter Property="Padding" Value="8,6" />
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الكمية" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Padding="4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="سعر الوحدة" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Padding="4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="الإجمالي"
                                                    Binding="{Binding TotalPrice, StringFormat=N0, Mode=OneWay}"
                                                    Width="130"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#E65100" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveRowCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="حذف السطر"
                                                    Foreground="#C62828"
                                                    Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- INSTALLMENT PLAN SETTINGS                      -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Plan settings -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding NumberOfInstallments, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="عدد الأقساط"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,12,0"
                                     FontSize="14" />

                            <DatePicker Grid.Column="1"
                                        SelectedDate="{Binding InstallmentStartDate}"
                                        materialDesign:HintAssist.Hint="تاريخ أول قسط"
                                        materialDesign:HintAssist.IsFloating="True"
                                        Style="{StaticResource FilledDatePicker}"
                                        Margin="0,0,12,0"
                                        FontSize="14" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding InstallmentAmount, StringFormat=N0, Mode=OneWay}"
                                     IsReadOnly="True"
                                     materialDesign:HintAssist.Hint="مبلغ القسط الواحد"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     FontSize="14"
                                     FontWeight="Bold"
                                     Foreground="#E65100" />
                        </Grid>

                        <!-- Schedule preview -->
                        <Border Grid.Row="1"
                                Background="#FFF8E1"
                                CornerRadius="8"
                                Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="جدول الأقساط المقترح"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100"
                                           Margin="12,10,12,6" />

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SchedulePreview}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#FFE082"
                                          RowHeight="36"
                                          MaxHeight="260"
                                          FontSize="12"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          materialDesign:DataGridAssist.ColumnHeaderPadding="12 6"
                                          materialDesign:DataGridAssist.CellPadding="12 4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم القسط"
                                                            Binding="{Binding Number}"
                                                            Width="80">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="تاريخ الاستحقاق"
                                                            Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="المبلغ"
                                                            Binding="{Binding Amount, StringFormat='{}{0:N0} د.ع'}"
                                                            Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#E65100" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- FOOTER / TOTALS                                -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="الملاحظات"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Margin="0,0,20,0"
                                 VerticalAlignment="Top" />

                        <Border Grid.Column="1"
                                Background="#FFF3E0"
                                CornerRadius="10"
                                Padding="20,16"
                                MinWidth="300">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="المجموع:" FontSize="14" Foreground="#616161" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Subtotal, StringFormat='{}{0:N0} د.ع'}" FontSize="14" Foreground="#424242" VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="التقريب:" FontSize="13" Foreground="#E65100" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding RoundingAmount, StringFormat='{}{0:N0} د.ع'}" FontSize="13" Foreground="#E65100" FontWeight="Medium" VerticalAlignment="Center" />
                                </Grid>

                                <Separator Margin="0,4,0,12" Background="#FFE0B2" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الإجمالي النهائي:" FontSize="18" FontWeight="Bold" Foreground="#BF360C" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Bold" Foreground="#BF360C" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ERROR + ACTION BUTTONS                         -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Command="{Binding NewInvoiceCommand}"
                                Style="{StaticResource FlatButton}"
                                Foreground="#616161"
                                Height="44"
                                Padding="20,0"
                                Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="فاتورة جديدة" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Print -->
                        <Button Command="{Binding PrintInvoiceCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="44"
                                Padding="20,0"
                                Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="طباعة" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SaveInvoiceCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Background="#E65100"
                                Foreground="White"
                                Height="44"
                                Padding="28,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontSize="15"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding CanSave}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="حفظ الفاتورة وجدول الأقساط" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- LOADING OVERLAY -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جاري التحميل..."
                           FontSize="13"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
