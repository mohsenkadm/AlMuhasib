<UserControl x:Class="AlMuhasib.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LEFT: User List -->
        <!-- ═══════════════════════════════════════════ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="0" Padding="16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="إدارة المستخدمين" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- Action buttons -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Command="{Binding ToggleActiveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            md:ButtonAssist.CornerRadius="8"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding SelectedUser, Converter={StaticResource NotNullToBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountSwitch" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تفعيل/تعطيل"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenResetPasswordCommand}"
                            Style="{StaticResource PrimaryButton}"
                            md:ButtonAssist.CornerRadius="8" >
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="LockReset" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إعادة كلمة المرور"/>
                        </StackPanel>
                    </Button>

                    <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 TargetDataGrid="{Binding ElementName=UsersGrid}"
                                                 Margin="8,0,0,0"
                                                 VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Data Grid -->
                <DataGrid x:Name="UsersGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Username"/>
                        <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="FullName"/>
                        <DataGridTextColumn Header="الصلاحية" Binding="{Binding RoleDisplay}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RoleDisplay"/>
                        <DataGridTemplateColumn Header="الحالة" Width="80"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusDisplay}" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D32F2F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>

        <!-- ═══════════════════════════════════════════ -->
        <!-- RIGHT: Add/Edit Form -->
        <!-- ═══════════════════════════════════════════ -->
        <StackPanel Grid.Column="2">
            <md:Card Style="{StaticResource ElevatedCard}" Padding="20" md:ElevationAssist.Elevation="Dp2" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Margin="0,0,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="إضافة مستخدم"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="تعديل مستخدم"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBox md:HintAssist.Hint="اسم المستخدم"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"
                             Margin="0,0,0,12"/>

                    <TextBox md:HintAssist.Hint="الاسم الكامل"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>

                    <!-- Password only visible when adding -->
                    <TextBox md:HintAssist.Hint="كلمة المرور"
                             Text="{Binding FormPassword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource FilledTextBox}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <ComboBox md:HintAssist.Hint="الدور"
                              Style="{StaticResource FilledComboBox}"
                              SelectedValue="{Binding FormRole}"
                              SelectedValuePath="Tag"
                              Margin="0,0,0,16">
                        <ComboBoxItem Content="مدير" Tag="{x:Static enums:UserRole.Admin}"/>
                        <ComboBoxItem Content="مستخدم" Tag="{x:Static enums:UserRole.User}"/>
                    </ComboBox>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Command="{Binding SaveUserCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="حفظ"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding StartEditCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Pencil" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="تعديل المحدد"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelEditCommand}"
                                Style="{StaticResource OutlinedButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="إلغاء"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>

            <!-- Reset Password Card -->
            <md:Card Style="{StaticResource ElevatedCard}" Padding="20" md:ElevationAssist.Elevation="Dp2"
                     Visibility="{Binding IsResetPasswordOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="إعادة تعيين كلمة المرور" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Margin="0,0,0,8" Foreground="#757575">
                        <Run Text="المستخدم: "/>
                        <Run Text="{Binding SelectedUser.FullName, Mode=OneWay}"/>
                    </TextBlock>

                    <TextBox md:HintAssist.Hint="كلمة المرور الجديدة"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding ConfirmResetPasswordCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="تأكيد"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding CancelResetPasswordCommand}"
                                Style="{StaticResource OutlinedButton}"
                                md:ButtonAssist.CornerRadius="8">
                            <TextBlock Text="إلغاء"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </Grid>
</UserControl>
