<UserControl x:Class="AlMuhasib.UI.Views.StockHealthReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:StockHealthReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="صحة المخزون" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="منتجات بكمية منخفضة أو راكدة (بدون مبيعات لفترة طويلة)"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="منخفض المخزون" TextValue="{Binding LowStockCount}" Icon="Alert" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="مخزون راكد" TextValue="{Binding DeadStockCount}" Icon="PackageVariantClosed" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="قيمة الراكد" TextValue="{Binding TotalDeadValue}" Icon="Cash" IconBackground="#ECEFF1" IconForeground="#455A64" ValueForeground="#455A64"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن" Width="150" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Filters}" SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="العرض" Width="140" Margin="0,0,12,8"/>
                        <TextBox Text="{Binding LowStockThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="حد المنخفض" Width="100" Margin="0,0,12,8"/>
                        <TextBox Text="{Binding DeadStockDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="أيام الركود" Width="100" Margin="0,0,12,8"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,8,8"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,8"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="القيمة" Binding="{Binding StockValue, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="80"/>
                        <DataGridTextColumn Header="آخر بيع" Binding="{Binding LastSaleDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                        <DataGridTextColumn Header="أيام بدون بيع" Binding="{Binding DaysSinceLastSale}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="1" Padding="16,8">
                    <Grid>
                        <TextBlock Text="{Binding PaginationText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource IconButton}" Command="{Binding LastPageCommand}"><materialDesign:PackIcon Kind="ChevronDoubleRight"/></Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}"><materialDesign:PackIcon Kind="ChevronRight"/></Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}"><materialDesign:PackIcon Kind="ChevronLeft"/></Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding FirstPageCommand}"><materialDesign:PackIcon Kind="ChevronDoubleLeft"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
