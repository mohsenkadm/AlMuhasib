<UserControl x:Class="AlMuhasib.UI.Views.OpeningSupplierBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpeningSupplierBalanceViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E65100" Offset="0"/>
                    <GradientStop Color="#EF6C00" Offset="0.5"/>
                    <GradientStop Color="#FFB74D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                        Background="#FFFFFF22" Margin="0,0,16,0" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Factory" Width="28" Height="28"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="أرصدة الموردين الافتتاحية" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="إدخال أرصدة آجلة سابقة مستحقة للموردين — بدون أصناف أو تأثير على القاصة"
                               FontSize="13" Foreground="#FFE0B2" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Style="{StaticResource MaterialDesignFilledTabControl}">
            <TabItem Header="إدخال يدوي">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,8,0">
                    <StackPanel>
                        <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                             Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Background="#FFF3E0" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Foreground="#EF6C00" Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="#E65100" FontSize="13"
                                                   Text="اختر المورد أو أدخل اسماً جديداً، ثم المبلغ المستحق له. إذا لم يكن المورد موجوداً سيُنشأ تلقائياً عند الحفظ."/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding FilteredSuppliers}"
                                                  SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True" StaysOpenOnEdit="True"
                                                  materialDesign:HintAssist.Hint="المورد"
                                                  materialDesign:HintAssist.IsFloating="True"
                                                  Style="{StaticResource FilledComboBox}" FontSize="14"/>
                                        <Button Grid.Column="1" Command="{Binding OpenQuickAddSupplierCommand}"
                                                Style="{StaticResource IconButton}" ToolTip="إضافة مورد جديد"
                                                Width="40" Height="40" Margin="6,0,0,0">
                                            <materialDesign:PackIcon Kind="AccountPlus" Width="22" Height="22"/>
                                        </Button>
                                    </Grid>

                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,12"
                                             Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="الهاتف"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource FilledTextBox}" FontSize="14"/>

                                    <TextBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"
                                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="مبلغ الرصيد الآجل"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource NumericTextBox}" FontSize="14"/>

                                    <DatePicker Grid.Row="1" Grid.Column="0" Margin="0,0,12,12"
                                                SelectedDate="{Binding BalanceDate}"
                                                materialDesign:HintAssist.Hint="التاريخ"
                                                materialDesign:HintAssist.IsFloating="True"
                                                Style="{StaticResource FilledDatePicker}" FontSize="14"/>

                                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,12"
                                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="ملاحظات"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource FilledTextBox}" FontSize="14"/>
                                </Grid>

                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13"
                                           Margin="0,0,0,12" TextWrapping="Wrap"
                                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                                <Button Command="{Binding SaveManualCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Height="44" Padding="28,0" HorizontalAlignment="Left"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        FontSize="15" FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center"/>
                                        <TextBlock Text="حفظ الرصيد" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="استيراد Excel">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <materialDesign:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                         Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal">
                                <Button Command="{Binding DownloadTemplateCommand}" Margin="0,0,12,0"
                                        Style="{StaticResource OutlinedButton}" Height="40" Padding="16,0"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Foreground="#EF6C00"/>
                                        <TextBlock Text="تنزيل قالب Excel" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding PickImportFileCommand}"
                                        Style="{StaticResource AccentButton}" Height="40" Padding="16,0"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="اختيار ملف" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding ImportStatusMessage}" Margin="0,12,0,0"
                                       FontSize="13" Foreground="#455A64" TextWrapping="Wrap"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                         Padding="0" Margin="0,0,0,16"
                                         Visibility="{Binding HasImportRows, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <controls:ListTableHeaderBar Grid.Row="0"
                                                         Title="معاينة الاستيراد"
                                                         TargetDataGrid="{Binding ElementName=ImportRowsGrid}"
                                                         ShowCardToggle="False" ShowExport="False" ShowPrint="False" ShowFilter="False">
                                <controls:ListTableHeaderBar.ExtraContent>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ImportValidCount, StringFormat=صالح: {0}}" Margin="0,0,16,0" Foreground="#C8E6C9"/>
                                        <TextBlock Text="{Binding ImportInvalidCount, StringFormat=يحتاج تصحيح: {0}}" Foreground="#FFCDD2"/>
                                    </StackPanel>
                                </controls:ListTableHeaderBar.ExtraContent>
                            </controls:ListTableHeaderBar>
                            <DataGrid x:Name="ImportRowsGrid" Grid.Row="1" ItemsSource="{Binding ImportRows}"
                                      Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" MinHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding RowNumber}" Width="50"/>
                                    <DataGridTextColumn Header="المورد" Binding="{Binding PartyName}" Width="*"/>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"/>
                                    <DataGridTextColumn Header="الأخطاء" Binding="{Binding ErrorsText}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <Button Grid.Row="2" Command="{Binding ImportCommand}" HorizontalAlignment="Left"
                            Style="{StaticResource SuccessButton}" Height="44" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            Visibility="{Binding HasImportRows, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DatabaseImport" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="استيراد إلى النظام" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="40" Height="40" Value="0"/>
                <TextBlock Text="{Binding ImportStatusMessage}" Margin="0,16,0,0"
                           FontSize="13" Foreground="#757575" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Background="#88000000" Visibility="{Binding IsQuickAddSupplierOpen, Converter={StaticResource BoolToVis}}">
            <materialDesign:Card Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="12">
                <StackPanel>
                    <TextBlock Text="إضافة مورد سريع" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBox Text="{Binding QuickSupplierName, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="اسم المورد" Margin="0,0,0,12"
                             Style="{StaticResource FilledTextBox}"/>
                    <TextBox Text="{Binding QuickSupplierPhone, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="الهاتف" Margin="0,0,0,12"
                             Style="{StaticResource FilledTextBox}"/>
                    <TextBlock Text="{Binding QuickSupplierError}" Foreground="#C62828" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حفظ" Command="{Binding SaveQuickSupplierCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Height="36" Padding="20,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddSupplierCommand}"
                                Style="{StaticResource FlatButton}" Height="36" Padding="16,0"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>
    </Grid>
</UserControl>
