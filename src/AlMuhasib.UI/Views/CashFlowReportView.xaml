<UserControl x:Class="AlMuhasib.UI.Views.CashFlowReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CashFlowReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير التدفقات النقدية" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="إجمالي الواردات"
                        TextValue="{Binding TotalIncoming}"
                        Icon="CashPlus"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="إجمالي الصادرات"
                        TextValue="{Binding TotalOutgoing}"
                        Icon="CashMinus"
                        IconBackground="#FFEBEE"
                        IconForeground="#C62828"
                        ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard
                        Title="صافي التدفق"
                        TextValue="{Binding NetFlow}"
                        Icon="SwapHorizontal"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="الرصيد الحالي"
                        TextValue="{Binding CurrentBalance}"
                        Icon="Cash"
                        IconBackground="{DynamicResource AccentLightBrush}"
                        IconForeground="{DynamicResource AccentBrush}"
                        ValueForeground="{DynamicResource AccentBrush}"/>
                </UniformGrid>

                <!-- ═══ Chart ═══ -->
                <controls:ChartCard Title="التدفقات النقدية">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding FlowSeries}" XAxes="{Binding FlowXAxes}" YAxes="{Binding FlowYAxes}" Height="350"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding CashBoxes}" SelectedValue="{Binding SelectedCashBoxId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="الصندوق" Width="160" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                       ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                       ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                       TargetDataGrid="{Binding ElementName=CashFlowReportGrid}"
                                                       Margin="0,0,12,0"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="CashFlowReportGrid"
                                  ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=\{0:yyyy/MM/dd\}}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Type"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description"/>
                                <DataGridTextColumn Header="وارد" Binding="{Binding Incoming, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Incoming">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="صادر" Binding="{Binding Outgoing, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Outgoing">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Balance"/>
                                <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AccountName"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <controls:PaginationBar Grid.Row="1"/>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
