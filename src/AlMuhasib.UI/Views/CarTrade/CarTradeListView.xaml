<UserControl x:Class="AlMuhasib.UI.Views.CarTrade.CarTradeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource FormFieldLabel}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailFieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="DetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12" md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="إدارة العمليات" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Command="{Binding OpenNewTransactionCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#E65100" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="SwapHorizontal" Margin="0,0,6,0"/>
                            <TextBlock Text="عملية جديدة"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PrintAllCommand}" Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8" IsEnabled="{Binding CanPrint}">
                        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Printer" Margin="0,0,6,0"/><TextBlock Text="طباعة الكل"/></StackPanel>
                    </Button>
                    <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8" IsEnabled="{Binding CanExport}">
                        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="FileExcelOutline" Margin="0,0,6,0"/><TextBlock Text="تصدير Excel"/></StackPanel>
                    </Button>
                    <Button Command="{Binding LoadTransactionsCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Refresh" Margin="0,0,6,0"/><TextBlock Text="تحديث"/></StackPanel>
                    </Button>
                    <TextBox md:HintAssist.Hint="بحث..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" MinWidth="200" Margin="0,0,8,8"/>
                    <DatePicker md:HintAssist.Hint="من" SelectedDate="{Binding DateFrom}" Width="140" Margin="0,0,8,8"/>
                    <DatePicker md:HintAssist.Hint="إلى" SelectedDate="{Binding DateTo}" Width="140" Margin="0,0,8,8"/>
                    <CheckBox Content="غير مسددة فقط" IsChecked="{Binding UnpaidOnly}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </md:Card>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="العدد" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalCount}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="شراء" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryBuyCount}" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="بيع" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummarySellCount}" FontSize="20" FontWeight="Bold" Foreground="#E65100"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="الإجمالي" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalAmount, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="المدفوع" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalPaid, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="المتبقي" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalRemaining, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="#C62828"/></StackPanel></md:Card>
        </UniformGrid>

        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#E65100" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="قائمة العمليات" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <controls:ColumnFilterToggle Grid.Column="1"
                                                     IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     TargetDataGrid="{Binding ElementName=TransactionsGrid}"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="TransactionsGrid" Grid.Row="1"
                          ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" Style="{StaticResource ModernDataGrid}"
                          md:DataGridAssist.CellPadding="10 8" FontSize="13" Margin="8,4,8,0"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم العملية" Binding="{Binding TransactionNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TransactionNumber">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#E65100"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=yyyy/MM/dd}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TransactionDate"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding TradeType}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TradeType"/>
                        <DataGridTextColumn Header="السيارة" Binding="{Binding CarName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CarName"/>
                        <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SellerName"/>
                        <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BuyerName"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalAmount"/>
                        <DataGridTextColumn Header="المدفوع" Binding="{Binding AmountPaid, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AmountPaid"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#C62828"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Status"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="300" MinWidth="300"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource TableViewIconButton}"
                                                Command="{Binding DataContext.ViewTransactionDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="عرض التفاصيل">
                                            <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                                Command="{Binding DataContext.OpenPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="تسديد"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="CashCheck" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource TablePrintIconButton}"
                                                Command="{Binding DataContext.PrintTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="طباعة"
                                                IsEnabled="{Binding DataContext.CanPrint, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="Printer" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource TableEditIconButton}"
                                                Command="{Binding DataContext.EditTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="تعديل"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource TableDeleteIconButton}"
                                                Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" ToolTip="حذف"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- Payment dialog -->
        <md:DialogHost IsOpen="{Binding IsPaymentDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="440" MaxWidth="480" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E65100" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding ClosePaymentDialogCommand}" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="تسديد مبلغ" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding PaymentTransactionSummary}" FontSize="12" Foreground="#FFE0B2" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="24,20,24,8">
                            <TextBlock Text="المبلغ *" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding PaymentAmount, StringFormat=N0}" Style="{StaticResource NumericTextBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="تاريخ التسديد" Style="{StaticResource FormFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding PaymentDate}" Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,0,0,12"/>
                            <TextBlock Text="ملاحظات" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" MinHeight="60" AcceptsReturn="True"/>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تسديد" Command="{Binding SubmitPaymentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E65100" md:ButtonAssist.CornerRadius="8" Padding="28,10" Margin="0,0,8,0"/>
                                <Button Content="إغلاق" Command="{Binding ClosePaymentDialogCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Detail dialog -->
        <md:DialogHost IsOpen="{Binding IsDetailDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="820" MaxWidth="920" MaxHeight="720" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E65100" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseDetailDialogCommand}" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="تفاصيل العملية" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DetailTransaction.TransactionNumber}" FontSize="14" FontWeight="SemiBold" Foreground="#FFE0B2"/>
                                    <TextBlock Text="  •  " Foreground="#FFCC80"/>
                                    <TextBlock Text="{Binding DetailTransaction.TradeType}" FontSize="13" Foreground="#FFE0B2"/>
                                    <TextBlock Text="  •  " Foreground="#FFCC80"/>
                                    <TextBlock Text="{Binding DetailTransaction.Status}" FontSize="13" Foreground="#FFE0B2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20" DataContext="{Binding DetailTransaction}">
                            <StackPanel>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="بيانات العملية" FontWeight="Bold" Foreground="#E65100" FontSize="14" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="رقم العملية" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding TransactionNumber}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="التاريخ" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding TransactionDate}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="نوع العملية" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding TradeType}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="السيارة" FontWeight="Bold" Foreground="#E65100" FontSize="14" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="اسم السيارة" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding CarName}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="النوع" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding CarType}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="اللوحة" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding PlateNumber}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="الشاصي" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding ChassisNumber}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="الأطراف" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="البائع" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding SellerName}" Style="{StaticResource DetailValue}"/>
                                                <TextBlock Text="{Binding SellerPhone}" Style="{StaticResource DetailLabel}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="المشتري" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding BuyerName}" Style="{StaticResource DetailValue}"/>
                                                <TextBlock Text="{Binding BuyerPhone}" Style="{StaticResource DetailLabel}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="المبالغ" FontWeight="Bold" Foreground="#2E7D32" FontSize="14" Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="الإجمالي" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding TotalAmount}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="المدفوع" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding AmountPaid}" Style="{StaticResource DetailValue}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Style="{StaticResource DetailFieldPanel}">
                                                <TextBlock Text="المتبقي" Style="{StaticResource DetailLabel}"/>
                                                <TextBlock Text="{Binding RemainingAmount}" Style="{StaticResource DetailValue}" Foreground="#C62828"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="طريقة الدفع" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Text="{Binding PaymentMode}" Style="{StaticResource DetailValue}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="سجل التسديدات" FontWeight="Bold" Foreground="#1565C0" FontSize="14" Margin="0,0,0,12"/>
                                        <DataGrid ItemsSource="{Binding Payments}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="التاريخ" Binding="{Binding PaymentDate}" Width="100"/>
                                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="100"/>
                                                <DataGridTextColumn Header="قبل" Binding="{Binding RemainingBefore}" Width="90"/>
                                                <DataGridTextColumn Header="بعد" Binding="{Binding RemainingAfter}" Width="90"/>
                                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="ملاحظات" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock Text="{Binding Notes}" Style="{StaticResource DetailValue}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DetailPrintCommand}" Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8" Padding="16,8" Margin="0,0,8,0" IsEnabled="{Binding CanPrint}">
                                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Printer" Margin="0,0,6,0"/><TextBlock Text="طباعة"/></StackPanel>
                                </Button>
                                <Button Command="{Binding DetailEditCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E65100" md:ButtonAssist.CornerRadius="8" Padding="16,8" Margin="0,0,8,0" IsEnabled="{Binding CanEdit}">
                                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="PencilOutline" Margin="0,0,6,0"/><TextBlock Text="تعديل"/></StackPanel>
                                </Button>
                                <Button Command="{Binding DetailDeleteCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#C62828" md:ButtonAssist.CornerRadius="8" Padding="16,8" Margin="0,0,8,0" IsEnabled="{Binding CanDelete}">
                                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="DeleteOutline" Margin="0,0,6,0"/><TextBlock Text="حذف"/></StackPanel>
                                </Button>
                                <Button Command="{Binding CloseDetailDialogCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="16,8">
                                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Close" Margin="0,0,6,0"/><TextBlock Text="إغلاق"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Delete dialog -->
        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="400" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#C62828" Padding="20,14" CornerRadius="16,16,0,0">
                            <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Grid.Row="1" Margin="24,20,24,8" FontSize="14" TextWrapping="Wrap">
                            <Run Text="هل أنت متأكد من حذف العملية "/>
                            <Run Text="{Binding TransactionToDelete.TransactionNumber, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
