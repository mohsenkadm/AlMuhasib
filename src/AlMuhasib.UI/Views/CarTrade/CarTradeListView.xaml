<UserControl x:Class="AlMuhasib.UI.Views.CarTrade.CarTradeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource FormFieldLabel}">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DetailFieldPanel" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="DetailSectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="AvailableRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSold}" Value="False">
                    <Setter Property="Background" Value="#E8F5E9"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CarTradeCardTemplate">
            <md:Card Width="320" Margin="8" Padding="16" md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding CarName}" FontSize="16" FontWeight="Bold" Foreground="#E65100" TextWrapping="Wrap"/>
                        <Border Grid.Column="1" CornerRadius="8" Padding="8,4" Margin="8,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSold}" Value="True">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SoldStatus}" FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSold}" Value="True">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <TextBlock Margin="0,0,0,4">
                        <Run Text="رقم العملية: " Foreground="#78909C"/>
                        <Run Text="{Binding TransactionNumber}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4">
                        <Run Text="البائع: " Foreground="#78909C"/>
                        <Run Text="{Binding SellerName}"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4" Visibility="{Binding IsSold, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Run Text="المشتري: " Foreground="#78909C"/>
                        <Run Text="{Binding BuyerName}"/>
                    </TextBlock>
                    <UniformGrid Columns="2" Margin="0,8,0,12">
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Text="متبقي بائع" FontSize="11" Foreground="#78909C"/>
                            <TextBlock Text="{Binding RemainingAmount, StringFormat=N0}" FontWeight="Bold" Foreground="#C62828"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="متبقي مشتري" FontSize="11" Foreground="#78909C"/>
                            <TextBlock Text="{Binding SaleRemainingAmount, StringFormat=N0}" FontWeight="Bold" Foreground="#1565C0"/>
                        </StackPanel>
                    </UniformGrid>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource TableViewIconButton}"
                                Command="{Binding DataContext.ViewTransactionDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="عرض التفاصيل" Margin="2">
                            <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                Command="{Binding DataContext.OpenSellDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="بيع"
                                IsEnabled="{Binding CanSell}" Margin="2">
                            <md:PackIcon Kind="CashRegister" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                Command="{Binding DataContext.OpenPurchasePaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="تسديد بائع"
                                IsEnabled="{Binding CanPaySeller}" Margin="2">
                            <md:PackIcon Kind="CashPlus" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                Command="{Binding DataContext.OpenSalePaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="تسديد مشتري"
                                IsEnabled="{Binding CanPayBuyer}" Margin="2">
                            <md:PackIcon Kind="CashCheck" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TablePrintIconButton}"
                                Command="{Binding DataContext.PrintPurchaseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="طباعة شراء"
                                IsEnabled="{Binding DataContext.CanPrint, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="2">
                            <md:PackIcon Kind="PrinterOutline" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TablePrintIconButton}"
                                Command="{Binding DataContext.PrintSaleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="طباعة بيع"
                                IsEnabled="{Binding IsSold}" Margin="2">
                            <md:PackIcon Kind="PrinterCheck" Width="18" Height="18"/>
                        </Button>
                        <Button Style="{StaticResource TableEditIconButton}"
                                Command="{Binding DataContext.EditTransactionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="تعديل"
                                IsEnabled="{Binding IsSold, Converter={StaticResource InverseBooleanConverter}}" Margin="2">
                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </md:Card>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12" md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="إدارة العمليات" FontSize="16" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Command="{Binding OpenNewTransactionCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#E65100" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CarArrowRight" Margin="0,0,6,0"/>
                            <TextBlock Text="شراء سيارة"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadTransactionsCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Refresh" Margin="0,0,6,0"/><TextBlock Text="تحديث"/></StackPanel>
                    </Button>
                    <TextBox md:HintAssist.Hint="بحث..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBox}" MinWidth="200" Margin="0,0,8,8"/>
                    <DatePicker md:HintAssist.Hint="من" SelectedDate="{Binding DateFrom}" Width="140" Margin="0,0,8,8"/>
                    <DatePicker md:HintAssist.Hint="إلى" SelectedDate="{Binding DateTo}" Width="140" Margin="0,0,8,8"/>
                    <CheckBox Content="غير مسددة فقط" IsChecked="{Binding UnpaidOnly}" VerticalAlignment="Center" Margin="0,0,8,8"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton Content="الكل" GroupName="SoldFilter" IsChecked="{Binding IsSoldFilterAll, Mode=OneWay}"
                                 Command="{Binding SetSoldFilterAllCommand}" Margin="0,0,12,0"/>
                    <RadioButton Content="متوفرة" GroupName="SoldFilter" IsChecked="{Binding IsSoldFilterAvailable, Mode=OneWay}"
                                 Command="{Binding SetSoldFilterAvailableCommand}" Margin="0,0,12,0"/>
                    <RadioButton Content="مباعة" GroupName="SoldFilter" IsChecked="{Binding IsSoldFilterSold, Mode=OneWay}"
                                 Command="{Binding SetSoldFilterSoldCommand}"/>
                </StackPanel>
            </StackPanel>
        </md:Card>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,12">
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="العدد" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalCount}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="متوفرة" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryAvailableCount}" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="مباعة" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummarySoldCount}" FontSize="20" FontWeight="Bold" Foreground="#E65100"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="قيمة الشراء" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalAmount, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="المدفوع" Foreground="#78909C" FontSize="12"/><TextBlock Text="{Binding SummaryTotalPaid, StringFormat=N0}" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></md:Card>
            <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="ديون" Foreground="#78909C" FontSize="12"/><TextBlock FontSize="18" FontWeight="Bold" Foreground="#C62828"><Run Text="{Binding SummaryTotalRemaining, StringFormat=N0}"/><Run Text=" / "/><Run Text="{Binding SummarySaleRemaining, StringFormat=N0}"/></TextBlock></StackPanel></md:Card>
        </UniformGrid>

        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة العمليات"
                                             TargetDataGrid="{Binding ElementName=TransactionsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportExcelCommand}"
                                             PrintCommand="{Binding PrintAllCommand}"
                                             ShowCardToggle="True"/>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="TransactionsGrid"
                              ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource AvailableRowStyle}"
                              md:DataGridAssist.CellPadding="10 8" FontSize="13" Margin="8,4,8,0"
                              Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العملية" Binding="{Binding TransactionNumber}" Width="110"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TransactionNumber">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#E65100"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=yyyy/MM/dd}" Width="95"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TransactionDate"/>
                            <DataGridTextColumn Header="السيارة" Binding="{Binding CarName}" Width="*"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CarName"/>
                            <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SellerName"/>
                            <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BuyerName"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding SoldStatus}" Width="80"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SoldStatus"/>
                            <DataGridTextColumn Header="شراء" Binding="{Binding PurchasePrice, StringFormat=N0}" Width="90"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PurchasePrice"/>
                            <DataGridTextColumn Header="متبقي بائع" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="95"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="بيع" Binding="{Binding SalePrice, StringFormat=N0}" Width="90"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SalePrice"/>
                            <DataGridTextColumn Header="متبقي مشتري" Binding="{Binding SaleRemainingAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SaleRemainingAmount">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#1565C0"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="الإجراءات" Width="390" MinWidth="390"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource TableViewIconButton}"
                                                    Command="{Binding DataContext.ViewTransactionDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="عرض التفاصيل">
                                                <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableSecondaryIconButton}"
                                                    Command="{Binding DataContext.OpenSellDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="بيع"
                                                    IsEnabled="{Binding CanSell}">
                                                <md:PackIcon Kind="CashRegister" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableSecondaryIconButton}"
                                                    Command="{Binding DataContext.OpenPurchasePaymentDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="تسديد بائع"
                                                    IsEnabled="{Binding CanPaySeller}">
                                                <md:PackIcon Kind="CashPlus" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableSecondaryIconButton}"
                                                    Command="{Binding DataContext.OpenSalePaymentDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="تسديد مشتري"
                                                    IsEnabled="{Binding CanPayBuyer}">
                                                <md:PackIcon Kind="CashCheck" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TablePrintIconButton}"
                                                    Command="{Binding DataContext.PrintPurchaseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="طباعة شراء"
                                                    IsEnabled="{Binding DataContext.CanPrint, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                                <md:PackIcon Kind="PrinterOutline" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TablePrintIconButton}"
                                                    Command="{Binding DataContext.PrintSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="طباعة بيع"
                                                    IsEnabled="{Binding IsSold}">
                                                <md:PackIcon Kind="PrinterCheck" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableEditIconButton}"
                                                    Command="{Binding DataContext.EditTransactionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="تعديل"
                                                    IsEnabled="{Binding IsSold, Converter={StaticResource InverseBooleanConverter}}">
                                                <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableDeleteIconButton}"
                                                    Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" ToolTip="حذف"
                                                    IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Transactions}" ItemTemplate="{StaticResource CarTradeCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- Payment dialog -->
        <md:DialogHost IsOpen="{Binding IsPaymentDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="440" MaxWidth="480" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E65100" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding ClosePaymentDialogCommand}" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="{Binding PaymentDialogTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding PaymentTransactionSummary}" FontSize="12" Foreground="#FFE0B2" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="24,20,24,8">
                            <TextBlock Text="المبلغ المدفوع *" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}" Margin="0,0,0,12"/>
                            <TextBlock Text="تاريخ التسديد" Style="{StaticResource FormFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding PaymentDate}" Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,0,0,12"/>
                            <TextBlock Text="ملاحظات" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" MinHeight="60" AcceptsReturn="True"/>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تسديد" Command="{Binding SubmitPaymentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#E65100" md:ButtonAssist.CornerRadius="8" Padding="28,10" Margin="0,0,8,0"/>
                                <Button Content="إغلاق" Command="{Binding ClosePaymentDialogCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Sell dialog -->
        <md:DialogHost IsOpen="{Binding IsSellDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="500" MaxWidth="560" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#2E7D32" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseSellDialogCommand}" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="بيع سيارة من المعرض" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SelectedTransaction.CarName}" FontSize="12" Foreground="#C8E6C9" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="24,20,24,8">
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="اسم المشتري *" Style="{StaticResource FormFieldLabel}"/>
                                    <TextBox Text="{Binding SellBuyerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="هاتف المشتري" Style="{StaticResource FormFieldLabel}"/>
                                    <TextBox Text="{Binding SellBuyerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="سعر البيع *" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding SellPrice, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="18" FontWeight="Bold" MinHeight="48"/>
                            </StackPanel>
                            <TextBlock Text="طريقة الدفع من المشتري" Style="{StaticResource FormFieldLabel}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ToggleButton Content="نقدي" IsChecked="{Binding IsSellCash, Mode=OneWay}" Command="{Binding SetSellCashCommand}" Margin="0,0,8,0" Padding="20,10" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"/>
                                <ToggleButton Content="آجل" IsChecked="{Binding IsSellCredit, Mode=OneWay}" Command="{Binding SetSellCreditCommand}" Padding="20,10" Style="{StaticResource MaterialDesignFlatPrimaryToggleButton}"/>
                            </StackPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,8,12">
                                    <TextBlock Text="المبلغ المدفوع" Style="{StaticResource FormFieldLabel}"/>
                                    <TextBox Text="{Binding SellAmountPaid, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource NumericTextBox}"
                                             FontSize="16" FontWeight="SemiBold" MinHeight="48"/>
                                </StackPanel>
                                <StackPanel Margin="8,0,0,12">
                                    <TextBlock Text="المتبقي على المشتري" Style="{StaticResource FormFieldLabel}"/>
                                    <TextBox Text="{Binding SellRemainingAmount, StringFormat=N0}" IsReadOnly="True"
                                             Style="{StaticResource FilledTextBox}" Background="#E3F2FD" Foreground="#1565C0"
                                             FontSize="16" FontWeight="Bold" MinHeight="48"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="تاريخ البيع" Style="{StaticResource FormFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding SellDate}" Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,0,0,12"/>
                            <TextBlock Text="ملاحظات" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding SellNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" MinHeight="50" AcceptsReturn="True"/>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ البيع" Command="{Binding SubmitSellCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" md:ButtonAssist.CornerRadius="8" Padding="28,10" Margin="0,0,8,0"/>
                                <Button Content="إلغاء" Command="{Binding CloseSellDialogCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Detail dialog -->
        <md:DialogHost IsOpen="{Binding IsDetailDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="820" MaxWidth="920" MaxHeight="720" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E65100" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseDetailDialogCommand}" HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="تفاصيل العملية" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DetailTransaction.TransactionNumber}" FontSize="14" FontWeight="SemiBold" Foreground="#FFE0B2"/>
                                    <TextBlock Text="  •  " Foreground="#FFCC80"/>
                                    <TextBlock Text="{Binding DetailTransaction.SoldStatus}" FontSize="13" Foreground="#FFE0B2"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20" DataContext="{Binding DetailTransaction}">
                            <StackPanel>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="السيارة" FontWeight="Bold" Foreground="#E65100" FontSize="14" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding CarName}" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Text="{Binding ChassisNumber}" Style="{StaticResource DetailLabel}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}">
                                    <StackPanel>
                                        <TextBlock Text="البائع" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding SellerName}" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Text="شراء" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock><Run Text="الإجمالي: "/><Run Text="{Binding PurchasePrice}" FontWeight="Bold"/><Run Text=" — متبقي: "/><Run Text="{Binding RemainingAmount}" Foreground="#C62828" FontWeight="Bold"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource DetailSectionCard}" Visibility="{Binding IsSold, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="المشتري" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding BuyerName}" Style="{StaticResource DetailValue}"/>
                                        <TextBlock Text="بيع" Style="{StaticResource DetailLabel}"/>
                                        <TextBlock><Run Text="الإجمالي: "/><Run Text="{Binding SalePrice}" FontWeight="Bold"/><Run Text=" — متبقي: "/><Run Text="{Binding SaleRemainingAmount}" Foreground="#1565C0" FontWeight="Bold"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding DetailPrintCommand}" Style="{StaticResource PrimaryButton}" md:ButtonAssist.CornerRadius="8" Padding="16,8" Margin="0,0,8,0" IsEnabled="{Binding CanPrint}">
                                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Printer" Margin="0,0,6,0"/><TextBlock Text="طباعة"/></StackPanel>
                                </Button>
                                <Button Command="{Binding CloseDetailDialogCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="16,8">
                                    <StackPanel Orientation="Horizontal"><md:PackIcon Kind="Close" Margin="0,0,6,0"/><TextBlock Text="إغلاق"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Delete dialog -->
        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="400" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#C62828" Padding="20,14" CornerRadius="16,16,0,0">
                            <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Grid.Row="1" Margin="24,20,24,8" FontSize="14" TextWrapping="Wrap">
                            <Run Text="هل أنت متأكد من حذف العملية "/>
                            <Run Text="{Binding TransactionToDelete.TransactionNumber, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حذف" Command="{Binding DeleteConfirmedCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#C62828" md:ButtonAssist.CornerRadius="8" Padding="28,10" Margin="0,0,8,0"/>
                                <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
