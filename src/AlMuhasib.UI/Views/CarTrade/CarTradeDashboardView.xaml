<UserControl x:Class="AlMuhasib.UI.Views.CarTrade.CarTradeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="عملية جديدة" Command="{Binding OpenNewTransactionCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Plus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

<ScrollViewer Padding="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="لوحة التحكم — بيع وشراء السيارات" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenNewTransactionCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#E65100" md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="SwapHorizontal" Margin="0,0,6,0"/>
                            <TextBlock Text="عملية جديدة"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenTransactionsCommand}" Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FormatListBulleted" Margin="0,0,6,0"/>
                            <TextBlock Text="العمليات"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="عمليات اليوم" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TodayTransactions}" FontSize="24" FontWeight="Bold" Foreground="#E65100"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="عمليات الشهر" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding MonthTransactions}" FontSize="24" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="غير مسددة" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding UnpaidTransactions}" FontSize="24" FontWeight="Bold" Foreground="#C62828"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="المتبقي الكلي" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalRemaining, StringFormat=N0}" FontSize="24" FontWeight="Bold" Foreground="#C62828"/></StackPanel></md:Card>
            </UniformGrid>

            <UniformGrid Columns="4" Margin="0,0,0,16">
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="عمليات شراء" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding BuyCount}" FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="عمليات بيع" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding SellCount}" FontSize="22" FontWeight="Bold" Foreground="#E65100"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="قيمة الشراء" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalBuyValue, StringFormat=N0}" FontSize="22" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="قيمة البيع" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="{Binding TotalSellValue, StringFormat=N0}" FontSize="22" FontWeight="Bold"/></StackPanel></md:Card>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <md:Card Grid.Column="0" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="الشراء الشهري" FontWeight="Bold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding MonthlyBuySeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}" Height="240"/>
                    </StackPanel>
                </md:Card>
                <md:Card Grid.Column="1" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="البيع الشهري" FontWeight="Bold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding MonthlySellSeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}" Height="240"/>
                    </StackPanel>
                </md:Card>
                <md:Card Grid.Column="2" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="حالة التسديد" FontWeight="Bold" Margin="0,0,0,8"/>
                        <lvc:PieChart Series="{Binding StatusSeries}" Height="240"/>
                    </StackPanel>
                </md:Card>
            </Grid>

            <md:Card Padding="12" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="أحدث العمليات" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding RecentTransactions}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم" Binding="{Binding TransactionNumber}" Width="100"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding TradeType}" Width="70"/>
                            <DataGridTextColumn Header="السيارة" Binding="{Binding CarName}" Width="*"/>
                            <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"/>
                            <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
