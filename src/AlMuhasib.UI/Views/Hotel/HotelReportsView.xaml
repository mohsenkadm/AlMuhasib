<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <md:Card Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,12">
            <WrapPanel>
                <DatePicker md:HintAssist.Hint="من" SelectedDate="{Binding DateFrom}" Width="140" Margin="0,0,8,8"/>
                <DatePicker md:HintAssist.Hint="إلى" SelectedDate="{Binding DateTo}" Width="140" Margin="0,0,8,8"/>
                <DatePicker md:HintAssist.Hint="تاريخ المراجعة" SelectedDate="{Binding AuditDate}" Width="160" Margin="0,0,8,8"/>
                <Button Command="{Binding LoadCurrentTabCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"><TextBlock Text="تحديث"/></Button>
            </WrapPanel>
        </md:Card>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="الإشغال">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="متوسط الإشغال:" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding OccupancyRate}" Margin="0,0,24,0"/>
                        <TextBlock Text="ليالي مباعة:" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SoldRoomNights}"/>
                    </StackPanel>
                    <controls:ListTableHeaderBar Grid.Row="1"
                                                 Title="تقرير الإشغال"
                                                 TargetDataGrid="{Binding ElementName=OccupancyGrid}"
                                                 IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 ExportCommand="{Binding ExportExcelCommand}"
                                                 ShowPrint="False"
                                                 ShowCardToggle="False"
                                                 Margin="0,0,0,8"/>
                    <DataGrid x:Name="OccupancyGrid" Grid.Row="2"
                              ItemsSource="{Binding OccupancyRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120" MinWidth="100"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                            <DataGridTextColumn Header="المشغولة" Binding="{Binding OccupiedRooms}" Width="100" MinWidth="80"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="OccupiedRooms"/>
                            <DataGridTextColumn Header="المتاحة" Binding="{Binding AvailableRooms}" Width="100" MinWidth="80"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AvailableRooms"/>
                            <DataGridTextColumn Header="الإشغال %" Binding="{Binding OccupancyRate}" Width="110" MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="OccupancyRate"/>
                            <DataGridTextColumn Header="الوصول" Binding="{Binding Arrivals}" Width="100" MinWidth="80"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Arrivals"/>
                            <DataGridTextColumn Header="المغادرة" Binding="{Binding Departures}" Width="100" MinWidth="80"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Departures"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="الإيرادات">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="إيراد الغرف:" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalRoomRevenue, StringFormat=N0}" Margin="0,0,24,0"/>
                        <TextBlock Text="المدفوعات:" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalPayments, StringFormat=N0}" Margin="0,0,24,0"/>
                        <TextBlock Text="المستحق:" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding OutstandingBalance, StringFormat=N0}"/>
                    </StackPanel>
                    <controls:ListTableHeaderBar Grid.Row="1"
                                                 Title="تقرير الإيرادات"
                                                 TargetDataGrid="{Binding ElementName=RevenueGrid}"
                                                 IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 ExportCommand="{Binding ExportExcelCommand}"
                                                 ShowPrint="False"
                                                 ShowCardToggle="False"
                                                 Margin="0,0,0,8"/>
                    <DataGrid x:Name="RevenueGrid" Grid.Row="2"
                              ItemsSource="{Binding RevenueRows}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="120" MinWidth="100"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                            <DataGridTextColumn Header="رقم الحجز" Binding="{Binding ReservationNumber}" Width="120" MinWidth="100"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ReservationNumber"/>
                            <DataGridTextColumn Header="النزيل" Binding="{Binding GuestName}" Width="2*" MinWidth="140"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GuestName"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" Width="120" MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalAmount"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="120" MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="المراجعة الليلية">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <StackPanel><TextBlock Text="الغرف" Foreground="#78909C"/><TextBlock Text="{Binding AuditTotalRooms}" FontWeight="Bold"/></StackPanel>
                        <StackPanel><TextBlock Text="المشغولة" Foreground="#78909C"/><TextBlock Text="{Binding AuditOccupiedRooms}" FontWeight="Bold"/></StackPanel>
                        <StackPanel><TextBlock Text="إيراد الغرف" Foreground="#78909C"/><TextBlock Text="{Binding AuditRoomRevenue, StringFormat=N0}" FontWeight="Bold"/></StackPanel>
                        <StackPanel><TextBlock Text="التحصيل" Foreground="#78909C"/><TextBlock Text="{Binding AuditPaymentsCollected, StringFormat=N0}" FontWeight="Bold"/></StackPanel>
                    </UniformGrid>
                    <controls:ListTableHeaderBar Grid.Row="1"
                                                 Title="المراجعة الليلية"
                                                 TargetDataGrid="{Binding ElementName=NightAuditGrid}"
                                                 IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 ExportCommand="{Binding ExportExcelCommand}"
                                                 ShowPrint="False"
                                                 ShowCardToggle="False"
                                                 Margin="0,0,0,8"/>
                    <DataGrid x:Name="NightAuditGrid" Grid.Row="2"
                              ItemsSource="{Binding NightAuditInHouse}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الحجز" Binding="{Binding ReservationNumber}" Width="120" MinWidth="100"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ReservationNumber"/>
                            <DataGridTextColumn Header="النزيل" Binding="{Binding GuestName}" Width="2*" MinWidth="140"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GuestName"/>
                            <DataGridTextColumn Header="الغرفة" Binding="{Binding RoomNumber}" Width="100" MinWidth="80"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RoomNumber"/>
                            <DataGridTextColumn Header="المغادرة" Binding="{Binding CheckOutDate, StringFormat=yyyy/MM/dd}" Width="120" MinWidth="100"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CheckOutDate"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="120" MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
