<UserControl x:Class="AlMuhasib.UI.Views.Hotel.RestaurantPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Loading -->
        <Border Grid.RowSpan="2" Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تحميل الكاشير..." Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="14" Padding="20,14" Margin="0,0,0,12"
                Background="{StaticResource RestaurantPosHeaderBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="كاشير المطعم" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="#33FFFFFF" CornerRadius="6" Padding="8,2" Margin="12,0,0,0"
                                Visibility="{Binding HasActiveOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="طلب #"/>
                                <Run Text="{Binding CurrentOrderNumber, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="10" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="طاولات مشغولة" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding OccupiedTablesCount, Mode=OneWay}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#26FFFFFF" CornerRadius="10" Padding="14,8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="السلة" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CartLineCount, StringFormat='{}{0} صنف'}" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#26FFFFFF" CornerRadius="10" Padding="14,8">
                    <StackPanel>
                        <TextBlock Text="الإجمالي" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Read-only banner -->
        <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8" VerticalAlignment="Top" Panel.ZIndex="5"
                Visibility="{Binding ShowReadOnlyBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <md:PackIcon Kind="LockOutline" Foreground="#E65100" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="8,0,0,0" Foreground="#6D4C41" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="200"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <md:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="14" Margin="0,0,8,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="نوع الطلب" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,12">
                            <RadioButton Content="صالة" GroupName="RestaurantOrderType" Margin="0,0,0,4"
                                         IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DineIn, Mode=TwoWay}"/>
                            <RadioButton Content="سفري" GroupName="RestaurantOrderType" Margin="0,0,0,4"
                                         IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Takeaway, Mode=TwoWay}"/>
                            <RadioButton Content="خدمة غرف" GroupName="RestaurantOrderType"
                                         IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RoomService, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDineIn, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="اختر الطاولة" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Tables}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="0" Margin="4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                                    <Setter Property="Width" Value="68"/>
                                                    <Setter Property="Height" Value="68"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Tile" CornerRadius="10" Background="#00897B">
                                                                    <TextBlock Text="{Binding TableNumber}" Foreground="White" FontWeight="Bold" FontSize="16"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:RestaurantTableStatus.Occupied}">
                                                                        <Setter TargetName="Tile" Property="Background" Value="#E65100"/>
                                                                        <Setter Property="IsEnabled" Value="False"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.SelectedTable.Id, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{Binding Id}">
                                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White"/>
                                                                        <Setter TargetName="Tile" Property="BorderThickness" Value="3"/>
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsRoomService, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,12">
                            <TextBlock Text="الغرفة" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ActiveRooms}" SelectedItem="{Binding SelectedRoom}"
                                      DisplayMemberPath="RoomNumber" Style="{StaticResource FilledComboBox}"/>
                        </StackPanel>

                        <Button Command="{Binding StartNewOrderCommand}" Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8" Margin="0,0,0,12" IsEnabled="{Binding CanAdd}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="طلب جديد"/>
                            </StackPanel>
                        </Button>

                        <Separator Margin="0,4,0,12"/>
                        <TextBlock Text="الفئات" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chip" CornerRadius="8" Padding="10,8"
                                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Chip" Property="BorderBrush" Value="White"/>
                                                        <Setter TargetName="Chip" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </md:Card>

            <!-- Products -->
            <md:Card Grid.Column="1" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="الأصناف السريعة" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding FavoriteItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource RestaurantPosMenuTile}" MinWidth="110" MinHeight="56"
                                            Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SalePrice, StringFormat='{}{0:N0}'}" FontSize="11" Opacity="0.75"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBox x:Name="SearchBox" Grid.Row="2" md:HintAssist.Hint="بحث بالاسم أو الباركود — Enter للإضافة"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12" KeyDown="SearchBox_KeyDown"/>

                    <Grid Grid.Row="3">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MenuItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RestaurantPosMenuTile}"
                                                Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsActive}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SalePrice, StringFormat='{}{0:N0} د.ع'}" FontSize="12" Opacity="0.75" Margin="0,4,0,0"/>
                                                <TextBlock Text="غير متاح" FontSize="10" Foreground="#C62828" Margin="0,4,0,0"
                                                           Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="لا توجد أصناف في هذه الفئة" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource HintForegroundBrush}" FontSize="14"
                                   Visibility="{Binding HasMenuItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </md:Card>

            <!-- Cart -->
            <md:Card Grid.Column="2" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="السلة" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <DataGrid ItemsSource="{Binding CartLines}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الصنف" Binding="{Binding ItemName}" Width="*" MinWidth="100"/>
                                <DataGridTemplateColumn Header="الكمية" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource TableSecondaryIconButton}" Content="−"
                                                        Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat=N0}" VerticalAlignment="Center" Margin="8,0" MinWidth="24" TextAlignment="Center"/>
                                                <Button Style="{StaticResource TableSecondaryIconButton}" Content="+"
                                                        Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="المجموع" Binding="{Binding LineTotal, StringFormat=N0}" Width="80"/>
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TableDeleteIconButton}"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsCartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <md:PackIcon Kind="CartOutline" Width="48" Height="48" Foreground="{DynamicResource HintForegroundBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="السلة فارغة — أضف أصنافاً من القائمة" Margin="0,12,0,0"
                                       Foreground="{DynamicResource HintForegroundBrush}" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Background="{DynamicResource MaterialDesignDivider}" CornerRadius="8" Padding="12" Margin="0,12,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الفرعي" Opacity="0.8"/>
                                <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:N0} د.ع'}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الخصم" VerticalAlignment="Center" Opacity="0.8"/>
                                <TextBox Grid.Column="1" Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource OutlinedTextBox}" IsEnabled="{Binding CanAdd}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الإجمالي" FontWeight="Bold"/>
                                <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontWeight="Bold" FontSize="16"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Command="{Binding OpenPaymentDialogCommand}" Style="{StaticResource PrimaryButton}"
                                Height="44" Padding="20,0" md:ButtonAssist.CornerRadius="10" Margin="0,0,8,0"
                                IsEnabled="{Binding CanAdd}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CashCheck" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="إتمام الدفع" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelCurrentOrderCommand}" Style="{StaticResource FlatButton}"
                                Height="44" Content="إلغاء الطلب" IsEnabled="{Binding CanAdd}"/>
                    </StackPanel>
                </Grid>
            </md:Card>
        </Grid>

        <md:DialogHost IsOpen="{Binding IsPaymentDialogOpen}" CloseOnClickAway="False"
                       Style="{StaticResource ModernDialogHost}" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="400">
                    <StackPanel>
                        <TextBlock Text="إتمام الدفع" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBlock Margin="0,0,0,12" Opacity="0.8">
                            <Run Text="المبلغ المستحق:"/>
                            <Run Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontWeight="Bold"/>
                        </TextBlock>

                        <Border Background="#E8F5E9" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                Visibility="{Binding IsRoomService, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="يُحاسَب على الغرفة — لا حاجة لدفع نقدي" TextWrapping="Wrap" Foreground="#2E7D32"/>
                        </Border>

                        <StackPanel Visibility="{Binding ShowCashPaymentFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ComboBox md:HintAssist.Hint="طريقة الدفع" ItemsSource="{Binding PaymentMethodOptions}"
                                      SelectedItem="{Binding PaymentMethod}" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RestaurantEnumLabelConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox md:HintAssist.Hint="الصندوق" ItemsSource="{Binding CashBoxes}"
                                      SelectedValuePath="Id" SelectedValue="{Binding PaymentCashBoxId}"
                                      DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="المبلغ المدفوع" Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                            <TextBlock Margin="0,0,0,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChangeDue, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="الباقي:"/>
                                <Run Text="{Binding ChangeDue, StringFormat='{}{0:N0} د.ع', Mode=OneWay}" FontWeight="Bold" Foreground="#2E7D32"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تأكيد الدفع" Command="{Binding ConfirmPaymentCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding ClosePaymentDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
