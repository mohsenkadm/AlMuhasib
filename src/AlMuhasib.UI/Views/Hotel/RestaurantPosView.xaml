<UserControl x:Class="AlMuhasib.UI.Views.Hotel.RestaurantPosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading overlay -->
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}" Panel.ZIndex="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تجهيز الكاشير..." Margin="0,12,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Top bar ═══ -->
            <Border Grid.Row="0" Style="{StaticResource RestaurantPosTopBar}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Order type segmented -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Style="{StaticResource RestaurantPosTypeChip}" Content="صالة"
                                     GroupName="PosOrderType"
                                     IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DineIn, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource RestaurantPosTypeChip}" Content="سفري"
                                     GroupName="PosOrderType"
                                     IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Takeaway, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource RestaurantPosTypeChip}" Content="غرف"
                                     GroupName="PosOrderType"
                                     IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=RoomService, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Context -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Background="#22FFFFFF" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="MapMarkerOutline" Width="16" Height="16" Foreground="#E0FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ContextLabel}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#33FFFFFF" CornerRadius="8" Padding="12,6"
                                Visibility="{Binding HasActiveOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="White" FontWeight="Bold">
                                <Run Text="{Binding CurrentOrderNumber, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#B3FFFFFF" FontSize="12"
                                   VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"/>
                    </StackPanel>

                    <!-- Compact metrics + new order -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource RestaurantPosMetricPill}" Margin="0,0,8,0">
                            <TextBlock>
                                <Run Text="مشغول " Foreground="#B3FFFFFF" FontSize="11"/>
                                <Run Text="{Binding OccupiedTablesCount, Mode=OneWay}" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            </TextBlock>
                        </Border>
                        <Button Command="{Binding StartNewOrderCommand}" Style="{StaticResource RestaurantPosGhostButton}"
                                IsEnabled="{Binding CanAdd}" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="طلب جديد" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Read-only -->
            <Border Grid.Row="1" Background="#FFF3E0" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding ShowReadOnlyBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="LockOutline" Foreground="#E65100" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Margin="8,0,0,0" Foreground="#6D4C41" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ═══ Main workspace: catalog | ticket ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="360" MinWidth="320" MaxWidth="420"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Catalog -->
                <Border Grid.Column="0" Style="{StaticResource RestaurantPosPanel}" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Context strip: tables / rooms -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Visibility="{Binding IsDineIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="الطاولات" FontWeight="Bold" FontSize="13" DockPanel.Dock="Right"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="برتقالي = استئناف" FontSize="11" Opacity="0.55"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Tables}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RestaurantPosTableButton}"
                                                        Command="{Binding DataContext.SelectTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TableNumber}" Foreground="White" FontWeight="Bold" FontSize="15"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock FontSize="9" Foreground="#E0FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="متاحة"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:RestaurantTableStatus.Occupied}">
                                                                            <Setter Property="Text" Value="استئناف"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsRoomService, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="الغرفة النشطة" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>
                                <ComboBox ItemsSource="{Binding ActiveRooms}" SelectedItem="{Binding SelectedRoom}"
                                          Style="{StaticResource FilledComboBox}" MaxWidth="420" HorizontalAlignment="Left" Width="320">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding RoomNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding GuestName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Categories + search -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,12,0">
                                <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                         Style="{StaticResource RestaurantPosCategoryBar}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     md:HintAssist.Hint="بحث / باركود"
                                     md:TextFieldAssist.HasClearButton="True"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"
                                     KeyDown="SearchBox_KeyDown"/>
                        </Grid>

                        <!-- Favorites -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8"
                                    Visibility="{Binding HasFavorites, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="الأكثر مبيعاً" FontSize="12" FontWeight="SemiBold" Opacity="0.65" Margin="0,0,0,6"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding FavoriteItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RestaurantPosFavoriteChip}"
                                                    Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding SalePrice, StringFormat='{}{0:N0}'}" Opacity="0.7"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Product grid -->
                        <Grid Grid.Row="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding MenuItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RestaurantPosMenuTile}"
                                                    Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsActive}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="48" VerticalAlignment="Center"/>
                                                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                                        <TextBlock Text="غير متاح" FontSize="11" Foreground="#C62828"
                                                                   DockPanel.Dock="Left"
                                                                   Visibility="{Binding IsActive, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding SalePrice, StringFormat='{}{0:N0} د.ع'}"
                                                                   FontSize="15" FontWeight="Bold" Foreground="#00695C"
                                                                   HorizontalAlignment="Left"/>
                                                    </DockPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasMenuItems, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <md:PackIcon Kind="FoodOff" Width="40" Height="40"
                                             Foreground="{DynamicResource HintForegroundBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="لا توجد أصناف في هذه الفئة" Margin="0,10,0,0"
                                           Foreground="{DynamicResource HintForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT: Ticket -->
                <Border Grid.Column="1" Style="{StaticResource RestaurantPosTicketPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Ticket header -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="{Binding TicketTitle}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#E0F2F1" CornerRadius="8" Padding="10,4" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding OrderTypeLabel}" Foreground="#00695C" FontWeight="SemiBold" FontSize="12"/>
                            </Border>
                        </DockPanel>

                        <!-- Open orders chips -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8"
                                    Visibility="{Binding OpenOrdersCount, Converter={StaticResource PositiveIntToVisibilityConverter}}">
                            <TextBlock Text="طلبات مفتوحة" FontSize="11" Opacity="0.6" Margin="0,0,0,6"/>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding OpenOrders}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RestaurantPosOpenOrderChip}"
                                                    Command="{Binding DataContext.ResumeOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding OrderNumber}" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock FontSize="10" Opacity="0.7">
                                                        <Run Text="{Binding TotalAmount, StringFormat='{}{0:N0}', Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Cart lines -->
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding IsCartEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding CartLines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource RestaurantPosCartLine}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N0} د.ع'}"
                                                                   FontSize="11" Opacity="0.55" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8" Padding="4,2" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Style="{StaticResource RestaurantPosQtyButton}" Content="−"
                                                                    Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                            <TextBlock Text="{Binding Quantity, StringFormat=N0}"
                                                                       MinWidth="28" TextAlignment="Center"
                                                                       VerticalAlignment="Center" FontWeight="Bold"/>
                                                            <Button Style="{StaticResource RestaurantPosQtyButton}" Content="+"
                                                                    Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N0}'}"
                                                                   FontWeight="Bold" VerticalAlignment="Center" MinWidth="56"
                                                                   TextAlignment="Left" Margin="0,0,4,0"/>
                                                        <Button Style="{StaticResource RestaurantPosRemoveLineButton}"
                                                                Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding DataContext.CanAdd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                ToolTip="حذف">
                                                            <md:PackIcon Kind="Close" Width="14" Height="14"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding IsCartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <md:PackIcon Kind="ReceiptTextOutline" Width="44" Height="44"
                                             Foreground="{DynamicResource HintForegroundBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="التذكرة فارغة" Margin="0,10,0,4" FontWeight="SemiBold"
                                           Foreground="{DynamicResource HintForegroundBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="اختر صنفاً من القائمة لإضافته" FontSize="12" Opacity="0.6"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Totals -->
                        <Border Grid.Row="3" Style="{StaticResource RestaurantPosTotalsBox}" Margin="0,10,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding SubTotal, StringFormat='{}{0:N0} د.ع'}" DockPanel.Dock="Left" Opacity="0.85"/>
                                    <TextBlock Text="المجموع الفرعي" Opacity="0.7"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBox Width="96" DockPanel.Dock="Left"
                                             Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OutlinedTextBox}" IsEnabled="{Binding CanAdd}"
                                             HorizontalContentAlignment="Center"/>
                                    <TextBlock Text="الخصم" Opacity="0.7" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Rectangle Height="1" Fill="#1A000000" Margin="0,0,0,10"/>
                                <DockPanel>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}"
                                               DockPanel.Dock="Left" FontSize="22" FontWeight="Bold" Foreground="#00695C"/>
                                    <TextBlock Text="الإجمالي" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.55"
                                           Text="{Binding CartLineCount, StringFormat='{}{0} صنف'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Actions -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenPaymentDialogCommand}"
                                    Style="{StaticResource RestaurantPosPayButton}"
                                    IsEnabled="{Binding CanAdd}" Height="52">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="CashRegister" Width="22" Height="22" VerticalAlignment="Center"/>
                                    <TextBlock Text="دفع" Margin="10,0,0,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding CancelCurrentOrderCommand}"
                                    Style="{StaticResource RestaurantPosCancelButton}"
                                    Content="إلغاء" IsEnabled="{Binding CanAdd}"
                                    Margin="8,0,0,0" Width="72" Height="52"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Payment dialog -->
        <md:DialogHost IsOpen="{Binding IsPaymentDialogOpen}" CloseOnClickAway="False"
                       Style="{StaticResource ModernDialogHost}" Panel.ZIndex="30">
            <md:DialogHost.DialogContent>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="28" MinWidth="420"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="إتمام الدفع" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Margin="0,0,0,16" Opacity="0.75">
                            <Run Text="المبلغ المستحق"/>
                            <Run Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontWeight="Bold" Foreground="#00695C"/>
                        </TextBlock>

                        <Border Background="#E8F5E9" CornerRadius="10" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding IsRoomService, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Bed" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="يُقيَّد على فاتورة الغرفة" TextWrapping="Wrap" Foreground="#2E7D32"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding ShowCashPaymentFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ComboBox md:HintAssist.Hint="طريقة الدفع" ItemsSource="{Binding PaymentMethodOptions}"
                                      SelectedItem="{Binding PaymentMethod}" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RestaurantEnumLabelConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <ComboBox md:HintAssist.Hint="الصندوق" ItemsSource="{Binding CashBoxes}"
                                      SelectedValuePath="Id" SelectedValue="{Binding PaymentCashBoxId}"
                                      DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="المبلغ المستلم"
                                     Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"
                                     IsEnabled="{Binding IsCashPayment}" FontSize="18" FontWeight="SemiBold"/>
                            <Border Background="#E8F5E9" CornerRadius="10" Padding="14" Margin="0,0,0,16"
                                    Visibility="{Binding ShowChangeDue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DockPanel>
                                    <TextBlock Text="{Binding ChangeDue, StringFormat='{}{0:N0} د.ع', Mode=OneWay}"
                                               DockPanel.Dock="Left" FontWeight="Bold" FontSize="18" Foreground="#2E7D32"/>
                                    <TextBlock Text="الباقي للعميل" VerticalAlignment="Center" Foreground="#2E7D32"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="تأكيد الدفع" Command="{Binding ConfirmPaymentCommand}"
                                    Style="{StaticResource RestaurantPosPayButton}" Height="48" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="إلغاء" Command="{Binding ClosePaymentDialogCommand}"
                                    Style="{StaticResource RestaurantPosCancelButton}" Width="88" Height="48"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
