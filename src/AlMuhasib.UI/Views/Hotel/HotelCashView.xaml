<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelCashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:hotelVm="clr-namespace:AlMuhasib.UI.ViewModels.Hotel"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <md:Card Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding OpenAddCashBoxDialogCommand}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0">
                    <TextBlock Text="صندوق جديد"/>
                </Button>
                <Button Command="{Binding OpenAddVoucherDialogCommand}" Style="{StaticResource OutlinedButton}" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0">
                    <TextBlock Text="سند جديد"/>
                </Button>
                <Button Command="{Binding LoadVouchersCommand}" Style="{StaticResource FlatButton}">
                    <md:PackIcon Kind="Refresh"/>
                </Button>
                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             TargetDataGrid="{Binding ElementName=VouchersGrid}"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"/>
            </StackPanel>
        </md:Card>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding CashBoxes}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <md:Card Padding="12" Margin="4" Width="180">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <Button HorizontalAlignment="Left" Style="{StaticResource FlatButton}" Padding="2" Command="{Binding DataContext.OpenEditCashBoxDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <md:PackIcon Kind="Pencil" Width="14" Height="14"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding CurrentBalance, StringFormat=N0}" FontSize="18" Foreground="#1565C0"/>
                        </StackPanel>
                    </md:Card>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DataGrid x:Name="VouchersGrid" Grid.Row="2" ItemsSource="{Binding Vouchers}" AutoGenerateColumns="False"
                  IsReadOnly="True" Style="{StaticResource HotelListDataGrid}" Margin="8"
                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="130" MinWidth="100"
                                    ElementStyle="{StaticResource HotelDataGridTextElement}"
                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherNumber"/>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate, StringFormat=yyyy/MM/dd}" Width="120" MinWidth="100"
                                    ElementStyle="{StaticResource HotelDataGridTextElement}"
                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherDate"/>
                <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="100" MinWidth="80"
                                    ElementStyle="{StaticResource HotelDataGridTextElement}"
                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Type"/>
                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120" MinWidth="90"
                                    ElementStyle="{StaticResource HotelDataGridTextElement}"
                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="2*" MinWidth="200"
                                    ElementStyle="{StaticResource HotelDataGridTextElement}"
                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description"/>
            </DataGrid.Columns>
        </DataGrid>
        <controls:PaginationBar Grid.Row="3"/>

        <md:DialogHost IsOpen="{Binding IsCashBoxDialogOpen}" CloseOnClickAway="False" Style="{StaticResource ModernDialogHost}" Grid.RowSpan="4">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="400">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="إضافة صندوق"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCashBoxEditMode}" Value="True">
                                            <Setter Property="Text" Value="تعديل صندوق"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox md:HintAssist.Hint="اسم الصندوق *" Text="{Binding EditCashBoxName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="الرصيد الافتتاحي" Text="{Binding EditOpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <CheckBox Content="حساب بنك" IsChecked="{Binding EditIsBank}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حفظ" Command="{Binding SaveCashBoxCommand}" Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CloseCashBoxDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsVoucherDialogOpen}" CloseOnClickAway="False" Style="{StaticResource ModernDialogHost}" Grid.RowSpan="4">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="420">
                    <StackPanel>
                        <TextBlock Text="سند قبض / صرف" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ComboBox md:HintAssist.Hint="نوع السند" ItemsSource="{Binding VoucherTypeOptions}" SelectedItem="{Binding EditVoucherType}" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                        <DatePicker md:HintAssist.Hint="التاريخ" SelectedDate="{Binding EditVoucherDate}" Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="المبلغ *" Text="{Binding EditVoucherAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <ComboBox md:HintAssist.Hint="الصندوق *" ItemsSource="{Binding CashBoxes}" SelectedValuePath="Id" SelectedValue="{Binding EditVoucherCashBoxId}" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="البيان" Text="{Binding EditVoucherDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="ملاحظات" Text="{Binding EditVoucherNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حفظ" Command="{Binding SaveVoucherCommand}" Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CloseVoucherDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
