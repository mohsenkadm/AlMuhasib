<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelFloorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="إدارة الطوابق"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8"
                            Padding="24,8"
                            Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="StairsUp" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="طابق جديد"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <controls:ColumnFilterToggle
                        IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                        ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                        ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                        TargetDataGrid="{Binding ElementName=FloorsGrid}"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"/>
                    <TextBox md:HintAssist.Hint="بحث..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="220"
                             Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- ═══ BOTTOM: Grid + Cards + Stats ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="قائمة الطوابق"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>

                        <controls:ListViewModeToggle Grid.Column="1"
                                                     OnDarkBackground="True"
                                                     VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Stats + Grid / Cards -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Stats bar -->
                    <controls:HotelListStatsBar Grid.Row="0"
                                                Margin="16,12,16,4"
                                                ItemsSource="{Binding Stats}"/>

                    <!-- Table mode -->
                    <DataGrid x:Name="FloorsGrid"
                              Grid.Row="1"
                              Margin="8"
                              ItemsSource="{Binding Floors}"
                              SelectedItem="{Binding SelectedFloor}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              Style="{StaticResource HotelListDataGrid}"
                              Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="120"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                            <DataGridTextColumn Header="الترتيب"
                                                Binding="{Binding SortOrder}"
                                                Width="120"
                                                MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SortOrder"/>
                            <DataGridTemplateColumn Header="الإجراءات"
                                                    Width="140"
                                                    MinWidth="140"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource TableEditIconButton}"
                                                    Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableDeleteIconButton}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}">
                                                <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Card mode -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Floors}"
                                      ItemTemplate="{StaticResource HotelFloorCardTemplate}"
                                      ItemsPanel="{StaticResource MasterDataCardWrapPanel}"/>
                    </ScrollViewer>
                </Grid>

                <!-- Footer: Pagination -->
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- Dialog -->
        <md:DialogHost IsOpen="{Binding IsDialogOpen}"
                       CloseOnClickAway="False"
                       Style="{StaticResource ModernDialogHost}"
                       Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <controls:HotelFormDialog Title="بيانات الطابق"
                                          IconKind="Stairs"
                                          SaveCommand="{Binding SaveCommand}"
                                          CloseCommand="{Binding CloseDialogCommand}"
                                          IsBusy="{Binding IsBusy}">
                    <controls:HotelFormDialog.DialogContent>
                        <StackPanel>
                            <TextBox md:HintAssist.Hint="اسم الطابق *"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="الترتيب"
                                     Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"/>
                        </StackPanel>
                    </controls:HotelFormDialog.DialogContent>
                </controls:HotelFormDialog>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
