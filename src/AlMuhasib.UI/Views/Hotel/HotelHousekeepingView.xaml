<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelHousekeepingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="إدارة النظافة" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding LoadTasksCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                    <ComboBox md:HintAssist.Hint="الحالة" ItemsSource="{Binding StatusFilterOptions}"
                              SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}"
                              DisplayMemberPath="Label" Width="140" Margin="8,0,0,0"/>
                    <TextBox md:HintAssist.Hint="تصفية بالمسؤول"
                             Text="{Binding AssignedFilter, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Width="180" Margin="8,0,0,0"/>
                    <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 TargetDataGrid="{Binding ElementName=HousekeepingGrid}"
                                                 Margin="4,0,0,0"
                                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,10">
                    <TextBlock Text="مهام النظافة" FontSize="15" FontWeight="Bold" Foreground="White"/>
                </Border>
                <controls:HotelListStatsBar Grid.Row="1" Margin="16,12,16,4" ItemsSource="{Binding Stats}"/>
                <DataGrid x:Name="HousekeepingGrid"
                          Grid.Row="2" Margin="8"
                          ItemsSource="{Binding Tasks}"
                          SelectedItem="{Binding SelectedTask}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource HotelListDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الغرفة" Binding="{Binding RoomNumber}" Width="100" MinWidth="80"
                                            ElementStyle="{StaticResource HotelDataGridTextElement}"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RoomNumber"/>
                        <DataGridTemplateColumn Header="الحالة" Width="280" MinWidth="220"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:HotelStatusBadge Label="{Binding StatusLabel}" Color="{Binding StatusColor}" Margin="0,0,6,0"/>
                                        <ComboBox Width="120"
                                                  ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding PendingStatus, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  Style="{StaticResource FilledComboBox}"/>
                                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                                Command="{Binding DataContext.ChangeRoomStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Margin="4,0,0,0">
                                            <md:PackIcon Kind="CheckBold" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="المسؤول" Binding="{Binding AssignedTo}" Width="140" MinWidth="100"
                                            ElementStyle="{StaticResource HotelDataGridTextElement}"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AssignedTo"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*" MinWidth="160"
                                            ElementStyle="{StaticResource HotelDataGridTextElement}"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt}" Width="140" MinWidth="120"
                                            ElementStyle="{StaticResource HotelDataGridTextElement}"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CreatedAt"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="150" MinWidth="150">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                                Command="{Binding DataContext.MarkInProgressCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="بدء التنظيف">
                                            <md:PackIcon Kind="Play" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource TableSecondaryIconButton}"
                                                Command="{Binding DataContext.MarkDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="إنهاء">
                                            <md:PackIcon Kind="Check" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource TableViewIconButton}"
                                                Command="{Binding DataContext.MarkVerifiedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="تحقق">
                                            <md:PackIcon Kind="ShieldCheck" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
