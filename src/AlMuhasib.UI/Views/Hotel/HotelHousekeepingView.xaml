<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelHousekeepingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <controls:HotelListPageShell PageTitle="إدارة النظافة"
                                 ListTitle="مهام النظافة"
                                 ShowStatsBar="True"
                                 ShowPagination="False"
                                 StatsItemsSource="{Binding Stats}"
                                 HasPreviewSelection="{Binding HasPreviewSelection}"
                                 PreviewTitle="{Binding PreviewTitle}"
                                 PreviewSubtitle="{Binding PreviewSubtitle}"
                                 PreviewIconKind="{Binding PreviewIconKind}"
                                 PreviewSelectedTab="{Binding PreviewSelectedTab, Mode=TwoWay}"
                                 ClosePreviewCommand="{Binding ClosePreviewCommand}">

        <controls:HotelListPageShell.ToolbarContent>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding LoadTasksCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="تحديث"/>
                    </StackPanel>
                </Button>
                <ComboBox md:HintAssist.Hint="الحالة" ItemsSource="{Binding StatusFilterOptions}"
                          SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}"
                          DisplayMemberPath="Label" Width="140" Margin="8,0,0,0"/>
                <TextBox md:HintAssist.Hint="تصفية بالمسؤول"
                         Text="{Binding AssignedFilter, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilledTextBox}" Width="180" Margin="8,0,0,0"/>
                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             TargetDataGrid="{Binding ElementName=HousekeepingGrid}"
                                             Margin="4,0,0,0"
                                             VerticalAlignment="Center"/>
            </StackPanel>
        </controls:HotelListPageShell.ToolbarContent>

        <controls:HotelListPageShell.ListContent>
            <DataGrid x:Name="HousekeepingGrid"
                      Margin="8"
                      ItemsSource="{Binding Tasks}"
                      SelectedItem="{Binding SelectedTask}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource HotelListDataGrid}"
                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                      behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="الغرفة" Width="100" MinWidth="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RoomNumber">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:HotelEntityLink LinkText="{Binding RoomNumber}"
                                                          Command="{Binding DataContext.OpenRoomFromTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          CommandParameter="{Binding}"
                                                          ToolTipText="عرض الغرفة"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="الحالة" Width="280" MinWidth="220" behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:HotelStatusBadge Label="{Binding StatusLabel}" Color="{Binding StatusColor}" Margin="0,0,6,0"/>
                                    <ComboBox Width="120"
                                              ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding PendingStatus, Mode=TwoWay}"
                                              DisplayMemberPath="Label"
                                              Style="{StaticResource FilledComboBox}"/>
                                    <Button Style="{StaticResource TableSecondaryIconButton}"
                                            Command="{Binding DataContext.ChangeRoomStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Margin="4,0,0,0">
                                        <md:PackIcon Kind="CheckBold" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="المسؤول" Binding="{Binding AssignedTo}" Width="140" MinWidth="100"
                                        ElementStyle="{StaticResource HotelDataGridTextElement}"
                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AssignedTo"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="2*" MinWidth="160"
                                        ElementStyle="{StaticResource HotelDataGridTextElement}"
                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt}" Width="140" MinWidth="120"
                                        ElementStyle="{StaticResource HotelDataGridTextElement}"
                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CreatedAt"/>
                    <DataGridTemplateColumn Header="إجراءات" Width="150" MinWidth="150">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource TableSecondaryIconButton}" Command="{Binding DataContext.MarkInProgressCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="بدء التنظيف">
                                        <md:PackIcon Kind="Play" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource TableSecondaryIconButton}" Command="{Binding DataContext.MarkDoneCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="إنهاء">
                                        <md:PackIcon Kind="Check" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource TableViewIconButton}" Command="{Binding DataContext.MarkVerifiedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="تحقق">
                                        <md:PackIcon Kind="ShieldCheck" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </controls:HotelListPageShell.ListContent>

        <controls:HotelListPageShell.PreviewSummaryContent>
            <StackPanel Margin="12,0" DataContext="{Binding PreviewTask}">
                <controls:HotelStatusBadge Label="{Binding StatusLabel}" Color="{Binding StatusColor}" HorizontalAlignment="Right" Margin="0,0,0,12"/>
                <TextBlock Text="المسؤول" Style="{StaticResource HotelPreviewFieldLabel}"/>
                <TextBlock Text="{Binding AssignedTo}" Style="{StaticResource HotelPreviewFieldValue}"/>
                <TextBlock Text="التاريخ" Style="{StaticResource HotelPreviewFieldLabel}"/>
                <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource HotelPreviewFieldValue}"/>
                <TextBlock Text="ملاحظات" Style="{StaticResource HotelPreviewFieldLabel}"/>
                <TextBlock Text="{Binding Notes}" Style="{StaticResource HotelPreviewFieldValue}"/>
            </StackPanel>
        </controls:HotelListPageShell.PreviewSummaryContent>

        <controls:HotelListPageShell.PreviewActionsContent>
            <WrapPanel Margin="12,0">
                <Button Content="عرض الغرفة" Command="{Binding OpenRoomFromTaskCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,8"/>
                <Button Content="بدء التنظيف" Command="{Binding MarkInProgressCommand}" CommandParameter="{Binding PreviewTask}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,8"/>
                <Button Content="إنهاء" Command="{Binding MarkDoneCommand}" CommandParameter="{Binding PreviewTask}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,8"/>
            </WrapPanel>
        </controls:HotelListPageShell.PreviewActionsContent>
    </controls:HotelListPageShell>
</UserControl>
