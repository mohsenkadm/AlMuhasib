<UserControl x:Class="AlMuhasib.UI.Views.Hotel.RestaurantTablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="طاولات الصالة" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="20,8" Margin="0,0,8,0" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="TableChair" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="طاولة جديدة"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadTablesCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                    <TextBox md:HintAssist.Hint="بحث برقم الطاولة..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" MinWidth="200" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Title="خريطة الطاولات"
                                             TargetDataGrid="{Binding ElementName=TablesGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False">
                    <controls:ListTableHeaderBar.ExtraContent>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton IsChecked="{Binding IsGridView}" ToolTip="عرض شبكة"
                                          Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Margin="0,0,8,0">
                                <md:PackIcon Kind="ViewGrid" Width="18" Height="18"/>
                            </ToggleButton>
                            <ToggleButton IsChecked="{Binding IsGridView, Converter={StaticResource InverseBooleanConverter}}" ToolTip="عرض جدول"
                                          Style="{StaticResource MaterialDesignFlatButton}" Foreground="White">
                                <md:PackIcon Kind="ViewList" Width="18" Height="18"/>
                            </ToggleButton>
                        </StackPanel>
                    </controls:ListTableHeaderBar.ExtraContent>
                </controls:ListTableHeaderBar>
                <controls:HotelListStatsBar Grid.Row="1" Margin="16,12,16,4" ItemsSource="{Binding Stats}"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="12"
                              Visibility="{Binding IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Tables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="110" Height="110" Margin="8" CornerRadius="14" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FF00897B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                    <Setter Property="Background" Value="#FFE65100"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <md:PackIcon Kind="TableChair" Width="28" Height="28" Foreground="White" HorizontalAlignment="Center" Opacity="0.9"/>
                                        <TextBlock Text="{Binding TableNumber}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource RestaurantEnumLabelConverter}}"
                                                   Foreground="White" HorizontalAlignment="Center" Opacity="0.9" FontSize="11"/>
                                        <TextBlock HorizontalAlignment="Center" Foreground="White" Opacity="0.8" FontSize="10" Margin="0,2,0,0">
                                            <Run Text="{Binding Capacity, Mode=OneWay}"/>
                                            <Run Text=" مقاعد"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <DataGrid x:Name="TablesGrid" Grid.Row="2" Margin="8"
                          ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                          AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}"
                          Visibility="{Binding IsTableView, Converter={StaticResource BooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الطاولة" Binding="{Binding TableNumber}" Width="120" MinWidth="100"
                                            ElementStyle="{StaticResource HotelDataGridTextElement}"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TableNumber"/>
                        <DataGridTextColumn Header="السعة" Binding="{Binding Capacity}" Width="90" MinWidth="70"
                                            ElementStyle="{StaticResource HotelDataGridTextElement}"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Capacity"/>
                        <DataGridTemplateColumn Header="الحالة" Width="120" MinWidth="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:HotelStatusBadge Label="{Binding Status, Converter={StaticResource RestaurantEnumLabelConverter}}"
                                                                 Color="#00897B">
                                        <controls:HotelStatusBadge.Style>
                                            <Style TargetType="controls:HotelStatusBadge">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Occupied">
                                                        <Setter Property="Color" Value="#E65100"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:HotelStatusBadge.Style>
                                    </controls:HotelStatusBadge>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="160" MinWidth="140"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource TableEditIconButton}"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource TableSecondaryIconButton}" ToolTip="تحرير الطاولة"
                                                Command="{Binding DataContext.SetAvailableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <md:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource TableDeleteIconButton}"
                                                Command="{Binding DataContext.DeleteTableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False"
                       Style="{StaticResource ModernDialogHost}" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="380">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="إضافة طاولة"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="تعديل طاولة"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox md:HintAssist.Hint="رقم الطاولة *" Text="{Binding EditTableNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="السعة (مقاعد)" Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حفظ" Command="{Binding SaveTableCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
