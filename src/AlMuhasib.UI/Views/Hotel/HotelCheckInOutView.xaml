<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelCheckInOutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <md:Card Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="تسجيل دخول/خروج" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <DatePicker md:HintAssist.Hint="التاريخ" SelectedDate="{Binding SelectedDate}" Width="160" Margin="0,0,8,0"/>
                <Button Command="{Binding LoadDataCommand}" Style="{StaticResource FlatButton}">
                    <md:PackIcon Kind="Refresh"/>
                </Button>
                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             TargetDataGrid="{Binding ElementName=ArrivalsGrid}"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"/>
            </StackPanel>
        </md:Card>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <md:Card Grid.Column="0" Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,8,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#6A1B9A" Padding="12,8">
                        <TextBlock Text="وصول اليوم" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <DataGrid x:Name="ArrivalsGrid"
                              ItemsSource="{Binding Arrivals}" SelectedItem="{Binding SelectedArrival}"
                              AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource HotelListDataGrid}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم" Binding="{Binding ReservationNumber}" Width="110" MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ReservationNumber"/>
                            <DataGridTextColumn Header="النزيل" Binding="{Binding GuestName}" Width="2*" MinWidth="140"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GuestName"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding RoomTypeName}" Width="140" MinWidth="100"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RoomTypeName"/>
                            <DataGridTemplateColumn Header="إجراء" Width="120" MinWidth="110"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تسجيل دخول" Command="{Binding DataContext.OpenCheckInDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </md:Card>
            <md:Card Grid.Column="1" Style="{StaticResource ElevatedCard}" Padding="0" Margin="8,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#1565C0" Padding="12,8">
                        <TextBlock Text="مغادرة اليوم" Foreground="White" FontWeight="Bold"/>
                    </Border>
                    <DataGrid x:Name="DeparturesGrid"
                              ItemsSource="{Binding Departures}" SelectedItem="{Binding SelectedDeparture}"
                              AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource HotelListDataGrid}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم" Binding="{Binding ReservationNumber}" Width="110" MinWidth="90"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ReservationNumber"/>
                            <DataGridTextColumn Header="النزيل" Binding="{Binding GuestName}" Width="2*" MinWidth="140"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GuestName"/>
                            <DataGridTextColumn Header="الغرفة" Binding="{Binding RoomNumber}" Width="100" MinWidth="80"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RoomNumber"/>
                            <DataGridTemplateColumn Header="إجراء" Width="120" MinWidth="110"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تسجيل خروج" Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </md:Card>
        </Grid>

        <md:DialogHost IsOpen="{Binding IsCheckInDialogOpen}" CloseOnClickAway="False" Style="{StaticResource ModernDialogHost}" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="420">
                    <StackPanel>
                        <TextBlock Text="تسجيل دخول" FontSize="18" FontWeight="Bold" Foreground="#6A1B9A" Margin="0,0,0,8"/>
                        <TextBlock Margin="0,0,0,16">
                            <Run Text="الحجز: "/>
                            <Run Text="{Binding SelectedArrival.ReservationNumber, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" — "/>
                            <Run Text="{Binding SelectedArrival.GuestName, Mode=OneWay}"/>
                        </TextBlock>
                        <ComboBox md:HintAssist.Hint="اختر الغرفة" ItemsSource="{Binding AvailableRooms}" SelectedValuePath="Id" SelectedValue="{Binding CheckInRoomId}" DisplayMemberPath="Number" Style="{StaticResource FilledComboBox}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="تأكيد الدخول" Command="{Binding ConfirmCheckInCommand}" Style="{StaticResource MaterialDesignRaisedButton}" md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CloseCheckInDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
