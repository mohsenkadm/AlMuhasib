<UserControl x:Class="AlMuhasib.UI.Views.Hotel.HotelRoomTypesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="إدارة أنواع الغرف" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="BedKingOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="نوع جديد"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                    <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 TargetDataGrid="{Binding ElementName=RoomTypesGrid}"
                                                 Margin="4,0,0,0"
                                                 VerticalAlignment="Center"/>
                    <TextBox md:HintAssist.Hint="بحث..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="220" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="قائمة أنواع الغرف" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <controls:ListViewModeToggle Grid.Column="1" OnDarkBackground="True" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <controls:HotelListStatsBar Grid.Row="0" Margin="16,12,16,4" ItemsSource="{Binding Stats}"/>

                    <DataGrid x:Name="RoomTypesGrid"
                              Grid.Row="1"
                              Margin="8"
                              ItemsSource="{Binding RoomTypes}"
                              SelectedItem="{Binding SelectedRoomType}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource HotelListDataGrid}"
                              Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*" MinWidth="120"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                            <DataGridTextColumn Header="السعة" Binding="{Binding Capacity}" Width="90" MinWidth="70"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Capacity"/>
                            <DataGridTextColumn Header="السعر الأساسي" Binding="{Binding BasePrice, StringFormat=N0}" Width="140" MinWidth="110"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BasePrice"/>
                            <DataGridTextColumn Header="الترتيب" Binding="{Binding SortOrder}" Width="90" MinWidth="70"
                                                ElementStyle="{StaticResource HotelDataGridTextElement}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SortOrder"/>
                            <DataGridTemplateColumn Header="إجراءات" Width="140" MinWidth="140"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TableEditIconButton}" Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                            </Button>
                                            <Button Style="{StaticResource TableDeleteIconButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding RoomTypes}"
                                      ItemTemplate="{StaticResource HotelRoomTypeCardTemplate}"
                                      ItemsPanel="{StaticResource MasterDataCardWrapPanel}"/>
                    </ScrollViewer>
                </Grid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Style="{StaticResource ModernDialogHost}" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <controls:HotelFormDialog Title="{Binding DialogTitle}"
                                          IconKind="BedKingOutline"
                                          SaveCommand="{Binding SaveCommand}"
                                          CloseCommand="{Binding CloseDialogCommand}"
                                          IsBusy="{Binding IsBusy}">
                    <controls:HotelFormDialog.DialogContent>
                        <StackPanel>
                            <TextBox md:HintAssist.Hint="الاسم *"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="الوصف"
                                     Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="السعة"
                                     Text="{Binding EditCapacity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="السعر الأساسي"
                                     Text="{Binding EditBasePrice, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="الترتيب"
                                     Text="{Binding EditSortOrder, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        </StackPanel>
                    </controls:HotelFormDialog.DialogContent>
                </controls:HotelFormDialog>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
