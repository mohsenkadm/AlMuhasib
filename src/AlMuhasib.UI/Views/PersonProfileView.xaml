<UserControl x:Class="AlMuhasib.UI.Views.PersonProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:PersonProfileViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="TypeFilterChip" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChipBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimelineCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="16"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.35">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                             From="16" To="0" Duration="0:0:0.4">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionHeaderButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootPanel" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="18"/>
        </Grid.RenderTransform>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F9FC" Offset="0"/>
                <GradientStop Color="#EEF5F8" Offset="0.45"/>
                <GradientStop Color="#F7FBFD" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,8">
            <StackPanel Margin="24,20,24,24">

                <!-- Title -->
                <DockPanel Margin="0,0,0,18" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock Text="ملف الشخص"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="اختر عميلاً أو مورداً أو مستثمراً لعرض كل بياناته مرتبة زمنياً"
                                   FontSize="13" Margin="0,4,0,0"
                                   Foreground="{DynamicResource HintForegroundBrush}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Search / Filter Card -->
                <materialDesign:Card UniformCornerRadius="22"
                                     Padding="20,18"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Margin="0,0,0,18">
                    <StackPanel>
                        <!-- Type filters -->
                        <ItemsControl ItemsSource="{Binding TypeFilters}" Margin="0,0,0,14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PersonTypeFilterItem}">
                                    <Button Command="{Binding DataContext.SelectTypeFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource TypeFilterChip}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Search row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                      MinWidth="280"
                                      Margin="0,0,12,0"
                                      ItemsSource="{Binding FilteredPeople}"
                                      SelectedItem="{Binding SelectedPerson, UpdateSourceTrigger=PropertyChanged}"
                                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      materialDesign:HintAssist.Hint="ابحث بالاسم أو الهاتف...">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <Border CornerRadius="10" Padding="8,2" Margin="0,0,10,0"
                                                    Background="#E3F2FD" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                                           Foreground="#1565C0" FontWeight="SemiBold"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Phone}" FontSize="11"
                                                           Foreground="{DynamicResource HintForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom}"
                                        Style="{StaticResource FilledDatePicker}"
                                        materialDesign:HintAssist.Hint="من تاريخ"
                                        Width="140" Margin="0,0,8,0"/>
                            <DatePicker Grid.Column="2" SelectedDate="{Binding DateTo}"
                                        Style="{StaticResource FilledDatePicker}"
                                        materialDesign:HintAssist.Hint="إلى تاريخ"
                                        Width="140" Margin="0,0,12,0"/>

                            <Button Grid.Column="3" Content="عرض الملف"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding LoadProfileCommand}"
                                    Margin="0,0,8,0"
                                    Padding="18,0"/>

                            <Button Grid.Column="4" Content="مسح"
                                    Style="{StaticResource OutlinedButton}"
                                    Command="{Binding ClearSelectionCommand}"/>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Empty state -->
                <Border Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"
                        Padding="40,60" Margin="0,20,0,0"
                        CornerRadius="24"
                        Background="#80FFFFFF"
                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                        <Border Width="88" Height="88" CornerRadius="44"
                                HorizontalAlignment="Center" Margin="0,0,0,18"
                                Background="#E3F2FD">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="44" CenterY="44"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="1" To="1.06" Duration="0:0:1.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="1" To="1.06" Duration="0:0:1.4">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <materialDesign:PackIcon Kind="AccountSearch"
                                                     Width="40" Height="40"
                                                     Foreground="#1565C0"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="ابدأ باختيار شخص"
                                   FontSize="22" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="ابحث عن عميل أو مورد أو مستثمر لعرض ملفه الكامل: الملخص، الخط الزمني، والفواتير والسندات."
                                   FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource HintForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Profile content -->
                <StackPanel x:Name="ProfileContent"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                            Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform Y="24"/>
                    </StackPanel.RenderTransform>

                    <!-- Hero header -->
                    <Border CornerRadius="24" Padding="24,22" Margin="0,0,0,16"
                            BorderThickness="1"
                            BorderBrush="{Binding TypeAccent, Converter={StaticResource HexToBrushConverter}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                <GradientStop Color="#F3F8FC" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="72" Height="72" CornerRadius="36"
                                    Background="{Binding TypeAccentLight, Converter={StaticResource HexToBrushConverter}}"
                                    Margin="0,0,18,0">
                                <materialDesign:PackIcon Kind="{Binding TypeIcon}"
                                                         Width="34" Height="34"
                                                         Foreground="{Binding TypeAccent, Converter={StaticResource HexToBrushConverter}}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border CornerRadius="12" Padding="10,3" Margin="0,0,10,0"
                                            Background="{Binding TypeAccentLight, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding TypeAccent, Converter={StaticResource HexToBrushConverter}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding PeriodLabel}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource HintForegroundBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PersonName}" FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <materialDesign:PackIcon Kind="Phone" Width="14" Height="14"
                                                                 Foreground="{DynamicResource HintForegroundBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                        <materialDesign:PackIcon Kind="MapMarker" Width="14" Height="14"
                                                                 Foreground="{DynamicResource HintForegroundBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Address}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                                Visibility="{Binding ShowCustomerExtras, Converter={StaticResource BoolToVis}}">
                                        <materialDesign:PackIcon Kind="Identifier" Width="14" Height="14"
                                                                 Foreground="{DynamicResource HintForegroundBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding FileNumber}" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="طباعة" Style="{StaticResource OutlinedButton}"
                                        Command="{Binding PrintCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}"
                                        Command="{Binding ExportToExcelCommand}"
                                        Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stats -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <controls:AnimatedStatCard
                            Title="إجمالي المدين"
                            TextValue="{Binding TotalDebit}"
                            Icon="CashPlus"
                            IconBackground="#FFEBEE"
                            IconForeground="#C62828"
                            ValueForeground="#C62828"
                            Margin="0,0,10,0"/>
                        <controls:AnimatedStatCard
                            Title="إجمالي الدائن"
                            TextValue="{Binding TotalCredit}"
                            Icon="CashMinus"
                            IconBackground="#E8F5E9"
                            IconForeground="#2E7D32"
                            ValueForeground="#2E7D32"
                            Margin="0,0,10,0"/>
                        <controls:AnimatedStatCard
                            Title="الرصيد"
                            TextValue="{Binding Balance}"
                            Icon="ScaleBalance"
                            IconBackground="{DynamicResource AccentLightBrush}"
                            IconForeground="{DynamicResource AccentBrush}"
                            ValueForeground="{DynamicResource AccentBrush}"
                            Margin="0,0,10,0"/>
                        <controls:AnimatedStatCard
                            Title="عدد الحركات"
                            TextValue="{Binding TransactionCount}"
                            Icon="SwapHorizontal"
                            IconBackground="#E3F2FD"
                            IconForeground="#1565C0"
                            ValueForeground="#1565C0"/>
                    </UniformGrid>

                    <!-- Customer extras -->
                    <materialDesign:Card UniformCornerRadius="18" Padding="18,14" Margin="0,0,0,16"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         Visibility="{Binding ShowCustomerExtras, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="درجة الموثوقية" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding ReliabilityScore}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="حد الآجل" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding MaxCreditLimit}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="حد الأقساط" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding MaxInstallmentDebt}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="الضامن" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding GuarantorInfo}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </UniformGrid>
                    </materialDesign:Card>

                    <!-- Investor extras -->
                    <materialDesign:Card UniformCornerRadius="18" Padding="18,14" Margin="0,0,0,16"
                                         materialDesign:ElevationAssist.Elevation="Dp1"
                                         Visibility="{Binding ShowInvestorExtras, Converter={StaticResource BoolToVis}}">
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="إجمالي الإيداع" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding TotalDeposit}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="الرصيد الافتتاحي" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding OpeningBalance}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="نسبة الأرباح" FontSize="11" Foreground="{DynamicResource HintForegroundBrush}"/>
                                <TextBlock Text="{Binding ProfitPercentage}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </UniformGrid>
                    </materialDesign:Card>

                    <!-- Timeline -->
                    <materialDesign:Card UniformCornerRadius="22" Padding="22,20" Margin="0,0,0,16"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Border Width="36" Height="36" CornerRadius="18" Background="#E0F7FA" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="TimelineClock" Width="18" Height="18"
                                                                 Foreground="#00838F"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="الخط الزمني" FontSize="18" FontWeight="Bold"/>
                                        <TextBlock Text="كل الحركات مرتبة من الأقدم إلى الأحدث" FontSize="12"
                                                   Foreground="{DynamicResource HintForegroundBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding TimelineItems}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TimelineItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PersonTimelineDisplayItem}">
                                        <Grid Margin="0,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Timeline rail -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Center">
                                                <Rectangle Width="2" Fill="#D0D7DE"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Stretch"
                                                           Margin="0,28,0,-12"/>
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        VerticalAlignment="Top"
                                                        Background="{Binding AccentLight, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderBrush="{Binding Accent, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="1.5">
                                                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                                             Foreground="{Binding Accent, Converter={StaticResource HexToBrushConverter}}"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <Border Grid.Column="1" Style="{StaticResource TimelineCard}" Margin="8,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Border CornerRadius="8" Padding="8,2" Margin="0,0,8,0"
                                                                    Background="{Binding AccentLight, Converter={StaticResource HexToBrushConverter}}">
                                                                <TextBlock Text="{Binding CategoryLabel}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding Accent, Converter={StaticResource HexToBrushConverter}}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}}"
                                                                       FontSize="12" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource HintForegroundBrush}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="14" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                            <TextBlock Text="مدين" FontSize="10" Width="36"
                                                                       Foreground="{DynamicResource HintForegroundBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding DebitLabel}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="#C62828" Width="90" TextAlignment="Left"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="دائن" FontSize="10" Width="36"
                                                                       Foreground="{DynamicResource HintForegroundBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding CreditLabel}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="#2E7D32" Width="90" TextAlignment="Left"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <TextBlock Text="رصيد" FontSize="10" Width="36"
                                                                       Foreground="{DynamicResource HintForegroundBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding BalanceLabel}" FontSize="13" FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" Width="90" TextAlignment="Left"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="لا توجد حركات في الفترة المحددة"
                                       FontSize="13" HorizontalAlignment="Center" Margin="0,12"
                                       Foreground="{DynamicResource HintForegroundBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TimelineItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Detail sections -->
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PersonSectionDisplayItem}">
                                <materialDesign:Card UniformCornerRadius="20" Padding="18,14" Margin="0,0,0,12"
                                                     materialDesign:ElevationAssist.Elevation="Dp1">
                                    <StackPanel>
                                        <Button Style="{StaticResource SectionHeaderButton}"
                                                Command="{Binding DataContext.ToggleSectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="#F5F7FA" Margin="0,0,10,0">
                                                        <materialDesign:PackIcon Kind="{Binding Icon}" Width="16" Height="16"
                                                                                 Foreground="#455A64"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <Border CornerRadius="10" Padding="8,2" Margin="10,0,0,0"
                                                            Background="#ECEFF1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="#455A64"/>
                                                    </Border>
                                                </StackPanel>
                                                <materialDesign:PackIcon DockPanel.Dock="Left"
                                                                         Width="20" Height="20"
                                                                         VerticalAlignment="Center"
                                                                         Foreground="{DynamicResource HintForegroundBrush}">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="ChevronDown"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Kind" Value="ChevronUp"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </DockPanel>
                                        </Button>

                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,10,0,0"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="12"
                                                            Background="#F8FAFC" BorderBrush="#E8EEF2" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                                                           Foreground="{DynamicResource HintForegroundBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="11" Margin="0,4,0,0"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                                                    <Run Text="{Binding Date, StringFormat={}{0:yyyy/MM/dd}, Mode=OneWay}"/>
                                                                    <Run Text="  ·  "/>
                                                                    <Run Text="{Binding Status, Mode=OneWay}"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding AmountLabel}"
                                                                       FontSize="14" FontWeight="Bold"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="لا توجد عناصر"
                                                   FontSize="12" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource HintForegroundBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                                <Condition Binding="{Binding Count}" Value="0"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Notes -->
                    <materialDesign:Card UniformCornerRadius="18" Padding="18,14" Margin="0,0,0,8"
                                         materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel>
                            <TextBlock Text="ملاحظات" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource HintForegroundBrush}"/>
                            <TextBlock Text="{Binding Notes}" FontSize="14" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Busy overlay -->
        <Border Background="#66FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="42" Height="42"
                             Foreground="#1565C0"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
