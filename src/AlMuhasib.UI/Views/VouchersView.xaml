<UserControl x:Class="AlMuhasib.UI.Views.VouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VouchersViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:VoucherTypeToTextConverter x:Key="VoucherTypeToText" />
        <converters:VoucherTypeToBrushConverter x:Key="VoucherTypeToBrush" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TOP: Create Voucher Form                               -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="12" Padding="20"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="إضافة سند جديد" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" />

                <!-- Row 1: Type + Number + Date -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding VoucherTypes}"
                              SelectedValue="{Binding SelectedVoucherType}"
                              SelectedValuePath="Type"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="نوع السند"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="14" />

                    <TextBox Grid.Column="2"
                             Text="{Binding VoucherNumber}"
                             IsReadOnly="True"
                             materialDesign:HintAssist.Hint="رقم السند (تلقائي)"
                             Style="{StaticResource FilledTextBox}"
                             FontSize="14" FontWeight="Bold"
                             Foreground="{DynamicResource PrimaryHueMidBrush}" />

                    <DatePicker Grid.Column="4"
                                SelectedDate="{Binding VoucherDate}"
                                materialDesign:HintAssist.Hint="التاريخ"
                                Style="{StaticResource FilledDatePicker}"
                                FontSize="13" />
                </Grid>

                <!-- Row 2: Amount + BankFees + CashBox -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="المبلغ"
                             Style="{StaticResource NumericTextBox}"
                             FontSize="15" FontWeight="Bold" />

                    <!-- Bank Fees (shown for BankReceipt only) -->
                    <TextBox Grid.Column="2"
                             Text="{Binding BankFees, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="عمولة المصرف"
                             Style="{StaticResource NumericTextBox}"
                             FontSize="13"
                             Visibility="{Binding ShowBankFeesField, Converter={StaticResource BoolToVis}}" />

                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding CashBoxes}"
                              SelectedItem="{Binding SelectedCashBox}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="الصندوق"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="13" />

                    <!-- Net amount display -->
                    <TextBlock Grid.Column="6" Text="{Binding NetAmountText}"
                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource HighlightBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>

                <!-- Row 3: Customer / Investor / Bank (conditional) -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Customer (Receipt, DebtReceipt, optional Payment) -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding FilteredCustomers}"
                              SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="{Binding CustomerFieldHint}"
                              Style="{StaticResource CustomerSearchableComboBox}"
                              FontSize="13"
                              Visibility="{Binding ShowCustomerPickerField, Converter={StaticResource BoolToVis}}" />

                    <!-- Supplier (Payment, optional) -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding FilteredSuppliers}"
                              SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                              Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                              materialDesign:HintAssist.Hint="المورد (اختياري — ابحث بالاسم أو الهاتف أو المعرف)"
                              Style="{StaticResource SupplierSearchableComboBox}"
                              FontSize="13"
                              Visibility="{Binding ShowSupplierField, Converter={StaticResource BoolToVis}}" />

                    <!-- Investor (InvestorDeposit, InvestorWithdrawal) -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding FilteredInvestors}"
                              SelectedItem="{Binding SelectedInvestor, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              Text="{Binding InvestorSearchText, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              StaysOpenOnEdit="True"
                              materialDesign:HintAssist.Hint="المستثمر (ابحث بالاسم أو الهاتف)"
                              materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="13"
                              Visibility="{Binding ShowInvestorField, Converter={StaticResource BoolToVis}}" />

                    <!-- Bank (BankReceipt) -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding BankAccounts}"
                              SelectedItem="{Binding SelectedBankAccount}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="الحساب"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="13"
                              Visibility="{Binding ShowBankField, Converter={StaticResource BoolToVis}}" />

                    <!-- Notes -->
                    <TextBox Grid.Column="2"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="ملاحظات (اختياري)"
                             Style="{StaticResource FilledTextBox}"
                             FontSize="13" />
                </Grid>

                <!-- Row 4: optional invoice / installment link -->
                <Grid Grid.Row="7" Margin="0,12,0,0"
                      Visibility="{Binding ShowDocumentLinkFields, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding OpenCreditInvoices}"
                              SelectedItem="{Binding SelectedLinkedInvoice}"
                              DisplayMemberPath="InvoiceNumber"
                              materialDesign:HintAssist.Hint="فاتورة آجلة (اختياري)"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="13"
                              IsEditable="False"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding OpenInstallments}"
                              SelectedItem="{Binding SelectedLinkedInstallment}"
                              materialDesign:HintAssist.Hint="قسط مستحق (اختياري)"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="13"
                              IsEditable="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DueDate, StringFormat=yyyy/MM/dd, Mode=OneWay}"/>
                                    <Run Text=" — متبقي "/>
                                    <Run Text="{Binding RemainingAmount, StringFormat=N0, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Create button -->
                <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Command="{Binding CreateVoucherCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            Foreground="White" FontSize="14" Padding="24,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"
                                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="حفظ السند" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ═══════════════════════════════════════════ -->
        <!-- BOTTOM: Vouchers List                                  -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" UniformCornerRadius="12" Padding="0"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة السندات"
                                             TargetDataGrid="{Binding ElementName=VouchersGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportVouchersCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False">
                    <controls:ListTableHeaderBar.ExtraContent>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Width="260"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="بحث برقم السند أو اسم العميل..."
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     Style="{StaticResource FilledTextBox}"
                                     FontSize="13" Foreground="White"
                                     materialDesign:HintAssist.Foreground="#B0BEC5"
                                     Margin="0,0,8,0"/>
                            <Button Command="{Binding SearchVouchersCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="White" FontSize="12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Margin="0,0,4,0" />
                                    <TextBlock Text="بحث" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:ListTableHeaderBar.ExtraContent>
                </controls:ListTableHeaderBar>

                <!-- Data grid -->
                <DataGrid x:Name="VouchersGrid"
                          Grid.Row="1" ItemsSource="{Binding Vouchers}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True" CanUserReorderColumns="False"
                          materialDesign:DataGridAssist.CellPadding="10 6"
                          HeadersVisibility="Column" FontSize="13" Margin="8"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherNumber">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="النوع" Width="140"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding VoucherType, Converter={StaticResource VoucherTypeToText}}"
                                               Foreground="{Binding VoucherType, Converter={StaticResource VoucherTypeToBrush}}"
                                               FontWeight="Bold" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="العمولة" Binding="{Binding BankFees, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BankFees" />
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date" />
                        <DataGridTextColumn Header="الصندوق" Binding="{Binding CashBox.Name}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CashBox.Name" />
                        <DataGridTextColumn Header="العميل" Binding="{Binding Customer.Name}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Customer.Name" />
                        <DataGridTextColumn Header="فاتورة مرتبطة" Binding="{Binding Invoice.InvoiceNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Invoice.InvoiceNumber" />
                        <DataGridTextColumn Header="المستثمر" Binding="{Binding Investor.Name}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Investor.Name" />
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes" />
                        <DataGridTemplateColumn Header="إرسال" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.PrintVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TablePrintIconButton}"
                                                ToolTip="طباعة">
                                            <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" />
                                        </Button>
                                        <Button Command="{Binding DataContext.SendVoucherWhatsAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableWhatsAppIconButton}"
                                                ToolTip="إرسال السند عبر واتساب">
                                            <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="حذف" Width="70"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.DeleteVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TableDeleteIconButton}"
                                            IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            ToolTip="حذف">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
