<UserControl x:Class="AlMuhasib.UI.Views.VouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VouchersViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="إنشاء سند" Command="{Binding OpenCreateDialogCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تحديث القائمة" Command="{Binding LoadVouchersCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="بحث" Command="{Binding SearchVouchersCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportVouchersCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة الجدول" Command="{Binding PrintTableCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBool" />
        <converters:VoucherTypeToTextConverter x:Key="VoucherTypeToText" />
        <converters:VoucherTypeToBrushConverter x:Key="VoucherTypeToBrush" />
    </UserControl.Resources>

    <materialDesign:DialogHost Style="{StaticResource ModernDialogHost}"
                               IsOpen="{Binding IsCreateDialogOpen}"
                               CloseOnClickAway="False">
        <materialDesign:DialogHost.DialogContent>
            <Border Style="{StaticResource DialogContentWrapper}"
                    MinWidth="720" MaxWidth="860" Padding="0"
                    Background="{DynamicResource CardBrush}">
                <Grid MaxHeight="760">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="20,14"
                            Background="{DynamicResource PrimaryHueLightBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                                        Background="{DynamicResource PrimaryHueMidBrush}">
                                    <materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="20" Height="20"
                                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="إضافة سند جديد" FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="اختر النوع والطرف والعملة — يظهر الرصيد والمتبقي فوراً"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Left"
                                    Command="{Binding CloseCreateDialogCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="{DynamicResource TextSecondaryBrush}" Padding="6" ToolTip="إغلاق">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                        <StackPanel>
                            <!-- Type / Number / Date -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding VoucherTypes}"
                                          SelectedValue="{Binding SelectedVoucherType}"
                                          SelectedValuePath="Type"
                                          DisplayMemberPath="Name"
                                          materialDesign:HintAssist.Hint="نوع السند"
                                          Style="{StaticResource FilledComboBox}"
                                          FontSize="14"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding VoucherNumber}"
                                         IsReadOnly="True"
                                         materialDesign:HintAssist.Hint="رقم السند"
                                         Style="{StaticResource FilledTextBox}"
                                         FontSize="14" FontWeight="Bold"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <DatePicker Grid.Column="4"
                                            SelectedDate="{Binding VoucherDate}"
                                            materialDesign:HintAssist.Hint="التاريخ"
                                            Style="{StaticResource FilledDatePicker}"
                                            FontSize="13"/>
                            </Grid>

                            <!-- Party type -->
                            <ComboBox Margin="0,12,0,0"
                                      ItemsSource="{Binding AvailablePartyTypes}"
                                      SelectedValue="{Binding SelectedPartyKind}"
                                      SelectedValuePath="Kind"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="نوع الشخص"
                                      Style="{StaticResource FilledComboBox}"
                                      FontSize="14"
                                      Visibility="{Binding ShowPartyTypeField, Converter={StaticResource BoolToVis}}"/>

                            <!-- Party pickers -->
                            <Grid Margin="0,12,0,0">
                                <StackPanel Visibility="{Binding ShowCustomerPickerField, Converter={StaticResource BoolToVis}}">
                                    <ComboBox ItemsSource="{Binding FilteredCustomers}"
                                              SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              materialDesign:HintAssist.Hint="{Binding CustomerFieldHint}"
                                              Style="{StaticResource CustomerSearchableComboBox}"
                                              FontSize="13"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowEmployeeField, Converter={StaticResource BoolToVis}}">
                                    <ComboBox ItemsSource="{Binding FilteredEmployees}"
                                              SelectedItem="{Binding SelectedEmployee, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              DisplayMemberPath="Name"
                                              materialDesign:HintAssist.Hint="الموظف *"
                                              Style="{StaticResource FilledComboBox}"
                                              FontSize="13"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowSupplierField, Converter={StaticResource BoolToVis}}">
                                    <ComboBox ItemsSource="{Binding FilteredSuppliers}"
                                              SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              materialDesign:HintAssist.Hint="المورد (ابحث بالاسم أو الهاتف أو المعرف)"
                                              Style="{StaticResource SupplierSearchableComboBox}"
                                              FontSize="13"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding ShowInvestorField, Converter={StaticResource BoolToVis}}">
                                    <ComboBox ItemsSource="{Binding FilteredInvestors}"
                                              SelectedItem="{Binding SelectedInvestor, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding InvestorSearchText, UpdateSourceTrigger=PropertyChanged}"
                                              materialDesign:HintAssist.Hint="المستثمر (ابحث بالاسم أو الهاتف)"
                                              Style="{StaticResource InvestorSearchableComboBox}"
                                              FontSize="13"/>
                                </StackPanel>
                                <ComboBox ItemsSource="{Binding BankAccounts}"
                                          SelectedItem="{Binding SelectedBankAccount}"
                                          DisplayMemberPath="Name"
                                          materialDesign:HintAssist.Hint="الحساب"
                                          Style="{StaticResource FilledComboBox}"
                                          FontSize="13"
                                          Visibility="{Binding ShowBankField, Converter={StaticResource BoolToVis}}"/>
                            </Grid>

                            <!-- Balance cards -->
                            <Border Margin="0,14,0,0" CornerRadius="14" Padding="14"
                                    Background="{DynamicResource HighlightLightBrush}"
                                    Visibility="{Binding ShowPartyBalancePanel, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <materialDesign:PackIcon Kind="WalletOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding PartyBalanceTitle}" FontWeight="SemiBold"
                                                   FontSize="14" Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock DockPanel.Dock="Left" Text="جاري التحميل..."
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding IsPartyBalanceLoading, Converter={StaticResource BoolToVis}}"/>
                                    </DockPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IqdBalanceCard" Grid.Column="0"
                                                CornerRadius="12" Padding="12,10"
                                                Background="{DynamicResource DashboardKpiOrangeLightBrush}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowMultiCurrency}" Value="True">
                                                            <Setter Property="Grid.ColumnSpan" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="رصيد دينار" FontSize="11"
                                                           Foreground="{DynamicResource DashboardKpiOrangeBrush}"/>
                                                <TextBlock FontSize="18" FontWeight="Bold" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource DashboardKpiOrangeBrush}">
                                                    <Run Text="{Binding PartyBalanceIqd, StringFormat=N0, TargetNullValue=0}"/>
                                                    <Run Text=" د.ع" FontSize="12"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" CornerRadius="12" Padding="12,10"
                                                Background="{DynamicResource DashboardKpiBlueLightBrush}"
                                                Visibility="{Binding ShowMultiCurrency, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="رصيد دولار" FontSize="11"
                                                           Foreground="{DynamicResource DashboardKpiBlueBrush}"/>
                                                <TextBlock FontSize="18" FontWeight="Bold" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource DashboardKpiBlueBrush}">
                                                    <Run Text="{Binding PartyBalanceUsd, StringFormat=N2, TargetNullValue=0}"/>
                                                    <Run Text=" $" FontSize="12"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding SettlementCurrencyOptions}"
                                                  SelectedItem="{Binding SelectedSettlementCurrencyOption}"
                                                  DisplayMemberPath="DisplayName"
                                                  materialDesign:HintAssist.Hint="تسديد رصيد أي عملة؟"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13"
                                                  Visibility="{Binding ShowSettlementCurrencyPicker, Converter={StaticResource BoolToVis}}"/>
                                        <Border Grid.Column="2" CornerRadius="10" Padding="10,8"
                                                Background="{DynamicResource DashboardKpiGreenLightBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RemainingBalanceLabel}" FontSize="11"
                                                           Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                                                <TextBlock Text="{Binding RemainingBalanceText}" FontSize="15" FontWeight="Bold"
                                                           Foreground="{DynamicResource DashboardKpiGreenBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding CrossCurrencyHint}" Margin="0,8,0,0"
                                               FontSize="12" Foreground="{DynamicResource DashboardKpiOrangeBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding IsCrossCurrencySettlement, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ConvertedAmountText}" Margin="0,4,0,0"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding IsCrossCurrencySettlement, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Currency + Amount + CashBox -->
                            <Border Margin="0,14,0,0" CornerRadius="14" Padding="14"
                                    Background="{DynamicResource PrimaryHueLightBrush}">
                                <StackPanel>
                                    <TextBlock Text="التسديد والعملة" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" MinWidth="140"
                                                  ItemsSource="{Binding CurrencyOptions}"
                                                  SelectedItem="{Binding SelectedCurrencyOption}"
                                                  DisplayMemberPath="DisplayName"
                                                  materialDesign:HintAssist.Hint="عملة الدفع"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13"
                                                  Visibility="{Binding ShowMultiCurrency, Converter={StaticResource BoolToVis}}"/>

                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="المبلغ"
                                                     Style="{StaticResource NumericTextBox}"
                                                     FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrencyAmountSuffix}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"
                                                       FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        </Grid>

                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding FilteredCashBoxes}"
                                                  SelectedItem="{Binding SelectedCashBox}"
                                                  DisplayMemberPath="DisplayNameWithCurrency"
                                                  materialDesign:HintAssist.Hint="الصندوق"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13"/>
                                    </Grid>

                                    <Grid Margin="0,10,0,0"
                                          Visibility="{Binding ShowFxRateInput, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                 materialDesign:HintAssist.Hint="سعر الصرف (دولار→دينار)"
                                                 Style="{StaticResource NumericTextBox}"
                                                 FontSize="13"/>
                                        <TextBlock Grid.Column="2" Text="{Binding NetAmountText}"
                                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource HighlightBrush}"/>
                                    </Grid>

                                    <TextBox Margin="0,10,0,0"
                                             Text="{Binding BankFeesText, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="عمولة المصرف"
                                             Style="{StaticResource NumericTextBox}"
                                             FontSize="13"
                                             Visibility="{Binding ShowBankFeesField, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Document links -->
                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding ShowDocumentLinkFields, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding OpenCreditInvoices}"
                                          SelectedItem="{Binding SelectedLinkedInvoice}"
                                          DisplayMemberPath="InvoiceNumber"
                                          materialDesign:HintAssist.Hint="فاتورة آجلة (اختياري)"
                                          Style="{StaticResource FilledComboBox}"
                                          FontSize="13"
                                          IsEditable="False"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding OpenInstallments}"
                                          SelectedItem="{Binding SelectedLinkedInstallment}"
                                          materialDesign:HintAssist.Hint="قسط مستحق (اختياري)"
                                          Style="{StaticResource FilledComboBox}"
                                          FontSize="13"
                                          IsEditable="False">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding DueDate, StringFormat=yyyy/MM/dd, Mode=OneWay}"/>
                                                <Run Text=" — متبقي "/>
                                                <Run Text="{Binding RemainingAmount, StringFormat=N0, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <TextBox Margin="0,12,0,0"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="ملاحظات (اختياري)"
                                     Style="{StaticResource FilledTextBox}"
                                     FontSize="13"
                                     AcceptsReturn="True"
                                     MinHeight="56"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="2" Padding="22,14" BorderBrush="{DynamicResource SubtleBorderBrush}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Command="{Binding CreateVoucherCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White" FontSize="14" Padding="28,10"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="حفظ السند" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Content="إلغاء" Command="{Binding CloseCreateDialogCommand}"
                                        Style="{StaticResource FlatButton}" Margin="8,0,0,0"
                                        Padding="20,10" materialDesign:ButtonAssist.CornerRadius="10"/>
                            </StackPanel>
                            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Center"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <!-- Main page: list only -->
        <Grid Margin="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Action bar -->
            <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0"
                                 Padding="20" Margin="0,0,0,16"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,10,0"
                                Background="{DynamicResource PrimaryHueLightBrush}">
                            <materialDesign:PackIcon Kind="ReceiptText" Width="18" Height="18"
                                                     Foreground="{DynamicResource HighlightBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="السندات" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="قبض · صرف · دين · مستثمر · مصرفي"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Command="{Binding OpenCreateDialogCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Padding="20,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="سند جديد" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LoadVouchersCommand}"
                                Style="{StaticResource FlatButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ComboBox Width="140" Margin="0,0,8,0"
                                  ItemsSource="{Binding FilterTypeOptions}"
                                  SelectedItem="{Binding SelectedFilterTypeOption}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="نوع السند"
                                  Style="{StaticResource FilledComboBox}"/>
                        <DatePicker Width="130" Margin="0,0,8,0"
                                    SelectedDate="{Binding DateFrom}"
                                    materialDesign:HintAssist.Hint="من تاريخ"
                                    Style="{StaticResource FilledDatePicker}"/>
                        <DatePicker Width="130" Margin="0,0,8,0"
                                    SelectedDate="{Binding DateTo}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ"
                                    Style="{StaticResource FilledDatePicker}"/>
                        <TextBox Width="220" Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="بحث برقم السند أو الطرف..."
                                 materialDesign:TextFieldAssist.HasClearButton="True"
                                 Style="{StaticResource FilledTextBox}"/>
                        <Button Command="{Binding SearchVouchersCommand}"
                                Style="{StaticResource FlatButton}"
                                materialDesign:ButtonAssist.CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="بحث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" UniformCornerRadius="12" Padding="0"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <controls:ListTableHeaderBar Grid.Row="0"
                                                 Title="قائمة السندات"
                                                 TargetDataGrid="{Binding ElementName=VouchersGrid}"
                                                 IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 ExportCommand="{Binding ExportVouchersCommand}"
                                                 PrintCommand="{Binding PrintTableCommand}"
                                                 ShowCardToggle="False"/>

                    <DataGrid x:Name="VouchersGrid"
                              Grid.Row="1" ItemsSource="{Binding Vouchers}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="True" CanUserReorderColumns="False"
                              materialDesign:DataGridAssist.CellPadding="10 6"
                              HeadersVisibility="Column" FontSize="13" Margin="8"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherNumber">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="النوع" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding VoucherType, Converter={StaticResource VoucherTypeToText}}"
                                                   Foreground="{Binding VoucherType, Converter={StaticResource VoucherTypeToBrush}}"
                                                   FontWeight="Bold" FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="العمولة" Binding="{Binding BankFees, StringFormat=N0}" Width="90"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BankFees"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                            <DataGridTextColumn Header="الصندوق" Binding="{Binding CashBox.Name}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CashBox.Name"/>
                            <DataGridTextColumn Header="الطرف" Binding="{Binding PartyDisplayName}" Width="140"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PartyDisplayName"/>
                            <DataGridTextColumn Header="فاتورة مرتبطة" Binding="{Binding Invoice.InvoiceNumber}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Invoice.InvoiceNumber"/>
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                            <DataGridTemplateColumn Header="إرسال" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.PrintVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TablePrintIconButton}"
                                                    ToolTip="طباعة">
                                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.SendVoucherWhatsAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TableWhatsAppIconButton}"
                                                    ToolTip="إرسال السند عبر واتساب">
                                                <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="حذف" Width="70"
                                                    behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.DeleteVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                ToolTip="حذف">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationBar Grid.Row="2"/>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
