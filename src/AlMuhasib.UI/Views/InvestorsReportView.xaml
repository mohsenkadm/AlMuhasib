<UserControl x:Class="AlMuhasib.UI.Views.InvestorsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InvestorsReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير المستثمرين" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="إجمالي الاستثمارات"
                        TextValue="{Binding TotalInvestments}"
                        Icon="Cash"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="إجمالي الأرباح الموزعة"
                        TextValue="{Binding TotalDistributed}"
                        Icon="CashCheck"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="عدد المستثمرين"
                        TextValue="{Binding InvestorCount}"
                        Icon="AccountGroup"
                        IconBackground="{DynamicResource AccentLightBrush}"
                        IconForeground="{DynamicResource AccentBrush}"
                        ValueForeground="{DynamicResource AccentBrush}"/>
                    <controls:AnimatedStatCard
                        Title="آخر توزيع"
                        TextValue="{Binding LastDistributionDate}"
                        Icon="CalendarToday"
                        IconBackground="#E0F2F1"
                        IconForeground="#00796B"
                        ValueForeground="#00796B"/>
                </UniformGrid>

                <!-- ═══ Charts ═══ -->
                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <controls:ChartCard Title="حصص المستثمرين" Margin="0,0,8,0">
                        <controls:ChartCard.ChartContent>
                            <lvc:PieChart Series="{Binding SharesSeries}" Height="300"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                    <controls:ChartCard Title="الأرباح الموزعة" Margin="8,0,0,0">
                        <controls:ChartCard.ChartContent>
                            <lvc:PieChart Series="{Binding DistributedSeries}" Height="300"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                </UniformGrid>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Investors}" SelectedValue="{Binding SelectedInvestorId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المستثمر" Width="160" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستثمر" Binding="{Binding InvestorName}" Width="*"/>
                                <DataGridTextColumn Header="إجمالي الإيداع" Binding="{Binding TotalDeposit, StringFormat=N0}" Width="130"/>
                                <DataGridTextColumn Header="الإيداع المؤهل" Binding="{Binding EligibleDeposit, StringFormat=N0}" Width="130"/>
                                <DataGridTextColumn Header="نسبة الربح %" Binding="{Binding ProfitPercentage}" Width="110"/>
                                <DataGridTextColumn Header="الأرباح الموزعة" Binding="{Binding TotalDistributed, StringFormat=N0}" Width="130"/>
                                <DataGridTextColumn Header="آخر سحب" Binding="{Binding LastWithdrawal, StringFormat=\{0:yyyy/MM/dd\}, TargetNullValue=—}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="0,0,12,12" Padding="16,8">
                            <Grid>
                                <TextBlock Text="{Binding PaginationText}" VerticalAlignment="Center" FontSize="12" Foreground="#757575"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource IconButton}" Command="{Binding LastPageCommand}"><materialDesign:PackIcon Kind="ChevronDoubleRight"/></Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}"><materialDesign:PackIcon Kind="ChevronRight"/></Button>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalPages, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}"><materialDesign:PackIcon Kind="ChevronLeft"/></Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding FirstPageCommand}"><materialDesign:PackIcon Kind="ChevronDoubleLeft"/></Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
