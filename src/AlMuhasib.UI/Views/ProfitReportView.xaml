<UserControl x:Class="AlMuhasib.UI.Views.ProfitReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfitReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير الأرباح" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي المبيعات" TextValue="{Binding TotalSales}" Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي المشتريات" TextValue="{Binding TotalPurchases}" Icon="CartArrowDown" IconBackground="{DynamicResource HighlightLightBrush}" IconForeground="{DynamicResource HighlightBrush}" ValueForeground="{DynamicResource HighlightBrush}"/>
                    <controls:AnimatedStatCard Title="صافي الربح" TextValue="{Binding NetProfit}" Icon="TrendingUp" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="هامش الربح" TextValue="{Binding ProfitMargin}" Icon="Percent" IconBackground="#E0F2F1" IconForeground="#00796B" ValueForeground="#00796B"/>
                </UniformGrid>

                <!-- ═══ Chart ═══ -->
                <controls:ChartCard Title="الأرباح الشهرية">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}" Height="350"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                       ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                       ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                       TargetDataGrid="{Binding ElementName=ProfitReportGrid}"
                                                       Margin="0,0,12,0"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="ProfitReportGrid"
                                  ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الشهر" Binding="{Binding Month}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Month"/>
                                <DataGridTextColumn Header="المبيعات" Binding="{Binding Sales, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Sales"/>
                                <DataGridTextColumn Header="المشتريات" Binding="{Binding Purchases, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Purchases"/>
                                <DataGridTextColumn Header="إجمالي الربح" Binding="{Binding GrossProfit, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GrossProfit"/>
                                <DataGridTextColumn Header="المصروفات" Binding="{Binding Expenses, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Expenses"/>
                                <DataGridTextColumn Header="صافي الربح" Binding="{Binding NetProfit, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NetProfit"/>
                                <DataGridTextColumn Header="هامش الربح %" Binding="{Binding ProfitMargin, StringFormat=N1}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProfitMargin"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <controls:PaginationBar Grid.Row="1"/>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
