<UserControl x:Class="AlMuhasib.UI.Views.ProfitReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfitReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,24">

                <TextBlock Text="تقرير الأرباح" FontSize="26" FontWeight="Bold" Margin="0,0,0,16"/>

                <!-- Filter Bar -->
                <Border Style="{StaticResource FilterBar}" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="150" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="150" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <Button Content="عرض تفاصيل الأرباح" Style="{StaticResource AccentButton}"
                                Command="{Binding ToggleDetailsCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Stat Cards -->
                <UniformGrid Columns="5" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي المبيعات" TextValue="{Binding TotalSales}"
                                                Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="تكلفة المبيعات" TextValue="{Binding CostOfSales}"
                                                Icon="CartArrowDown" IconBackground="#FFF3E0" IconForeground="#E65100" ValueForeground="#E65100"/>
                    <controls:AnimatedStatCard Title="إجمالي الربح" TextValue="{Binding GrossProfit}"
                                                Icon="TrendingUp" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="إجمالي المصاريف" TextValue="{Binding TotalExpenses}"
                                                Icon="CashMinus" IconBackground="#FCE4EC" IconForeground="#C2185B" ValueForeground="#C2185B"/>
                    <controls:AnimatedStatCard Title="صافي الأرباح" TextValue="{Binding NetProfit}"
                                                Icon="Finance" IconBackground="#E0F2F1" IconForeground="#00695C" ValueForeground="#00695C"/>
                </UniformGrid>

                <!-- Chart -->
                <controls:ChartCard Title="ملخص الأرباح للفترة المحددة" Margin="0,0,0,20">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding PeriodSeries}" XAxes="{Binding PeriodXAxes}"
                                            YAxes="{Binding PeriodYAxes}" Height="320"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- Details Panel -->
                <materialDesign:Card Padding="20" materialDesign:ElevationAssist.Elevation="Dp2"
                                     Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="تفاصيل مصادر الأرباح" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBlock Text="تفاصيل الفواتير المباعة" FontSize="15" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <controls:AnimatedStatCard Title="عدد الفواتير" TextValue="{Binding DetailInvoiceCount}"
                                                        Icon="FileDocument" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                            <controls:AnimatedStatCard Title="إجمالي مبيعات الفواتير" TextValue="{Binding DetailInvoiceRevenue}"
                                                        Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                            <controls:AnimatedStatCard Title="إجمالي ربح الفواتير" TextValue="{Binding DetailInvoiceProfit}"
                                                        Icon="TrendingUp" IconBackground="#FFF3E0" IconForeground="#E65100" ValueForeground="#E65100"/>
                        </UniformGrid>

                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <controls:ListTableHeaderBar Grid.Row="0"
                                                             Title="تفاصيل الفواتير المباعة"
                                                             TargetDataGrid="{Binding ElementName=ProfitInvoiceGrid}"
                                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                             ExportCommand="{Binding ExportToExcelCommand}"
                                                             PrintCommand="{Binding PrintCommand}"
                                                             ShowCardToggle="False"/>
                                <DataGrid x:Name="ProfitInvoiceGrid" Grid.Row="1"
                                          ItemsSource="{Binding InvoiceRows}" Style="{StaticResource ModernDataGrid}"
                                          IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="220"
                                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceNumber"/>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                                                            <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerFileNumber}" Width="90"/>
                                        <DataGridTextColumn Header="النوع" Binding="{Binding InvoiceTypeLabel}" Width="80"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceTypeLabel"/>
                                        <DataGridTextColumn Header="البنود" Binding="{Binding ItemCount}" Width="70"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ItemCount"/>
                                        <DataGridTextColumn Header="المبيعات" Binding="{Binding Revenue, StringFormat=N0}" Width="110"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Revenue"/>
                                        <DataGridTextColumn Header="التكلفة" Binding="{Binding Cost, StringFormat=N0}" Width="110"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Cost"/>
                                        <DataGridTextColumn Header="الربح" Binding="{Binding GrossProfit, StringFormat=N0}" Width="110"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GrossProfit"/>
                                        <DataGridTextColumn Header="هامش %" Binding="{Binding MarginPercent, StringFormat=N1}" Width="80"
                                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="MarginPercent"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <TextBlock Text="تفاصيل المنتجات" FontSize="15" FontWeight="SemiBold" Foreground="#7B1FA2" Margin="0,0,0,10"/>
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <controls:AnimatedStatCard Title="عدد المنتجات" TextValue="{Binding DetailProductCount}"
                                                        Icon="PackageVariant" IconBackground="#F3E5F5" IconForeground="#7B1FA2" ValueForeground="#7B1FA2"/>
                            <controls:AnimatedStatCard Title="إجمالي الكميات المباعة" TextValue="{Binding DetailTotalQuantity}"
                                                        Icon="Counter" IconBackground="#E8EAF6" IconForeground="#3949AB" ValueForeground="#3949AB"/>
                            <controls:AnimatedStatCard Title="أعلى منتج ربحاً" TextValue="{Binding DetailTopProduct}"
                                                        Icon="Trophy" IconBackground="#FFF8E1" IconForeground="#F9A825" ValueForeground="#F9A825"/>
                        </UniformGrid>

                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <controls:ListTableHeaderBar Grid.Row="0"
                                                             Title="تفاصيل المنتجات"
                                                             TargetDataGrid="{Binding ElementName=ProfitProductGrid}"
                                                             ShowExport="False"
                                                             ShowPrint="False"
                                                             ShowFilter="False"
                                                             ShowCardToggle="False"/>
                                <DataGrid x:Name="ProfitProductGrid" Grid.Row="1"
                                          ItemsSource="{Binding DetailRows}" Style="{StaticResource ModernDataGrid}"
                                          IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="2*"/>
                                        <DataGridTextColumn Header="الكمية" Binding="{Binding QuantitySold, StringFormat=N0}" Width="100"/>
                                        <DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N0}" Width="120"/>
                                        <DataGridTextColumn Header="التكلفة" Binding="{Binding Cost, StringFormat=N0}" Width="120"/>
                                        <DataGridTextColumn Header="الربح" Binding="{Binding GrossProfit, StringFormat=N0}" Width="120"/>
                                        <DataGridTextColumn Header="هامش %" Binding="{Binding MarginPercent, StringFormat=N1}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <Border Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
