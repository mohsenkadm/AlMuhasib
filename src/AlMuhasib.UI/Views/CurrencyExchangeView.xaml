<UserControl x:Class="AlMuhasib.UI.Views.CurrencyExchangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="تحديث" Command="{Binding RefreshCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Refresh" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تنفيذ الصيرفة" Command="{Binding SaveExchangeCommand}"
                      IsEnabled="{Binding CanAdd}">
                <MenuItem.Icon><md:PackIcon Kind="CurrencyUsd" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تراجع عن المحدد" Command="{Binding ReverseSelectedCommand}"
                      IsEnabled="{Binding CanDelete}">
                <MenuItem.Icon><md:PackIcon Kind="Undo" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Margin="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16"
                 md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="صيرفة — تحويل بين عملات القاصات" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding LatestRateDisplay}" FontSize="13" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}"
                        md:ButtonAssist.CornerRadius="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="تحديث"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <!-- Create form -->
        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16"
                 md:ElevationAssist.Elevation="Dp2"
                 IsEnabled="{Binding CanAdd}">
            <StackPanel>
                <TextBlock Text="عملية صيرفة جديدة" FontWeight="Bold" FontSize="14"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <ComboBox ItemsSource="{Binding FromCashBoxes}"
                              SelectedItem="{Binding SelectedFromCashBox}"
                              DisplayMemberPath="DisplayNameWithCurrency"
                              md:HintAssist.Hint="من قاصة"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding ToCashBoxes}"
                              SelectedItem="{Binding SelectedToCashBox}"
                              DisplayMemberPath="DisplayNameWithCurrency"
                              md:HintAssist.Hint="إلى قاصة"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="4,0"/>
                    <DatePicker SelectedDate="{Binding ExchangeDate}"
                                md:HintAssist.Hint="التاريخ"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Margin="8,0,0,0"/>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,0,0,10">
                    <TextBox Text="{Binding FromAmount, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="المبلغ من عملة المصدر"
                             Style="{StaticResource NumericTextBox}"
                             Margin="0,0,8,0"/>
                    <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="سعر الصرف (1$ = ؟ د.ع)"
                             Style="{StaticResource NumericTextBox}"
                             Margin="4,0"/>
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
                            Padding="12,8" Margin="8,0,0,0" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="المبلغ الناتج" FontSize="11"
                                       Foreground="{DynamicResource HintForegroundBrush}"/>
                            <TextBlock Text="{Binding ToAmountPreviewDisplay}" FontSize="16" FontWeight="Bold"
                                       Foreground="#1565C0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="تنفيذ الصيرفة"
                            Command="{Binding SaveExchangeCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Height="40" Padding="22,0"
                            Margin="12,0,0,0"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="ملاحظات (اختياري)"
                             Style="{StaticResource FilledTextBox}"/>
                </DockPanel>
            </StackPanel>
        </md:Card>

        <!-- Filters -->
        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,16"
                 md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="بحث في القاصة أو الملاحظات"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFromDate}"
                            md:HintAssist.Hint="من تاريخ"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="150" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="2" SelectedDate="{Binding FilterToDate}"
                            md:HintAssist.Hint="إلى تاريخ"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="150" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding FilterCashBoxes}"
                          SelectedItem="{Binding FilterCashBox}"
                          DisplayMemberPath="Name"
                          md:HintAssist.Hint="القاصة"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Width="180" Margin="0,0,8,0"/>
                <Button Grid.Column="4" Content="بحث" Command="{Binding ApplyFiltersCommand}"
                        Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8" Padding="16,8"/>
            </Grid>
        </md:Card>

        <!-- History grid -->
        <md:Card Grid.Row="3" Style="{StaticResource ElevatedCard}" Padding="0"
                 md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="سجل عمليات الصيرفة"
                                             TargetDataGrid="{Binding ElementName=ExchangeGrid}"
                                             ShowCardToggle="False"
                                             ShowExport="False"
                                             ShowPrint="False"
                                             ShowFilter="False"/>
                <DataGrid x:Name="ExchangeGrid" Grid.Row="1"
                          ItemsSource="{Binding History}"
                          SelectedItem="{Binding SelectedExchange}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"/>
                        <DataGridTextColumn Header="من قاصة" Binding="{Binding FromCashBoxName}" Width="*"/>
                        <DataGridTextColumn Header="إلى قاصة" Binding="{Binding ToCashBoxName}" Width="*"/>
                        <DataGridTextColumn Header="التحويل" Binding="{Binding DirectionDisplay}" Width="220"/>
                        <DataGridTextColumn Header="سعر الصرف" Binding="{Binding FxRate, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>

        <!-- Footer -->
        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="تراجع عن المحدد" Command="{Binding ReverseSelectedCommand}"
                        Style="{StaticResource OutlinedButton}" md:ButtonAssist.CornerRadius="8"
                        Padding="14,8" IsEnabled="{Binding CanDelete}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="السابق" Command="{Binding PrevPageCommand}" Margin="0,0,8,0"
                        IsEnabled="{Binding CanGoPrev}" Style="{StaticResource FlatButton}"/>
                <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                    <Run Text="صفحة "/><Run Text="{Binding CurrentPage, Mode=OneWay}"/>
                    <Run Text=" / "/><Run Text="{Binding TotalPages, Mode=OneWay}"/>
                    <Run Text=" ("/><Run Text="{Binding TotalCount, Mode=OneWay}"/><Run Text=")"/>
                </TextBlock>
                <Button Content="التالي" Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}" Style="{StaticResource FlatButton}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
