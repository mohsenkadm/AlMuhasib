<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    
    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث / تحديث" Command="{Binding LoadDataCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="عقد جديد" Command="{Binding OpenNewContractCommand}">
                <MenuItem.Icon><md:PackIcon Kind="FileDocumentPlus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

<ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="عقد جديد" Command="{Binding OpenNewContractCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="العقود" Command="{Binding OpenContractsCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"/>
                    <Button Content="المدينون" Command="{Binding OpenDebtsCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"/>
                    <Button Content="تحديث" Command="{Binding LoadDataCommand}" Style="{StaticResource FlatButton}"/>
                </StackPanel>
                <TextBlock Text="لوحة التحكم — عقود العقارات" FontSize="24" FontWeight="Bold"
                           Foreground="#1565C0" VerticalAlignment="Center"/>
            </DockPanel>

            <UniformGrid Columns="4" Margin="0,0,0,12">
                <controls:AnimatedStatCard Title="عقود اليوم" TextValue="{Binding TodayContractsText}"
                                            Icon="CalendarToday" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                <controls:AnimatedStatCard Title="عقود الشهر" TextValue="{Binding MonthContractsText}"
                                            Icon="CalendarMonth" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                <controls:AnimatedStatCard Title="غير مسددة" TextValue="{Binding UnpaidContractsText}"
                                            Icon="CashClock" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}" IconForeground="#E65100" ValueForeground="#E65100"/>
                <controls:AnimatedStatCard Title="ديون متأخرة" TextValue="{Binding OverdueDebtsText}"
                                            Icon="AlertCircle" IconBackground="{DynamicResource DashboardKpiRedLightBrush}" IconForeground="#C62828" ValueForeground="#C62828"/>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="0,0,0,16">
                <controls:AnimatedStatCard Title="إجمالي القيمة" TextValue="{Binding TotalValueText}"
                                            Icon="Cash" IconBackground="{DynamicResource DashboardKpiTealLightBrush}" IconForeground="#00695C" ValueForeground="#00695C"/>
                <controls:AnimatedStatCard Title="المحصّل" TextValue="{Binding TotalReceivedText}"
                                            Icon="CashCheck" IconBackground="{DynamicResource DashboardKpiIndigoLightBrush}" IconForeground="#3949AB" ValueForeground="#3949AB"/>
                <controls:AnimatedStatCard Title="المتبقي" TextValue="{Binding TotalRemainingText}"
                                            Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiPinkLightBrush}" IconForeground="#C2185B" ValueForeground="#C2185B"/>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ChartCard Grid.Column="0" Title="العقود الشهرية" Subtitle="عدد العقود" Margin="0,0,12,0">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding MonthlySeries}"
                                            XAxes="{Binding MonthlyXAxes}"
                                            YAxes="{Binding MonthlyYAxes}"
                                            Height="260" FlowDirection="LeftToRight"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
                <controls:ChartCard Grid.Column="1" Title="حالة التسديد" Subtitle="محصّل مقابل متبقي">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding StatusSeries}" Height="260" FlowDirection="LeftToRight"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
            </Grid>

            <md:Card Style="{StaticResource ElevatedCard}" Padding="16" md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="أحدث العقود" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <DataGrid ItemsSource="{Binding RecentContracts}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="120"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding ContractType}" Width="80"/>
                            <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"/>
                            <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding TotalPrice, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
