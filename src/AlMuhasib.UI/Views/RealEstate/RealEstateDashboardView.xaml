<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <ScrollViewer Padding="24">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="عقد جديد" Command="{Binding OpenNewContractCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                    <Button Content="العقود" Command="{Binding OpenContractsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                    <Button Content="المدينون" Command="{Binding OpenDebtsCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
                <TextBlock Text="لوحة التحكم — عقود العقارات" FontSize="22" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
            </DockPanel>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="عقود اليوم" Foreground="#78909C"/><TextBlock Text="{Binding TodayContracts}" FontSize="24" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="عقود الشهر" Foreground="#78909C"/><TextBlock Text="{Binding MonthContracts}" FontSize="24" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="غير مسددة" Foreground="#78909C"/><TextBlock Text="{Binding UnpaidContracts}" FontSize="24" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="ديون متأخرة" Foreground="#C62828"/><TextBlock Text="{Binding OverdueDebts}" FontSize="24" FontWeight="Bold" Foreground="#C62828"/></StackPanel></md:Card>
            </UniformGrid>
            <UniformGrid Columns="3" Margin="0,0,0,16">
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="إجمالي القيمة" Foreground="#78909C"/><TextBlock Text="{Binding TotalValue, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="المحصّل" Foreground="#78909C"/><TextBlock Text="{Binding TotalReceived, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
                <md:Card Padding="16" Margin="4"><StackPanel><TextBlock Text="المتبقي" Foreground="#78909C"/><TextBlock Text="{Binding TotalRemaining, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <md:Card Grid.Column="0" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="العقود الشهرية" FontWeight="Bold" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}" Height="260"/>
                    </StackPanel>
                </md:Card>
                <md:Card Grid.Column="1" Padding="12" Margin="4">
                    <StackPanel>
                        <TextBlock Text="حالة التسديد" FontWeight="Bold" Margin="0,0,0,8"/>
                        <lvc:PieChart Series="{Binding StatusSeries}" Height="260"/>
                    </StackPanel>
                </md:Card>
            </Grid>
            <md:Card Padding="12" Margin="4,16,4,0">
                <StackPanel>
                    <TextBlock Text="أحدث العقود" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding RecentContracts}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم" Binding="{Binding ContractNumber}" Width="120"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding ContractType}" Width="80"/>
                            <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"/>
                            <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
