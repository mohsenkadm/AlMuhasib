<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateContractsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="تقرير عقود العقارات" FontSize="24" FontWeight="Bold"
                       Foreground="#2E7D32" Margin="0,0,0,16"/>

            <UniformGrid Columns="5" Margin="0,0,0,16">
                <controls:AnimatedStatCard Title="عدد العقود" TextValue="{Binding ContractsCountText}"
                                            Icon="FileDocumentMultiple" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                <controls:AnimatedStatCard Title="إجمالي القيمة" TextValue="{Binding TotalValueText}"
                                            Icon="Cash" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                <controls:AnimatedStatCard Title="المحصّل" TextValue="{Binding TotalReceivedText}"
                                            Icon="CashCheck" IconBackground="#E0F2F1" IconForeground="#00695C" ValueForeground="#00695C"/>
                <controls:AnimatedStatCard Title="المتبقي" TextValue="{Binding TotalRemainingText}"
                                            Icon="CashClock" IconBackground="#FFF3E0" IconForeground="#E65100" ValueForeground="#E65100"/>
                <controls:AnimatedStatCard Title="غير مسددة" TextValue="{Binding UnpaidCountText}"
                                            Icon="AlertCircleOutline" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
            </UniformGrid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <controls:ChartCard Grid.Column="0" Title="العقود الشهرية" Subtitle="عدد العقود حسب الشهر" Margin="0,0,12,0">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding MonthlySeries}"
                                            XAxes="{Binding MonthlyXAxes}"
                                            YAxes="{Binding MonthlyYAxes}"
                                            Height="240" FlowDirection="LeftToRight"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
                <controls:ChartCard Grid.Column="1" Title="حسب نوع العقار" Margin="0,0,12,0">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding TypeSeries}" Height="240" FlowDirection="LeftToRight"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
                <controls:ChartCard Grid.Column="2" Title="حسب نوع العملية">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding ContractTypeSeries}" Height="240" FlowDirection="LeftToRight"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
            </Grid>

            <Border Style="{StaticResource FilterBar}" Margin="0,0,0,16">
                <WrapPanel>
                    <DatePicker Width="150" md:HintAssist.Hint="من تاريخ" SelectedDate="{Binding DateFrom}"
                                Style="{StaticResource FilledDatePicker}" Margin="0,0,8,8"/>
                    <DatePicker Width="150" md:HintAssist.Hint="إلى تاريخ" SelectedDate="{Binding DateTo}"
                                Style="{StaticResource FilledDatePicker}" Margin="0,0,8,8"/>
                    <TextBox Width="200" md:HintAssist.Hint="بحث في التقرير..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,8,8"/>
                    <Button Content="بحث" Command="{Binding LoadReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
                    <TextBox Width="180" md:HintAssist.Hint="بحث داخل الجدول..."
                             Text="{Binding TableSearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                </WrapPanel>
            </Border>

            <md:Card Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <controls:ListTableHeaderBar Grid.Row="0"
                                                 Title="تفاصيل العقود"
                                                 TargetDataGrid="{Binding ElementName=ReportGrid}"
                                                 IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 ExportCommand="{Binding ExportExcelCommand}"
                                                 PrintCommand="{Binding PrintReportCommand}"
                                                 ShowCardToggle="True"/>
                    <DataGrid x:Name="ReportGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FilteredRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              MaxHeight="480"
                              Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractNumber"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding ContractDate, StringFormat=yyyy/MM/dd}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractDate"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding ContractType}" Width="70"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractType"/>
                            <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SellerName"/>
                            <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BuyerName"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding TotalPrice, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalPrice"/>
                            <DataGridTextColumn Header="المدفوع" Binding="{Binding AmountPaid, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AmountPaid"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ScrollViewer Grid.Row="1"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  MaxHeight="480" VerticalScrollBarVisibility="Auto" Padding="12">
                        <ItemsControl ItemsSource="{Binding FilteredRows}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="280" Margin="8" Padding="14" Background="White"
                                            BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding ContractDate, StringFormat=yyyy/MM/dd}" Foreground="#78909C" Margin="0,4,0,0"/>
                                            <TextBlock Margin="0,8,0,0"><Run Text="بائع: "/><Run Text="{Binding SellerName}"/></TextBlock>
                                            <TextBlock><Run Text="مشتري: "/><Run Text="{Binding BuyerName}"/></TextBlock>
                                            <TextBlock FontWeight="SemiBold" Margin="0,8,0,0" Foreground="#2E7D32">
                                                <Run Text="السعر: "/><Run Text="{Binding TotalPrice, StringFormat=N0}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
