<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateContractsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             Style="{StaticResource PageStyle}" FlowDirection="RightToLeft">
  <ScrollViewer Padding="16">
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button Content="تحديث" Command="{Binding LoadReportCommand}" Margin="0,0,8,0"/>
          <Button Content="Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0"/>
          <Button Content="طباعة" Command="{Binding PrintReportCommand}"/>
        </StackPanel>
        <TextBlock Text="تقرير عقود العقارات" FontSize="20" FontWeight="Bold" Foreground="#2E7D32"/>
      </DockPanel>
      <WrapPanel Margin="0,0,0,12">
        <DatePicker Width="140" md:HintAssist.Hint="من" SelectedDate="{Binding DateFrom}" Margin="0,0,8,0"/>
        <DatePicker Width="140" md:HintAssist.Hint="إلى" SelectedDate="{Binding DateTo}" Margin="0,0,8,0"/>
        <TextBox Width="200" md:HintAssist.Hint="بحث" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
      </WrapPanel>
      <UniformGrid Columns="3" Margin="0,0,0,12">
        <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="الإجمالي"/><TextBlock Text="{Binding TotalValue, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
        <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="المحصّل"/><TextBlock Text="{Binding TotalReceived, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
        <md:Card Padding="12" Margin="4"><StackPanel><TextBlock Text="المتبقي"/><TextBlock Text="{Binding TotalRemaining, StringFormat=N0}" FontSize="20" FontWeight="Bold"/></StackPanel></md:Card>
      </UniformGrid>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <md:Card Grid.Column="0" Padding="12" Margin="4">
          <StackPanel>
            <TextBlock Text="العقود الشهرية" FontWeight="Bold" Margin="0,0,0,8"/>
            <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}" Height="240"/>
          </StackPanel>
        </md:Card>
        <md:Card Grid.Column="1" Padding="12" Margin="4">
          <StackPanel>
            <TextBlock Text="حسب نوع العقار" FontWeight="Bold" Margin="0,0,0,8"/>
            <lvc:PieChart Series="{Binding TypeSeries}" Height="240"/>
          </StackPanel>
        </md:Card>
      </Grid>
      <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
        <DataGrid.Columns>
          <DataGridTextColumn Header="رقم" Binding="{Binding ContractNumber}" Width="120"/>
          <DataGridTextColumn Header="التاريخ" Binding="{Binding ContractDate, StringFormat=yyyy/MM/dd}" Width="100"/>
          <DataGridTextColumn Header="النوع" Binding="{Binding ContractType}" Width="70"/>
          <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"/>
          <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"/>
          <DataGridTextColumn Header="السعر" Binding="{Binding TotalPrice, StringFormat=N0}" Width="100"/>
          <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
