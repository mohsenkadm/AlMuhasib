<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateClauseTemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}" FlowDirection="RightToLeft">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button Content="بند جديد" Command="{Binding OpenNewCommand}" Style="{StaticResource MaterialDesignRaisedButton}" DockPanel.Dock="Left"/>
      <TextBlock Text="بنود العقد الجاهزة" FontSize="20" FontWeight="Bold" Foreground="#455A64"/>
    </DockPanel>
    <DataGrid Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding SortOrder}" Width="50"/>
        <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="180"/>
        <DataGridTextColumn Header="النص" Binding="{Binding Body}" Width="*"/>
        <DataGridCheckBoxColumn Header="مفعّل" Binding="{Binding IsActive}" Width="70"/>
        <DataGridTemplateColumn Header="إجراءات" Width="160">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="تعديل" Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                <Button Content="حذف" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <md:DialogHost IsOpen="{Binding IsEditOpen}" Grid.RowSpan="2">
      <md:DialogHost.DialogContent>
        <StackPanel Margin="24" Width="480">
          <TextBlock Text="تعديل بند" FontWeight="Bold" Margin="0,0,0,12"/>
          <TextBox md:HintAssist.Hint="الترتيب" Text="{Binding EditSortOrder}" Margin="0,0,0,8"/>
          <TextBox md:HintAssist.Hint="العنوان" Text="{Binding EditTitle}" Margin="0,0,0,8"/>
          <TextBox md:HintAssist.Hint="النص" Text="{Binding EditBody}" AcceptsReturn="True" Height="120" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <CheckBox Content="مفعّل" IsChecked="{Binding EditIsActive}" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding CloseEditCommand}"/>
          </StackPanel>
        </StackPanel>
      </md:DialogHost.DialogContent>
    </md:DialogHost>
  </Grid>
</UserControl>
