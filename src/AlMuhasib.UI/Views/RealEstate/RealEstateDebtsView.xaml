<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateDebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="كشف المدينين" FontSize="24" FontWeight="Bold"
                   Foreground="#C62828" Margin="0,0,0,16"/>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="عدد المدينين" TextValue="{Binding DebtorsCountText}"
                                        Icon="AccountCash" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="إجمالي الدين" TextValue="{Binding TotalDebtText}"
                                        Icon="Cash" IconBackground="#FFF3E0" IconForeground="#E65100" ValueForeground="#E65100"/>
            <controls:AnimatedStatCard Title="المتأخرون" TextValue="{Binding OverdueCountText}"
                                        Icon="AlertCircle" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
            <controls:AnimatedStatCard Title="مبلغ المتأخر" TextValue="{Binding OverdueAmountText}"
                                        Icon="CashClock" IconBackground="#FCE4EC" IconForeground="#AD1457" ValueForeground="#AD1457"/>
        </UniformGrid>

        <controls:ChartCard Grid.Row="2" Title="توزيع الديون" Subtitle="حالية مقابل متأخرة" Margin="0,0,0,16">
            <controls:ChartCard.ChartContent>
                <lvc:PieChart Series="{Binding StatusSeries}" Height="200" FlowDirection="LeftToRight"
                              MaxWidth="360" HorizontalAlignment="Center"/>
            </controls:ChartCard.ChartContent>
        </controls:ChartCard>

        <Border Grid.Row="3" Style="{StaticResource FilterBar}" Margin="0,0,0,16">
            <WrapPanel>
                <TextBox Width="220" md:HintAssist.Hint="بحث في المدينين..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,8,8"/>
                <CheckBox Content="المتأخر فقط" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/>
            </WrapPanel>
        </Border>

        <md:Card Grid.Row="4" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="كشف المدينين"
                                             TargetDataGrid="{Binding ElementName=DebtsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="True"/>
                <Grid Grid.Row="1">
                <DataGrid x:Name="DebtsGrid"
                          ItemsSource="{Binding Debts}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="العقد" Binding="{Binding ContractNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractNumber"/>
                        <DataGridTextColumn Header="المدين" Binding="{Binding DebtorName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DebtorName"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding DebtorPhone}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DebtorPhone"/>
                        <DataGridTextColumn Header="الطرف" Binding="{Binding DebtorParty}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DebtorParty"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate"/>
                        <DataGridCheckBoxColumn Header="متأخر" Binding="{Binding IsOverdue}" Width="70"
                                               behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IsOverdue"/>
                        <DataGridTextColumn Header="أيام التأخير" Binding="{Binding DaysOverdue}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DaysOverdue"/>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding Debts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="280" Margin="8" Padding="14" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Background="#FFEBEE" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                                                    Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="متأخر" FontSize="11" FontWeight="SemiBold" Foreground="#C62828"/>
                                            </Border>
                                            <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding DebtorName}" FontSize="15" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding DebtorPhone}" Foreground="#78909C" Margin="0,2,0,0"/>
                                        <TextBlock FontWeight="Bold" Foreground="#C62828" Margin="0,10,0,0">
                                            <Run Text="المتبقي: "/><Run Text="{Binding RemainingAmount, StringFormat=N0}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" Foreground="#607D8B" FontSize="12">
                                            <Run Text="الاستحقاق: "/><Run Text="{Binding DueDate, StringFormat=yyyy/MM/dd}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
