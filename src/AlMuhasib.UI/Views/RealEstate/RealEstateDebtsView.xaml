<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateDebtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}" FlowDirection="RightToLeft">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="تصدير Excel" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0"/>
        <Button Content="طباعة" Command="{Binding PrintTableCommand}"/>
      </StackPanel>
      <TextBlock Text="كشف المدينين" FontSize="20" FontWeight="Bold" Foreground="#C62828"/>
    </DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBox Width="220" md:HintAssist.Hint="بحث" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0"/>
      <CheckBox Content="المتأخر فقط" IsChecked="{Binding OverdueOnly}" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <TextBlock VerticalAlignment="Center" Margin="0,0,16,0"><Run Text="إجمالي الدين: "/><Run Text="{Binding TotalDebt, StringFormat=N0}" FontWeight="Bold"/></TextBlock>
      <TextBlock VerticalAlignment="Center" Foreground="#C62828"><Run Text="متأخر: "/><Run Text="{Binding OverdueCount}" FontWeight="Bold"/></TextBlock>
    </WrapPanel>
    <DataGrid Grid.Row="2" ItemsSource="{Binding Debts}" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="العقد" Binding="{Binding ContractNumber}" Width="120"/>
        <DataGridTextColumn Header="المدين" Binding="{Binding DebtorName}" Width="*"/>
        <DataGridTextColumn Header="الهاتف" Binding="{Binding DebtorPhone}" Width="120"/>
        <DataGridTextColumn Header="الطرف" Binding="{Binding DebtorParty}" Width="90"/>
        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
        <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueDate, StringFormat=yyyy/MM/dd}" Width="110"/>
        <DataGridCheckBoxColumn Header="متأخر" Binding="{Binding IsOverdue}" Width="70"/>
        <DataGridTextColumn Header="أيام التأخير" Binding="{Binding DaysOverdue}" Width="90"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
