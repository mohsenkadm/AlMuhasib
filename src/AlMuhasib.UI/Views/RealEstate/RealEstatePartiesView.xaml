<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstatePartiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="الزبائن" FontSize="24" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,16"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="عدد الزبائن" TextValue="{Binding PartiesCountText}"
                                        Icon="AccountGroup" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="عليهم ديون" TextValue="{Binding WithDebtCountText}"
                                        Icon="AccountAlert" IconBackground="#FFF3E0" IconForeground="#E65100" ValueForeground="#E65100"/>
            <controls:AnimatedStatCard Title="إجمالي الديون" TextValue="{Binding TotalDebtText}"
                                        Icon="Cash" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource FilterBar}" Margin="0,0,0,16">
            <WrapPanel>
                <Button Content="زبون جديد" Command="{Binding OpenNewCommand}" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanAdd}" Margin="0,0,8,8"/>
                <Button Content="تحديث" Command="{Binding LoadCommand}" Style="{StaticResource FlatButton}" Margin="0,0,8,8"/>
                <TextBox Width="240" md:HintAssist.Hint="بحث في الزبائن..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,8,8"/>
                <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             TargetDataGrid="{Binding ElementName=PartiesGrid}"
                                             Margin="0,0,8,8" VerticalAlignment="Center"/>
                <controls:ListViewModeToggle OnDarkBackground="False" VerticalAlignment="Center" Margin="0,0,0,8"/>
            </WrapPanel>
        </Border>

        <md:Card Grid.Row="3" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <DataGrid x:Name="PartiesGrid"
                          ItemsSource="{Binding Parties}"
                          SelectedItem="{Binding SelectedParty}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Phone"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Address"/>
                        <DataGridTextColumn Header="الهوية" Binding="{Binding IdNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IdNumber"/>
                        <DataGridTextColumn Header="الدين" Binding="{Binding TotalDebt, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalDebt"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="160" behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="تعديل" Style="{StaticResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="حذف" Style="{StaticResource FlatButton}" Padding="8,4" Foreground="#C62828"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding Parties}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="260" Margin="8" Padding="14" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding Phone}" Foreground="#607D8B" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Address}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,0" Foreground="#C62828">
                                            <Run Text="الدين: "/><Run Text="{Binding TotalDebt, StringFormat=N0}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="تعديل" Style="{StaticResource OutlinedButton}" Padding="12,6" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="حذف" Style="{StaticResource FlatButton}" Padding="12,6" Foreground="#C62828"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </md:Card>

        <controls:PaginationBar Grid.Row="4" Margin="0,12,0,0"/>

        <md:DialogHost IsOpen="{Binding IsEditDialogOpen}" Grid.RowSpan="5">
            <md:DialogHost.DialogContent>
                <StackPanel Margin="24" Width="400">
                    <TextBlock Text="بيانات الزبون" FontWeight="Bold" FontSize="16" Margin="0,0,0,16"/>
                    <TextBlock Text="الاسم *" Style="{StaticResource FormFieldLabel}"/>
                    <TextBox Text="{Binding EditName}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="الهاتف" Style="{StaticResource FormFieldLabel}"/>
                    <TextBox Text="{Binding EditPhone}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="العنوان" Style="{StaticResource FormFieldLabel}"/>
                    <TextBox Text="{Binding EditAddress}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="رقم الهوية" Style="{StaticResource FormFieldLabel}"/>
                    <TextBox Text="{Binding EditIdNumber}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CloseEditCommand}" Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
