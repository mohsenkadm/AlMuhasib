<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateContractFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,24,24,8">
            <StackPanel MaxWidth="1120">
                <!-- Page header -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="12" Background="#E3F2FD" Margin="0,0,14,0">
                        <md:PackIcon Kind="HomeCityOutline" Width="26" Height="26"
                                     Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="#1565C0"/>
                        <TextBlock Text="أدخل بيانات عقد العقار — الحقول المطلوبة مميزة بعلامة *"
                                   FontSize="13" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Contract info -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="FileDocumentEditOutline" Width="22" Height="22" Foreground="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock Text="بيانات العقد" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="4">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="رقم العقد" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding ContractNumber}" IsReadOnly="True" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock Text="تاريخ العقد *" Style="{StaticResource FormFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding ContractDate}" Style="{StaticResource MaterialDesignFilledDatePicker}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock Text="نوع العملية *" Style="{StaticResource FormFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ContractTypes}"
                                          SelectedValue="{Binding ContractType}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilledComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="نوع العقار *" Style="{StaticResource FormFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PropertyTypes}"
                                          SelectedValue="{Binding PropertyType}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilledComboBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>

                <!-- Property -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="HomeMapMarker" Width="22" Height="22" Foreground="#E65100" VerticalAlignment="Center"/>
                            <TextBlock Text="بيانات العقار" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="3" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="الموقع / الحي" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding PropertyLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock Text="العنوان" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding PropertyAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="المساحة (م²)" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding PropertyAreaSqm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel>
                            <TextBlock Text="وصف العقار" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding PropertyDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- Seller -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="AccountArrowUp" Width="22" Height="22" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock Text="الطرف الأول (البائع)" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="اسم البائع *" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding SellerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="رقم الهاتف" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding SellerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="العنوان" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding SellerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="رقم الهوية" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding SellerIdNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel MaxWidth="360" HorizontalAlignment="Right">
                            <TextBlock Text="تاريخ الهوية" Style="{StaticResource FormFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding SellerIdDate}" Style="{StaticResource MaterialDesignFilledDatePicker}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- Buyer -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="AccountArrowDown" Width="22" Height="22" Foreground="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock Text="الطرف الثاني (المشتري)" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="اسم المشتري *" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding BuyerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="رقم الهاتف" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding BuyerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="العنوان" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding BuyerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="رقم الهوية" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding BuyerIdNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel MaxWidth="360" HorizontalAlignment="Right">
                            <TextBlock Text="تاريخ الهوية" Style="{StaticResource FormFieldLabel}"/>
                            <DatePicker SelectedDate="{Binding BuyerIdDate}" Style="{StaticResource MaterialDesignFilledDatePicker}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>

                <!-- Finance -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="CashMultiple" Width="22" Height="22" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock Text="البيانات المالية" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="4" Margin="0,0,0,4">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="السعر الكلي *" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding TotalPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock Text="عربون / دفعة أولى" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding DownPayment, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,12">
                                <TextBlock Text="المبلغ المدفوع" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="المبلغ المتبقي" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding RemainingAmount}" IsReadOnly="True" Style="{StaticResource FilledTextBox}" Background="#F5F5F5"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="المبلغ كتابةً" Style="{StaticResource FormFieldLabel}"/>
                            <TextBox Text="{Binding TotalPriceInWords}" IsReadOnly="True"
                                     Style="{StaticResource FilledTextBox}" Background="#F5F5F5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="طريقة الدفع *" Style="{StaticResource FormFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PaymentModes}"
                                          SelectedValue="{Binding PaymentMode}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilledComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="طرف المدين" Style="{StaticResource FormFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding DebtorParties}"
                                          SelectedValue="{Binding DebtorParty}"
                                          SelectedValuePath="Value"
                                          DisplayMemberPath="Label"
                                          IsEnabled="{Binding IsCredit}"
                                          Style="{StaticResource FilledComboBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="تاريخ الاستحقاق" Style="{StaticResource FormFieldLabel}"/>
                                <DatePicker SelectedDate="{Binding DueDate}"
                                            IsEnabled="{Binding IsCredit}"
                                            Style="{StaticResource MaterialDesignFilledDatePicker}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>

                <!-- Clauses -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="FormatListNumbered" Width="22" Height="22" Foreground="#6A1B9A" VerticalAlignment="Center"/>
                            <TextBlock Text="بنود العقد" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Clauses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                            <TextBlock Text="نص البند" Style="{StaticResource FormFieldLabel}"/>
                                            <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FilledTextBox}"
                                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>

                <!-- Witnesses & notes -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="24" Margin="0,0,0,8" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <md:PackIcon Kind="Pen" Width="22" Height="22" Foreground="#455A64" VerticalAlignment="Center"/>
                            <TextBlock Text="الشهود والملاحظات" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="اسم الشاهد الأول" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding WitnessOneName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="4,0,4,0">
                                <TextBlock Text="اسم الشاهد الثاني" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding WitnessTwoName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Text="ملاحظات" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky action bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                Padding="24,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ العقد" Command="{Binding SaveCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        md:ButtonAssist.CornerRadius="8" Padding="28,10" Margin="0,0,10,0"
                        IsEnabled="{Binding CanSave}"/>
                <Button Content="حفظ وطباعة" Command="{Binding SaveAndPrintCommand}"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8" Padding="24,10" Margin="0,0,10,0"
                        IsEnabled="{Binding CanSave}"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}"
                        Style="{StaticResource FlatButton}"
                        md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
