<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="عقود العقارات" FontSize="24" FontWeight="Bold"
                   Foreground="#1565C0" Margin="0,0,0,16"/>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="عدد العقود" TextValue="{Binding StatCountText}"
                                        Icon="FileDocumentMultiple" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="إجمالي القيمة" TextValue="{Binding StatTotalText}"
                                        Icon="Cash" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="المحصّل" TextValue="{Binding StatReceivedText}"
                                        Icon="CashCheck" IconBackground="#E0F2F1" IconForeground="#00695C" ValueForeground="#00695C"/>
            <controls:AnimatedStatCard Title="المتبقي" TextValue="{Binding StatRemainingText}"
                                        Icon="CashClock" IconBackground="#FFF3E0" IconForeground="#E65100" ValueForeground="#E65100"/>
            <controls:AnimatedStatCard Title="غير مسددة" TextValue="{Binding StatUnpaidText}"
                                        Icon="AlertCircleOutline" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource FilterBar}" Margin="0,0,0,16">
            <WrapPanel>
                <Button Content="عقد جديد" Command="{Binding OpenNewContractCommand}" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanAdd}" Margin="0,0,8,8"/>
                <Button Content="تحديث" Command="{Binding LoadContractsCommand}" Style="{StaticResource FlatButton}" Margin="0,0,8,8"/>
                <TextBox Width="200" md:HintAssist.Hint="بحث في العقود..."
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,8,8"/>
                <DatePicker Width="140" md:HintAssist.Hint="من تاريخ" SelectedDate="{Binding DateFrom}"
                            Style="{StaticResource FilledDatePicker}" Margin="0,0,8,8"/>
                <DatePicker Width="140" md:HintAssist.Hint="إلى تاريخ" SelectedDate="{Binding DateTo}"
                            Style="{StaticResource FilledDatePicker}" Margin="0,0,8,8"/>
                <ComboBox Width="140" md:HintAssist.Hint="الحالة"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedValue="{Binding StatusFilter}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Label"
                          Style="{StaticResource FilledComboBox}" Margin="0,0,8,8"/>
                <CheckBox Content="غير مسدد فقط" IsChecked="{Binding UnpaidOnly}" VerticalAlignment="Center" Margin="0,0,12,8"/>
                <CheckBox Content="آجل فقط" IsChecked="{Binding CreditOnly}" VerticalAlignment="Center" Margin="0,0,12,8"/>
            </WrapPanel>
        </Border>

        <md:Card Grid.Row="3" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة العقود"
                                             TargetDataGrid="{Binding ElementName=ContractsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="True"/>
                <Grid Grid.Row="1">
                <DataGrid x:Name="ContractsGrid"
                          ItemsSource="{Binding Contracts}"
                          SelectedItem="{Binding SelectedContract}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractNumber"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding ContractDate, StringFormat=yyyy/MM/dd}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractDate"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding ContractType}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractType"/>
                        <DataGridTextColumn Header="العقار" Binding="{Binding PropertyType}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PropertyType"/>
                        <DataGridTextColumn Header="الموقع" Binding="{Binding PropertyLocation}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PropertyLocation"/>
                        <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SellerName"/>
                        <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BuyerName"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding TotalPrice, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalPrice"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMode}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentMode"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Status"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="220" behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="تعديل" Style="{StaticResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.EditContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="تسديد" Style="{StaticResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="طباعة" Style="{StaticResource FlatButton}" Padding="8,4" Margin="0,0,4,0"
                                                Command="{Binding DataContext.PrintContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="حذف" Style="{StaticResource FlatButton}" Padding="8,4" Foreground="#C62828"
                                                Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <ScrollViewer Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto" Padding="12">
                    <ItemsControl ItemsSource="{Binding Contracts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" Margin="8" Padding="16" Background="White"
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.12"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border DockPanel.Dock="Left" Background="#E3F2FD" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding PropertyLocation}" Foreground="#607D8B" Margin="0,0,0,4"/>
                                        <TextBlock FontSize="12" Margin="0,2,0,0">
                                            <Run Text="بائع: "/><Run Text="{Binding SellerName}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Margin="0,2,0,0">
                                            <Run Text="مشتري: "/><Run Text="{Binding BuyerName}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="#E65100" Margin="0,10,0,0">
                                            <Run Text="متبقي: "/><Run Text="{Binding RemainingAmount, StringFormat=N0}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="تعديل" Style="{StaticResource OutlinedButton}" Padding="12,6" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.EditContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="تسديد" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="طباعة" Style="{StaticResource FlatButton}" Padding="12,6"
                                                    Command="{Binding DataContext.PrintContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </Grid>
        </md:Card>

        <controls:PaginationBar Grid.Row="4" Margin="0,12,0,0"/>

        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" Grid.RowSpan="5">
            <md:DialogHost.DialogContent>
                <StackPanel Margin="24" Width="340">
                    <TextBlock Text="تأكيد الحذف الناعم" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
                    <TextBlock Text="سيتم إخفاء العقد من القوائم والتقارير دون حذفه نهائياً." TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="حذف" Command="{Binding DeleteConfirmedCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsPaymentDialogOpen}" Grid.RowSpan="5">
            <md:DialogHost.DialogContent>
                <StackPanel Margin="24" Width="380">
                    <TextBlock Text="تسجيل تسديد" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PaymentContractSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="المبلغ *" Style="{StaticResource FormFieldLabel}"/>
                    <TextBox Text="{Binding PaymentAmount}" Style="{StaticResource NumericTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="التاريخ" Style="{StaticResource FormFieldLabel}"/>
                    <DatePicker SelectedDate="{Binding PaymentDate}" Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,0,0,8"/>
                    <TextBlock Text="ملاحظات" Style="{StaticResource FormFieldLabel}"/>
                    <TextBox Text="{Binding PaymentNotes}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="حفظ" Command="{Binding SubmitPaymentCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding ClosePaymentDialogCommand}" Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
