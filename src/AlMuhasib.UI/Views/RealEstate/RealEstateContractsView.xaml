<UserControl x:Class="AlMuhasib.UI.Views.RealEstate.RealEstateContractsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}" FlowDirection="RightToLeft">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button Content="عقد جديد" Command="{Binding OpenNewContractCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
        <Button Content="تصدير Excel" Command="{Binding ExportExcelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
        <Button Content="طباعة كشف" Command="{Binding PrintTableCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
        <controls:ListViewModeToggle OnDarkBackground="False"/>
        <controls:ColumnFilterToggle Margin="8,0,0,0" IsChecked="{Binding IsColumnFilterPanelOpen}"
            ActiveFilterCount="{Binding ActiveColumnFilterCount}" ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
            TargetDataGrid="{Binding ElementName=ContractsGrid}"/>
      </StackPanel>
      <TextBlock Text="عقود العقارات" FontSize="20" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
    </DockPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBox Width="220" md:HintAssist.Hint="بحث..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,8,8"/>
      <DatePicker Width="140" md:HintAssist.Hint="من" SelectedDate="{Binding DateFrom}" Margin="0,0,8,8"/>
      <DatePicker Width="140" md:HintAssist.Hint="إلى" SelectedDate="{Binding DateTo}" Margin="0,0,8,8"/>
      <CheckBox Content="غير مسدد فقط" IsChecked="{Binding UnpaidOnly}" VerticalAlignment="Center" Margin="0,0,12,8"/>
      <CheckBox Content="آجل فقط" IsChecked="{Binding CreditOnly}" VerticalAlignment="Center" Margin="0,0,12,8"/>
    </WrapPanel>
    <DataGrid x:Name="ContractsGrid" Grid.Row="2"
              ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}"
              AutoGenerateColumns="False" IsReadOnly="True"
              Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen}"
              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="120" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractNumber"/>
        <DataGridTextColumn Header="التاريخ" Binding="{Binding ContractDate, StringFormat=yyyy/MM/dd}" Width="100" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractDate"/>
        <DataGridTextColumn Header="النوع" Binding="{Binding ContractType}" Width="70" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ContractType"/>
        <DataGridTextColumn Header="العقار" Binding="{Binding PropertyType}" Width="70" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PropertyType"/>
        <DataGridTextColumn Header="الموقع" Binding="{Binding PropertyLocation}" Width="*" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PropertyLocation"/>
        <DataGridTextColumn Header="البائع" Binding="{Binding SellerName}" Width="*" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SellerName"/>
        <DataGridTextColumn Header="المشتري" Binding="{Binding BuyerName}" Width="*" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BuyerName"/>
        <DataGridTextColumn Header="السعر" Binding="{Binding TotalPrice, StringFormat=N0}" Width="90" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalPrice"/>
        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="90" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
        <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMode}" Width="70" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentMode"/>
        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="80" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Status"/>
        <DataGridTemplateColumn Header="إجراءات" Width="220" behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <Button Content="تعديل" Command="{Binding DataContext.EditContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                <Button Content="تسديد" Command="{Binding DataContext.OpenPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                <Button Content="طباعة" Command="{Binding DataContext.PrintContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                <Button Content="حذف" Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <ScrollViewer Grid.Row="2" Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
      <ItemsControl ItemsSource="{Binding Contracts}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="280" Margin="8" Padding="12" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <TextBlock Text="{Binding ContractNumber}" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="{Binding PropertyLocation}" Foreground="#607D8B" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SellerName, StringFormat=بائع: {0}}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding BuyerName, StringFormat=مشتري: {0}}"/>
                <TextBlock Text="{Binding RemainingAmount, StringFormat=متبقي: {0:N0}}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="تعديل" Command="{Binding DataContext.EditContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                  <Button Content="طباعة" Command="{Binding DataContext.PrintContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <controls:PaginationBar Grid.Row="3" Margin="0,12,0,0"/>
    <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" Grid.RowSpan="4">
      <md:DialogHost.DialogContent>
        <StackPanel Margin="24" Width="320">
          <TextBlock Text="تأكيد الحذف الناعم" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
          <TextBlock Text="سيتم إخفاء العقد من القوائم والتقارير دون حذفه نهائياً." TextWrapping="Wrap" Margin="0,0,0,16"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="حذف" Command="{Binding DeleteConfirmedCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}"/>
          </StackPanel>
        </StackPanel>
      </md:DialogHost.DialogContent>
    </md:DialogHost>
    <md:DialogHost IsOpen="{Binding IsPaymentDialogOpen}" Grid.RowSpan="4">
      <md:DialogHost.DialogContent>
        <StackPanel Margin="24" Width="360">
          <TextBlock Text="تسجيل تسديد" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
          <TextBlock Text="{Binding PaymentContractSummary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <TextBox md:HintAssist.Hint="المبلغ" Text="{Binding PaymentAmount}" Margin="0,0,0,8"/>
          <DatePicker md:HintAssist.Hint="التاريخ" SelectedDate="{Binding PaymentDate}" Margin="0,0,0,8"/>
          <TextBox md:HintAssist.Hint="ملاحظات" Text="{Binding PaymentNotes}" Margin="0,0,0,12"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="حفظ" Command="{Binding SubmitPaymentCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
            <Button Content="إلغاء" Command="{Binding ClosePaymentDialogCommand}"/>
          </StackPanel>
        </StackPanel>
      </md:DialogHost.DialogContent>
    </md:DialogHost>
  </Grid>
</UserControl>
