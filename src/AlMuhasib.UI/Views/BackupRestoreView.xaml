<UserControl x:Class="AlMuhasib.UI.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:ux="clr-namespace:AlMuhasib.Core.Models.Ux;assembly=AlMuhasib.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BackupRestoreViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource GradientIconCircle}" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="DatabaseCog" Width="28" Height="28"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="النسخ الاحتياطي والاستعادة"
                                   FontSize="{StaticResource HugeFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryHueDarkBrush}"/>
                        <TextBlock Text="حماية بياناتك من خلال إنشاء نسخ احتياطية واستعادتها بسهولة"
                                   FontSize="{StaticResource NormalFontSize}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS -->
            <Border Grid.Row="1" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                <Border CornerRadius="12" Padding="16,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EBF4FF"/>
                            <Setter Property="BorderBrush" Value="#90CAF9"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24"
                                                 VerticalAlignment="Top" Margin="0,0,12,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="InformationOutline"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSuccess, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Kind" Value="AlertCircleOutline"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                       FontSize="13" LineHeight="20"/>
                            <ProgressBar Margin="0,8,0,0" Height="6"
                                         Value="{Binding ProgressValue}"
                                         Visibility="{Binding IsOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         materialDesign:TransitionAssist.DisableTransitions="True"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- BACKUP OPTIONS -->
            <Border Grid.Row="2" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="إنشاء نسخة احتياطية" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="اختر طريقة حفظ النسخة الاحتياطية لقاعدة البيانات"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,16"/>
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupToFolderCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#EBF4FF" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="26" Height="26"
                                                                 Foreground="#1565C0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="حفظ في مجلد" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="اختر مكان الحفظ يدوياً"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupToDefaultFolderCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#E8F5E9" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="LightningBolt" Width="26" Height="26"
                                                                 Foreground="#2E7D32"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="نسخ سريع" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="حفظ في المجلد الافتراضي"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupToOneDriveCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#E3F2FD" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CloudUpload" Width="26" Height="26"
                                                                 Foreground="#0277BD"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="رفع إلى OneDrive" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="حفظ في السحابة تلقائياً"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupAndShareCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#FFF3E0" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ShareVariant" Width="26" Height="26"
                                                                 Foreground="#E65100"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="مشاركة النسخة" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="إنشاء ومشاركة عبر أي تطبيق"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- AUTO SCHEDULE -->
            <materialDesign:Card Grid.Row="3" UniformCornerRadius="16" Padding="24" Margin="0,0,0,24"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#E8EAF6" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="24" Height="24"
                                                     Foreground="#3949AB"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="النسخ التلقائي والجدولة"
                                       FontSize="{StaticResource LargeFontSize}" FontWeight="DemiBold"
                                       Foreground="{StaticResource PrimaryHueDarkBrush}"/>
                            <TextBlock Text="جدولة نسخ احتياطي دوري مع الاحتفاظ بعدد محدد من النسخ"
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <CheckBox Content="تفعيل النسخ الاحتياطي التلقائي"
                              IsChecked="{Binding AutoBackupEnabled}" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="التكرار:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding BackupSchedule}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="يومي" Tag="{x:Static ux:BackupSchedule.Daily}"/>
                            <ComboBoxItem Content="أسبوعي" Tag="{x:Static ux:BackupSchedule.Weekly}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="الاحتفاظ:" VerticalAlignment="Center" Margin="24,0,12,0"/>
                        <TextBox Grid.Column="3" Text="{Binding RetainCount, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="عدد"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BackupFolder, Mode=OneWay}"
                                 Style="{StaticResource OutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="مجلد النسخ الاحتياطي الافتراضي"
                                 materialDesign:HintAssist.IsFloating="True"
                                 IsReadOnly="True" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Command="{Binding BrowseBackupFolderCommand}"
                                Style="{StaticResource OutlinedButton}" Height="48">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="استعراض"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button Command="{Binding SaveScheduleSettingsCommand}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Padding="24,0" Height="42">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="حفظ الإعدادات"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </materialDesign:Card>

            <!-- RESTORE -->
            <Border Grid.Row="4">
                <materialDesign:Card UniformCornerRadius="16" Padding="24"
                                     Background="{DynamicResource CardBrush}"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="#FFF3E0" Margin="0,0,14,0" VerticalAlignment="Top">
                                <materialDesign:PackIcon Kind="DatabaseImport" Width="24" Height="24"
                                                         Foreground="#E65100"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="استعادة قاعدة البيانات"
                                           FontSize="{StaticResource LargeFontSize}"
                                           FontWeight="DemiBold"
                                           Foreground="{StaticResource PrimaryHueDarkBrush}"/>
                                <TextBlock Text="اختر ملف النسخة الاحتياطية لاستعادة البيانات. سيتم إعادة تشغيل البرنامج بعد الاستعادة."
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Separator Background="{StaticResource SubtleBorderBrush}" Margin="0,16"/>

                        <TextBlock Text="النسخ الاحتياطية الأخيرة" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding RecentBackups}"
                                 SelectedItem="{Binding SelectedRestoreFile}"
                                 MaxHeight="140" Margin="0,0,0,16"
                                 BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" Width="18" Height="18"
                                                                 Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding SelectedRestoreFile, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource OutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="مسار ملف النسخة الاحتياطية (.bak)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     IsReadOnly="True"
                                     Margin="0,0,12,0"/>
                            <Button Grid.Column="1"
                                    Command="{Binding BrowseRestoreFileCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="48">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderSearch" Width="20" Height="20"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="استعراض" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Background="#FFF8E1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                BorderBrush="#FFE082" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AlertOutline" Width="20" Height="20"
                                                         Foreground="#F57F17" VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="#5D4037">
                                    <Run FontWeight="DemiBold">تحذير:</Run>
                                    <Run>عملية الاستعادة ستستبدل جميع البيانات الحالية. تأكد من إنشاء نسخة احتياطية قبل الاستعادة.</Run>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Button Command="{Binding RestoreDatabaseCommand}"
                                IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                HorizontalAlignment="Right"
                                Height="46"
                                Padding="28,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Background" Value="#E65100"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#BF360C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseImport" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="استعادة قاعدة البيانات" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="DemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
