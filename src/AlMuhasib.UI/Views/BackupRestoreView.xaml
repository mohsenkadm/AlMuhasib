<UserControl x:Class="AlMuhasib.UI.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             d:DataContext="{d:DesignInstance vm:BackupRestoreViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- HEADER SECTION                              -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GradientIconCircle}" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="DatabaseCog" Width="28" Height="28"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="النسخ الاحتياطي والاستعادة"
                                   FontSize="{StaticResource HugeFontSize}"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryHueDarkBrush}"/>
                        <TextBlock Text="حماية بياناتك من خلال إنشاء نسخ احتياطية واستعادتها بسهولة"
                                   FontSize="{StaticResource NormalFontSize}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- STATUS MESSAGE                              -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="0,0,0,20"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                <Border CornerRadius="12" Padding="16,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EBF4FF"/>
                            <Setter Property="BorderBrush" Value="#90CAF9"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="BorderBrush" Value="#A5D6A7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="BorderBrush" Value="#EF9A9A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" Width="24" Height="24"
                                                 VerticalAlignment="Top" Margin="0,0,12,0">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="InformationOutline"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSuccess, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Kind" Value="CheckCircleOutline"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Kind" Value="AlertCircleOutline"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                                       FontSize="13" LineHeight="20"/>
                            <!-- Progress bar during operation -->
                            <ProgressBar Margin="0,8,0,0" Height="6"
                                         Value="{Binding ProgressValue}"
                                         Visibility="{Binding IsOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         materialDesign:TransitionAssist.DisableTransitions="True"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- BACKUP SECTION                              -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="2" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="إنشاء نسخة احتياطية" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Text="اختر طريقة حفظ النسخة الاحتياطية لقاعدة البيانات"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,16"/>

                    <WrapPanel Orientation="Horizontal">
                        <!-- Save to Folder -->
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupToFolderCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#EBF4FF" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="26" Height="26"
                                                                 Foreground="#1565C0"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="حفظ في مجلد" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="اختر مكان الحفظ يدوياً"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Quick Backup (Default Folder) -->
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupToDefaultFolderCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#E8F5E9" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="LightningBolt" Width="26" Height="26"
                                                                 Foreground="#2E7D32"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="نسخ سريع" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="حفظ في المجلد الافتراضي"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Save to OneDrive -->
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupToOneDriveCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#E3F2FD" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CloudUpload" Width="26" Height="26"
                                                                 Foreground="#0277BD"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="رفع إلى OneDrive" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="حفظ في السحابة تلقائياً"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Share / Send -->
                        <Border Style="{StaticResource BackupOptionCard}" Width="260">
                            <Button Command="{Binding BackupAndShareCommand}"
                                    IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                    Cursor="Hand" Background="Transparent" BorderThickness="0"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Padding="0" Height="Auto">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="52" Height="52" CornerRadius="26"
                                            Background="#FFF3E0" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="ShareVariant" Width="26" Height="26"
                                                                 Foreground="#E65100"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="مشاركة النسخة" FontSize="15" FontWeight="DemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                    <TextBlock Text="إنشاء ومشاركة عبر أي تطبيق"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- RESTORE SECTION                             -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="3">
                <materialDesign:Card UniformCornerRadius="16" Padding="24"
                                     Background="White"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                                    Background="#FFF3E0" Margin="0,0,14,0" VerticalAlignment="Top">
                                <materialDesign:PackIcon Kind="DatabaseImport" Width="24" Height="24"
                                                         Foreground="#E65100"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="استعادة قاعدة البيانات"
                                           FontSize="{StaticResource LargeFontSize}"
                                           FontWeight="DemiBold"
                                           Foreground="{StaticResource PrimaryHueDarkBrush}"/>
                                <TextBlock Text="اختر ملف النسخة الاحتياطية لاستعادة البيانات. سيتم إعادة تشغيل البرنامج بعد الاستعادة."
                                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource SubtleBorderBrush}" Margin="0,16"/>

                        <!-- File Selection -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SelectedRestoreFile, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource OutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="مسار ملف النسخة الاحتياطية (.bak)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     IsReadOnly="True"
                                     Margin="0,0,12,0"/>

                            <Button Grid.Column="1"
                                    Command="{Binding BrowseRestoreFileCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="48">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderSearch" Width="20" Height="20"
                                                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="استعراض" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Warning -->
                        <Border Background="#FFF8E1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16"
                                BorderBrush="#FFE082" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AlertOutline" Width="20" Height="20"
                                                         Foreground="#F57F17" VerticalAlignment="Center"
                                                         Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="#5D4037">
                                    <Run FontWeight="DemiBold">تحذير:</Run>
                                    <Run>عملية الاستعادة ستستبدل جميع البيانات الحالية. تأكد من إنشاء نسخة احتياطية قبل الاستعادة.</Run>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- Restore Button -->
                        <Button Command="{Binding RestoreDatabaseCommand}"
                                IsEnabled="{Binding IsOperationInProgress, Converter={StaticResource InverseBooleanConverter}}"
                                HorizontalAlignment="Right"
                                Height="46"
                                Padding="28,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Background" Value="#E65100"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#BF360C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseImport" Width="20" Height="20"
                                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="استعادة قاعدة البيانات" VerticalAlignment="Center"
                                           FontSize="14" FontWeight="DemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
