<UserControl x:Class="AlMuhasib.UI.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:ux="clr-namespace:AlMuhasib.Core.Models.Ux;assembly=AlMuhasib.Core"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
        <Grid Margin="24" MaxWidth="720">
            <StackPanel>
                <TextBlock Text="النسخ الاحتياطي والاستعادة" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="نسخ يدوي" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BackupFolder}" materialDesign:HintAssist.Hint="مجلد الحفظ"/>
                            <Button Grid.Column="1" Content="استعراض" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Button Command="{Binding CreateBackupCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseExport"/>
                                <TextBlock Text="نسخ الآن" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="استعادة بنقرة واحدة" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <ListBox ItemsSource="{Binding RecentBackups}" SelectedItem="{Binding SelectedBackupFile}"
                                 MaxHeight="200" Margin="0,0,0,12"/>
                        <Button Command="{Binding RestoreBackupCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="#C62828" BorderBrush="#C62828">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseImport"/>
                                <TextBlock Text="استعادة المحدد" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <TextBlock Text="جدولة تلقائية" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox Content="نسخ تلقائي" IsChecked="{Binding AutoBackupEnabled}" Margin="0,4"/>
                        <ComboBox SelectedValue="{Binding BackupSchedule}" SelectedValuePath="Tag" Width="160" Margin="0,8">
                            <ComboBoxItem Content="يومي" Tag="{x:Static ux:BackupSchedule.Daily}"/>
                            <ComboBoxItem Content="أسبوعي" Tag="{x:Static ux:BackupSchedule.Weekly}"/>
                        </ComboBox>
                        <Button Command="{Binding SaveScheduleSettingsCommand}" Margin="0,12,0,0"
                                Style="{StaticResource MaterialDesignFlatButton}" Content="حفظ الجدولة"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
