<UserControl x:Class="AlMuhasib.UI.Views.WarehouseTransfersReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WarehouseTransfersReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث / تحديث" Command="{Binding LoadDataCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="طباعة" Command="{Binding PrintCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="تقرير نقل المخازن" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="عدد فواتير النقل" TextValue="{Binding TransferCount}"
                                               Icon="TruckDelivery" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                               IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي البنود" TextValue="{Binding TotalLineCount}"
                                               Icon="FormatListNumbered" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                               IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="إجمالي الكميات" TextValue="{Binding TotalQuantity}"
                                               Icon="Counter" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="مخازن مشاركة" TextValue="{Binding WarehouseCount}"
                                               Icon="Warehouse" IconBackground="{DynamicResource AccentLightBrush}"
                                               IconForeground="{DynamicResource AccentBrush}" ValueForeground="{DynamicResource AccentBrush}"/>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,0,0,4">
                    <controls:ChartCard Title="الكميات حسب التاريخ" Margin="0,0,8,0">
                        <controls:ChartCard.ChartContent>
                            <lvc:CartesianChart Series="{Binding DailySeries}" XAxes="{Binding DailyXAxes}" YAxes="{Binding DailyYAxes}" Height="260"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                    <controls:ChartCard Title="حسب مخزن المصدر" Margin="8,0,0,0">
                        <controls:ChartCard.ChartContent>
                            <lvc:PieChart Series="{Binding FromWarehouseSeries}" Height="260"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedFromWarehouseId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="من مخزن" Width="160" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedToWarehouseId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="إلى مخزن" Width="160" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="0,0,12,0"
                                 Style="{StaticResource FilledTextBox}" materialDesign:HintAssist.Hint="رقم النقل / ملاحظات"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="انقر مرتين على صف فاتورة النقل لعرض التفاصيل والبنود"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="فواتير نقل المخازن"
                                             TargetDataGrid="{Binding ElementName=WarehouseTransfersGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="WarehouseTransfersGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridReportRowBehavior.DoubleClickCommand="{Binding OpenTransferDetailFromReportRowCommand}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم النقل" Binding="{Binding TransferNumber}" Width="150"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TransferNumber"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=\{0:yyyy/MM/dd HH:mm\}}" Width="140"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                        <DataGridTextColumn Header="من مخزن" Binding="{Binding FromWarehouseName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="FromWarehouseName"/>
                        <DataGridTextColumn Header="إلى مخزن" Binding="{Binding ToWarehouseName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ToWarehouseName"/>
                        <DataGridTextColumn Header="البنود" Binding="{Binding LineCount}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="LineCount"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding TotalQuantity, StringFormat=N2}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalQuantity"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                        <DataGridTextColumn Header="بواسطة" Binding="{Binding CreatedBy}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CreatedBy"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
