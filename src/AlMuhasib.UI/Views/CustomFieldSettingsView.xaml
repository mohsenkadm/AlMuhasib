<UserControl x:Class="AlMuhasib.UI.Views.CustomFieldSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:AlMuhasib.UI.Models"
             x:Name="Root"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="EntityTabButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="12" Padding="14,10" Background="#F5F7FA"
                                BorderBrush="#E0E6ED" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{Binding AccentLight}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Accent}"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldRowCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EEF4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <md:DialogHost IsOpen="{Binding IsChoicesDialogOpen}" CloseOnClickAway="False" DialogTheme="Inherit">
        <md:DialogHost.DialogContent>
            <Border MinWidth="420" MaxWidth="520" MaxHeight="560" Background="White" CornerRadius="18" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="خيارات الحقل" FontSize="18" FontWeight="Bold" Foreground="#1A237E"/>
                        <TextBlock Text="{Binding ChoicesTargetField.Label}" FontSize="13" Foreground="#607D8B" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="280">
                        <ItemsControl ItemsSource="{Binding EditingChoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10,8" Background="#F5F7FA" CornerRadius="10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Left" Content="حذف"
                                                    Command="{Binding DataContext.RemoveChoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource OutlinedButton}" Padding="10,4"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding NewChoiceText, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="خيار جديد" Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="إضافة" Command="{Binding AddChoiceCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="16,0" Height="48"/>
                    </Grid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Content="حفظ الخيارات" Command="{Binding SaveChoicesCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelChoicesCommand}" Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </md:DialogHost.DialogContent>

        <Grid Margin="24" MaxWidth="1100">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hero -->
            <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="20" Margin="0,0,0,18" Padding="24,22" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="16"/>
                </Border.RenderTransform>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D47A1" Offset="0"/>
                        <GradientStop Color="#1565C0" Offset="0.55"/>
                        <GradientStop Color="#0288D1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.28" Color="#0D47A1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <md:PackIcon Kind="FormSelect" Width="30" Height="30" Foreground="White"/>
                            <TextBlock Text="إعدادات الحقول المخصصة" FontSize="26" FontWeight="Bold"
                                       Foreground="White" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="أضف حتى 8 حقول لكل واجهة (منتجات، عملاء، موردون، مستثمرون) — تظهر في الجداول ونماذج الإضافة والتعديل"
                                   FontSize="13" Foreground="#BBDEFB" TextWrapping="Wrap" MaxWidth="640"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="14" Padding="16,12" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedTab.EnabledCount}" FontSize="28" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="حقل مفعّل" FontSize="11" Foreground="#E3F2FD" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Entity tabs -->
            <Border x:Name="TabsBar" Grid.Row="1" Background="White" CornerRadius="16" Padding="12" Margin="0,0,0,16"
                    BorderBrush="#E8EEF4" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform Y="14"/>
                </Border.RenderTransform>
                <ItemsControl ItemsSource="{Binding EntityTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource EntityTabButton}"
                                         GroupName="CustomFieldEntityTabs"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         CommandParameter="{Binding}"
                                         Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{Binding AccentLight}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                        <md:PackIcon Kind="{Binding IconKind}" Width="18" Height="18"
                                                     Foreground="{Binding Accent}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="11" Foreground="#78909C">
                                            <Run Text="{Binding EnabledCount, Mode=OneWay}"/>
                                            <Run Text=" / 8 مفعّل"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Fields panel -->
            <Border x:Name="FieldsPanel" Grid.Row="2" Background="#F4F7FB" CornerRadius="18" Padding="16"
                    BorderBrush="#E3EAF2" BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform X="24"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0,4,12">
                        <Border DockPanel.Dock="Right" Background="{Binding SelectedTab.AccentLight}"
                                CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{Binding SelectedTab.Accent}">
                                <Run Text="واجهة"/>
                                <Run Text="{Binding SelectedTab.Title, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="الحقول الثمانية" FontSize="16" FontWeight="Bold" Foreground="#263238"/>
                            <TextBlock Text="البيان · التفعيل · المسمى الظاهر · نوع الحقل · الخيارات"
                                       FontSize="12" Foreground="#78909C" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Column headers -->
                    <Border Grid.Row="0" Margin="4,48,4,0" Padding="14,8" Background="#E8EEF4" CornerRadius="10"
                            VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="11" Foreground="#607D8B"/>
                            <TextBlock Grid.Column="1" Text="البيان" FontWeight="Bold" FontSize="11" Foreground="#607D8B"/>
                            <TextBlock Grid.Column="2" Text="الاستخدام" FontWeight="Bold" FontSize="11" Foreground="#607D8B" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="مسمى الحقل" FontWeight="Bold" FontSize="11" Foreground="#607D8B"/>
                            <TextBlock Grid.Column="4" Text="نوع الحقل" FontWeight="Bold" FontSize="11" Foreground="#607D8B"/>
                            <TextBlock Grid.Column="5" Text="الخيارات" FontWeight="Bold" FontSize="11" Foreground="#607D8B" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding SelectedTab.Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CustomFieldDefinitionItem}">
                                    <Border Style="{StaticResource FieldRowCard}">
                                        <Border.RenderTransform>
                                            <TranslateTransform Y="0"/>
                                        </Border.RenderTransform>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="#ECEFF1" CornerRadius="8"
                                                    Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Slot}" FontWeight="Bold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Foreground="#546E7A"/>
                                            </Border>

                                            <TextBox Grid.Column="1" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="البيان" Style="{StaticResource FilledTextBox}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>

                                            <ToggleButton Grid.Column="2"
                                                          IsChecked="{Binding IsEnabled}"
                                                          Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                          ToolTip="تفعيل / إلغاء"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                            <TextBox Grid.Column="3" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                     md:HintAssist.Hint="المسمى في الجداول" Style="{StaticResource FilledTextBox}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>

                                            <ComboBox Grid.Column="4"
                                                      ItemsSource="{Binding DataContext.FieldTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding FieldType}"
                                                      SelectedValuePath="Type"
                                                      DisplayMemberPath="Label"
                                                      Style="{StaticResource FilledComboBox}"
                                                      Margin="0,0,8,0" VerticalAlignment="Center"/>

                                            <Button Grid.Column="5"
                                                    Command="{Binding DataContext.OpenChoicesDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource OutlinedButton}"
                                                    Padding="10,6"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsChoiceType, Converter={StaticResource BoolVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <md:PackIcon Kind="PlaylistEdit" Width="16" Height="16" VerticalAlignment="Center"/>
                                                    <TextBlock Text="خيارات" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Save -->
            <StackPanel x:Name="SavePanel" Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0" Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="14"/>
                </StackPanel.RenderTransform>
                <Button Command="{Binding SaveCommand}" md:ButtonAssist.CornerRadius="12"
                        Padding="28,12" MinWidth="200">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SaveSuccessPulse}" Value="True">
                                    <Setter Property="Background" Value="#2E7D32"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentSave" VerticalAlignment="Center"/>
                        <TextBlock Text="حفظ الإعدادات" Margin="8,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="13"/>
            </StackPanel>
        </Grid>
    </md:DialogHost>
</UserControl>
