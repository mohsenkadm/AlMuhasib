<UserControl x:Class="AlMuhasib.UI.Views.ProductFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="حفظ المنتج" Command="{Binding SaveCommand}">
                <MenuItem.Icon><md:PackIcon Kind="ContentSave" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="إلغاء" Command="{Binding CancelCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Close" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Storyboard x:Key="SectionEnter">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,16,0,0" To="0,0,0,16" Duration="0:0:0.35">
                <ThicknessAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,24,8">
            <StackPanel x:Name="FormRoot" MaxWidth="1180">

                <!-- Header -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="14" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E3F2FD" Offset="0"/>
                                <GradientStop Color="#BBDEFB" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <md:PackIcon Kind="PackageVariantPlus" Width="28" Height="28"
                                     Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FormTitle}" FontSize="22" FontWeight="Bold" Foreground="#0D47A1"/>
                        <TextBlock Text="أدخل بيانات المنتج والأسعار والكميات والفروع في شاشة واحدة — الحقول تظهر حسب الإعدادات المفعّلة"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Basic info -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <md:PackIcon Kind="InformationOutline" Width="22" Height="22" Foreground="#1565C0" VerticalAlignment="Center"/>
                            <TextBlock Text="البيانات الأساسية" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="اسم المنتج *" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilledTextBox}" md:HintAssist.Hint="مثال: زيت محرك 5W-30"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="الصنف *" Style="{StaticResource FormFieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              SelectedItem="{Binding SelectedCategory}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource FilledComboBox}"
                                              md:HintAssist.Hint="اختر الصنف"/>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Width="42" Height="42"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding OpenQuickCategoryCommand}"
                                            ToolTip="إضافة صنف جديد"
                                            md:ButtonAssist.CornerRadius="10">
                                        <md:PackIcon Kind="Plus" Width="20" Height="20"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="الباركود" Style="{StaticResource FormFieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FilledTextBox}"/>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,0" Height="42"
                                            Style="{StaticResource OutlinedButton}"
                                            Command="{Binding GenerateBarcodeCommand}"
                                            ToolTip="توليد باركود">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Barcode" Width="18" Height="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="توليد" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="الوصف" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Pharmacy -->
                        <UniformGrid Columns="2" Visibility="{Binding ShowScientificName, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="الاسم العلمي" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding ScientificName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12" Visibility="{Binding ShowUsageInstructions, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="طريقة الاستخدام" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding UsageInstructions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Weight -->
                        <UniformGrid Columns="2" Visibility="{Binding ShowWeightSection, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="0,0,8,12">
                                <TextBlock Text="الوزن / الحجم" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,12">
                                <TextBlock Text="وحدة الوزن" Style="{StaticResource FormFieldLabel}"/>
                                <ComboBox ItemsSource="{Binding WeightUnitOptions}" SelectedItem="{Binding WeightUnit}"
                                          Style="{StaticResource FilledComboBox}"/>
                            </StackPanel>
                        </UniformGrid>

                        <!-- Discount -->
                        <StackPanel Visibility="{Binding ShowDiscountSection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                            <TextBlock Text="خصم المنتج" Style="{StaticResource FormFieldLabel}"/>
                            <UniformGrid Columns="3">
                                <ComboBox ItemsSource="{Binding DiscountTypeOptions}"
                                          SelectedItem="{Binding DiscountTypeOption}"
                                          DisplayMemberPath="Label"
                                          Style="{StaticResource FilledComboBox}" Margin="0,0,8,8"/>
                                <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource NumericTextBox}" Margin="4,0,4,8"
                                         md:HintAssist.Hint="قيمة الخصم"/>
                                <StackPanel Margin="8,0,0,8" VerticalAlignment="Center">
                                    <CheckBox Content="له تاريخ انتهاء" IsChecked="{Binding DiscountHasExpiry}"/>
                                    <DatePicker SelectedDate="{Binding DiscountExpiresAt}"
                                                Visibility="{Binding DiscountHasExpiry, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource MaterialDesignFilledDatePicker}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Car showroom -->
                        <StackPanel Visibility="{Binding ShowCarShowroomFields, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="بيانات السيارة" Style="{StaticResource FormFieldLabel}" Margin="0,4,0,6"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding VehicleType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                         md:HintAssist.Hint="نوع السيارة" Margin="0,0,6,8"/>
                                <TextBox Text="{Binding ChassisNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                         md:HintAssist.Hint="صنف السيارة" Margin="3,0,3,8"/>
                                <TextBox Text="{Binding CarModel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                         md:HintAssist.Hint="الموديل" Margin="6,0,0,8"/>
                                <TextBox Text="{Binding VehicleColor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                         md:HintAssist.Hint="اللون" Margin="0,0,6,8"/>
                                <TextBox Text="{Binding PassengerCountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"
                                         md:HintAssist.Hint="عدد الركاب" Margin="3,0,3,8"/>
                                <TextBox Text="{Binding PlateNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                                         md:HintAssist.Hint="رقم اللوحة" Margin="6,0,0,8"/>
                            </UniformGrid>
                            <ComboBox ItemsSource="{Binding PlateTypeOptions}" SelectedItem="{Binding PlateTypeOption}"
                                      DisplayMemberPath="Label" Style="{StaticResource FilledComboBox}"
                                      md:HintAssist.Hint="نوع اللوحة" MaxWidth="280" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <controls:CustomFieldsEditor Items="{Binding CustomFields}"
                                                     Visibility="{Binding HasCustomFields, Converter={StaticResource BoolToVis}}"
                                                     Margin="0,8,0,0"/>
                    </StackPanel>
                </md:Card>

                <!-- Branches -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <md:PackIcon Kind="SourceBranch" Width="22" Height="22" Foreground="#00695C" VerticalAlignment="Center"/>
                                <TextBlock Text="الفروع التي يظهر فيها المنتج" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedBranchesSummary}" FontSize="14" FontWeight="SemiBold" Foreground="#00695C" TextWrapping="Wrap"/>
                            <TextBlock Text="يظهر المنتج في النظام والفواتير فقط للفروع المختارة. الفرع الرئيسي مفعّل افتراضياً."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenBranchPickerCommand}" Height="40" Padding="16,0"
                                md:ButtonAssist.CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="CheckboxMultipleMarkedOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="اختيار الفروع" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </md:Card>

                <!-- Prices -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2"
                         Visibility="{Binding ShowPricingSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <md:PackIcon Kind="TagOutline" Width="22" Height="22" Foreground="#E65100" VerticalAlignment="Center"/>
                                <TextBlock Text="أسعار المنتج" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Left" Margin="12,0,0,0"
                                    Style="{StaticResource OutlinedButton}" Command="{Binding OpenQuickPricingTypeCommand}"
                                    Height="36" Padding="12,0" md:ButtonAssist.CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="نوع تسعير جديد" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding PriceRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PricingTypeName}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="افتراضي" FontSize="11" Foreground="#1565C0"
                                                           Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0">
                                                <TextBlock Text="بيع (د.ع)" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="6,0">
                                                <TextBlock Text="شراء (د.ع)" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Margin="6,0" Visibility="{Binding ShowUsd, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="بيع ($)" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding SalePriceUsd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Margin="6,0" Visibility="{Binding ShowUsd, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="شراء ($)" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding PurchasePriceUsd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                                            </StackPanel>
                                            <Border Grid.Column="5" Background="#E8F5E9" CornerRadius="8" Padding="8,6" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <StackPanel>
                                                    <TextBlock Text="ربح تقديري" FontSize="10" Foreground="#2E7D32"/>
                                                    <TextBlock Text="{Binding EstimatedProfitText}" FontSize="12" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>

                <!-- Stock quantities -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Warehouse" Width="22" Height="22" Foreground="#4527A0" VerticalAlignment="Center"/>
                                <TextBlock Text="كميات المخازن" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Left" Margin="12,0,0,0"
                                    Style="{StaticResource OutlinedButton}" Command="{Binding OpenQuickWarehouseCommand}"
                                    Height="36" Padding="12,0" md:ButtonAssist.CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="مخزن جديد" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding StockRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WarehouseName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding BranchName}" FontSize="11" Opacity="0.7"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0">
                                                <TextBlock Text="الكمية" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0">
                                                <TextBlock Text="الحد الأدنى" FontSize="11" Opacity="0.7"/>
                                                <TextBox Text="{Binding MinQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="لا مخازن للفروع المختارة — أضف مخزناً أو اختر فروعاً أخرى"
                                   FontSize="12" Opacity="0.65">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StockRows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </md:Card>

                <!-- Packaging -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2"
                         Visibility="{Binding ShowUnitsSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="PackageVariantClosed" Width="22" Height="22" Foreground="#AD1457" VerticalAlignment="Center"/>
                                <TextBlock Text="أنواع التعبئة" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Left" Margin="12,0,0,0"
                                    Style="{StaticResource OutlinedButton}" Command="{Binding OpenQuickPackagingCommand}"
                                    Height="36" Padding="12,0" md:ButtonAssist.CornerRadius="8">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="نوع تعبئة جديد" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding AvailablePackagingTypes}"
                                      SelectedItem="{Binding SelectedPackagingToAdd}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"
                                      md:HintAssist.Hint="نوع التعبئة"/>
                            <TextBox Grid.Column="1" Margin="8,0"
                                     Text="{Binding NewUnitFactor, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericTextBox}"
                                     md:HintAssist.Hint="كمية التعبئة"/>
                            <Button Grid.Column="2" Content="إضافة" Command="{Binding AddPendingUnitCommand}"
                                    Style="{StaticResource PrimaryButton}" Height="42" Padding="14,0" md:ButtonAssist.CornerRadius="8"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding UnitRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding UnitName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="1" Text="{Binding ConversionFactor, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBox}" Margin="8,0"/>
                                            <Button Grid.Column="2" Content="افتراضي" Margin="6,0"
                                                    Command="{Binding DataContext.SetDefaultUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource OutlinedButton}" Padding="8,2"/>
                                            <Button Grid.Column="3" Style="{StaticResource OutlinedButton}" Padding="8,2"
                                                    Command="{Binding DataContext.RemovePendingUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" ToolTip="حذف">
                                                <md:PackIcon Kind="DeleteOutline" Width="16" Height="16" Foreground="#C62828"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </md:Card>

                <!-- Clothing sizes/colors -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="22" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2"
                         Visibility="{Binding ShowSizesSection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <md:PackIcon Kind="TshirtCrew" Width="22" Height="22" Foreground="#6A1B9A" VerticalAlignment="Center"/>
                            <TextBlock Text="القياسات والألوان" Style="{StaticResource SectionSubHeader}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewSizeName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" md:HintAssist.Hint="قياس جديد"/>
                                    <Button Grid.Column="1" Content="+" Command="{Binding AddPendingSizeCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}" Width="40" Height="40"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PendingSizes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F3E5F5" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Left" Command="{Binding DataContext.RemovePendingSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource OutlinedButton}" Padding="4" Margin="0,0,8,0">
                                                        <md:PackIcon Kind="Close" Width="12" Height="12"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" Visibility="{Binding ShowColorsSection, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewColorName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" md:HintAssist.Hint="لون جديد"/>
                                    <Button Grid.Column="1" Content="+" Command="{Binding AddPendingColorCommand}" Margin="8,0,0,0"
                                            Style="{StaticResource PrimaryButton}" Width="40" Height="40"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PendingColors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E8EAF6" CornerRadius="6" Padding="8,4" Margin="0,0,0,4">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Left" Command="{Binding DataContext.RemovePendingColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource OutlinedButton}" Padding="4" Margin="0,0,8,0">
                                                        <md:PackIcon Kind="Close" Width="12" Height="12"/>
                                                    </Button>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </md:Card>

                <TextBlock Text="{Binding FormError}" Foreground="#C62828" FontWeight="SemiBold" Margin="0,0,0,8"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FormError}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel MaxWidth="1180" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                            Height="44" Padding="22,0" md:ButtonAssist.CornerRadius="12"
                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ المنتج مع كافة التفاصيل" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" Style="{StaticResource OutlinedButton}"
                            Height="44" Padding="18,0" Margin="10,0,0,0" md:ButtonAssist.CornerRadius="12"
                            Content="إلغاء"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding SelectedBranchesSummary}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" MaxWidth="360"/>
            </DockPanel>
        </Border>

        <!-- Branch picker overlay -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsBranchPickerOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000" Panel.ZIndex="20">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="16" Padding="22"
                    MaxWidth="460" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Opacity="0.28" Color="#004D40"/>
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="اختيار الفروع" FontSize="18" FontWeight="Bold" Foreground="#00695C"/>
                        <TextBlock Text="حدد الفروع التي سيظهر فيها هذا المنتج" FontSize="12.5" Opacity="0.75" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Content="تم" Command="{Binding CloseBranchPickerCommand}" Style="{StaticResource PrimaryButton}"
                                Height="40" Padding="24,0" md:ButtonAssist.CornerRadius="10"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BranchOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="10"
                                            Background="{DynamicResource BackgroundBrush}">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center"/>
                                                <Border Background="#E0F2F1" CornerRadius="6" Padding="6,2" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#00695C"/>
                                                </Border>
                                            </StackPanel>
                                        </CheckBox>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Quick category -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsQuickCategoryOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000" Panel.ZIndex="21">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20" Width="380"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة صنف جديد" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding QuickCategoryName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                             md:HintAssist.Hint="اسم الصنف"/>
                    <TextBlock Text="{Binding QuickCategoryError}" Foreground="#C62828" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickCategoryCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickCategoryCommand}" Style="{StaticResource OutlinedButton}" Margin="8,0,0,0" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quick pricing type -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsQuickPricingTypeOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000" Panel.ZIndex="21">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20" Width="380"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة نوع تسعير" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding QuickPricingTypeName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                             md:HintAssist.Hint="اسم نوع التسعير"/>
                    <TextBlock Text="{Binding QuickPricingTypeError}" Foreground="#C62828" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickPricingTypeCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickPricingTypeCommand}" Style="{StaticResource OutlinedButton}" Margin="8,0,0,0" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quick warehouse -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsQuickWarehouseOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000" Panel.ZIndex="21">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20" Width="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة مخزن جديد" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding QuickWarehouseName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                             md:HintAssist.Hint="اسم المخزن" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding QuickWarehouseLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                             md:HintAssist.Hint="الموقع (اختياري)" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding QuickWarehouseBranch}"
                              DisplayMemberPath="DisplayName" Style="{StaticResource FilledComboBox}"
                              md:HintAssist.Hint="الفرع"/>
                    <TextBlock Text="{Binding QuickWarehouseError}" Foreground="#C62828" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickWarehouseCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickWarehouseCommand}" Style="{StaticResource OutlinedButton}" Margin="8,0,0,0" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Quick packaging -->
        <Grid Grid.RowSpan="2" Visibility="{Binding IsQuickPackagingOpen, Converter={StaticResource BoolToVis}}"
              Background="#99000000" Panel.ZIndex="21">
            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20" Width="400"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="إضافة نوع تعبئة" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Text="{Binding QuickPackagingName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}"
                             md:HintAssist.Hint="اسم التعبئة" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding QuickPackagingFactor, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBox}"
                             md:HintAssist.Hint="كمية التعبئة"/>
                    <TextBlock Text="{Binding QuickPackagingError}" Foreground="#C62828" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickPackagingCommand}" Style="{StaticResource PrimaryButton}" Padding="18,8"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickPackagingCommand}" Style="{StaticResource OutlinedButton}" Margin="8,0,0,0" Padding="18,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
