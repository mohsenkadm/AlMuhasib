<UserControl x:Class="AlMuhasib.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN CONTENT                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Filter Bar -->
                <RowDefinition Height="*" />      <!-- DataGrid -->
                <RowDefinition Height="Auto" />  <!-- Pagination -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 0: FILTER BAR                              -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />      <!-- Search -->
                        <ColumnDefinition Width="Auto" />   <!-- Category -->
                        <ColumnDefinition Width="Auto" />   <!-- Separator -->
                        <ColumnDefinition Width="Auto" />   <!-- Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             materialDesign:HintAssist.Hint="ابحث عن المنتج أو الباركود..."
                             Margin="0,0,12,0"
                             MaxWidth="400"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" />

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="التصنيف"
                              materialDesign:HintAssist.IsFloating="True"
                              materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                              MinWidth="160"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              IsEditable="False"
                              Style="{StaticResource FilledComboBox}" />

                    <Separator Grid.Column="2"
                               Width="1"
                               Margin="8,4"
                               Background="#E0E0E0" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Add -->
                        <Button Command="{Binding OpenAddDialogCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                Padding="16,0"
                                Margin="4,0"
                                ToolTip="إضافة منتج"
                                Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Export -->
                        <Button Command="{Binding ExportToExcelCommand}"
                                Style="{StaticResource SuccessButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="تصدير إلى Excel"
                                Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="تصدير" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Print -->
                        <Button Command="{Binding PrintCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="طباعة"
                                Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="طباعة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Refresh -->
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButton}"
                                Width="36" Height="36"
                                Margin="4,0"
                                ToolTip="تحديث">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 1: DATA GRID                               -->
            <!-- ═══════════════════════════════════════════ -->
            <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1"
                                 UniformCornerRadius="12"
                                 Padding="0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <DataGrid ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          RowHeight="44">

                    <DataGrid.Columns>
                        <!-- # Row Number -->
                        <DataGridTemplateColumn Header="#" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" 
                                               HorizontalAlignment="Center"
                                               Foreground="#9E9E9E" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name -->
                        <DataGridTextColumn Header="اسم المنتج"
                                            Binding="{Binding Name}"
                                            Width="2*"
                                            FontWeight="Medium" />

                        <!-- Category -->
                        <DataGridTextColumn Header="التصنيف"
                                            Binding="{Binding Category.Name}"
                                            Width="*" />

                        <!-- Barcode -->
                        <DataGridTextColumn Header="الباركود"
                                            Binding="{Binding Barcode}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="#616161" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Description -->
                        <DataGridTextColumn Header="الوصف"
                                            Binding="{Binding Description}"
                                            Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="Foreground" Value="#757575" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="180" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource TableEditButton}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="تعديل" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource TableDeleteButton}" IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="حذف" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <!-- Empty state -->
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
            </materialDesign:Card>

            <!-- Empty State Overlay -->
            <materialDesign:Card Grid.Row="1"
                                 UniformCornerRadius="12"
                                 Padding="40"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource ElevatedCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariantClosed"
                                             Width="64" Height="64"
                                             HorizontalAlignment="Center"
                                             Foreground="#BDBDBD" />
                    <TextBlock Text="لا توجد منتجات"
                               FontSize="16"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="لم يُضاف أي منتج بعد أو نتائج البحث فارغة"
                               FontSize="12"
                               Foreground="#BDBDBD"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 2: PAGINATION                              -->
            <!-- ═══════════════════════════════════════════ -->
            <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="2"
                                 UniformCornerRadius="12"
                                 Padding="12,8"
                                 Margin="0,16,0,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />  <!-- Info -->
                        <ColumnDefinition Width="*" />     <!-- Spacer -->
                        <ColumnDefinition Width="Auto" />  <!-- Nav buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Result info -->
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#757575">
                        <Run Text="إجمالي النتائج:" />
                        <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#424242" />
                    </TextBlock>

                    <!-- Pagination Nav -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button Command="{Binding FirstPageCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="الصفحة الأولى"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="PageFirst" Width="18" Height="18" />
                        </Button>

                        <Button Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="السابقة"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" />
                        </Button>

                        <Border Padding="12,0"
                                VerticalAlignment="Center">
                            <TextBlock FontSize="12" Foreground="#424242">
                                <Run Text="صفحة" />
                                <Run Text="{Binding CurrentPage, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="من" />
                                <Run Text="{Binding TotalPages, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </Border>

                        <Button Command="{Binding NextPageCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="التالية"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" />
                        </Button>

                        <Button Command="{Binding LastPageCommand}"
                                Style="{StaticResource IconButton}"
                                ToolTip="الصفحة الأخيرة"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="PageLast" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ADD / EDIT DIALOG               -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="450"
                        MaxWidth="520"
                        Padding="24"
                        Background="White"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Title -->
                            <RowDefinition Height="Auto" /> <!-- Form -->
                            <RowDefinition Height="Auto" /> <!-- Error -->
                            <RowDefinition Height="Auto" /> <!-- Buttons -->
                        </Grid.RowDefinitions>

                        <!-- Dialog Title -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding DialogTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SidebarBackground}"
                                   Margin="0,0,0,20" />

                        <!-- Form -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">

                            <!-- Product Name -->
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم المنتج *"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,16" />

                            <!-- Category -->
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding EditCategory}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="التصنيف *"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      Margin="0,0,0,16" />

                            <!-- Barcode -->
                            <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="الباركود"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,16"
                                     FontFamily="Consolas" />

                            <!-- Description -->
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="الوصف"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding DialogError}"
                                   Foreground="#C62828"
                                   FontSize="12"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DialogError.Length, FallbackValue=0, TargetNullValue=0}" 
                                                     Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0">
                            <Button Command="{Binding SaveProductCommand}"
                                    Content="حفظ"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="24,8"
                                    Margin="0,0,8,0" />

                            <Button Command="{Binding CancelDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="24,8" />
                        </StackPanel>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- DELETE CONFIRMATION DIALOG      -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDeleteDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="380"
                        MaxWidth="420"
                        Padding="24"
                        Background="White"
                        CornerRadius="16">
                    <StackPanel>
                        <!-- Icon -->
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="48" Height="48"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#EF6C00"
                                                 Margin="0,0,0,16" />

                        <!-- Title -->
                        <TextBlock Text="تأكيد الحذف"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                        <!-- Message -->
                        <TextBlock TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Foreground="#616161"
                                   Margin="0,0,0,20">
                            <Run Text="هل أنت متأكد من حذف المنتج" />
                            <Run Text="&quot;" /><Run Text="{Binding ProductToDelete.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="&quot;" />
                            <Run Text="؟" />
                            <LineBreak />
                            <Run Text="لا يمكن التراجع عن هذا الإجراء."
                                 FontSize="12" Foreground="#9E9E9E" />
                        </TextBlock>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Command="{Binding ExecuteDeleteCommand}"
                                    Content="حذف"
                                    Style="{StaticResource DangerButton}"
                                    Padding="24,8"
                                    Margin="0,0,8,0" />

                            <Button Command="{Binding CancelDeleteCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOADING OVERLAY                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جاري التحميل..."
                           FontSize="13"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
