<UserControl x:Class="AlMuhasib.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN CONTENT                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Filter Bar -->
                <RowDefinition Height="*" />      <!-- DataGrid -->
                <RowDefinition Height="Auto" />  <!-- Pagination -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 0: FILTER BAR                              -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />      <!-- Search -->
                        <ColumnDefinition Width="Auto" />   <!-- Category -->
                        <ColumnDefinition Width="Auto" />   <!-- Separator -->
                        <ColumnDefinition Width="Auto" />   <!-- Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             materialDesign:HintAssist.Hint="ابحث عن المنتج أو الباركود..."
                             Margin="0,0,12,0"
                             MaxWidth="400"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" />

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="التصنيف"
                              materialDesign:HintAssist.IsFloating="True"
                              materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                              MinWidth="160"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              IsEditable="False"
                              Style="{StaticResource FilledComboBox}" />

                    <Separator Grid.Column="2"
                               Width="1"
                               Margin="8,4"
                               Background="#E0E0E0" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Add -->
                        <Button Command="{Binding OpenAddDialogCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                Padding="16,0"
                                Margin="4,0"
                                ToolTip="إضافة منتج"
                                Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Export -->
                        <Button Command="{Binding ExportToExcelCommand}"
                                Style="{StaticResource SuccessButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="تصدير إلى Excel"
                                Visibility="{Binding CanExport, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="تصدير" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Print -->
                        <Button Command="{Binding PrintCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="طباعة"
                                Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="طباعة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Refresh -->
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButton}"
                                Width="36" Height="36"
                                Margin="4,0"
                                ToolTip="تحديث">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                        </Button>

                        <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     TargetDataGrid="{Binding ElementName=ProductsGrid}"
                                                     Margin="4,0,0,0"
                                                     VerticalAlignment="Center"/>

                        <controls:ListViewModeToggle OnDarkBackground="False" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 1: DATA GRID                               -->
            <!-- ═══════════════════════════════════════════ -->
            <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1"
                                 UniformCornerRadius="12"
                                 Padding="8,8,8,4"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                <DataGrid x:Name="ProductsGrid"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">

                    <DataGrid.Columns>
                        <!-- # Row Number -->
                        <DataGridTemplateColumn Header="#" Width="56" IsReadOnly="True"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F4F8"
                                            CornerRadius="8"
                                            Padding="6,3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#78909C"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name -->
                        <DataGridTextColumn Header="اسم المنتج"
                                            Binding="{Binding Name}"
                                            Width="2*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#263238"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Category -->
                        <DataGridTextColumn Header="التصنيف"
                                            Binding="{Binding Category.Name}"
                                            Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Category.Name" />

                        <!-- Barcode -->
                        <DataGridTextColumn Header="الباركود"
                                            Binding="{Binding Barcode}"
                                            Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Barcode">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="#616161" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Description -->
                        <DataGridTextColumn Header="الوصف"
                                            Binding="{Binding Description}"
                                            Width="2*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="Foreground" Value="#757575" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="150" MinWidth="150" IsReadOnly="True"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenBarcodePrintDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TablePrintIconButton}"
                                                ToolTip="طباعة باركود">
                                            <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ProductCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="268" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20" Foreground="#388E3C"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name, Mode=OneWay}"
                                                       Style="{StaticResource MasterDataCardTitle}"
                                                       ToolTip="{Binding Name, Mode=OneWay}"/>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Style="{StaticResource MasterDataCardMeta}"
                                                           Text="{Binding CategoryName, Mode=OneWay, StringFormat=التصنيف: {0}}"/>
                                                <TextBlock Style="{StaticResource MasterDataCardMeta}" FontFamily="Consolas"
                                                           Text="{Binding Barcode, Mode=OneWay, TargetNullValue=—, StringFormat=الباركود: {0}}"/>
                                            </StackPanel>
                                            <ItemsControl Grid.Row="3" ItemsSource="{Binding Prices}" Margin="0,6,0,6"
                                                          Visibility="{Binding DataContext.ShowPricingOnCards, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F1F8E9" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding PricingTypeName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                                                                    <TextBlock FontSize="11" Foreground="#546E7A"
                                                                               Text="{Binding SalePriceText, Mode=OneWay, StringFormat=بيع: {0}}"/>
                                                                    <TextBlock FontSize="11" Foreground="#546E7A"
                                                                               Text="{Binding PurchasePriceText, Mode=OneWay, StringFormat=شراء: {0}}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Command="{Binding DataContext.OpenEditPriceDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource TableEditIconButton}"
                                                                        ToolTip="تعديل السعر">
                                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.OpenAddPriceDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                        Visibility="{Binding DataContext.ShowPricingOnCards, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        Content="إضافة سعر"/>
                                                <Button Command="{Binding DataContext.OpenBarcodePrintFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TablePrintIconButton}"
                                                        ToolTip="طباعة باركود"
                                                        Margin="0,0,4,0">
                                                    <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenEditProductFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableEditIconButton}">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.ConfirmDeleteFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- Empty State Overlay -->
            <materialDesign:Card Grid.Row="1"
                                 UniformCornerRadius="12"
                                 Padding="40"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource ElevatedCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariantClosed"
                                             Width="64" Height="64"
                                             HorizontalAlignment="Center"
                                             Foreground="#BDBDBD" />
                    <TextBlock Text="لا توجد منتجات"
                               FontSize="16"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="لم يُضاف أي منتج بعد أو نتائج البحث فارغة"
                               FontSize="12"
                               Foreground="#BDBDBD"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <controls:PaginationBar Grid.Row="2" Margin="0,16,0,0"/>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ADD / EDIT DIALOG               -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="450"
                        MaxWidth="560"
                        MaxHeight="680"
                        Padding="24"
                        Background="White"
                        CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Title -->
                            <RowDefinition Height="*" /> <!-- Form -->
                            <RowDefinition Height="Auto" /> <!-- Error -->
                            <RowDefinition Height="Auto" /> <!-- Buttons -->
                        </Grid.RowDefinitions>

                        <!-- Dialog Title -->
                        <TextBlock Grid.Row="0"
                                   Text="{Binding DialogTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource SidebarBackground}"
                                   Margin="0,0,0,20" />

                        <!-- Form -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                        <StackPanel>

                            <!-- Product Name -->
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم المنتج *"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,16" />

                            <!-- Category -->
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedItem="{Binding EditCategory}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="التصنيف *"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      Margin="0,0,0,16" />

                            <!-- Barcode -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="الباركود"
                                         materialDesign:HintAssist.IsFloating="True"
                                         Style="{StaticResource FilledTextBox}"
                                         FontFamily="Consolas"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="1"
                                        Command="{Binding GenerateBarcodeCommand}"
                                        Style="{StaticResource OutlinedButton}"
                                        Height="48"
                                        Padding="14,0"
                                        VerticalAlignment="Bottom"
                                        ToolTip="إنشاء باركود فريد غير مكرر"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="إنشاء" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Description -->
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="الوصف"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="80"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto" />

                            <!-- Units of measure (feature-gated) -->
                            <Border Margin="0,16,0,0" Padding="12" Background="#FFF8E1" CornerRadius="8"
                                    Visibility="{Binding ShowUnitsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="وحدات القياس" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding EditUnits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="افتراضي" Style="{StaticResource OutlinedButton}" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.SetDefaultProductUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                        <Button Content="حذف" Style="{StaticResource OutlinedButton}"
                                                                Command="{Binding DataContext.DeleteProductUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UnitName}" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" × " VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ConversionFactor, StringFormat=N2}" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" (افتراضي)" Foreground="#F9A825" FontSize="11" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewUnitName, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="اسم الوحدة" Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewUnitFactor, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="المعامل" Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddProductUnitCommand}" Padding="12,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Batches / expiry (feature-gated) -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#E8F5E9" CornerRadius="8"
                                    Visibility="{Binding ShowBatchesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="الدفعات وتواريخ الانتهاء" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="تُضاف الدفعات تلقائياً من فاتورة المشتريات عند تفعيل الميزة."
                                               FontSize="12" Foreground="#616161" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding EditBatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,3" FontSize="12">
                                                    <Run Text="{Binding BatchNumber, TargetNullValue=بدون رقم}"/>
                                                    <Run Text=" | انتهاء: "/>
                                                    <Run Text="{Binding ExpiryDate, StringFormat=yyyy/MM/dd, TargetNullValue=-}"/>
                                                    <Run Text=" | كمية: "/>
                                                    <Run Text="{Binding Quantity, StringFormat=N0}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Serials (feature-gated) -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#F3E5F5" CornerRadius="8"
                                    Visibility="{Binding ShowSerialsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="الأرقام التسلسلية" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding EditSerials}" MaxHeight="120">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12" Margin="0,0,0,2">
                                                    <Run Text="{Binding SerialNumber}" FontFamily="Consolas"/>
                                                    <Run Text="{Binding IsSold, StringFormat=' — {0}'}" Foreground="#9E9E9E"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewSerialText, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="سيريال أو عدة أرقام مفصولة بفاصلة"
                                                 Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddProductSerialsCommand}" Padding="12,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- Error Message -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding DialogError}"
                                   Foreground="#C62828"
                                   FontSize="12"
                                   Margin="0,0,0,12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DialogError.Length, FallbackValue=0, TargetNullValue=0}" 
                                                     Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0">
                            <Button Command="{Binding SaveProductCommand}"
                                    Content="حفظ"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="24,8"
                                    Margin="0,0,8,0" />

                            <Button Command="{Binding CancelDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="24,8" />
                        </StackPanel>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- DELETE CONFIRMATION DIALOG      -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDeleteDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="380"
                        MaxWidth="420"
                        Padding="24"
                        Background="White"
                        CornerRadius="16">
                    <StackPanel>
                        <!-- Icon -->
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="48" Height="48"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#EF6C00"
                                                 Margin="0,0,0,16" />

                        <!-- Title -->
                        <TextBlock Text="تأكيد الحذف"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                        <!-- Message -->
                        <TextBlock TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Foreground="#616161"
                                   Margin="0,0,0,20">
                            <Run Text="هل أنت متأكد من حذف المنتج" />
                            <Run Text="&quot;" /><Run Text="{Binding ProductToDelete.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="&quot;" />
                            <Run Text="؟" />
                            <LineBreak />
                            <Run Text="لا يمكن التراجع عن هذا الإجراء."
                                 FontSize="12" Foreground="#9E9E9E" />
                        </TextBlock>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Command="{Binding ExecuteDeleteCommand}"
                                    Content="حذف"
                                    Style="{StaticResource DangerButton}"
                                    Padding="24,8"
                                    Margin="0,0,8,0" />

                            <Button Command="{Binding CancelDeleteCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <materialDesign:DialogHost IsOpen="{Binding IsPriceEditDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="420" Padding="24" Background="White" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="تعديل سعر المنتج" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PriceEditProductName}" FontSize="14" Foreground="#546E7A" Margin="0,0,0,16"/>
                        <ComboBox materialDesign:HintAssist.Hint="نوع التسعير"
                                  ItemsSource="{Binding PricingTypes}"
                                  SelectedItem="{Binding EditPricingType}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="سعر البيع"
                                 Text="{Binding EditSalePrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="سعر الشراء"
                                 Text="{Binding EditPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding PriceEditError}" Foreground="#C62828" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حفظ" Command="{Binding SaveProductPriceCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="24,8"/>
                            <Button Content="إلغاء" Command="{Binding CancelPriceEditCommand}"
                                    Style="{StaticResource OutlinedButton}" Padding="24,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- BARCODE PRINT DIALOG                        -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsBarcodePrintDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="440" MaxWidth="520" Padding="28,24" Background="White" CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#1565C0"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3E0" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="Barcode" Width="24" Height="24"
                                                         Foreground="#EF6C00"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="طباعة ملصق الباركود" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                                <TextBlock Text="معاينة الملصق قبل الطباعة" FontSize="12" Foreground="#90A4AE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#F7FAFC" CornerRadius="14" Padding="18,16" Margin="0,0,0,16"
                                BorderBrush="#E3EAF0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding BarcodePrintProductName}" FontSize="16" FontWeight="Bold"
                                           Foreground="#263238" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <Image Source="{Binding BarcodePreviewImage}" Height="100" Stretch="Uniform"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding BarcodePrintCode}" FontFamily="Consolas" FontSize="14"
                                           Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding BarcodePrintPriceText}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding BarcodePrintCopies, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="عدد نسخ الطباعة"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding ConfirmBarcodePrintCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44" Padding="24,0" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="طباعة" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseBarcodePrintDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="44" Padding="22,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOADING OVERLAY                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جاري التحميل..."
                           FontSize="13"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
