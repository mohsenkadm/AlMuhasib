<UserControl x:Class="AlMuhasib.UI.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:ProductDiscountDisplayConverter x:Key="ProductDiscountDisplayConverter"/>
        <helpers:CustomFieldSlotConverter x:Key="CustomFieldSlotConverter"/>
    </UserControl.Resources>

    <Grid>
        <FrameworkElement x:Name="VmProxy" Visibility="Collapsed"/>
        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN CONTENT                    -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Filter Bar -->
                <RowDefinition Height="*" />      <!-- DataGrid -->
                <RowDefinition Height="Auto" />  <!-- Pagination -->
            </Grid.RowDefinitions>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 0: FILTER BAR                              -->
            <!-- ═══════════════════════════════════════════ -->
            <Border Grid.Row="0" Style="{StaticResource FilterBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />      <!-- Search -->
                        <ColumnDefinition Width="Auto" />   <!-- Category -->
                        <ColumnDefinition Width="Auto" />   <!-- Size -->
                        <ColumnDefinition Width="Auto" />   <!-- Color -->
                        <ColumnDefinition Width="Auto" />   <!-- Batches -->
                        <ColumnDefinition Width="Auto" />   <!-- Separator -->
                        <ColumnDefinition Width="Auto" />   <!-- Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBox}"
                             materialDesign:HintAssist.Hint="ابحث بالاسم أو الاسم العلمي أو الباركود..."
                             Margin="0,0,12,0"
                             MaxWidth="400"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" />

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="التصنيف"
                              materialDesign:HintAssist.IsFloating="True"
                              materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                              MinWidth="160"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              IsEditable="False"
                              Style="{StaticResource FilledComboBox}" />

                    <!-- Size filter (clothing feature) -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding SizeFilterOptions}"
                              SelectedItem="{Binding SelectedSizeFilter}"
                              materialDesign:HintAssist.Hint="القياس"
                              materialDesign:HintAssist.IsFloating="True"
                              MinWidth="120"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              IsEditable="False"
                              Style="{StaticResource FilledComboBox}"
                              Visibility="{Binding ShowSizesSection, Converter={StaticResource BoolToVis}}"/>

                    <!-- Color filter (clothing feature) -->
                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding ColorFilterOptions}"
                              SelectedItem="{Binding SelectedColorFilter}"
                              materialDesign:HintAssist.Hint="اللون"
                              materialDesign:HintAssist.IsFloating="True"
                              MinWidth="120"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              IsEditable="False"
                              Style="{StaticResource FilledComboBox}"
                              Visibility="{Binding ShowColorsSection, Converter={StaticResource BoolToVis}}"/>

                    <!-- Batches filter (expiry feature) -->
                    <CheckBox Grid.Column="4"
                              Content="لديه دفعات/صلاحية"
                              IsChecked="{Binding FilterHasBatchesOnly}"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowBatchesSection, Converter={StaticResource BoolToVis}}"/>

                    <Separator Grid.Column="5"
                               Width="1"
                               Margin="8,4"
                               Background="#E0E0E0" />

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="6"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- Add -->
                        <Button Command="{Binding OpenAddDialogCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="36"
                                Padding="16,0"
                                Margin="4,0"
                                ToolTip="إضافة منتج"
                                Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Bulk entry -->
                        <Button Command="{Binding OpenBulkEntryCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="فتح واجهة إدخال منتجات متعددة كجدول Excel"
                                Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableLarge" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="إضافة متعددة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Excel template -->
                        <Button Command="{Binding DownloadImportTemplateCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="تنزيل قالب Excel لملء بيانات المنتجات">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDownloadOutline" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="قالب Excel" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Excel import -->
                        <Button Command="{Binding ImportFromExcelCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="36"
                                Padding="12,0"
                                Margin="4,0"
                                ToolTip="استيراد منتجات من ملف Excel"
                                Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="استيراد Excel" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <!-- Refresh -->
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource IconButton}"
                                Width="36" Height="36"
                                Margin="4,0"
                                ToolTip="تحديث">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ROW 1: DATA GRID                               -->
            <!-- ═══════════════════════════════════════════ -->
            <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="1"
                                 UniformCornerRadius="12"
                                 Padding="8,8,8,4"
                                 materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة المنتجات"
                                             TargetDataGrid="{Binding ElementName=ProductsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="True"/>

                <Border Grid.Row="1" Margin="8,4,8,8" Padding="12,10" Background="#E8F5E9" CornerRadius="10"
                        Visibility="{Binding HasBulkDiscountSelection, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Percent" Width="20" Height="20" Foreground="#2E7D32" VerticalAlignment="Center"/>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13">
                                <Run Text="محدد:"/>
                                <Run Text="{Binding BulkDiscountSelectionCount, Mode=OneWay}" FontWeight="Bold"/>
                                <Run Text="منتج — خصم جماعي"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" DockPanel.Dock="Right">
                            <Button Content="إضافة / تعديل خصم" Style="{StaticResource PrimaryButton}" Height="34" Padding="12,0" Margin="0,0,6,0"
                                    Command="{Binding OpenBulkDiscountDialogCommand}"
                                    CommandParameter="{Binding ElementName=ProductsGrid}"/>
                            <Button Content="إلغاء التحديد" Style="{StaticResource OutlinedButton}" Height="34" Padding="12,0"
                                    Command="{Binding ClearBulkDiscountSelectionCommand}"
                                    CommandParameter="{Binding ElementName=ProductsGrid}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <DataGrid x:Name="ProductsGrid"
                          Grid.Row="2"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          SelectionMode="Extended"
                          SelectionChanged="ProductsGrid_OnSelectionChanged"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">

                    <DataGrid.Columns>
                        <!-- # Row Number -->
                        <DataGridTemplateColumn Header="#" Width="56" IsReadOnly="True"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F4F8"
                                            CornerRadius="8"
                                            Padding="6,3"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Id}"
                                                   HorizontalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#78909C"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name -->
                        <DataGridTextColumn Header="اسم المنتج"
                                            Binding="{Binding Name}"
                                            Width="2*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#263238"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Scientific name (pharmacy template) -->
                        <DataGridTextColumn x:Name="ColScientificName"
                                            Header="الاسم العلمي"
                                            Binding="{Binding ScientificName}"
                                            Width="*"
                                            Visibility="Collapsed"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ScientificName">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#546E7A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Usage instructions (pharmacy template) -->
                        <DataGridTextColumn x:Name="ColUsageInstructions"
                                            Header="طريقة الاستخدام"
                                            Binding="{Binding UsageInstructions}"
                                            Width="1.4*"
                                            Visibility="Collapsed"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="UsageInstructions">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#546E7A"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Category -->
                        <DataGridTextColumn Header="التصنيف"
                                            Binding="{Binding Category.Name}"
                                            Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Category.Name" />

                        <!-- Barcode -->
                        <DataGridTextColumn Header="الباركود"
                                            Binding="{Binding Barcode}"
                                            Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Barcode">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="#616161" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Description -->
                        <DataGridTextColumn Header="الوصف"
                                            Binding="{Binding Description}"
                                            Width="2*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="Foreground" Value="#757575" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Discount (feature-gated) -->
                        <DataGridTemplateColumn Header="الخصم" Width="*" IsReadOnly="True"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False"
                                                Visibility="{Binding DataContext.ShowDiscountSection, Source={x:Reference VmProxy}, Converter={StaticResource BoolToVis}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource ProductDiscountDisplayConverter}}"
                                               VerticalAlignment="Center"
                                               Foreground="#2E7D32"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Custom fields (up to 8) -->
                        <DataGridTextColumn x:Name="ColCf1" Header="حقل 1" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=1}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf2" Header="حقل 2" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=2}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf3" Header="حقل 3" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=3}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf4" Header="حقل 4" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=4}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf5" Header="حقل 5" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=5}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf6" Header="حقل 6" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=6}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf7" Header="حقل 7" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=7}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf8" Header="حقل 8" Width="110" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=8}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="الإجراءات" Width="230" MinWidth="230" IsReadOnly="True"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenProductPackagingDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                ToolTip="أنواع التعبئة"
                                                Visibility="{Binding DataContext.ShowUnitsSection, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="PackageVariant" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenProductClothingDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                ToolTip="القياسات والألوان"
                                                Visibility="{Binding DataContext.ShowSizesSection, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}">
                                            <materialDesign:PackIcon Kind="TshirtCrew" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenBarcodePrintDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TablePrintIconButton}"
                                                ToolTip="طباعة باركود">
                                            <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGrid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ProductCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MasterDataEntityCardBorder}" Width="268" Margin="0,0,10,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Width="36" Height="36" CornerRadius="10" Background="#E8F5E9" Margin="0,0,0,8">
                                                <materialDesign:PackIcon Kind="PackageVariant" Width="20" Height="20" Foreground="#388E3C"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Name, Mode=OneWay}"
                                                       Style="{StaticResource MasterDataCardTitle}"
                                                       ToolTip="{Binding Name, Mode=OneWay}"/>
                                            <StackPanel Grid.Row="2">
                                                <TextBlock Style="{StaticResource MasterDataCardMeta}"
                                                           Text="{Binding CategoryName, Mode=OneWay, StringFormat=التصنيف: {0}}"/>
                                                <TextBlock Style="{StaticResource MasterDataCardMeta}"
                                                           Text="{Binding ScientificName, Mode=OneWay, StringFormat=علمي: {0}}"
                                                           Visibility="{Binding HasScientificName, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Style="{StaticResource MasterDataCardMeta}"
                                                           Text="{Binding UsageInstructions, Mode=OneWay, StringFormat=الاستخدام: {0}}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HasUsageInstructions, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Style="{StaticResource MasterDataCardMeta}" FontFamily="Consolas"
                                                           Text="{Binding Barcode, Mode=OneWay, TargetNullValue=—, StringFormat=الباركود: {0}}"/>
                                            </StackPanel>
                                            <ItemsControl Grid.Row="3" ItemsSource="{Binding Prices}" Margin="0,6,0,6"
                                                          Visibility="{Binding DataContext.ShowPricingOnCards, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#F1F8E9" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding PricingTypeName, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                                                                    <TextBlock FontSize="11" Foreground="#546E7A"
                                                                               Text="{Binding SalePriceText, Mode=OneWay, StringFormat=بيع: {0}}"/>
                                                                    <TextBlock FontSize="11" Foreground="#546E7A"
                                                                               Text="{Binding PurchasePriceText, Mode=OneWay, StringFormat=شراء: {0}}"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1"
                                                                        Command="{Binding DataContext.OpenEditPriceDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource TableEditIconButton}"
                                                                        ToolTip="تعديل السعر">
                                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <StackPanel Grid.Row="4" Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.OpenAddPriceDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                        Visibility="{Binding DataContext.ShowPricingOnCards, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                        Content="إضافة سعر"/>
                                                <Button Command="{Binding DataContext.OpenBarcodePrintFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TablePrintIconButton}"
                                                        ToolTip="طباعة باركود"
                                                        Margin="0,0,4,0">
                                                    <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenProductPackagingDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Product}"
                                                        Style="{StaticResource TableEditIconButton}"
                                                        ToolTip="أنواع التعبئة"
                                                        Margin="0,0,4,0"
                                                        Visibility="{Binding DataContext.ShowUnitsSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                    <materialDesign:PackIcon Kind="PackageVariant" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenProductClothingDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Product}"
                                                        Style="{StaticResource TableEditIconButton}"
                                                        ToolTip="القياسات والألوان"
                                                        Margin="0,0,4,0"
                                                        Visibility="{Binding DataContext.ShowSizesSection, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                                    <materialDesign:PackIcon Kind="TshirtCrew" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenEditProductFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableEditIconButton}">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.ConfirmDeleteFromCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- Empty State Overlay -->
            <materialDesign:Card Grid.Row="1"
                                 UniformCornerRadius="12"
                                 Padding="40"
                                 materialDesign:ElevationAssist.Elevation="Dp1"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch">
                <materialDesign:Card.Style>
                    <Style TargetType="materialDesign:Card" BasedOn="{StaticResource ElevatedCard}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </materialDesign:Card.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="PackageVariantClosed"
                                             Width="64" Height="64"
                                             HorizontalAlignment="Center"
                                             Foreground="#BDBDBD" />
                    <TextBlock Text="لا توجد منتجات"
                               FontSize="16"
                               Foreground="#9E9E9E"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="لم يُضاف أي منتج بعد أو نتائج البحث فارغة"
                               FontSize="12"
                               Foreground="#BDBDBD"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </materialDesign:Card>

            <controls:PaginationBar Grid.Row="2" Margin="0,16,0,0"/>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ADD / EDIT DIALOG               -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#99000000">
            <materialDesign:DialogHost.DialogContent>
                <Border x:Name="ProductDialogRoot"
                        MinWidth="520"
                        MaxWidth="680"
                        MaxHeight="760"
                        Background="Transparent"
                        Loaded="ProductDialogRoot_OnLoaded">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.35" Color="#0D47A1"/>
                    </Border.Effect>
                    <Border CornerRadius="20" Background="White" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Gradient header -->
                        <Border Grid.Row="0" Padding="22,18" CornerRadius="20,20,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1B5E20" Offset="0"/>
                                    <GradientStop Color="#2E7D32" Offset="0.55"/>
                                    <GradientStop Color="#43A047" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#33FFFFFF" CornerRadius="12" Padding="10" Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PackageVariant" Width="26" Height="26" Foreground="White"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="أدخل بيانات المنتج والحقول الإضافية إن وُجدت"
                                               FontSize="12" Foreground="#C8E6C9" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Form -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,8">
                        <StackPanel>

                            <!-- Product Name -->
                            <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم المنتج *"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,14" />

                            <!-- Scientific name (pharmacy template) -->
                            <TextBox Text="{Binding EditScientificName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="الاسم العلمي"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     Margin="0,0,0,14"
                                     Visibility="{Binding ShowScientificName, Converter={StaticResource BoolToVis}}" />

                            <!-- Usage instructions -->
                            <TextBox Text="{Binding EditUsageInstructions, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="طريقة استخدام الدواء"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MinHeight="110"
                                     MaxHeight="200"
                                     Margin="0,0,0,14"
                                     Visibility="{Binding ShowUsageInstructions, Converter={StaticResource BoolToVis}}" />

                            <!-- Category + Barcode -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding EditCategory}"
                                          DisplayMemberPath="Name"
                                          materialDesign:HintAssist.Hint="التصنيف *"
                                          materialDesign:HintAssist.IsFloating="True"
                                          materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                          Style="{StaticResource FilledComboBox}"/>
                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="الباركود"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource FilledTextBox}"
                                             FontFamily="Consolas"
                                             Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding GenerateBarcodeCommand}"
                                            Style="{StaticResource OutlinedButton}"
                                            Height="48"
                                            Padding="12,0"
                                            VerticalAlignment="Bottom"
                                            ToolTip="إنشاء باركود فريد غير مكرر"
                                            materialDesign:ButtonAssist.CornerRadius="10">
                                        <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18"/>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Description -->
                            <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="الوصف"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8" />

                            <controls:CustomFieldsEditor Items="{Binding EditCustomFields}"
                                                         Margin="0,8,0,8"
                                                         Visibility="{Binding HasCustomFields, Converter={StaticResource BoolToVis}}"/>

                            <!-- Product weight (feature-gated: MenuWeight) -->
                            <Border Margin="0,8,0,0" Padding="12" Background="#E0F7FA" CornerRadius="12"
                                    Visibility="{Binding ShowWeightSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="وزن المادة" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="وزن/حجم الوحدة الأساسية للمنتج. يُستخدم لحساب وزن فاتورة البيع تلقائياً."
                                               FontSize="12" Foreground="#006064" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditWeight, UpdateSourceTrigger=PropertyChanged, StringFormat=N4}"
                                                 materialDesign:HintAssist.Hint="الوزن *"
                                                 materialDesign:HintAssist.IsFloating="True"
                                                 Style="{StaticResource FilledTextBox}"
                                                 Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding WeightUnitOptions}"
                                                  SelectedItem="{Binding EditWeightUnit}"
                                                  IsEditable="True"
                                                  materialDesign:HintAssist.Hint="الوحدة"
                                                  materialDesign:HintAssist.IsFloating="True"
                                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                                  Style="{StaticResource FilledComboBox}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Product discount (feature-gated: ProductDiscountEnabled) -->
                            <Border Margin="0,16,0,0" Padding="12" Background="#E8F5E9" CornerRadius="8"
                                    Visibility="{Binding ShowDiscountSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="خصم المنتج" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="اختياري: نسبة أو قيمة ثابتة لكل وحدة. يُطبَّق تلقائياً في فواتير البيع والأقساط ونقطة البيع ما دام غير منتهٍ."
                                               FontSize="12" Foreground="#1B5E20" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ComboBox ItemsSource="{Binding ProductDiscountTypeOptions}"
                                              SelectedItem="{Binding EditDiscountTypeOption}"
                                              DisplayMemberPath="Label"
                                              materialDesign:HintAssist.Hint="نوع الخصم"
                                              materialDesign:HintAssist.IsFloating="True"
                                              Style="{StaticResource FilledComboBox}"
                                              Margin="0,0,0,8"/>
                                    <TextBox Text="{Binding EditDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="قيمة الخصم"
                                             materialDesign:HintAssist.IsFloating="True"
                                             Style="{StaticResource FilledTextBox}"
                                             Margin="0,0,0,8"/>
                                    <CheckBox Content="تحديد تاريخ انتهاء للخصم"
                                              IsChecked="{Binding EditDiscountHasExpiry}"
                                              Margin="0,0,0,8"/>
                                    <DatePicker SelectedDate="{Binding EditDiscountExpiresAt}"
                                                IsEnabled="{Binding EditDiscountHasExpiry}"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"/>
                                </StackPanel>
                            </Border>

                            <!-- Clothing sizes (feature-gated: TemplateClothing) -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#FCE4EC" CornerRadius="8"
                                    Visibility="{Binding ShowSizesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="القياسات" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="أضف قياسات المنتج (مثل S / M / L / XL). عند البيع أو الشراء سيُطلب اختيار القياس والكمية، ويُتتبع المخزون لكل قياس."
                                               FontSize="12" Foreground="#6A1B4D" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding EditSizes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button Content="حذف" Style="{StaticResource OutlinedButton}" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.DeleteProductSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,2"/>
                                                    <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewSizeName, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="اسم القياس (مثال: XL)"
                                                 Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddProductSizeCommand}" Padding="12,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Clothing colors (feature-gated: TemplateClothing) -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#E3F2FD" CornerRadius="8"
                                    Visibility="{Binding ShowColorsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="الألوان" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="أضف ألوان المنتج. في الفاتورة يُختار اللون من قائمة بدل كتابته يدوياً."
                                               FontSize="12" Foreground="#1565C0" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding EditColors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button Content="حذف" Style="{StaticResource OutlinedButton}" DockPanel.Dock="Right"
                                                            Command="{Binding DataContext.DeleteProductColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Padding="8,2"/>
                                                    <TextBlock Text="{Binding ColorName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewColorName, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="اسم اللون (مثال: أسود)"
                                                 Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddProductColorCommand}" Padding="12,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Packaging types (feature-gated) -->
                            <Border Margin="0,16,0,0" Padding="12" Background="#FFF8E1" CornerRadius="8"
                                    Visibility="{Binding ShowUnitsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="أنواع التعبئة" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="كمية التعبئة = عدد الوحدات الأساسية داخل النوع (مثال: كارتون = 12 قطعة)"
                                               FontSize="11" Foreground="#795548" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding EditUnits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,4">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="افتراضي" Style="{StaticResource OutlinedButton}" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.SetDefaultProductUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                        <Button Content="حذف" Style="{StaticResource OutlinedButton}"
                                                                Command="{Binding DataContext.DeleteProductUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UnitName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" = " VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ConversionFactor, StringFormat=N2}" VerticalAlignment="Center"/>
                                                        <TextBlock Text=" وحدة أساسية" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                        <TextBlock Text=" (افتراضي)" Foreground="#F9A825" FontSize="11" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding AvailablePackagingTypes}"
                                                  SelectedItem="{Binding SelectedPackagingTypeToAdd}"
                                                  DisplayMemberPath="Name"
                                                  materialDesign:HintAssist.Hint="نوع التعبئة"
                                                  Style="{StaticResource FilledComboBox}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding NewUnitFactor, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="كمية التعبئة" Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddProductUnitCommand}" Padding="12,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Batches / expiry (feature-gated) -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#E8F5E9" CornerRadius="8"
                                    Visibility="{Binding ShowBatchesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="الدفعات وتواريخ الانتهاء" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <TextBlock Text="تُضاف الدفعات تلقائياً من فاتورة المشتريات عند تفعيل الميزة."
                                               FontSize="12" Foreground="#616161" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding EditBatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,0,0,3" FontSize="12">
                                                    <Run Text="{Binding BatchNumber, TargetNullValue=بدون رقم}"/>
                                                    <Run Text=" | انتهاء: "/>
                                                    <Run Text="{Binding ExpiryDate, StringFormat=yyyy/MM/dd, TargetNullValue=-}"/>
                                                    <Run Text=" | كمية: "/>
                                                    <Run Text="{Binding Quantity, StringFormat=N0}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Serials (feature-gated) -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#F3E5F5" CornerRadius="8"
                                    Visibility="{Binding ShowSerialsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="الأرقام التسلسلية" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding EditSerials}" MaxHeight="120">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="12" Margin="0,0,0,2">
                                                    <Run Text="{Binding SerialNumber}" FontFamily="Consolas"/>
                                                    <Run Text="{Binding IsSold, StringFormat=' — {0}'}" Foreground="#9E9E9E"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding NewSerialText, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="سيريال أو عدة أرقام مفصولة بفاصلة"
                                                 Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="1" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AddProductSerialsCommand}" Padding="12,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Minimum quantities per warehouse -->
                            <Border Margin="0,12,0,0" Padding="12" Background="#E3F2FD" CornerRadius="8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <materialDesign:PackIcon Kind="AlertDecagramOutline" Width="18" Height="18"
                                                                 Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="كميات الحد الأدنى حسب المخزن" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="#1565C0"/>
                                    </StackPanel>
                                    <TextBlock Text="حدد الحد الأدنى لكل مخزن؛ سيظهر المنتج في تقرير كميات الحد الأدنى عند تجاوز العجز."
                                               FontSize="12" Foreground="#546E7A" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{Binding EditMinQuantities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White" CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                        BorderBrush="#BBDEFB" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="130"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding WarehouseName}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock FontSize="11" Foreground="#78909C"
                                                                       Text="{Binding CurrentQuantity, StringFormat=الكمية الحالية: {0:N0}}"/>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding MinQuantity, UpdateSourceTrigger=LostFocus}"
                                                                 materialDesign:HintAssist.Hint="الحد الأدنى"
                                                                 materialDesign:HintAssist.IsFloating="True"
                                                                 Style="{StaticResource FilledTextBox}"
                                                                 VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="لا توجد مخازن معرفة بعد."
                                               FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditMinQuantities.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                        <!-- Error Message -->
                        <TextBlock Grid.Row="2"
                                   Text="{Binding DialogError}"
                                   Foreground="#C62828"
                                   FontSize="12"
                                   Margin="22,0,22,8"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogError}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DialogError.Length, FallbackValue=0, TargetNullValue=0}" 
                                                     Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="22,8,22,18">
                            <Button Command="{Binding SaveProductCommand}"
                                    Content="حفظ"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="28,10"
                                    Margin="0,0,8,0" />

                            <Button Command="{Binding CancelDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="24,10" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- DELETE CONFIRMATION DIALOG      -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsDeleteDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="380"
                        MaxWidth="420"
                        Padding="24"
                        Background="White"
                        CornerRadius="16">
                    <StackPanel>
                        <!-- Icon -->
                        <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                 Width="48" Height="48"
                                                 HorizontalAlignment="Center"
                                                 Foreground="#EF6C00"
                                                 Margin="0,0,0,16" />

                        <!-- Title -->
                        <TextBlock Text="تأكيد الحذف"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12" />

                        <!-- Message -->
                        <TextBlock TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Foreground="#616161"
                                   Margin="0,0,0,20">
                            <Run Text="هل أنت متأكد من حذف المنتج" />
                            <Run Text="&quot;" /><Run Text="{Binding ProductToDelete.Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="&quot;" />
                            <Run Text="؟" />
                            <LineBreak />
                            <Run Text="لا يمكن التراجع عن هذا الإجراء."
                                 FontSize="12" Foreground="#9E9E9E" />
                        </TextBlock>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Command="{Binding ExecuteDeleteCommand}"
                                    Content="حذف"
                                    Style="{StaticResource DangerButton}"
                                    Padding="24,8"
                                    Margin="0,0,8,0" />

                            <Button Command="{Binding CancelDeleteCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="24,8" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <materialDesign:DialogHost IsOpen="{Binding IsPriceEditDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="420" Padding="24" Background="White" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="تعديل سعر المنتج" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding PriceEditProductName}" FontSize="14" Foreground="#546E7A" Margin="0,0,0,16"/>
                        <ComboBox materialDesign:HintAssist.Hint="نوع التسعير"
                                  ItemsSource="{Binding PricingTypes}"
                                  SelectedItem="{Binding EditPricingType}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="سعر البيع"
                                 Text="{Binding EditSalePrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="سعر الشراء"
                                 Text="{Binding EditPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding PriceEditError}" Foreground="#C62828" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حفظ" Command="{Binding SaveProductPriceCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="24,8"/>
                            <Button Content="إلغاء" Command="{Binding CancelPriceEditCommand}"
                                    Style="{StaticResource OutlinedButton}" Padding="24,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- BARCODE PRINT DIALOG                        -->
        <!-- ═══════════════════════════════════════════ -->
        <materialDesign:DialogHost IsOpen="{Binding IsBarcodePrintDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="440" MaxWidth="520" Padding="28,24" Background="White" CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.16" Color="#1565C0"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3E0" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="Barcode" Width="24" Height="24"
                                                         Foreground="#EF6C00"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="طباعة ملصق الباركود" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                                <TextBlock Text="معاينة الملصق قبل الطباعة" FontSize="12" Foreground="#90A4AE" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#F7FAFC" CornerRadius="14" Padding="18,16" Margin="0,0,0,16"
                                BorderBrush="#E3EAF0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding BarcodePrintProductName}" FontSize="16" FontWeight="Bold"
                                           Foreground="#263238" TextWrapping="Wrap" HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <Image Source="{Binding BarcodePreviewImage}" Height="100" Stretch="Uniform"
                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding BarcodePrintCode}" FontFamily="Consolas" FontSize="14"
                                           Foreground="#546E7A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding BarcodePrintPriceText}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding BarcodePrintCopies, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="عدد نسخ الطباعة"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,0,18"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding ConfirmBarcodePrintCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44" Padding="24,0" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="طباعة" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseBarcodePrintDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="44" Padding="22,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Clothing sizes/colors dialog -->
        <materialDesign:DialogHost IsOpen="{Binding IsClothingDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000"
                                   Identifier="ProductClothingDialog">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="480" MaxWidth="580" MaxHeight="680" Padding="24"
                        Background="White" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{Binding ClothingDialogTitle}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SidebarBackground}"/>
                            <TextBlock Text="أضف قياسات وألوان هذا المنتج. في الفواتير يُختاران من قوائم."
                                       FontSize="12" Foreground="#6A1B4D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <StackPanel>
                                <Border Padding="12" Background="#FCE4EC" CornerRadius="8" Margin="0,0,0,12"
                                        Visibility="{Binding ShowSizesSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="القياسات" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding EditSizes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <Button Content="حذف" Style="{StaticResource OutlinedButton}" DockPanel.Dock="Right"
                                                                Command="{Binding DataContext.DeleteProductSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding NewSizeName, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="اسم القياس"
                                                     Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding AddProductSizeCommand}" Padding="12,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Padding="12" Background="#E3F2FD" CornerRadius="8"
                                        Visibility="{Binding ShowColorsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="الألوان" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding EditColors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,4">
                                                        <Button Content="حذف" Style="{StaticResource OutlinedButton}" DockPanel.Dock="Right"
                                                                Command="{Binding DataContext.DeleteProductColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                        <TextBlock Text="{Binding ColorName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding NewColorName, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="اسم اللون"
                                                     Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="1" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding AddProductColorCommand}" Padding="12,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="إغلاق" Command="{Binding CloseClothingDialogCommand}"
                                Style="{StaticResource OutlinedButton}" HorizontalAlignment="Left"
                                Height="40" Padding="22,0" materialDesign:ButtonAssist.CornerRadius="10"/>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Packaging types dialog -->
        <materialDesign:DialogHost IsOpen="{Binding IsPackagingDialogOpen}"
                                   CloseOnClickAway="False"
                                   DialogTheme="Inherit"
                                   OverlayBackground="#80000000"
                                   Identifier="ProductPackagingDialog">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="480" MaxWidth="560" MaxHeight="620" Padding="24"
                        Background="White" CornerRadius="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="{Binding PackagingDialogTitle}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource SidebarBackground}"/>
                            <TextBlock Text="كمية التعبئة = عدد الوحدات الأساسية داخل النوع المختار"
                                       FontSize="12" Foreground="#795548" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding EditUnits}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF8E1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                        <Button Content="افتراضي" Style="{StaticResource OutlinedButton}" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.SetDefaultProductUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                        <Button Content="حذف" Style="{StaticResource OutlinedButton}"
                                                                Command="{Binding DataContext.DeleteProductUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Padding="8,2"/>
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold">
                                                            <Run Text="{Binding UnitName}"/>
                                                            <Run Text=" = "/>
                                                            <Run Text="{Binding ConversionFactor, StringFormat=N2}"/>
                                                            <Run Text=" وحدة أساسية"/>
                                                        </TextBlock>
                                                        <TextBlock Text="افتراضي" Foreground="#F9A825" FontSize="11"
                                                                   Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailablePackagingTypes}"
                                              SelectedItem="{Binding SelectedPackagingTypeToAdd}"
                                              DisplayMemberPath="Name"
                                              materialDesign:HintAssist.Hint="نوع التعبئة"
                                              Style="{StaticResource FilledComboBox}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewUnitFactor, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="كمية التعبئة"
                                             Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="إضافة" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding AddProductUnitCommand}" Padding="14,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Content="إغلاق" Command="{Binding ClosePackagingDialogCommand}"
                                Style="{StaticResource OutlinedButton}" HorizontalAlignment="Left"
                                Height="40" Padding="22,0" materialDesign:ButtonAssist.CornerRadius="10"/>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOADING OVERLAY                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جاري التحميل..."
                           FontSize="13"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
