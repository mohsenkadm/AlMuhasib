<UserControl x:Class="AlMuhasib.UI.Views.InvoiceModificationsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FILTER BAR -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="14" md:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
            <StackPanel>
            <Border BorderBrush="#FFCDD2" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFEBEE" CornerRadius="10" Padding="10,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ShieldSearch" Width="18" Height="18" Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="التقارير الرقابية" FontWeight="SemiBold" Foreground="#C62828" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="تعديلات الفواتير" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <WrapPanel Margin="0,12,0,0">
                <DatePicker Width="140" Margin="0,0,8,8"
                            md:HintAssist.Hint="من تاريخ التعديل"
                            Style="{StaticResource FilledDatePicker}"
                            SelectedDate="{Binding DateFrom}"/>
                <DatePicker Width="140" Margin="0,0,8,8"
                            md:HintAssist.Hint="إلى تاريخ التعديل"
                            Style="{StaticResource FilledDatePicker}"
                            SelectedDate="{Binding DateTo}"/>
                <ComboBox Width="160" Margin="0,0,8,8"
                          md:HintAssist.Hint="المعدِّل"
                          Style="{StaticResource FilledComboBox}"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          IsEditable="True"/>

                <TextBox Width="200" Margin="0,0,8,8"
                         md:HintAssist.Hint="بحث..."
                         Style="{StaticResource FilledTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8"
                        Margin="0,0,8,8" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Magnify" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="بحث"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            </StackPanel>
        </md:Card>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="0" Padding="0" md:ElevationAssist.Elevation="Dp2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <controls:ListTableHeaderBar Grid.Row="0"
                                                 Title="تعديلات الفواتير"
                                                 TargetDataGrid="{Binding ElementName=MainGrid}"
                                                 IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                 ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                 ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                 ExportCommand="{Binding ExportToExcelCommand}"
                                                 PrintCommand="{Binding PrintTableCommand}"
                                                 ShowCardToggle="False"/>
                    <DataGrid x:Name="MainGrid" Grid.Row="1"
                              ItemsSource="{Binding Rows}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              Style="{StaticResource ModernDataGrid}"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick"
                                          Command="{Binding ShowDetailsCommand}"
                                          CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="تاريخ التعديل" Width="140"
                                                Binding="{Binding Timestamp, StringFormat=yyyy/MM/dd HH:mm}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Timestamp">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="رقم الفاتورة" Width="120"
                                                Binding="{Binding EntityKey}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EntityKey">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="العنوان" Width="*"
                                                Binding="{Binding EntityTitle}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EntityTitle">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ملخص التعديل" Width="2*"
                                                Binding="{Binding ChangeSummary}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ChangeSummary">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="المعدِّل" Width="120"
                                                Binding="{Binding ModifiedBy}"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ModifiedBy">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="8,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="التفاصيل" behaviors:DataGridColumnFilterBehavior.IsFilterable="False" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="عرض التفاصيل"
                                                Width="32" Height="32">
                                            <md:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <controls:PaginationBar Grid.Row="2" ShowFirstLastButtons="True"/>
                </Grid>
            </md:Card>

            <md:Card Style="{StaticResource ElevatedCard}" Grid.Column="1" Width="380" Padding="16"
                     md:ElevationAssist.Elevation="Dp3" Margin="16,0,0,0"
                     Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="{Binding DetailsTitle}" FontSize="15" FontWeight="Bold"
                                   TextWrapping="Wrap" Margin="0,0,36,0" VerticalAlignment="Center"
                                   Foreground="#C62828"/>
                        <Button HorizontalAlignment="Left"
                                Command="{Binding CloseDetailsCommand}"
                                Style="{StaticResource IconButton}"
                                Width="30" Height="30">
                            <md:PackIcon Kind="Close" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#FFF8F8" CornerRadius="8" Padding="12" Margin="0,0,0,12"
                                    BorderBrush="#FFCDD2" BorderThickness="1">
                                <TextBlock Text="{Binding DetailsBody}" TextWrapping="Wrap" FontSize="13" LineHeight="22"/>
                            </Border>
                            <TextBlock Text="جدول الفروقات" FontWeight="Bold" Margin="0,0,0,8" Foreground="#37474F"/>
                            <DataGrid ItemsSource="{Binding SelectedDiffs}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column"
                                      Style="{StaticResource ModernDataGrid}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الحقل" Binding="{Binding Field}" Width="*"/>
                                    <DataGridTextColumn Header="قبل" Binding="{Binding OldValue}" Width="*"/>
                                    <DataGridTextColumn Header="بعد" Binding="{Binding NewValue}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </md:Card>
        </Grid>
    </Grid>
</UserControl>
