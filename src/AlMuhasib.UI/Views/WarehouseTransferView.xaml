<UserControl x:Class="AlMuhasib.UI.Views.WarehouseTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:b="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="إضافة صف" Command="{Binding AddRowCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Plus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="مسح البنود" Command="{Binding ClearLinesCommand}">
                <MenuItem.Icon><md:PackIcon Kind="DeleteSweep" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تنفيذ النقل" Command="{Binding SaveTransferCommand}">
                <MenuItem.Icon><md:PackIcon Kind="TruckDelivery" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header card -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16"
                 md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,12,0"
                            Background="{DynamicResource DashboardKpiGreenLightBrush}" DockPanel.Dock="Right">
                        <md:PackIcon Kind="TruckDelivery" Width="26" Height="26"
                                     Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="نقل بين مخازن" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="أدر البنود داخل الجدول كجدول Excel — ابحث عن المنتج وعدّل الكمية ثم نفّذ النقل"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <controls:AnimatedStatCard Title="عدد البنود" TextValue="{Binding LinesCountText}"
                                               Icon="FormatListNumbered"
                                               IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                               IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="إجمالي الكميات" TextValue="{Binding TotalQuantityText}"
                                               Icon="Counter"
                                               IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="منتجات مميزة" TextValue="{Binding DistinctProductsText}"
                                               Icon="PackageVariant"
                                               IconBackground="{DynamicResource AccentLightBrush}"
                                               IconForeground="{DynamicResource AccentBrush}"
                                               ValueForeground="{DynamicResource AccentBrush}"/>
                    <controls:AnimatedStatCard Title="حالة المسودة" TextValue="{Binding DraftStatusText}"
                                               Icon="ClipboardCheck"
                                               IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                               IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                </UniformGrid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding FromWarehouse}"
                              DisplayMemberPath="DisplayName"
                              md:HintAssist.Hint="من مخزن"
                              md:HintAssist.IsFloating="True"
                              md:ComboBoxAssist.ShowSelectedItem="True"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="14"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding ToWarehouse}"
                              DisplayMemberPath="DisplayName"
                              md:HintAssist.Hint="إلى مخزن"
                              md:HintAssist.IsFloating="True"
                              md:ComboBoxAssist.ShowSelectedItem="True"
                              Style="{StaticResource FilledComboBox}"
                              FontSize="14"/>
                    <DatePicker Grid.Column="4"
                                SelectedDate="{Binding TransferDate}"
                                md:HintAssist.Hint="التاريخ"
                                md:HintAssist.IsFloating="True"
                                Style="{StaticResource FilledDatePicker}"
                                FontSize="14"/>
                </Grid>

                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="ملاحظات النقل (اختياري)"
                         md:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}"
                         AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap"/>
            </StackPanel>
        </md:Card>

        <!-- Lines grid -->
        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="بنود النقل — ابحث عن المنتج وعدّل الكمية داخل الجدول"
                                             TargetDataGrid="{Binding ElementName=TransferLinesGrid}"
                                             ShowCardToggle="False"
                                             ShowExport="False"
                                             ShowPrint="False"
                                             ShowFilter="False">
                    <controls:ListTableHeaderBar.ExtraContent>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <md:PackIcon Kind="BarcodeScan" Width="18" Height="18"
                                         VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                            <TextBox Width="168" Height="32" Margin="0,0,10,0"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     Background="White"
                                     Foreground="#212121"
                                     CaretBrush="#212121"
                                     BorderThickness="0"
                                     Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="الباركود + Enter"
                                     md:HintAssist.Foreground="#78909C"
                                     md:TextFieldAssist.HasClearButton="True"
                                     behaviors:EnterKeyCommandBehavior.Command="{Binding ProcessBarcodeCommand}"/>
                            <Button Command="{Binding AddRowCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="White" Height="32" Padding="14,0" Margin="0,0,8,0"
                                    ToolTip="إضافة صف فارغ">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="إضافة صف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearLinesCommand}"
                                    Style="{StaticResource FlatButton}"
                                    Foreground="White" Height="32" Padding="12,0"
                                    ToolTip="مسح جميع البنود">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="DeleteSweep" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="مسح الكل" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </controls:ListTableHeaderBar.ExtraContent>
                </controls:ListTableHeaderBar>

                <DataGrid x:Name="TransferLinesGrid" Grid.Row="1"
                          ItemsSource="{Binding Lines}"
                          Style="{StaticResource InvoiceItemsDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          MinHeight="220"
                          b:InvoiceDataGridBehavior.Enable="True"
                          b:InvoiceDataGridBehavior.AddRowCommand="{Binding AddRowCommand}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowNumber}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource HintForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="اسم المنتج" Width="*" MinWidth="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource InvoiceProductCellTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="المتاح في المصدر" Width="140" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AvailableQuantityText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="#1565C0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="الكمية" Width="180" MinWidth="150"
                                                CellTemplate="{StaticResource InvoiceQuantityCellTemplate}"/>

                        <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True"
                                                CellTemplate="{StaticResource InvoiceDeleteRowCellTemplate}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="تنفيذ النقل" Command="{Binding SaveTransferCommand}"
                    Style="{StaticResource PrimaryButton}" Height="42" Padding="28,0"
                    HorizontalAlignment="Left" DockPanel.Dock="Right"/>
            <TextBlock Text="بعد التنفيذ تُحدَّث كميات المخازن فوراً ولا يمكن تعديل الفاتورة من هنا — راجع التقرير للتفاصيل"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تنفيذ النقل..." Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
