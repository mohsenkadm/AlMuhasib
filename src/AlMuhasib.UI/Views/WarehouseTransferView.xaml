<UserControl x:Class="AlMuhasib.UI.Views.WarehouseTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="إضافة بند" Command="{Binding AddLineCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Plus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="مسح البنود" Command="{Binding ClearLinesCommand}">
                <MenuItem.Icon><md:PackIcon Kind="DeleteSweep" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تنفيذ النقل" Command="{Binding SaveTransferCommand}">
                <MenuItem.Icon><md:PackIcon Kind="TruckDelivery" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Modern header card -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16"
                 md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <DockPanel Margin="0,0,0,16">
                    <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,12,0"
                            Background="{DynamicResource DashboardKpiGreenLightBrush}" DockPanel.Dock="Right">
                        <md:PackIcon Kind="TruckDelivery" Width="26" Height="26"
                                     Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="نقل بين مخازن" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="انقل كميات المنتجات بين المخازن بنفس الفرع أو فروع مختلفة — عدّل الكميات من الجدول قبل التنفيذ"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>

                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <controls:AnimatedStatCard Title="عدد البنود" TextValue="{Binding LinesCountText}"
                                               Icon="FormatListNumbered"
                                               IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                               IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="إجمالي الكميات" TextValue="{Binding TotalQuantityText}"
                                               Icon="Counter"
                                               IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="منتجات مميزة" TextValue="{Binding DistinctProductsText}"
                                               Icon="PackageVariant"
                                               IconBackground="{DynamicResource AccentLightBrush}"
                                               IconForeground="{DynamicResource AccentBrush}"
                                               ValueForeground="{DynamicResource AccentBrush}"/>
                    <controls:AnimatedStatCard Title="حالة المسودة" TextValue="{Binding DraftStatusText}"
                                               Icon="ClipboardCheck"
                                               IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                               IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                </UniformGrid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="من مخزن" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding FromWarehouse}"
                              DisplayMemberPath="DisplayName" Margin="0,0,16,0"
                              md:HintAssist.Hint="اختر المخزن المصدر"/>
                    <TextBlock Grid.Column="2" Text="إلى مخزن" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="3" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding ToWarehouse}"
                              DisplayMemberPath="DisplayName"
                              md:HintAssist.Hint="اختر المخزن الوجهة"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <md:PackIcon Grid.Column="0" Kind="BarcodeScan" Width="20" Height="20"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,8,0" md:HintAssist.Hint="الباركود + Enter"
                             behaviors:EnterKeyCommandBehavior.Command="{Binding ProcessBarcodeCommand}"/>
                    <ComboBox Grid.Column="2" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                              DisplayMemberPath="Name" Margin="0,0,8,0" md:HintAssist.Hint="المنتج"/>
                    <TextBox Grid.Column="3" Text="{Binding LineQuantity}" Margin="0,0,8,0"
                             md:HintAssist.Hint="الكمية"/>
                    <Button Grid.Column="4" Content="إضافة" Command="{Binding AddLineCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Grid.Column="5" Content="مسح الكل" Command="{Binding ClearLinesCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </Grid>

                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="ملاحظات النقل (اختياري)"
                         AcceptsReturn="True" MinHeight="44" TextWrapping="Wrap"/>
            </StackPanel>
        </md:Card>

        <md:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="0" md:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="بنود النقل — عدّل الكمية أو احذف الصف قبل التنفيذ"
                                             TargetDataGrid="{Binding ElementName=TransferLinesGrid}"
                                             ShowCardToggle="False"
                                             ShowExport="False"
                                             ShowPrint="False"
                                             ShowFilter="False"/>
                <DataGrid x:Name="TransferLinesGrid" Grid.Row="1"
                          ItemsSource="{Binding Lines}" Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="220"
                          IsReadOnly="False"
                          SelectionUnit="FullRow"
                          behaviors:DataGridCopyableCellsBehavior.IsEnabled="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="الكمية" Width="160" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                             Style="{StaticResource NumericCellTextBox}"
                                             MinWidth="100" MinHeight="34"
                                             FontSize="15"
                                             FontWeight="Bold"
                                             Padding="8,6"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Foreground="#EF6C00"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراء" Width="100" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف" Padding="10,2"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Foreground="#C62828"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="تنفيذ النقل" Command="{Binding SaveTransferCommand}"
                    Style="{StaticResource PrimaryButton}" Height="42" Padding="28,0"
                    HorizontalAlignment="Left" DockPanel.Dock="Right"/>
            <TextBlock Text="بعد التنفيذ تُحدَّث كميات المخازن فوراً ولا يمكن تعديل الفاتورة من هنا — راجع التقرير للتفاصيل"
                       VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
        </DockPanel>

        <Border Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تنفيذ النقل..." Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
