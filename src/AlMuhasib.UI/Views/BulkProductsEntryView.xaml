<UserControl x:Class="AlMuhasib.UI.Views.BulkProductsEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header / actions -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,12"
                 md:ElevationAssist.Elevation="Dp2">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                            Height="36" Padding="18,0" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ المنتجات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddEmptyRowsCommand}" Style="{StaticResource OutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="TableRowPlusAfter" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="صفوف إضافية" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ClearRowsCommand}" Style="{StaticResource OutlinedButton}"
                            Height="36" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Eraser" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="مسح" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseCommand}" Style="{StaticResource FlatButton}"
                            Height="36" Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="إغلاق" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="إضافة منتجات متعددة" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="أدخل البيانات مباشرة في الجدول كما في Excel ثم اضغط حفظ"
                               FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </md:Card>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <controls:AnimatedStatCard Margin="0,0,8,0"
                                       Title="صفوف باسم"
                                       Value="{Binding TotalRows}"
                                       Icon="FormatListNumbered"
                                       IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Margin="0,0,8,0"
                                       Title="جاهزة للحفظ"
                                       Value="{Binding ReadyRows}"
                                       Icon="CheckCircleOutline"
                                       IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Margin="0,0,8,0"
                                       Title="ناقصة"
                                       Value="{Binding IncompleteRows}"
                                       Icon="AlertCircleOutline"
                                       IconBackground="#FFF8E1" IconForeground="#F9A825" ValueForeground="#F9A825"/>
            <controls:AnimatedStatCard Title="مكررة"
                                       Value="{Binding DuplicateRows}"
                                       Icon="ContentDuplicate"
                                       IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
        </UniformGrid>

        <!-- Excel-like grid -->
        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="8"
                 md:ElevationAssist.Elevation="Dp2">
            <DataGrid x:Name="BulkGrid"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      CanUserSortColumns="False"
                      HeadersVisibility="Column"
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0"
                      FontSize="13">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160" MinWidth="120"/>
                    <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="160"/>

                    <DataGridTextColumn x:Name="ColPharmacyScientific" Header="الاسم العلمي"
                                        Binding="{Binding ScientificName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="130" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColPharmacyUsage" Header="طريقة الاستخدام"
                                        Binding="{Binding UsageInstructions, UpdateSourceTrigger=PropertyChanged}"
                                        Width="140" Visibility="Collapsed"/>

                    <DataGridTextColumn x:Name="ColWeight" Header="الوزن"
                                        Binding="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                        Width="80" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColWeightUnit" Header="وحدة الوزن"
                                        Binding="{Binding WeightUnit, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90" Visibility="Collapsed"/>

                    <DataGridTextColumn x:Name="ColDiscountType" Header="نوع الخصم"
                                        Binding="{Binding DiscountTypeText, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColDiscountValue" Header="قيمة الخصم"
                                        Binding="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                        Width="90" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColDiscountExpires" Header="انتهاء الخصم"
                                        Binding="{Binding DiscountExpiresText, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>

                    <DataGridTextColumn x:Name="ColSalePrice" Header="سعر البيع"
                                        Binding="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColPurchasePrice" Header="سعر الشراء"
                                        Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                        Width="100" Visibility="Collapsed"/>

                    <DataGridTextColumn x:Name="ColCf1" Header="حقل 1"
                                        Binding="{Binding CustomField1, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf2" Header="حقل 2"
                                        Binding="{Binding CustomField2, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf3" Header="حقل 3"
                                        Binding="{Binding CustomField3, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf4" Header="حقل 4"
                                        Binding="{Binding CustomField4, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf5" Header="حقل 5"
                                        Binding="{Binding CustomField5, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf6" Header="حقل 6"
                                        Binding="{Binding CustomField6, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf7" Header="حقل 7"
                                        Binding="{Binding CustomField7, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColCf8" Header="حقل 8"
                                        Binding="{Binding CustomField8, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110" Visibility="Collapsed"/>

                    <DataGridTextColumn Header="الحالة" Binding="{Binding RowStatus}" Width="110" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>

        <!-- Footer status -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Opacity="0.8"/>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="16,0,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
    </Grid>
</UserControl>
