<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldSaleReturnsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:GoldSaleReturnsReportViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="تقرير مرتجعات البيع" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="عدد المرتجعات" TextValue="{Binding ReturnCount}"
                                               Icon="BackupRestore" IconBackground="#FFF8E7" IconForeground="#B8860B" ValueForeground="#B8860B"/>
                    <controls:AnimatedStatCard Title="إجمالي د.ع" TextValue="{Binding TotalIqd}"
                                               Icon="Cash" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي $" TextValue="{Binding TotalUsd}"
                                               Icon="CurrencyUsd" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="الوزن المرتجع" TextValue="{Binding TotalWeight}"
                                               Icon="ScaleBalance" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                </UniformGrid>

                <controls:GoldReportFilterBar DateFrom="{Binding DateFrom}" DateTo="{Binding DateTo}"
                                              SearchCommand="{Binding LoadDataCommand}"
                                              SetDateTodayCommand="{Binding SetDateTodayCommand}"
                                              SetDateWeekCommand="{Binding SetDateWeekCommand}"
                                              SetDateMonthCommand="{Binding SetDateMonthCommand}"
                                              SetDateQuarterCommand="{Binding SetDateQuarterCommand}"
                                              ResetDateFiltersCommand="{Binding ResetDateFiltersCommand}">
                    <controls:GoldReportFilterBar.FilterContent>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" Width="140" Margin="0,0,12,0"
                                      materialDesign:HintAssist.Hint="زبون" Style="{StaticResource FilledComboBox}"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                                      DisplayMemberPath="Name" Width="120" Margin="0,0,12,0"
                                      materialDesign:HintAssist.Hint="مخزن" Style="{StaticResource FilledComboBox}"/>
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedValue="{Binding StatusFilter}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label" Width="100" Margin="0,0,12,0"
                                      materialDesign:HintAssist.Hint="الحالة" Style="{StaticResource FilledComboBox}"/>
                            <TextBox Text="{Binding RelatedInvoiceSearch, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,12,0"
                                     materialDesign:HintAssist.Hint="فاتورة أصلية" Style="{StaticResource FilledTextBox}"/>
                            <TextBox Text="{Binding UserNameFilter, UpdateSourceTrigger=PropertyChanged}" Width="120"
                                     materialDesign:HintAssist.Hint="مستخدم" Style="{StaticResource FilledTextBox}"/>
                        </StackPanel>
                    </controls:GoldReportFilterBar.FilterContent>
                </controls:GoldReportFilterBar>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="مرتجعات البيع"
                                             TargetDataGrid="{Binding ElementName=ReturnsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="ReturnsGrid" Grid.Row="1"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding InvoiceNumber}" Width="110"/>
                        <DataGridTextColumn Header="تاريخ" Binding="{Binding InvoiceDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="100"/>
                        <DataGridTextColumn Header="زبون" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="فاتورة أصلية" Binding="{Binding RelatedInvoiceNumber}" Width="110"/>
                        <DataGridTextColumn Header="وزن" Binding="{Binding TotalWeightGrams, StringFormat=N3}" Width="80"/>
                        <DataGridTextColumn Header="د.ع" Binding="{Binding TotalAmountIqd, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="$" Binding="{Binding TotalAmountUsd, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="حالة" Binding="{Binding Status}" Width="90"/>
                        <DataGridTemplateColumn Header="تفاصيل" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="عرض" Style="{StaticResource FlatButton}" Padding="4,2"
                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                           Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
