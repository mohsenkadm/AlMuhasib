<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldSalesReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="تقرير المبيعات" FontSize="24" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,0,16"/>

        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="عدد الفواتير" TextValue="{Binding SaleCount}"
                                       Icon="FileDocument" IconBackground="#FFF8E7" IconForeground="#B8860B" ValueForeground="#B8860B"/>
            <controls:AnimatedStatCard Title="مبيعات د.ع" TextValue="{Binding TotalSalesIqd, StringFormat=N0}"
                                       Icon="Cash" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="مبيعات $" TextValue="{Binding TotalSalesUsd, StringFormat=N2}"
                                       Icon="CurrencyUsd" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="الوزن المباع" TextValue="{Binding TotalWeightGrams, StringFormat=N3}"
                                       Icon="ScaleBalance" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
            <controls:AnimatedStatCard Title="أجور الصياغة" TextValue="{Binding TotalMakingIqd, StringFormat=N0}"
                                       Icon="Hammer" IconBackground="#F3E5F5" IconForeground="#7B1FA2" ValueForeground="#7B1FA2"/>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource FilterBar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <DatePicker Width="150" Margin="0,0,12,0" SelectedDate="{Binding DateFrom}"
                            materialDesign:HintAssist.Hint="من تاريخ" Style="{StaticResource FilledDatePicker}"/>
                <DatePicker Width="150" Margin="0,0,12,0" SelectedDate="{Binding DateTo}"
                            materialDesign:HintAssist.Hint="إلى تاريخ" Style="{StaticResource FilledDatePicker}"/>
                <ComboBox Width="150" Margin="0,0,12,0" ItemsSource="{Binding StatusFilters}"
                          SelectedValue="{Binding StatusFilter}" SelectedValuePath="Value" DisplayMemberPath="Label"
                          materialDesign:HintAssist.Hint="الحالة" Style="{StaticResource FilledComboBox}"/>
                <Button Content="عرض التقرير" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <materialDesign:Card Grid.Row="3" Style="{StaticResource ElevatedCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ModernDataGrid}" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="110"/>
                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerFileNumber}" Width="90"/>
                    <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="80"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90"/>
                    <DataGridTextColumn Header="الوزن" Binding="{Binding TotalWeightGrams, StringFormat=N3}" Width="90"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="د.ع" Binding="{Binding TotalAmountIqd, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="$" Binding="{Binding TotalAmountUsd, StringFormat=N2}" Width="90"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                    <DataGridTemplateColumn Header="مرتجع" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="مرتجع" Style="{StaticResource FlatButton}" Padding="4,2"
                                        Command="{Binding DataContext.CreateReturnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
