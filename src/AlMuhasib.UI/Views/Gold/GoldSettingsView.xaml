<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="720">
            <md:Card Padding="0" Margin="0,0,0,16" UniformCornerRadius="16"
                     BorderBrush="#D4AF37" BorderThickness="1" md:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#8B6914" Offset="0"/>
                                <GradientStop Color="#B8860B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Margin="22,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="إعدادات محل الذهب" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="المثقال، الميزان، تنبيهات المخزون والآجل" FontSize="13"
                                       Foreground="#FFF8E1" Margin="0,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}">
                            <md:PackIcon Kind="Refresh" Width="22" Height="22" Foreground="White"/>
                        </Button>
                    </Grid>
                </Grid>
            </md:Card>

            <md:Card Padding="22" Margin="0,0,0,14" UniformCornerRadius="14"
                     BorderBrush="#E8D5A3" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="إعدادات عامة" FontWeight="Bold" Foreground="#B8860B" FontSize="15" Margin="0,0,0,14"/>

                    <TextBox Text="{Binding MithqalGrams, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="وزن المثقال (غرام)"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding EnabledKaratsCsv, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="العيارات المفعّلة (مفصولة بفاصلة)"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding LowStockAlertGrams, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="حد تنبيه المخزون المنخفض (غرام)"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding OverdueDaysThreshold, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="أيام اعتبار الآجل متأخراً"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <CheckBox Content="السماح بتعديل الوزن يدوياً"
                              IsChecked="{Binding AllowManualWeightEdit}" Margin="0,4,0,0"/>
                </StackPanel>
            </md:Card>

            <md:Card Padding="22" Margin="0,0,0,14" UniformCornerRadius="14"
                     BorderBrush="#E8D5A3" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,14">
                        <TextBlock Text="الميزان الإلكتروني" FontWeight="Bold" Foreground="#B8860B" FontSize="15"
                                   VerticalAlignment="Center"/>
                        <Border DockPanel.Dock="Right" Padding="10,4" CornerRadius="8" Background="#FFF8E1"
                                HorizontalAlignment="Left" Margin="12,0,0,0">
                            <TextBlock Text="{Binding ScaleStatusText}" Foreground="#8B6914" FontSize="12"/>
                        </Border>
                    </DockPanel>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                  Text="{Binding ScaleComPort, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  md:HintAssist.Hint="منفذ COM"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Command="{Binding RefreshPortsCommand}"
                                Style="{StaticResource IconButton}" Width="40" Height="40" ToolTip="تحديث المنافذ">
                            <md:PackIcon Kind="SerialPort" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <ComboBox ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding ScaleBaudRate}"
                              md:HintAssist.Hint="Baud Rate"
                              Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding ScaleStabilityThresholdGrams, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="عتبة استقرار الوزن (غرام)"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="اتصال" Command="{Binding ConnectScaleCommand}"
                                Style="{StaticResource PrimaryButton}" Height="36" Padding="18,0" Margin="0,0,8,0"/>
                        <Button Content="قطع الاتصال" Command="{Binding DisconnectScaleCommand}"
                                Style="{StaticResource FlatButton}" Height="36"/>
                    </StackPanel>
                </StackPanel>
            </md:Card>

            <Button Content="حفظ الإعدادات" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}" Height="44" Padding="28,0"
                    HorizontalAlignment="Left" IsEnabled="{Binding CanEdit}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
