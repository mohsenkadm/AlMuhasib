<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldCollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="تحصيل الآجل" FontSize="24" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource FilterBar}" Margin="0,0,12,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="260" Margin="0,0,12,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="بحث"
                         Style="{StaticResource FilledTextBox}"/>
                <Button Content="بحث" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <materialDesign:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,12,0">
            <DataGrid ItemsSource="{Binding OpenInvoices}" SelectedItem="{Binding SelectedInvoice}"
                      AutoGenerateColumns="False" IsReadOnly="True" Style="{StaticResource ModernDataGrid}" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="العملة" Binding="{Binding PaymentCurrency}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource ElevatedCard}" Padding="20">
            <StackPanel>
                <TextBlock Text="تسجيل دفعة" FontSize="16" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber, FallbackValue='—'}" FontFamily="Consolas" FontSize="14" Margin="0,0,0,12"/>
                <DatePicker SelectedDate="{Binding PaymentDate}" materialDesign:HintAssist.Hint="تاريخ الدفع"
                            materialDesign:HintAssist.IsFloating="True" Style="{StaticResource FilledDatePicker}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="مبلغ الدفعة" materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding Currencies}" SelectedValue="{Binding PaymentCurrency}"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          materialDesign:HintAssist.Hint="العملة" materialDesign:HintAssist.IsFloating="True"
                          Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                         materialDesign:HintAssist.Hint="سعر الصرف" materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedCashBox}"
                          DisplayMemberPath="Name" materialDesign:HintAssist.Hint="القاصة"
                          materialDesign:HintAssist.IsFloating="True" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="ملاحظات" materialDesign:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                <Button Content="تسجيل التحصيل" Command="{Binding RecordPaymentCommand}"
                        Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Message}" Foreground="#2E7D32" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <Border Grid.ColumnSpan="2" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="180" Height="6" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
