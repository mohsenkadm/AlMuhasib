<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldSaleInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             d:DataContext="{d:DesignInstance Type=vm:GoldSaleInvoiceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="20,16,20,24">

                <!-- Gold header -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6B4E16" Offset="0"/>
                            <GradientStop Color="#B8860B" Offset="0.45"/>
                            <GradientStop Color="#E8C547" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Gold" Width="30" Height="30" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="فاتورة بيع ذهب" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Foreground="#EEFFFFFF" FontSize="13" Margin="0,4,0,0">
                                <Run Text="رقم الفاتورة:"/>
                                <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="12" Background="#33FFFFFF" Padding="16,10">
                            <StackPanel>
                                <TextBlock Text="الإجمالي" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Scale connection status -->
                <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="8" Background="#FFF8E1"
                        BorderBrush="#E8D5A3" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#C62828"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScaleConnected}" Value="True">
                                            <Setter Property="Fill" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <materialDesign:PackIcon Kind="ScaleBalance" Width="18" Height="18"
                                                 Foreground="#8B6914" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="#8B6914" VerticalAlignment="Center">
                            <Run Text="الميزان:"/>
                            <Run Text="{Binding ScaleStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Header fields -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DatePicker Grid.Row="0" Grid.Column="0"
                                    SelectedDate="{Binding InvoiceDate}"
                                    materialDesign:HintAssist.Hint="التاريخ"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource FilledDatePicker}"
                                    Margin="0,0,12,12"/>

                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding PaymentMethods}"
                                  SelectedValue="{Binding PaymentMethod}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  materialDesign:HintAssist.Hint="طريقة الدفع"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,12"/>

                        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      StaysOpenOnEdit="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      materialDesign:HintAssist.Hint="الزبون"
                                      materialDesign:HintAssist.IsFloating="True"
                                      Style="{StaticResource FilledComboBox}"/>
                            <Button Grid.Column="1"
                                    Command="{Binding ShowSelectedPartyDetailsCommand}"
                                    ToolTip="تفاصيل الزبون"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" Margin="4,0,0,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountDetails" Width="20" Height="20" Foreground="#8B6914"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding OpenQuickAddCustomerCommand}"
                                    ToolTip="إضافة زبون جديد"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Button>
                        </Grid>

                        <ComboBox Grid.Row="0" Grid.Column="3"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,0,12"/>

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="القاصة"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,12"/>

                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  ItemsSource="{Binding Currencies}"
                                  SelectedValue="{Binding PricingCurrency}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  materialDesign:HintAssist.Hint="عملة التسعير"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,12"/>

                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding Currencies}"
                                  SelectedValue="{Binding PaymentCurrency}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  materialDesign:HintAssist.Hint="عملة الدفع"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,12"/>

                        <Grid Grid.Row="1" Grid.Column="3" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                     materialDesign:HintAssist.Hint="سعر الصرف (دولار→دينار)"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"/>
                            <Button Grid.Column="1" Command="{Binding RefreshFxCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="تحديث سعر الصرف" Margin="4,0,0,0">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20" Foreground="#B8860B"/>
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ملاحظات"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"/>
                    </Grid>
                </materialDesign:Card>

                <!-- Lines toolbar -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Border Width="220" Background="#FFF8E1" CornerRadius="8" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18"
                                                         Foreground="#8B6914" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="الباركود + Enter"
                                         materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                         BorderThickness="0" Background="Transparent" FontSize="13"
                                         behaviors:EnterKeyCommandBehavior.Command="{Binding ProcessBarcodeCommand}"/>
                            </Grid>
                        </Border>
                        <Button Command="{Binding OpenItemPickerCommand}"
                                Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Height="36" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Gold" Margin="0,0,6,0"/>
                                <TextBlock Text="اختيار قطع"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddLineCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/>
                                <TextBlock Text="إضافة بند"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ReadScaleCommand}" Style="{StaticResource PrimaryButton}">
                            <Button.Background>
                                <SolidColorBrush Color="#B8860B"/>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ScaleBalance" Margin="0,0,6,0"/>
                                <TextBlock Text="قراءة الميزان"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="بنود الفاتورة" FontSize="16" FontWeight="SemiBold"
                                   Foreground="#8B6914"/>
                        <TextBlock FontSize="11" Foreground="#8D6E63" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="امسح الباركود أو اختر قطعة — أو أدخل العيار والوزن يدوياً للبيع بالوزن."/>
                    </StackPanel>
                </DockPanel>

                <!-- Lines grid -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="0" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <DataGrid ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False"
                              Style="{StaticResource InvoiceItemsDataGrid}"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="قطعة / باركود" Width="110"
                                                Binding="{Binding ItemLookup, UpdateSourceTrigger=LostFocus}"/>
                            <DataGridTemplateColumn Header="العيار" Width="100"
                                                    CellTemplate="{StaticResource GoldInvoiceKaratCellTemplate}"/>
                            <DataGridTemplateColumn Header="الوزن (غ)" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WeightGrams, StringFormat=N3}"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding WeightGrams, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                 IsReadOnly="{Binding IsWeightReadOnly}"
                                                 BorderThickness="0" Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="سعر المثقال" Width="120"
                                                Binding="{Binding MithqalPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                            <DataGridTextColumn Header="معدل الأجور" Width="100"
                                                Binding="{Binding MakingChargeRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"/>
                            <DataGridTextColumn Header="أجور الصياغة" Width="120"
                                                Binding="{Binding MakingCharge, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                            <DataGridTextColumn Header="قيمة الذهب" Width="120" IsReadOnly="True"
                                                Binding="{Binding GoldValue, StringFormat=N0}"/>
                            <DataGridTextColumn Header="إجمالي البند" Width="120" IsReadOnly="True"
                                                Binding="{Binding LineTotal, StringFormat=N0}"/>
                            <DataGridTextColumn Header="الوصف" Width="*"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="" Width="52" IsReadOnly="True"
                                                    CellTemplate="{StaticResource InvoiceDeleteRowCellTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <!-- Totals -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="360"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Message}" Foreground="#1565C0" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="حفظ الفاتورة" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    IsEnabled="{Binding CanAdd}"
                                    Padding="28,10" Margin="0,0,8,0">
                                <Button.Background>
                                    <SolidColorBrush Color="#B8860B"/>
                                </Button.Background>
                            </Button>
                            <Button Content="طباعة" Command="{Binding PrintInvoiceCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="20,10" Margin="0,0,8,0"/>
                            <Button Content="واتساب" Command="{Binding SendInvoiceWhatsAppCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Padding="20,10" Margin="0,0,8,0"/>
                            <Button Content="فاتورة جديدة" Command="{Binding NewInvoiceCommand}"
                                    Style="{StaticResource OutlinedButton}" Padding="20,10"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource GoldInvoiceTotalsPanelStyle}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="قيمة الذهب" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                                <TextBlock Text="{Binding TotalGoldValue, StringFormat=N0}" FontWeight="SemiBold"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="أجور الصياغة" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                                <TextBlock Text="{Binding TotalMakingCharge, StringFormat=N0}" FontWeight="SemiBold"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="الخصم" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120" HorizontalAlignment="Left"
                                         Style="{StaticResource FilledTextBox}"/>
                            </DockPanel>
                            <Separator Margin="0,4,0,10"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="الإجمالي" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GoldInvoiceTotalsAccentBrush}"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat=N0}" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource GoldInvoiceTotalsAccentBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="بالدينار" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                                <TextBlock Text="{Binding TotalIqd, StringFormat='{}{0:N0} د.ع'}" FontWeight="SemiBold"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="بالدولار" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                                <TextBlock Text="{Binding TotalUsd, StringFormat='{}{0:N2} $'}" FontWeight="SemiBold"
                                           HorizontalAlignment="Left" Foreground="{DynamicResource GoldInvoiceTotalsTextBrush}"/>
                            </DockPanel>
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="المبلغ المدفوع"
                                     materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource GoldInvoiceTotalsMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="نقدي: اترك المدفوع أو اجعله صفر ليُحسب كامل المبلغ. للآجل اختر «آجل» صراحةً."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <controls:GoldItemPickerOverlay Panel.ZIndex="120"
                                        DataContext="{Binding ItemPicker}"
                                        IsOpen="{Binding DataContext.IsItemPickerOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <Border Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="6" VerticalAlignment="Center"
                         Foreground="#B8860B"/>
        </Border>

        <Grid Visibility="{Binding IsQuickAddCustomerOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="24" MinWidth="420" MaxWidth="500"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="16"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <TextBlock Text="إضافة زبون جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBox materialDesign:HintAssist.Hint="اسم الزبون *"
                             Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="رقم الهاتف"
                             Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="العنوان"
                             Text="{Binding QuickCustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding QuickCustomerError}" Foreground="#D32F2F" Margin="0,0,0,8"
                               Visibility="{Binding QuickCustomerError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickCustomerCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddCustomerCommand}"
                                Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
