<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldOpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
            <md:Card Padding="0" Margin="0,0,0,16" UniformCornerRadius="16"
                     BorderBrush="#D4AF37" BorderThickness="1" md:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6D4C00" Offset="0"/>
                                <GradientStop Color="#B8860B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="22,18">
                        <TextBlock Text="رصيد افتتاحي للمخزون" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="عيّن الرصيد المطلق بالغرام لكل عيار ومخزن" FontSize="13"
                                   Foreground="#FFF8E1" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </md:Card>

            <md:Card Padding="24" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1"
                     md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentBalanceText}" FontSize="13" Foreground="#8B6914"
                               Background="#FFF8E1" Padding="12,8" Margin="0,0,0,16"/>

                    <ComboBox ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name"
                              md:HintAssist.Hint="المخزن"
                              Style="{StaticResource FilledComboBox}"
                              Margin="0,0,0,14"/>

                    <ComboBox ItemsSource="{Binding Karats}"
                              SelectedValue="{Binding KaratValue}"
                              SelectedValuePath="KaratValue"
                              DisplayMemberPath="Name"
                              md:HintAssist.Hint="العيار"
                              Style="{StaticResource FilledComboBox}"
                              Margin="0,0,0,14"/>

                    <TextBox Text="{Binding GramsOnHand, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="الرصيد الافتتاحي (غرام)"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBox Text="{Binding CostPerGram, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             md:HintAssist.Hint="تكلفة الغرام (اختياري)"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="ملاحظات"
                             Style="{StaticResource FilledTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding FormError}" Foreground="#D32F2F" Margin="0,0,0,12"/>

                    <Button Content="حفظ رصيد الافتتاح" Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0"
                            HorizontalAlignment="Left" IsEnabled="{Binding CanAdd}"/>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
