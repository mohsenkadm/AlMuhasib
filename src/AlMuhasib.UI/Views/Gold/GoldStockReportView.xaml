<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <TextBlock Text="تقرير المخزون" FontSize="24" FontWeight="Bold" Foreground="#B8860B" VerticalAlignment="Center"/>
            <Button Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Content="تحديث"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="إجمالي الغرامات" TextValue="{Binding TotalGrams, StringFormat=N3}"
                                       Icon="ScaleBalance" IconBackground="#FFF8E7" IconForeground="#B8860B" ValueForeground="#B8860B"/>
            <controls:AnimatedStatCard Title="قيمة المخزون" TextValue="{Binding TotalValue, StringFormat=N0}"
                                       Icon="Gold" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="عدد القطع" TextValue="{Binding PieceCount}"
                                       Icon="DiamondStone" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="عيارات منخفضة" TextValue="{Binding LowStockCount}"
                                       Icon="Alert" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
        </UniformGrid>

        <materialDesign:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ModernDataGrid}" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="العيار" Binding="{Binding KaratValue}" Width="80"/>
                    <DataGridTextColumn Header="الاسم" Binding="{Binding KaratName}" Width="140"/>
                    <DataGridTextColumn Header="الغرامات" Binding="{Binding GramsOnHand, StringFormat=N3}" Width="120"/>
                    <DataGridTextColumn Header="متوسط التكلفة/غ" Binding="{Binding AverageCostPerGram, StringFormat=N0}" Width="140"/>
                    <DataGridTextColumn Header="قيمة المخزون" Binding="{Binding StockValue, StringFormat=N0}" Width="140"/>
                    <DataGridTextColumn Header="القطع" Binding="{Binding PieceCount}" Width="80"/>
                    <DataGridCheckBoxColumn Header="منخفض" Binding="{Binding IsLowStock}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
