<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldUserPerformanceReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:GoldUserPerformanceReportViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="أداء المستخدمين" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="المستخدمون" TextValue="{Binding UserCount}"
                                               Icon="AccountMultiple" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="مبيعات د.ع" TextValue="{Binding TotalSales}"
                                               Icon="Cash" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="مشتريات د.ع" TextValue="{Binding TotalPurchases}"
                                               Icon="Cart" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="الإجراءات" TextValue="{Binding TotalActions}"
                                               Icon="ShieldKey" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding UserNameFilter, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" materialDesign:HintAssist.Hint="اسم المستخدم"
                                 Width="160" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أداء المستخدمين"
                                             TargetDataGrid="{Binding ElementName=UserPerformanceGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="UserPerformanceGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                          Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المستخدم" Binding="{Binding UserName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="UserName"/>
                        <DataGridTextColumn Header="مبيعات" Binding="{Binding SalesCount}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SalesCount"/>
                        <DataGridTextColumn Header="مشتريات" Binding="{Binding PurchasesCount}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PurchasesCount"/>
                        <DataGridTextColumn Header="تبديل" Binding="{Binding ExchangeCount}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ExchangeCount"/>
                        <DataGridTextColumn Header="دفعات" Binding="{Binding PaymentsCount}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentsCount"/>
                        <DataGridTextColumn Header="إجراءات" Binding="{Binding AuditActionsCount}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AuditActionsCount"/>
                        <DataGridTextColumn Header="مبلغ مبيعات د.ع" Binding="{Binding SalesAmountIqd, StringFormat=N0}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SalesAmountIqd"/>
                        <DataGridTextColumn Header="مبلغ مشتريات د.ع" Binding="{Binding PurchasesAmountIqd, StringFormat=N0}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PurchasesAmountIqd"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
