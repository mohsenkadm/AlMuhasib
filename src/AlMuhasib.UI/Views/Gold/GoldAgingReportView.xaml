<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldAgingReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:GoldAgingReportViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="أعمار ذمم الذهب" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي المستحق" TextValue="{Binding TotalOutstanding}"
                                               Icon="AccountCash" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="فواتير مفتوحة" TextValue="{Binding RowCount}"
                                               Icon="Counter" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="عدد الزبائن" TextValue="{Binding CustomerCount}"
                                               Icon="AccountGroup" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="أكثر من 90 يوم" TextValue="{Binding Over90Total}"
                                               Icon="CalendarAlert" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أعمار ذمم الذهب"
                                             TargetDataGrid="{Binding ElementName=GoldAgingGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldAgingGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                          Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Phone"/>
                        <DataGridTextColumn Header="جاري" Binding="{Binding CurrentIqd, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CurrentIqd"/>
                        <DataGridTextColumn Header="1-30" Binding="{Binding Days1To30Iqd, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Days1To30Iqd"/>
                        <DataGridTextColumn Header="31-60" Binding="{Binding Days31To60Iqd, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Days31To60Iqd"/>
                        <DataGridTextColumn Header="61-90" Binding="{Binding Days61To90Iqd, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Days61To90Iqd"/>
                        <DataGridTextColumn Header="+90" Binding="{Binding Over90Iqd, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Over90Iqd"/>
                        <DataGridTextColumn Header="الإجمالي د.ع" Binding="{Binding TotalIqd, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalIqd"/>
                        <DataGridTextColumn Header="الإجمالي $" Binding="{Binding TotalUsd, StringFormat=N2}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalUsd"/>
                        <DataGridTextColumn Header="فواتير" Binding="{Binding OpenInvoiceCount}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="OpenInvoiceCount"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
