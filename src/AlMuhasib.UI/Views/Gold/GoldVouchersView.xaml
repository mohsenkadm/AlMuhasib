<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldVouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="السندات" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenCreateDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileDocumentPlusOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="سند جديد"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <ComboBox Width="140" Margin="0,0,12,0" ItemsSource="{Binding TypeFilters}"
                              SelectedValue="{Binding TypeFilter}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              md:HintAssist.Hint="النوع" Style="{StaticResource FilledComboBox}"/>
                    <ComboBox Width="140" Margin="0,0,12,0" ItemsSource="{Binding Currencies}"
                              SelectedValue="{Binding CurrencyFilter}" SelectedValuePath="Value" DisplayMemberPath="Label"
                              md:HintAssist.Hint="العملة" Style="{StaticResource FilledComboBox}"/>
                    <DatePicker Width="140" Margin="0,0,12,0" SelectedDate="{Binding DateFrom}"
                                md:HintAssist.Hint="من تاريخ" Style="{StaticResource FilledDatePicker}"/>
                    <DatePicker Width="140" SelectedDate="{Binding DateTo}"
                                md:HintAssist.Hint="إلى تاريخ" Style="{StaticResource FilledDatePicker}"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- ═══ BOTTOM: Data Grid ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة السندات"
                                             TargetDataGrid="{Binding ElementName=GoldVouchersGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldVouchersGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Vouchers}"
                          SelectedItem="{Binding SelectedVoucher}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherNumber"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate, StringFormat=yyyy/MM/dd}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherDate"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding VoucherType}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VoucherType"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Currency"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                        <DataGridTextColumn Header="الزبون/المورد" Binding="{Binding PartyDisplayName}" Width="160"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PartyDisplayName"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- ═══ Create Dialog ═══ -->
        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False"
                       Style="{StaticResource ModernDialogHost}" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="420">
                    <StackPanel>
                        <TextBlock Text="إنشاء سند" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBox Text="{Binding EditVoucherNumber}" IsReadOnly="True"
                                 md:HintAssist.Hint="رقم السند" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding VoucherTypes}" SelectedValue="{Binding EditType}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  md:HintAssist.Hint="نوع السند" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                        <DatePicker SelectedDate="{Binding EditDate}" md:HintAssist.Hint="التاريخ"
                                    Style="{StaticResource FilledDatePicker}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Currencies}" SelectedValue="{Binding EditCurrency}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  md:HintAssist.Hint="العملة" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                        <TextBox Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="المبلغ" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding EditCashBox}"
                                  DisplayMemberPath="Name" md:HintAssist.Hint="القاصة"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding EditCustomer}"
                                  DisplayMemberPath="Name" md:HintAssist.Hint="الزبون (اختياري — تحصيل آجل)"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"
                                  Visibility="{Binding ShowCustomerField, Converter={StaticResource BoolToVis}}"/>
                        <Border Margin="0,0,0,12" Padding="12" CornerRadius="10"
                                Background="{DynamicResource PrimaryHueLightBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                                Visibility="{Binding ShowCustomerCreditPanel, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="تفاصيل دين الزبون" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="{Binding CustomerCreditSummary}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding EditSupplier}"
                                  DisplayMemberPath="Name" md:HintAssist.Hint="المورد (اختياري — تسديد آجل)"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"
                                  Visibility="{Binding ShowSupplierField, Converter={StaticResource BoolToVis}}"/>
                        <Border Margin="0,0,0,12" Padding="12" CornerRadius="10"
                                Background="{DynamicResource PrimaryHueLightBrush}"
                                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                                Visibility="{Binding ShowSupplierCreditPanel, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="تفاصيل دين المورد" FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                <TextBlock Text="{Binding SupplierCreditSummary}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="ملاحظات" Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حفظ" Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CloseDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
