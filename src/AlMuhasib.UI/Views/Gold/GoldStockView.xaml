<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="مخزون الذهب" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAdjustmentCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="TuneVerticalVariant" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تسوية"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <ComboBox ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name"
                              md:HintAssist.Hint="المخزن"
                              Style="{StaticResource FilledComboBox}"
                              MinWidth="200" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- Stats -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <md:Card Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,10,0" md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="إجمالي الوزن" Foreground="#8D6E63" FontSize="12"/>
                    <TextBlock Text="{Binding TotalGrams, StringFormat={}{0:N2} غ}" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                </StackPanel>
            </md:Card>
            <md:Card Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,10,0" md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="قيمة المخزون" Foreground="#8D6E63" FontSize="12"/>
                    <TextBlock Text="{Binding TotalValue, StringFormat={}{0:N0} د.ع}" FontSize="22" FontWeight="Bold" Foreground="#8B6914"/>
                </StackPanel>
            </md:Card>
            <md:Card Style="{StaticResource ElevatedCard}" Padding="16" md:ElevationAssist.Elevation="Dp2"
                     BorderBrush="#FFCDD2" BorderThickness="1" Background="#FFEBEE">
                <StackPanel>
                    <TextBlock Text="عيارات منخفضة" Foreground="#C62828" FontSize="12"/>
                    <TextBlock Text="{Binding LowStockCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
            </md:Card>
        </UniformGrid>

        <!-- ═══ BOTTOM: Data Grid ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أرصدة المخزون حسب العيار"
                                             TargetDataGrid="{Binding ElementName=GoldStockGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldStockGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding StockRows}"
                          SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                    <Setter Property="Background" Value="#FFEBEE"/>
                                    <Setter Property="Foreground" Value="#B71C1C"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WarehouseName"/>
                        <DataGridTextColumn Header="العيار" Binding="{Binding KaratName}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="KaratName"/>
                        <DataGridTextColumn Header="القيمة" Binding="{Binding KaratValue}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="KaratValue"/>
                        <DataGridTextColumn Header="الوزن (غ)" Binding="{Binding GramsOnHand, StringFormat=N2}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GramsOnHand"/>
                        <DataGridTextColumn Header="متوسط التكلفة/غ" Binding="{Binding AverageCostPerGram, StringFormat=N0}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AverageCostPerGram"/>
                        <DataGridTextColumn Header="قيمة المخزون" Binding="{Binding StockValue, StringFormat=N0}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StockValue"/>
                        <DataGridTextColumn Header="عدد القطع" Binding="{Binding PieceCount}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PieceCount"/>
                        <DataGridTemplateColumn Header="تنبيه" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <md:PackIcon Kind="Alert" Width="18" Height="18" Foreground="#C62828">
                                            <md:PackIcon.Style>
                                                <Style TargetType="md:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </md:PackIcon.Style>
                                        </md:PackIcon>
                                        <TextBlock Text="منخفض" Foreground="#C62828" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
