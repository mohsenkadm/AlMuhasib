<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldCustomerStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="كشف حساب زبون" FontSize="24" FontWeight="Bold" Foreground="#B8860B" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Style="{StaticResource FilterBar}" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBox Width="200" Margin="0,0,12,0"
                         Text="{Binding CustomerSearch, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="بحث عن زبون"
                         Style="{StaticResource FilledTextBox}"/>
                <ComboBox Width="280" Margin="0,0,12,0"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          DisplayMemberPath="Name"
                          IsEditable="True"
                          materialDesign:HintAssist.Hint="اختر الزبون"
                          Style="{StaticResource FilledComboBox}"/>
                <Button Content="تحميل الكشف" Command="{Binding LoadStatementCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                <Button Content="طباعة" Command="{Binding PrintStatementCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"/>
                <Button Content="واتساب" Command="{Binding ShareWhatsAppCommand}" Style="{StaticResource OutlinedButton}"/>
            </StackPanel>
        </Border>

        <UniformGrid Grid.Row="2" Columns="6" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="إجمالي الفواتير" TextValue="{Binding TotalAmount, StringFormat=N0}"
                                       Icon="FileDocument" IconBackground="#FFF8E7" IconForeground="#B8860B" ValueForeground="#B8860B"/>
            <controls:AnimatedStatCard Title="المدفوع" TextValue="{Binding TotalPaid, StringFormat=N0}"
                                       Icon="Cash" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="المتبقي" TextValue="{Binding TotalRemaining, StringFormat=N0}"
                                       Icon="CashRemove" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
            <controls:AnimatedStatCard Title="رصيد آجل د.ع" TextValue="{Binding CreditBalanceIqd, StringFormat=N0}"
                                       Icon="CurrencyUsd" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="رصيد آجل $" TextValue="{Binding CreditBalanceUsd, StringFormat=N2}"
                                       Icon="CurrencyUsd" IconBackground="#E8EAF6" IconForeground="#3949AB" ValueForeground="#3949AB"/>
            <controls:AnimatedStatCard Title="ذهب آجل (غ)" TextValue="{Binding GoldCreditGrams, StringFormat=N3}"
                                       Icon="Gold" IconBackground="#FFF8E1" IconForeground="#8B6914" ValueForeground="#8B6914"/>
        </UniformGrid>

        <materialDesign:Card Grid.Row="3" Style="{StaticResource ElevatedCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Invoices}" AutoGenerateColumns="False" IsReadOnly="True"
                      Style="{StaticResource ModernDataGrid}" Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="110"/>
                    <DataGridTextColumn Header="النوع" Binding="{Binding InvoiceType}" Width="90"/>
                    <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="80"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                    <DataGridTextColumn Header="الوزن" Binding="{Binding TotalWeightGrams, StringFormat=N3}" Width="90"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110"/>
                    <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
