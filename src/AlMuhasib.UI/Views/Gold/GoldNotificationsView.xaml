<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldNotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="التنبيهات" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    <Border Background="#FFF3E0" CornerRadius="10" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock>
                            <Run Text="غير مقروء:"/><Run Text=" "/><Run Text="{Binding UnreadCount}" FontWeight="Bold"/>
                        </TextBlock>
                    </Border>
                </DockPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding RefreshGenerateCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="BellRing" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث / توليد"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding MarkAllReadCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="EmailCheckOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تعليم الكل كمقروء"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding LoadCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <CheckBox Content="غير المقروء فقط" IsChecked="{Binding UnreadOnly}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Message}" Foreground="#2E7D32" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- ═══ BOTTOM: Data Grid ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة التنبيهات"
                                             TargetDataGrid="{Binding ElementName=GoldNotificationsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldNotificationsGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Alerts}"
                          SelectedItem="{Binding SelectedAlert}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Type"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="180"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Title"/>
                        <DataGridTextColumn Header="الرسالة" Binding="{Binding Message}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Message"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="140"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CreatedAt"/>
                        <DataGridCheckBoxColumn Header="مقروء" Binding="{Binding IsRead}" Width="70"
                                               behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IsRead"/>
                        <DataGridTemplateColumn Header="" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="مقروء" Style="{StaticResource FlatButton}"
                                            Command="{Binding DataContext.MarkReadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
