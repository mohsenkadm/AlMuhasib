<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldSaleReturnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             d:DataContext="{d:DesignInstance Type=vm:GoldSaleReturnViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel Margin="20,16,20,24">
            <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5D4037" Offset="0"/>
                        <GradientStop Color="#8B6914" Offset="0.5"/>
                        <GradientStop Color="#B8860B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="مرتجع بيع ذهب" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Foreground="#EEFFFFFF" FontSize="13" Margin="0,4,0,0">
                            <Run Text="رقم المرتجع:"/>
                            <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="12" Background="#33FFFFFF" Padding="16,10">
                        <StackPanel>
                            <TextBlock Text="الإجمالي" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                 Padding="20,16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DatePicker Grid.Row="0" Grid.Column="0" SelectedDate="{Binding InvoiceDate}"
                                materialDesign:HintAssist.Hint="التاريخ" Style="{StaticResource FilledDatePicker}" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{Binding PaymentMethods}" SelectedValue="{Binding PaymentMethod}"
                              SelectedValuePath="Value" DisplayMemberPath="Label"
                              materialDesign:HintAssist.Hint="طريقة الاسترداد" Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="0" Grid.Column="2"
                              ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name" IsEditable="True"
                              materialDesign:HintAssist.Hint="الزبون" Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="0" Grid.Column="3"
                              ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="المخزن" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                    <ComboBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding OriginalSales}" SelectedItem="{Binding SelectedOriginalSale}"
                              DisplayMemberPath="InvoiceNumber" IsEditable="True"
                              materialDesign:HintAssist.Hint="فاتورة البيع الأصلية (اختياري)"
                              Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="1" Grid.Column="2"
                              ItemsSource="{Binding Currencies}" SelectedValue="{Binding PricingCurrency}"
                              SelectedValuePath="Value" DisplayMemberPath="Label"
                              materialDesign:HintAssist.Hint="عملة التسعير" Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                    <ComboBox Grid.Row="1" Grid.Column="3"
                              ItemsSource="{Binding Currencies}" SelectedValue="{Binding PaymentCurrency}"
                              SelectedValuePath="Value" DisplayMemberPath="Label"
                              materialDesign:HintAssist.Hint="عملة الدفع" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                    <TextBox Grid.Row="2" Grid.Column="0"
                             Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="سعر الصرف" Style="{StaticResource FilledTextBox}" Margin="0,0,12,0"/>
                    <ComboBox Grid.Row="2" Grid.Column="1"
                              ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedCashBox}"
                              DisplayMemberPath="Name"
                              materialDesign:HintAssist.Hint="القاصة" Style="{StaticResource FilledComboBox}" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="2" Grid.Column="2"
                             Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="مبلغ الاسترداد" Style="{StaticResource FilledTextBox}" Margin="0,0,12,0"/>
                    <TextBox Grid.Row="2" Grid.Column="3"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="ملاحظات" Style="{StaticResource FilledTextBox}"/>
                </Grid>
            </materialDesign:Card>

            <DockPanel Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Command="{Binding AddLineCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Content="إضافة بند"/>
                    <Button Command="{Binding RemoveLineCommand}" CommandParameter="{Binding SelectedLine}"
                            Style="{StaticResource FlatButton}" Content="حذف بند"/>
                </StackPanel>
                <TextBlock Text="بنود المرتجع" FontSize="16" FontWeight="SemiBold" Foreground="#8B6914" VerticalAlignment="Center"/>
            </DockPanel>

            <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12" Padding="0" Margin="0,0,0,16">
                <DataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          Style="{StaticResource ModernDataGrid}" MinHeight="200" Margin="8">
                    <DataGrid.Columns>
                        <DataGridComboBoxColumn Header="العيار" Width="100"
                                                SelectedValueBinding="{Binding KaratValue, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="KaratValue" DisplayMemberPath="Name"
                                                ItemsSource="{Binding DataContext.Karats, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <DataGridTextColumn Header="الوزن (غ)" Width="110"
                                            Binding="{Binding WeightGrams, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"/>
                        <DataGridTextColumn Header="سعر المثقال" Width="120"
                                            Binding="{Binding MithqalPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                        <DataGridTextColumn Header="أجور الصياغة" Width="120"
                                            Binding="{Binding MakingCharge, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                        <DataGridTextColumn Header="قيمة الذهب" Width="120" IsReadOnly="True"
                                            Binding="{Binding GoldValue, StringFormat=N0}"/>
                        <DataGridTextColumn Header="إجمالي البند" Width="120" IsReadOnly="True"
                                            Binding="{Binding LineTotal, StringFormat=N0}"/>
                        <DataGridTextColumn Header="الوصف" Width="*"
                                            Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </materialDesign:Card>

            <StackPanel Orientation="Horizontal">
                <Button Content="حفظ المرتجع" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanAdd}" Padding="28,10" Margin="0,0,8,0"/>
                <Button Content="جديد" Command="{Binding NewInvoiceCommand}" Style="{StaticResource FlatButton}" Padding="20,10"/>
            </StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="#1565C0" Margin="0,12,0,0"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
