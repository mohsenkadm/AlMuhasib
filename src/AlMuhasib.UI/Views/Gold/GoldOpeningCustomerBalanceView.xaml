<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldOpeningCustomerBalanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch">
            <md:Card Padding="0" Margin="0,0,0,16" UniformCornerRadius="16"
                     BorderBrush="#D4AF37" BorderThickness="1" md:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5D4037" Offset="0"/>
                                <GradientStop Color="#A67C00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="22,18">
                        <TextBlock Text="رصيد افتتاحي للزبون" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="عيّن ذمم الدينار والدولار وغرامات الذهب الآجلة" FontSize="13"
                                   Foreground="#FFF8E1" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </md:Card>

            <md:Card Padding="24" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1"
                     md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="بحث عن زبون"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <ComboBox ItemsSource="{Binding Customers}"
                              SelectedItem="{Binding SelectedCustomer}"
                              DisplayMemberPath="Name"
                              IsEditable="True"
                              md:HintAssist.Hint="الزبون"
                              Style="{StaticResource FilledComboBox}"
                              Margin="0,0,0,14"/>

                    <TextBox Text="{Binding CreditBalanceIqd, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="رصيد آجل د.ع"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBox Text="{Binding CreditBalanceUsd, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="رصيد آجل $"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBox Text="{Binding GoldCreditGrams, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="غرامات ذهب آجلة"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="ملاحظات"
                             Style="{StaticResource FilledTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding FormError}" Foreground="#D32F2F" Margin="0,0,0,12"/>

                    <Button Content="حفظ أرصدة الافتتاح" Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0"
                            HorizontalAlignment="Left" IsEnabled="{Binding CanAdd}"/>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
