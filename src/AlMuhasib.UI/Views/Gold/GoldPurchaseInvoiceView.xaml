<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldPurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:GoldPurchaseInvoiceViewModel}"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel Margin="20,16,20,24">
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4A3728" Offset="0"/>
                            <GradientStop Color="#8D6E63" Offset="0.5"/>
                            <GradientStop Color="#BCAAA4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="Basket" Width="30" Height="30" Foreground="White"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="فاتورة شراء ذهب" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Foreground="#EEFFFFFF" FontSize="13" Margin="0,4,0,0">
                                <Run Text="رقم الفاتورة:"/>
                                <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="12" Background="#33FFFFFF" Padding="16,10">
                            <StackPanel>
                                <TextBlock Text="الإجمالي" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Margin="0,0,0,12" Padding="12,8" CornerRadius="8" Background="#FFF8E1"
                        BorderBrush="#E8D5A3" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#C62828"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScaleConnected}" Value="True">
                                            <Setter Property="Fill" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <materialDesign:PackIcon Kind="ScaleBalance" Width="18" Height="18"
                                                 Foreground="#8B6914" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="13" Foreground="#8B6914" VerticalAlignment="Center">
                            <Run Text="الميزان:"/>
                            <Run Text="{Binding ScaleStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DatePicker Grid.Row="0" Grid.Column="0" SelectedDate="{Binding InvoiceDate}"
                                    materialDesign:HintAssist.Hint="التاريخ" materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource FilledDatePicker}" Margin="0,0,12,12"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding PaymentMethods}"
                                  SelectedValue="{Binding PaymentMethod}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  materialDesign:HintAssist.Hint="طريقة الدفع" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                        <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" IsEditable="True"
                                      StaysOpenOnEdit="True" materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      materialDesign:HintAssist.Hint="المورد" materialDesign:HintAssist.IsFloating="True"
                                      Style="{StaticResource FilledComboBox}"/>
                            <Button Grid.Column="1" Command="{Binding ShowSelectedSupplierDetailsCommand}"
                                    ToolTip="تفاصيل المورد" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" Margin="4,0,0,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountDetails" Width="20" Height="20" Foreground="#5D4037"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding OpenQuickAddSupplierCommand}"
                                    ToolTip="إضافة مورد جديد" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="المخزن" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" IsEditable="True"
                                      StaysOpenOnEdit="True" materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      materialDesign:HintAssist.Hint="الزبون (اختياري)" materialDesign:HintAssist.IsFloating="True"
                                      Style="{StaticResource FilledComboBox}"/>
                            <Button Grid.Column="1" Command="{Binding ShowSelectedCustomerDetailsCommand}"
                                    ToolTip="تفاصيل الزبون" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" Margin="4,0,0,0" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountDetails" Width="20" Height="20" Foreground="#5D4037"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding OpenQuickAddCustomerCommand}"
                                    ToolTip="إضافة زبون جديد" Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Button>
                        </Grid>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}" DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="القاصة" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding Currencies}"
                                  SelectedValue="{Binding PricingCurrency}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  materialDesign:HintAssist.Hint="عملة التسعير" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,12,12"/>
                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Currencies}"
                                  SelectedValue="{Binding PaymentCurrency}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                  materialDesign:HintAssist.Hint="عملة الدفع" materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                     materialDesign:HintAssist.Hint="سعر الصرف" materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"/>
                            <Button Grid.Column="1" Command="{Binding RefreshFxCommand}" Style="{StaticResource MaterialDesignIconButton}" ToolTip="تحديث">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Width="20" Height="20"/>
                            </Button>
                        </Grid>
                        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ملاحظات" materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"/>
                    </Grid>
                </materialDesign:Card>

                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Command="{Binding AddLineCommand}" Style="{StaticResource OutlinedButton}" Margin="0,0,8,0" Content="إضافة بند"/>
                        <Button Command="{Binding ReadScaleCommand}" Style="{StaticResource PrimaryButton}" Content="قراءة الميزان"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="بنود الشراء" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11" Foreground="#8D6E63" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="خردة/وزن: اترك «قطعة؟» بدون تحديد. لشراء قطعة جاهزة: فعّل «قطعة؟» وأدخل الاسم في الوصف والباركود اختياري."/>
                    </StackPanel>
                </DockPanel>

                <materialDesign:Card Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,0,16">
                    <DataGrid ItemsSource="{Binding Lines}"
                              AutoGenerateColumns="False" Style="{StaticResource InvoiceItemsDataGrid}"
                              Margin="8">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="قطعة؟" Width="60"
                                                    Binding="{Binding CreateAsPiece, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="باركود القطعة" Width="110"
                                                Binding="{Binding PieceBarcode, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="العيار" Width="100"
                                                    CellTemplate="{StaticResource GoldInvoiceKaratCellTemplate}"/>
                            <DataGridTemplateColumn Header="الوزن (غ)" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding WeightGrams, StringFormat=N3}"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding WeightGrams, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                 IsReadOnly="{Binding IsWeightReadOnly}"
                                                 BorderThickness="0" Padding="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="سعر المثقال" Width="120"
                                                Binding="{Binding MithqalPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                            <DataGridTextColumn Header="أجور" Width="100"
                                                Binding="{Binding MakingCharge, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"/>
                            <DataGridTextColumn Header="قيمة الذهب" Width="120" IsReadOnly="True"
                                                Binding="{Binding GoldValue, StringFormat=N0}"/>
                            <DataGridTextColumn Header="الإجمالي" Width="120" IsReadOnly="True"
                                                Binding="{Binding LineTotal, StringFormat=N0}"/>
                            <DataGridTextColumn Header="الوصف" Width="*"
                                                Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="" Width="52" IsReadOnly="True"
                                                    CellTemplate="{StaticResource InvoiceDeleteRowCellTemplate}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </materialDesign:Card>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Message}" Foreground="#1565C0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="حفظ فاتورة الشراء" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanAdd}" Margin="0,0,8,0"/>
                            <Button Content="طباعة" Command="{Binding PrintInvoiceCommand}"
                                    Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"/>
                            <Button Content="واتساب" Command="{Binding SendInvoiceWhatsAppCommand}"
                                    Style="{StaticResource OutlinedButton}" Margin="0,0,8,0"/>
                            <Button Content="فاتورة جديدة" Command="{Binding NewInvoiceCommand}" Style="{StaticResource OutlinedButton}"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="14" Padding="20,16" Background="#F3E5F5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="قيمة الذهب"/><TextBlock Text="{Binding TotalGoldValue, StringFormat=N0}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="الخصم" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" Style="{StaticResource FilledTextBox}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="الإجمالي" FontWeight="Bold"/><TextBlock Text="{Binding GrandTotal, StringFormat=N0}" FontWeight="Bold" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="دينار"/><TextBlock Text="{Binding TotalIqd, StringFormat=N0}" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="دولار"/><TextBlock Text="{Binding TotalUsd, StringFormat=N2}" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="المبلغ المدفوع" materialDesign:HintAssist.IsFloating="True"
                                     Style="{StaticResource FilledTextBox}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        <Border Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="200" Height="6" VerticalAlignment="Center"/>
        </Border>

        <Grid Visibility="{Binding IsQuickAddCustomerOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="24" MinWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" UniformCornerRadius="16">
                <StackPanel>
                    <TextBlock Text="إضافة زبون جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="اسم الزبون *" Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="رقم الهاتف" Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="العنوان" Text="{Binding QuickCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding QuickCustomerError}" Foreground="#D32F2F" Visibility="{Binding QuickCustomerError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickCustomerCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddCustomerCommand}" Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid Visibility="{Binding IsQuickAddSupplierOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="24" MinWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" UniformCornerRadius="16">
                <StackPanel>
                    <TextBlock Text="إضافة مورد جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="اسم المورد *" Text="{Binding QuickSupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="رقم الهاتف" Text="{Binding QuickSupplierPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="العنوان" Text="{Binding QuickSupplierAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding QuickSupplierError}" Foreground="#D32F2F" Visibility="{Binding QuickSupplierError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickSupplierCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddSupplierCommand}" Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
