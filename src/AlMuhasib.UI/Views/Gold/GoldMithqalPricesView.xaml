<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldMithqalPricesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="أسعار المثقال" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <TextBox md:HintAssist.Hint="بحث..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="220" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- Latest prices strip -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding LatestPrices}" Margin="0,0,0,16">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="160" Margin="0,0,10,10" Padding="14,12" CornerRadius="12"
                            Background="#FFF8E1" BorderBrush="#D4AF37" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding KaratName}" FontWeight="Bold" Foreground="#8B6914"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#B8860B" Margin="0,4,0,0">
                                <Run Text="{Binding PricePerMithqal, StringFormat=N0, Mode=OneWay}"/>
                                <Run Text="{Binding Currency, Mode=OneWay}" FontSize="12"/>
                            </TextBlock>
                            <TextBlock Text="{Binding PriceDate, StringFormat=yyyy/MM/dd}" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══ BOTTOM: Data Grid ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="سجل أسعار المثقال"
                                             TargetDataGrid="{Binding ElementName=GoldMithqalPricesGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldMithqalPricesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Prices}"
                          SelectedItem="{Binding SelectedPrice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding PriceDate, StringFormat=yyyy/MM/dd}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PriceDate"/>
                        <DataGridTextColumn Header="العيار" Binding="{Binding KaratName}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="KaratName"/>
                        <DataGridTextColumn Header="القيمة" Binding="{Binding KaratValue}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="KaratValue"/>
                        <DataGridTextColumn Header="سعر المثقال" Binding="{Binding PricePerMithqal, StringFormat=N2}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PricePerMithqal"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Currency"/>
                        <DataGridTextColumn Header="سعر الغرام" Binding="{Binding PricePerGram, StringFormat=N2}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PricePerGram"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="120" MinWidth="120"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeletePriceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- ═══ Add/Edit Dialog ═══ -->
        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="420" MaxWidth="480">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <ComboBox ItemsSource="{Binding Karats}"
                                  SelectedValue="{Binding EditKaratValue}"
                                  SelectedValuePath="KaratValue"
                                  DisplayMemberPath="Name"
                                  md:HintAssist.Hint="العيار"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                        <TextBox Text="{Binding EditPricePerMithqal, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="سعر المثقال"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                        <ComboBox ItemsSource="{Binding Currencies}"
                                  SelectedItem="{Binding EditCurrency}"
                                  md:HintAssist.Hint="العملة"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>

                        <DatePicker SelectedDate="{Binding EditPriceDate}"
                                    md:HintAssist.Hint="التاريخ"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,12"/>

                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="ملاحظات"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding DialogError}" Foreground="#D32F2F" Margin="0,0,0,8"
                                   Visibility="{Binding DialogError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Content="حفظ" Command="{Binding SavePriceCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
