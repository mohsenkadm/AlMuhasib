<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldCashBoxMovementReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             d:DataContext="{d:DesignInstance vm:GoldCashBoxMovementReportViewModel, IsDesignTimeCreatable=False}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="حركة القاصات" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي الوارد" TextValue="{Binding TotalIn}"
                                               Icon="CashPlus" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي الصادر" TextValue="{Binding TotalOut}"
                                               Icon="CashMinus" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="الصافي" TextValue="{Binding Net}"
                                               Icon="SwapHorizontal" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding CashBoxes}" SelectedValue="{Binding SelectedCashBoxId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="القاصة"
                                  Width="180" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="حركة القاصات"
                                             TargetDataGrid="{Binding ElementName=CashMovementGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="CashMovementGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                          AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                          Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=\{0:yyyy/MM/dd\}}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding MovementType}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="MovementType"/>
                        <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Reference"/>
                        <DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}" Width="140"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PartyName"/>
                        <DataGridTextColumn Header="القاصة" Binding="{Binding CashBoxName}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CashBoxName"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Currency"/>
                        <DataGridTextColumn Header="وارد" Binding="{Binding AmountIn, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AmountIn"/>
                        <DataGridTextColumn Header="صادر" Binding="{Binding AmountOut, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AmountOut"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
