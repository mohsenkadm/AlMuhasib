<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldSupplierPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Grid.ColumnSpan="2"
                 Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="تسديد الموردين" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBox Width="260" Margin="0,0,12,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="بحث"
                             Style="{StaticResource FilledTextBox}"/>
                    <Button Content="بحث" Command="{Binding SearchCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Grid.Column="0"
                 Padding="0" Margin="0,0,12,0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="الفواتير المفتوحة"
                                             TargetDataGrid="{Binding ElementName=GoldSupplierPaymentGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldSupplierPaymentGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding OpenInvoices}"
                          SelectedItem="{Binding SelectedInvoice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceNumber"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceDate"/>
                        <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SupplierName"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding PaymentCurrency}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentCurrency"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Grid.Column="1"
                 Padding="20" md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="تسجيل دفعة" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber, FallbackValue='—'}" FontFamily="Consolas" FontSize="14" Margin="0,0,0,12"/>
                <DatePicker SelectedDate="{Binding PaymentDate}" md:HintAssist.Hint="تاريخ الدفع"
                            md:HintAssist.IsFloating="True" Style="{StaticResource FilledDatePicker}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="مبلغ الدفعة" md:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding Currencies}" SelectedValue="{Binding PaymentCurrency}"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          md:HintAssist.Hint="العملة" md:HintAssist.IsFloating="True"
                          Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                         md:HintAssist.Hint="سعر الصرف" md:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                <ComboBox ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding SelectedCashBox}"
                          DisplayMemberPath="Name" md:HintAssist.Hint="القاصة"
                          md:HintAssist.IsFloating="True" Style="{StaticResource FilledComboBox}" Margin="0,0,0,12"/>
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="ملاحظات" md:HintAssist.IsFloating="True"
                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                <Button Content="تسجيل التسديد" Command="{Binding RecordPaymentCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        md:ButtonAssist.CornerRadius="8" HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Message}" Foreground="#2E7D32" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </md:Card>

        <Border Grid.ColumnSpan="2" Grid.RowSpan="2" Background="#88000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Panel.ZIndex="50">
            <ProgressBar IsIndeterminate="True" Width="180" Height="6" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
