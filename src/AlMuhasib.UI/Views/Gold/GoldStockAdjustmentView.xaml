<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldStockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">
            <md:Card Padding="0" Margin="0,0,0,16" UniformCornerRadius="16"
                     BorderBrush="#D4AF37" BorderThickness="1" md:ElevationAssist.Elevation="Dp3">
                <Grid>
                    <Border CornerRadius="16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B6914" Offset="0"/>
                                <GradientStop Color="#B8860B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="22,18">
                        <TextBlock Text="تسوية مخزون الذهب" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="أدخل فرق الوزن بالموجب للزيادة والسالب للنقصان" FontSize="13"
                                   Foreground="#FFF8E1" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </md:Card>

            <md:Card Padding="24" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1"
                     md:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentBalanceText}" FontSize="13" Foreground="#8B6914"
                               Background="#FFF8E1" Padding="12,8" Margin="0,0,0,16"/>

                    <ComboBox ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name"
                              md:HintAssist.Hint="المخزن"
                              Style="{StaticResource FilledComboBox}"
                              Margin="0,0,0,14"/>

                    <ComboBox ItemsSource="{Binding Karats}"
                              SelectedValue="{Binding KaratValue}"
                              SelectedValuePath="KaratValue"
                              DisplayMemberPath="Name"
                              md:HintAssist.Hint="العيار"
                              Style="{StaticResource FilledComboBox}"
                              Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GramsDelta, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="فرق الوزن بالغرام (+/-)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="قراءة الميزان" Command="{Binding ReadScaleCommand}"
                                Style="{StaticResource OutlinedButton}" Height="40" Padding="14,0"
                                ToolTip="قراءة الوزن من الميزان الإلكتروني"/>
                    </Grid>

                    <Border Padding="10,6" CornerRadius="8" Background="#FFF8E1" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#C62828"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsScaleConnected}" Value="True">
                                                <Setter Property="Fill" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12" Foreground="#8B6914" VerticalAlignment="Center">
                                <Run Text="الميزان:"/>
                                <Run Text="{Binding ScaleStatusText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBox Text="{Binding CostPerGram, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             md:HintAssist.Hint="تكلفة الغرام (اختياري)"
                             Style="{StaticResource FilledTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="ملاحظات"
                             Style="{StaticResource FilledTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="{Binding FormError}" Foreground="#D32F2F" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تنفيذ التسوية" Command="{Binding SubmitCommand}"
                                Style="{StaticResource PrimaryButton}" Height="40" Padding="24,0" Margin="0,0,10,0"
                                IsEnabled="{Binding CanAdd}"/>
                        <Button Content="مسح" Command="{Binding ResetFormCommand}" Style="{StaticResource FlatButton}" Height="40"/>
                    </StackPanel>
                </StackPanel>
            </md:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
