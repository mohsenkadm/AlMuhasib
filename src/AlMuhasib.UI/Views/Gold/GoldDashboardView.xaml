<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="GoldQuickAction" TargetType="Button">
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFF8E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <md:Card x:Name="Card" UniformCornerRadius="14" Padding="14,12"
                                 md:ElevationAssist.Elevation="Dp2"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="#E8D5A3" BorderThickness="1"
                                 RenderTransformOrigin="0.5,0.5">
                            <md:Card.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </md:Card.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </md:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="md:ElevationAssist.Elevation" Value="Dp6"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.03" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.03" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تحميل لوحة الذهب..." Margin="0,16,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Hero -->
                <md:Card UniformCornerRadius="18" Padding="0" Margin="0,0,0,18"
                         md:ElevationAssist.Elevation="Dp3" BorderBrush="#D4AF37" BorderThickness="1">
                    <Grid MinHeight="120">
                        <Border CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B6914" Offset="0"/>
                                    <GradientStop Color="#B8860B" Offset="0.5"/>
                                    <GradientStop Color="#D4AF37" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <md:PackIcon Kind="Gold" Width="28" Height="28" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="المحاسب — محل الذهب" Margin="10,0,0,0"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#FFF8E1"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding WelcomeText}" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SubtitleText}" Margin="0,6,0,0" FontSize="13" Foreground="#FFFDE7" Opacity="0.92"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding LoadDataCommand}"
                                    Style="{StaticResource FlatButton}" Foreground="White"
                                    VerticalAlignment="Top" ToolTip="تحديث">
                                <md:PackIcon Kind="Refresh" Width="22" Height="22" Foreground="White"/>
                            </Button>
                        </Grid>
                    </Grid>
                </md:Card>

                <!-- Quick actions -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenSaleCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="CashRegister" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="بيع" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="فاتورة بيع ذهب" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenPurchaseCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="CartArrowDown" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="شراء" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="فاتورة شراء" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenMithqalPricesCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="CurrencyUsd" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="أسعار المثقال" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="تحديث التسعير" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenCollectionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="CashCheck" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="تحصيل" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="تحصيل الآجل" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- KPI cards -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <controls:DashboardKpiCard Margin="0,0,10,0"
                                              Title="مبيعات اليوم"
                                              Value="{Binding TodaySalesDisplay}"
                                              Icon="TrendingUp"
                                              AccentBrush="#B8860B"
                                              AccentLightBrush="#FFF8E1"
                                              ValueBrush="#5D4037"/>
                    <controls:DashboardKpiCard Margin="0,0,10,0"
                                              Title="رصيد القاصة"
                                              Value="{Binding CashBalanceDisplay}"
                                              Icon="Cash"
                                              AccentBrush="#D4AF37"
                                              AccentLightBrush="#FFFDE7"
                                              ValueBrush="#5D4037"/>
                    <controls:DashboardKpiCard Margin="0,0,10,0"
                                              Title="المخزون"
                                              Value="{Binding StockDisplay}"
                                              Icon="Gold"
                                              AccentBrush="#8B6914"
                                              AccentLightBrush="#FFF8E1"
                                              ValueBrush="#5D4037"/>
                    <controls:DashboardKpiCard Title="الآجل المفتوح"
                                               Value="{Binding CreditDisplay}"
                                               Icon="CreditCardClock"
                                               AccentBrush="#A67C00"
                                               AccentLightBrush="#FFF3CD"
                                               ValueBrush="#5D4037"/>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,0,0,18">
                    <md:Card Padding="16" Margin="0,0,10,0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="سعر الصرف" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock Text="{Binding FxRateDisplay}" FontSize="22" FontWeight="Bold" Foreground="#B8860B" Margin="0,4,0,0"/>
                            <TextBlock Text="دولار → دينار" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Padding="16" Margin="0,0,10,0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="مخزون منخفض" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock Text="{Binding LowStockKaratCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                            <TextBlock Text="عيارات تحت الحد" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Padding="16" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="أسعار اليوم" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock FontSize="18" FontWeight="Bold" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="لم تُحدَّث"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PricesUpdatedToday}" Value="True">
                                                <Setter Property="Text" Value="محدّثة ✓"/>
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="مثقال حسب العيار" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                </UniformGrid>

                <!-- Charts + Alerts -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <md:Card Grid.Column="0" Padding="16" Margin="0,0,10,0" UniformCornerRadius="14"
                             BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المخزون حسب العيار" FontWeight="Bold" Foreground="#5D4037" Margin="0,0,0,8"/>
                            <lvc:PieChart Series="{Binding StockSeries}" Height="240" LegendPosition="Bottom"/>
                        </StackPanel>
                    </md:Card>

                    <md:Card Grid.Column="1" Padding="16" Margin="0,0,10,0" UniformCornerRadius="14"
                             BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="مبيعات حديثة (مؤشر)" FontWeight="Bold" Foreground="#5D4037" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding SalesSeries}"
                                                XAxes="{Binding SalesXAxes}"
                                                YAxes="{Binding SalesYAxes}"
                                                Height="240"/>
                        </StackPanel>
                    </md:Card>

                    <md:Card Grid.Column="2" Padding="16" UniformCornerRadius="14"
                             BorderBrush="#E8D5A3" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="التنبيهات" FontWeight="Bold"
                                       Foreground="#5D4037" Margin="0,0,0,10"/>
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="10"
                                                    Background="#FFF8E1" BorderBrush="#E8D5A3" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#8B6914"/>
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="#6D4C41" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </md:Card>
                </Grid>

                <!-- Recent invoices -->
                <md:Card Padding="0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1"
                         md:ElevationAssist.Elevation="Dp2">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#B8860B" Padding="16,12" CornerRadius="14,14,0,0">
                            <TextBlock Text="أحدث الفواتير" FontWeight="Bold" Foreground="White" FontSize="15"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding RecentInvoices}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="280" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرقم" Binding="{Binding InvoiceNumber}" Width="110"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding InvoiceType}" Width="80"/>
                                <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="الوزن (غ)" Binding="{Binding TotalWeightGrams, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="المبلغ د.ع" Binding="{Binding TotalAmountIqd, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </md:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
