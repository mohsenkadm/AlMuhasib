<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:TaskPriorityToBrushConverter x:Key="TaskPriorityBrush"/>
        <converters:TaskPriorityToLightBrushConverter x:Key="TaskPriorityLightBrush"/>

        <Style x:Key="GoldQuickAction" TargetType="Button">
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FFF8E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <md:Card x:Name="Card" UniformCornerRadius="14" Padding="14,12"
                                 md:ElevationAssist.Elevation="Dp2"
                                 Background="{TemplateBinding Background}"
                                 BorderBrush="#E8D5A3" BorderThickness="1"
                                 RenderTransformOrigin="0.5,0.5">
                            <md:Card.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </md:Card.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </md:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="md:ElevationAssist.Elevation" Value="Dp6"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.03" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.03" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.16"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GoldTaskButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تحميل لوحة الذهب..." Margin="0,16,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <!-- Hero -->
                <md:Card UniformCornerRadius="18" Padding="0" Margin="0,0,0,18"
                         md:ElevationAssist.Elevation="Dp3" BorderBrush="#D4AF37" BorderThickness="1">
                    <Grid MinHeight="120">
                        <Border CornerRadius="18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B6914" Offset="0"/>
                                    <GradientStop Color="#B8860B" Offset="0.5"/>
                                    <GradientStop Color="#D4AF37" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Margin="24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <md:PackIcon Kind="Gold" Width="28" Height="28" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="المحاسب — محل الذهب" Margin="10,0,0,0"
                                               FontSize="14" FontWeight="SemiBold" Foreground="#FFF8E1"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding WelcomeText}" FontSize="26" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding SubtitleText}" Margin="0,6,0,0" FontSize="13" Foreground="#FFFDE7" Opacity="0.92"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Border Background="#33FFFFFF" CornerRadius="14" Padding="14,10" Margin="0,0,0,8"
                                        BorderBrush="#55FFFFFF" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="ClipboardList" Width="18" Height="18"
                                                     Foreground="White" VerticalAlignment="Center"/>
                                        <StackPanel Margin="10,0,0,0">
                                            <TextBlock Text="مهام اليوم" FontSize="11" Foreground="#FFF8E1"/>
                                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="White">
                                                <Run Text="{Binding DailyTaskCount, Mode=OneWay}"/>
                                                <Run Text=" مهمة" FontSize="12" FontWeight="Normal"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Button Command="{Binding LoadDataCommand}"
                                        Style="{StaticResource FlatButton}" Foreground="White"
                                        HorizontalAlignment="Left" ToolTip="تحديث">
                                    <md:PackIcon Kind="Refresh" Width="22" Height="22" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </md:Card>

                <!-- Quick actions: تبديل / مصروف / نقل / بيع -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenExchangeCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="SwapHorizontal" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="تبديل ذهب" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="فتح فاتورة تبديل" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenExpenseCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="CashMinus" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="مصروف جديد" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="تسجيل مصروف" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenWarehouseTransferCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="TruckDelivery" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="نقل مخزني" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="نقل بين المخازن" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldQuickAction}" Command="{Binding OpenSaleCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#FFF3CD">
                                <md:PackIcon Kind="CashRegister" Width="24" Height="24" Foreground="#B8860B"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="فاتورة بيع" FontWeight="Bold" FontSize="15" Foreground="#5D4037"/>
                                <TextBlock Text="بيع ذهب" FontSize="11" Foreground="#8D6E63"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- KPI cards -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <controls:DashboardKpiCard Margin="0,0,10,0"
                                              Title="مبيعات اليوم"
                                              Value="{Binding TodaySalesDisplay}"
                                              Icon="TrendingUp"
                                              AccentBrush="#B8860B"
                                              AccentLightBrush="#FFF8E1"
                                              ValueBrush="#5D4037"/>
                    <controls:DashboardKpiCard Margin="0,0,10,0"
                                              Title="مصروفات اليوم"
                                              Value="{Binding TodayExpensesDisplay}"
                                              Icon="CashMinus"
                                              AccentBrush="#C9A227"
                                              AccentLightBrush="#FFFDE7"
                                              ValueBrush="#5D4037"/>
                    <controls:DashboardKpiCard Margin="0,0,10,0"
                                              Title="رصيد القاصة"
                                              Value="{Binding CashBalanceDisplay}"
                                              Icon="Cash"
                                              AccentBrush="#D4AF37"
                                              AccentLightBrush="#FFFDE7"
                                              ValueBrush="#5D4037"/>
                    <controls:DashboardKpiCard Title="المخزون"
                                               Value="{Binding StockDisplay}"
                                               Icon="Gold"
                                               AccentBrush="#8B6914"
                                               AccentLightBrush="#FFF8E1"
                                               ValueBrush="#5D4037"/>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <md:Card Padding="16" Margin="0,0,10,0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="الآجل المفتوح" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock Text="{Binding CreditDisplay}" FontSize="16" FontWeight="Bold" Foreground="#5D4037" Margin="0,4,0,0"/>
                            <TextBlock Text="ذمم الزبائن" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Padding="16" Margin="0,0,10,0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="سعر الصرف" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock Text="{Binding FxRateDisplay}" FontSize="22" FontWeight="Bold" Foreground="#B8860B" Margin="0,4,0,0"/>
                            <TextBlock Text="دولار → دينار" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Padding="16" Margin="0,0,10,0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="مخزون عيارات منخفض" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock Text="{Binding LowStockKaratCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                            <TextBlock Text="عيارات تحت الحد" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                    <md:Card Padding="16" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="مخازن منخفضة" Foreground="#8D6E63" FontSize="12"/>
                            <TextBlock Text="{Binding LowWarehouseStockCount}" FontSize="22" FontWeight="Bold" Foreground="#C62828" Margin="0,4,0,0"/>
                            <TextBlock Text="مخازن تحتاج مراجعة" FontSize="11" Foreground="#A1887F"/>
                        </StackPanel>
                    </md:Card>
                </UniformGrid>

                <!-- Daily tasks + Smart alerts (Accounting layout) -->
                <md:Card Padding="16" Margin="0,0,0,18" UniformCornerRadius="14"
                         BorderBrush="#E8D5A3" BorderThickness="1" md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#FFFBF0" CornerRadius="16" Padding="18,16"
                                BorderBrush="#E8D5A3" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#FFF3CD" Margin="0,0,12,0">
                                        <md:PackIcon Kind="ClipboardList" Width="22" Height="22" Foreground="#B8860B"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="#5D4037">
                                            <Run Text="مهام اليوم"/>
                                            <Run Text=" (" Foreground="#A1887F"/>
                                            <Run Text="{Binding DailyTaskCount, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=")" Foreground="#A1887F"/>
                                        </TextBlock>
                                        <TextBlock Text="إنجاز المهام العاجلة يحافظ على تدفق العمل"
                                                   FontSize="11" Foreground="#8D6E63" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DailyTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GoldTaskButton}"
                                                    Command="{Binding DataContext.ExecuteDailyTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="#FFFFFF" CornerRadius="14" Padding="14,12"
                                                        BorderBrush="#E8D5A3" BorderThickness="1" MinHeight="64">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0"
                                                                Background="{Binding Priority, Converter={StaticResource TaskPriorityLightBrush}}">
                                                            <TextBlock Text="{Binding Priority}" FontWeight="Bold" FontSize="16"
                                                                       Foreground="{Binding Priority, Converter={StaticResource TaskPriorityBrush}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                                       Foreground="#5D4037"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                                       Foreground="#8D6E63" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#FFF3CD"
                                                                CornerRadius="10" Padding="8,6" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="تنفيذ" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="#B8860B" VerticalAlignment="Center"/>
                                                                <md:PackIcon Kind="ChevronLeft" Foreground="#B8860B"
                                                                             Width="16" Height="16" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#E8F5E9" CornerRadius="12" Padding="14,12" Margin="0,10,0,0"
                                        BorderBrush="#A5D6A7" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <md:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                                     Foreground="#2E7D32" VerticalAlignment="Center"/>
                                        <TextBlock Text="لا توجد مهام عاجلة اليوم — عمل رائع!"
                                                   FontSize="12" Foreground="#2E7D32"
                                                   Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DailyTaskCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="#FFF8E1" CornerRadius="16" Padding="18,16"
                                BorderBrush="#E8D5A3" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#FFECB3" Margin="0,0,12,0">
                                        <md:PackIcon Kind="BellRing" Width="22" Height="22" Foreground="#C62828"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="#5D4037">
                                            <Run Text="تنبيهات ذكية"/>
                                            <Run Text=" (" Foreground="#A1887F"/>
                                            <Run Text="{Binding SmartAlertCount, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=")" Foreground="#A1887F"/>
                                        </TextBlock>
                                        <TextBlock Text="متابعة فورية للحالات التي تحتاج انتباهك"
                                                   FontSize="11" Foreground="#8D6E63" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Alerts}" MaxHeight="280">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GoldTaskButton}"
                                                    Command="{Binding DataContext.ExecuteAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="#FFFFFF" CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                                        BorderBrush="#E8D5A3" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                                Background="#B8860B" VerticalAlignment="Top" Margin="0,6,10,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="#8B6914"/>
                                                            <TextBlock Text="{Binding Message}" FontSize="12"
                                                                       Foreground="#6D4C41"
                                                                       TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18"/>
                                                        </StackPanel>
                                                        <md:PackIcon Grid.Column="2" Kind="ChevronLeft" Foreground="#BCAAA4"
                                                                     Width="16" Height="16" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="لا توجد تنبيهات حالياً"
                                           FontSize="12" Foreground="#A1887F"
                                           HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmartAlertCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>

                <!-- Charts -->
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <md:Card Grid.Column="0" Padding="16" Margin="0,0,10,0" UniformCornerRadius="14"
                             BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="المخزون حسب العيار" FontWeight="Bold" Foreground="#5D4037" Margin="0,0,0,8"/>
                            <lvc:PieChart Series="{Binding StockSeries}" Height="240" LegendPosition="Bottom"/>
                        </StackPanel>
                    </md:Card>

                    <md:Card Grid.Column="1" Padding="16" UniformCornerRadius="14"
                             BorderBrush="#E8D5A3" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="مبيعات حديثة (مؤشر)" FontWeight="Bold" Foreground="#5D4037" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding SalesSeries}"
                                                XAxes="{Binding SalesXAxes}"
                                                YAxes="{Binding SalesYAxes}"
                                                Height="240"/>
                        </StackPanel>
                    </md:Card>
                </Grid>

                <!-- Recent invoices -->
                <md:Card Padding="0" UniformCornerRadius="14" BorderBrush="#E8D5A3" BorderThickness="1"
                         md:ElevationAssist.Elevation="Dp2">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="#B8860B" Padding="16,12" CornerRadius="14,14,0,0">
                            <TextBlock Text="أحدث الفواتير" FontWeight="Bold" Foreground="White" FontSize="15"/>
                        </Border>
                        <DataGrid ItemsSource="{Binding RecentInvoices}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="280" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الرقم" Binding="{Binding InvoiceNumber}" Width="110"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding InvoiceType}" Width="80"/>
                                <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="الوزن (غ)" Binding="{Binding TotalWeightGrams, StringFormat=N2}" Width="90"/>
                                <DataGridTextColumn Header="المبلغ د.ع" Binding="{Binding TotalAmountIqd, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </md:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
