<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels.Gold"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:GoldDashboardViewModel, IsDesignTimeCreatable=False}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             Background="Transparent"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:TaskPriorityToBrushConverter x:Key="TaskPriorityBrush"/>
        <converters:TaskPriorityToLightBrushConverter x:Key="TaskPriorityLightBrush"/>

        <Color x:Key="GoldPrimaryColor">#B8860B</Color>
        <Color x:Key="GoldAccentColor">#D4AF37</Color>
        <SolidColorBrush x:Key="GoldPrimaryBrush" Color="{StaticResource GoldPrimaryColor}"/>
        <SolidColorBrush x:Key="GoldAccentBrush" Color="{StaticResource GoldAccentColor}"/>

        <Style x:Key="SummaryCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp6"/>
                    <Setter Property="BorderBrush" Value="#E8D5A3"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.02" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.02" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="#E8D5A3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                    <Setter Property="BorderBrush" Value="#D4AF37"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DashboardTaskButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <Style x:Key="DashboardSectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="DashboardIconBadge" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <Storyboard x:Key="SkeletonShimmerStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ShimmerWave"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="-160" To="520" Duration="0:0:1.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="SkeletonRect" TargetType="ContentControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <Border Background="#F0E6C8" CornerRadius="8"/>
                            <Rectangle x:Name="ShimmerWave" Width="120" IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#44FFFFFF" Offset="0.42"/>
                                        <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#44FFFFFF" Offset="0.58"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-160"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource SkeletonShimmerStoryboard}"/>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkeletonRound" TargetType="ContentControl" BasedOn="{StaticResource SkeletonRect}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid ClipToBounds="True">
                            <Ellipse Fill="#F0E6C8"/>
                            <Rectangle x:Name="ShimmerWave" Width="120" IsHitTestVisible="False"
                                       VerticalAlignment="Stretch" RadiusX="8" RadiusY="8">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                                        <GradientStop Color="#44FFFFFF" Offset="0.42"/>
                                        <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#44FFFFFF" Offset="0.58"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-160"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard Storyboard="{StaticResource SkeletonShimmerStoryboard}"/>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardQuickAction" TargetType="Button">
            <Setter Property="Height" Value="92"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <materialDesign:Card x:Name="Card" UniformCornerRadius="16" Padding="16,14"
                                             materialDesign:ElevationAssist.Elevation="Dp0"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="#33FFFFFF" BorderThickness="1"
                                             RenderTransformOrigin="0.5,0.5">
                            <materialDesign:Card.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </materialDesign:Card.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </materialDesign:Card>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="materialDesign:ElevationAssist.Elevation" Value="Dp4"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.03" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.03" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardReveal0" TargetType="FrameworkElement">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="22"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal1" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.08">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.08">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal2" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.16">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal3" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.24">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.24">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DashboardReveal4" TargetType="FrameworkElement" BasedOn="{StaticResource DashboardReveal0}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.45" BeginTime="0:0:0.32">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.45" BeginTime="0:0:0.32">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Ambient gold page background -->
        <Border Background="{DynamicResource BackgroundBrush}" IsHitTestVisible="False"/>
        <Ellipse Width="480" Height="480" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-140,-120,0,0" IsHitTestVisible="False" Opacity="0.5">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#22B8860B" Offset="0"/>
                    <GradientStop Color="#00B8860B" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-80,-100,0" IsHitTestVisible="False" Opacity="0.4">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#1AD4AF37" Offset="0"/>
                    <GradientStop Color="#00D4AF37" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- LOADING SKELETON -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
              Margin="24,20,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="0,0,10,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="5,0,5,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card UniformCornerRadius="16" Padding="22,20" Margin="10,0,0,0"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Width="50" Height="50" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="12" Width="120" Margin="0,12,0,6" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="20" Width="90" HorizontalAlignment="Right"/>
                    </StackPanel>
                </materialDesign:Card>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="180" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="260" Margin="0,14,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRound}" Height="260" Margin="0,14,0,0"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:Card Grid.Column="0" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14"/>
                    </StackPanel>
                </materialDesign:Card>
                <materialDesign:Card Grid.Column="2" UniformCornerRadius="16" Padding="22,18"
                                     materialDesign:ElevationAssist.Elevation="Dp1" Background="{DynamicResource CardBrush}">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="16" Width="140" HorizontalAlignment="Right"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,14,0,6"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14" Margin="0,0,0,6"/>
                        <ContentControl Style="{StaticResource SkeletonRect}" Height="14"/>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>

        <!-- MAIN CONTENT -->
        <ScrollViewer x:Name="DashboardScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer" BasedOn="{StaticResource ThinScrollViewer}">
                    <Setter Property="Opacity" Value="0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid x:Name="DashboardContent" Margin="24,20,16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Expanded gold hero -->
                <materialDesign:Card Grid.Row="0" UniformCornerRadius="24" Padding="0"
                                     Margin="0,0,0,20" ClipToBounds="True"
                                     materialDesign:ElevationAssist.Elevation="Dp4"
                                     BorderThickness="0">
                    <Grid MinHeight="210">
                        <Border CornerRadius="24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B6914" Offset="0"/>
                                    <GradientStop Color="#B8860B" Offset="0.45"/>
                                    <GradientStop Color="#D4AF37" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="-90,-110,0,0" IsHitTestVisible="False" Opacity="0.18" Fill="White"/>
                        <Ellipse Width="220" Height="220" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,-50,-70" IsHitTestVisible="False" Opacity="0.14" Fill="#FFF8E1"/>
                        <Ellipse Width="140" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,20,80,0" IsHitTestVisible="False" Opacity="0.1" Fill="White"/>

                        <Grid Margin="28,26">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Background="#33FFFFFF" CornerRadius="20" Padding="10,4"
                                            HorizontalAlignment="Right" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Gold" Width="16" Height="16"
                                                                     Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock Text="لوحة الذهب" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="White">
                                        <Run Text="{Binding WelcomeGreeting, Mode=OneWay}"/>
                                        <Run Text="، "/>
                                        <Run Text="{Binding UserDisplayName, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SubtitleText}"
                                               FontSize="14" Foreground="#FFF8E1" Margin="0,8,0,0" Opacity="0.95"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16"
                                                                 Foreground="#FFFDE7" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayDate, Mode=OneWay}"
                                                   FontSize="12" Foreground="#FFFDE7"
                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0">
                                    <Border Background="#33FFFFFF" CornerRadius="16"
                                            Padding="16,12" Margin="0,0,0,10" BorderBrush="#55FFFFFF" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="مبيعات اليوم" FontSize="11" Foreground="#FFF8E1"/>
                                            <TextBlock Text="{Binding TodaySalesDisplay}"
                                                       FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#33FFFFFF" CornerRadius="16"
                                            Padding="16,12" BorderBrush="#55FFFFFF" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClipboardList" Width="18" Height="18"
                                                                     Foreground="White" VerticalAlignment="Center"/>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="مهام اليوم" FontSize="11" Foreground="#FFF8E1"/>
                                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="White">
                                                    <Run Text="{Binding DailyTaskCount, Mode=OneWay}"/>
                                                    <Run Text=" مهمة" FontSize="13" FontWeight="Normal"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="إجراءات سريعة" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FFF8E1" Margin="0,22,0,10"/>

                            <!-- Quick actions INSIDE hero: Sale, Purchase, Exchange, Mithqal -->
                            <UniformGrid Grid.Row="2" Columns="4">
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowQuickSale, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenSaleCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#43A047" Offset="0"/>
                                                    <GradientStop Color="#2E7D32" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة بيع" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                            <TextBlock Text="بيع ذهب جديد" FontSize="11" Foreground="#558B2F" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowQuickPurchase, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenPurchaseCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="3,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FB8C00" Offset="0"/>
                                                    <GradientStop Color="#EF6C00" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="CartArrowDown" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="فاتورة شراء" FontWeight="Bold" FontSize="14" Foreground="#E65100"/>
                                            <TextBlock Text="تسجيل مشتريات" FontSize="11" Foreground="#F57C00" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowQuickExchange, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenExchangeCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="3,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#D4AF37" Offset="0"/>
                                                    <GradientStop Color="#B8860B" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="تبديل ذهب" FontWeight="Bold" FontSize="14" Foreground="#5D4037"/>
                                            <TextBlock Text="فتح فاتورة تبديل" FontSize="11" Foreground="#8D6E63" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource DashboardQuickAction}"
                                        Visibility="{Binding ShowQuickMithqal, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding OpenMithqalPricesCommand}"
                                        Background="{DynamicResource DashboardQuickActionBrush}" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="14" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#42A5F5" Offset="0"/>
                                                    <GradientStop Color="#1565C0" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="24" Height="24"
                                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="أسعار المثقال" FontWeight="Bold" FontSize="14" Foreground="#0D47A1"/>
                                            <TextBlock Text="تحديث الأسعار" FontSize="11" Foreground="#1976D2" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- 2. Daily tasks + smart alerts side by side -->
                <materialDesign:Card Grid.Row="1" Style="{StaticResource SectionCard}" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource DashboardTasksPanelBrush}" CornerRadius="16" Padding="18,16"
                                BorderBrush="#E8D5A3" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource DashboardIconBadge}" Background="#FFF3CD">
                                        <materialDesign:PackIcon Kind="ClipboardList" Width="22" Height="22"
                                                                 Foreground="{StaticResource GoldPrimaryBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}">
                                            <Run Text="مهام اليوم"/>
                                            <Run Text=" (" Foreground="{DynamicResource HintForegroundBrush}"/>
                                            <Run Text="{Binding DailyTaskCount, Mode=OneWay}" FontWeight="Bold"/>
                                            <Run Text=")" Foreground="{DynamicResource HintForegroundBrush}"/>
                                        </TextBlock>
                                        <TextBlock Text="إنجاز المهام العاجلة يحافظ على تدفق العمل"
                                                   FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DailyTasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DashboardTaskButton}"
                                                    Command="{Binding DataContext.ExecuteDailyTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{DynamicResource DashboardItemBrush}" CornerRadius="14" Padding="14,12"
                                                        BorderBrush="#E8D5A3" BorderThickness="1" MinHeight="64">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12" Margin="0,0,12,0"
                                                                Background="{Binding Priority, Converter={StaticResource TaskPriorityLightBrush}}">
                                                            <TextBlock Text="{Binding Priority}" FontWeight="Bold" FontSize="16"
                                                                       Foreground="{Binding Priority, Converter={StaticResource TaskPriorityBrush}}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#FFF3CD"
                                                                CornerRadius="10" Padding="8,6" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="تنفيذ" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource GoldPrimaryBrush}" VerticalAlignment="Center"/>
                                                                <materialDesign:PackIcon Kind="ChevronLeft" Foreground="{StaticResource GoldPrimaryBrush}"
                                                                                         Width="16" Height="16" Margin="4,0,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource DashboardSuccessPanelBrush}" CornerRadius="12" Padding="14,12" Margin="0,10,0,0"
                                        BorderBrush="{DynamicResource DashboardSuccessPanelBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                                                 Foreground="{DynamicResource DashboardSuccessForegroundBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="لا توجد مهام عاجلة اليوم — عمل رائع!"
                                                   FontSize="12" Foreground="{DynamicResource DashboardSuccessForegroundBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DailyTaskCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{DynamicResource DashboardAlertsPanelBrush}" CornerRadius="16" Padding="18,16"
                                BorderBrush="#E8D5A3" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Style="{StaticResource DashboardIconBadge}" Background="{DynamicResource DashboardIconBadgeRedBrush}">
                                        <materialDesign:PackIcon Kind="BellRing" Width="22" Height="22"
                                                                 Foreground="{DynamicResource DashboardKpiRedBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="تنبيهات ذكية" FontWeight="Bold" FontSize="15"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="متابعة فورية للحالات التي تحتاج انتباهك"
                                                   FontSize="11" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Alerts}" MaxHeight="260">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource DashboardTaskButton}"
                                                    Command="{Binding DataContext.ExecuteAlertCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{DynamicResource DashboardItemBrush}" CornerRadius="12" Padding="14,12" Margin="0,0,0,8"
                                                        BorderBrush="{DynamicResource DashboardAlertItemBorderBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                                Background="{StaticResource GoldPrimaryBrush}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                                       Foreground="{StaticResource GoldPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding Message}" FontSize="12"
                                                                       Foreground="{DynamicResource DashboardAlertBodyBrush}"
                                                                       TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18"/>
                                                        </StackPanel>
                                                        <materialDesign:PackIcon Grid.Column="2" Kind="ChevronLeft"
                                                                                 Foreground="{DynamicResource HintForegroundBrush}"
                                                                                 Width="16" Height="16" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="لا توجد تنبيهات حالياً"
                                           FontSize="12" Foreground="{DynamicResource HintForegroundBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SmartAlertCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- 3a. KPI row 1: sales, purchases, expenses, cash -->
                <Grid Grid.Row="2" Margin="0,0,0,16" Style="{StaticResource DashboardReveal0}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               HorizontalAlignment="Stretch"
                                               Title="مبيعات اليوم"
                                               Value="{Binding TodaySalesDisplay}"
                                               Icon="CashRegister"
                                               AccentBrush="{StaticResource GoldPrimaryBrush}"
                                               AccentLightBrush="#FFF8E1"
                                               ValueBrush="#5D4037"/>

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Title="مشتريات اليوم"
                                               Value="{Binding TodayPurchasesDisplay}"
                                               Icon="CartArrowDown"
                                               AccentBrush="{DynamicResource DashboardKpiOrangeBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiOrangeBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="2" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Title="مصروفات اليوم"
                                               Value="{Binding TodayExpensesDisplay}"
                                               Icon="CashMinus"
                                               AccentBrush="{DynamicResource DashboardKpiRedBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiRedLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiRedBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="3" Margin="8,0,0,0"
                                               HorizontalAlignment="Stretch"
                                               Title="رصيد القاصة (د.ع / $)"
                                               Value="{Binding CashBalanceDisplay}"
                                               Icon="Cash"
                                               AccentBrush="{DynamicResource DashboardKpiTealBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiTealLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiTealBrush}"/>
                </Grid>

                <!-- 3b. KPI row 2: stock grams, credit, overdue, FX -->
                <Grid Grid.Row="3" Margin="0,0,0,16" Style="{StaticResource DashboardReveal1}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               HorizontalAlignment="Stretch"
                                               Title="المخزون (غرام)"
                                               Value="{Binding StockGramsDisplay}"
                                               Icon="Gold"
                                               AccentBrush="{StaticResource GoldAccentBrush}"
                                               AccentLightBrush="#FFFDE7"
                                               ValueBrush="#5D4037"/>

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Title="الآجل المفتوح"
                                               Value="{Binding CreditDisplay}"
                                               Icon="AccountCash"
                                               AccentBrush="{DynamicResource DashboardKpiPinkBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiPinkLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiPinkBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="2" Margin="4,0,4,0"
                                               HorizontalAlignment="Stretch"
                                               Title="آجل متأخر"
                                               Value="{Binding OverdueDisplay}"
                                               Icon="AlertCircleOutline"
                                               AccentBrush="{DynamicResource DashboardKpiRedBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiRedLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiRedBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="3" Margin="8,0,0,0"
                                               HorizontalAlignment="Stretch"
                                               Title="سعر الصرف"
                                               Value="{Binding FxRateDisplay}"
                                               Icon="CashMultiple"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}"/>
                </Grid>

                <!-- 4. Charts 2:1 — 30-day sales + karat pie -->
                <Grid Grid.Row="4" Margin="0,0,0,16" Style="{StaticResource DashboardReveal2}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource DashboardSectionHeaderPanel}">
                                <Border Style="{StaticResource DashboardIconBadge}" Background="#FFF3CD">
                                    <materialDesign:PackIcon Kind="ChartAreaspline" Width="22" Height="22"
                                                             Foreground="{StaticResource GoldPrimaryBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="مبيعات آخر 30 يوم" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="اتجاه الإيرادات اليومية (د.ع)" FontSize="11"
                                               Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource DashboardChartWellBrush}" CornerRadius="14" Padding="8"
                                    BorderBrush="{DynamicResource DashboardChartWellBorderBrush}" BorderThickness="1" FlowDirection="LeftToRight">
                                <lvc:CartesianChart Series="{Binding SalesSeries}"
                                                    XAxes="{Binding SalesXAxes}"
                                                    YAxes="{Binding SalesYAxes}"
                                                    TooltipPosition="Top"
                                                    MinHeight="260"
                                                    AnimationsSpeed="00:00:00.500"/>
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Style="{StaticResource DashboardSectionHeaderPanel}">
                                <Border Style="{StaticResource DashboardIconBadge}" Background="#FFFDE7">
                                    <materialDesign:PackIcon Kind="ChartPie" Width="22" Height="22"
                                                             Foreground="{StaticResource GoldAccentBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="توزيع المخزون بالعيار" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="حصة كل عيار من إجمالي الغرامات" FontSize="11"
                                               Foreground="{DynamicResource HintForegroundBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource DashboardChartWellBrush}" CornerRadius="14" Padding="8"
                                    BorderBrush="{DynamicResource DashboardChartWellBorderBrush}" BorderThickness="1" FlowDirection="LeftToRight">
                                <lvc:PieChart Series="{Binding StockSeries}"
                                              LegendPosition="Bottom"
                                              MinHeight="260"
                                              AnimationsSpeed="00:00:00.500"/>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- 5. Two tables: recent invoices + latest mithqal prices -->
                <Grid Grid.Row="5" Margin="0,0,0,16" Style="{StaticResource DashboardReveal3}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource GoldPrimaryBrush}"/>
                                <TextBlock Text="أحدث الفواتير"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding RecentInvoices}"
                                      Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم" Binding="{Binding InvoiceNumber}" Width="100"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="95"/>
                                    <DataGridTextColumn Header="النوع" Binding="{Binding InvoiceType}" Width="70"/>
                                    <DataGridTextColumn Header="الزبون" Binding="{Binding CustomerName}" Width="*"/>
                                    <DataGridTextColumn Header="المبلغ د.ع" Binding="{Binding TotalAmountIqd, StringFormat=N0}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldPrimaryBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Style="{StaticResource SectionCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <materialDesign:PackIcon Kind="CurrencyUsd"
                                                         Width="22" Height="22"
                                                         VerticalAlignment="Center"
                                                         Foreground="{StaticResource GoldAccentBrush}"/>
                                <TextBlock Text="أحدث أسعار المثقال"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding LatestPrices}"
                                      Style="{StaticResource ModernDataGrid}"
                                      IsReadOnly="True"
                                      AutoGenerateColumns="False"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="العيار" Binding="{Binding KaratName}" Width="*"/>
                                    <DataGridTextColumn Header="السعر" Binding="{Binding PricePerMithqal, StringFormat=N0}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{StaticResource GoldAccentBrush}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="العملة" Binding="{Binding Currency}" Width="70"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding PriceDate, StringFormat=yyyy/MM/dd}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </materialDesign:Card>
                </Grid>

                <!-- 6. Bottom: cash boxes + inventory value + FX strip -->
                <Grid Grid.Row="6" Style="{StaticResource DashboardReveal4}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Title="القاصات"
                                               Value="{Binding CashBalanceDisplay}"
                                               Icon="SafeSquareOutline"
                                               AccentBrush="{DynamicResource DashboardKpiTealBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiTealLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiTealBrush}">
                        <ItemsControl ItemsSource="{Binding CashBoxes}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding Name}"/>
                                                <Run Text=" ("/>
                                                <Run Text="{Binding CurrencyLabel}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding BalanceDisplay}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DashboardKpiTealBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:DashboardKpiCard>

                    <controls:DashboardKpiCard Grid.Column="2"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Title="قيمة المخزون"
                                               Value="{Binding InventoryValueDisplay}"
                                               Icon="Warehouse"
                                               AccentBrush="{StaticResource GoldPrimaryBrush}"
                                               AccentLightBrush="#FFF8E1"
                                               ValueBrush="#5D4037"/>

                    <controls:DashboardKpiCard Grid.Column="4"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Stretch"
                                               Title="سعر الصرف (دولار → دينار)"
                                               Value="{Binding FxRateDisplay}"
                                               Icon="CashMultiple"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}"/>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
