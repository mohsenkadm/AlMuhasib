<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldItemsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="أصناف الذهب" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة صنف"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding DownloadImportTemplateCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                            ToolTip="تنزيل قالب Excel لملء بيانات الأصناف">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileDownloadOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="قالب Excel"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ImportFromExcelCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                            ToolTip="استيراد أصناف من ملف Excel"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="استيراد Excel"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding PrintAllLabelsCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="12,8" Margin="0,0,8,0"
                            ToolTip="طباعة ملصقات جماعية للقطع المتوفرة"
                            IsEnabled="{Binding CanPrint}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Barcode" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="ملصقات جماعية"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <TextBox md:HintAssist.Hint="ابحث بالاسم أو الباركود أو التصنيف..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="260" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- ═══ BOTTOM: Data Grid ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة أصناف الذهب"
                                             TargetDataGrid="{Binding ElementName=GoldItemsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="True"/>

                <Grid Grid.Row="1">
                <DataGrid x:Name="GoldItemsGrid"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                        <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Barcode"/>
                        <DataGridTextColumn Header="العيار" Binding="{Binding KaratValue}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="KaratValue"/>
                        <DataGridTextColumn Header="الوزن (غ)" Binding="{Binding WeightGrams, StringFormat=N2}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WeightGrams"/>
                        <DataGridTextColumn Header="أجور الصياغة" Binding="{Binding SuggestedMakingCharge, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SuggestedMakingCharge"/>
                        <DataGridTextColumn Header="تكلفة/غ" Binding="{Binding CostPerGram, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CostPerGram"/>
                        <DataGridTextColumn Header="التصنيف" Binding="{Binding Category}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Category"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status, Converter={StaticResource GoldItemStatusLabelConverter}}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Status"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="160" MinWidth="160"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.PrintLabelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                ToolTip="طباعة ملصق"
                                                IsEnabled="{Binding DataContext.CanPrint, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Margin="0,0,4,0">
                                            <md:PackIcon Kind="Barcode" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Items}"
                                      ItemTemplate="{StaticResource GoldItemCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- ═══ Add/Edit Dialog ═══ -->
        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="460" MaxWidth="520">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الاسم *" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الباركود" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding Karats}" SelectedValue="{Binding EditKaratValue}"
                                  SelectedValuePath="KaratValue" DisplayMemberPath="Name"
                                  md:HintAssist.Hint="العيار" Style="{StaticResource FilledComboBox}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding EditWeight, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الوزن (غرام)" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding EditMakingCharge, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="أجور الصياغة" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding EditCostPerGram, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="التكلفة لكل غرام" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding CategoryNames}"
                                  Text="{Binding EditCategory, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  md:HintAssist.Hint="التصنيف"
                                  Style="{StaticResource FilledComboBox}" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding DialogError}" Foreground="#D32F2F" Margin="0,0,0,8"
                                   Visibility="{Binding DialogError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Content="حفظ" Command="{Binding SaveItemCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- ═══ Delete Confirmation Dialog ═══ -->
        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Margin="0,0,0,16">
                            <Run Text="هل أنت متأكد من حذف الصنف "/>
                            <Run Text="{Binding ItemToDelete.Name, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حذف" Command="{Binding ExecuteDeleteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D32F2F" Foreground="White"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
