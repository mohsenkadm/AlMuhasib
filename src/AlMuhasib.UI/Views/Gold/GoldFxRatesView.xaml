<UserControl x:Class="AlMuhasib.UI.Views.Gold.GoldFxRatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Latest rate summary -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="أسعار الصرف" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding LatestRateDisplay}" FontSize="20" FontWeight="Bold"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}"
                        md:ButtonAssist.CornerRadius="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="تحديث"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <!-- New rate form -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="تسجيل سعر جديد (USD → IQD)" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding NewUsdToIqd, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="سعر الدولار بالدينار"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,10,0"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding NewRateDate}"
                                md:HintAssist.Hint="التاريخ"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="2" Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"
                             md:HintAssist.Hint="ملاحظات"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,10,0"/>
                    <Button Grid.Column="3" Content="حفظ" Command="{Binding SaveRateCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Height="40" Padding="22,0"
                            IsEnabled="{Binding CanAdd}"/>
                </Grid>
            </StackPanel>
        </md:Card>

        <!-- Rates list -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="سجل أسعار الصرف"
                                             TargetDataGrid="{Binding ElementName=GoldFxRatesGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="GoldFxRatesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Rates}"
                          SelectedItem="{Binding SelectedRate}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding RateDate, StringFormat=yyyy/MM/dd}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RateDate"/>
                        <DataGridTextColumn Header="USD → IQD" Binding="{Binding UsdToIqd, StringFormat=N0}" Width="140"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="UsdToIqd"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                        <DataGridTextColumn Header="أُنشئ" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="140"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CreatedAt"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
