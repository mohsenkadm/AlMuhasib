<UserControl x:Class="AlMuhasib.UI.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MaintenanceViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:MaintenanceStatusToArabicConverter x:Key="MaintenanceStatusToArabicConverter"/>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="حفظ" Command="{Binding SaveCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="سجل جديد" Command="{Binding NewRecordCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.Resources>

    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" MaxHeight="520">
            <StackPanel Margin="24,24,24,8">
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1565C0" Offset="0"/>
                            <GradientStop Color="#1E88E5" Offset="0.55"/>
                            <GradientStop Color="#42A5F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="CellphoneCog" Width="28" Height="28"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="صيانة الأجهزة" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="سجل صيانة مرتبط بالزبون والمنتج والسيريال" FontSize="13" Foreground="#E3F2FD" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <materialDesign:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,12,12"
                                 Text="{Binding RecordNumber}" IsReadOnly="True"
                                 Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="رقم السجل"/>
                        <DatePicker Grid.Row="0" Grid.Column="1" Margin="0,0,12,12"
                                    SelectedDate="{Binding Date}"
                                    Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="التاريخ"/>
                        <ComboBox Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedValue="{Binding Status}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="حالة الصيانة"/>

                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding FilteredCustomers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      IsEditable="True"
                                      Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FilledComboBox}"
                                      materialDesign:HintAssist.Hint="الزبون *"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="10,0"
                                    Style="{StaticResource FlatButton}"
                                    Command="{Binding OpenQuickAddCustomerCommand}"
                                    ToolTip="إضافة زبون سريع">
                                <materialDesign:PackIcon Kind="AccountPlus" Width="22" Height="22"/>
                            </Button>
                        </Grid>

                        <ComboBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="القاصة"/>

                        <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,12"
                                  ItemsSource="{Binding FilteredProducts}"
                                  SelectedItem="{Binding SelectedProduct}"
                                  IsEditable="True"
                                  Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="اسم المنتج *"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Margin="0,0,0,12"
                                 Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="Serial Number"/>

                        <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,12,12"
                                 Text="{Binding CostAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="مبلغ تكلفة الصيانة"/>
                        <DatePicker Grid.Row="3" Grid.Column="1" Margin="0,0,12,12"
                                    SelectedDate="{Binding WarrantyEndDate}"
                                    Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="انتهاء الضمان"
                                    Visibility="{Binding ShowWarrantyFields, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Margin="0,0,0,12"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="ملاحظات"/>

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                            <Button Content="حفظ" Command="{Binding SaveCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                            <Button Content="جديد" Command="{Binding NewRecordCommand}"
                                    Style="{StaticResource FlatButton}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FormError}" Foreground="#C62828" VerticalAlignment="Center"
                                       Visibility="{Binding FormError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0" Title="سجلات الصيانة الأخيرة"
                                             TargetDataGrid="{Binding ElementName=MaintGrid}"
                                             ShowCardToggle="False"/>
                <DataGrid x:Name="MaintGrid" Grid.Row="1" ItemsSource="{Binding RecentRecords}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          MouseDoubleClick="MaintGrid_OnMouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding RecordNumber}" Width="100"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"/>
                        <DataGridTextColumn Header="الزبون" Binding="{Binding Customer.Name}" Width="*"/>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="سيريال" Binding="{Binding SerialNumber}" Width="120"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding CostAmount, StringFormat=N0}" Width="100"/>
                        <DataGridTemplateColumn Header="الحالة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource MaintenanceStatusToArabicConverter}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource FlatButton}" Padding="6"
                                                Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="تعديل">
                                            <materialDesign:PackIcon Kind="Pencil" Width="18" Height="18"/>
                                        </Button>
                                        <Button Style="{StaticResource FlatButton}" Padding="6"
                                                Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="حذف">
                                            <materialDesign:PackIcon Kind="Delete" Width="18" Height="18" Foreground="#C62828"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <Grid Visibility="{Binding IsQuickAddCustomerOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="24" MinWidth="420" MaxWidth="500"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="16"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <TextBlock Text="إضافة زبون سريع" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="اسم الزبون *"
                             Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="رقم الهاتف"
                             Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="العنوان"
                             Text="{Binding QuickCustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding QuickCustomerError}" Foreground="#D32F2F" Margin="0,0,0,8"
                               Visibility="{Binding QuickCustomerError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickCustomerCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddCustomerCommand}"
                                Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
