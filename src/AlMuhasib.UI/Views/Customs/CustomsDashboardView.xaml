<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>

        <Style x:Key="SectionCard" TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp1"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="DashboardChartCard" TargetType="materialDesign:Card" BasedOn="{StaticResource SectionCard}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource DashboardChartCardBrush}"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        </Style>

        <Style x:Key="DashboardChartHost" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,4,16,16"/>
            <Setter Property="Margin" Value="4,0,4,4"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>

        <Style x:Key="DashboardChartHeader" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="20,16,20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{DynamicResource BackgroundBrush}"
                Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تحميل لوحة التحكم..." Margin="0,16,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <Grid Margin="24,20,16,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="لوحة التحكم — التخليص الكمركي"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="{Binding PeriodLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource HintForegroundBrush}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource OutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="8"
                            ToolTip="تحديث">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Row 1: customers | invoices | vehicles | unpaid -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               Title="العملاء"
                                               Value="{Binding CustomerCountDisplay}"
                                               Icon="AccountGroup"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               Title="الفواتير"
                                               Value="{Binding InvoiceCountDisplay}"
                                               Icon="FileDocumentOutline"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="2" Margin="4,0,4,0"
                                               Title="إجمالي السيارات"
                                               Value="{Binding VehicleCountDisplay}"
                                               Icon="Car"
                                               AccentBrush="{DynamicResource DashboardKpiTealBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiTealLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiTealBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="3" Margin="8,0,0,0"
                                               Title="غير مسددة"
                                               Value="{Binding UnpaidInvoiceCountDisplay}"
                                               Icon="AlertCircleOutline"
                                               AccentBrush="{DynamicResource DashboardKpiRedBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiRedLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiRedBrush}"/>
                </Grid>

                <!-- Row 2: in progress | exited | arrived -->
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               Title="قيد الإجراء"
                                               Value="{Binding VehiclesInProgressDisplay}"
                                               Icon="ProgressClock"
                                               AccentBrush="{DynamicResource DashboardKpiOrangeBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiOrangeBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               Title="خارجة"
                                               Value="{Binding VehiclesExitedDisplay}"
                                               Icon="TruckDelivery"
                                               AccentBrush="{DynamicResource DashboardKpiPinkBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiPinkLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiPinkBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="2" Margin="8,0,0,0"
                                               Title="واصلة"
                                               Value="{Binding VehiclesArrivedDisplay}"
                                               Icon="CheckCircleOutline"
                                               AccentBrush="{DynamicResource DashboardKpiGreenBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiGreenLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiGreenBrush}"/>
                </Grid>

                <!-- Row 3: receipts | expenses | profit | debts (dual currency) -->
                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <controls:DashboardKpiCard Grid.Column="0" Margin="0,0,8,0"
                                               Title="المقبوضات"
                                               Value="{Binding ReceiptsDisplay}"
                                               Icon="CashPlus"
                                               AccentBrush="{DynamicResource DashboardKpiGreenBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiGreenLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiGreenBrush}"/>

                    <controls:DashboardKpiCard Grid.Column="1" Margin="4,0,4,0"
                                               Title="المصاريف"
                                               Value="{Binding ExpensesDisplay}"
                                               Icon="CashMinus"
                                               AccentBrush="{DynamicResource DashboardKpiOrangeBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiOrangeBrush}"
                                               Visibility="{Binding CanViewExpenses, Converter={StaticResource BoolToVis}}"/>

                    <controls:DashboardKpiCard Grid.Column="2" Margin="4,0,4,0"
                                               Title="الربح الداخلي"
                                               Value="{Binding ProfitDisplay}"
                                               Icon="ChartLine"
                                               AccentBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiBlueLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiBlueBrush}"
                                               Visibility="{Binding CanViewProfit, Converter={StaticResource BoolToVis}}"/>

                    <controls:DashboardKpiCard Grid.Column="3" Margin="8,0,0,0"
                                               Title="الديون"
                                               Value="{Binding DebtsDisplay}"
                                               Icon="AccountCash"
                                               AccentBrush="{DynamicResource DashboardKpiRedBrush}"
                                               AccentLightBrush="{DynamicResource DashboardKpiRedLightBrush}"
                                               ValueBrush="{DynamicResource DashboardKpiRedBrush}"/>
                </Grid>

                <!-- Charts: monthly invoices | vehicle status -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <materialDesign:Card Grid.Column="0" Style="{StaticResource DashboardChartCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1565C0" Offset="0"/>
                                        <GradientStop Color="#42A5F5" Offset="0.55"/>
                                        <GradientStop Color="#90CAF9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource DashboardChartHeader}">
                                <DockPanel LastChildFill="True">
                                    <Border Width="44" Height="44" CornerRadius="14"
                                            Background="{DynamicResource DashboardKpiBlueLightBrush}"
                                            DockPanel.Dock="Right" Margin="12,0,0,0">
                                        <materialDesign:PackIcon Kind="ChartBar" Width="22" Height="22"
                                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="الفواتير الشهرية" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="عدد الفواتير خلال آخر 12 شهرًا"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource HintForegroundBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource DashboardChartHost}">
                                <lvc:CartesianChart Series="{Binding MonthlyInvoiceSeries}"
                                                    XAxes="{Binding MonthlyXAxes}"
                                                    YAxes="{Binding MonthlyYAxes}"
                                                    TooltipPosition="Top"
                                                    LegendPosition="Hidden"
                                                    MinHeight="260"
                                                    AnimationsSpeed="00:00:00.550"/>
                            </Border>
                        </Grid>
                    </materialDesign:Card>

                    <materialDesign:Card Grid.Column="2" Style="{StaticResource DashboardChartCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="300"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00838F" Offset="0"/>
                                        <GradientStop Color="#26A69A" Offset="0.55"/>
                                        <GradientStop Color="#80CBC4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource DashboardChartHeader}">
                                <DockPanel LastChildFill="True">
                                    <Border Width="44" Height="44" CornerRadius="14"
                                            Background="{DynamicResource DashboardKpiTealLightBrush}"
                                            DockPanel.Dock="Right" Margin="12,0,0,0">
                                        <materialDesign:PackIcon Kind="ChartDonut" Width="22" Height="22"
                                                                 Foreground="{DynamicResource DashboardKpiTealBrush}"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="حالة السيارات" Style="{StaticResource SectionHeader}"/>
                                        <TextBlock Text="قيد الإجراء / خارجة / واصلة"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource HintForegroundBrush}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="2" Style="{StaticResource DashboardChartHost}">
                                <lvc:PieChart Series="{Binding VehicleStatusSeries}"
                                              LegendPosition="Bottom"
                                              MinHeight="260"
                                              InitialRotation="-90"
                                              AnimationsSpeed="00:00:00.550"/>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
