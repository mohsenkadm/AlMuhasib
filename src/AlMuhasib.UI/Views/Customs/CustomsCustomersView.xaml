<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsCustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="تحديث" Command="{Binding RefreshCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Refresh" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="إضافة عميل" Command="{Binding OpenAddDialogCommand}">
                <MenuItem.Icon><md:PackIcon Kind="AccountPlus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}">
                <MenuItem.Icon><md:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="طباعة الجدول" Command="{Binding PrintTableCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="إدارة العملاء — التخليص الكمركي" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountPlus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة عميل"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <TextBox md:HintAssist.Hint="بحث بالاسم أو الهاتف أو الشركة..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="240" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة العملاء"
                                             TargetDataGrid="{Binding ElementName=CustomsCustomersGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="CustomsCustomersGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          Sorting="CustomsCustomersGrid_Sorting"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" SortMemberPath="Name" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding CustomerTypeLabel}" Width="90" CanUserSort="False"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerTypeLabel"/>
                        <DataGridTextColumn Header="الشركة" Binding="{Binding CompanyName}" Width="140" CanUserSort="False"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CompanyName"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" SortMemberPath="Phone" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Phone"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="150" CanUserSort="False"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Address"/>
                        <DataGridTextColumn Header="رصيد د.ع" Binding="{Binding BalanceIqd, StringFormat=N0}" SortMemberPath="BalanceIqd" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BalanceIqd"/>
                        <DataGridTextColumn Header="رصيد $" Binding="{Binding BalanceUsd, StringFormat=N2}" SortMemberPath="BalanceUsd" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BalanceUsd"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusLabel}" Width="80" CanUserSort="False"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StatusLabel"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="160" MinWidth="160" CanUserSort="False"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenCustomerFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableViewIconButton}"
                                                ToolTip="فتح ملف العميل">
                                            <md:PackIcon Kind="AccountDetails" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="420" MaxWidth="520">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <ComboBox ItemsSource="{Binding CustomerTypeOptions}"
                                  SelectedValue="{Binding EditCustomerType}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  md:HintAssist.Hint="نوع العميل"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,0,10"/>

                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الاسم *" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>

                        <TextBox Text="{Binding EditCompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="اسم الشركة"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>

                        <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الهاتف" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="العنوان" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="ملاحظات" Style="{StaticResource FilledTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,10"/>
                        <CheckBox Content="عميل نشط" IsChecked="{Binding EditIsActive}" Margin="0,0,0,10"/>

                        <TextBlock Text="{Binding DialogError}" Foreground="#D32F2F" Margin="0,0,0,8"
                                   Visibility="{Binding DialogError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Content="حفظ" Command="{Binding SaveCustomerCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Margin="0,0,0,16">
                            <Run Text="هل أنت متأكد من حذف العميل "/>
                            <Run Text="{Binding CustomerToDelete.Name, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حذف" Command="{Binding ExecuteDeleteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D32F2F" Foreground="White"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- M-02: loading overlay (same pattern as Customs reports) -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                         Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
