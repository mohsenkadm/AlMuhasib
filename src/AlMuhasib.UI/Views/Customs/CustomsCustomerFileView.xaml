<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsCustomerFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Border Visibility="{Binding IsLoaded, Converter={StaticResource InvBoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Value="0" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تحميل ملف العميل..." Margin="0,16,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Padding="24,20,16,24"
                      Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">

                <!-- Hero header -->
                <Border CornerRadius="24" Padding="24,22" Margin="0,0,0,16"
                        BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                        Background="{DynamicResource CardBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="72" Height="72" CornerRadius="36"
                                Background="{DynamicResource DashboardKpiBlueLightBrush}" Margin="0,0,18,0">
                            <materialDesign:PackIcon Kind="Account"
                                                     Width="34" Height="34"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border CornerRadius="12" Padding="10,3" Margin="0,0,10,0" Background="{DynamicResource DashboardKpiBlueLightBrush}">
                                    <TextBlock Text="{Binding CustomerTypeLabel}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                </Border>
                                <Border CornerRadius="12" Padding="10,3" Background="{DynamicResource DashboardKpiGreenLightBrush}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DashboardKpiGreenBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CustomerName}" FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                    <materialDesign:PackIcon Kind="Phone" Width="14" Height="14"
                                                             Foreground="{DynamicResource HintForegroundBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Phone}" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,4">
                                    <materialDesign:PackIcon Kind="MapMarker" Width="14" Height="14"
                                                             Foreground="{DynamicResource HintForegroundBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Address}" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <materialDesign:PackIcon Kind="OfficeBuilding" Width="14" Height="14"
                                                             Foreground="{DynamicResource HintForegroundBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding CompanyName}" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <Button Grid.Column="2" Command="{Binding LoadFileCommand}"
                                Style="{StaticResource OutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8"
                                VerticalAlignment="Top" ToolTip="تحديث">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,6,0"/>
                                <TextBlock Text="تحديث" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Account summary -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <controls:AnimatedStatCard Title="رصيد د.ع" TextValue="{Binding BalanceIqdDisplay}"
                                               Icon="Cash" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="{DynamicResource PrimaryHueMidBrush}"
                                               ValueForeground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,10,0"/>
                    <controls:AnimatedStatCard Title="رصيد $" TextValue="{Binding BalanceUsdDisplay}"
                                               Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiTealLightBrush}"
                                               IconForeground="{DynamicResource DashboardKpiTealBrush}"
                                               ValueForeground="{DynamicResource DashboardKpiTealBrush}" Margin="0,0,10,0"/>
                    <controls:AnimatedStatCard Title="فواتير غير مسددة" TextValue="{Binding UnpaidInvoiceCountDisplay}"
                                               Icon="AlertCircleOutline" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                               IconForeground="{DynamicResource DashboardKpiRedBrush}"
                                               ValueForeground="{DynamicResource DashboardKpiRedBrush}" Margin="0,0,10,0"/>
                    <controls:AnimatedStatCard Title="السيارات" TextValue="{Binding VehicleCountDisplay}"
                                               Icon="Car" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                                               IconForeground="{DynamicResource DashboardKpiOrangeBrush}"
                                               ValueForeground="{DynamicResource DashboardKpiOrangeBrush}"/>
                </UniformGrid>

                <!-- Tabs -->
                <materialDesign:Card UniformCornerRadius="20" Padding="20,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1"
                                     Background="{DynamicResource CardBrush}"
                                     BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <TabControl SelectedIndex="{Binding SelectedTab}"
                                Style="{StaticResource MaterialDesignTabControl}">

                        <!-- Invoices -->
                        <TabItem Header="الفواتير">
                            <DataGrid ItemsSource="{Binding Invoices}" Margin="0,12,0,0"
                                      Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" MaxHeight="420">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الرقم" Binding="{Binding InvoiceNumber}" Width="110"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                    <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceTypeLabel}" Width="120"/>
                                    <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusLabel}" Width="90"/>
                                    <DataGridTemplateColumn Header="فتح" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableViewIconButton}"
                                                        ToolTip="فتح الفاتورة">
                                                    <materialDesign:PackIcon Kind="OpenInNew" Width="16" Height="16"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Vehicles -->
                        <TabItem Header="السيارات والشحنات">
                            <DataGrid ItemsSource="{Binding Vehicles}" Margin="0,12,0,0"
                                      Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" MaxHeight="420">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="الفاتورة" Binding="{Binding InvoiceNumber}" Width="110"/>
                                    <DataGridTextColumn Header="التسلسل" Binding="{Binding SerialNumber}" Width="90"/>
                                    <DataGridTextColumn Header="لوحة عراقية" Binding="{Binding IraqiPlate}" Width="110"/>
                                    <DataGridTextColumn Header="لوحة سورية" Binding="{Binding SyrianPlate}" Width="110"/>
                                    <DataGridTextColumn Header="سائق عراقي" Binding="{Binding IraqiDriver}" Width="110"/>
                                    <DataGridTextColumn Header="الحمولة" Binding="{Binding CargoType}" Width="*"/>
                                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusLabel}" Width="100"/>
                                    <DataGridTextColumn Header="السعر" Binding="{Binding VehiclePrice, StringFormat=N0}" Width="90"/>
                                    <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <!-- Receipts / account -->
                        <TabItem Header="القبض والحسابات">
                            <StackPanel Margin="0,12,0,0">
                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <controls:AnimatedStatCard Title="مدين د.ع" TextValue="{Binding DebitIqdDisplay}"
                                                               Icon="CashPlus" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                                               IconForeground="#C62828" ValueForeground="#C62828" Margin="0,0,8,0"/>
                                    <controls:AnimatedStatCard Title="دائن د.ع" TextValue="{Binding CreditIqdDisplay}"
                                                               Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                               IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                                    <controls:AnimatedStatCard Title="مدين $" TextValue="{Binding DebitUsdDisplay}"
                                                               Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                                               IconForeground="#C62828" ValueForeground="#C62828" Margin="0,0,8,0"/>
                                    <controls:AnimatedStatCard Title="دائن $" TextValue="{Binding CreditUsdDisplay}"
                                                               Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                               IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                                </UniformGrid>
                                <Button Command="{Binding OpenStatementCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Padding="18,8" Margin="0,0,0,12"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="فتح كشف الحساب"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="المقبوضات" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding Receipts}"
                                          Style="{StaticResource ModernDataGrid}" AutoGenerateColumns="False"
                                          IsReadOnly="True" CanUserAddRows="False" MaxHeight="320">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="الرقم" Binding="{Binding ReceiptNumber}" Width="110"/>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding ReceiptDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="110"/>
                                        <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"/>
                                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethodLabel}" Width="110"/>
                                        <DataGridTextColumn Header="المستلم" Binding="{Binding ReceiverName}" Width="*"/>
                                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="140"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </TabItem>

                        <!-- Attachments -->
                        <TabItem Header="المرفقات">
                            <StackPanel Margin="0,12,0,0">
                                <controls:AttachmentsPanel
                                    Title="المرفقات"
                                    SaveFirstHint=""
                                    MaxGridHeight="360"
                                    Items="{Binding Attachments}"
                                    HasSavedOwner="{Binding IsLoaded}"
                                    CanManage="{Binding CanEdit}"
                                    CanDelete="{Binding CanDelete}"
                                    AddCommand="{Binding AddAttachmentCommand}"
                                    OpenCommand="{Binding OpenAttachmentCommand}"
                                    DeleteCommand="{Binding DeleteAttachmentCommand}"/>
                            </StackPanel>
                        </TabItem>

                        <!-- Notes -->
                        <TabItem Header="الملاحظات">
                            <StackPanel Margin="0,12,0,0">
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="ملاحظات العميل"
                                         Style="{StaticResource FilledTextBox}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="160" IsEnabled="{Binding CanEdit}"/>
                                <TextBlock Text="{Binding NotesError}" Foreground="#D32F2F" Margin="0,8,0,0"
                                           Visibility="{Binding NotesError, Converter={StaticResource NullToCollapsedConverter}}"/>
                                <Button Content="حفظ الملاحظات"
                                        Command="{Binding SaveNotesCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="8"
                                        Padding="24,8" Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding CanEdit}"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
