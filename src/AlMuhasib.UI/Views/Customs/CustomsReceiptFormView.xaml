<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsReceiptFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="وصل قبض" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="{DynamicResource DashboardKpiBlueLightBrush}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReceiptNumber}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="حفظ" Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="18,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanSave}"/>
                    <Button Content="طباعة" Command="{Binding PrintCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0"
                            IsEnabled="{Binding HasSavedReceipt}"
                            Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="PDF" Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0"
                            IsEnabled="{Binding HasSavedReceipt}"
                            Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="إلغاء الوصل" Command="{Binding CancelReceiptCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0"
                            Visibility="{Binding CanCancelReceipt, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource FlatButton}"/>
                </StackPanel>
            </DockPanel>
        </md:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding FormError}" Foreground="#D32F2F" Margin="0,0,0,8"
                           Visibility="{Binding FormError, Converter={StaticResource NullToCollapsedConverter}}"/>

                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="بيانات الوصل" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      md:HintAssist.Hint="العميل *"
                                      Style="{StaticResource CustomerSearchableComboBox}"
                                      Margin="0,0,8,10"/>
                            <TextBox Text="{Binding ReceiptNumber}" IsReadOnly="True"
                                     md:HintAssist.Hint="رقم الوصل"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                            <DatePicker SelectedDate="{Binding ReceiptDate}"
                                        md:HintAssist.Hint="التاريخ *"
                                        Style="{StaticResource FilledDatePicker}" Margin="0,0,0,10"/>

                            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                     md:HintAssist.Hint="المبلغ *"
                                     Style="{StaticResource NumericTextBox}" Margin="0,0,8,10"/>
                            <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                      SelectedValue="{Binding Currency}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="العملة *"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                            <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="سعر الصرف (USD→IQD)"
                                     Style="{StaticResource NumericTextBox}" Margin="0,0,0,10"
                                     Visibility="{Binding ShowFxRate, Converter={StaticResource BoolToVis}}"/>

                            <ComboBox ItemsSource="{Binding PaymentMethodOptions}"
                                      SelectedValue="{Binding PaymentMethod}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="طريقة الدفع"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                            <TextBox Text="{Binding ReceiverName, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="المستلم"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="ملاحظات"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>

                <md:Card Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,0,12"
                         md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="توزيع على الفواتير المفتوحة (نفس العملة)"
                                                     TargetDataGrid="{Binding ElementName=AllocationsGrid}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowPrint="False"
                                                     ShowFilter="False">
                            <controls:ListTableHeaderBar.ExtraContent>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AutoAllocateCommand}"
                                            Style="{StaticResource FlatButton}" Foreground="White"
                                            Height="32" Padding="12,0" Margin="0,0,8,0" Content="توزيع تلقائي"/>
                                    <Button Command="{Binding ClearAllocationsCommand}"
                                            Style="{StaticResource FlatButton}" Foreground="White"
                                            Height="32" Padding="12,0" Content="مسح التوزيع"/>
                                </StackPanel>
                            </controls:ListTableHeaderBar.ExtraContent>
                        </controls:ListTableHeaderBar>

                        <DataGrid x:Name="AllocationsGrid" Grid.Row="1"
                                  ItemsSource="{Binding AllocationRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single"
                                  Style="{StaticResource InvoiceItemsDataGrid}"
                                  MaxHeight="280" MinHeight="140" Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="المتبقي المتاح" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="مبلغ التوزيع"
                                                    Binding="{Binding AllocateAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Grid.Row="2" Columns="3" Margin="16,0,16,16">
                            <controls:AnimatedStatCard Title="مبلغ الوصل" TextValue="{Binding Amount, StringFormat=N0}"
                                                       Icon="Cash" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="{DynamicResource PrimaryHueMidBrush}"
                                                       ValueForeground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="مجموع التوزيع" TextValue="{Binding AllocatedSum, StringFormat=N0}"
                                                       Icon="FormatListNumbered" IconBackground="{DynamicResource DashboardKpiTealLightBrush}"
                                                       IconForeground="{DynamicResource DashboardKpiTealBrush}"
                                                       ValueForeground="{DynamicResource DashboardKpiTealBrush}" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="الفرق" TextValue="{Binding AllocationDifference, StringFormat=N0}"
                                                       Icon="SwapHorizontal" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                                                       IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                        </UniformGrid>
                    </Grid>
                </md:Card>

                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <controls:AttachmentsPanel
                        Title="المرفقات"
                        SaveFirstHint="احفظ الوصل أولاً لتفعيل المرفقات"
                        Items="{Binding Attachments}"
                        HasSavedOwner="{Binding HasSavedReceipt}"
                        CanManage="{Binding CanManageAttachments}"
                        CanDelete="{Binding CanDelete}"
                        AddCommand="{Binding AddAttachmentCommand}"
                        OpenCommand="{Binding OpenAttachmentCommand}"
                        DeleteCommand="{Binding DeleteAttachmentCommand}"/>
                </md:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" Padding="12,8" Margin="0,8,0,0"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="بعد الحفظ يُحدَّث تلقائياً: المدفوع · المتبقي · رصيد العميل (بنفس العملة)"/>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
