<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsInvoiceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
             Style="{StaticResource PosPageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/CustomsUiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
            <helpers:BindingProxy x:Key="FormProxy" Data="{Binding}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,12"
                 Panel.ZIndex="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="فاتورة التخليص" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="{DynamicResource DashboardKpiBlueLightBrush}" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </Border>
                </StackPanel>
                <WrapPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource CustomsToolbarPrimaryButton}"
                            IsEnabled="{Binding CanSave}"
                            ToolTip="حفظ الفاتورة كمسودة">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ الفاتورة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveAndApproveCommand}"
                            Style="{StaticResource CustomsToolbarPrimaryButton}" Background="#2E7D32"
                            IsEnabled="{Binding CanSave}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ واعتماد" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="اعتماد" Command="{Binding ApproveCommand}"
                            Style="{StaticResource CustomsToolbarButton}"
                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="إلغاء الفاتورة" Command="{Binding CancelInvoiceCommand}"
                            Style="{StaticResource CustomsToolbarButton}"
                            Visibility="{Binding CanCancelInvoice, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="معاينة" Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource CustomsToolbarButton}"
                            IsEnabled="{Binding CanExportDocument}"
                            ToolTip="معاينة PDF — نسخة عميل"/>
                    <Button Content="طباعة" Command="{Binding PrintCommand}"
                            Style="{StaticResource CustomsToolbarButton}"
                            IsEnabled="{Binding CanPrintDocument}"
                            ToolTip="نسخة عميل — بدون مصاريف أو ربح داخلي"/>
                    <Button Content="PDF" Command="{Binding ExportPdfCommand}"
                            Style="{StaticResource CustomsToolbarButton}"
                            IsEnabled="{Binding CanExportDocument}"
                            ToolTip="تصدير PDF — نسخة عميل"/>
                    <Button Command="{Binding CloseCommand}"
                            Style="{StaticResource CustomsToolbarButton}"
                            ToolTip="إغلاق بدون حفظ إضافي">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </md:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding FormError}" Foreground="#D32F2F" Margin="0,0,0,8"
                           Visibility="{Binding FormError, Converter={StaticResource NullToCollapsedConverter}}"/>

                <Border Background="{DynamicResource DashboardKpiBlueLightBrush}"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding HasFocusSectionHint, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FocusSectionHint}" FontSize="13"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Header fields -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="بيانات الفاتورة" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      md:HintAssist.Hint="العميل *"
                                      Style="{StaticResource CustomerSearchableComboBox}"
                                      Margin="0,0,8,10"/>
                            <TextBox Text="{Binding InvoiceNumber}" IsReadOnly="True"
                                     md:HintAssist.Hint="رقم الفاتورة"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                            <DatePicker SelectedDate="{Binding InvoiceDate}"
                                        md:HintAssist.Hint="التاريخ"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,10"/>

                            <ComboBox ItemsSource="{Binding ServiceTypeOptions}"
                                      SelectedValue="{Binding ServiceType}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="نوع الخدمة"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                            <ComboBox ItemsSource="{Binding TransportKindOptions}"
                                      SelectedValue="{Binding TransportKind}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="نوع النقل *"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"
                                      Visibility="{Binding ShowTransportKind, Converter={StaticResource BoolToVis}}"/>
                            <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                      SelectedValue="{Binding Currency}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="العملة"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                            <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="سعر الصرف (USD→IQD)"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"
                                     Visibility="{Binding ShowFxRate, Converter={StaticResource BoolToVis}}"/>
                        </UniformGrid>
                        <TextBox Text="{Binding TransportRoute, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="مسار النقل الداخلي (مثال: من منفذ ربيعة ← إلى بغداد)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"
                                 Visibility="{Binding ShowTransportRoute, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الوصف / نوع الخدمة"
                                 Style="{StaticResource FilledTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                    </StackPanel>
                </md:Card>

                <!-- Vehicles DataTable -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,0,12"
                         md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="السيارات والشحنات — إدخال سريع داخل الجدول"
                                                     TargetDataGrid="{Binding ElementName=VehiclesGrid}"
                                                     IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowPrint="False"
                                                     ShowFilter="True">
                            <controls:ListTableHeaderBar.ExtraContent>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="180" Height="32" Margin="0,0,10,0"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Background="White"
                                             Foreground="#212121"
                                             CaretBrush="#212121"
                                             BorderThickness="0"
                                             Text="{Binding VehicleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="بحث لوحة / تسلسل / حمولة"
                                             md:HintAssist.Foreground="#78909C"
                                             md:TextFieldAssist.HasClearButton="True"/>
                                    <Button Command="{Binding AddVehicleRowCommand}"
                                            Background="White"
                                            Foreground="{DynamicResource PrimaryHueMidBrush}"
                                            BorderThickness="0"
                                            Height="34" Padding="16,0"
                                            FontWeight="SemiBold"
                                            md:ButtonAssist.CornerRadius="8"
                                            IsEnabled="{Binding CanAddVehicle}"
                                            ToolTip="إضافة سيارة / شحنة (Enter في آخر صف)">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Plus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                            <TextBlock Text="إضافة" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:ListTableHeaderBar.ExtraContent>
                        </controls:ListTableHeaderBar>

                        <DataGrid x:Name="VehiclesGrid" Grid.Row="1"
                                  ItemsSource="{Binding FilteredVehicles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  MaxHeight="480"
                                  MinHeight="220"
                                  RowHeight="44"
                                  FontSize="13"
                                  Style="{StaticResource InvoiceItemsDataGrid}"
                                  CellStyle="{StaticResource CustomsExcelDataGridCell}"
                                  GridLinesVisibility="All"
                                  HorizontalGridLinesBrush="#B0BEC5"
                                  VerticalGridLinesBrush="#B0BEC5"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  md:DataGridAssist.CellPadding="0"
                                  behaviors:InvoiceDataGridBehavior.Enable="True"
                                  behaviors:InvoiceDataGridBehavior.AddRowCommand="{Binding AddVehicleRowCommand}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                            <DataGrid.Columns>
                                <!-- تخليص: اسم السائق -->
                                <DataGridTemplateColumn Header="اسم السائق" Width="140" MinWidth="120"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IraqiDriver">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding IraqiDriver, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- تخليص: رقم العجلة -->
                                <DataGridTemplateColumn Header="رقم العجلة" Width="110" MinWidth="90"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IraqiPlate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding IraqiPlate, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- تخليص: تاريخ التفريغ -->
                                <DataGridTemplateColumn Header="تاريخ التفريغ" Width="150" MinWidth="140"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="UnloadingDate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <DatePicker SelectedDate="{Binding UnloadingDate, UpdateSourceTrigger=PropertyChanged}"
                                                            Style="{StaticResource CustomsVehicleDatePicker}"
                                                            IsEnabled="{Binding DataContext.CanAddVehicle, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- تخليص: رقم الإرسالية -->
                                <DataGridTemplateColumn Header="رقم الإرسالية وعددها" Width="140" MinWidth="120"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SerialNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- تخليص: رسوم -->
                                <DataGridTemplateColumn Header="سيل" Width="90" MinWidth="80"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SealAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding SealAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="إشعاع" Width="90" MinWidth="80"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RadiationAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding RadiationAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="رسم" Width="90" MinWidth="80"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DutyAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding DutyAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="فحص سيطرة نوعية" Width="120" MinWidth="100"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="QualityControlAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding QualityControlAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="نقل بري مانيڤست" Width="120" MinWidth="100"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="LandTransportAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding LandTransportAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="أتعاب التخليص" Width="110" MinWidth="100"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ClearanceFeeAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding ClearanceFeeAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="المصاريف" Width="100" MinWidth="90"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ExpensesAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding ExpensesAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ملاحظات" Width="120" MinWidth="100"
                                                        Visibility="{Binding Data.IsClearanceGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- نقل: رقم الفاتورة / تسلسل -->
                                <DataGridTemplateColumn Header="رقم الفاتورة / تسلسل" Width="150" MinWidth="130"
                                                        Visibility="{Binding Data.IsTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SerialNumber">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="لوحة سورية" Width="120" MinWidth="110"
                                                        Visibility="{Binding Data.IsTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SyrianPlate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding SyrianPlate, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="سائق سوري" Width="130" MinWidth="120"
                                                        Visibility="{Binding Data.IsTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SyrianDriver">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding SyrianDriver, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="لوحة عراقية" Width="120" MinWidth="110"
                                                        Visibility="{Binding Data.IsInternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IraqiPlate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding IraqiPlate, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="سائق عراقي" Width="130" MinWidth="120"
                                                        Visibility="{Binding Data.IsInternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IraqiDriver">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding IraqiDriver, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="البضاعة" Width="*" MinWidth="120"
                                                        Visibility="{Binding Data.IsExternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CargoType">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding CargoType, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الوجهة" Width="140" MinWidth="120"
                                                        Visibility="{Binding Data.IsExternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Destination">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="تاريخ التحميل" Width="150" MinWidth="140"
                                                        Visibility="{Binding Data.IsInternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="LoadingDate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <DatePicker SelectedDate="{Binding LoadingDate, UpdateSourceTrigger=PropertyChanged}"
                                                            Style="{StaticResource CustomsVehicleDatePicker}"
                                                            IsEnabled="{Binding DataContext.CanAddVehicle, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="تاريخ التخريج" Width="150" MinWidth="140"
                                                        Visibility="{Binding Data.IsInternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ExitDate">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <DatePicker SelectedDate="{Binding ExitDate, UpdateSourceTrigger=PropertyChanged}"
                                                            Style="{StaticResource CustomsVehicleDatePicker}"
                                                            IsEnabled="{Binding DataContext.CanAddVehicle, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="أجرة النقل / السعر" Width="120" MinWidth="110"
                                                        Visibility="{Binding Data.IsTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VehiclePrice">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding VehiclePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="غرامات تأخيرية" Width="120" MinWidth="110"
                                                        Visibility="{Binding Data.ShowDelayPenaltyColumn, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DelayPenaltyAmount">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding DelayPenaltyAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="ملاحظات" Width="120" MinWidth="100"
                                                        Visibility="{Binding Data.IsInternalTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource CustomsVehicleInputBox}"
                                                         IsReadOnly="{Binding DataContext.IsVehiclesReadOnly, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="الحالة" Width="130" MinWidth="120"
                                                        Visibility="{Binding Data.IsTransportGrid, Source={StaticResource FormProxy}, Converter={StaticResource BoolToVis}}"
                                                       behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StatusLabel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CustomsGridFieldBorder}">
                                                <ComboBox ItemsSource="{Binding DataContext.VehicleStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value"
                                                          DisplayMemberPath="Label"
                                                          IsEnabled="{Binding DataContext.CanAddVehicle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          Style="{StaticResource CustomsVehicleComboBox}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="إجراءات" Width="160" MinWidth="150"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.OpenVehicleDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableViewIconButton}"
                                                        ToolTip="تفاصيل ومرفقات السيارة">
                                                    <md:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenVehicleDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableAttachIconButton}"
                                                        ToolTip="مرفقات السيارة">
                                                    <md:PackIcon Kind="Attachment" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.RemoveVehicleRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}"
                                                        IsEnabled="{Binding DataContext.CanDeleteVehicle, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="حذف الصف"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>

                <!-- Pricing -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="التسعير" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                        <UniformGrid Columns="5">
                            <controls:AnimatedStatCard Title="مجموع السيارات" TextValue="{Binding VehiclesSum, StringFormat=N0}"
                                                       Icon="Car" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="{DynamicResource PrimaryHueMidBrush}"
                                                       ValueForeground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="الخصم" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <controls:AnimatedStatCard Title="الإجمالي" TextValue="{Binding TotalAmount, StringFormat=N0}"
                                                       Icon="Cash" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                       IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="المدفوع" TextValue="{Binding PaidAmount, StringFormat=N0}"
                                                       Icon="CashCheck" IconBackground="{DynamicResource DashboardKpiTealLightBrush}"
                                                       IconForeground="{DynamicResource DashboardKpiTealBrush}"
                                                       ValueForeground="{DynamicResource DashboardKpiTealBrush}" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="المتبقي" TextValue="{Binding RemainingAmount, StringFormat=N0}"
                                                       Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                                       IconForeground="#C62828" ValueForeground="#C62828"/>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>

                <!-- Expenses DataTable + internal profit -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,0,12"
                         md:ElevationAssist.Elevation="Dp2"
                         Visibility="{Binding CanViewExpenses, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="المصاريف / الخدمات الإضافية"
                                                     TargetDataGrid="{Binding ElementName=ExpensesGrid}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowPrint="False"
                                                     ShowFilter="False">
                            <controls:ListTableHeaderBar.ExtraContent>
                                <Button Command="{Binding OpenAddExpenseDialogCommand}"
                                        Style="{StaticResource CustomsToolbarPrimaryButton}"
                                        Background="White"
                                        Foreground="{DynamicResource PrimaryHueMidBrush}"
                                        BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                        BorderThickness="1"
                                        IsEnabled="{Binding CanAddExpense}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="CashPlus" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                        <TextBlock Text="إضافة مصروف" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </controls:ListTableHeaderBar.ExtraContent>
                        </controls:ListTableHeaderBar>

                        <DataGrid x:Name="ExpensesGrid" Grid.Row="1"
                                  ItemsSource="{Binding Expenses}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single"
                                  Style="{StaticResource ModernDataGrid}"
                                  MaxHeight="240"
                                  MinHeight="120"
                                  Margin="0,0,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Binding="{Binding ExpenseTypeName}" Width="120"/>
                                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat=yyyy/MM/dd}" Width="110"/>
                                <DataGridTextColumn Header="المستلم" Binding="{Binding Recipient}" Width="110"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="160" MinWidth="150">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding DataContext.OpenEditExpenseDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableEditIconButton}"
                                                        IsEnabled="{Binding DataContext.CanEditExpense, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="تعديل ومرفقات">
                                                    <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenEditExpenseDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableAttachIconButton}"
                                                        IsEnabled="{Binding DataContext.CanEditExpense, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="مرفقات المصروف">
                                                    <md:PackIcon Kind="Attachment" Width="18" Height="18"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.RemoveExpenseRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}"
                                                        IsEnabled="{Binding DataContext.CanDeleteExpense, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="حذف"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Margin="16,4,16,16"
                                    Visibility="{Binding CanViewProfit, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12" Foreground="{DynamicResource HintForegroundBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="الربح الداخلي = الإيراد − مصاريف نفس عملة الفاتورة — رصيد العميل (المدفوع/المتبقي) ليس ربحاً"/>
                            <UniformGrid Columns="4">
                                <controls:AnimatedStatCard Title="الإيراد"
                                                           TextValue="{Binding TotalAmount, StringFormat=N0}"
                                                           Icon="CashPlus" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="{DynamicResource PrimaryHueMidBrush}"
                                                           ValueForeground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0"/>
                                <controls:AnimatedStatCard Title="مصاريف نفس العملة"
                                                           TextValue="{Binding ExpensesSameCurrencySum, StringFormat=N0}"
                                                           Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                                                           IconForeground="#EF6C00" ValueForeground="#EF6C00" Margin="0,0,8,0"/>
                                <controls:AnimatedStatCard Title="الربح الداخلي"
                                                           TextValue="{Binding InternalProfit, StringFormat=N0}"
                                                           Icon="ChartLine" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                           IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                                <controls:AnimatedStatCard Title="مصاريف عملة أخرى"
                                                           TextValue="{Binding ExpensesOtherCurrencySum, StringFormat=N0}"
                                                           Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiTealLightBrush}"
                                                           IconForeground="{DynamicResource DashboardKpiTealBrush}"
                                                           ValueForeground="{DynamicResource DashboardKpiTealBrush}"/>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- Attachments -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <controls:AttachmentsPanel
                        Title="المرفقات"
                        SaveFirstHint=""
                        Items="{Binding Attachments}"
                        HasSavedOwner="{Binding CanManageAttachments}"
                        CanManage="{Binding CanManageAttachments}"
                        CanDelete="{Binding CanManageAttachments}"
                        AddCommand="{Binding AddAttachmentCommand}"
                        OpenCommand="{Binding OpenAttachmentCommand}"
                        DeleteCommand="{Binding DeleteAttachmentCommand}"/>
                </md:Card>

                <!-- Notes -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ملاحظات داخلية" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ملاحظات العميل" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CustomerNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"/>
                        </StackPanel>
                    </Grid>
                </md:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CustomsDialogFooter}" Margin="0,8,0,0"
                BorderThickness="1" CornerRadius="8"
                BorderBrush="{DynamicResource CardBorderBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Command="{Binding SaveCommand}"
                            Style="{StaticResource CustomsDialogPrimaryButton}"
                            IsEnabled="{Binding CanSave}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="ContentSave" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="حفظ الفاتورة" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseCommand}"
                            Style="{StaticResource CustomsDialogSecondaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <Run Text="رقم:"/>
                    <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text="  |  إجمالي:"/>
                    <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold"/>
                    <Run Text="  |  متبقي:"/>
                    <Run Text="{Binding RemainingAmount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold"/>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Vehicle detail dialog -->
        <md:DialogHost IsOpen="{Binding IsVehicleDetailDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       Panel.ZIndex="200"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="720" MaxWidth="820" MaxHeight="680" UniformCornerRadius="16"
                         md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseVehicleDetailCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="تفاصيل السيارة" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="عدّل البيانات والتواريخ ثم طبّق — المرفقات بعد حفظ الفاتورة"
                                           FontSize="12" Foreground="#BBDEFB" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16"
                                      DataContext="{Binding DetailVehicle}">
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="رقم الفاتورة / تسلسل" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding IraqiPlate, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="لوحة عراقية" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding IraqiDriver, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="سائق عراقي" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding SyrianPlate, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="لوحة سورية" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding SyrianDriver, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="سائق سوري" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding CargoType, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="نوع الحمولة" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding VehiclePrice, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="السعر" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding DelayPenaltyAmount, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="غرامات تأخيرية"
                                             Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <ComboBox ItemsSource="{Binding DataContext.VehicleStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label"
                                              md:HintAssist.Hint="الحالة" Style="{StaticResource FilledComboBox}" Margin="0,0,0,10"/>
                                    <DatePicker SelectedDate="{Binding LoadingDate}"
                                                md:HintAssist.Hint="تاريخ التحميل"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,10"/>
                                    <DatePicker SelectedDate="{Binding ExitDate}"
                                                md:HintAssist.Hint="تاريخ الخروج"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,10"/>
                                    <DatePicker SelectedDate="{Binding WarehouseArrivalDate}"
                                                md:HintAssist.Hint="وصول المخزن"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,10"/>
                                    <DatePicker SelectedDate="{Binding UnloadingDate}"
                                                md:HintAssist.Hint="تاريخ التفريغ"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,10"/>
                                </UniformGrid>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="ملاحظات السيارة"
                                         Style="{StaticResource FilledTextBox}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" Margin="0,0,0,12"/>

                                <controls:AttachmentsPanel
                                    Title="مرفقات السيارة"
                                    AddButtonText="+ مرفق"
                                    SaveFirstHint="احفظ الفاتورة أولاً لتفعيل مرفقات هذه السيارة"
                                    MaxGridHeight="140"
                                    Items="{Binding DataContext.VehicleAttachments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    HasSavedOwner="{Binding DataContext.HasSavedDetailVehicle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CanManage="{Binding DataContext.CanManageAttachments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CanDelete="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AddCommand="{Binding DataContext.AddVehicleAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    OpenCommand="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    DeleteCommand="{Binding DataContext.DeleteVehicleAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Style="{StaticResource CustomsDialogFooter}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تطبيق" Command="{Binding ApplyVehicleDetailCommand}"
                                        Style="{StaticResource CustomsDialogPrimaryButton}"/>
                                <Button Content="إغلاق" Command="{Binding CloseVehicleDetailCommand}"
                                        Style="{StaticResource CustomsDialogSecondaryButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Expense add/edit dialog -->
        <md:DialogHost IsOpen="{Binding IsExpenseDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       Panel.ZIndex="200"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="520" MaxWidth="580" MaxHeight="680" UniformCornerRadius="16" md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseExpenseDialogCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="{Binding ExpenseDialogTitle}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="نوع · مبلغ · عملة · تاريخ — المرفقات بعد حفظ الفاتورة"
                                           FontSize="12" Foreground="#BBDEFB" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      behaviors:ScrollViewerMouseWheel.IsEnabled="True">
                            <StackPanel Margin="24,20,24,8">
                                <TextBlock Text="نوع المصروف" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding ExpenseTypes}"
                                          SelectedItem="{Binding SelectedExpenseType}"
                                          DisplayMemberPath="Name"
                                          md:HintAssist.Hint="اختر نوع المصروف *"
                                          Style="{StaticResource FilledComboBox}"
                                          Margin="0,0,0,14"/>
                                <TextBlock Text="إضافة نوع جديد" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource HintForegroundBrush}" Margin="0,0,0,6"/>
                                <DockPanel Margin="0,0,0,14">
                                    <Button Command="{Binding AddExpenseTypeCommand}"
                                            Style="{StaticResource OutlinedButton}"
                                            md:ButtonAssist.CornerRadius="8"
                                            DockPanel.Dock="Right"
                                            VerticalAlignment="Center" Padding="14,8" Margin="8,0,0,0"
                                            ToolTip="يضيف نوع مصروف جديداً إلى القائمة (وليس مصروفاً على الفاتورة)">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="إضافة نوع جديد" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox Text="{Binding NewExpenseTypeName, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="اسم النوع الجديد"
                                             Style="{StaticResource FilledTextBox}"/>
                                </DockPanel>
                                <TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="الوصف"
                                         Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                             md:HintAssist.Hint="المبلغ *"
                                             Style="{StaticResource NumericTextBox}" Margin="0,0,8,0"/>
                                    <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                              SelectedValue="{Binding ExpenseCurrency}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label"
                                              md:HintAssist.Hint="العملة *"
                                              Style="{StaticResource FilledComboBox}"/>
                                </UniformGrid>
                                <TextBox Text="{Binding ExpenseFxRate, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="سعر الصرف (USD→IQD)"
                                         Style="{StaticResource NumericTextBox}" Margin="0,0,0,12"
                                         Visibility="{Binding ShowExpenseFxRate, Converter={StaticResource BoolToVis}}"/>
                                <UniformGrid Columns="2" Margin="0,0,0,16">
                                    <DatePicker SelectedDate="{Binding ExpenseDate}"
                                                md:HintAssist.Hint="تاريخ المصروف *"
                                                Style="{StaticResource FilledDatePicker}" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding ExpenseRecipient, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="المستلم"
                                             Style="{StaticResource FilledTextBox}"/>
                                </UniformGrid>

                                <controls:AttachmentsPanel
                                    Title="مرفقات المصروف"
                                    AddButtonText="+ مرفق"
                                    SaveFirstHint="يجب حفظ الفاتورة أولاً لإضافة مرفق للمصروف."
                                    MaxGridHeight="140"
                                    UseLabeledActions="True"
                                    Items="{Binding ExpenseAttachments}"
                                    HasSavedOwner="{Binding HasSavedEditingExpense}"
                                    CanManage="{Binding CanManageAttachments}"
                                    CanDelete="{Binding CanDelete}"
                                    AddCommand="{Binding AddExpenseAttachmentCommand}"
                                    OpenCommand="{Binding OpenAttachmentCommand}"
                                    DeleteCommand="{Binding DeleteExpenseAttachmentCommand}"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" Style="{StaticResource CustomsDialogFooter}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ" Command="{Binding SaveExpenseDialogCommand}"
                                        Style="{StaticResource CustomsDialogPrimaryButton}"/>
                                <Button Content="إلغاء" Command="{Binding CloseExpenseDialogCommand}"
                                        Style="{StaticResource CustomsDialogSecondaryButton}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- M-02: save/approve loading overlay -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsSaving, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="40" Height="40" Value="0"/>
                <TextBlock Text="جارٍ الحفظ..." FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
