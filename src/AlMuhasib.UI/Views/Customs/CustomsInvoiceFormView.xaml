<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsInvoiceFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             behaviors:ScrollViewerMouseWheel.IsEnabled="True"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="16" Margin="0,0,0,12"
                 Panel.ZIndex="1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="فاتورة التخليص" FontSize="18" FontWeight="Bold"
                               Foreground="#0277BD" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Border Background="#E1F5FE" CornerRadius="10" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="#0277BD"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="حفظ مسودة" Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#0277BD"
                            md:ButtonAssist.CornerRadius="8" Padding="18,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanSave}"/>
                    <Button Content="حفظ واعتماد" Command="{Binding SaveAndApproveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32"
                            md:ButtonAssist.CornerRadius="8" Padding="18,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanSave}"/>
                    <Button Content="اعتماد" Command="{Binding ApproveCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0"
                            Visibility="{Binding CanApprove, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="إلغاء الفاتورة" Command="{Binding CancelInvoiceCommand}"
                            Style="{StaticResource OutlinedButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0"
                            Visibility="{Binding CanCancelInvoice, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="إغلاق" Command="{Binding CloseCommand}" Style="{StaticResource FlatButton}"/>
                </StackPanel>
            </DockPanel>
        </md:Card>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding FormError}" Foreground="#D32F2F" Margin="0,0,0,8"
                           Visibility="{Binding FormError, Converter={StaticResource NullToCollapsedConverter}}"/>

                <!-- Header fields -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="بيانات الفاتورة" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                        <UniformGrid Columns="3">
                            <ComboBox ItemsSource="{Binding Customers}"
                                      SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name"
                                      md:HintAssist.Hint="العميل *"
                                      Style="{StaticResource FilledComboBox}"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      Margin="0,0,8,10"/>
                            <TextBox Text="{Binding InvoiceNumber}" IsReadOnly="True"
                                     md:HintAssist.Hint="رقم الفاتورة"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                            <DatePicker SelectedDate="{Binding InvoiceDate}"
                                        md:HintAssist.Hint="التاريخ"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,10"/>

                            <ComboBox ItemsSource="{Binding ServiceTypeOptions}"
                                      SelectedValue="{Binding ServiceType}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="نوع الخدمة"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                            <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                      SelectedValue="{Binding Currency}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="العملة"
                                      Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                            <TextBox Text="{Binding FxRate, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="سعر الصرف (USD→IQD)"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"
                                     Visibility="{Binding ShowFxRate, Converter={StaticResource BoolToVis}}"/>
                        </UniformGrid>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="الوصف"
                                 Style="{StaticResource FilledTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                    </StackPanel>
                </md:Card>

                <!-- Vehicles DataTable -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="0" Margin="0,0,0,12"
                         md:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="السيارات والشحنات — إدخال سريع داخل الجدول"
                                                     TargetDataGrid="{Binding ElementName=VehiclesGrid}"
                                                     IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     ShowCardToggle="False"
                                                     ShowExport="False"
                                                     ShowPrint="False"
                                                     ShowFilter="True">
                            <controls:ListTableHeaderBar.ExtraContent>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Width="180" Height="32" Margin="0,0,10,0"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center"
                                             Background="White"
                                             Foreground="#212121"
                                             CaretBrush="#212121"
                                             BorderThickness="0"
                                             Text="{Binding VehicleSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="بحث لوحة / تسلسل / حمولة"
                                             md:HintAssist.Foreground="#78909C"
                                             md:TextFieldAssist.HasClearButton="True"/>
                                    <Button Command="{Binding AddVehicleRowCommand}"
                                            Style="{StaticResource FlatButton}"
                                            Foreground="White" Height="32" Padding="14,0"
                                            IsEnabled="{Binding CanAddVehicle}"
                                            ToolTip="إضافة سيارة (Enter في آخر صف)">
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="إضافة سيارة" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </controls:ListTableHeaderBar.ExtraContent>
                        </controls:ListTableHeaderBar>

                        <DataGrid x:Name="VehiclesGrid" Grid.Row="1"
                                  ItemsSource="{Binding FilteredVehicles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="{Binding IsVehiclesReadOnly}"
                                  SelectionMode="Single"
                                  SelectionUnit="Cell"
                                  MaxHeight="320"
                                  MinHeight="160"
                                  Style="{StaticResource InvoiceItemsDataGrid}"
                                  behaviors:InvoiceDataGridBehavior.Enable="True"
                                  behaviors:InvoiceDataGridBehavior.AddRowCommand="{Binding AddVehicleRowCommand}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                                  CellEditEnding="VehiclesGrid_OnCellEditEnding">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="تسلسل"
                                                    Binding="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="80"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SerialNumber"/>
                                <DataGridTextColumn Header="لوحة عراقية"
                                                    Binding="{Binding IraqiPlate, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IraqiPlate"/>
                                <DataGridTextColumn Header="سائق عراقي"
                                                    Binding="{Binding IraqiDriver, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IraqiDriver"/>
                                <DataGridTextColumn Header="لوحة سورية"
                                                    Binding="{Binding SyrianPlate, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SyrianPlate"/>
                                <DataGridTextColumn Header="سائق سوري"
                                                    Binding="{Binding SyrianDriver, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SyrianDriver"/>
                                <DataGridTextColumn Header="الحمولة"
                                                    Binding="{Binding CargoType, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CargoType"/>
                                <DataGridTextColumn Header="السعر"
                                                    Binding="{Binding VehiclePrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                    Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="VehiclePrice"/>
                                <DataGridTemplateColumn Header="الحالة" Width="120"
                                                       behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StatusLabel">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.VehicleStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Value"
                                                      DisplayMemberPath="Label"
                                                      IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Style="{StaticResource FilledComboBox}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="إجراءات" Width="120"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Command="{Binding DataContext.OpenVehicleDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableViewIconButton}"
                                                        ToolTip="تفاصيل السيارة">
                                                    <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.OpenVehicleAttachmentsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableAttachIconButton}"
                                                        ToolTip="مرفقات السيارة">
                                                    <md:PackIcon Kind="Attachment" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.RemoveVehicleRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}"
                                                        IsEnabled="{Binding DataContext.CanDeleteVehicle, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        ToolTip="حذف">
                                                    <md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </md:Card>

                <!-- Pricing -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="التسعير" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                        <UniformGrid Columns="5">
                            <controls:AnimatedStatCard Title="مجموع السيارات" TextValue="{Binding VehiclesSum, StringFormat=N0}"
                                                       Icon="Car" IconBackground="#E1F5FE" IconForeground="#0277BD"
                                                       ValueForeground="#0277BD" Margin="0,0,8,0"/>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="الخصم" FontSize="12" Foreground="{DynamicResource HintForegroundBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DiscountAmount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilledTextBox}"/>
                            </StackPanel>
                            <controls:AnimatedStatCard Title="الإجمالي" TextValue="{Binding TotalAmount, StringFormat=N0}"
                                                       Icon="Cash" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                       IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="المدفوع" TextValue="{Binding PaidAmount, StringFormat=N0}"
                                                       Icon="CashCheck" IconBackground="{DynamicResource DashboardKpiTealLightBrush}"
                                                       IconForeground="{DynamicResource DashboardKpiTealBrush}"
                                                       ValueForeground="{DynamicResource DashboardKpiTealBrush}" Margin="0,0,8,0"/>
                            <controls:AnimatedStatCard Title="المتبقي" TextValue="{Binding RemainingAmount, StringFormat=N0}"
                                                       Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                                       IconForeground="#C62828" ValueForeground="#C62828"/>
                        </UniformGrid>
                    </StackPanel>
                </md:Card>

                <!-- Expenses / Additional services -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="الخدمات الإضافية / المصاريف" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                        <WrapPanel Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding ExpenseTypes}"
                                      SelectedItem="{Binding SelectedExpenseType}"
                                      DisplayMemberPath="Name"
                                      md:HintAssist.Hint="نوع المصروف"
                                      Style="{StaticResource FilledComboBox}" Width="160" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding NewExpenseTypeName, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="نوع جديد"
                                     Style="{StaticResource FilledTextBox}" Width="120" Margin="0,0,4,8"/>
                            <Button Content="+" Command="{Binding AddExpenseTypeCommand}"
                                    Style="{StaticResource FlatButton}" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding ExpenseDescription, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="الوصف"
                                     Style="{StaticResource FilledTextBox}" Width="140" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding ExpenseAmount, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="المبلغ"
                                     Style="{StaticResource FilledTextBox}" Width="100" Margin="0,0,8,8"/>
                            <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                      SelectedValue="{Binding ExpenseCurrency}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      md:HintAssist.Hint="عملة المصروف"
                                      Style="{StaticResource FilledComboBox}" Width="120" Margin="0,0,8,8"/>
                            <DatePicker SelectedDate="{Binding ExpenseDate}"
                                        md:HintAssist.Hint="التاريخ"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" Width="130" Margin="0,0,8,8"/>
                            <TextBox Text="{Binding ExpenseRecipient, UpdateSourceTrigger=PropertyChanged}"
                                     md:HintAssist.Hint="المستلم"
                                     Style="{StaticResource FilledTextBox}" Width="120" Margin="0,0,8,8"/>
                            <Button Content="إضافة" Command="{Binding AddExpenseRowCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#0277BD"
                                    md:ButtonAssist.CornerRadius="8" Padding="16,8" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Expenses}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource ModernDataGrid}" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Binding="{Binding ExpenseTypeName}" Width="120"/>
                                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="100"/>
                                <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                                <DataGridTextColumn Header="المستلم" Binding="{Binding Recipient}" Width="110"/>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveExpenseRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource TableDeleteIconButton}">
                                                <md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </md:Card>

                <!-- Attachments -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="المرفقات" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                    Command="{Binding AddAttachmentCommand}"
                                    Style="{StaticResource FlatButton}" Content="+ إضافة مرفق"
                                    IsEnabled="{Binding HasSavedInvoice}"/>
                        </DockPanel>
                        <TextBlock Text="احفظ الفاتورة أولاً لتفعيل المرفقات" FontSize="12"
                                   Foreground="{DynamicResource HintForegroundBrush}" Margin="0,0,0,8"
                                   Visibility="{Binding HasSavedInvoice, Converter={StaticResource InvBoolToVis}}"/>
                        <DataGrid ItemsSource="{Binding Attachments}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False"
                                  Style="{StaticResource ModernDataGrid}" MaxHeight="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="140"/>
                                <DataGridTemplateColumn Header="إجراءات" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource TableViewIconButton}">
                                                    <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                                </Button>
                                                <Button Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}">
                                                    <md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </md:Card>

                <!-- Notes -->
                <md:Card Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ملاحظات داخلية" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding InternalNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ملاحظات العميل" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding CustomerNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90"/>
                        </StackPanel>
                    </Grid>
                </md:Card>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" Padding="12,8" Margin="0,8,0,0"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}">
                <Run Text="رقم:"/>
                <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="Bold"/>
                <Run Text="  |  إجمالي:"/>
                <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold"/>
                <Run Text="  |  متبقي:"/>
                <Run Text="{Binding RemainingAmount, Mode=OneWay, StringFormat=N0}" FontWeight="Bold"/>
            </TextBlock>
        </Border>

        <!-- Vehicle detail dialog -->
        <md:DialogHost IsOpen="{Binding IsVehicleDetailDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="720" MaxWidth="820" MaxHeight="680" UniformCornerRadius="16"
                         md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0277BD" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseVehicleDetailCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="تفاصيل السيارة" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="عدّل البيانات والتواريخ ثم طبّق — المرفقات بعد حفظ الفاتورة"
                                           FontSize="12" Foreground="#B3E5FC" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16"
                                      DataContext="{Binding DetailVehicle}">
                            <StackPanel>
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="التسلسل" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding IraqiPlate, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="لوحة عراقية" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding IraqiDriver, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="سائق عراقي" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding SyrianPlate, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="لوحة سورية" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding SyrianDriver, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="سائق سوري" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <TextBox Text="{Binding CargoType, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="نوع الحمولة" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding VehiclePrice, UpdateSourceTrigger=PropertyChanged}"
                                             md:HintAssist.Hint="السعر" Style="{StaticResource FilledTextBox}" Margin="0,0,8,10"/>
                                    <ComboBox ItemsSource="{Binding DataContext.VehicleStatusOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Value" DisplayMemberPath="Label"
                                              md:HintAssist.Hint="الحالة" Style="{StaticResource FilledComboBox}" Margin="0,0,8,10"/>
                                    <DatePicker SelectedDate="{Binding LoadingDate}"
                                                md:HintAssist.Hint="تاريخ التحميل"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,10"/>
                                    <DatePicker SelectedDate="{Binding ExitDate}"
                                                md:HintAssist.Hint="تاريخ الخروج"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,10"/>
                                    <DatePicker SelectedDate="{Binding WarehouseArrivalDate}"
                                                md:HintAssist.Hint="وصول المخزن"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,8,10"/>
                                    <DatePicker SelectedDate="{Binding UnloadingDate}"
                                                md:HintAssist.Hint="تاريخ التفريغ"
                                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,10"/>
                                </UniformGrid>
                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                         md:HintAssist.Hint="ملاحظات السيارة"
                                         Style="{StaticResource FilledTextBox}"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="64" Margin="0,0,0,12"/>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="مرفقات السيارة" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Command="{Binding DataContext.AddVehicleAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Style="{StaticResource FlatButton}" Content="+ مرفق"
                                            IsEnabled="{Binding DataContext.HasSavedDetailVehicle, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                </DockPanel>
                                <TextBlock Text="احفظ الفاتورة أولاً لتفعيل مرفقات هذه السيارة" FontSize="12"
                                           Foreground="{DynamicResource HintForegroundBrush}" Margin="0,0,0,8"
                                           Visibility="{Binding DataContext.HasSavedDetailVehicle, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}"/>
                                <DataGrid ItemsSource="{Binding DataContext.VehicleAttachments, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          Style="{StaticResource ModernDataGrid}" MaxHeight="140">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="140"/>
                                        <DataGridTemplateColumn Header="" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource TableViewIconButton}">
                                                            <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.DeleteVehicleAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}">
                                                            <md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تطبيق" Command="{Binding ApplyVehicleDetailCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Background="#0277BD"
                                        md:ButtonAssist.CornerRadius="8" Padding="28,10" Margin="0,0,8,0"/>
                                <Button Content="إغلاق" Command="{Binding CloseVehicleDetailCommand}"
                                        Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- Vehicle attachments dialog -->
        <md:DialogHost IsOpen="{Binding IsVehicleAttachmentsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3"
                       Style="{StaticResource ModernDialogHost}">
            <md:DialogHost.DialogContent>
                <md:Card MinWidth="520" MaxWidth="600" MaxHeight="560" UniformCornerRadius="16"
                         md:ElevationAssist.Elevation="Dp8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#0277BD" Padding="16,12,16,14" CornerRadius="16,16,0,0">
                            <StackPanel>
                                <Button Command="{Binding CloseVehicleAttachmentsCommand}" HorizontalAlignment="Left"
                                        Style="{StaticResource FlatButton}" Foreground="White" Padding="2" Margin="0,0,0,8">
                                    <md:PackIcon Kind="Close" Width="22" Height="22"/>
                                </Button>
                                <TextBlock Text="مرفقات السيارة" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock FontSize="12" Foreground="#B3E5FC" Margin="0,6,0,0">
                                    <Run Text="لوحة:"/>
                                    <Run Text="{Binding AttachmentsVehicle.IraqiPlate, Mode=OneWay}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding AttachmentsVehicle.SyrianPlate, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="24,16">
                            <Button Content="+ إضافة مرفق" Command="{Binding AddVehicleAttachmentCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#0277BD"
                                    md:ButtonAssist.CornerRadius="8" Padding="16,8" HorizontalAlignment="Right"
                                    Margin="0,0,0,12"
                                    IsEnabled="{Binding HasSavedAttachmentsVehicle}"/>
                            <DataGrid ItemsSource="{Binding VehicleAttachments}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      Style="{StaticResource ModernDataGrid}" MaxHeight="320" MinHeight="160">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="اسم الملف" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd HH:mm}" Width="140"/>
                                    <DataGridTemplateColumn Header="إجراءات" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource TableViewIconButton}">
                                                        <md:PackIcon Kind="Eye" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteVehicleAttachmentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}">
                                                        <md:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                            <Button Content="إغلاق" Command="{Binding CloseVehicleAttachmentsCommand}"
                                    Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8" Padding="24,10"/>
                        </Border>
                    </Grid>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
