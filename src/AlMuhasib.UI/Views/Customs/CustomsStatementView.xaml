<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث / تحديث" Command="{Binding LoadDataCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}">
                <MenuItem.Icon><md:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة" Command="{Binding PrintCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تصدير PDF" Command="{Binding ExportPdfCommand}">
                <MenuItem.Icon><md:PackIcon Kind="FilePdfBox" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="كشف حساب عميل — التخليص الكمركي" FontSize="24" FontWeight="Bold"
                           Foreground="#0277BD" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <controls:AnimatedStatCard Title="اسم العميل" TextValue="{Binding CustomerName}"
                                               Icon="Account" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                               IconForeground="#1565C0" ValueForeground="#1565C0" Margin="0,0,8,0"/>
                    <controls:AnimatedStatCard Title="مدين د.ع" TextValue="{Binding TotalDebitIqd}"
                                               Icon="CashPlus" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                               IconForeground="#C62828" ValueForeground="#C62828" Margin="0,0,8,0"/>
                    <controls:AnimatedStatCard Title="دائن د.ع" TextValue="{Binding TotalCreditIqd}"
                                               Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                               IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                    <controls:AnimatedStatCard Title="الرصيد د.ع" TextValue="{Binding BalanceIqd}"
                                               Icon="ScaleBalance" IconBackground="{DynamicResource AccentLightBrush}"
                                               IconForeground="{DynamicResource AccentBrush}"
                                               ValueForeground="{DynamicResource AccentBrush}"/>
                </UniformGrid>
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="عدد الحركات" TextValue="{Binding TransactionCount}"
                                               Icon="FormatListNumbered" IconBackground="#E1F5FE"
                                               IconForeground="#0277BD" ValueForeground="#0277BD" Margin="0,0,8,0"/>
                    <controls:AnimatedStatCard Title="مدين $" TextValue="{Binding TotalDebitUsd}"
                                               Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                               IconForeground="#C62828" ValueForeground="#C62828" Margin="0,0,8,0"/>
                    <controls:AnimatedStatCard Title="دائن $" TextValue="{Binding TotalCreditUsd}"
                                               Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                               IconForeground="#2E7D32" ValueForeground="#2E7D32" Margin="0,0,8,0"/>
                    <controls:AnimatedStatCard Title="الرصيد $" TextValue="{Binding BalanceUsd}"
                                               Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                               IconForeground="#1565C0" ValueForeground="#1565C0"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <WrapPanel>
                        <ComboBox Width="240" Margin="0,0,12,8"
                                  ItemsSource="{Binding FilteredCustomers}"
                                  SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                  Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" IsTextSearchEnabled="True"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  md:HintAssist.Hint="العميل *"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    md:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,8"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    md:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding TransactionTypeOptions}"
                                  SelectedValue="{Binding TransactionTypeFilter}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  Style="{StaticResource FilledComboBox}"
                                  md:HintAssist.Hint="نوع الحركة" Width="130" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding InvoiceOptions}"
                                  SelectedItem="{Binding SelectedInvoiceOption}"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilledComboBox}"
                                  md:HintAssist.Hint="الفاتورة" Width="180" Margin="0,0,12,8"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadDataCommand}" Margin="0,0,12,8"/>
                        <Button Content="PDF" Style="{StaticResource OutlinedButton}"
                                Command="{Binding ExportPdfCommand}" Margin="0,0,0,8"
                                IsEnabled="{Binding CanPrint}"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <md:Card Grid.Row="1" md:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="كشف الحساب — دفاتر د.ع و $ منفصلة"
                                             TargetDataGrid="{Binding ElementName=StatementGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False">
                    <controls:ListTableHeaderBar.ExtraContent>
                        <TextBlock Text="{Binding PeriodLabel}" Foreground="White" VerticalAlignment="Center"
                                   FontSize="12" Margin="0,0,8,0"/>
                    </controls:ListTableHeaderBar.ExtraContent>
                </controls:ListTableHeaderBar>

                <DataGrid x:Name="StatementGrid" Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding TransactionTypeLabel}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TransactionTypeLabel"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CurrencyLabel"/>
                        <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Debit"/>
                        <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Credit"/>
                        <DataGridTextColumn Header="الرصيد الجاري" Binding="{Binding RunningBalance, StringFormat=N0}" Width="120"
                                            FontWeight="Bold"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RunningBalance"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
