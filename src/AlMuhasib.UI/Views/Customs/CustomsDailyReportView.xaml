<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsDailyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث / تحديث" Command="{Binding LoadDataCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}">
                <MenuItem.Icon><md:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تصدير PDF" Command="{Binding ExportToPdfCommand}">
                <MenuItem.Icon><md:PackIcon Kind="FilePdfBox" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="طباعة" Command="{Binding PrintCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="التقرير اليومي" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#0277BD"/>
                <UniformGrid Columns="5" Margin="0,0,0,16">
                    <controls:AnimatedStatCard Title="فواتير" TextValue="{Binding InvoiceCount}" Icon="FileDocument" IconBackground="#E1F5FE" IconForeground="#0277BD" ValueForeground="#0277BD"/>
                    <controls:AnimatedStatCard Title="فواتير د.ع / $" TextValue="{Binding InvoicesIqd}" Icon="Cash" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="مقبوضات" TextValue="{Binding ReceiptsIqd}" Icon="CashPlus" IconBackground="{DynamicResource DashboardKpiTealLightBrush}" IconForeground="{DynamicResource DashboardKpiTealBrush}" ValueForeground="{DynamicResource DashboardKpiTealBrush}"/>
                    <controls:AnimatedStatCard Title="مصاريف" TextValue="{Binding ExpensesIqd}" Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}" IconForeground="#EF6C00" ValueForeground="#EF6C00"
                                               Visibility="{Binding CanViewExpenses, Converter={StaticResource BoolToVis}}"/>
                    <controls:AnimatedStatCard Title="سيارات" TextValue="{Binding VehicleCount}" Icon="Car" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                </UniformGrid>
                <controls:ChartCard Title="توزيع الحركات" Margin="0,0,0,12">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding TypeSeries}" Height="260"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" md:HintAssist.Hint="اليوم" Width="150" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" md:HintAssist.Hint="العميل" Width="200" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <md:Card Grid.Row="1" md:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0" Title="حركة اليوم"
                    TargetDataGrid="{Binding ElementName=ReportGrid}"
                    IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                    ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                    ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                    ExportCommand="{Binding ExportToExcelCommand}"
                    PrintCommand="{Binding PrintCommand}" ShowCardToggle="False"/>
                <DataGrid x:Name="ReportGrid" Grid.Row="1" ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="90" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Kind"/>
                        <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="120" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Reference"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CurrencyLabel"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="110" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*" behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
