<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsInvoiceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="تحديث" Command="{Binding RefreshCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Refresh" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="فاتورة جديدة" Command="{Binding OpenNewInvoiceCommand}">
                <MenuItem.Icon><md:PackIcon Kind="FileDocumentPlus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}">
                <MenuItem.Icon><md:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة الجدول" Command="{Binding PrintTableCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="فواتير التخليص الكمركي" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <Button Command="{Binding OpenNewInvoiceCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,8"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="FileDocumentPlus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="فاتورة جديدة"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                    <TextBox md:HintAssist.Hint="بحث برقم الفاتورة أو العميل..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" MinWidth="220" Margin="0,0,8,8"/>
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedValue="{Binding StatusFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              md:HintAssist.Hint="الحالة"
                              Style="{StaticResource FilledComboBox}"
                              Width="140" Margin="0,0,8,8"/>
                    <DatePicker SelectedDate="{Binding DateFrom}"
                                md:HintAssist.Hint="من تاريخ"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Width="140" Margin="0,0,8,8"/>
                    <DatePicker SelectedDate="{Binding DateTo}"
                                md:HintAssist.Hint="إلى تاريخ"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                Width="140" Margin="0,0,0,8"/>
                </WrapPanel>
            </StackPanel>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة الفواتير"
                                             TargetDataGrid="{Binding ElementName=InvoicesGrid}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="InvoicesGrid" Grid.Row="1"
                          ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single"
                          Style="{StaticResource ModernDataGrid}"
                          Sorting="InvoicesGrid_Sorting">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرقم" Binding="{Binding InvoiceNumber}" SortMemberPath="InvoiceNumber" Width="110"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" SortMemberPath="InvoiceDate" Width="100"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*" CanUserSort="False"/>
                        <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceTypeLabel}" Width="110" CanUserSort="False"/>
                        <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70" CanUserSort="False"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat=N0}" SortMemberPath="TotalAmount" Width="100"/>
                        <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat=N0}" SortMemberPath="PaidAmount" Width="90"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" SortMemberPath="RemainingAmount" Width="90"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusLabel}" SortMemberPath="Status" Width="90"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="420" MinWidth="360" CanUserSort="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <WrapPanel Orientation="Horizontal" Margin="4,6">
                                        <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="عرض تفاصيل الفاتورة">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Eye" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="عرض التفاصيل" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ApproveInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="اعتماد المسودة"
                                                IsEnabled="{Binding CanApprove}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="CheckCircleOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#2E7D32"/>
                                                <TextBlock Text="اعتماد" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmCancelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="إلغاء الفاتورة"
                                                IsEnabled="{Binding CanCancel}">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Cancel" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#C62828"/>
                                                <TextBlock Text="إلغاء" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.PreviewInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="معاينة PDF — نسخة عميل">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="FileEye" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="معاينة" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="طباعة نسخة العميل عبر CustomsPrintService">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Printer" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="طباعة" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ExportInvoicePdfCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="تصدير PDF">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="FilePdfBox" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="PDF" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ViewInvoiceExpensesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="مصاريف الفاتورة">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="CashMinus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="مصاريف الفاتورة" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ViewInvoiceAttachmentsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="مرفقات الفاتورة">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Paperclip" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="مرفقات الفاتورة" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ViewInvoiceVehiclesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,6,4"
                                                FontSize="11" ToolTip="المركبات والشحنات">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="Car" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="المركبات" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlinedButton}"
                                                md:ButtonAssist.CornerRadius="6"
                                                Height="30" Padding="10,0" Margin="0,0,0,4"
                                                FontSize="11" ToolTip="حذف مسودة فقط">
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#C62828"/>
                                                <TextBlock Text="حذف مسودة" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsCancelDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="400">
                    <StackPanel>
                        <TextBlock Text="تأكيد الإلغاء" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Margin="0,0,0,12">
                            <Run Text="إلغاء الفاتورة "/>
                            <Run Text="{Binding InvoiceToCancel.InvoiceNumber, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
                        <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                                 md:HintAssist.Hint="سبب الإلغاء (اختياري)"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="إلغاء الفاتورة" Command="{Binding ExecuteCancelCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D32F2F" Foreground="White"
                                    md:ButtonAssist.CornerRadius="8" Padding="20,8" Margin="0,0,8,0"/>
                            <Button Content="رجوع" Command="{Binding CloseCancelDialogCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="حذف المسودة" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Margin="0,0,0,16">
                            <Run Text="حذف المسودة "/>
                            <Run Text="{Binding InvoiceToDelete.InvoiceNumber, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حذف" Command="{Binding ExecuteDeleteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D32F2F" Foreground="White"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- M-02: loading overlay (same pattern as Customs reports) -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True"
                         Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
