<UserControl x:Class="AlMuhasib.UI.Views.Customs.CustomsMonthlyReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث / تحديث" Command="{Binding LoadDataCommand}">
                <MenuItem.Icon><md:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}"/>
            <MenuItem Header="تصدير PDF" Command="{Binding ExportToPdfCommand}"/>
            <Separator/>
            <MenuItem Header="طباعة" Command="{Binding PrintCommand}"/>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="التقرير الشهري" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#0277BD"/>
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <controls:AnimatedStatCard Title="فواتير د.ع" TextValue="{Binding InvoicesIqd}" Icon="Cash" IconBackground="#E1F5FE" IconForeground="#0277BD" ValueForeground="#0277BD"/>
                    <controls:AnimatedStatCard Title="فواتير $" TextValue="{Binding InvoicesUsd}" Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiTealLightBrush}" IconForeground="{DynamicResource DashboardKpiTealBrush}" ValueForeground="{DynamicResource DashboardKpiTealBrush}"/>
                    <controls:AnimatedStatCard Title="مقبوضات" TextValue="{Binding ReceiptsIqd}" Icon="CashPlus" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="الربح الداخلي" TextValue="{Binding ProfitIqd}" Icon="ChartLine" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}" IconForeground="#EF6C00" ValueForeground="#EF6C00"
                                               Visibility="{Binding CanViewProfit, Converter={StaticResource BoolToVis}}"/>
                </UniformGrid>
                <controls:ChartCard Title="الفواتير اليومية" Margin="0,0,0,12">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding DailySeries}" XAxes="{Binding DailyXAxes}" YAxes="{Binding DailyYAxes}" Height="260"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" md:HintAssist.Hint="من" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" md:HintAssist.Hint="إلى" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <md:Card Grid.Row="1" md:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0" Title="اليوميات"
                    TargetDataGrid="{Binding ElementName=ReportGrid}"
                    IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                    ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                    ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                    ExportCommand="{Binding ExportToExcelCommand}"
                    PrintCommand="{Binding PrintCommand}" ShowCardToggle="False"/>
                <DataGrid x:Name="ReportGrid" Grid.Row="1" ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"/>
                        <DataGridTextColumn Header="فواتير" Binding="{Binding InvoiceCount}" Width="80"/>
                        <DataGridTextColumn Header="فواتير د.ع" Binding="{Binding InvoicesIqd, StringFormat=N0}" Width="100"/>
                        <DataGridTextColumn Header="فواتير $" Binding="{Binding InvoicesUsd, StringFormat=N2}" Width="90"/>
                        <DataGridTextColumn Header="قبض د.ع" Binding="{Binding ReceiptsIqd, StringFormat=N0}" Width="90"/>
                        <DataGridTextColumn Header="قبض $" Binding="{Binding ReceiptsUsd, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="مصروف د.ع" Binding="{Binding ExpensesIqd, StringFormat=N0}" Width="100"
                                            Visibility="{Binding DataContext.CanViewExpenses, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                        <DataGridTextColumn Header="مصروف $" Binding="{Binding ExpensesUsd, StringFormat=N2}" Width="90"
                                            Visibility="{Binding DataContext.CanViewExpenses, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                        <DataGridTextColumn Header="ربح د.ع" Binding="{Binding ProfitIqd, StringFormat=N0}" Width="90"
                                            Visibility="{Binding DataContext.CanViewProfit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                        <DataGridTextColumn Header="ربح $" Binding="{Binding ProfitUsd, StringFormat=N2}" Width="80"
                                            Visibility="{Binding DataContext.CanViewProfit, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVis}}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
