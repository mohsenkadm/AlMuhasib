<UserControl x:Class="AlMuhasib.UI.Views.SalesRepCollectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="إجمالي التحصيل" TextValue="{Binding TotalCollected}"
                                       Icon="CashPlus" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="تم التسليم" TextValue="{Binding TotalHandedOver}"
                                       Icon="CashCheck" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="متبقي للتسليم" TextValue="{Binding TotalPending}"
                                       Icon="CashClock" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
        </UniformGrid>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="تحصيلات المندوبين" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0" IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="CashPlus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تسجيل تحصيل"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource FlatButton}" md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                    <ComboBox ItemsSource="{Binding Representatives}" SelectedItem="{Binding FilterSalesRep}"
                              DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"
                              md:HintAssist.Hint="المندوب" Width="180" Margin="16,0,0,0"/>
                    <TextBox md:HintAssist.Hint="بحث..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" MinWidth="200" Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </md:Card>

        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0" Title="التحصيلات"
                                             TargetDataGrid="{Binding ElementName=CollectionsGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="CollectionsGrid" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المندوب" Binding="{Binding SalesRepresentativeName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SalesRepresentativeName"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                                            <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerFileNumber}" Width="90"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CollectionDate, StringFormat=yyyy/MM/dd}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CollectionDate"/>
                        <DataGridTextColumn Header="رقم الوصل" Binding="{Binding ReceiptNumber}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ReceiptNumber"/>
                        <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethodLabel}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentMethodLabel"/>
                        <DataGridTextColumn Header="المسلّم" Binding="{Binding HandedOverAmount, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="HandedOverAmount"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding PendingHandoverAmount, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PendingHandoverAmount"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="150" MinWidth="150"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenHandoverDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableSecondaryIconButton}"
                                                ToolTip="تسليم للصندوق"
                                                Visibility="{Binding HasPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <md:PackIcon Kind="CashCheck" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="440" MaxWidth="500">
                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                            <ComboBox ItemsSource="{Binding Representatives}" SelectedItem="{Binding EditSalesRep}"
                                      DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"
                                      md:HintAssist.Hint="المندوب *" Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding EditCustomer}"
                                      DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"
                                      md:HintAssist.Hint="العميل *" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="المبلغ *" Text="{Binding EditAmount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                            <DatePicker SelectedDate="{Binding EditCollectionDate}" Style="{StaticResource FilledDatePicker}"
                                        md:HintAssist.Hint="تاريخ التحصيل" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="رقم الوصل" Text="{Binding EditReceiptNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                            <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding EditPaymentMethod}"
                                      DisplayMemberPath="Label" Style="{StaticResource FilledComboBox}"
                                      md:HintAssist.Hint="طريقة الدفع" Margin="0,0,0,12"/>
                            <TextBox md:HintAssist.Hint="ملاحظات" Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"
                                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                            <TextBlock Text="{Binding DialogError}" Foreground="#D32F2F" Margin="0,0,0,8"
                                       Visibility="{Binding DialogError, Converter={StaticResource NullToCollapsedConverter}}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ" Command="{Binding SaveCollectionCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                        md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                                <Button Content="إلغاء" Command="{Binding CancelDialogCommand}" Style="{StaticResource FlatButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsHandoverDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="400">
                    <StackPanel>
                        <TextBlock Text="تسليم التحصيل للصندوق" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Margin="0,0,0,8" Foreground="#757575">
                            <Run Text="المتبقي: "/>
                            <Run Text="{Binding HandoverTarget.PendingHandoverAmount, StringFormat=N0, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                        <TextBox md:HintAssist.Hint="مبلغ التسليم" Text="{Binding HandoverAmount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding HandoverError}" Foreground="#D32F2F" Margin="0,0,0,8"
                                   Visibility="{Binding HandoverError, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="تسليم" Command="{Binding ConfirmHandoverCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="تسليم كامل" Command="{Binding HandoverFullCommand}" Style="{StaticResource SuccessButton}" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelHandoverCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="هل أنت متأكد من حذف هذا التحصيل؟" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حذف" Command="{Binding ExecuteDeleteCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D32F2F" Foreground="White" md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
