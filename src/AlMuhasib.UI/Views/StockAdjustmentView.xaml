<UserControl x:Class="AlMuhasib.UI.Views.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StockAdjustmentViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- HEADER -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E65100" Offset="0"/>
                            <GradientStop Color="#F57C00" Offset="0.5"/>
                            <GradientStop Color="#FF9800" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                Background="#FFFFFF22" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TuneVerticalVariant"
                                                     Width="28" Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="تسوية مخزنية"
                                       FontSize="22" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="مطابقة الكمية الفعلية مع الرصيد — الفرق يُحسب تلقائياً (مثال: رصيد 10 وإدخال 9 = -1)"
                                       FontSize="13" Foreground="#FFE0B2" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WAREHOUSE -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="اختر المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  FontSize="14" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Background="#FFF3E0" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                                <TextBlock FontSize="13" Foreground="#E65100">
                                    <Run Text="عدد التسويات:" FontWeight="SemiBold"/>
                                    <Run Text="{Binding ChangedCount, Mode=OneWay}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- TABLE -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                             Padding="0" Margin="0,0,0,16"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="12,12,0,0" Padding="16,10">
                    <TextBlock Text="كميات المنتجات"
                               FontSize="15" FontWeight="SemiBold" Foreground="#E65100"
                               VerticalAlignment="Center"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          MinHeight="200">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="#" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                       Path=(ItemsControl.AlternationIndex), StringFormat='{}{0}'}"
                                                       HorizontalAlignment="Center" Foreground="#9E9E9E"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="اسم المنتج"
                                                    Binding="{Binding ProductName, Mode=OneWay}"
                                                    Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="الكمية الحالية" Width="130" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrentQuantity, StringFormat=N0}"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#616161"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الكمية الجديدة" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Style="{StaticResource NumericCellTextBox}"
                                                     FontSize="14"
                                                     FontWeight="Bold"
                                                     Foreground="#E65100"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الفرق" Width="100" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DifferenceDisplay, Mode=OneWay}"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPositiveDifference}" Value="True">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNegativeDifference}" Value="True">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>

        <!-- ACTIONS -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                               Foreground="#C62828" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1"
                            Command="{Binding ResetChangesCommand}"
                            Style="{StaticResource OutlinedButton}"
                            Height="44" Padding="20,0" Margin="0,0,12,0"
                            materialDesign:ButtonAssist.CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Undo" Width="20" Height="20" VerticalAlignment="Center"/>
                            <TextBlock Text="إلغاء التغييرات" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            FontSize="15" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ التسوية" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="40" Height="40" Value="0"/>
                <TextBlock Text="جارٍ التحميل..." FontSize="13" Foreground="#757575"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
