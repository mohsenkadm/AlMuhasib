<UserControl x:Class="AlMuhasib.UI.Views.InventoryReplenishmentReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:services="clr-namespace:AlMuhasib.Core.Interfaces.Services;assembly=AlMuhasib.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InventoryReplenishmentReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <Border CornerRadius="16" Padding="22,18" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1976D2" Offset="0.55"/>
                            <GradientStop Color="#42A5F5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="28" Height="28"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="تقرير احتياج المخزون" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="المخزون الحالي، المبيعات خلال الفترة، والكمية المقترحة لإعادة التوريد"
                                       FontSize="12" Foreground="#E3F2FD" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <controls:AnimatedStatCard Title="أصناف في المخزن" TextValue="{Binding TotalProducts}"
                                               Icon="PackageVariant" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="إجمالي المخزون الحالي" TextValue="{Binding TotalCurrentQuantity}"
                                               Icon="Warehouse" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="الكمية المباعة" TextValue="{Binding TotalSoldQuantity}"
                                               Icon="CartArrowDown" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="كمية التوريد المقترحة" TextValue="{Binding TotalSuggestedOrder}"
                                               Icon="TruckDelivery" IconBackground="#FCE4EC" IconForeground="#C2185B" ValueForeground="#C2185B"/>
                    <controls:AnimatedStatCard Title="أصناف تحتاج توريد" TextValue="{Binding ItemsNeedingReplenishment}"
                                               Icon="AlertCircleOutline" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="قيمة التوريد المقدرة" TextValue="{Binding EstimatedOrderValue}"
                                               Icon="CashMultiple" IconBackground="#E0F7FA" IconForeground="#00838F" ValueForeground="#00838F"/>
                </UniformGrid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <controls:ChartCard Title="حالة المخزون" Grid.Column="0">
                        <controls:ChartCard.ChartContent>
                            <lvc:PieChart Series="{Binding StatusSeries}" Height="280"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>

                    <controls:ChartCard Title="أعلى 10 أصناف تحتاج توريد" Grid.Column="2">
                        <controls:ChartCard.ChartContent>
                            <lvc:CartesianChart Series="{Binding ReorderSeries}"
                                                XAxes="{Binding ReorderXAxes}"
                                                YAxes="{Binding ReorderYAxes}"
                                                Height="280"/>
                        </controls:ChartCard.ChartContent>
                    </controls:ChartCard>
                </Grid>

                <controls:ChartCard Title="مقارنة المخزون الحالي مقابل المباع (أعلى 8 أصناف)" Margin="0,0,0,20">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding ComparisonSeries}"
                                            XAxes="{Binding ComparisonXAxes}"
                                            YAxes="{Binding ComparisonYAxes}"
                                            Height="300"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <WrapPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,8"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن"
                                  Width="160" Margin="0,0,12,8"/>
                        <TextBox Text="{Binding MinimumStock, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" materialDesign:HintAssist.Hint="الحد الأدنى للمخزون"
                                 Width="130" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Filters}" SelectedValue="{Binding SelectedFilter}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="عرض"
                                  Width="160" Margin="0,0,12,8"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"
                                Margin="0,0,12,8"/>
                    </WrapPanel>
                </Border>

                <TextBlock Text="الكمية المقترحة = (الحد الأدنى + المباع خلال الفترة) − المخزون الحالي"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="تقرير احتياج المخزون"
                                             TargetDataGrid="{Binding ElementName=ReplenishmentGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>


                <DataGrid x:Name="ReplenishmentGrid"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"


                                  Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProductName"/>
                        <DataGridTextColumn Header="التصنيف" Binding="{Binding CategoryName}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CategoryName"/>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WarehouseName"/>
                        <DataGridTextColumn Header="المخزون الحالي" Binding="{Binding CurrentQuantity, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CurrentQuantity"/>
                        <DataGridTextColumn Header="المباع" Binding="{Binding QuantitySold, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="QuantitySold"/>
                        <DataGridTextColumn Header="الحد الأدنى" Binding="{Binding MinimumStock, StringFormat=N0}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="MinimumStock"/>
                        <DataGridTextColumn Header="توريد مقترح" Binding="{Binding SuggestedOrderQuantity, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SuggestedOrderQuantity"/>
                        <DataGridTextColumn Header="قيمة التوريد" Binding="{Binding EstimatedOrderValue, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="EstimatedOrderValue"/>
                        <DataGridTemplateColumn Header="الحالة" Width="110"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StatusDisplay">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="8,4" HorizontalAlignment="Center" MinWidth="72">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:InventoryReplenishmentStatus.NeedsReorder}">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static services:InventoryReplenishmentStatus.Critical}">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static services:InventoryReplenishmentStatus.NeedsReorder}">
                                                            <Setter Property="Foreground" Value="#EF6C00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static services:InventoryReplenishmentStatus.Critical}">
                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري تحميل التقرير..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
