<UserControl x:Class="AlMuhasib.UI.Views.TopProductsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TopProductsReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="أفضل / أقل المنتجات مبيعاً" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي الإيراد" TextValue="{Binding TotalRevenue}" Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="الكمية المباعة" TextValue="{Binding TotalQuantity}" Icon="PackageVariant" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="عدد الأصناف" TextValue="{Binding ProductCount}" Icon="FormatListNumbered" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                </UniformGrid>

                <controls:ChartCard Title="أعلى 10 منتجات">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Height="280"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن" Width="150" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding TopCountOptions}" SelectedItem="{Binding TopCount}" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="عدد النتائج" Width="120" Margin="0,0,12,0"/>
                        <CheckBox Content="الأكثر مبيعاً" IsChecked="{Binding ShowBestSellers}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,8,0"/>
                        <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                       ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                       ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                       TargetDataGrid="{Binding ElementName=TopProductsGrid}"
                                                       Margin="0,0,8,0"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="TopProductsGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Rank"/>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProductName"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding QuantitySold, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="QuantitySold"/>
                        <DataGridTextColumn Header="الإيراد" Binding="{Binding Revenue, StringFormat=N0}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Revenue"/>
                        <DataGridTextColumn Header="الحصة %" Binding="{Binding SharePercent, StringFormat={}{0:N1}%}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="SharePercent"/>
                    </DataGrid.Columns>
                </DataGrid>
                        <controls:PaginationBar Grid.Row="1"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
