<UserControl x:Class="AlMuhasib.UI.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:helpers="clr-namespace:AlMuhasib.UI.Helpers"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <helpers:CustomFieldSlotConverter x:Key="CustomFieldSlotConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP: Action Bar ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="إدارة الموردين" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="AccountPlus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة مورد"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>

                    <TextBox md:HintAssist.Hint="بحث..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="220" Margin="16,0,0,0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- ═══ BOTTOM: Data Grid ═══ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="1" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة الموردين"
                                             TargetDataGrid="{Binding ElementName=SuppliersGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="True"/>

                <Grid Grid.Row="1">
                <DataGrid x:Name="SuppliersGrid"
                          ItemsSource="{Binding Suppliers}"
                          SelectedItem="{Binding SelectedSupplier}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          Visibility="{Binding IsCardView, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="130"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Phone"/>
                        <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="160"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Address"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="180"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes"/>
                        <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat=yyyy/MM/dd}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CreatedAt"/>

                        <DataGridTextColumn x:Name="ColCf1" Header="حقل 1" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=1}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf2" Header="حقل 2" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=2}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf3" Header="حقل 3" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=3}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf4" Header="حقل 4" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=4}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf5" Header="حقل 5" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=5}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf6" Header="حقل 6" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=6}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf7" Header="حقل 7" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=7}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>
                        <DataGridTextColumn x:Name="ColCf8" Header="حقل 8" Width="100" Visibility="Collapsed"
                                            Binding="{Binding CustomFieldsJson, Converter={StaticResource CustomFieldSlotConverter}, ConverterParameter=8}"
                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False"/>

                        <DataGridTemplateColumn Header="الإجراءات" Width="110" MinWidth="110"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}" IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                                  Visibility="{Binding IsCardView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Suppliers}"
                                        ItemTemplate="{StaticResource SupplierCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <!-- ═══ Add/Edit Dialog ═══ -->
        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="420" MaxWidth="500">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

                        <TextBox md:HintAssist.Hint="اسم المورد *"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                        <TextBox md:HintAssist.Hint="رقم الهاتف"
                                 Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                        <TextBox md:HintAssist.Hint="العنوان"
                                 Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                        <TextBox md:HintAssist.Hint="ملاحظات"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>

                        <controls:CustomFieldsEditor Items="{Binding EditCustomFields}" Margin="0,0,0,12"
                                                     Visibility="{Binding HasCustomFields, Converter={StaticResource BoolVis}}"/>

                        <TextBlock Text="{Binding DialogError}" Foreground="#D32F2F" Margin="0,0,0,8"
                                   Visibility="{Binding DialogError, Converter={StaticResource NullToCollapsedConverter}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                            <Button Content="حفظ" Command="{Binding SaveSupplierCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDialogCommand}"
                                    Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <!-- ═══ Delete Confirmation Dialog ═══ -->
        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="2">
            <md:DialogHost.DialogContent>
                <md:Card Padding="24" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Margin="0,0,0,16">
                            <Run Text="هل أنت متأكد من حذف المورد "/>
                            <Run Text="{Binding SupplierToDelete.Name, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text="؟"/>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="حذف" Command="{Binding ExecuteDeleteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#D32F2F" Foreground="White"
                                    md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}"
                                    Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </md:Card>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
