<UserControl x:Class="AlMuhasib.UI.Views.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:b="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpeningStockViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="إضافة صف" Command="{Binding AddRowCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="حفظ" Command="{Binding SaveCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تنزيل قالب" Command="{Binding DownloadTemplateCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="FileDownloadOutline" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="استيراد من Excel" Command="{Binding ImportFromExcelCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="FileUploadOutline" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- HEADER -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1565C0" Offset="0.55"/>
                            <GradientStop Color="#1E88E5" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                Background="#FFFFFF22" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                     Width="28" Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="الأرصدة الافتتاحية للمنتجات"
                                       FontSize="22" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="كميات فقط — الموجود يُحدَّث، والجديد يُنشأ تلقائياً من الاستيراد · الباركود اختياري"
                                       FontSize="13" Foreground="#BBDEFB" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WAREHOUSE + EXCEL -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16" Margin="0,0,0,12"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Width="300"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="اختر المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  FontSize="14" />
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Command="{Binding DownloadTemplateCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="40" Padding="14,0" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    ToolTip="قالب Excel: اسم · باركود اختياري · كمية">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Foreground="#1565C0"/>
                                    <TextBlock Text="تنزيل قالب" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportFromExcelCommand}"
                                    Style="{StaticResource AccentButton}"
                                    Height="40" Padding="14,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    ToolTip="استيراد كميات جماعي عالي الأداء">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseImport" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="استيراد Excel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- IMPORT STATS -->
                <Border Margin="0,0,0,16" Padding="16" CornerRadius="14"
                        Visibility="{Binding ShowImportStats, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#E3F2FD" Offset="0"/>
                            <GradientStop Color="#F5F9FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#90CAF9"/>
                            <Setter Property="BorderThickness" Value="1"/>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChartTimelineVariant"
                                                         Width="20" Height="20"
                                                         Foreground="#1565C0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ImportPhase}"
                                           Margin="8,0,0,0" FontWeight="SemiBold"
                                           FontSize="14" Foreground="#0D47A1"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatElapsedText, StringFormat=المدة: {0}}"
                                       FontSize="12" Foreground="#546E7A"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar Height="8" Minimum="0" Maximum="100"
                                     Value="{Binding ImportProgress}"
                                     Foreground="#1E88E5"
                                     Background="#BBDEFB"
                                     Margin="0,0,0,14"/>

                        <UniformGrid Columns="5">
                            <Border Margin="4" Padding="12,10" CornerRadius="10" Background="#FFFFFF">
                                <StackPanel>
                                    <TextBlock Text="الصفوف" FontSize="11" Foreground="#78909C"/>
                                    <TextBlock Text="{Binding StatTotalRows, StringFormat=N0}"
                                               FontSize="20" FontWeight="Bold" Foreground="#37474F"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,10" CornerRadius="10" Background="#E8F5E9">
                                <StackPanel>
                                    <TextBlock Text="تحديث كمية" FontSize="11" Foreground="#2E7D32"/>
                                    <TextBlock Text="{Binding StatUpdated, StringFormat=N0}"
                                               FontSize="20" FontWeight="Bold" Foreground="#1B5E20"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,10" CornerRadius="10" Background="#E3F2FD">
                                <StackPanel>
                                    <TextBlock Text="منتجات جديدة" FontSize="11" Foreground="#1565C0"/>
                                    <TextBlock Text="{Binding StatCreated, StringFormat=N0}"
                                               FontSize="20" FontWeight="Bold" Foreground="#0D47A1"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,10" CornerRadius="10" Background="#FFF8E1">
                                <StackPanel>
                                    <TextBlock Text="غير صالح" FontSize="11" Foreground="#F9A825"/>
                                    <TextBlock Text="{Binding StatInvalid, StringFormat=N0}"
                                               FontSize="20" FontWeight="Bold" Foreground="#F57F17"/>
                                </StackPanel>
                            </Border>
                            <Border Margin="4" Padding="12,10" CornerRadius="10" Background="#FFEBEE">
                                <StackPanel>
                                    <TextBlock Text="تُجوّز" FontSize="11" Foreground="#C62828"/>
                                    <TextBlock Text="{Binding StatSkipped, StringFormat=N0}"
                                               FontSize="20" FontWeight="Bold" Foreground="#B71C1C"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="{Binding ImportStatusMessage}"
                                   Margin="4,10,4,0" FontSize="13"
                                   Foreground="#455A64" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- TABLE -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                             Padding="0" Margin="0,0,0,16"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="كميات الأرصدة"
                                             TargetDataGrid="{Binding ElementName=OpeningStockGrid}"
                                             ShowCardToggle="False"
                                             ShowExport="False"
                                             ShowPrint="False"
                                             ShowFilter="False">
                    <controls:ListTableHeaderBar.ExtraContent>
                        <Button Command="{Binding AddRowCommand}"
                                Style="{StaticResource FlatButton}"
                                Foreground="White" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة صف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </controls:ListTableHeaderBar.ExtraContent>
                </controls:ListTableHeaderBar>

                <DataGrid x:Name="OpeningStockGrid" Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          MinHeight="200"
                          b:InvoiceDataGridBehavior.Enable="True"
                          b:InvoiceDataGridBehavior.AddRowCommand="{Binding AddRowCommand}">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RowNumber}"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource HintForegroundBrush}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="اسم المنتج" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}"
                                                    ContentTemplate="{StaticResource InvoiceProductCellTemplate}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="الباركود" Width="160" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Barcode}"
                                               VerticalAlignment="Center"
                                               Margin="8,0"
                                               Foreground="{DynamicResource HintForegroundBrush}"
                                               Opacity="0.9"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="الكمية" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                             Style="{StaticResource NumericCellTextBox}"
                                             FontSize="14"
                                             FontWeight="Bold"
                                             Foreground="#1565C0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.RemoveRowCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="حذف" Foreground="#C62828"
                                            Width="28" Height="28">
                                        <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <!-- ERROR + SAVE -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                       Foreground="#C62828" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Grid.Column="1"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Height="44" Padding="28,0"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    FontSize="15" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center"/>
                    <TextBlock Text="حفظ الأرصدة" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- LOADING OVERLAY -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="44" Height="44" Value="0"
                             HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding BusyStatusText}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,8"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <ProgressBar Height="6" Minimum="0" Maximum="100"
                             Value="{Binding ImportProgress}"
                             Visibility="{Binding ShowImportStats, Converter={StaticResource BoolToVis}}"
                             Foreground="#1E88E5"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
