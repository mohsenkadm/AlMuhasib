<UserControl x:Class="AlMuhasib.UI.Views.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:b="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpeningStockViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- HEADER -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B5E20" Offset="0"/>
                            <GradientStop Color="#2E7D32" Offset="0.5"/>
                            <GradientStop Color="#43A047" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                Background="#FFFFFF22" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                     Width="28" Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="الأرصدة الافتتاحية للمنتجات"
                                       FontSize="22" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="إدخال الكمية وكلفة الشراء لكل منتج لحساب متوسط الكلفة في المبيعات والأقساط"
                                       FontSize="13" Foreground="#C8E6C9" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WAREHOUSE SELECTOR -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="اختر المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  FontSize="14" />
                    </Grid>
                </materialDesign:Card>

                <!-- ITEMS TABLE -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="0" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#E8F5E9" CornerRadius="12,12,0,0" Padding="16,10">
                            <Grid>
                                <TextBlock Text="أرصدة المنتجات"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#1B5E20"
                                           VerticalAlignment="Center"/>
                                <Button Command="{Binding AddRowCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButton}"
                                        Height="32" Padding="14,0"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="إضافة صف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="Cell"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowHeight="48"
                                  MinHeight="200"
                                  MaxHeight="500"
                                  FontSize="13"
                                  Background="White"
                                  BorderThickness="0"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  materialDesign:DataGridAssist.CellPadding="12 6"
                                  b:InvoiceDataGridBehavior.Enable="True"
                                  b:InvoiceDataGridBehavior.AddRowCommand="{Binding AddRowCommand}">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTemplateColumn Header="#" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                       Path=(ItemsControl.AlternationIndex), StringFormat='{}{0}'}"
                                                       HorizontalAlignment="Center" Foreground="#9E9E9E"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Product Name -->
                                <DataGridTextColumn Header="اسم المنتج"
                                                    Binding="{Binding ProductName, Mode=OneWay}"
                                                    Width="2*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Quantity -->
                                <DataGridTemplateColumn Header="الكمية" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="14"
                                                     FontWeight="Bold"
                                                     Foreground="#2E7D32"
                                                     Padding="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Cost -->
                                <DataGridTemplateColumn Header="كلفة الشراء" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="14"
                                                     Foreground="#1565C0"
                                                     Padding="4"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete -->
                                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveRowCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="حذف" Foreground="#C62828"
                                                    Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- ERROR + SAVE -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                               Foreground="#C62828" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            FontSize="15" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ الأرصدة" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- LOADING OVERLAY -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="40" Height="40" Value="0"/>
                <TextBlock Text="جارٍ التحميل..." FontSize="13" Foreground="#757575"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
