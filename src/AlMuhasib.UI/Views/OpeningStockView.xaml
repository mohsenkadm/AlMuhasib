<UserControl x:Class="AlMuhasib.UI.Views.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:b="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpeningStockViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- HEADER -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B5E20" Offset="0"/>
                            <GradientStop Color="#2E7D32" Offset="0.5"/>
                            <GradientStop Color="#43A047" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="12"
                                Background="#FFFFFF22" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                     Width="28" Height="28"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="الأرصدة الافتتاحية للمنتجات"
                                       FontSize="22" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="أدخل الكمية مع سعر الوحدة (يُحسب الإجمالي) أو الكمية مع الإجمالي الكلي (يُحسب سعر الوحدة)"
                                       FontSize="13" Foreground="#C8E6C9" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WAREHOUSE SELECTOR + PRICING TYPE + EXCEL -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ComboBox Width="280"
                                      ItemsSource="{Binding Warehouses}"
                                      SelectedItem="{Binding SelectedWarehouse}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="اختر المخزن"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      FontSize="14" />
                            <ComboBox Width="220" Margin="12,0,0,0"
                                      ItemsSource="{Binding PricingTypes}"
                                      SelectedItem="{Binding SelectedPricingType}"
                                      DisplayMemberPath="Name"
                                      materialDesign:HintAssist.Hint="نوع التسعير"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      Style="{StaticResource FilledComboBox}"
                                      FontSize="14"
                                      Visibility="{Binding ProductPricingEnabled, Converter={StaticResource BoolToVis}}"
                                      ToolTip="أسعار الشراء المدخلة تُحفظ حسب نوع التسعير المختار"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Command="{Binding DownloadTemplateCommand}"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="40" Padding="14,0" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    ToolTip="تنزيل قالب Excel للأرصدة الافتتاحية">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" Width="18" Height="18" VerticalAlignment="Center" Foreground="#2E7D32"/>
                                    <TextBlock Text="تنزيل قالب Excel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportFromExcelCommand}"
                                    Style="{StaticResource AccentButton}"
                                    Height="40" Padding="14,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    ToolTip="استيراد أرصدة من ملف Excel">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseImport" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="استيراد Excel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ITEMS TABLE -->
        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                             Padding="0" Margin="0,0,0,16"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أرصدة المنتجات"
                                             TargetDataGrid="{Binding ElementName=OpeningStockGrid}"
                                             ShowCardToggle="False"
                                             ShowExport="False"
                                             ShowPrint="False"
                                             ShowFilter="False">
                    <controls:ListTableHeaderBar.ExtraContent>
                        <Button Command="{Binding AddRowCommand}"
                                Style="{StaticResource FlatButton}"
                                Foreground="White" Height="32" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="إضافة صف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </controls:ListTableHeaderBar.ExtraContent>
                </controls:ListTableHeaderBar>

                <DataGrid x:Name="OpeningStockGrid" Grid.Row="1"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          MinHeight="200"
                          b:InvoiceDataGridBehavior.Enable="True"
                          b:InvoiceDataGridBehavior.AddRowCommand="{Binding AddRowCommand}">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTemplateColumn Header="#" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RowNumber}"
                                                       HorizontalAlignment="Center" Foreground="#9E9E9E"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Product Name -->
                                <DataGridTemplateColumn Header="اسم المنتج" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource InvoiceProductCellTemplate}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quantity -->
                                <DataGridTemplateColumn Header="الكمية" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Style="{StaticResource NumericCellTextBox}"
                                                     FontSize="14"
                                                     FontWeight="Bold"
                                                     Foreground="#2E7D32"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Cost -->
                                <DataGridTemplateColumn Header="سعر الوحدة" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Style="{StaticResource NumericCellTextBox}"
                                                     FontSize="14"
                                                     Foreground="#1565C0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Cost -->
                                <DataGridTemplateColumn Header="الإجمالي الكلي" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TotalCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Style="{StaticResource NumericCellTextBox}"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Foreground="#E65100"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete -->
                                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveRowCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="حذف" Foreground="#C62828"
                                                    Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <!-- ERROR + SAVE -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                               Foreground="#C62828" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" Padding="28,0"
                            materialDesign:ButtonAssist.CornerRadius="10"
                            FontSize="15" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="حفظ الأرصدة" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

        <!-- LOADING OVERLAY -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True" Width="40" Height="40" Value="0"/>
                <TextBlock Text="جارٍ التحميل..." FontSize="13" Foreground="#757575"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
