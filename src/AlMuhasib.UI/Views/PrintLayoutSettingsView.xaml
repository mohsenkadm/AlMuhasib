<UserControl x:Class="AlMuhasib.UI.Views.PrintLayoutSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             x:Name="Root"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <Style x:Key="SettingsCard" TargetType="materialDesign:Card" BasedOn="{StaticResource ElevatedCard}">
            <Setter Property="UniformCornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp2"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero header -->
        <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="14" Margin="0,0,0,16" Padding="22,18" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="16"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0D47A1" Offset="0"/>
                    <GradientStop Color="#1976D2" Offset="0.55"/>
                    <GradientStop Color="#42A5F5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="PrinterSettings" Width="28" Height="28" Foreground="White"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إعدادات الطباعة" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="الهيدر والفوتر يظهران في جميع الفواتير والتقارير المطبوعة"
                                   FontSize="12" Foreground="#E3F2FD" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Settings column -->
                <StackPanel x:Name="SettingsColumn" Grid.Column="0" Opacity="0">
                    <StackPanel.RenderTransform>
                        <TranslateTransform X="-24"/>
                    </StackPanel.RenderTransform>

                    <materialDesign:Card Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="بيانات الشركة (نص الهيدر)" FontWeight="Bold" FontSize="15" Foreground="#1565C0" Margin="0,0,0,12"/>
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="اسم الشركة" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="البريد الإلكتروني" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Details, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="تفاصيل إضافية" Style="{StaticResource FilledTextBox}"
                                     AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                            <CheckBox Content="إظهار النص في الهيدر" IsChecked="{Binding ShowHeaderText}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="صورة الهيدر" FontWeight="Bold" FontSize="15" Foreground="#1565C0" Margin="0,0,0,10"/>
                            <Border Background="#F5F7FA" CornerRadius="10" MinHeight="100" Margin="0,0,0,10">
                                <Image Source="{Binding HeaderImagePreview}" Stretch="Uniform" MaxHeight="120" Margin="8"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding PickHeaderImageCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="36" Padding="14,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImagePlus" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="اختيار صورة" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearHeaderImageCommand}" Style="{StaticResource FlatButton}" Height="36" Content="إزالة"/>
                            </StackPanel>
                            <CheckBox Content="إظهار صورة الهيدر" IsChecked="{Binding ShowHeaderImage}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="الفوتر" FontWeight="Bold" FontSize="15" Foreground="#1565C0" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding FooterText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="نص الفوتر (شكراً لتعاملكم...)"
                                     Style="{StaticResource FilledTextBox}" AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="العنوان (يظهر في الفوتر)" Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PhonePrimary, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="هاتف 1 (يظهر في الفوتر)" Style="{StaticResource FilledTextBox}"/>
                                <TextBox Grid.Column="2" Text="{Binding PhoneSecondary, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="هاتف 2 (يظهر في الفوتر)" Style="{StaticResource FilledTextBox}"/>
                            </Grid>
                            <CheckBox Content="إظهار نص الفوتر" IsChecked="{Binding ShowFooterText}" Margin="0,0,0,12"/>
                            <Border Background="#F5F7FA" CornerRadius="10" MinHeight="80" Margin="0,0,0,10">
                                <Image Source="{Binding FooterImagePreview}" Stretch="Uniform" MaxHeight="90" Margin="8"/>
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding PickFooterImageCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="36" Padding="14,0" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ImagePlus" Width="16" Height="16" VerticalAlignment="Center"/>
                                        <TextBlock Text="صورة الفوتر" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearFooterImageCommand}" Style="{StaticResource FlatButton}" Height="36" Content="إزالة"/>
                            </StackPanel>
                            <CheckBox Content="إظهار صورة الفوتر" IsChecked="{Binding ShowFooterImage}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="إعدادات الطابعة (هذا الجهاز)" FontWeight="Bold" FontSize="15" Foreground="#546E7A" Margin="0,0,0,10"/>
                            <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding SelectedPrinter}"
                                      materialDesign:HintAssist.Hint="الطابعة الافتراضية" Style="{StaticResource FilledComboBox}" Margin="0,0,0,10"/>
                            <ComboBox SelectedValue="{Binding PaperSize}" SelectedValuePath="Content"
                                      materialDesign:HintAssist.Hint="حجم الورق" Style="{StaticResource FilledComboBox}" Margin="0,0,0,10">
                                <ComboBoxItem Content="A4"/>
                                <ComboBoxItem Content="Letter"/>
                            </ComboBox>
                            <CheckBox Content="معاينة قبل الطباعة" IsChecked="{Binding ShowPrintPreview}"/>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- Preview column -->
                <materialDesign:Card x:Name="PreviewCard" Grid.Column="2" UniformCornerRadius="14" Padding="0"
                                     materialDesign:ElevationAssist.Elevation="Dp4" Opacity="0">
                    <materialDesign:Card.RenderTransform>
                        <TranslateTransform X="24"/>
                    </materialDesign:Card.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#ECEFF1" Padding="14,10" CornerRadius="14,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20" Foreground="#1565C0" Margin="0,0,8,0"/>
                                <TextBlock Text="معاينة الطباعة" FontWeight="SemiBold" Foreground="#37474F" VerticalAlignment="Center"/>
                                <TextBlock Text="— مثال تقرير" FontSize="11" Foreground="#90A4AE" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="#B0BEC5" Padding="16">
                            <Border Background="White" CornerRadius="4" Padding="0"
                                    materialDesign:ElevationAssist.Elevation="Dp8" MaxWidth="420" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                    <FlowDocumentScrollViewer Document="{Binding PreviewDocument}"
                                                              VerticalScrollBarVisibility="Disabled"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              Background="White"/>
                                </ScrollViewer>
                            </Border>
                        </Border>
                    </Grid>
                </materialDesign:Card>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0" Padding="16,12" Background="White" CornerRadius="12"
                BorderBrush="#E0E7EF" BorderThickness="1">
            <Grid>
                <Button Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Height="42" Padding="24,0"
                        IsEnabled="{Binding CanEdit}" materialDesign:ButtonAssist.CornerRadius="10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                        <TextBlock Text="حفظ الإعدادات" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#2E7D32" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource PageLoading}" Grid.RowSpan="3"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="40" Height="40"/>
        </Border>
    </Grid>
</UserControl>
