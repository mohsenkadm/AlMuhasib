<UserControl x:Class="AlMuhasib.UI.Views.SalesInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             xmlns:b="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:loyalty="clr-namespace:AlMuhasib.UI.Controls.Loyalty"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesInvoiceViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             x:Name="Root"
             Focusable="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <FrameworkElement x:Name="VmProxy" Visibility="Collapsed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- BEAUTIFUL GRADIENT HEADER                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1B5E20" Offset="0"/>
                            <GradientStop Color="#2E7D32" Offset="0.5"/>
                            <GradientStop Color="#43A047" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" Color="#1B5E20"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#26FFFFFF" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="ReceiptTextOutline" Width="28" Height="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="فاتورة مبيعات" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Foreground="#CCFFFFFF" FontSize="13">
                                <Run Text="رقم الفاتورة:"/>
                                <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="10" Background="#26FFFFFF" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="الإجمالي" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Command="{Binding OpenCurrencyChangeCommand}"
                                        Style="{StaticResource FlatButton}"
                                        Foreground="White" Padding="10,6"
                                        VerticalAlignment="Center"
                                        ToolTip="حساب الباقي بعملات الدينار العراقي (F7)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="F7" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- HEADER SECTION                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <!-- Invoice Number -->
                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Text="{Binding InvoiceNumber, Mode=OneWay}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="رقم الفاتورة"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,12,12"
                                 FontSize="14"
                                 FontFamily="Consolas"
                                 Foreground="#2E7D32"
                                 FontWeight="Bold" />

                        <!-- Date Picker -->
                        <DatePicker Grid.Row="0" Grid.Column="1"
                                    SelectedDate="{Binding InvoiceDate}"
                                    materialDesign:HintAssist.Hint="التاريخ"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource FilledDatePicker}"
                                    Margin="0,0,12,12"
                                    FontSize="14" />

                        <!-- Customer (searchable ComboBox) -->
                        <Grid Grid.Row="0" Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding FilteredCustomers}"
                                      SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="Name"
                                      Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      materialDesign:HintAssist.Hint="العميل (ابحث أو اكتب اسم جديد)"
                                      materialDesign:HintAssist.IsFloating="True"
                                      materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                      StaysOpenOnEdit="True"
                                      Style="{StaticResource FilledComboBox}"
                                      Margin="0,0,0,12"
                                      FontSize="14" />
                            <Button Grid.Column="1"
                                    Command="{Binding ShowSelectedPartyDetailsCommand}"
                                    ToolTip="تفاصيل العميل"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36"
                                    Margin="4,0,0,12"
                                    VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountDetails" Width="20" Height="20"
                                                         Foreground="#00695C"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Command="{Binding OpenQuickAddCustomerCommand}"
                                    ToolTip="إضافة عميل جديد"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Width="36" Height="36"
                                    Margin="0,0,0,12"
                                    VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Width="20" Height="20"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Button>
                        </Grid>

                        <!-- Row 1 -->
                        <!-- Warehouse -->
                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,0"
                                  FontSize="14" />

                        <!-- Payment Method — 3 Radio Buttons -->
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="طريقة الدفع:"
                                       FontSize="13"
                                       Foreground="#616161"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <RadioButton Content="نقدي"
                                         IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource PaymentMethodConverter}, ConverterParameter=Cash}"
                                         GroupName="PaymentMethod"
                                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                                         Padding="12,8"
                                         FontSize="13"
                                         Margin="0,0,6,0" />

                            <RadioButton Content="آجل"
                                         IsChecked="{Binding SelectedPaymentMethod, Converter={StaticResource PaymentMethodConverter}, ConverterParameter=Credit}"
                                         GroupName="PaymentMethod"
                                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                                         Padding="12,8"
                                         FontSize="13"
                                         Margin="0,0,6,0" />

                        </StackPanel>

                        <!-- CashBox (visible only for Cash) -->
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="الصندوق"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  FontSize="14"
                                  Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}" />

                        <!-- CreditDueDate (visible only for Credit) -->
                        <DatePicker Grid.Row="1" Grid.Column="2"
                                    SelectedDate="{Binding CreditDueDate}"
                                    materialDesign:HintAssist.Hint="تاريخ استحقاق التسديد"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource FilledDatePicker}"
                                    FontSize="14"
                                    Foreground="#C62828"
                                    Visibility="{Binding IsCreditPayment, Converter={StaticResource BoolToVis}}" />

                        <!-- Driver (feature-gated) -->
                        <ComboBox Grid.Row="2" Grid.Column="0"
                                  ItemsSource="{Binding Drivers}"
                                  SelectedItem="{Binding SelectedDriver}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="السائق"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,12,12,0"
                                  FontSize="14"
                                  Visibility="{Binding ShowDriverSelection, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </materialDesign:Card>

                <!-- Credit due-date notice -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="10"
                                     Padding="14,10"
                                     Margin="0,0,0,16"
                                     Background="#FFEBEE"
                                     materialDesign:ElevationAssist.Elevation="Dp0"
                                     Visibility="{Binding IsCreditPayment, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarAlert"
                                                 Width="20" Height="20"
                                                 Foreground="#C62828"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock FontSize="13" Foreground="#B71C1C" VerticalAlignment="Center">
                            <Run Text="فاتورة آجلة — موعد الاستحقاق:"/>
                            <Run Text="{Binding CreditDueDate, StringFormat='{}{0:yyyy/MM/dd}', FallbackValue='غير محدد'}"
                                 FontWeight="Bold"/>
                            <Run Text="— سيُدرج في تقرير المتأخرات عند التأخر"/>
                        </TextBlock>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ITEMS TABLE                                    -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="0"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="14,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F1F8F4" Offset="0"/>
                                    <GradientStop Color="#FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="بنود الفاتورة"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#2E7D32"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Width="240" Background="#E8F5E9" CornerRadius="8" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="BarcodeScan" Width="18" Height="18"
                                                                     Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="الباركود + Enter"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0" Background="Transparent" FontSize="13"
                                                     b:EnterKeyCommandBehavior.Command="{Binding ProcessBarcodeCommand}"/>
                                        </Grid>
                                    </Border>
                                    <Button Command="{Binding OpenProductPickerCommand}"
                                            Style="{StaticResource AccentButton}"
                                            Height="32" Padding="14,0" Margin="0,0,8,0"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CartPlus" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="اختيار المنتجات" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding CheckProfitCommand}"
                                            Style="{StaticResource FlatButton}"
                                            Height="32" Padding="14,0" Margin="0,0,8,0"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            ToolTip="فحص ربح وخسارة مواد الفاتورة">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16" VerticalAlignment="Center" Foreground="#2E7D32"/>
                                            <TextBlock Text="فحص الربح" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#2E7D32"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AddRowCommand}"
                                            Style="{StaticResource FlatButton}"
                                            Height="32" Padding="14,0"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            ToolTip="إضافة صف فارغ للكتابة اليدوية">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="صف يدوي" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Items DataGrid -->
                        <DataGrid x:Name="SalesItemsGrid"
                                  Grid.Row="1"
                                  Style="{StaticResource InvoiceItemsDataGrid}"
                                  ItemsSource="{Binding Items}"
                                  b:InvoiceDataGridBehavior.Enable="True"
                                  b:InvoiceDataGridBehavior.AddRowCommand="{Binding AddRowCommand}">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTemplateColumn Header="#" Width="45" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                       Path=(ItemsControl.AlternationIndex),
                                                       StringFormat='{}{0}'}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#9E9E9E" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="المنتج" Width="200" MinWidth="160"
                                                        CellTemplate="{StaticResource InvoiceProductCellTemplate}"/>

                                <!-- أعمدة الميزات: مخفية افتراضياً؛ يزامنها InvoiceFeatureColumnSync حسب الأعلام -->
                                <DataGridTemplateColumn x:Name="ColCustomField1" Width="100" MinWidth="80"
                                                        Visibility="Collapsed">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{Binding DataContext.CustomField1Header, ElementName=Root}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding CustomField1, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericCellTextBox}"
                                                     ToolTip="{Binding CustomField1Label}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColCustomField2" Width="110" MinWidth="90"
                                                        Visibility="Collapsed">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{Binding DataContext.CustomField2Header, ElementName=Root}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <ComboBox ItemsSource="{Binding AvailableColors}"
                                                          SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}"
                                                          DisplayMemberPath="ColorName"
                                                          IsEditable="False"
                                                          ToolTip="اختر اللون"
                                                          Visibility="{Binding DataContext.ShowClothingSizes, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
                                                <TextBox Text="{Binding CustomField2, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="{Binding CustomField2Label}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource NumericCellTextBox}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.ShowClothingSizes, ElementName=Root}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColUsageInstructions" Header="طريقة الاستخدام" Width="160" MinWidth="120"
                                                        Visibility="Collapsed" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UsageInstructions}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="48"
                                                       VerticalAlignment="Center"
                                                       ToolTip="{Binding UsageInstructions}"
                                                       Foreground="#546E7A"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColUnit" Header="التعبئة" Width="100"
                                                        Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableUnits}"
                                                      SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="UnitName"
                                                      IsEditable="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColBatch" Header="الدفعة" Width="110"
                                                        Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailableBatches}"
                                                      SelectedItem="{Binding SelectedBatch, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <Run Text="{Binding BatchNumber, TargetNullValue=بدون}"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding ExpiryDate, StringFormat=yyyy/MM/dd, TargetNullValue=-}"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding Quantity, StringFormat=N0}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColSerial" Header="سيريال" Width="120"
                                                        Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericCellTextBox}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn x:Name="ColPricingType" Header="نوع التسعير" Width="150" MinWidth="120"
                                                        Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding AvailablePricingOptions}"
                                                      SelectedItem="{Binding SelectedPricingOption, UpdateSourceTrigger=PropertyChanged}"
                                                      DisplayMemberPath="Display"
                                                      IsEditable="False"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الكمية" Width="140"
                                                        CellTemplate="{StaticResource InvoiceQuantityCellTemplate}"/>

                                <DataGridTemplateColumn Header="سعر الوحدة" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Style="{StaticResource NumericCellTextBox}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الخصم" Width="90" IsReadOnly="True"
                                                        Visibility="{Binding DataContext.ShowProductDiscount, Source={x:Reference VmProxy}, Converter={StaticResource BoolToVis}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiscountAmount, StringFormat=N0}"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#2E7D32"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="الإجمالي" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TotalPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     Style="{StaticResource NumericCellTextBox}"
                                                     FontWeight="SemiBold"
                                                     Foreground="#2E7D32" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="" Width="44" IsReadOnly="True"
                                                        CellTemplate="{StaticResource InvoiceProductDetailsRowCellTemplate}"/>
                                <DataGridTemplateColumn Header="" Width="52" IsReadOnly="True"
                                                        CellTemplate="{StaticResource InvoiceDeleteRowCellTemplate}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ITEMS SUMMARY                                  -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="8" Background="#F5F5F5" Padding="16,8" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="عدد الأصناف:" FontSize="13" Foreground="#616161" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalItemCount}" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <TextBlock Text="إجمالي الكميات:" FontSize="13" Foreground="#616161" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding TotalQuantity, StringFormat=N0}" FontSize="14" FontWeight="Bold" Foreground="#1B5E20" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Invoice weight card (feature-gated: MenuWeight) -->
                <materialDesign:Card UniformCornerRadius="12" Padding="0" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Visibility="{Binding ShowMenuWeight, Converter={StaticResource BoolToVis}}">
                    <Border CornerRadius="12" Padding="18,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E0F7FA" Offset="0"/>
                                <GradientStop Color="#B2EBF2" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="12" Background="#00838F" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ScaleBalance" Width="26" Height="26"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="وزن الفاتورة" FontSize="15" FontWeight="Bold" Foreground="#006064"/>
                                <TextBlock Text="{Binding InvoiceWeightSummaryText}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="#004D40" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="يُحدَّث تلقائياً عند إضافة أو حذف أو تغيير كمية المنتجات"
                                           FontSize="11" Foreground="#00838F" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- FOOTER / TOTALS                                -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Notes -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ملاحظات"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Margin="0,0,20,0"
                                 VerticalAlignment="Top" />

                        <!-- Totals panel -->
                        <Border Grid.Column="1"
                                CornerRadius="12"
                                Padding="22,18"
                                MinWidth="320">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E8F5E9" Offset="0"/>
                                    <GradientStop Color="#C8E6C9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>

                                <!-- Subtotal -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="المجموع:"
                                               FontSize="14"
                                               Foreground="#616161"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="14"
                                               Foreground="#424242"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Invoice-level discount (feature-gated) -->
                                <StackPanel Margin="0,0,0,10"
                                            Visibility="{Binding ShowProductDiscount, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="خصم الفاتورة" FontSize="13" FontWeight="SemiBold" Foreground="#1B5E20" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding InvoiceDiscountTypeOptions}"
                                              SelectedItem="{Binding SelectedInvoiceDiscountOption}"
                                              DisplayMemberPath="Label"
                                              Margin="0,0,0,6"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                    <TextBox Text="{Binding InvoiceDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="قيمة الخصم الكلي"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="مبلغ الخصم:" FontSize="13" Foreground="#2E7D32" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding InvoiceDiscountAmount, StringFormat='{}{0:N0} د.ع'}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"/>
                                    </Grid>
                                </StackPanel>

                                <loyalty:LoyaltyPanel DataContext="{Binding}"/>

                                <Grid Margin="0,0,0,10"
                                      Visibility="{Binding ShowLoyaltyPanel, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="خصم الولاء:" FontSize="13" Foreground="#C62828" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding LoyaltyDiscountAmount, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#C62828"/>
                                </Grid>

                                <!-- Rounding -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="التقريب (لصالح العميل):"
                                                   FontSize="13"
                                                   Foreground="#2E7D32"
                                                   VerticalAlignment="Center" />
                                        <materialDesign:PackIcon Kind="ArrowDown"
                                                                 Width="14" Height="14"
                                                                 Foreground="#2E7D32"
                                                                 VerticalAlignment="Center"
                                                                 Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RoundingAmount, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="13"
                                               Foreground="#2E7D32"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Transport fee -->
                                <Grid Margin="0,0,0,10"
                                      Visibility="{Binding ShowTransportFee, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="أجور النقل:" FontSize="13"
                                               Foreground="#1565C0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding TransportFeeAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                             Style="{StaticResource NumericCellTextBox}"
                                             materialDesign:HintAssist.Hint="0"/>
                                </Grid>

                                <Separator Margin="0,4,0,12" Background="#C8E6C9" />

                                <!-- Grand Total -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="الإجمالي النهائي:"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1B5E20"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#1B5E20"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ACTION BUTTONS                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card UniformCornerRadius="12" Padding="14,12" Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="#C62828"
                                   FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button Command="{Binding OpenCurrencyChangeCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="14,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="حساب الباقي بعملات الدينار العراقي (F7)">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="حساب العملات (F7)" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenInvoiceSearchCommand}" Style="{StaticResource AccentButton}"
                                        Height="42" Padding="18,0" Margin="0,0,10,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        FontWeight="SemiBold"
                                        ToolTip="بحث سريع عن فاتورة للتعديل">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileSearchOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="بحث فواتير" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenTemplatePickerCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="14,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="تحميل قالب محفوظ">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="قوالب" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenSaveTemplateDialogCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="14,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="حفظ الفاتورة الحالية كقالب">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveSettings" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="حفظ قالب" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddToQueueCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="14,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="إرسال الفاتورة الحالية إلى قائمة الانتظار">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlaylistPlus" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="إضافة للانتظار" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenQueuePickerCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="14,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="عرض قائمة الانتظار">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlaylistPlay" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="قائمة الانتظار" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SetDefaultCustomerFromInvoiceCommand}" Style="{StaticResource FlatButton}"
                                        Height="40" Padding="12,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="تعيين العميل المحدد كافتراضي">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountStar" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="عميل افتراضي" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NewInvoiceCommand}" Style="{StaticResource FlatButton}"
                                        Height="40" Padding="16,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="جديد" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding PrintInvoiceCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="16,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"/>
                                        <TextBlock Text="طباعة" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SendInvoiceWhatsAppCommand}" Style="{StaticResource OutlinedButton}"
                                        Height="40" Padding="16,0" Margin="0,0,8,0"
                                        materialDesign:ButtonAssist.CornerRadius="10"
                                        ToolTip="إرسال نسخة PDF عبر واتساب">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Whatsapp" Width="18" Height="18" VerticalAlignment="Center" Foreground="#25D366"/>
                                        <TextBlock Text="واتساب" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding SaveInvoiceCommand}" Style="{StaticResource SuccessButton}"
                                        Height="40" Padding="22,0" materialDesign:ButtonAssist.CornerRadius="10"
                                        FontWeight="SemiBold" IsEnabled="{Binding CanSave}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <TextBlock Text="حفظ الفاتورة" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                    </Grid>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOADING OVERLAY                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جارٍ الحفظ..."
                           FontSize="13"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- PRODUCT PICKER                                 -->
        <!-- ═══════════════════════════════════════════ -->
        <controls:ProductPickerOverlay Panel.ZIndex="120"
                                       DataContext="{Binding ProductPicker}"
                                       IsOpen="{Binding DataContext.IsProductPickerOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

        <controls:InvoiceSearchSidePanel Panel.ZIndex="140"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch"
                                         IsOpen="{Binding IsInvoiceSearchOpen, Mode=TwoWay}"
                                         CloseCommand="{Binding CloseInvoiceSearchCommand}"
                                         SelectInvoiceCommand="{Binding SelectInvoiceFromSearchCommand}"
                                         PanelTitle="بحث فواتير المبيعات"
                                         HeaderColorStart="#1B5E20"
                                         HeaderColorEnd="#43A047"/>

        <!-- قوالب الفواتير -->
        <Grid Visibility="{Binding IsTemplatePickerOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="130">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="20" MinWidth="400" MaxWidth="520" MaxHeight="480"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="14" materialDesign:ElevationAssist.Elevation="Dp8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="قوالب فاتورة المبيعات" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SavedTemplates}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding LineCountText}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.LoadTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}"
                                                    Height="32" Padding="12,0" Margin="0,0,6,0" Content="تحميل"/>
                                            <Button Command="{Binding DataContext.DeleteTemplateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                                                    ToolTip="حذف"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2" Command="{Binding CloseTemplatePickerCommand}" Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Content="إغلاق"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <Grid Visibility="{Binding IsSaveTemplateDialogOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="135">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="24" MinWidth="360" MaxWidth="420"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="14" materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <TextBlock Text="حفظ كقالب" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="اسم القالب"
                             Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Command="{Binding ConfirmSaveTemplateCommand}" Style="{StaticResource PrimaryButton}"
                                Content="حفظ" Padding="20,8" Margin="0,0,8,0"/>
                        <Button Command="{Binding CloseSaveTemplateDialogCommand}" Style="{StaticResource FlatButton}" Content="إلغاء"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <Grid Visibility="{Binding IsQueuePickerOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="136">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="20" MinWidth="400" MaxWidth="540" MaxHeight="500"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="14" materialDesign:ElevationAssist.Elevation="Dp8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="قائمة انتظار فواتير المبيعات" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="بحث في قائمة الانتظار"
                                 Text="{Binding QueueSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource PrimaryCheckBox}"
                                  Content="الأحدث أولاً"
                                  IsChecked="{Binding QueueSortNewestFirst}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding QueueItems}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" Margin="0,0,0,6" CornerRadius="8"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding SummaryText, Mode=OneWay}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.LoadFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}"
                                                    Height="32" Padding="12,0" Margin="0,0,6,0" Content="متابعة"/>
                                            <Button Command="{Binding DataContext.DeleteFromQueueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}" ToolTip="حذف"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Command="{Binding CloseQueuePickerCommand}" Style="{StaticResource FlatButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0" Content="إغلاق"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ═══════════════════════════════════════════ -->
        <!-- QUICK ADD CUSTOMER DIALOG                      -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsQuickAddCustomerOpen, Converter={StaticResource BoolToVis}}"
              Panel.ZIndex="100">
            <Border Background="#80000000" />
            <materialDesign:Card Padding="24" MinWidth="420" MaxWidth="500"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="16"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <TextBlock Text="إضافة عميل جديد" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>

                    <TextBox materialDesign:HintAssist.Hint="اسم العميل *"
                             Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <TextBox materialDesign:HintAssist.Hint="رقم الهاتف"
                             Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <TextBox materialDesign:HintAssist.Hint="العنوان"
                             Text="{Binding QuickCustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding QuickCustomerError}" Foreground="#D32F2F" Margin="0,0,0,8"
                               Visibility="{Binding QuickCustomerError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickCustomerCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddCustomerCommand}"
                                Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
