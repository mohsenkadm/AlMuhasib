<UserControl x:Class="AlMuhasib.UI.Views.CashBankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:enums="clr-namespace:AlMuhasib.Core.Enums;assembly=AlMuhasib.Core"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CashBankViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="تحديث الكل" Command="{Binding RefreshAllCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="إضافة صندوق" Command="{Binding ShowAddCashBoxCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="CashPlus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="إضافة حساب بنكي" Command="{Binding ShowAddBankCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="BankPlus" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تحويل بين الحسابات" Command="{Binding CreateTransferCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير الصناديق" Command="{Binding ExportCashBoxesCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة الصناديق" Command="{Binding PrintCashBoxesCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:TransferAccountTypeToTextConverter x:Key="AccountTypeToText" />
    </UserControl.Resources>

    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                    Style="{StaticResource ModernTabs}">

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 0: الصناديق (Cash Boxes)                            -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Safe" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="الصناديق" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: CashBox list -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Column="0" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Padding="16,12"
                                    CornerRadius="12,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الصناديق" FontSize="16" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshAllCommand}"
                                            Style="{StaticResource IconButton}"
                                            Width="36" Height="36"
                                            ToolTip="تحديث القاصات والحركات"
                                            Foreground="White"
                                            VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- List -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding CashBoxes}"
                                     SelectedItem="{Binding SelectedCashBox}"
                                     Margin="0" Padding="8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Balance, StringFormat=N0}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add / Edit CashBox panel -->
                            <StackPanel Grid.Row="2" Margin="12,8">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8"
                                           Visibility="{Binding IsAddCashBoxVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <Button Content="إضافة صندوق" Command="{Binding ShowAddCashBoxCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanAdd}" />
                                    <Button Content="تعديل" Command="{Binding ShowEditCashBoxCommand}"
                                            Style="{StaticResource OutlinedButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanEdit}" />
                                    <Button Content="حذف" Command="{Binding DeleteCashBoxCommand}"
                                            Style="{StaticResource FlatButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanDelete}" />
                                    <Button Command="{Binding ShowAdjustCashBoxCommand}"
                                            Style="{StaticResource OutlinedButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanEdit}"
                                            ToolTip="تسوية رصيد الصندوق بقيد موثّق">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ScaleBalance" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="تسوية" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <!-- Add / Edit form -->
                                <StackPanel Visibility="{Binding IsAddCashBoxVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding NewCashBoxName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="اسم الصندوق"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding NewCashBoxBalance, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="الرصيد الافتتاحي"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13" Margin="0,0,0,8"
                                             IsEnabled="{Binding IsEditCashBoxMode, Converter={StaticResource InverseBooleanConverter}}" />
                                    <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                              SelectedItem="{Binding SelectedCashBoxCurrencyOption}"
                                              DisplayMemberPath="DisplayName"
                                              materialDesign:HintAssist.Hint="عملة القاصة"
                                              Style="{StaticResource FilledComboBox}"
                                              FontSize="13" Margin="0,0,0,8"
                                              IsEnabled="{Binding IsEditCashBoxMode, Converter={StaticResource InverseBooleanConverter}}"
                                              Visibility="{Binding ShowMultiCurrency, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="حفظ" Command="{Binding SaveCashBoxCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0" />
                                        <Button Content="إلغاء" Command="{Binding CancelAddCashBoxCommand}"
                                                Style="{StaticResource FlatButton}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- تسوية رصيد -->
                                <Border Margin="0,8,0,0" Padding="10" CornerRadius="8"
                                        Background="{DynamicResource BackgroundBrush}"
                                        Visibility="{Binding ShowCashAdjustPanel, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="تسوية رصيد (موجب = زيادة / سالب = نقصان)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding AdjustAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="المبلغ (+/-)"
                                                 Style="{StaticResource NumericTextBox}" Margin="0,0,0,8"/>
                                        <DatePicker SelectedDate="{Binding AdjustDate}"
                                                    materialDesign:HintAssist.Hint="التاريخ"
                                                    Style="{StaticResource FilledDatePicker}" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="سبب التسوية (إلزامي)"
                                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="حفظ التسوية" Command="{Binding SaveAdjustBalanceCommand}"
                                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                            <Button Content="إلغاء" Command="{Binding CancelAdjustBalanceCommand}"
                                                    Style="{StaticResource FlatButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Right: Transaction history -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Column="2" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:ListTableHeaderBar Grid.Row="0"
                                                         Title="كشف حساب الصندوق"
                                                         TargetDataGrid="{Binding ElementName=CashBoxTransactionsGrid}"
                                                         IsFilterPanelOpen="{Binding IsCashBoxColumnFilterPanelOpen, Mode=TwoWay}"
                                                         ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                         ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                         ExportCommand="{Binding ExportCashBoxTransactionsCommand}"
                                                         PrintCommand="{Binding PrintCashBoxTransactionsCommand}"
                                                         ShowCardToggle="False"/>

                            <Border Grid.Row="1" Style="{StaticResource FilterBar}" Margin="8,8,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             materialDesign:HintAssist.Hint="بحث (النوع، المرجع، الوصف)"
                                             Text="{Binding CashBoxSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13"/>
                                    <DatePicker Grid.Column="2"
                                                materialDesign:HintAssist.Hint="من تاريخ"
                                                SelectedDate="{Binding CashBoxFromDate}"
                                                Style="{StaticResource FilledDatePicker}"/>
                                    <DatePicker Grid.Column="4"
                                                materialDesign:HintAssist.Hint="إلى تاريخ"
                                                SelectedDate="{Binding CashBoxToDate}"
                                                Style="{StaticResource FilledDatePicker}"/>
                                    <Button Grid.Column="6"
                                            Command="{Binding ClearCashBoxFiltersCommand}"
                                            ToolTip="مسح الفلاتر"
                                            Style="{StaticResource FlatButton}">
                                        <materialDesign:PackIcon Kind="FilterRemoveOutline"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="CashBoxTransactionsGrid"
                                      Grid.Row="2" ItemsSource="{Binding CashBoxTransactions}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="True" CanUserReorderColumns="False"
                                      materialDesign:DataGridAssist.CellPadding="10 6"
                                      HeadersVisibility="Column" FontSize="13" Margin="8,8,8,0"
                                      MinHeight="220"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsCashBoxColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding OpenSourceDocumentCommand}"
                                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date" />
                                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Type" />
                                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Reference" />
                                    <DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}" Width="110"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PartyName" />
                                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N0}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Credit">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N0}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Debit">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N0}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RunningBalance">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description" />
                                    <DataGridTemplateColumn Header="إجراء" Width="90"
                                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ReverseMovementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}"
                                                        Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="عكس / حذف">
                                                    <materialDesign:PackIcon Kind="Undo" Width="16" Height="16"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" Padding="10,10,10,12"
                                    BorderBrush="#E3EDF7" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12" Margin="0,8,0,0">
                                <UniformGrid Columns="4">
                                    <controls:AnimatedStatCard Title="عدد الحركات"
                                                                 Value="{Binding CashBoxFilteredCount}"
                                                                 Icon="FormatListNumbered"
                                                                 IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                                                 IconForeground="#1565C0"
                                                                 ValueForeground="#1565C0"
                                                                 Margin="4,0"/>
                                    <controls:AnimatedStatCard Title="إجمالي الدائن"
                                                                 Value="{Binding CashBoxFilteredCredit}"
                                                                 Icon="CashPlus"
                                                                 IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                                 IconForeground="#2E7D32"
                                                                 ValueForeground="#2E7D32"
                                                                 Margin="4,0"/>
                                    <controls:AnimatedStatCard Title="إجمالي المدين"
                                                                 Value="{Binding CashBoxFilteredDebit}"
                                                                 Icon="CashMinus"
                                                                 IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                                                 IconForeground="#C62828"
                                                                 ValueForeground="#C62828"
                                                                 Margin="4,0"/>
                                    <controls:AnimatedStatCard Title="الصافي"
                                                                 Value="{Binding CashBoxFilteredNet}"
                                                                 Icon="ScaleBalance"
                                                                 IconBackground="{DynamicResource NotepadPaperBrush}"
                                                                 IconForeground="#F9A825"
                                                                 ValueForeground="#F57F17"
                                                                 Margin="4,0"/>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 1: البنوك (Banks)                                 -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Bank" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="البنوك" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Bank list -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Column="0" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#1565C0" Padding="16,12"
                                    CornerRadius="12,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="البنوك" FontSize="16" FontWeight="Bold"
                                               Foreground="White" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding RefreshAllCommand}"
                                            Style="{StaticResource IconButton}"
                                            Width="36" Height="36"
                                            ToolTip="تحديث المصارف والحركات"
                                            Foreground="White"
                                            VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ListBox Grid.Row="1" ItemsSource="{Binding BankAccounts}"
                                     SelectedItem="{Binding SelectedBankAccount}"
                                     Margin="0" Padding="8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                                       FontSize="14" FontWeight="Medium" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Balance, StringFormat=N0}"
                                                       FontSize="14" FontWeight="Bold"
                                                       Foreground="#1565C0" Margin="8,0,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                       Text="{Binding AccountNumber}" FontSize="11"
                                                       Foreground="Gray" Margin="0,2,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Add Bank panel -->
                            <StackPanel Grid.Row="2" Margin="12,8">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8"
                                           Visibility="{Binding IsAddBankVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <Button Content="إضافة بنك" Command="{Binding ShowAddBankCommand}"
                                            Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanAdd}" />
                                    <Button Content="تعديل" Command="{Binding ShowEditBankCommand}"
                                            Style="{StaticResource OutlinedButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanEdit}" />
                                    <Button Content="حذف" Command="{Binding DeleteBankCommand}"
                                            Style="{StaticResource FlatButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanDelete}" />
                                    <Button Command="{Binding ShowAdjustBankCommand}"
                                            Style="{StaticResource OutlinedButton}"
                                            Margin="0,0,8,8"
                                            IsEnabled="{Binding CanEdit}"
                                            ToolTip="تسوية رصيد المصرف بقيد موثّق">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ScaleBalance" Width="16" Height="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="تسوية" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>

                                <StackPanel Visibility="{Binding IsAddBankVisible, Converter={StaticResource BoolToVis}}">
                                    <TextBox Text="{Binding NewBankName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="اسم البنك"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding NewBankAccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="رقم الحساب (اختياري)"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13" Margin="0,0,0,8" />
                                    <TextBox Text="{Binding NewBankBalance, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="الرصيد الافتتاحي"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13" Margin="0,0,0,8"
                                             IsEnabled="{Binding IsEditBankMode, Converter={StaticResource InverseBooleanConverter}}" />
                                    <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                              SelectedItem="{Binding SelectedBankCurrencyOption}"
                                              DisplayMemberPath="DisplayName"
                                              materialDesign:HintAssist.Hint="عملة الحساب"
                                              Style="{StaticResource FilledComboBox}"
                                              FontSize="13" Margin="0,0,0,8"
                                              IsEnabled="{Binding IsEditBankMode, Converter={StaticResource InverseBooleanConverter}}"
                                              Visibility="{Binding ShowMultiCurrency, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="حفظ" Command="{Binding SaveBankCommand}"
                                                Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,0" />
                                        <Button Content="إلغاء" Command="{Binding CancelAddBankCommand}"
                                                Style="{StaticResource FlatButton}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Margin="0,8,0,0" Padding="10" CornerRadius="8"
                                        Background="{DynamicResource BackgroundBrush}"
                                        Visibility="{Binding ShowBankAdjustPanel, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="تسوية رصيد المصرف (+/-)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding AdjustAmount, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="المبلغ (+/-)"
                                                 Style="{StaticResource NumericTextBox}" Margin="0,0,0,8"/>
                                        <DatePicker SelectedDate="{Binding AdjustDate}"
                                                    materialDesign:HintAssist.Hint="التاريخ"
                                                    Style="{StaticResource FilledDatePicker}" Margin="0,0,0,8"/>
                                        <TextBox Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="سبب التسوية (إلزامي)"
                                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="حفظ التسوية" Command="{Binding SaveAdjustBalanceCommand}"
                                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                            <Button Content="إلغاء" Command="{Binding CancelAdjustBalanceCommand}"
                                                    Style="{StaticResource FlatButton}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Right: Bank transaction history -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Column="2" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:ListTableHeaderBar Grid.Row="0"
                                                         Title="كشف حساب البنك"
                                                         TargetDataGrid="{Binding ElementName=BankTransactionsGrid}"
                                                         IsFilterPanelOpen="{Binding IsBankColumnFilterPanelOpen, Mode=TwoWay}"
                                                         ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                         ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                         ExportCommand="{Binding ExportBankTransactionsCommand}"
                                                         PrintCommand="{Binding PrintBankTransactionsCommand}"
                                                         ShowCardToggle="False"/>

                            <Border Grid.Row="1" Style="{StaticResource FilterBar}" Margin="8,8,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MinWidth="160"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             materialDesign:HintAssist.Hint="بحث (النوع، المرجع، الوصف)"
                                             Text="{Binding BankSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FilledTextBox}"
                                             FontSize="13"/>
                                    <DatePicker Grid.Column="2"
                                                materialDesign:HintAssist.Hint="من تاريخ"
                                                SelectedDate="{Binding BankFromDate}"
                                                Style="{StaticResource FilledDatePicker}"/>
                                    <DatePicker Grid.Column="4"
                                                materialDesign:HintAssist.Hint="إلى تاريخ"
                                                SelectedDate="{Binding BankToDate}"
                                                Style="{StaticResource FilledDatePicker}"/>
                                    <CheckBox Grid.Column="6"
                                              Content="غير المسوّاة فقط"
                                              IsChecked="{Binding ShowUnreconciledOnly}"
                                              VerticalAlignment="Center"
                                              FontSize="12"/>
                                    <Button Grid.Column="8"
                                            Command="{Binding ClearBankFiltersCommand}"
                                            ToolTip="مسح الفلاتر"
                                            Style="{StaticResource FlatButton}">
                                        <materialDesign:PackIcon Kind="FilterRemoveOutline"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <DataGrid x:Name="BankTransactionsGrid"
                                      Grid.Row="2" ItemsSource="{Binding BankTransactions}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="True" CanUserReorderColumns="False"
                                      materialDesign:DataGridAssist.CellPadding="10 6"
                                      HeadersVisibility="Column" FontSize="13" Margin="8,8,8,0"
                                      MinHeight="220"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsBankColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding OpenSourceDocumentCommand}"
                                                  CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </DataGrid.InputBindings>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date" />
                                    <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Type" />
                                    <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Reference" />
                                    <DataGridTextColumn Header="الطرف" Binding="{Binding PartyName}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PartyName" />
                                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N0}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Credit">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N0}" Width="90"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Debit">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Red" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N0}" Width="100"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RunningBalance" />
                                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description" />
                                    <DataGridTemplateColumn Header="التسوية" Width="120"
                                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="—"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource HintForegroundBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsVoucher}" Value="True">
                                                                        <Setter Property="Text" Value="غير مسوّى"/>
                                                                        <Setter Property="Foreground" Value="#EF6C00"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsReconciled}" Value="True">
                                                                        <Setter Property="Text" Value="مسوّى"/>
                                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Command="{Binding DataContext.ToggleReconcileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource FlatButton}"
                                                            Visibility="{Binding IsVoucher, Converter={StaticResource BoolToVis}}"
                                                            ToolTip="تبديل التسوية البنكية">
                                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="عكس" Width="70"
                                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ReverseMovementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}"
                                                        Visibility="{Binding CanReverse, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="عكس">
                                                    <materialDesign:PackIcon Kind="Undo" Width="16" Height="16"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" Padding="10,10,10,12"
                                    BorderBrush="#E3EDF7" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,12,12" Margin="0,8,0,0">
                                <UniformGrid Columns="4">
                                    <controls:AnimatedStatCard Title="عدد الحركات"
                                                                 Value="{Binding BankFilteredCount}"
                                                                 Icon="FormatListNumbered"
                                                                 IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                                                                 IconForeground="#1565C0"
                                                                 ValueForeground="#1565C0"
                                                                 Margin="4,0"/>
                                    <controls:AnimatedStatCard Title="إجمالي الدائن"
                                                                 Value="{Binding BankFilteredCredit}"
                                                                 Icon="CashPlus"
                                                                 IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                                                                 IconForeground="#2E7D32"
                                                                 ValueForeground="#2E7D32"
                                                                 Margin="4,0"/>
                                    <controls:AnimatedStatCard Title="إجمالي المدين"
                                                                 Value="{Binding BankFilteredDebit}"
                                                                 Icon="CashMinus"
                                                                 IconBackground="{DynamicResource DashboardKpiRedLightBrush}"
                                                                 IconForeground="#C62828"
                                                                 ValueForeground="#C62828"
                                                                 Margin="4,0"/>
                                    <controls:AnimatedStatCard Title="الصافي"
                                                                 Value="{Binding BankFilteredNet}"
                                                                 Icon="ScaleBalance"
                                                                 IconBackground="{DynamicResource NotepadPaperBrush}"
                                                                 IconForeground="#F9A825"
                                                                 ValueForeground="#F57F17"
                                                                 Margin="4,0"/>
                                </UniformGrid>
                            </Border>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

            <!-- ═══════════════════════════════════════════ -->
            <!-- TAB 2: التحويلات (Transfers)                           -->
            <!-- ═══════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="التحويلات" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- New transfer form -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" UniformCornerRadius="12" Padding="20"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="تحويل جديد" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />

                            <!-- From / To row -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- FROM -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="من" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  SelectedValue="{Binding TransferFromType}"
                                                  SelectedValuePath="Tag"
                                                  materialDesign:HintAssist.Hint="النوع"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13" Margin="0,0,8,0" Width="120">
                                            <ComboBoxItem Content="صندوق" Tag="{x:Static enums:TransferAccountType.CashBox}" />
                                            <ComboBoxItem Content="بنك" Tag="{x:Static enums:TransferAccountType.Bank}" />
                                        </ComboBox>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TransferFromAccounts}"
                                                  SelectedItem="{Binding TransferFromAccount}"
                                                  materialDesign:HintAssist.Hint="الحساب"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Name}" />
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{Binding TransferFromBalanceText}" FontSize="11"
                                               Foreground="Gray" Margin="0,4,0,0" />
                                </StackPanel>

                                <!-- Arrow -->
                                <materialDesign:PackIcon Grid.Column="1" Kind="ArrowLeftBold"
                                                          Width="32" Height="32"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{DynamicResource PrimaryHueMidBrush}" />

                                <!-- TO -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="إلى" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0"
                                                  SelectedValue="{Binding TransferToType}"
                                                  SelectedValuePath="Tag"
                                                  materialDesign:HintAssist.Hint="النوع"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13" Margin="0,0,8,0" Width="120">
                                            <ComboBoxItem Content="صندوق" Tag="{x:Static enums:TransferAccountType.CashBox}" />
                                            <ComboBoxItem Content="بنك" Tag="{x:Static enums:TransferAccountType.Bank}" />
                                        </ComboBox>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding TransferToAccounts}"
                                                  SelectedItem="{Binding TransferToAccount}"
                                                  materialDesign:HintAssist.Hint="الحساب"
                                                  Style="{StaticResource FilledComboBox}"
                                                  FontSize="13">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Name}" />
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Amount + Notes + Button -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding TransferAmount, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="المبلغ"
                                         Style="{StaticResource NumericTextBox}"
                                         FontSize="14" FontWeight="Bold" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding TransferNotes, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="ملاحظات (اختياري)"
                                         Style="{StaticResource FilledTextBox}"
                                         FontSize="13" />

                                <Button Grid.Column="4" Command="{Binding CreateTransferCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White" FontSize="14" Padding="24,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="تنفيذ التحويل" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Transfers list -->
                    <materialDesign:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" UniformCornerRadius="12" Padding="0"
                                         materialDesign:ElevationAssist.Elevation="Dp2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:ListTableHeaderBar Grid.Row="0"
                                                         Title="سجل التحويلات"
                                                         TargetDataGrid="{Binding ElementName=TransfersGrid}"
                                                         IsFilterPanelOpen="{Binding IsTransfersColumnFilterPanelOpen, Mode=TwoWay}"
                                                         ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                         ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                         ExportCommand="{Binding ExportTransfersCommand}"
                                                         PrintCommand="{Binding PrintTransfersCommand}"
                                                         ShowCardToggle="False">
                                <controls:ListTableHeaderBar.ExtraContent>
                                    <StackPanel Orientation="Horizontal">
                                        <DatePicker Width="130" Margin="0,0,8,0"
                                                    SelectedDate="{Binding TransferFromDate}"
                                                    materialDesign:HintAssist.Hint="من تاريخ"
                                                    Style="{StaticResource FilledDatePicker}"
                                                    FontSize="12" Foreground="White"
                                                    materialDesign:HintAssist.Foreground="#B0BEC5"/>
                                        <DatePicker Width="130"
                                                    SelectedDate="{Binding TransferToDate}"
                                                    materialDesign:HintAssist.Hint="إلى تاريخ"
                                                    Style="{StaticResource FilledDatePicker}"
                                                    FontSize="12" Foreground="White"
                                                    materialDesign:HintAssist.Foreground="#B0BEC5"/>
                                    </StackPanel>
                                </controls:ListTableHeaderBar.ExtraContent>
                            </controls:ListTableHeaderBar>

                            <DataGrid x:Name="TransfersGrid"
                                      Grid.Row="1" ItemsSource="{Binding Transfers}"
                                      Style="{StaticResource ModernDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="True" CanUserReorderColumns="False"
                                      materialDesign:DataGridAssist.CellPadding="10 6"
                                      HeadersVisibility="Column" FontSize="13" Margin="8"
                                      behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                      behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsTransfersColumnFilterPanelOpen, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date" />
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="من" Binding="{Binding FromName}" Width="160"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="FromName" />
                                    <DataGridTextColumn Header="إلى" Binding="{Binding ToName}" Width="160"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ToName" />
                                    <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"
                                                        behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Notes" />
                                    <DataGridTemplateColumn Header="عكس" Width="70"
                                                            behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ReverseTransferCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource TableDeleteIconButton}"
                                                        ToolTip="عكس التحويل">
                                                    <materialDesign:PackIcon Kind="Undo" Width="16" Height="16"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <controls:PaginationBar Grid.Row="2" DataContext="{Binding TransferPager}"/>
                        </Grid>
                    </materialDesign:Card>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
