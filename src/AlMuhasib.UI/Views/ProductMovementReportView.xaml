<UserControl x:Class="AlMuhasib.UI.Views.ProductMovementReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProductMovementReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="حركة المنتجات" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="كميات الوارد (مشتريات) والصادر (مبيعات/أقساط) حسب الفترة"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي الوارد" TextValue="{Binding TotalIn}" Icon="ArrowDownBold" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي الصادر" TextValue="{Binding TotalOut}" Icon="ArrowUpBold" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="عدد الأصناف" TextValue="{Binding ProductCount}" Icon="PackageVariant" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <WrapPanel>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,8"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن" Width="150" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Products}" SelectedValue="{Binding SelectedProductId}" SelectedValuePath="Id" DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="منتج (الكل)" Width="180" Margin="0,0,12,8"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,8,8"/>
                        <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                       ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                       ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                       TargetDataGrid="{Binding ElementName=ProductMovementGrid}"
                                                       Margin="0,0,8,8"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,8"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}" Margin="0,0,0,8"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="ProductMovementGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProductName"/>
                        <DataGridTextColumn Header="وارد" Binding="{Binding QuantityIn, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="QuantityIn"/>
                        <DataGridTextColumn Header="صادر" Binding="{Binding QuantityOut, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="QuantityOut"/>
                        <DataGridTextColumn Header="صافي" Binding="{Binding NetQuantity, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NetQuantity"/>
                    </DataGrid.Columns>
                </DataGrid>
                        <controls:PaginationBar Grid.Row="1"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
