<UserControl x:Class="AlMuhasib.UI.Views.SalesRepPerformanceReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SalesRepPerformanceReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="تقرير أداء المندوبين" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="5" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي المبيعات" TextValue="{Binding TotalSales}" Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي التحصيل" TextValue="{Binding TotalCollections}" Icon="CashPlus" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="إجمالي العمولات" TextValue="{Binding TotalCommissions}" Icon="Percent" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                    <controls:AnimatedStatCard Title="عدد المندوبين" TextValue="{Binding RepCount}" Icon="AccountTie" IconBackground="#EFEBE9" IconForeground="#5D4037" ValueForeground="#5D4037"/>
                    <controls:AnimatedStatCard Title="متوسط التحقق" TextValue="{Binding AverageAchievement}" Icon="Target" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                </UniformGrid>

                <controls:ChartCard Title="مقارنة المبيعات حسب المندوب">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Height="280"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <TextBox materialDesign:HintAssist.Hint="بحث..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" MinWidth="200"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أداء المندوبين"
                                             TargetDataGrid="{Binding ElementName=PerformanceGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="PerformanceGrid" Grid.Row="1" ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المندوب" Binding="{Binding Name}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                        <DataGridTextColumn Header="المنطقة" Binding="{Binding Region}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Region"/>
                        <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IsActive}" Width="70"
                                               behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IsActive"/>
                        <DataGridTextColumn Header="فواتير" Binding="{Binding InvoiceCount}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceCount"/>
                        <DataGridTextColumn Header="عملاء" Binding="{Binding CustomerCount}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerCount"/>
                        <DataGridTextColumn Header="المبيعات" Binding="{Binding TotalSales, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalSales"/>
                        <DataGridTextColumn Header="التحصيل" Binding="{Binding TotalCollections, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalCollections"/>
                        <DataGridTextColumn Header="الذمم" Binding="{Binding RemainingReceivables, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingReceivables"/>
                        <DataGridTextColumn Header="العمولات" Binding="{Binding TotalCommissions, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalCommissions"/>
                        <DataGridTextColumn Header="الهدف" Binding="{Binding TargetAmount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TargetAmount"/>
                        <DataGridTextColumn Header="المحقق" Binding="{Binding AchievedAmount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AchievedAmount"/>
                        <DataGridTextColumn Header="تحقق %" Binding="{Binding AchievementPercent, StringFormat=N1}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AchievementPercent"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
