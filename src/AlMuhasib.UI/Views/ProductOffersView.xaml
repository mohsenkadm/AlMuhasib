<UserControl x:Class="AlMuhasib.UI.Views.ProductOffersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             x:Name="Root"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border x:Name="HeroHeader" Grid.Row="0" CornerRadius="18" Margin="0,0,0,16" Padding="24,20" Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform Y="16"/>
            </Border.RenderTransform>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E65100" Offset="0"/>
                    <GradientStop Color="#F9A825" Offset="0.55"/>
                    <GradientStop Color="#FFB300" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.28" Color="#E65100"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <md:PackIcon Kind="Sale" Width="28" Height="28" Foreground="White"/>
                        <TextBlock Text="عروض المنتجات" FontSize="24" FontWeight="Bold"
                                   Foreground="White" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="اشترِ كمية معيّنة واحصل على منتج هدية مجاناً — تُطبَّق تلقائياً في فاتورة البيع"
                               FontSize="13" Foreground="#FFF8E1" TextWrapping="Wrap" MaxWidth="560"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#33FFFFFF" CornerRadius="14" Padding="16,10" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveOffersCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="عروض في الصفحة" FontSize="11" Foreground="#FFFDE7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <md:Card x:Name="ToolbarCard" Style="{StaticResource ElevatedCard}" Grid.Row="1"
                 Padding="20" Margin="0,0,0,16" md:ElevationAssist.Elevation="Dp2" Opacity="0">
            <md:Card.RenderTransform>
                <TranslateTransform Y="14"/>
            </md:Card.RenderTransform>
            <StackPanel>
                <TextBlock Text="إدارة العروض" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding OpenAddDialogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,0"
                            IsEnabled="{Binding CanAdd}">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="إضافة عرض"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource FlatButton}"
                            md:ButtonAssist.CornerRadius="8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="تحديث"/>
                        </StackPanel>
                    </Button>
                    <CheckBox Content="النشطة فقط" IsChecked="{Binding ActiveOnlyFilter}"
                              VerticalAlignment="Center" Margin="8,0,12,0"/>
                    <TextBox md:HintAssist.Hint="بحث بالاسم أو المنتج..."
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             MinWidth="240"/>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#EF6C00"
                           Text="الميزة غير مفعّلة — فعّلها من إعدادات الميزات لعرض القائمة وتطبيق العروض في البيع.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeatureEnabled}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </md:Card>

        <md:Card x:Name="ListCard" Style="{StaticResource ElevatedCard}" Grid.Row="2"
                 Padding="0" md:ElevationAssist.Elevation="Dp2" Opacity="0">
            <md:Card.RenderTransform>
                <TranslateTransform Y="14"/>
            </md:Card.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="قائمة العروض"
                                             TargetDataGrid="{Binding ElementName=OffersGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintTableCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="OffersGrid" Grid.Row="1"
                          ItemsSource="{Binding Offers}"
                          SelectedItem="{Binding SelectedOffer}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          Style="{StaticResource ModernDataGrid}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="اسم العرض" Binding="{Binding Name}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                        <DataGridTextColumn Header="المنتج المشترى" Binding="{Binding TriggerProduct.Name}" Width="160"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TriggerProduct.Name"/>
                        <DataGridTextColumn Header="كمية التفعيل" Binding="{Binding TriggerQuantity, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TriggerQuantity"/>
                        <DataGridTextColumn Header="منتج الهدية" Binding="{Binding GiftProduct.Name}" Width="160"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GiftProduct.Name"/>
                        <DataGridTextColumn Header="كمية الهدية" Binding="{Binding GiftQuantity, StringFormat=N0}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="GiftQuantity"/>
                        <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="70"
                                               IsReadOnly="True"
                                               behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="IsActive"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="110" MinWidth="110"
                                                behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableEditIconButton}"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.ConfirmDeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource TableDeleteIconButton}"
                                                IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </md:Card>

        <md:DialogHost IsOpen="{Binding IsDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="14" Padding="24" MinWidth="480" MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{Binding DialogTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
                        <TextBox md:HintAssist.Hint="اسم العرض"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding EditTriggerProduct}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  md:HintAssist.Hint="المنتج المشترى (المشغّل)"
                                  Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="كمية التفعيل (مثال: 4)"
                                 Text="{Binding EditTriggerQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedItem="{Binding EditGiftProduct}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  md:HintAssist.Hint="منتج الهدية"
                                  Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="كمية الهدية (مثال: 1)"
                                 Text="{Binding EditGiftQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <TextBox md:HintAssist.Hint="ملاحظات (اختياري)"
                                 Text="{Binding EditNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" Margin="0,0,0,12"/>
                        <CheckBox Content="العرض نشط" IsChecked="{Binding EditIsActive}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding DialogError}" Foreground="#C62828" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حفظ" Command="{Binding SaveOfferCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"/>
                            <Button Content="إلغاء" Command="{Binding CancelDialogCommand}"
                                    Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </md:DialogHost.DialogContent>
        </md:DialogHost>

        <md:DialogHost IsOpen="{Binding IsDeleteDialogOpen}" CloseOnClickAway="False" Grid.RowSpan="3">
            <md:DialogHost.DialogContent>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24" MinWidth="360">
                    <StackPanel>
                        <TextBlock Text="تأكيد الحذف" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="هل تريد حذف العرض المحدد؟" Margin="0,0,0,16" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="حذف" Command="{Binding ExecuteDeleteCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,0,8,0"
                                    Background="#C62828"/>
                            <Button Content="إلغاء" Command="{Binding CancelDeleteCommand}" Style="{StaticResource FlatButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </md:DialogHost.DialogContent>
        </md:DialogHost>
    </Grid>
</UserControl>
