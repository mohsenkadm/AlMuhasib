<UserControl x:Class="AlMuhasib.UI.Views.CustomerStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CustomerStatementViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="كشف حساب عميل" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="اسم العميل"
                        TextValue="{Binding CustomerName}"
                        Icon="Account"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="إجمالي المدين"
                        TextValue="{Binding TotalDebit}"
                        Icon="CashPlus"
                        IconBackground="#FFEBEE"
                        IconForeground="#C62828"
                        ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard
                        Title="إجمالي الدائن"
                        TextValue="{Binding TotalCredit}"
                        Icon="CashMinus"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="الرصيد"
                        TextValue="{Binding Balance}"
                        Icon="ScaleBalance"
                        IconBackground="{DynamicResource AccentLightBrush}"
                        IconForeground="{DynamicResource AccentBrush}"
                        ValueForeground="{DynamicResource AccentBrush}"/>
                </UniformGrid>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="260" Margin="0,0,12,0"
                                  ItemsSource="{Binding FilteredCustomers}"
                                  SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                  Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource CustomerSearchableComboBox}"
                                  materialDesign:HintAssist.Hint="العميل (ابحث بالاسم أو الهاتف أو رقم العميل أو المعرف)"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="كشف حساب عميل"
                                                     TargetDataGrid="{Binding ElementName=CustomerStatementGrid}"
                                                     IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     ExportCommand="{Binding ExportToExcelCommand}"
                                                     PrintCommand="{Binding PrintCommand}"
                                                     ShowCardToggle="False">
                            <controls:ListTableHeaderBar.ExtraContent>
                                <Button Command="{Binding ShareWhatsAppCommand}"
                                        ToolTip="إرسال الكشف عبر واتساب"
                                        Background="#E8F8EF" BorderBrush="#A5D6A7" BorderThickness="1"
                                        Width="36" Height="36" Cursor="Hand"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    <materialDesign:PackIcon Kind="Whatsapp" Width="20" Height="20" Foreground="#25D366"/>
                                </Button>
                            </controls:ListTableHeaderBar.ExtraContent>
                        </controls:ListTableHeaderBar>


                        <DataGrid x:Name="CustomerStatementGrid"
                                  ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                                  behaviors:DataGridReportRowBehavior.DoubleClickCommand="{Binding OpenStatementDocumentFromRowCommand}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"


                                  Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=\{0:yyyy/MM/dd\}}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Description"/>
                                <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Debit"/>
                                <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Credit"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding RunningBalance, StringFormat=N0}" Width="130" FontWeight="Bold"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RunningBalance">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <controls:PaginationBar Grid.Row="2"/>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
