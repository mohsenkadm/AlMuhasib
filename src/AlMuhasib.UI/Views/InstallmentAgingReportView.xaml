<UserControl x:Class="AlMuhasib.UI.Views.InstallmentAgingReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:InstallmentAgingReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="أعمار ذمم الأقساط" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <controls:AnimatedStatCard Title="إجمالي المتبقي" TextValue="{Binding TotalOutstanding}" Icon="CashClock" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="عدد الأقساط" TextValue="{Binding InstallmentCount}" Icon="CalendarClock" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="عدد العملاء" TextValue="{Binding CustomerCount}" Icon="AccountGroup" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                </UniformGrid>

                <controls:ChartCard Title="توزيع الذمم حسب العمر" Margin="0,0,0,16">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding BucketSeries}" XAxes="{Binding BucketXAxes}" YAxes="{Binding BucketYAxes}" Height="260"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <ItemsControl ItemsSource="{Binding BucketSummaries}" Margin="0,0,0,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="4"
                                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding BucketName}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Count, StringFormat={}{0} قسط}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Amount, StringFormat={}{0:N0}}" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding AsOfDate}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="حتى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedValue="{Binding SelectedCustomerId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="العميل" Width="180" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,8,0"/>
                    </StackPanel>
                </Border>

                <controls:ReportBulkInstallmentPayBar DataContext="{Binding}"/>

                <TextBlock Text="انقر مرتين لعرض فاتورة الأقساط — حدّد عدة صفوف للتسديد الجماعي"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="أعمار ذمم الأقساط"
                                             TargetDataGrid="{Binding ElementName=AgingGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="AgingGrid" Grid.Row="1"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280"
                          SelectionMode="Extended" SelectionChanged="AgingGrid_SelectionChanged"
                          behaviors:DataGridReportRowBehavior.DoubleClickCommand="{Binding OpenInvoiceDetailFromReportRowCommand}"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                        <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Phone"/>
                        <DataGridTextColumn Header="الخطة" Binding="{Binding PlanNumber}" Width="70"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PlanNumber"/>
                        <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                        <DataGridTextColumn Header="أيام التأخير" Binding="{Binding DaysOverdue}" Width="90"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DaysOverdue"/>
                        <DataGridTextColumn Header="الفئة" Binding="{Binding AgingBucket}" Width="100"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AgingBucket"/>
                    </DataGrid.Columns>
                </DataGrid>
                        <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
