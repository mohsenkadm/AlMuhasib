<UserControl x:Class="AlMuhasib.UI.Views.IncomeExpenseReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:IncomeExpenseReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير الإيرادات والمصروفات" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="إجمالي الواردات"
                        TextValue="{Binding TotalIncome}"
                        Icon="CashPlus"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="إجمالي المصروفات"
                        TextValue="{Binding TotalExpenses}"
                        Icon="CashMinus"
                        IconBackground="#FFEBEE"
                        IconForeground="#C62828"
                        ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard
                        Title="صافي النتيجة"
                        TextValue="{Binding NetResult}"
                        Icon="TrendingUp"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="نسبة المصروفات"
                        TextValue="{Binding ExpenseRate}"
                        Icon="Percent"
                        IconBackground="#FFF8E1"
                        IconForeground="#FF8F00"
                        ValueForeground="#FF8F00"/>
                </UniformGrid>

                <!-- ═══ Chart ═══ -->
                <controls:ChartCard Title="الإيرادات مقابل المصروفات (شهري)">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding MonthlySeries}" XAxes="{Binding MonthlyXAxes}" YAxes="{Binding MonthlyYAxes}" Height="350"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="القسم" Binding="{Binding Section}" Width="140"/>
                                <DataGridTextColumn Header="النوع" Binding="{Binding Type}" Width="140"/>
                                <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="0,0,12,12" Padding="16,8">
                            <Grid>
                                <TextBlock Text="{Binding PaginationText}" VerticalAlignment="Center" FontSize="12" Foreground="#757575"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Style="{StaticResource IconButton}" Command="{Binding LastPageCommand}"><materialDesign:PackIcon Kind="ChevronDoubleRight"/></Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding NextPageCommand}"><materialDesign:PackIcon Kind="ChevronRight"/></Button>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0">
                                        <Run Text="{Binding CurrentPage, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding TotalPages, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding PreviousPageCommand}"><materialDesign:PackIcon Kind="ChevronLeft"/></Button>
                                    <Button Style="{StaticResource IconButton}" Command="{Binding FirstPageCommand}"><materialDesign:PackIcon Kind="ChevronDoubleLeft"/></Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
