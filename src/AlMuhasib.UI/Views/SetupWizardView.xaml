<UserControl x:Class="AlMuhasib.UI.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid MaxWidth="860" HorizontalAlignment="Center" Margin="0,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Step indicator -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- HEADER -->
        <!-- ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <md:PackIcon Kind="CogOutline" Width="48" Height="48"
                         HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="معالج إعداد النظام" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="15" Foreground="#757575"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!-- STEP INDICATOR (circles) -->
        <!-- ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
            <!-- Step 1 -->
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="32" Height="32">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E0E0E0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="14"
                           Margin="-24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Width="16" TextAlignment="Center"/>
                <Rectangle Width="50" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
            <!-- Step 2 -->
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="32" Height="32">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E0E0E0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="14"
                           Margin="-24,0,0,0" VerticalAlignment="Center" Width="16" TextAlignment="Center"/>
                <Rectangle Width="50" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
            <!-- Step 3 -->
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="32" Height="32">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E0E0E0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="14"
                           Margin="-24,0,0,0" VerticalAlignment="Center" Width="16" TextAlignment="Center"/>
                <Rectangle Width="50" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
            <!-- Step 4 -->
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="32" Height="32">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E0E0E0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="14"
                           Margin="-24,0,0,0" VerticalAlignment="Center" Width="16" TextAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!-- STEP CONTENT -->
        <!-- ═══════════════════════════════════════════ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="24" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <!-- STEP 0: Capital -->
                <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolVis}}">
                    <md:PackIcon Kind="Cash" Width="36" Height="36" Foreground="#388E3C"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="أدخل رأس المال الأساسي للنظام" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,0,0,24" Foreground="#616161"/>

                    <TextBox md:HintAssist.Hint="مبلغ رأس المال"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding CapitalAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                             Width="350" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <DatePicker md:HintAssist.Hint="التاريخ"
                                Style="{StaticResource FilledDatePicker}"
                                SelectedDate="{Binding CapitalDate}"
                                Width="350" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBox md:HintAssist.Hint="الملاحظات (اختياري)"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding CapitalNotes, UpdateSourceTrigger=PropertyChanged}"
                             Width="350" HorizontalAlignment="Center"
                             AcceptsReturn="True" MinHeight="60"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <!-- STEP 1: Cash Boxes -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="أدخل الصناديق (الافتتاحية) أو الأرصدة الابتدائية"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#616161"/>

                    <!-- Add row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم الصندوق"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewCashBoxName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 md:HintAssist.Hint="الرصيد الافتتاحي"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewCashBoxBalance, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding AddCashBoxCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <!-- List -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CashBoxes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الصندوق" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الرصيد الافتتاحي" Binding="{Binding Balance, StringFormat=N0}" Width="180"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveCashBoxCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 2: Warehouses -->
                <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="أدخل المخازن التي ستُحمَّل في النظام"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#616161"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم المخزن"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 md:HintAssist.Hint="الموقع (اختياري)"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewWarehouseLocation, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding AddWarehouseCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Warehouses}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المخزن" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 3: Expense Types -->
                <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="أدخل أنواع المصروفات (من أجهزة وكهرباء ونحو ذلك)"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#616161"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم نوع المصروف"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewExpenseTypeName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Command="{Binding AddExpenseTypeCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ExpenseTypes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع المصروف" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveExpenseTypeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </md:Card>

        <!-- ═══════════════════════════════════════════ -->
        <!-- NAVIGATION BUTTONS -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding PreviousStepCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"
                    Style="{StaticResource OutlinedButton}"
                    md:ButtonAssist.CornerRadius="8"
                    MinWidth="120">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="السابق"/>
                </StackPanel>
            </Button>

            <!-- Next or Finish -->
            <Button Grid.Column="2" md:ButtonAssist.CornerRadius="8" MinWidth="140">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Command" Value="{Binding NextStepCommand}"/>
                        <Setter Property="Content">
                            <Setter.Value>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="التالي"/>
                                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Command" Value="{Binding FinishCommand}"/>
                                <Setter Property="Background" Value="#388E3C"/>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                            <TextBlock Text="إنهاء الإعداد" Foreground="White"/>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
