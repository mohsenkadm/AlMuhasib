<UserControl x:Class="AlMuhasib.UI.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="0,12,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Step indicator -->
            <RowDefinition Height="*"/>     <!-- Content (scrollable) -->
            <RowDefinition Height="Auto"/>  <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- HEADER -->
        <!-- ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <md:PackIcon Kind="CogOutline" Width="48" Height="48"
                         HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="معالج إعداد النظام" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
            <TextBlock Text="{Binding StepTitle}" FontSize="15" Foreground="#757575"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!-- STEP INDICATOR -->
        <!-- ═══════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">

            <!-- Step 1 -->
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,4,0">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="١" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep0}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Rectangle Width="44" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>

            <!-- Step 2 -->
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,4,0">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="٢" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Rectangle Width="44" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>

            <!-- Step 3: Investors -->
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,4,0">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="٣" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Rectangle Width="44" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>

            <!-- Step 4 -->
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,4,0">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="٤" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Rectangle Width="44" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>

            <!-- Step 5 -->
            <StackPanel Orientation="Horizontal">
                <Grid Width="34" Height="34" Margin="0,0,4,0">
                    <Ellipse Fill="#E0E0E0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="٥" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#616161"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Rectangle Width="44" Height="2" Fill="#E0E0E0" VerticalAlignment="Center" Margin="4,0"/>
            </StackPanel>

            <!-- Step 6 -->
            <Grid Width="34" Height="34">
                <Ellipse Fill="#E0E0E0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="٦" FontWeight="Bold" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#616161"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

        </StackPanel>

        <!-- ═══════════════════════════════════════════ -->
        <!-- STEP CONTENT (scrollable) -->
        <!-- ═══════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0"
                      md:ScrollViewerAssist.IsAutoHideEnabled="True">
            <md:Card Style="{StaticResource ElevatedCard}"
                     Padding="24"
                     MaxWidth="860"
                     HorizontalAlignment="Center"
                     md:ElevationAssist.Elevation="Dp2">
            <Grid MinHeight="200">
                <!-- STEP 0: Capital -->
                <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolVis}}">
                    <md:PackIcon Kind="Cash" Width="36" Height="36" Foreground="#388E3C"
                                 HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="أدخل رأس المال الأساسي للنظام" FontSize="15"
                               HorizontalAlignment="Center" Margin="0,0,0,24" Foreground="#616161"/>

                    <TextBox md:HintAssist.Hint="مبلغ رأس المال"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding CapitalAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                             Width="350" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <DatePicker md:HintAssist.Hint="التاريخ"
                                Style="{StaticResource FilledDatePicker}"
                                SelectedDate="{Binding CapitalDate}"
                                Width="350" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <TextBox md:HintAssist.Hint="الملاحظات (اختياري)"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding CapitalNotes, UpdateSourceTrigger=PropertyChanged}"
                             Width="350" HorizontalAlignment="Center" Margin="0,0,0,16"
                             AcceptsReturn="True" MinHeight="60"
                             TextWrapping="Wrap"/>

                    <TextBlock Text="الرصيد الافتتاحي للأرباح (اختياري)"
                               FontSize="13" Foreground="#616161"
                               HorizontalAlignment="Center" Margin="0,8,0,8"/>
                    <TextBox md:HintAssist.Hint="رصيد الأرباح الافتتاحي"
                             Style="{StaticResource FilledTextBox}"
                             Text="{Binding ProfitOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                             Width="350" HorizontalAlignment="Center"/>
                    <TextBlock Text="يُضاف إلى صافي الأرباح كرصيد تراكمي من الفترة السابقة"
                               FontSize="11" Foreground="#9E9E9E"
                               HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                               Width="350" TextAlignment="Center"/>
                </StackPanel>

                <!-- STEP 1: Cash Boxes -->
                <Grid Visibility="{Binding IsStep1, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="أدخل الصناديق (الافتتاحية) أو الأرصدة الابتدائية"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#616161"/>

                    <!-- Add row -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم الصندوق"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewCashBoxName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 md:HintAssist.Hint="الرصيد الافتتاحي"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewCashBoxBalance, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding AddCashBoxCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <!-- List -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CashBoxes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              MaxHeight="320"
                              MinHeight="120"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم الصندوق" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الرصيد الافتتاحي" Binding="{Binding Balance, StringFormat=N0}" Width="180"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveCashBoxCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 2: Opening Investors -->
                <Grid Visibility="{Binding IsStep2, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="أضف المستثمرين وأرصدتهم الافتتاحية (اختياري — لا يُضاف الرصيد إلى القاصة)"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="#616161" TextWrapping="Wrap" TextAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم المستثمر"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewInvestorName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 md:HintAssist.Hint="الهاتف"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewInvestorPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2"
                                 md:HintAssist.Hint="نسبة %"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewInvestorProfitPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3"
                                 md:HintAssist.Hint="رصيد افتتاحي"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewInvestorOpeningBalance, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="4"
                                Command="{Binding AddOpeningInvestorItemCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding OpeningInvestorItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              MaxHeight="320" MinHeight="120"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المستثمر" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="*"/>
                            <DataGridTextColumn Header="نسبة %" Binding="{Binding ProfitPercentage, StringFormat=N2}" Width="80"/>
                            <DataGridTextColumn Header="رصيد افتتاحي" Binding="{Binding OpeningBalance, StringFormat=N0}" Width="120"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveOpeningInvestorItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 3: Warehouses -->
                <Grid Visibility="{Binding IsStep3, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="أدخل المخازن التي ستُحمَّل في النظام"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#616161"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم المخزن"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewWarehouseName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 md:HintAssist.Hint="الموقع (اختياري)"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewWarehouseLocation, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="2"
                                Command="{Binding AddWarehouseCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Warehouses}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              MaxHeight="320"
                              MinHeight="120"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم المخزن" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveWarehouseCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 4: Opening Stock -->
                <Grid Visibility="{Binding IsStep4, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="أدخل الكمية مع سعر الوحدة (يُحسب الإجمالي) أو الكمية مع الإجمالي الكلي (يُحسب سعر الوحدة) — اختياري"
                               FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,16"
                               Foreground="#616161" TextWrapping="Wrap" TextAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم المنتج"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewProductName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 md:HintAssist.Hint="الكمية"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewProductQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="2"
                                 md:HintAssist.Hint="سعر الوحدة"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewProductUnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,8,0"/>
                        <TextBox Grid.Column="3"
                                 md:HintAssist.Hint="الإجمالي الكلي"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewProductTotalCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="4"
                                Command="{Binding AddOpeningStockItemCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding OpeningStockItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              MaxHeight="320"
                              MinHeight="120"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N0}" Width="100"/>
                            <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitCost, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="الإجمالي الكلي" Binding="{Binding TotalCost, StringFormat=N0}" Width="130"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveOpeningStockItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- STEP 5: Expense Types -->
                <Grid Visibility="{Binding IsStep5, Converter={StaticResource BoolVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="أدخل أنواع المصروفات (من أجهزة وكهرباء ونحو ذلك)"
                               FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,16" Foreground="#616161"/>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 md:HintAssist.Hint="اسم نوع المصروف"
                                 Style="{StaticResource FilledTextBox}"
                                 Text="{Binding NewExpenseTypeName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0"/>
                        <Button Grid.Column="1"
                                Command="{Binding AddExpenseTypeCommand}"
                                Style="{StaticResource PrimaryButton}"
                                md:ButtonAssist.CornerRadius="8"
                                Content="إضافة" MinWidth="80"/>
                    </Grid>

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ExpenseTypes}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              MaxHeight="320"
                              MinHeight="120"
                              Style="{StaticResource ModernDataGrid}"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="نوع المصروف" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveExpenseTypeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="حذف" Foreground="#C62828" Width="28" Height="28">
                                            <md:PackIcon Kind="Delete" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
            </md:Card>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!-- NAVIGATION BUTTONS -->
        <!-- ═══════════════════════════════════════════ -->
        <Grid Grid.Row="3" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding PreviousStepCommand}"
                    Visibility="{Binding CanGoBack, Converter={StaticResource BoolVis}}"
                    Style="{StaticResource OutlinedButton}"
                    md:ButtonAssist.CornerRadius="8"
                    MinWidth="120">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="ArrowRight" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="السابق"/>
                </StackPanel>
            </Button>

            <!-- Next or Finish -->
            <Button Grid.Column="2" md:ButtonAssist.CornerRadius="8" MinWidth="140">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Command" Value="{Binding NextStepCommand}"/>
                        <Setter Property="Content">
                            <Setter.Value>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="التالي"/>
                                    <md:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLastStep}" Value="True">
                                <Setter Property="Command" Value="{Binding FinishCommand}"/>
                                <Setter Property="Background" Value="#388E3C"/>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <StackPanel Orientation="Horizontal">
                                            <md:PackIcon Kind="Check" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                                            <TextBlock Text="إنهاء الإعداد" Foreground="White"/>
                                        </StackPanel>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
