<UserControl x:Class="AlMuhasib.UI.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- TOP: User Selection + Buttons -->
        <!-- ═══════════════════════════════════════════ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="0" Padding="12" md:ElevationAssist.Elevation="Dp2" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Width="280"
                          md:HintAssist.Hint="اختر المستخدم"
                          Style="{StaticResource FilledComboBox}"
                          ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          DisplayMemberPath="DisplayName"
                          IsEditable="False"/>

                <Button Grid.Column="2"
                        Command="{Binding SelectAllCommand}"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CheckAll" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="تحديد الكل"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding DeselectAllCommand}"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="CloseCircleMultipleOutline" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="إلغاء الكل"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding VerifyCatalogCommand}"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="DatabaseSearch" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="التحقق من التسميات"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="5"
                        Command="{Binding SavePermissionsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        md:ButtonAssist.CornerRadius="8"
                        Background="#388E3C">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="White"/>
                        <TextBlock Text="حفظ الصلاحيات" Foreground="White"/>
                    </StackPanel>
                </Button>
            </Grid>
        </md:Card>

        <!-- ═══════════════════════════════════════════ -->
        <!-- PERMISSIONS TABLE -->
        <!-- ═══════════════════════════════════════════ -->
        <md:Card Style="{StaticResource ElevatedCard}" Grid.Row="2" Padding="0" md:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="صلاحيات الشاشات"
                                             TargetDataGrid="{Binding ElementName=PermissionsGrid}"
                                             ShowCardToggle="False"
                                             ShowExport="False"
                                             ShowPrint="False"
                                             ShowFilter="False"/>
            <DataGrid x:Name="PermissionsGrid" Grid.Row="1" ItemsSource="{Binding Screens}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      Style="{StaticResource ModernDataGrid}"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E0E0E0">
                <DataGrid.Columns>
                    <!-- Screen Name -->
                    <DataGridTextColumn Header="الشاشة"
                                        Binding="{Binding ScreenLabel}"
                                        Width="*"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- CanView -->
                    <DataGridTemplateColumn Header="عرض" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanView, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CanAdd -->
                    <DataGridTemplateColumn Header="إضافة" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanAdd, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CanEdit -->
                    <DataGridTemplateColumn Header="تعديل" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanEdit, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CanDelete -->
                    <DataGridTemplateColumn Header="حذف" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanDelete, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CanPrint -->
                    <DataGridTemplateColumn Header="طباعة" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanPrint, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- CanExport -->
                    <DataGridTemplateColumn Header="تصدير" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanExport, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="تعديل سعر" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding CanEditPrice, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="عرض فقط" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsViewOnly, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
