<UserControl x:Class="AlMuhasib.UI.Views.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseInvoiceViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel>

                <!-- ═══════════════════════════════════════════ -->
                <!-- BEAUTIFUL GRADIENT HEADER                      -->
                <!-- ═══════════════════════════════════════════ -->
                <Border CornerRadius="14" Margin="0,0,0,16" Padding="24,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D47A1" Offset="0"/>
                            <GradientStop Color="#1565C0" Offset="0.5"/>
                            <GradientStop Color="#1976D2" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.2" Color="#0D47A1"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="#26FFFFFF" Margin="0,0,16,0">
                            <materialDesign:PackIcon Kind="CartOutline" Width="28" Height="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="فاتورة مشتريات" FontSize="20" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Foreground="#CCFFFFFF" FontSize="13">
                                <Run Text="رقم الفاتورة:"/>
                                <Run Text="{Binding InvoiceNumber, Mode=OneWay}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="10" Background="#26FFFFFF" Padding="16,8">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="الإجمالي" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════ -->
                <!-- HEADER SECTION                                 -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <!-- Invoice Number -->
                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Text="{Binding InvoiceNumber, Mode=OneWay}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="رقم الفاتورة"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,12,12"
                                 FontSize="14"
                                 FontFamily="Consolas"
                                 Foreground="#1A237E"
                                 FontWeight="Bold" />

                        <!-- Date Picker -->
                        <DatePicker Grid.Row="0" Grid.Column="1"
                                    SelectedDate="{Binding InvoiceDate}"
                                    materialDesign:HintAssist.Hint="التاريخ"
                                    materialDesign:HintAssist.IsFloating="True"
                                    Style="{StaticResource FilledDatePicker}"
                                    Margin="0,0,12,12"
                                    FontSize="14" />

                        <!-- Supplier (searchable ComboBox) -->
                        <ComboBox Grid.Row="0" Grid.Column="2"
                                  ItemsSource="{Binding FilteredSuppliers}"
                                  SelectedItem="{Binding SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  materialDesign:HintAssist.Hint="المورد (ابحث أو اكتب اسم جديد)"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,0,12"
                                  FontSize="14" />

                        <!-- Row 1 -->
                        <!-- Warehouse -->
                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,12,0"
                                  FontSize="14" />

                        <!-- Payment Method Toggle -->
                        <StackPanel Grid.Row="1" Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="طريقة الدفع:"
                                       FontSize="13"
                                       Foreground="#616161"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <RadioButton Content="نقدي"
                                         IsChecked="{Binding IsCashPayment}"
                                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                                         Padding="16,8"
                                         FontSize="13"
                                         Margin="0,0,8,0" />

                            <RadioButton Content="آجل"
                                         IsChecked="{Binding IsCashPayment, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                         Style="{StaticResource MaterialDesignTabRadioButtonBottom}"
                                         Padding="16,8"
                                         FontSize="13" />
                        </StackPanel>

                        <!-- CashBox (visible only for Cash) -->
                        <ComboBox Grid.Row="1" Grid.Column="2"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="الصندوق"
                                  materialDesign:HintAssist.IsFloating="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  FontSize="14"
                                  Visibility="{Binding IsCashPayment, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ITEMS TABLE                                    -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="0"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0"
                                Background="#F5F5F5"
                                CornerRadius="12,12,0,0"
                                Padding="16,10">
                            <Grid>
                                <TextBlock Text="بنود الفاتورة"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="#424242"
                                           VerticalAlignment="Center" />
                                <Button Command="{Binding AddRowCommand}"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource AccentButton}"
                                        Height="32"
                                        Padding="14,0"
                                        materialDesign:ButtonAssist.CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="إضافة صف" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Items DataGrid -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="False"
                                  SelectionMode="Single"
                                  SelectionUnit="Cell"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowHeight="48"
                                  MinHeight="200"
                                  MaxHeight="400"
                                  FontSize="13"
                                  Background="White"
                                  BorderThickness="0"
                                  materialDesign:DataGridAssist.ColumnHeaderPadding="12 8"
                                  materialDesign:DataGridAssist.CellPadding="12 6">

                            <DataGrid.Columns>
                                <!-- # -->
                                <DataGridTemplateColumn Header="#" Width="45" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                       Path=(ItemsControl.AlternationIndex),
                                                       StringFormat='{}{0}'}"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#9E9E9E" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Product / Item Name -->
                                <DataGridTemplateColumn Header="المنتج / اسم الصنف" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Products, 
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name"
                                                      Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      materialDesign:HintAssist.Hint="ابحث أو اختر..."
                                                      materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                      BorderThickness="0"
                                                      Background="Transparent"
                                                      FontSize="13"
                                                      Padding="0,4">
                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}">
                                                        <Setter Property="Padding" Value="8,6" />
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quantity -->
                                <DataGridTemplateColumn Header="الكمية" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Padding="4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Price -->
                                <DataGridTemplateColumn Header="سعر الوحدة" Width="130">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                     materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     HorizontalContentAlignment="Center"
                                                     FontSize="13"
                                                     Padding="4" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total -->
                                <DataGridTextColumn Header="الإجمالي" 
                                                    Binding="{Binding TotalPrice, StringFormat=N0, Mode=OneWay}"
                                                    Width="130"
                                                    IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="#1A237E" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Delete Row -->
                                <DataGridTemplateColumn Header="" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveRowCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    ToolTip="حذف السطر"
                                                    Foreground="#C62828"
                                                    Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="16" Height="16" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- FOOTER / TOTALS                                -->
                <!-- ═══════════════════════════════════════════ -->
                <materialDesign:Card Style="{StaticResource ElevatedCard}" UniformCornerRadius="12"
                                     Padding="20,16"
                                     Margin="0,0,0,16"
                                     materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />     <!-- Notes -->
                            <ColumnDefinition Width="Auto" />  <!-- Totals -->
                        </Grid.ColumnDefinitions>

                        <!-- Notes -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="ملاحظات"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MinHeight="80"
                                 MaxHeight="120"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="13"
                                 Margin="0,0,20,0"
                                 VerticalAlignment="Top" />

                        <!-- Totals panel -->
                        <Border Grid.Column="1"
                                CornerRadius="12"
                                Padding="22,18"
                                MinWidth="320">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E3F2FD" Offset="0"/>
                                    <GradientStop Color="#BBDEFB" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>

                                <!-- Subtotal -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="المجموع:"
                                               FontSize="14"
                                               Foreground="#616161"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Subtotal, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="14"
                                               Foreground="#424242"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- Rounding -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="التقريب (لصالح المورد):"
                                                   FontSize="13"
                                                   Foreground="#EF6C00"
                                                   VerticalAlignment="Center" />
                                        <materialDesign:PackIcon Kind="ArrowUp"
                                                                 Width="14" Height="14"
                                                                 Foreground="#EF6C00"
                                                                 VerticalAlignment="Center"
                                                                 Margin="4,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding RoundingAmount, StringFormat='+{0:N0} د.ع'}"
                                               FontSize="13"
                                               Foreground="#EF6C00"
                                               FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Separator Margin="0,4,0,12" Background="#E0E0E0" />

                                <!-- Grand Total -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="الإجمالي النهائي:"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#1A237E"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="#1A237E"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </materialDesign:Card>

                <!-- ═══════════════════════════════════════════ -->
                <!-- ERROR + ACTION BUTTONS                         -->
                <!-- ═══════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Error -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                        <!-- New Invoice -->
                        <Button Command="{Binding NewInvoiceCommand}"
                                Style="{StaticResource FlatButton}"
                                Foreground="#616161"
                                Height="44"
                                Padding="20,0"
                                Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentPlusOutline" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="فاتورة جديدة" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Print -->
                        <Button Command="{Binding PrintInvoiceCommand}"
                                Style="{StaticResource OutlinedButton}"
                                Height="44"
                                Padding="20,0"
                                Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Text="طباعة" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Save -->
                        <Button Command="{Binding SaveInvoiceCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="44"
                                Padding="28,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                FontSize="15"
                                FontWeight="SemiBold"
                                IsEnabled="{Binding CanSave}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Text="حفظ الفاتورة" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════ -->
        <!-- LOADING OVERLAY                 -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Style="{StaticResource PageLoading}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                             IsIndeterminate="True"
                             Width="40" Height="40"
                             Value="0" />
                <TextBlock Text="جارٍ الحفظ..."
                           FontSize="13"
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
