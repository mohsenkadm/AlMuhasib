<UserControl x:Class="AlMuhasib.UI.Views.WarehouseReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WarehouseReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير المخازن" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="عدد المواد"
                        TextValue="{Binding TotalItems}"
                        Icon="Package"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="القيمة الإجمالية"
                        TextValue="{Binding TotalValue}"
                        Icon="Cash"
                        IconBackground="#E8F5E9"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="عدد المخازن"
                        TextValue="{Binding WarehouseCount}"
                        Icon="Warehouse"
                        IconBackground="{DynamicResource AccentLightBrush}"
                        IconForeground="{DynamicResource AccentBrush}"
                        ValueForeground="{DynamicResource AccentBrush}"/>
                    <controls:AnimatedStatCard
                        Title="متوسط التكلفة"
                        TextValue="{Binding AverageCost}"
                        Icon="Calculator"
                        IconBackground="#E0F2F1"
                        IconForeground="#00796B"
                        ValueForeground="#00796B"/>
                </UniformGrid>

                <!-- ═══ Chart ═══ -->
                <controls:ChartCard Title="توزيع المخزون حسب المخزن">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding WarehouseSeries}" Height="300"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن" Width="160" Margin="0,0,12,0"/>
                        <CheckBox Content="إظهار المواد بكمية صفر" IsChecked="{Binding IncludeZeroStock}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="تقرير المخازن"
                                                     TargetDataGrid="{Binding ElementName=WarehouseReportGrid}"
                                                     IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     ExportCommand="{Binding ExportToExcelCommand}"
                                                     PrintCommand="{Binding PrintCommand}"
                                                     ShowCardToggle="False"/>


                        <DataGrid x:Name="WarehouseReportGrid"
                                  ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"


                                  Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProductName"/>
                                <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WarehouseName"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N0}" Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Quantity"/>
                                <DataGridTextColumn Header="متوسط التكلفة" Binding="{Binding AverageCost, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AverageCost"/>
                                <DataGridTextColumn Header="القيمة الإجمالية" Binding="{Binding TotalValue, StringFormat=N0}" Width="140"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="TotalValue"/>
                                <DataGridTextColumn Header="كمية التلف" Binding="{Binding DamagedQuantity, StringFormat=N0}" Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DamagedQuantity"/>
                                <DataGridTextColumn Header="تكلفة التلف" Binding="{Binding DamagedCost, StringFormat=N0}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DamagedCost"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <controls:PaginationBar Grid.Row="2"/>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
