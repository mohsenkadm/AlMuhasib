<UserControl x:Class="AlMuhasib.UI.Views.PosQuickSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:loyalty="clr-namespace:AlMuhasib.UI.Controls.Loyalty"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:PosQuickSaleViewModel}"
             Style="{StaticResource PosPageStyle}"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             ClipToBounds="True"
             Loaded="Root_Loaded"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolVis"/>
    </UserControl.Resources>

    <Grid x:Name="PosShell" Margin="0" MinHeight="0">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFullscreenActive}" Value="True"/>
                            <Condition Binding="{Binding IsFullscreenHost, ElementName=Root}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="0"/>
            </Grid.RowDefinitions>

        <!-- Proxy outside DataGrid columns to avoid x:Reference cyclical dependency -->
        <FrameworkElement x:Name="VmProxy" Visibility="Collapsed"/>

        <!-- Compact toolbar (replaces large header) -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,12,0"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CartOutline" Width="16" Height="16"
                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBlock Text="{Binding CartLineCount, StringFormat='{}{0} بند'}"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding ToggleFullscreenCommand}"
                        Style="{StaticResource OutlinedButton}"
                        Height="36" Padding="12,0"
                        ToolTip="فتح الكاشير بملء الشاشة"
                        Visibility="{Binding IsFullscreenHost, ElementName=Root, Converter={StaticResource InverseBoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="ملء الشاشة" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Command="{Binding ToggleFullscreenCommand}"
                        Style="{StaticResource OutlinedButton}"
                        Height="36" Padding="12,0"
                        ToolTip="إغلاق نافذة الكاشير والعودة داخل النظام"
                        Visibility="{Binding IsFullscreenHost, ElementName=Root, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FullscreenExit" Width="18" Height="18" VerticalAlignment="Center"/>
                        <TextBlock Text="إغلاق الكاشير" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- Catalog (right in RTL = col 0) -->
            <Border Grid.Column="0" Style="{StaticResource PosPanelCard}" MinHeight="0">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="0"/>
                    </Grid.RowDefinitions>

                    <!-- Favorites -->
                    <ScrollViewer Grid.Row="0" Margin="0,0,0,10"
                                  MaxHeight="76"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Auto"
                                  Style="{DynamicResource ThinScrollViewer}">
                        <StackPanel>
                            <TextBlock Text="المفضلة" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding FavoriteProducts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,6" Padding="10,7"
                                            Style="{StaticResource PrimaryButton}"
                                            materialDesign:ButtonAssist.CornerRadius="8"
                                            ToolTip="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Star" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             materialDesign:HintAssist.Hint="باركود أو اسم أو اسم علمي — Enter للإضافة"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             KeyDown="SearchBox_KeyDown"
                             Margin="0,0,0,10"
                             FontSize="15"/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"/>
                        <ComboBox Grid.Column="1" Margin="6,0,0,0"
                                  materialDesign:HintAssist.Hint="القاصة"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"/>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding FilteredProducts}"
                             Style="{StaticResource PosProductListBox}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.IsVirtualizing="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             MinHeight="0"
                             ClipToBounds="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PosProductCard}"
                                        Height="104"
                                        Margin="3"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.RowSpan="2"
                                                Style="{StaticResource PosCardHitButton}"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel Margin="12,10,36,0" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ScientificName}" FontSize="10" Margin="0,2,0,0"
                                                       Foreground="#607D8B" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasScientificName, Converter={StaticResource BoolVis}}"/>
                                            <TextBlock Text="{Binding Barcode}" FontSize="10" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Row="0" Panel.ZIndex="2"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                Width="28" Height="28"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,4,4,0" ToolTip="مفضلة">
                                            <materialDesign:PackIcon Width="16" Height="16" Foreground="#F9A825">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="StarOutline"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                <Setter Property="Kind" Value="Star"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                        </Button>
                                        <Grid Grid.Row="1" Margin="10,0,10,10" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Price, StringFormat='{}{0:N0} د.ع'}"
                                                       FontWeight="Bold" FontSize="14" Foreground="#1565C0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Width="30" Height="30" CornerRadius="8" Background="#1565C0">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="White"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Cart (left in RTL = col 2) -->
            <Border Grid.Column="2" Style="{StaticResource PosPanelCard}" MinHeight="0">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Quick actions -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,10">
                        <Button Command="{Binding OpenPaymentDialogAndPrintCommand}"
                                Style="{StaticResource PosActionPayButton}" Margin="0,0,4,0"
                                ToolTip="إتمام البيع وطباعة الإيصال">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="دفع / طباعة" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding HoldInvoiceCommand}"
                                Style="{StaticResource PosActionHoldButton}" Margin="2,0"
                                ToolTip="إيقاف الفاتورة">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="22" Height="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="إيقاف" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCartCommand}"
                                Style="{StaticResource PosActionClearButton}" Margin="4,0,0,0"
                                ToolTip="مسح السلة">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CartOff" Width="22" Height="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="مسح" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding PosCustomers}"
                              SelectedItem="{Binding SelectedPosCustomer}"
                              materialDesign:HintAssist.Hint="العميل (ابحث بالاسم أو رقم العميل)"
                              Style="{StaticResource CustomerSearchableComboBox}"
                              Margin="0,0,0,10"/>

                    <DataGrid x:Name="PosCartGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding CartLines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              Style="{StaticResource PosDataGrid}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              FrozenColumnCount="1"
                              RowHeight="44"
                              MinRowHeight="40"
                              MinHeight="0"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource PosHiddenVerticalScrollBar}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="44" MinWidth="44" MaxWidth="44" IsReadOnly="True"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource InvoiceDeleteRowButton}"
                                                Width="34" Height="34"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="حذف البند">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17"
                                                                     Foreground="#C62828"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="المنتج" Width="*" MinWidth="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding DisplayName}"
                                                   Margin="4,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosSize" Header="القياس" Width="70" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosColor" Header="اللون" Width="88" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableColors}"
                                                  SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="ColorName"
                                                  IsEditable="False"
                                                  FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosCustom1" Width="90" Visibility="Collapsed">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.CustomField1Header, Source={x:Reference VmProxy}}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CustomField1, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosCustom2" Width="90" Visibility="Collapsed">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.CustomField2Header, Source={x:Reference VmProxy}}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CustomField2, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosBatch" Header="الدفعة" Width="100" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableBatches}"
                                                  SelectedItem="{Binding SelectedBatch, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="11">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding BatchNumber, TargetNullValue=—}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding ExpiryDate, StringFormat=yyyy-MM-dd, TargetNullValue=—}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosSerial" Header="سيريال" Width="100" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableSerials}"
                                                  Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الكمية" Width="100" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="−" Width="26" Height="26" Padding="0"
                                                    Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatButton}"/>
                                            <Border MinWidth="48" Margin="4,0" CornerRadius="6"
                                                    Background="#F0F4F8" Padding="2,0" VerticalAlignment="Center">
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                                         Style="{StaticResource NumericCellTextBox}"
                                                         MinWidth="40"
                                                         VerticalContentAlignment="Center"
                                                         FontWeight="SemiBold"
                                                         IsReadOnly="{Binding IsOfferGift}"/>
                                            </Border>
                                            <Button Content="+" Width="26" Height="26" Padding="0"
                                                    Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="66" MinWidth="52"/>
                            <DataGridTextColumn x:Name="ColPosDiscount" Header="الخصم" Binding="{Binding DiscountAmount, StringFormat=N0}" Width="70" IsReadOnly="True"
                                                Visibility="Collapsed"/>
                            <DataGridTextColumn Header="المجموع" Binding="{Binding LineTotal, StringFormat=N0}" Width="70" MinWidth="56" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Summary (always visible above pay buttons) -->
                    <Border Grid.Row="3" Background="#F5F9FC" CornerRadius="12" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المجموع الفرعي" Foreground="#607D8B" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:N0} د.ع'}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,10,0,2"
                                  MinHeight="44"
                                  Visibility="{Binding ShowProductDiscount, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="90"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="خصم" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding InvoiceDiscountTypeOptions}"
                                          SelectedItem="{Binding SelectedInvoiceDiscountOption}"
                                          DisplayMemberPath="Label"
                                          Height="40"
                                          MinHeight="40"
                                          Margin="0,0,6,0"
                                          VerticalContentAlignment="Center"
                                          Style="{StaticResource MaterialDesignFilledComboBox}"
                                          materialDesign:HintAssist.Hint="النوع"
                                          materialDesign:TextFieldAssist.HasLeadingIcon="False"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding InvoiceDiscountValue, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="قيمة"
                                         Style="{StaticResource MaterialDesignFilledTextBox}"
                                         Height="40"
                                         MinHeight="40"
                                         Margin="0,0,6,0"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0"/>
                                <TextBlock Grid.Column="3"
                                           Text="{Binding InvoiceDiscountAmount, StringFormat='{}{0:N0}'}"
                                           FontWeight="SemiBold" Foreground="#2E7D32" FontSize="13"
                                           VerticalAlignment="Center"
                                           ToolTip="مبلغ الخصم"/>
                            </Grid>

                            <loyalty:LoyaltyPanel Margin="0,8,0,0" IsCompact="True" DataContext="{Binding}"/>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الإجمالي" FontSize="16" FontWeight="Bold"
                                           Foreground="#0D47A1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}"
                                           FontSize="24" FontWeight="Bold" Foreground="#1565C0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bottom actions -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Command="{Binding OpenCurrencyChangeCommand}"
                                Style="{StaticResource OutlinedButton}" Height="40" Margin="0,0,0,8"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                BorderBrush="#1565C0" Foreground="#1565C0"
                                ToolTip="حساب الباقي بعملات الدينار العراقي (F7)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="حساب العملات (F7)" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenPaymentDialogCommand}"
                                    Style="{StaticResource PosPayPrintButton}" Height="48" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashCheck" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="إتمام البيع" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding PrintThermalReceiptCommand}"
                                    Style="{StaticResource OutlinedButton}" Height="48" Margin="6,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    ToolTip="طباعة آخر فاتورة بحجم ورق الكاشير المختار">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="طباعة" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <CheckBox Grid.Column="2" Content="طباعة تلقائية" IsChecked="{Binding PrintAfterSale}"
                                      VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11"/>
                        </Grid>
                        <Button Grid.Row="2" Command="{Binding PrintPharmacyReceiptCommand}"
                                Style="{StaticResource OutlinedButton}" Height="40" Margin="0,8,0,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                BorderBrush="#2E7D32" Foreground="#2E7D32"
                                Visibility="{Binding ShowPharmacy, Converter={StaticResource BoolVis}}"
                                ToolTip="طباعة إيصال صيدلية يتضمن طريقة الاستخدام (80/58 حسب إعداد الطباعة)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pill" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="طباعة صيدلية (طريقة الاستخدام)" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Style="{StaticResource PageLoading}" Grid.RowSpan="2"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="40" Height="40"/>
        </Border>

        <!-- Payment dialog -->
        <materialDesign:DialogHost IsOpen="{Binding IsPaymentDialogOpen}"
                                   CloseOnClickAway="False"
                                   Style="{StaticResource ModernDialogHost}"
                                   Grid.RowSpan="2">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="420" MaxWidth="480" Padding="28,24" Background="White" CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#0D47A1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="#E3F2FD" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                                         Foreground="#1565C0"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إتمام الدفع" FontSize="20" FontWeight="Bold" Foreground="#0D47A1"/>
                                <TextBlock Text="راجع المبلغ ثم أكّد الدفع" FontSize="12" Foreground="#78909C" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#F5F9FC" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المبلغ الكامل" VerticalAlignment="Center" Foreground="#546E7A" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}"
                                           FontSize="26" FontWeight="Bold" Foreground="#1565C0"/>
                            </Grid>
                        </Border>

                        <ComboBox ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  materialDesign:HintAssist.Hint="الصندوق"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource FilledComboBox}"
                                  Margin="0,0,0,12"/>

                        <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                 materialDesign:HintAssist.Hint="المبلغ المدفوع"
                                 materialDesign:HintAssist.IsFloating="True"
                                 Style="{StaticResource FilledTextBox}"
                                 Margin="0,0,0,8"
                                 FontSize="18" FontWeight="SemiBold"/>

                        <Button Command="{Binding OpenCurrencyChangeCommand}"
                                Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Left"
                                Foreground="#1565C0"
                                Padding="4,2"
                                Margin="0,0,0,8"
                                ToolTip="حساب الباقي بعملات الدينار (F7)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="حساب العملات (F7)" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="#E8F5E9" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding ShowChangeDue, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الباقي للزبون" VerticalAlignment="Center" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding ChangeAmount, StringFormat='{}{0:N0} د.ع'}"
                                           FontWeight="Bold" FontSize="18" Foreground="#1B5E20"/>
                            </Grid>
                        </Border>

                        <Border Background="#FFF8E1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding ShowCreditRemaining, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="المتبقي آجل" VerticalAlignment="Center" Foreground="#F57F17" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CreditRemainingAmount, StringFormat='{}{0:N0} د.ع'}"
                                               FontWeight="Bold" FontSize="18" Foreground="#E65100"/>
                                </Grid>
                                <TextBlock Text="سيُسجَّل كفاتورة آجلة — يلزم اختيار عميل" FontSize="11"
                                           Foreground="#F9A825" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ComboBox ItemsSource="{Binding PosCustomers}"
                                  SelectedItem="{Binding SelectedPosCustomer}"
                                  materialDesign:HintAssist.Hint="العميل (ابحث بالاسم أو رقم العميل)"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource CustomerSearchableComboBox}"
                                  Margin="0,4,0,16"
                                  Visibility="{Binding ShowCreditRemaining, Converter={StaticResource BoolVis}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding ConfirmPaymentCommand}"
                                    Style="{StaticResource PosPayPrintButton}" Height="44" Padding="28,0"
                                    materialDesign:ButtonAssist.CornerRadius="10" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="تأكيد الدفع" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClosePaymentDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="44" Padding="22,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>
