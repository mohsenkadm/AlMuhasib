<UserControl x:Class="AlMuhasib.UI.Views.PosQuickSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PosQuickSaleViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" CornerRadius="14" Margin="0,0,0,12" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0D47A1" Offset="0"/>
                    <GradientStop Color="#1976D2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="بيع سريع (POS)" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#26FFFFFF" CornerRadius="10" Padding="16,8">
                    <StackPanel>
                        <TextBlock Text="الإجمالي" FontSize="11" Foreground="#B3FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N0} د.ع'}"
                                   FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Products -->
            <materialDesign:Card Grid.Column="0" Style="{StaticResource ElevatedCard}"
                                 UniformCornerRadius="12" Padding="16" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="المفضلة" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding FavoriteProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Margin="0,0,6,6" Padding="10,8"
                                            Style="{StaticResource PrimaryButton}"
                                            materialDesign:ButtonAssist.CornerRadius="8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Star" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" Margin="6,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             materialDesign:HintAssist.Hint="باركود أو اسم منتج — Enter للإضافة"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             KeyDown="SearchBox_KeyDown"
                             Margin="0,0,0,10"/>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" Margin="0,0,6,0"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  ItemsSource="{Binding Warehouses}"
                                  SelectedItem="{Binding SelectedWarehouse}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"/>
                        <ComboBox Grid.Column="1" Margin="6,0,0,0"
                                  materialDesign:HintAssist.Hint="القاصة"
                                  ItemsSource="{Binding CashBoxes}"
                                  SelectedItem="{Binding SelectedCashBox}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                <Border Margin="0,0,8,8" Padding="0" Background="Transparent">
                                    <Grid>
                                        <Button Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="12,10,28,10"
                                                Style="{StaticResource OutlinedButton}"
                                                materialDesign:ButtonAssist.CornerRadius="10"
                                                MinWidth="140" MaxWidth="200">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Barcode}" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"
                                                Width="28" Height="28"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="4,4,0,0" ToolTip="إضافة/إزالة من المفضلة">
                                            <materialDesign:PackIcon Kind="StarOutline" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </materialDesign:Card>

            <!-- Cart -->
            <materialDesign:Card Grid.Column="1" Style="{StaticResource ElevatedCard}"
                                 UniformCornerRadius="12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="السلة" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CartLines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="70"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="80"/>
                            <DataGridTextColumn Header="المجموع" Binding="{Binding LineTotal, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource TableDeleteIconButton}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Command="{Binding CompleteSaleCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="44" Padding="24,0" Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashCheck" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="إتمام البيع (نقدي)" Margin="8,0,0,0" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCartCommand}"
                                Style="{StaticResource FlatButton}"
                                Height="44" Content="مسح السلة"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
