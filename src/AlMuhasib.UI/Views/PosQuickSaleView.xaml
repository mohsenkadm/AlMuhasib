<UserControl x:Class="AlMuhasib.UI.Views.PosQuickSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:loyalty="clr-namespace:AlMuhasib.UI.Controls.Loyalty"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=vm:PosQuickSaleViewModel}"
             Style="{StaticResource PosPageStyle}"
             FontFamily="{DynamicResource AppFont}"
             FlowDirection="RightToLeft"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch"
             ClipToBounds="True"
             Loaded="Root_Loaded"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="فحص الربح" Command="{Binding CheckProfitCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="ChartLine" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="الدفع" Command="{Binding OpenPaymentDialogCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Cash" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="دفع وطباعة (F12)" Command="{Binding OpenPaymentDialogAndPrintCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تعليق الفاتورة" Command="{Binding HoldInvoiceCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Pause" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="الفواتير المعلقة" Command="{Binding ShowHeldInvoicesCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="PlaylistPlay" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="آخر الفواتير" Command="{Binding ShowRecentInvoicesCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="ReceiptText" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="تفريغ السلة" Command="{Binding ClearCartCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="CartOff" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="حاسبة العملة" Command="{Binding OpenCurrencyChangeCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Cash" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة حرارية" Command="{Binding PrintThermalReceiptCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="PrinterPos" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="طباعة صيدلية" Command="{Binding PrintPharmacyReceiptCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="ملء الشاشة" Command="{Binding ToggleFullscreenCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Fullscreen" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolVis"/>
        <converters:ObjectsEqualMultiConverter x:Key="ObjectsEqual"/>
        <converters:EnumToBoolConverter x:Key="EnumToBool"/>
        <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        <!-- Touch-first POS chrome: readable, 40px+ targets, no microscopic UI -->
        <Style x:Key="PosCompactCombo" TargetType="ComboBox" BasedOn="{StaticResource FilledComboBox}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="True"/>
        </Style>
        <Style x:Key="PosToolbarIconButton" TargetType="Button" BasedOn="{StaticResource OutlinedButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="PosFullscreenCloseButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#E53935" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C62828"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B71C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PosCartColumnHeader" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ModernDataGridColumnHeader}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="#0D47A1"/>
            <Setter Property="Background" Value="#E3F2FD"/>
            <Setter Property="BorderBrush" Value="#BBDEFB"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="PosShell" Margin="0" MinHeight="0" behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsFullscreenActive}" Value="True"/>
                            <Condition Binding="{Binding IsFullscreenHost, ElementName=Root}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="0"/>
            </Grid.RowDefinitions>

        <!-- Proxy outside DataGrid columns to avoid x:Reference cyclical dependency -->
        <FrameworkElement x:Name="VmProxy" Visibility="Collapsed"/>

        <!-- Professional POS header: compact selectors, touch-sized actions -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="12,10" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox Width="150"
                              ItemsSource="{Binding Warehouses}"
                              SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource PosCompactCombo}"
                              materialDesign:HintAssist.Hint="المخزن"
                              ToolTip="المخزن"
                              Margin="0,0,8,0"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding FilteredCashBoxes}"
                              SelectedItem="{Binding SelectedCashBox}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource PosCompactCombo}"
                              materialDesign:HintAssist.Hint="القاصة"
                              ToolTip="القاصة / الصندوق"
                              Margin="0,0,8,0"/>
                    <ComboBox Width="140"
                              ItemsSource="{Binding BulkPricingTypes}"
                              SelectedItem="{Binding SelectedBulkPricingType}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource PosCompactCombo}"
                              materialDesign:HintAssist.Hint="التسعير"
                              ToolTip="نوع التسعير"
                              Visibility="{Binding ShowProductPricing, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding FxRateText}" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#1565C0"
                               Visibility="{Binding ShowFxInfo, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="10" Padding="10,0" Height="40"
                            Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CartOutline" Width="18" Height="18"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            <TextBlock Text="{Binding CartLineCount, StringFormat='{}{0} بند'}"
                                       FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ShowHeldInvoicesCommand}"
                            Style="{StaticResource PosToolbarIconButton}"
                            ToolTip="الفواتير المعلقة">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlaylistPlay" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding HeldInvoiceCount, StringFormat='معلقة ({0})'}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowRecentInvoicesCommand}"
                            Style="{StaticResource PosToolbarIconButton}"
                            ToolTip="آخر الفواتير">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ReceiptText" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="آخر الفواتير" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFullscreenCommand}"
                            Style="{StaticResource PosToolbarIconButton}"
                            ToolTip="فتح الكاشير بملء الشاشة"
                            Visibility="{Binding IsFullscreenHost, ElementName=Root, Converter={StaticResource InverseBoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="ملء الشاشة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFullscreenCommand}"
                            Style="{StaticResource PosToolbarIconButton}"
                            ToolTip="الخروج من ملء الشاشة"
                            Visibility="{Binding IsFullscreenHost, ElementName=Root, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FullscreenExit" Width="18" Height="18" VerticalAlignment="Center"/>
                            <TextBlock Text="ملء الشاشة" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFullscreenCommand}"
                            Style="{StaticResource PosFullscreenCloseButton}"
                            ToolTip="إغلاق نافذة الكاشير والعودة للنظام"
                            Visibility="{Binding IsFullscreenHost, ElementName=Root, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="إغلاق" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" MinHeight="0" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="320"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Catalog -->
            <Border Grid.Column="0" Style="{StaticResource PosPanelCard}" Padding="10" CornerRadius="12" MinHeight="0">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="0"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="الأصناف" FontWeight="SemiBold" FontSize="15"
                                   Margin="0,0,0,6" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <!-- Wrap to next rows when many categories; ~3 rows then vertical scroll -->
                        <ListBox ItemsSource="{Binding Categories}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="0"
                                 MaxHeight="156"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Focusable="False"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="False"
                                                  Style="{DynamicResource ThinScrollViewer}">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,8,8"/>
                                    <Setter Property="Focusable" Value="True"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Height="45" MinHeight="45" Padding="18,0" CornerRadius="12"
                                                        Background="{DynamicResource CardBrush}"
                                                        BorderBrush="{DynamicResource SubtleBorderBrush}"
                                                        BorderThickness="1" Cursor="Hand">
                                                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#E3F2FD"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#1565C0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#90CAF9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontSize="15" MaxWidth="175"
                                               TextTrimming="CharacterEllipsis"
                                               FontFamily="{DynamicResource AppFont}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="#1565C0"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             materialDesign:HintAssist.Hint="باركود أو اسم — Enter"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}"
                             KeyDown="SearchBox_KeyDown"
                             Margin="0,0,0,8"
                             Height="34" MinHeight="34" FontSize="13"
                             Padding="10,4"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredProducts}"
                             Style="{StaticResource PosProductListBox}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="False"
                             VirtualizingPanel.IsVirtualizing="False"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="0"
                             MinHeight="0"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             ClipToBounds="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Stretch"
                                           ItemWidth="175"
                                           ItemHeight="130"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Width" Value="175"/>
                                <Setter Property="Height" Value="130"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PosProductCard}"
                                        Height="120"
                                        Margin="5"
                                        CornerRadius="14"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Button Grid.RowSpan="2"
                                                Style="{StaticResource PosCardHitButton}"
                                                Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel Margin="14,12,14,0" IsHitTestVisible="False">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"
                                                       TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{DynamicResource AppFont}"/>
                                            <TextBlock FontSize="15" Margin="0,5,0,0" Foreground="#2E7D32"
                                                       FontFamily="{DynamicResource AppFont}">
                                                <Run Text="متوفر"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding AvailableQuantityText, Mode=OneWay}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Margin="14,0,14,12" IsHitTestVisible="False"
                                                   FontWeight="Bold" FontSize="18" Foreground="#1565C0"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   FontFamily="{DynamicResource AppFont}">
                                            <Run Text="{Binding Price, StringFormat=N0, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding DataContext.CurrencyAmountSuffix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Cart -->
            <Border Grid.Column="2" Style="{StaticResource PosPanelCard}" Padding="10" CornerRadius="12" MinHeight="0">
                <Grid MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="180"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
                        <Button Command="{Binding OpenPaymentDialogAndPrintCommand}"
                                Style="{StaticResource PosActionPayButton}" Height="52" Margin="0,0,4,0"
                                ToolTip="إتمام البيع وطباعة مباشرة على الطابعة الافتراضية (F12)">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CashRegister" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="دفع / طباعة" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding HoldInvoiceCommand}"
                                Style="{StaticResource PosActionHoldButton}" Height="52" Margin="2,0"
                                ToolTip="تعليق الفاتورة">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="PauseCircleOutline" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="تعليق" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowHeldInvoicesCommand}"
                                Style="{StaticResource PosActionHoldButton}" Height="52" Margin="2,0"
                                ToolTip="استئناف فاتورة معلقة">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="PlaylistPlay" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="معلقة" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearCartCommand}"
                                Style="{StaticResource PosActionClearButton}" Height="52" Margin="4,0,0,0"
                                ToolTip="مسح السلة">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CartOff" Width="20" Height="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="مسح" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding PosCustomers}"
                                  SelectedItem="{Binding SelectedPosCustomer}"
                                  materialDesign:HintAssist.Hint="العميل"
                                  Style="{StaticResource CustomerSearchableComboBox}"
                                  FontSize="12" Height="32" MinHeight="32" MaxHeight="32"
                                  Padding="8,2"/>
                        <Button Grid.Column="1"
                                Command="{Binding OpenQuickAddCustomerCommand}"
                                ToolTip="إضافة عميل جديد"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="32" Height="32"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Button>
                    </Grid>

                    <DataGrid x:Name="PosCartGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding CartLines}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              Style="{StaticResource PosDataGrid}"
                              ColumnHeaderStyle="{StaticResource PosCartColumnHeader}"
                              FontSize="14"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              FrozenColumnCount="1"
                              RowHeight="56"
                              MinRowHeight="52"
                              ColumnHeaderHeight="44"
                              MinHeight="0"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                        <DataGrid.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource PosHiddenVerticalScrollBar}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="40" MinWidth="40" MaxWidth="40" IsReadOnly="True"
                                                    CanUserResize="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ModernDataGridCell}">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource InvoiceDeleteRowButton}"
                                                Width="32" Height="32"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="حذف البند">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"
                                                                     Foreground="#C62828"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="المنتج" Width="2.2*" MinWidth="160" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding DisplayName}"
                                                   Margin="6,4"
                                                   FontFamily="{DynamicResource AppFont}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosSize" Header="القياس" Width="70" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosColor" Header="اللون" Width="88" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableColors}"
                                                  SelectedItem="{Binding SelectedColor, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="ColorName"
                                                  IsEditable="False"
                                                  FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosCustom1" Width="90" Visibility="Collapsed">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.CustomField1Header, Source={x:Reference VmProxy}}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CustomField1, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosCustom2" Width="90" Visibility="Collapsed">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{Binding DataContext.CustomField2Header, Source={x:Reference VmProxy}}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CustomField2, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" BorderThickness="0" Background="Transparent"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosBatch" Header="الدفعة" Width="100" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableBatches}"
                                                  SelectedItem="{Binding SelectedBatch, UpdateSourceTrigger=PropertyChanged}"
                                                  FontSize="11">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding BatchNumber, TargetNullValue=—}"/>
                                                        <Run Text=" / "/>
                                                        <Run Text="{Binding ExpiryDate, StringFormat=yyyy-MM-dd, TargetNullValue=—}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosSerial" Header="سيريال" Width="100" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding AvailableSerials}"
                                                  Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEditable="True"
                                                  FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosWarranty" Header="انتهاء الضمان" Width="120" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding WarrantyEndDate, UpdateSourceTrigger=PropertyChanged}"
                                                    FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="الكمية" Width="130" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Content="−" Width="34" Height="34" Padding="0" FontSize="16" FontWeight="Bold"
                                                    Command="{Binding DataContext.DecreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatButton}"/>
                                            <Button Margin="4,0" MinWidth="48" Height="34" Padding="8,0"
                                                    Style="{StaticResource PosTouchValueButton}"
                                                    Command="{Binding DataContext.EditLineQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="اضغط لإدخال الكمية">
                                                <TextBlock Text="{Binding Quantity, StringFormat=N0}" FontWeight="Bold" FontSize="15"
                                                           FontFamily="{DynamicResource AppFont}" Foreground="#0D47A1"/>
                                            </Button>
                                            <Button Content="+" Width="34" Height="34" Padding="0" FontSize="16" FontWeight="Bold"
                                                    Command="{Binding DataContext.IncreaseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource FlatButton}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="السعر" Width="90" MinWidth="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PosTouchValueButton}"
                                                HorizontalAlignment="Stretch" Height="34" MinHeight="34" Padding="6,0"
                                                Command="{Binding DataContext.EditLinePriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="اضغط لإدخال السعر">
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=N0}" FontWeight="Bold" FontSize="14"
                                                       FontFamily="{DynamicResource AppFont}" TextAlignment="Center"
                                                       Foreground="#1565C0"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="ColPosDiscount" Header="الخصم" Width="80" MinWidth="70"
                                                    Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PosTouchValueButton}"
                                                HorizontalAlignment="Stretch" Height="34" MinHeight="34" Padding="6,0"
                                                Command="{Binding DataContext.EditLineDiscountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="اضغط لإدخال الخصم">
                                            <TextBlock Text="{Binding DiscountAmount, StringFormat=N0}" FontWeight="Bold" FontSize="14"
                                                       FontFamily="{DynamicResource AppFont}" TextAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="المجموع" Width="96" MinWidth="84" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LineTotal, StringFormat=N0}"
                                                   FontWeight="Bold" FontSize="15" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" Margin="4,0"
                                                   Foreground="#0D47A1"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" CornerRadius="10"
                            Padding="10,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="فرعي" FontSize="11" Foreground="#78909C" VerticalAlignment="Center"/>
                                    <TextBlock FontWeight="SemiBold" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <Run Text="{Binding SubTotal, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CurrencyAmountSuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <Grid Visibility="{Binding ShowProductDiscount, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding InvoiceDiscountTypeOptions}"
                                              SelectedItem="{Binding SelectedInvoiceDiscountOption}"
                                              DisplayMemberPath="Label"
                                              FontSize="11" Height="28" MinHeight="28" Width="110"
                                              materialDesign:HintAssist.Hint="خصم"
                                              Style="{StaticResource MaterialDesignComboBox}"
                                              Margin="0,0,6,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PosTouchValueButton}"
                                            HorizontalAlignment="Stretch" Height="28" MinHeight="28"
                                            Command="{Binding EditInvoiceDiscountValueCommand}"
                                            ToolTip="قيمة الخصم">
                                        <TextBlock FontFamily="{DynamicResource AppFont}" FontSize="11">
                                            <Run Text="{Binding InvoiceDiscountValue, StringFormat=N0, Mode=OneWay}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </Button>
                                    <TextBlock Grid.Column="2" Margin="6,0,0,0"
                                               FontWeight="SemiBold" Foreground="#2E7D32" FontSize="11"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding InvoiceDiscountAmount, StringFormat=N0, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>

                                <loyalty:LoyaltyPanel Margin="0,4,0,0" IsCompact="True" DataContext="{Binding}"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="10" Padding="14,8" Margin="10,0,0,0"
                                    MinWidth="140" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="الإجمالي" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#1565C0" HorizontalAlignment="Right"/>
                                    <TextBlock FontSize="22" FontWeight="Bold" Foreground="#0D47A1"
                                               FontFamily="{DynamicResource AppFont}" TextAlignment="Right" Margin="0,2,0,0">
                                        <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CurrencyAmountSuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UsdEquivalentText}" FontSize="11"
                                               Foreground="#546E7A"
                                               HorizontalAlignment="Right"
                                               Visibility="{Binding ShowFxInfo, Converter={StaticResource BoolVis}}"
                                               FontFamily="{DynamicResource AppFont}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding OpenCurrencyChangeCommand}"
                                    Style="{StaticResource OutlinedButton}" Height="46" Padding="12,0" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    BorderBrush="#1565C0" Foreground="#1565C0"
                                    ToolTip="حساب الباقي بعملات الدينار العراقي (F7)">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashMultiple" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="عملات" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding OpenPaymentDialogCommand}"
                                    Style="{StaticResource PosPayPrintButton}" Height="46" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashCheck" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <TextBlock Text="إتمام البيع" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding PrintThermalReceiptCommand}"
                                    Style="{StaticResource OutlinedButton}" Height="46" Padding="14,0" Margin="0,0,6,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"
                                    ToolTip="طباعة آخر فاتورة بحجم ورق الكاشير">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="طباعة" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <CheckBox Grid.Column="3" Content="تلقائي" IsChecked="{Binding PrintAfterSale}"
                                      VerticalAlignment="Center" FontSize="11"
                                      ToolTip="طباعة تلقائية"/>
                        </Grid>
                        <Button Grid.Row="1" Command="{Binding PrintPharmacyReceiptCommand}"
                                Style="{StaticResource OutlinedButton}" Height="36" Margin="0,6,0,0"
                                materialDesign:ButtonAssist.CornerRadius="10"
                                BorderBrush="#2E7D32" Foreground="#2E7D32"
                                Visibility="{Binding ShowPharmacy, Converter={StaticResource BoolVis}}"
                                ToolTip="طباعة إيصال صيدلية">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pill" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="طباعة صيدلية" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Style="{StaticResource PageLoading}" Grid.RowSpan="2"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="40" Height="40"/>
        </Border>

        <!-- Payment dialog -->
        <materialDesign:DialogHost IsOpen="{Binding IsPaymentDialogOpen}"
                                   CloseOnClickAway="False"
                                   Style="{StaticResource ModernDialogHost}"
                                   Grid.RowSpan="2">
            <materialDesign:DialogHost.DialogContent>
                <Border MinWidth="420" MaxWidth="480" Padding="28,24" Background="{DynamicResource CardBrush}" CornerRadius="18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#0D47A1"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimaryHueLightBrush}" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="CashRegister" Width="24" Height="24"
                                                         Foreground="#1565C0"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="إتمام الدفع" FontSize="20" FontWeight="Bold" Foreground="#0D47A1"/>
                                <TextBlock Text="راجع المبلغ ثم أكّد الدفع" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="12" Padding="16,14" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="المبلغ الكامل" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock FontSize="26" FontWeight="Bold" Foreground="#1565C0" TextAlignment="Right">
                                        <Run Text="{Binding GrandTotal, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CurrencyAmountSuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UsdEquivalentText}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"
                                               Visibility="{Binding ShowFxInfo, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="القاصة" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding FilteredCashBoxes}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}"
                                            Command="{Binding DataContext.SelectCashBoxCommand, ElementName=Root}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource PosChoiceChip}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource ObjectsEqual}">
                                                                <Binding Path="DataContext.SelectedCashBox" ElementName="Root"/>
                                                                <Binding Path="."/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Tag" Value="Selected"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource PosTouchValueButton}"
                                HorizontalAlignment="Stretch" Height="52" Margin="0,0,0,8"
                                Command="{Binding EditPaidAmountCommand}"
                                ToolTip="اضغط لإدخال المبلغ المدفوع">
                            <TextBlock FontSize="18" FontWeight="SemiBold" FontFamily="{DynamicResource AppFont}">
                                <Run Text="{Binding PaidAmountHint, Mode=OneWay}"/>
                                <Run Text=": "/>
                                <Run Text="{Binding PaidAmount, StringFormat=N0, Mode=OneWay}"/>
                            </TextBlock>
                        </Button>

                        <Button Command="{Binding OpenCurrencyChangeCommand}"
                                Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Left"
                                Foreground="#1565C0"
                                Padding="4,2"
                                Margin="0,0,0,8"
                                ToolTip="حساب الباقي بعملات الدينار (F7)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="حساب العملات (F7)" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Background="{DynamicResource DashboardKpiGreenLightBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding ShowChangeDue, Converter={StaticResource BoolVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="الباقي للزبون" VerticalAlignment="Center" Foreground="#2E7D32" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="18" Foreground="#1B5E20">
                                    <Run Text="{Binding ChangeAmount, StringFormat=N0, Mode=OneWay}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding CurrencyAmountSuffix, Mode=OneWay}"/>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource NotepadPaperBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding ShowCreditRemaining, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="المتبقي آجل" VerticalAlignment="Center" Foreground="#F57F17" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" FontWeight="Bold" FontSize="18" Foreground="#E65100">
                                        <Run Text="{Binding CreditRemainingAmount, StringFormat=N0, Mode=OneWay}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding CurrencyAmountSuffix, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                                <DatePicker SelectedDate="{Binding CreditDueDate}"
                                            materialDesign:HintAssist.Hint="تاريخ استحقاق التسديد"
                                            materialDesign:HintAssist.IsFloating="True"
                                            Style="{StaticResource FilledDatePicker}"
                                            Margin="0,10,0,0"
                                            FontSize="13"
                                            Foreground="#C62828"/>
                                <TextBlock Text="سيُسجَّل كفاتورة آجلة — يلزم اختيار عميل" FontSize="11"
                                           Foreground="#F9A825" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <ComboBox ItemsSource="{Binding PosCustomers}"
                                  SelectedItem="{Binding SelectedPosCustomer}"
                                  materialDesign:HintAssist.Hint="العميل (ابحث بالاسم أو رقم العميل)"
                                  materialDesign:HintAssist.IsFloating="True"
                                  Style="{StaticResource CustomerSearchableComboBox}"
                                  Margin="0,4,0,16"
                                  Visibility="{Binding ShowCreditRemaining, Converter={StaticResource BoolVis}}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Command="{Binding ConfirmPaymentCommand}"
                                    Style="{StaticResource PosPayPrintButton}" Height="44" Padding="28,0"
                                    materialDesign:ButtonAssist.CornerRadius="10" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckBold" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="تأكيد الدفع" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClosePaymentDialogCommand}"
                                    Content="إلغاء"
                                    Style="{StaticResource OutlinedButton}"
                                    Height="44" Padding="22,0"
                                    materialDesign:ButtonAssist.CornerRadius="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </materialDesign:DialogHost.DialogContent>
        </materialDesign:DialogHost>

        <!-- Quick add customer -->
        <Grid Visibility="{Binding IsQuickAddCustomerOpen, Converter={StaticResource BoolVis}}"
              Panel.ZIndex="100" Grid.RowSpan="2">
            <Border Background="#80000000"/>
            <materialDesign:Card Padding="20" MinWidth="380" MaxWidth="460"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 UniformCornerRadius="14"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <StackPanel>
                    <TextBlock Text="إضافة عميل جديد" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    <TextBox materialDesign:HintAssist.Hint="اسم العميل *"
                             Text="{Binding QuickCustomerName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                    <TextBox materialDesign:HintAssist.Hint="رقم الهاتف"
                             Text="{Binding QuickCustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                    <TextBox materialDesign:HintAssist.Hint="العنوان"
                             Text="{Binding QuickCustomerAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FilledTextBox}" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding QuickCustomerError}" Foreground="#D32F2F" Margin="0,0,0,8"
                               Visibility="{Binding QuickCustomerError, Converter={StaticResource NullToCollapsedConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,0">
                        <Button Content="حفظ" Command="{Binding SaveQuickCustomerCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="8" Padding="20,6" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Command="{Binding CancelQuickAddCustomerCommand}"
                                Style="{StaticResource FlatButton}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
