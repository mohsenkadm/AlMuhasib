<UserControl x:Class="AlMuhasib.UI.Views.ExpiryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ExpiryReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="تقرير الصلاحية" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="متابعة دفعات المنتجات حسب تاريخ انتهاء الصلاحية مع فلاتر البحث"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="منتهي" TextValue="{Binding ExpiredCount}" Icon="CloseCircle"
                                               IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="قريب (30 يوم)" TextValue="{Binding CriticalCount}" Icon="Alert"
                                               IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="تحذير (90 يوم)" TextValue="{Binding WarningCount}" Icon="ClockAlert"
                                               IconBackground="#FFF8E1" IconForeground="#F9A825" ValueForeground="#F9A825"/>
                    <controls:AnimatedStatCard Title="كمية متأثرة" TextValue="{Binding AffectedQuantity}" Icon="PackageVariant"
                                               IconBackground="#ECEFF1" IconForeground="#455A64" ValueForeground="#455A64"/>
                </UniformGrid>

                <Border Style="{StaticResource FilterBar}">
                    <WrapPanel>
                        <ComboBox ItemsSource="{Binding Warehouses}"
                                  SelectedValue="{Binding SelectedWarehouseId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="المخزن"
                                  Width="150" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Products}"
                                  SelectedValue="{Binding SelectedProductId}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="منتج (الكل)"
                                  Width="180" Margin="0,0,12,8"/>
                        <TextBox Text="{Binding ProductSearch, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}"
                                 materialDesign:HintAssist.Hint="بحث بالاسم / باركود / دفعة"
                                 Width="200" Margin="0,0,12,8"/>
                        <ComboBox ItemsSource="{Binding Filters}"
                                  SelectedValue="{Binding SelectedFilter}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="حالة الصلاحية"
                                  Width="150" Margin="0,0,12,8"/>
                        <DatePicker SelectedDate="{Binding ExpiryFrom}"
                                    Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="انتهاء من"
                                    Width="140" Margin="0,0,12,8"/>
                        <DatePicker SelectedDate="{Binding ExpiryTo}"
                                    Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="انتهاء إلى"
                                    Width="140" Margin="0,0,12,8"/>
                        <CheckBox Content="إخفاء الكمية صفر"
                                  IsChecked="{Binding HideZeroQuantity}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,8"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}"
                                Command="{Binding LoadDataCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="تقرير الصلاحية"
                                             TargetDataGrid="{Binding ElementName=ExpiryGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="ExpiryGrid"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          MinHeight="280"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"

                                  Grid.Row="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProductName"/>
                        <DataGridTextColumn Header="الباركود" Binding="{Binding ProductBarcode}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ProductBarcode"/>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="WarehouseName"/>
                        <DataGridTextColumn Header="رقم الدفعة" Binding="{Binding BatchNumberDisplay}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="BatchNumberDisplay"/>
                        <DataGridTextColumn Header="تاريخ الانتهاء" Binding="{Binding ExpiryDateDisplay}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="ExpiryDateDisplay"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N0}" Width="80"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Quantity"/>
                        <DataGridTextColumn Header="الأيام المتبقية" Binding="{Binding DaysRemainingDisplay}" Width="110"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DaysRemainingDisplay"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="120"
                                            behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="StatusDisplay"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
