<UserControl x:Class="AlMuhasib.UI.Views.SalesReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SalesReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير المبيعات" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="5" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي المبيعات" TextValue="{Binding TotalSales}" Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="نسبة الشركة" TextValue="{Binding TotalCompanyFees}" Icon="Percent" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                    <controls:AnimatedStatCard Title="عدد الفواتير" TextValue="{Binding InvoiceCount}" Icon="FileDocument" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="متوسط الفاتورة" TextValue="{Binding AverageInvoice}" Icon="Calculator" IconBackground="{DynamicResource AccentLightBrush}" IconForeground="{DynamicResource AccentBrush}" ValueForeground="{DynamicResource AccentBrush}"/>
                    <controls:AnimatedStatCard Title="مبيعات اليوم" TextValue="{Binding TodaySales}" Icon="CalendarToday" IconBackground="#E0F2F1" IconForeground="#00796B" ValueForeground="#00796B"/>
                </UniformGrid>

                <!-- ═══ Chart ═══ -->
                <controls:ChartCard Title="المبيعات اليومية">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding DailySeries}" XAxes="{Binding DailyXAxes}" YAxes="{Binding DailyYAxes}" Height="300"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox Width="220" Margin="0,0,12,0"
                                  ItemsSource="{Binding FilteredCustomers}"
                                  SelectedItem="{Binding SelectedCustomer, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="العميل (ابحث بالاسم أو الهاتف)"/>
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن" Width="160" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethodItem}" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="طريقة الدفع" Width="150" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <controls:ColumnFilterToggle IsChecked="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                       ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                       ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                       TargetDataGrid="{Binding ElementName=SalesReportGrid}"
                                                       Margin="0,0,12,0"/>
                        <Button Content="طباعة" Style="{StaticResource OutlinedButton}" Command="{Binding PrintCommand}" Margin="0,0,8,0"/>
                        <Button Content="تصدير Excel" Style="{StaticResource OutlinedButton}" Command="{Binding ExportToExcelCommand}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="انقر مرتين على صف الفاتورة لعرض التفاصيل الكاملة (البنود وجدول الأقساط إن وُجد)"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid x:Name="SalesReportGrid"
                                  ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                                  behaviors:DataGridReportRowBehavior.DoubleClickCommand="{Binding OpenInvoiceDetailFromReportRowCommand}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceNumber"/>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=\{0:yyyy/MM/dd\}}" Width="95"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                                <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentMethod}" Width="60"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaymentMethod"/>
                                <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat=N0}" Width="90"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NetAmount"/>
                                <DataGridTextColumn Header="نسبة الشركة" Binding="{Binding CompanyFeeAmount, StringFormat=N0}" Width="100"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CompanyFeeAmount"/>
                                <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat=N0}" Width="90"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="90"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                                <DataGridTemplateColumn Header="الإجراءات" Width="310" MinWidth="310"
                                                        behaviors:DataGridColumnFilterBehavior.IsFilterable="False">
                                    <DataGridTemplateColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource TableActionsCellStyle}"/>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource TableViewIconButton}" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Eye" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableEditIconButton}"
                                                        Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="تعديل الفاتورة">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TablePrintIconButton}" Command="{Binding DataContext.PrintRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Printer" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableSecondaryIconButton}" Command="{Binding DataContext.CopyInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="نسخ إلى فاتورة جديدة">
                                                    <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableSecondaryIconButton}" Command="{Binding DataContext.ReturnInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        ToolTip="مرتجع مبيعات">
                                                    <materialDesign:PackIcon Kind="KeyboardReturn" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableSecondaryIconButton}" Command="{Binding DataContext.OpenPaymentDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsCredit, Converter={StaticResource BoolToVis}}">
                                                    <materialDesign:PackIcon Kind="CashCheck" Width="18" Height="18"/>
                                                </Button>
                                                <Button Style="{StaticResource TableDeleteIconButton}" Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <controls:PaginationBar Grid.Row="1"/>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Payment Dialog ═══ -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsPaymentDialogOpen, Converter={StaticResource BoolToVis}}">
            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp8" UniformCornerRadius="16" Padding="28"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="400" MaxWidth="500">
                <StackPanel>
                    <TextBlock Text="تسديد فاتورة آجلة" FontSize="18" FontWeight="Bold" Foreground="#1565C0" Margin="0,0,0,16"/>
                    <TextBlock Margin="0,0,0,4" Foreground="#757575">
                        <Run Text="رقم الفاتورة: "/><Run Text="{Binding PaymentTargetRow.InvoiceNumber, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,4" Foreground="#757575">
                        <Run Text="المبلغ الكلي: "/><Run Text="{Binding PaymentTargetRow.NetAmount, StringFormat=N0, Mode=OneWay}" FontWeight="Bold"/><Run Text=" د.ع"/>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,12" Foreground="#C62828">
                        <Run Text="المتبقي: "/><Run Text="{Binding PaymentTargetRow.RemainingAmount, StringFormat=N0, Mode=OneWay}" FontWeight="Bold"/><Run Text=" د.ع"/>
                    </TextBlock>
                    <TextBox materialDesign:HintAssist.Hint="مبلغ التسديد" Style="{StaticResource NumericTextBox}"
                             Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding CashBoxes}" SelectedItem="{Binding PaymentCashBox}" DisplayMemberPath="Name"
                              Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="القاصة" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="تسديد" Style="{StaticResource SuccessButton}" Command="{Binding ConfirmPaymentCommand}" Margin="0,0,8,0"/>
                        <Button Content="إلغاء" Style="{StaticResource OutlinedButton}" Command="{Binding CancelPaymentCommand}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </Border>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
