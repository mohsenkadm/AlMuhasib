<UserControl x:Class="AlMuhasib.UI.Views.EmployeeStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <md:Card Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="كشف حساب موظف (سلف)" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <ComboBox ItemsSource="{Binding FilteredEmployees}"
                              SelectedItem="{Binding SelectedEmployee}"
                              IsEditable="True"
                              Text="{Binding EmployeeSearchText, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              md:HintAssist.Hint="الموظف"
                              Style="{StaticResource FilledComboBox}"
                              Width="260" Margin="0,0,12,8"/>
                    <DatePicker SelectedDate="{Binding DateFrom}" md:HintAssist.Hint="من تاريخ"
                                Style="{StaticResource FilledDatePicker}" Width="160" Margin="0,0,12,8"/>
                    <DatePicker SelectedDate="{Binding DateTo}" md:HintAssist.Hint="إلى تاريخ"
                                Style="{StaticResource FilledDatePicker}" Width="160" Margin="0,0,12,8"/>
                    <Button Content="عرض" Command="{Binding LoadDataCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            md:ButtonAssist.CornerRadius="8" Padding="24,8" Margin="0,0,8,8"/>
                    <Button Content="واتساب" Command="{Binding ShareWhatsAppCommand}"
                            Style="{StaticResource FlatButton}" Margin="0,0,8,8"/>
                    <Button Content="طباعة" Command="{Binding PrintCommand}"
                            Style="{StaticResource FlatButton}" Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </md:Card>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
            <controls:AnimatedStatCard Title="الموظف" TextValue="{Binding EmployeeName}"
                                       Icon="BadgeAccount" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="#1565C0"/>
            <controls:AnimatedStatCard Title="إجمالي الدفع" TextValue="{Binding TotalPayments}"
                                       Icon="CashMinus" IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}" IconForeground="#EF6C00"/>
            <controls:AnimatedStatCard Title="إجمالي القبض" TextValue="{Binding TotalReceipts}"
                                       Icon="CashPlus" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}" IconForeground="#2E7D32"/>
            <controls:AnimatedStatCard Title="رصيد السلفة" TextValue="{Binding Balance}"
                                       Icon="ScaleBalance" IconBackground="{DynamicResource DashboardKpiTealLightBrush}" IconForeground="#00695C"/>
        </UniformGrid>

        <md:Card Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column"
                      Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="110"/>
                    <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="70"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="100"/>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="110"/>
                    <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNumber}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </md:Card>
    </Grid>
</UserControl>
