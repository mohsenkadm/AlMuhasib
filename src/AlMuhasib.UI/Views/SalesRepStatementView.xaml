<UserControl x:Class="AlMuhasib.UI.Views.SalesRepStatementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SalesRepStatementViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="كشف حساب المندوب" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="4" Margin="0,0,0,12">
                    <controls:AnimatedStatCard Title="إجمالي المبيعات" TextValue="{Binding TotalSales}" Icon="CashRegister" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="إجمالي التحصيل" TextValue="{Binding TotalCollections}" Icon="CashPlus" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="الذمم المتبقية" TextValue="{Binding RemainingReceivables}" Icon="CashMinus" IconBackground="#FFEBEE" IconForeground="#C62828" ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard Title="إجمالي العمولات" TextValue="{Binding TotalCommissions}" Icon="Percent" IconBackground="#F3E5F5" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                </UniformGrid>
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="عمولات مدفوعة" TextValue="{Binding PaidCommissions}" Icon="CashCheck" IconBackground="#E0F2F1" IconForeground="#00796B" ValueForeground="#00796B"/>
                    <controls:AnimatedStatCard Title="عمولات غير مدفوعة" TextValue="{Binding UnpaidCommissions}" Icon="CashClock" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard Title="متبقي تسليم" TextValue="{Binding PendingHandover}" Icon="Handshake" IconBackground="#EFEBE9" IconForeground="#5D4037" ValueForeground="#5D4037"/>
                </UniformGrid>

                <controls:ChartCard Title="المبيعات مقابل العمولات">
                    <controls:ChartCard.ChartContent>
                        <lvc:CartesianChart Series="{Binding ChartSeries}" XAxes="{Binding ChartXAxes}" YAxes="{Binding ChartYAxes}" Height="220"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Representatives}" SelectedItem="{Binding SelectedSalesRep}"
                                  DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}"
                                  materialDesign:HintAssist.Hint="المندوب" Width="200" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}"
                                    materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <Button Content="تحميل" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                        <TextBox materialDesign:HintAssist.Hint="بحث في الجدول..." Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FilledTextBox}" MinWidth="180"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Margin="12,8,12,0">
                    <TabItem Header="الفواتير الأخيرة"/>
                    <TabItem Header="العمولات"/>
                </TabControl>

                <controls:ListTableHeaderBar Grid.Row="1"
                                             Title="تفاصيل الكشف"
                                             TargetDataGrid="{Binding ElementName=StatementGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <Grid Grid.Row="2">
                    <DataGrid x:Name="StatementGrid" ItemsSource="{Binding InvoiceRows}" Style="{StaticResource ModernDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" MinHeight="240"
                              Visibility="{Binding ShowInvoicesTab, Converter={StaticResource BooleanToVisibilityConverter}}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفاتورة" Binding="{Binding InvoiceNumber}" Width="110"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceNumber"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Date"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                            <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="NetAmount"/>
                            <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                            <DataGridTextColumn Header="العمولة" Binding="{Binding CommissionAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CommissionAmount"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DataGrid ItemsSource="{Binding CommissionRows}" Style="{StaticResource ModernDataGrid}"
                              IsReadOnly="True" AutoGenerateColumns="False" MinHeight="240"
                              Visibility="{Binding ShowInvoicesTab, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                              behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                              behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                              behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفاتورة" Binding="{Binding InvoiceNumber}" Width="110"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceNumber"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding InvoiceDate, StringFormat=yyyy/MM/dd}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="InvoiceDate"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding CommissionType}" Width="120"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CommissionType"/>
                            <DataGridTextColumn Header="العمولة" Binding="{Binding CommissionAmount, StringFormat=N0}" Width="100"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CommissionAmount"/>
                            <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat=N0}" Width="90"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PaidAmount"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding UnpaidAmount, StringFormat=N0}" Width="90"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="UnpaidAmount"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90"
                                                behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Status"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <controls:PaginationBar Grid.Row="3"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
