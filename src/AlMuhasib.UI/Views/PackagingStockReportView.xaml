<UserControl x:Class="AlMuhasib.UI.Views.PackagingStockReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:PackagingStockReportViewModel, IsDesignTimeCreatable=False}"
             mc:Ignorable="d"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="كميات حسب التعبئة" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="الرصيد بالوحدة الأساسية (مثل اللتر) ومكافئه لكل نوع تعبئة"
                           FontSize="13" Foreground="#607D8B" Margin="0,0,0,20"/>
                <UniformGrid Columns="3" Margin="0,0,0,20">
                    <controls:AnimatedStatCard Title="إجمالي الأساسي" TextValue="{Binding TotalBaseQuantity}" Icon="PackageVariant" IconBackground="#E3F2FD" IconForeground="#1565C0" ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard Title="عدد المنتجات" TextValue="{Binding ProductCount}" Icon="Barcode" IconBackground="#E8F5E9" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard Title="عدد الصفوف" TextValue="{Binding RowCount}" Icon="Table" IconBackground="#FFF3E0" IconForeground="#EF6C00" ValueForeground="#EF6C00"/>
                </UniformGrid>
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المخزن" Width="160" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Products}" SelectedValue="{Binding SelectedProductId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="المنتج" Width="200" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <materialDesign:Card Grid.Row="1" Style="{StaticResource ElevatedCard}" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <controls:ListTableHeaderBar Grid.Row="0" Title="المخزون حسب التعبئة"
                                             TargetDataGrid="{Binding ElementName=PackagingGrid}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>
                <DataGrid x:Name="PackagingGrid" Grid.Row="1" ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}"
                          IsReadOnly="True" AutoGenerateColumns="False" MinHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="المخزن" Binding="{Binding WarehouseName}" Width="120"/>
                        <DataGridTextColumn Header="الكمية الأساسية" Binding="{Binding BaseQuantity, StringFormat=N0}" Width="120"/>
                        <DataGridTextColumn Header="نوع التعبئة" Binding="{Binding PackagingTypeName}" Width="140"/>
                        <DataGridTextColumn Header="معامل التحويل" Binding="{Binding ConversionFactor, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="المكافئ بالتعبئة" Binding="{Binding EquivalentPackQuantity, StringFormat=N3}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
