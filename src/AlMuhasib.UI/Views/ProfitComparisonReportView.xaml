<UserControl x:Class="AlMuhasib.UI.Views.ProfitComparisonReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProfitComparisonReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="مقارنة الأرباح" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="مقارنة الفترة المحددة بالفترة السابقة بنفس المدة"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20"/>

            <Border Style="{StaticResource FilterBar}" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                    <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                    <Button Content="تحديث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding PeriodLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PreviousPeriodLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <controls:AnimatedStatCard Title="المبيعات (الحالية)" TextValue="{Binding CurrentSales}" Icon="CashRegister" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}" IconForeground="#2E7D32" ValueForeground="#2E7D32"/>
                <controls:AnimatedStatCard Title="المبيعات (السابقة)" TextValue="{Binding PreviousSales}" Icon="History" IconBackground="{DynamicResource MutedIconBackgroundBrush}" IconForeground="{DynamicResource TextSecondaryBrush}" ValueForeground="{DynamicResource TextSecondaryBrush}"/>
                <controls:AnimatedStatCard Title="التغيّر" TextValue="{Binding SalesChange}" Icon="TrendingUp" IconBackground="{DynamicResource DashboardKpiBlueLightBrush}" IconForeground="#1565C0" ValueForeground="#1565C0"/>
            </UniformGrid>

            <UniformGrid Columns="3" Margin="0,0,0,12">
                <controls:AnimatedStatCard Title="إجمالي الربح (الحالي)" TextValue="{Binding CurrentGrossProfit}" Icon="ChartLine" IconBackground="{DynamicResource PrimaryHueLightBrush}" IconForeground="#6A1B9A" ValueForeground="#6A1B9A"/>
                <controls:AnimatedStatCard Title="إجمالي الربح (السابق)" TextValue="{Binding PreviousGrossProfit}" Icon="ChartLineVariant" IconBackground="{DynamicResource MutedIconBackgroundBrush}" IconForeground="{DynamicResource TextSecondaryBrush}" ValueForeground="{DynamicResource TextSecondaryBrush}"/>
                <controls:AnimatedStatCard Title="التغيّر" TextValue="{Binding GrossProfitChange}" Icon="Percent" IconBackground="{DynamicResource NotepadPaperBrush}" IconForeground="#F9A825" ValueForeground="#F9A825"/>
            </UniformGrid>

            <UniformGrid Columns="3">
                <controls:AnimatedStatCard Title="صافي الربح (الحالي)" TextValue="{Binding CurrentNetProfit}" Icon="CurrencyUsd" IconBackground="{DynamicResource DashboardKpiGreenLightBrush}" IconForeground="#1B5E20" ValueForeground="#1B5E20"/>
                <controls:AnimatedStatCard Title="صافي الربح (السابق)" TextValue="{Binding PreviousNetProfit}" Icon="CurrencyUsd" IconBackground="{DynamicResource MutedIconBackgroundBrush}" IconForeground="{DynamicResource TextSecondaryBrush}" ValueForeground="{DynamicResource TextSecondaryBrush}"/>
                <controls:AnimatedStatCard Title="التغيّر" TextValue="{Binding NetProfitChange}" Icon="ArrowUpDown" IconBackground="{DynamicResource DashboardIconBadgeCyanBrush}" IconForeground="#0277BD" ValueForeground="#0277BD"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
