<UserControl x:Class="AlMuhasib.UI.Views.CashBalancesSummaryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:CashBalancesSummaryReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        
        <ContextMenu x:Key="PageActionsMenu">
            <MenuItem Header="بحث / تحديث" Command="{Binding LoadDataCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="تصدير Excel" Command="{Binding ExportToExcelCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="طباعة" Command="{Binding PrintCommand}">
                <MenuItem.Icon><materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid behaviors:PageContextMenuBehavior.Menu="{StaticResource PageActionsMenu}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">
                <TextBlock Text="ملخص أرصدة نقدية" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="6" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="إجمالي السيولة د.ع"
                        TextValue="{Binding TotalLiquid}"
                        Icon="CashMultiple"
                        IconBackground="{DynamicResource DashboardKpiGreenLightBrush}"
                        IconForeground="#2E7D32"
                        ValueForeground="#2E7D32"/>
                    <controls:AnimatedStatCard
                        Title="سيولة $"
                        TextValue="{Binding TotalLiquidUsd}"
                        Icon="CurrencyUsd"
                        IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                        IconForeground="#00695C"
                        ValueForeground="#00695C"/>
                    <controls:AnimatedStatCard
                        Title="القاصات د.ع"
                        TextValue="{Binding CashBoxesTotal}"
                        Icon="Cash"
                        IconBackground="{DynamicResource DashboardKpiBlueLightBrush}"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="القاصات $"
                        TextValue="{Binding CashBoxesTotalUsd}"
                        Icon="Cash"
                        IconBackground="{DynamicResource DashboardKpiTealLightBrush}"
                        IconForeground="#00838F"
                        ValueForeground="#00838F"/>
                    <controls:AnimatedStatCard
                        Title="المصارف د.ع"
                        TextValue="{Binding BanksTotal}"
                        Icon="Bank"
                        IconBackground="{DynamicResource DashboardKpiOrangeLightBrush}"
                        IconForeground="#EF6C00"
                        ValueForeground="#EF6C00"/>
                    <controls:AnimatedStatCard
                        Title="المصارف $"
                        TextValue="{Binding BanksTotalUsd}"
                        Icon="Bank"
                        IconBackground="{DynamicResource PrimaryHueLightBrush}"
                        IconForeground="#6A1B9A"
                        ValueForeground="#6A1B9A"/>
                </UniformGrid>

                <controls:ChartCard Title="التوزيع" Margin="0,0,0,4">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding PieSeries}" Height="300"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ListTableHeaderBar Grid.Row="0"
                                             Title="ملخص أرصدة نقدية"
                                             TargetDataGrid="{Binding ElementName=CashBalancesSummaryReportGrid}"
                                             IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                             ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                             ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                             ExportCommand="{Binding ExportToExcelCommand}"
                                             PrintCommand="{Binding PrintCommand}"
                                             ShowCardToggle="False"/>

                <DataGrid x:Name="CashBalancesSummaryReportGrid"
                          ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" MinHeight="300"
                          behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                          behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                          behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"
                          Grid.Row="1">
                    <DataGrid.Columns>
                                <DataGridTextColumn Header="النوع" Binding="{Binding AccountType}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AccountType"/>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Name"/>
                                <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountNumber}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="AccountNumber"/>
                                <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyLabel}" Width="80"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CurrencyLabel"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N0}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Balance"/>
                    </DataGrid.Columns>
                </DataGrid>

                <controls:PaginationBar Grid.Row="2"/>
            </Grid>
        </materialDesign:Card>

        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
