<UserControl x:Class="AlMuhasib.UI.Views.BarcodePriceCheckView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BarcodePriceCheckViewModel}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft"
             Loaded="Root_Loaded"
             Focusable="True"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <Grid Margin="0,0,8,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="14" Margin="0,0,0,16" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1B5E20" Offset="0"/>
                    <GradientStop Color="#2E7D32" Offset="0.55"/>
                    <GradientStop Color="#43A047" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="فحص السعر بالباركود" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CCFFFFFF" FontSize="13" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding ClearDisplayCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="White"
                        BorderBrush="#66FFFFFF"
                        VerticalAlignment="Center"
                        Content="مسح العرض"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" CornerRadius="18" Padding="28">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F1F8E9" Offset="0"/>
                    <GradientStop Color="#E8F5E9" Offset="0.5"/>
                    <GradientStop Color="#FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Idle / waiting -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasResult}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <materialDesign:PackIcon Kind="BarcodeScan" Width="96" Height="96"
                                             Foreground="#81C784" HorizontalAlignment="Center"/>
                    <TextBlock Text="مرّر الباركود على الماسح" FontSize="28" FontWeight="SemiBold"
                               Foreground="#33691E" HorizontalAlignment="Center" Margin="0,20,0,8"/>
                    <TextBlock Text="سيظهر اسم المنتج والسعر هنا تلقائياً"
                               FontSize="16" Foreground="#558B2F" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="18" FontWeight="SemiBold"
                               Foreground="#C62828" HorizontalAlignment="Center" Margin="0,24,0,0"
                               Visibility="{Binding IsError, Converter={StaticResource BoolVis}}"/>
                </StackPanel>

                <!-- Result -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ProductName}" FontSize="40" FontWeight="Bold"
                               Foreground="#1B5E20" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="900" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayedBarcode, StringFormat=الباركود: {0}}"
                               FontSize="18" Foreground="#558B2F" HorizontalAlignment="Center"
                               Margin="0,14,0,0" FontFamily="Consolas"/>
                    <TextBlock Text="{Binding PricingTypeName, StringFormat=نوع التسعير: {0}}"
                               FontSize="16" Foreground="#689F38" HorizontalAlignment="Center"
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PricingTypeName}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PricingTypeName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border Margin="0,28,0,0" CornerRadius="16" Padding="40,22" HorizontalAlignment="Center"
                            Visibility="{Binding HasPrice, Converter={StaticResource BoolVis}}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#2E7D32" Offset="0"/>
                                <GradientStop Color="#43A047" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding SalePrice, StringFormat='{}{0:N0} د.ع'}"
                                   FontSize="64" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="لا يوجد سعر" FontSize="32" FontWeight="Bold" Foreground="#C62828"
                               HorizontalAlignment="Center" Margin="0,28,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasResult}" Value="True"/>
                                            <Condition Binding="{Binding HasPrice}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scanner input (kept ready for keyboard-wedge devices) -->
        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="12" Padding="14,10"
                Background="#FFFFFF" BorderBrush="#C8E6C9" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="BarcodeScan" Width="22" Height="22"
                                         Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="BarcodeBox"
                         Grid.Column="1"
                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="امسح الباركود هنا ثم Enter"
                         FontSize="18"
                         FontFamily="Consolas"
                         VerticalContentAlignment="Center"
                         KeyDown="BarcodeBox_KeyDown"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
