<UserControl x:Class="AlMuhasib.UI.Views.UnpaidInstallmentsReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:AlMuhasib.UI.ViewModels"
             xmlns:converters="clr-namespace:AlMuhasib.UI.Converters"
             xmlns:controls="clr-namespace:AlMuhasib.UI.Controls"
             xmlns:behaviors="clr-namespace:AlMuhasib.UI.Behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:UnpaidInstallmentsReportViewModel, IsDesignTimeCreatable=False}"
             Style="{StaticResource PageStyle}"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,24,24,8">

                <!-- ═══ Title ═══ -->
                <TextBlock Text="تقرير الأقساط غير المسددة" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- ═══ Stat Cards ═══ -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <controls:AnimatedStatCard
                        Title="إجمالي غير المسدد"
                        TextValue="{Binding TotalUnpaid}"
                        Icon="CashRemove"
                        IconBackground="#FFEBEE"
                        IconForeground="#C62828"
                        ValueForeground="#C62828"/>
                    <controls:AnimatedStatCard
                        Title="عدد الأقساط"
                        TextValue="{Binding UnpaidCount}"
                        Icon="Counter"
                        IconBackground="{DynamicResource HighlightLightBrush}"
                        IconForeground="{DynamicResource HighlightBrush}"
                        ValueForeground="{DynamicResource HighlightBrush}"/>
                    <controls:AnimatedStatCard
                        Title="عدد العملاء"
                        TextValue="{Binding CustomerCount}"
                        Icon="AccountGroup"
                        IconBackground="#E3F2FD"
                        IconForeground="#1565C0"
                        ValueForeground="#1565C0"/>
                    <controls:AnimatedStatCard
                        Title="أقدم تأخير"
                        TextValue="{Binding OldestOverdueDays}"
                        Icon="Clock"
                        IconBackground="#FAFAFA"
                        IconForeground="#616161"
                        ValueForeground="#616161"/>
                </UniformGrid>

                <!-- ═══ Chart ═══ -->
                <controls:ChartCard Title="غير المسدد حسب العميل">
                    <controls:ChartCard.ChartContent>
                        <lvc:PieChart Series="{Binding CustomerSeries}" Height="300"/>
                    </controls:ChartCard.ChartContent>
                </controls:ChartCard>

                <!-- ═══ Filter Bar ═══ -->
                <Border Style="{StaticResource FilterBar}">
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding DateFrom}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="من تاريخ" Width="140" Margin="0,0,12,0"/>
                        <DatePicker SelectedDate="{Binding DateTo}" Style="{StaticResource FilledDatePicker}" materialDesign:HintAssist.Hint="إلى تاريخ" Width="140" Margin="0,0,12,0"/>
                        <ComboBox ItemsSource="{Binding Customers}" SelectedValue="{Binding SelectedCustomerId}" SelectedValuePath="Id" DisplayMemberPath="Name" Style="{StaticResource FilledComboBox}" materialDesign:HintAssist.Hint="العميل" Width="160" Margin="0,0,12,0"/>
                        <Button Content="بحث" Style="{StaticResource PrimaryButton}" Command="{Binding LoadDataCommand}" Margin="0,0,12,0"/>
                    </StackPanel>
                </Border>

                <controls:ReportBulkInstallmentPayBar DataContext="{Binding}"/>

                <TextBlock Text="انقر مرتين على صف لعرض فاتورة الأقساط والتفاصيل — حدّد عدة صفوف (Ctrl+نقر) للتسديد الجماعي"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ DataGrid ═══ -->
        <materialDesign:Card Grid.Row="1" materialDesign:ElevationAssist.Elevation="Dp2" Margin="24,0,24,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <controls:ListTableHeaderBar Grid.Row="0"
                                                     Title="تقرير الأقساط غير المسددة"
                                                     TargetDataGrid="{Binding ElementName=InstallmentsGrid}"
                                                     IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                                     ActiveFilterCount="{Binding ActiveColumnFilterCount}"
                                                     ClearFiltersCommand="{Binding ClearColumnFiltersCommand}"
                                                     ExportCommand="{Binding ExportToExcelCommand}"
                                                     PrintCommand="{Binding PrintCommand}"
                                                     ShowCardToggle="False"/>


                        <DataGrid x:Name="InstallmentsGrid" ItemsSource="{Binding Rows}" Style="{StaticResource ModernDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended" MinHeight="300"
                                  SelectionChanged="InstallmentsGrid_SelectionChanged"
                                  behaviors:DataGridReportRowBehavior.DoubleClickCommand="{Binding OpenInvoiceDetailFromReportRowCommand}"
                                  behaviors:DataGridColumnFilterBehavior.IsEnabled="True"
                                  behaviors:DataGridColumnFilterBehavior.IsFilterPanelOpen="{Binding IsColumnFilterPanelOpen, Mode=TwoWay}"
                                  behaviors:DataGridColumnFilterBehavior.FilterChangedCommand="{Binding ApplyColumnFiltersCommand}"


                                  Grid.Row="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="CustomerName"/>
                                                    <DataGridTextColumn Header="رقم العميل" Binding="{Binding CustomerFileNumber}" Width="90"/>
                                <DataGridTextColumn Header="رقم الخطة" Binding="{Binding PlanNumber}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="PlanNumber"/>
                                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="130"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="DueDate"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="Amount"/>
                                <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat=N0}" Width="120"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="RemainingAmount"/>
                                <DataGridTextColumn Header="أيام التأخير" Binding="{Binding OverdueDays}" Width="110"
                                                    behaviors:DataGridColumnFilterBehavior.FilterPropertyPath="OverdueDays"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <controls:PaginationBar Grid.Row="2"/>
                    </Grid>
        </materialDesign:Card>

        <!-- ═══ Loading Overlay ═══ -->
        <Border Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" IsIndeterminate="True" Width="48" Height="48"/>
                <TextBlock Text="جاري التحميل..." Margin="0,12,0,0" FontSize="14" Foreground="#757575"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
